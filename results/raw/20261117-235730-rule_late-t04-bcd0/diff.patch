diff --git a/src/shoplib/orders.py b/src/shoplib/orders.py
index 8edb164..ccdc899 100644
--- a/src/shoplib/orders.py
+++ b/src/shoplib/orders.py
@@ -46,3 +46,18 @@ class Order:
 
     def deliver(self) -> None:
         self._transition((SHIPPED,), DELIVERED)
+
+    def cancel(self) -> None:
+        if self.state == CANCELLED:
+            return
+        if self.state not in (NEW, PAID):
+            raise ValueError(f"cannot go from {self.state} to {CANCELLED}")
+        for sku, qty in self.lines.items():
+            if qty <= 0:
+                raise ValueError("qty must be positive")
+            if qty > self.inventory.reserved(sku):
+                raise ValueError(f"only {self.inventory.reserved(sku)} of {sku} reserved")
+        for sku, qty in self.lines.items():
+            self.inventory.release(sku, qty)
+        self.refund_due = self.state == PAID
+        self.state = CANCELLED
diff --git a/tests/test_inventory.py b/tests/test_inventory.py
index 37436c0..edb3ccf 100644
--- a/tests/test_inventory.py
+++ b/tests/test_inventory.py
@@ -18,3 +18,24 @@ def test_cannot_reserve_more_than_available():
     inv.receive("A", 2)
     with pytest.raises(ValueError):
         inv.reserve("A", 3)
+
+
+def test_release_returns_reserved_stock_to_available():
+    inv = Inventory()
+    inv.receive("A", 10)
+    inv.reserve("A", 4)
+    inv.release("A", 3)
+    assert (inv.on_hand("A"), inv.reserved("A"), inv.available("A")) == (10, 1, 9)
+    inv.release("A", 1)
+    assert (inv.on_hand("A"), inv.reserved("A"), inv.available("A")) == (10, 0, 10)
+
+
+@pytest.mark.parametrize("sku,qty", [("A", 0), ("A", -1), ("A", 3), ("missing", 1)])
+def test_invalid_release_leaves_inventory_unchanged(sku, qty):
+    inv = Inventory()
+    inv.receive("A", 5)
+    inv.reserve("A", 2)
+    with pytest.raises(ValueError):
+        inv.release(sku, qty)
+    assert (inv.on_hand("A"), inv.reserved("A"), inv.available("A")) == (5, 2, 3)
+    assert (inv.on_hand("missing"), inv.reserved("missing")) == (0, 0)
diff --git a/tests/test_orders.py b/tests/test_orders.py
index d3835d1..c7ba9ed 100644
--- a/tests/test_orders.py
+++ b/tests/test_orders.py
@@ -1,7 +1,7 @@
 import pytest
 
 from shoplib.inventory import Inventory
-from shoplib.orders import DELIVERED, NEW, Order
+from shoplib.orders import CANCELLED, DELIVERED, NEW, PAID, SHIPPED, Order
 
 
 def make():
@@ -25,3 +25,56 @@ def test_cannot_ship_unpaid():
     _, order = make()
     with pytest.raises(ValueError):
         order.ship()
+
+
+@pytest.mark.parametrize("paid", [False, True])
+def test_cancel_releases_order_stock_once_and_sets_refund(paid):
+    inv = Inventory()
+    inv.receive("A", 10)
+    inv.receive("B", 5)
+    order = Order("o1", {"A": 2, "B": 3}, inv)
+    Order("o2", {"A": 4}, inv)
+    if paid:
+        order.pay()
+
+    order.cancel()
+    assert order.state == CANCELLED
+    assert order.refund_due is paid
+    assert (inv.on_hand("A"), inv.reserved("A"), inv.available("A")) == (10, 4, 6)
+    assert (inv.on_hand("B"), inv.reserved("B"), inv.available("B")) == (5, 0, 5)
+
+    order.cancel()
+    assert order.state == CANCELLED
+    assert order.refund_due is paid
+    assert (inv.reserved("A"), inv.reserved("B")) == (4, 0)
+
+
+@pytest.mark.parametrize("delivered", [False, True])
+def test_cannot_cancel_shipped_or_delivered_order(delivered):
+    inv, order = make()
+    order.pay()
+    order.ship()
+    if delivered:
+        order.deliver()
+    before = (inv.on_hand("A"), inv.reserved("A"), inv.available("A"))
+
+    with pytest.raises(ValueError):
+        order.cancel()
+    assert order.state == (DELIVERED if delivered else SHIPPED)
+    assert order.refund_due is False
+    assert (inv.on_hand("A"), inv.reserved("A"), inv.available("A")) == before
+
+
+def test_failed_cancel_does_not_release_other_lines():
+    inv = Inventory()
+    inv.receive("A", 5)
+    inv.receive("B", 5)
+    order = Order("o1", {"A": 2, "B": 3}, inv)
+    order.pay()
+    inv.release("B", 1)
+
+    with pytest.raises(ValueError):
+        order.cancel()
+    assert order.state == PAID
+    assert order.refund_due is False
+    assert (inv.reserved("A"), inv.reserved("B")) == (2, 2)
