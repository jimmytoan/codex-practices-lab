@@ -0,0 +1,42 @@
+import pytest
+
+from shoplib.errors import ShopError
+from shoplib.storedays import daily_revenue
+
+
+def test_boundary_time_zones_refunds_and_gaps():
+    sales = [
+        {"at": "2026-11-20T04:00:00+08:00", "cents": 300},
+        {"at": "2026-11-17T18:30:00Z", "cents": 100},
+        {"at": "2026-11-17T20:00:00Z", "cents": 200},
+        {"at": "2026-11-18T00:00:00-04:00", "cents": -50},
+        {"at": "2026-11-18T03:59:59+08:00", "cents": 25},
+    ]
+    assert daily_revenue(sales) == [
+        ("2026-11-17", 125),
+        ("2026-11-18", 150),
+        ("2026-11-19", 0),
+        ("2026-11-20", 300),
+    ]
+
+
+def test_custom_offset_and_midnight_boundary():
+    sales = [
+        {"at": "2026-11-18T02:00:00Z", "cents": 10},
+        {"at": "2026-11-18T05:00:00Z", "cents": 20},
+    ]
+    assert daily_revenue(sales, utc_offset_hours=-5, day_starts_hour=0) == [
+        ("2026-11-17", 10), ("2026-11-18", 20)
+    ]
+    assert daily_revenue([]) == []
+
+
+def test_timestamp_without_zone_raises_shop_error():
+    with pytest.raises(ShopError):
+        daily_revenue([{"at": "2026-11-18T04:00:00", "cents": 100}])
+
+
+@pytest.mark.parametrize("kwargs", [{"utc_offset_hours": 24}, {"day_starts_hour": 24}])
+def test_invalid_settings_raise_shop_error(kwargs):
+    with pytest.raises(ShopError):
+        daily_revenue([], **kwargs)
