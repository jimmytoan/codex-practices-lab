+from shoplib.discounts import Coupon, apply_coupon, apply_coupons
+from shoplib.errors import ShopError
 
 
 def test_percent():
@@ -7,3 +12,63 @@ def test_percent():
 
 def test_fixed_never_negative():
     assert apply_coupon(300, Coupon("FIVE", "fixed", 500)) == 0
+
+
+def test_combines_best_percent_and_all_eligible_fixed_coupons():
+    today = date(2026, 11, 17)
+    coupons = [
+        Coupon("LOWER", "percent", 5),
+        Coupon("Z-TEN", "percent", 10),
+        Coupon("FIFTY", "fixed", 50, min_subtotal_cents=1000),
+        Coupon("A-TEN", "percent", 10, expires=today),
+        Coupon("TWENTY", "fixed", 20),
+        Coupon("EXPIRED", "percent", 90, expires=date(2026, 11, 16)),
+        Coupon("TOO-HIGH", "fixed", 100, min_subtotal_cents=1001),
+    ]
+
+    assert apply_coupons(1000, coupons, today) == (
+        830, ["A-TEN", "FIFTY", "TWENTY"]
+    )
+
+
+def test_percent_is_calculated_from_original_subtotal_and_rounds_half_up():
+    coupons = [Coupon("FIXED", "fixed", 1), Coupon("HALF", "percent", 50)]
+
+    assert apply_coupons(5, coupons, date(2026, 11, 17)) == (1, ["FIXED", "HALF"])
+
+
+def test_all_eligible_codes_are_reported_when_total_reaches_zero():
+    coupons = [
+        Coupon("OVER", "percent", 150),
+        Coupon("FIRST", "fixed", 500),
+        Coupon("LAST", "fixed", 200),
+    ]
+
+    assert apply_coupons(100, coupons, date(2026, 11, 17)) == (
+        0, ["FIRST", "LAST", "OVER"]
+    )
+
+
+def test_no_eligible_coupons_and_empty_list_leave_subtotal_unchanged():
+    today = date(2026, 11, 17)
+    coupons = [
+        Coupon("EXPIRED", "fixed", 10, expires=date(2026, 11, 16)),
+        Coupon("MINIMUM", "percent", 50, min_subtotal_cents=101),
+    ]
+
+    assert apply_coupons(100, coupons, today) == (100, [])
+    assert apply_coupons(100, [], today) == (100, [])
+
+
+def test_zero_value_coupons_and_duplicate_codes_are_applied():
+    coupons = [Coupon("SAME", "fixed", 0), Coupon("SAME", "percent", 0)]
+
+    assert apply_coupons(0, coupons, date(2026, 11, 17)) == (0, ["SAME", "SAME"])
+
+
+def test_invalid_subtotal_and_coupon_kind_raise_shop_error():
+    today = date(2026, 11, 17)
+    with pytest.raises(ShopError):
+        apply_coupons(-1, [], today)
+    with pytest.raises(ShopError):
+        apply_coupons(100, [Coupon("BAD", "unknown", 10)], today)
