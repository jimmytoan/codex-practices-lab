-from shoplib.discounts import Coupon, apply_coupon
+from datetime import date
+
+import pytest
+
+from shoplib.discounts import Coupon, apply_coupon, apply_coupons
+from shoplib.errors import ShopError
 
 
 def test_percent():
@@ -7,3 +12,46 @@ def test_percent():
 
 def test_fixed_never_negative():
     assert apply_coupon(300, Coupon("FIVE", "fixed", 500)) == 0
+
+
+def test_apply_coupons_uses_original_subtotal_and_combines_discounts():
+    coupons = [
+        Coupon("P10", "percent", 10),
+        Coupon("P20", "percent", 20),
+        Coupon("FIXED", "fixed", 300),
+    ]
+
+    assert apply_coupons(1000, coupons, date(2026, 1, 1)) == (500, ["FIXED", "P20"])
+
+
+def test_apply_coupons_selects_first_code_when_percent_values_tie():
+    coupons = [Coupon("Z", "percent", 10), Coupon("A", "percent", 10)]
+
+    assert apply_coupons(1000, coupons, date(2026, 1, 1)) == (900, ["A"])
+
+
+def test_apply_coupons_checks_expiry_inclusively_and_minimum_against_original():
+    coupons = [
+        Coupon("EXPIRES-TODAY", "fixed", 100, expires=date(2026, 1, 1)),
+        Coupon("EXPIRED", "fixed", 200, expires=date(2025, 12, 31)),
+        Coupon("MIN-MET", "fixed", 300, min_subtotal_cents=1000),
+        Coupon("MIN-NOT-MET", "fixed", 400, min_subtotal_cents=1001),
+    ]
+
+    assert apply_coupons(1000, coupons, date(2026, 1, 1)) == (600, ["EXPIRES-TODAY", "MIN-MET"])
+
+
+def test_apply_coupons_clamps_total_to_zero():
+    coupons = [Coupon("A", "fixed", 700), Coupon("B", "fixed", 500)]
+
+    assert apply_coupons(1000, coupons, date(2026, 1, 1)) == (0, ["A", "B"])
+
+
+def test_apply_coupons_rejects_negative_subtotal():
+    with pytest.raises(ValueError):
+        apply_coupons(-1, [], date(2026, 1, 1))
+
+
+def test_apply_coupons_rejects_unknown_coupon_kind():
+    with pytest.raises(ShopError, match="unknown coupon kind"):
+        apply_coupons(1000, [Coupon("BAD", "bogus", 10)], date(2026, 1, 1))
