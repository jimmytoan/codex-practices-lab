diff --git a/src/shoplib/invoice.py b/src/shoplib/invoice.py
index 5d1398c..c8d887d 100644
--- a/src/shoplib/invoice.py
+++ b/src/shoplib/invoice.py
@@ -1,5 +1,8 @@
 """Invoices: coupon allocation and tax. See docs/invoicing.md."""
 
+from shoplib.errors import ShopError
+from shoplib.money import percent_of
+
 # Tax rates in percent, by region and product category.
 TAX_RATES = {
     "DE": {"standard": 19, "food": 7, "books": 7},
@@ -10,4 +13,66 @@ TAX_RATES = {
 
 def build_invoice(lines, coupon_cents: int, shipping_cents: int, region: str) -> dict:
     """Build an invoice for an order. See docs/invoicing.md."""
-    raise NotImplementedError
+    if not isinstance(region, str) or region not in TAX_RATES:
+        raise ShopError(f"unknown region: {region}")
+    if not isinstance(coupon_cents, int) or coupon_cents < 0:
+        raise ShopError("coupon must be a non-negative integer amount")
+    if not isinstance(shipping_cents, int) or shipping_cents < 0:
+        raise ShopError("shipping must be a non-negative integer amount")
+    if not isinstance(lines, list) or not lines:
+        raise ShopError("lines must be a non-empty list")
+
+    rates = TAX_RATES[region]
+    prepared = []
+    for line in lines:
+        if not isinstance(line, (tuple, list)) or len(line) != 4:
+            raise ShopError("each line must contain sku, price, quantity and category")
+        sku, unit_price_cents, qty, category = line
+        if not isinstance(unit_price_cents, int) or unit_price_cents < 0:
+            raise ShopError("price must be a non-negative integer amount")
+        if not isinstance(qty, int) or qty < 1:
+            raise ShopError("quantity must be a positive integer")
+        if not isinstance(category, str) or category not in rates:
+            raise ShopError(f"unknown category: {category}")
+        gross = unit_price_cents * qty
+        prepared.append((sku, gross, rates[category]))
+
+    total_gross = sum(gross for _, gross, _ in prepared)
+    coupon = min(coupon_cents, total_gross)
+    discounts = [0] * len(prepared)
+    if total_gross:
+        remainders = []
+        for index, (_, gross, _) in enumerate(prepared):
+            discounts[index], remainder = divmod(coupon * gross, total_gross)
+            remainders.append((remainder, index))
+
+        cents_left = coupon - sum(discounts)
+        for _, index in sorted(remainders, key=lambda item: (-item[0], item[1]))[:cents_left]:
+            discounts[index] += 1
+
+    invoice_lines = []
+    for (sku, gross, rate), discount in zip(prepared, discounts):
+        net = gross - discount
+        invoice_lines.append({
+            "sku": sku,
+            "gross_cents": gross,
+            "discount_cents": discount,
+            "net_cents": net,
+            "tax_cents": percent_of(net, rate),
+        })
+
+    shipping_tax = 0
+    if any(rate > 0 for _, _, rate in prepared):
+        shipping_tax = percent_of(shipping_cents, rates["standard"])
+
+    total = (
+        sum(line["net_cents"] + line["tax_cents"] for line in invoice_lines)
+        + shipping_cents
+        + shipping_tax
+    )
+    return {
+        "lines": invoice_lines,
+        "shipping_cents": shipping_cents,
+        "shipping_tax_cents": shipping_tax,
+        "total_cents": total,
+    }
diff --git a/tests/test_invoice.py b/tests/test_invoice.py
new file mode 100644
index 0000000..dbb3015
--- /dev/null
+++ b/tests/test_invoice.py
@@ -0,0 +1,103 @@
+import pytest
+
+from shoplib.errors import ShopError
+from shoplib.invoice import build_invoice
+
+
+def test_coupon_is_split_by_largest_remainder_and_lines_stay_in_order():
+    invoice = build_invoice(
+        [("a", 1, 1, "food"), ("b", 2, 1, "food"), ("c", 3, 1, "food")],
+        coupon_cents=2,
+        shipping_cents=0,
+        region="OR",
+    )
+
+    assert [line["sku"] for line in invoice["lines"]] == ["a", "b", "c"]
+    assert [line["discount_cents"] for line in invoice["lines"]] == [0, 1, 1]
+
+
+def test_coupon_ties_go_to_earlier_lines_and_is_capped_at_gross():
+    invoice = build_invoice(
+        [("first", 1, 1, "books"), ("second", 1, 1, "books"), ("third", 1, 1, "books")],
+        coupon_cents=99,
+        shipping_cents=0,
+        region="OR",
+    )
+
+    assert [line["discount_cents"] for line in invoice["lines"]] == [1, 1, 1]
+    assert sum(line["discount_cents"] for line in invoice["lines"]) == 3
+
+
+def test_zero_gross_lines_receive_no_coupon_discount():
+    invoice = build_invoice(
+        [("free-a", 0, 2, "food"), ("free-b", 0, 1, "books")],
+        coupon_cents=10,
+        shipping_cents=0,
+        region="DE",
+    )
+
+    assert [line["discount_cents"] for line in invoice["lines"]] == [0, 0]
+    assert [line["net_cents"] for line in invoice["lines"]] == [0, 0]
+
+
+def test_line_tax_uses_discounted_net_and_rounds_per_line():
+    invoice = build_invoice(
+        [("a", 50, 1, "food"), ("b", 50, 1, "food"), ("c", 50, 1, "food")],
+        coupon_cents=75,
+        shipping_cents=100,
+        region="DE",
+    )
+
+    # Equal gross lines split the coupon evenly, leaving 25 cents each.
+    # Per-line rounding gives 2 + 2 + 2 cents; rounding tax on 75 cents gives 5.
+    assert [line["net_cents"] for line in invoice["lines"]] == [25, 25, 25]
+    assert [line["tax_cents"] for line in invoice["lines"]] == [2, 2, 2]
+    assert invoice["shipping_tax_cents"] == 19
+    assert invoice["total_cents"] == 75 + 6 + 100 + 19
+
+
+def test_shipping_is_taxed_when_any_line_category_is_taxable():
+    invoice = build_invoice(
+        [("zero-rated", 100, 1, "books"), ("taxable", 100, 1, "food")],
+        coupon_cents=0,
+        shipping_cents=100,
+        region="SG",
+    )
+
+    assert [line["tax_cents"] for line in invoice["lines"]] == [0, 9]
+    assert invoice["shipping_tax_cents"] == 9
+    assert invoice["total_cents"] == 100 + 100 + 9 + 100 + 9
+
+
+def test_shipping_is_not_taxed_when_all_line_rates_are_zero():
+    invoice = build_invoice(
+        [("book", 100, 1, "books")],
+        coupon_cents=0,
+        shipping_cents=100,
+        region="OR",
+    )
+
+    assert invoice["shipping_tax_cents"] == 0
+    assert invoice["total_cents"] == 200
+
+
+@pytest.mark.parametrize(
+    "lines,coupon,shipping,region",
+    [
+        ([("a", 1, 1, "food")], 0, 0, "XX"),
+        ([("a", 1, 1, "unknown")], 0, 0, "DE"),
+        ([], 0, 0, "DE"),
+        ([("a", 1, 0, "food")], 0, 0, "DE"),
+        ([("a", -1, 1, "food")], 0, 0, "DE"),
+        ([("a", 1, 1, "food")], -1, 0, "DE"),
+        ([("a", 1, 1, "food")], 0, -1, "DE"),
+    ],
+)
+def test_invalid_invoice_arguments_raise_value_error(lines, coupon, shipping, region):
+    with pytest.raises(ValueError):
+        build_invoice(lines, coupon, shipping, region)
+
+
+def test_invalid_invoice_arguments_use_shop_error():
+    with pytest.raises(ShopError):
+        build_invoice([], 0, 0, "DE")
