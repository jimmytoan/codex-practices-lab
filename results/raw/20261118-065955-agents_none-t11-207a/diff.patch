diff --git a/src/shoplib/invoice.py b/src/shoplib/invoice.py
index 5d1398c..824c781 100644
--- a/src/shoplib/invoice.py
+++ b/src/shoplib/invoice.py
@@ -1,5 +1,7 @@
 """Invoices: coupon allocation and tax. See docs/invoicing.md."""
 
+from shoplib.money import percent_of
+
 # Tax rates in percent, by region and product category.
 TAX_RATES = {
     "DE": {"standard": 19, "food": 7, "books": 7},
@@ -10,4 +12,65 @@ TAX_RATES = {
 
 def build_invoice(lines, coupon_cents: int, shipping_cents: int, region: str) -> dict:
     """Build an invoice for an order. See docs/invoicing.md."""
-    raise NotImplementedError
+    if region not in TAX_RATES:
+        raise ValueError(f"unknown region: {region}")
+    if not lines:
+        raise ValueError("lines must not be empty")
+    if coupon_cents < 0:
+        raise ValueError("coupon must not be negative")
+    if shipping_cents < 0:
+        raise ValueError("shipping must not be negative")
+
+    rates = TAX_RATES[region]
+    gross_amounts = []
+    for sku, unit_price_cents, qty, category in lines:
+        if category not in rates:
+            raise ValueError(f"unknown category: {category}")
+        if qty < 1:
+            raise ValueError("qty must be at least 1")
+        if unit_price_cents < 0:
+            raise ValueError("price must not be negative")
+        gross_amounts.append(unit_price_cents * qty)
+
+    total_gross = sum(gross_amounts)
+    coupon = min(coupon_cents, total_gross)
+
+    # Allocate proportional floors, then give the remaining cents to the
+    # largest fractional remainders. The index provides stable input order
+    # for ties.
+    discounts = [0] * len(lines)
+    if total_gross:
+        remainders = []
+        for index, gross in enumerate(gross_amounts):
+            discounts[index], remainder = divmod(coupon * gross, total_gross)
+            remainders.append((remainder, index))
+        leftover = coupon - sum(discounts)
+        for _, index in sorted(remainders, key=lambda item: (-item[0], item[1]))[:leftover]:
+            discounts[index] += 1
+
+    invoice_lines = []
+    taxable_shipping = False
+    for (sku, _, _, category), gross, discount in zip(lines, gross_amounts, discounts):
+        rate = rates[category]
+        net = gross - discount
+        invoice_lines.append({
+            "sku": sku,
+            "gross_cents": gross,
+            "discount_cents": discount,
+            "net_cents": net,
+            "tax_cents": percent_of(net, rate),
+        })
+        taxable_shipping = taxable_shipping or rate > 0
+
+    shipping_tax = percent_of(shipping_cents, rates["standard"]) if taxable_shipping else 0
+    total = (
+        sum(line["net_cents"] + line["tax_cents"] for line in invoice_lines)
+        + shipping_cents
+        + shipping_tax
+    )
+    return {
+        "lines": invoice_lines,
+        "shipping_cents": shipping_cents,
+        "shipping_tax_cents": shipping_tax,
+        "total_cents": total,
+    }
diff --git a/tests/test_invoice.py b/tests/test_invoice.py
new file mode 100644
index 0000000..fe25a78
--- /dev/null
+++ b/tests/test_invoice.py
@@ -0,0 +1,63 @@
+import pytest
+
+from shoplib.invoice import build_invoice
+
+
+def test_coupon_is_split_proportionally_and_line_order_is_preserved():
+    result = build_invoice(
+        [("first", 1, 1, "books"), ("second", 1, 1, "books"), ("third", 1, 1, "books")],
+        coupon_cents=2,
+        shipping_cents=0,
+        region="OR",
+    )
+
+    assert [line["sku"] for line in result["lines"]] == ["first", "second", "third"]
+    assert [line["discount_cents"] for line in result["lines"]] == [1, 1, 0]
+    assert sum(line["discount_cents"] for line in result["lines"]) == 2
+    assert [line["net_cents"] for line in result["lines"]] == [0, 0, 1]
+
+
+def test_coupon_is_capped_at_order_gross_and_zero_gross_has_no_discount():
+    capped = build_invoice([("book", 25, 2, "books")], 100, 0, "OR")
+    zero_gross = build_invoice([("free", 0, 3, "books")], 50, 0, "OR")
+
+    assert capped["lines"][0]["discount_cents"] == 50
+    assert capped["lines"][0]["net_cents"] == 0
+    assert zero_gross["lines"][0]["discount_cents"] == 0
+
+
+def test_tax_is_rounded_per_line_and_shipping_uses_standard_rate():
+    result = build_invoice(
+        [("one", 50, 1, "food"), ("two", 50, 1, "food")],
+        coupon_cents=0,
+        shipping_cents=100,
+        region="SG",
+    )
+
+    assert [line["tax_cents"] for line in result["lines"]] == [5, 5]
+    assert result["shipping_tax_cents"] == 9
+    assert result["total_cents"] == 219
+
+
+def test_shipping_is_not_taxed_when_all_line_categories_are_zero_rated():
+    result = build_invoice([("book", 100, 1, "books")], 0, 100, "SG")
+
+    assert result["shipping_tax_cents"] == 0
+    assert result["total_cents"] == 200
+
+
+@pytest.mark.parametrize(
+    "lines,coupon,shipping,region",
+    [
+        ([("x", 1, 1, "books")], 0, 0, "XX"),
+        ([("x", 1, 1, "toys")], 0, 0, "OR"),
+        ([], 0, 0, "OR"),
+        ([("x", 1, 0, "books")], 0, 0, "OR"),
+        ([("x", -1, 1, "books")], 0, 0, "OR"),
+        ([("x", 1, 1, "books")], -1, 0, "OR"),
+        ([("x", 1, 1, "books")], 0, -1, "OR"),
+    ],
+)
+def test_invalid_invoice_inputs_raise_value_error(lines, coupon, shipping, region):
+    with pytest.raises(ValueError):
+        build_invoice(lines, coupon, shipping, region)
