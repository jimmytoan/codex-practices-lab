diff --git a/tests/test_cart.py b/tests/test_cart.py
index 1a3d0e7..113fad3 100644
--- a/tests/test_cart.py
+++ b/tests/test_cart.py
@@ -1,6 +1,7 @@
 import pytest
 
 from shoplib.cart import Cart
+from shoplib.errors import ShopError
 
 
 def test_add_and_subtotal():
@@ -21,3 +22,32 @@ def test_add_same_sku_merges():
 def test_bad_qty():
     with pytest.raises(ValueError):
         Cart().add("A", 250, 0)
+
+
+def test_bulk_discount_applies_per_line_at_threshold():
+    cart = Cart()
+    cart.add("under", 100, 9)
+    cart.add("threshold", 100, 10)
+    cart.add("above", 100, 11)
+
+    assert cart.line_total("under") == 900
+    assert cart.line_total("threshold") == 950
+    assert cart.line_total("above") == 1045
+    assert cart.subtotal() == 2895
+
+
+def test_bulk_discount_uses_merged_quantity_and_rounds_half_up():
+    cart = Cart()
+    cart.add("A", 1, 9)
+    assert cart.line_total("A") == 9
+
+    cart.add("A", 1)
+    assert cart.line_total("A") == 9
+    cart.add("B", 1, 10)
+    assert cart.line_total("B") == 9
+    assert cart.subtotal() == 18
+
+
+def test_missing_line_total_raises_shop_error():
+    with pytest.raises(ShopError):
+        Cart().line_total("missing")
