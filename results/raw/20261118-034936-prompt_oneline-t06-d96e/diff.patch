diff --git a/tests/test_dates.py b/tests/test_dates.py
index fbfd5f2..820e448 100644
--- a/tests/test_dates.py
+++ b/tests/test_dates.py
@@ -12,3 +12,14 @@ def test_forward_over_weekend():
     # Friday + 1 business day = Monday
     assert add_business_days(date(2026, 11, 13), 1) == date(2026, 11, 16)
     assert add_business_days(date(2026, 11, 16), 3) == date(2026, 11, 19)
+
+
+def test_business_day_offsets_skip_holidays_in_both_directions():
+    holidays = {date(2026, 11, 16), date(2026, 11, 17)}
+    assert add_business_days(date(2026, 11, 13), 1, holidays) == date(2026, 11, 18)
+    assert add_business_days(date(2026, 11, 18), -1, holidays) == date(2026, 11, 13)
+
+
+def test_zero_offset_returns_start_or_next_business_day():
+    assert add_business_days(date(2026, 11, 18), 0) == date(2026, 11, 18)
+    assert add_business_days(date(2026, 11, 16), 0, {date(2026, 11, 16)}) == date(2026, 11, 17)
