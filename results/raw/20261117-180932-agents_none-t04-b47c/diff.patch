diff --git a/src/shoplib/orders.py b/src/shoplib/orders.py
index 8edb164..7a99d09 100644
--- a/src/shoplib/orders.py
+++ b/src/shoplib/orders.py
@@ -46,3 +46,22 @@ class Order:
 
     def deliver(self) -> None:
         self._transition((SHIPPED,), DELIVERED)
+
+    def cancel(self) -> None:
+        if self.state == CANCELLED:
+            return
+        if self.state not in (NEW, PAID):
+            raise ValueError(f"cannot cancel an order in {self.state}")
+
+        # Check the complete reservation before releasing any lines so a
+        # malformed or externally changed reservation cannot be partly freed.
+        for sku, qty in self.lines.items():
+            if qty > self.inventory.reserved(sku):
+                raise ValueError(f"only {self.inventory.reserved(sku)} of {sku} reserved")
+
+        was_paid = self.state == PAID
+        for sku, qty in self.lines.items():
+            self.inventory.release(sku, qty)
+        self.state = CANCELLED
+        if was_paid:
+            self.refund_due = True
diff --git a/tests/test_inventory.py b/tests/test_inventory.py
index 37436c0..e1bed2c 100644
--- a/tests/test_inventory.py
+++ b/tests/test_inventory.py
@@ -18,3 +18,39 @@ def test_cannot_reserve_more_than_available():
     inv.receive("A", 2)
     with pytest.raises(ValueError):
         inv.reserve("A", 3)
+
+
+def test_release_returns_reserved_stock_to_available():
+    inv = Inventory()
+    inv.receive("A", 5)
+    inv.reserve("A", 3)
+
+    inv.release("A", 2)
+
+    assert inv.on_hand("A") == 5
+    assert inv.reserved("A") == 1
+    assert inv.available("A") == 4
+
+
+@pytest.mark.parametrize("qty", [0, -1])
+def test_release_requires_positive_quantity(qty):
+    inv = Inventory()
+    inv.receive("A", 2)
+    inv.reserve("A", 1)
+
+    with pytest.raises(ValueError):
+        inv.release("A", qty)
+
+    assert inv.reserved("A") == 1
+    assert inv.available("A") == 1
+
+
+def test_release_more_than_reserved_changes_nothing():
+    inv = Inventory()
+    inv.receive("A", 2)
+
+    with pytest.raises(ValueError):
+        inv.release("A", 1)
+
+    assert inv.reserved("A") == 0
+    assert inv.available("A") == 2
diff --git a/tests/test_orders.py b/tests/test_orders.py
index d3835d1..7c93cb0 100644
--- a/tests/test_orders.py
+++ b/tests/test_orders.py
@@ -1,7 +1,7 @@
 import pytest
 
 from shoplib.inventory import Inventory
-from shoplib.orders import DELIVERED, NEW, Order
+from shoplib.orders import CANCELLED, DELIVERED, NEW, PAID, SHIPPED, Order
 
 
 def make():
@@ -25,3 +25,73 @@ def test_cannot_ship_unpaid():
     _, order = make()
     with pytest.raises(ValueError):
         order.ship()
+
+
+def test_cancel_new_order_releases_reserved_stock():
+    inv, order = make()
+
+    order.cancel()
+
+    assert order.state == CANCELLED
+    assert order.refund_due is False
+    assert inv.reserved("A") == 0
+    assert inv.available("A") == 5
+
+
+def test_cancel_paid_order_releases_reserved_stock_and_sets_refund_due():
+    inv, order = make()
+    order.pay()
+
+    order.cancel()
+
+    assert order.state == CANCELLED
+    assert order.refund_due is True
+    assert inv.reserved("A") == 0
+    assert inv.available("A") == 5
+
+
+def test_cancelling_cancelled_order_does_nothing():
+    inv, order = make()
+    order.cancel()
+
+    order.cancel()
+
+    assert order.state == CANCELLED
+    assert order.refund_due is False
+    assert inv.reserved("A") == 0
+    assert inv.available("A") == 5
+
+
+@pytest.mark.parametrize("next_state", [SHIPPED, DELIVERED])
+def test_cannot_cancel_shipped_or_delivered_order(next_state):
+    inv, order = make()
+    order.pay()
+    order.ship()
+    if next_state == DELIVERED:
+        order.deliver()
+
+    before = (inv.on_hand("A"), inv.reserved("A"), inv.available("A"))
+    with pytest.raises(ValueError):
+        order.cancel()
+
+    assert order.state == next_state
+    assert order.refund_due is False
+    assert (inv.on_hand("A"), inv.reserved("A"), inv.available("A")) == before
+
+
+def test_cancel_with_missing_reservation_changes_nothing():
+    inv = Inventory()
+    inv.receive("A", 1)
+    inv.receive("B", 1)
+    order = Order("o2", {"A": 1, "B": 1}, inv)
+    inv.release("B", 1)
+
+    with pytest.raises(ValueError):
+        order.cancel()
+
+    assert order.state == NEW
+    assert order.refund_due is False
+    assert inv.reserved("A") == 1
+    assert inv.reserved("B") == 0
+    assert inv.available("A") == 0
+    assert inv.available("B") == 1
