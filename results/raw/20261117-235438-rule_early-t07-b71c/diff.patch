 def test_percent():
@@ -7,3 +12,52 @@ def test_percent():
 
 def test_fixed_never_negative():
     assert apply_coupon(300, Coupon("FIVE", "fixed", 500)) == 0
+
+
+def test_combine_coupons_using_original_subtotal_and_sorted_codes():
+    today = date(2026, 1, 10)
+    coupons = [
+        Coupon("Z_FIXED", "fixed", 100, min_subtotal_cents=1000),
+        Coupon("LOW", "percent", 5),
+        Coupon("B_TEN", "percent", 10),
+        Coupon("A_TEN", "percent", 10, expires=today),
+        Coupon("EXPIRED", "fixed", 500, expires=date(2026, 1, 9)),
+        Coupon("MINIMUM", "fixed", 500, min_subtotal_cents=1001),
+        Coupon("A_FIXED", "fixed", 50, expires=date(2026, 1, 11)),
+    ]
+
+    assert apply_coupons(1000, coupons, today) == (
+        750, ["A_FIXED", "A_TEN", "Z_FIXED"]
+    )
+
+
+def test_percent_rounds_half_up_before_fixed_discount():
+    coupons = [Coupon("FIXED", "fixed", 1), Coupon("HALF", "percent", 50)]
+    assert apply_coupons(5, coupons, date(2026, 1, 1)) == (1, ["FIXED", "HALF"])
+
+
+def test_total_is_zero_and_all_eligible_fixed_codes_are_recorded():
+    coupons = [Coupon("B", "fixed", 10), Coupon("A", "fixed", 10)]
+    assert apply_coupons(5, coupons, date(2026, 1, 1)) == (0, ["A", "B"])
+    assert apply_coupons(5, [Coupon("BIG", "percent", 200)], date(2026, 1, 1)) == (
+        0, ["BIG"]
+    )
+
+
+def test_empty_and_ineligible_coupons_leave_subtotal_unchanged():
+    today = date(2026, 1, 1)
+    assert apply_coupons(0, [], today) == (0, [])
+    assert apply_coupons(100, [Coupon("NO", "percent", 10, min_subtotal_cents=101)], today) == (100, [])
+
+
+def test_duplicate_fixed_codes_are_each_applied():
+    coupons = [Coupon("SAME", "fixed", 10), Coupon("SAME", "fixed", 20)]
+    assert apply_coupons(100, coupons, date(2026, 1, 1)) == (70, ["SAME", "SAME"])
+
+
+def test_invalid_subtotal_and_coupon_kind_raise_shop_error():
+    today = date(2026, 1, 1)
+    with pytest.raises(ShopError):
+        apply_coupons(-1, [], today)
+    with pytest.raises(ShopError):
+        apply_coupons(100, [Coupon("BAD", "unknown", 10)], today)
