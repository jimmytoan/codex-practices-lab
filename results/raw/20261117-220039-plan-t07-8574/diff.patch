diff --git a/src/shoplib/discounts.py b/src/shoplib/discounts.py
index d2804c4..b97a8e8 100644
--- a/src/shoplib/discounts.py
+++ b/src/shoplib/discounts.py
@@ -3,6 +3,7 @@
 from dataclasses import dataclass
 from datetime import date
 
+from .errors import ShopError
 from .money import percent_of
 
 
@@ -30,4 +31,29 @@ def apply_coupon(subtotal_cents: int, coupon: Coupon) -> int:
 
 def apply_coupons(subtotal_cents: int, coupons: list[Coupon], today: date) -> tuple[int, list[str]]:
     """Apply several coupons following the rules in docs/discounts.md."""
-    raise NotImplementedError
+    if subtotal_cents < 0:
+        raise ShopError("subtotal must not be negative")
+
+    percent_coupon = None
+    fixed_coupons = []
+    for coupon in coupons:
+        if coupon.kind not in ("percent", "fixed"):
+            raise ShopError(f"unknown coupon kind {coupon.kind!r}")
+        if (coupon.expires is not None and coupon.expires < today) or (
+            subtotal_cents < coupon.min_subtotal_cents
+        ):
+            continue
+        if coupon.kind == "fixed":
+            fixed_coupons.append(coupon)
+        elif percent_coupon is None or (-coupon.value, coupon.code) < (
+            -percent_coupon.value, percent_coupon.code
+        ):
+            percent_coupon = coupon
+
+    total = subtotal_cents
+    codes = [coupon.code for coupon in fixed_coupons]
+    if percent_coupon is not None:
+        total -= percent_of(subtotal_cents, percent_coupon.value)
+        codes.append(percent_coupon.code)
+    total -= sum(coupon.value for coupon in fixed_coupons)
+    return max(total, 0), sorted(codes)
diff --git a/tests/test_discounts.py b/tests/test_discounts.py
