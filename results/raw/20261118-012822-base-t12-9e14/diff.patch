@@ -0,0 +1,105 @@
+import pytest
+
+from shoplib.errors import ShopError
+from shoplib.search import Product, search
+
+
+@pytest.fixture
+def products():
+    return [
+        Product('MUG-Blue', 'Big Blue Mug', 1000, ['Sale', 'Kitchenware']),
+        Product('MUG-RED', 'Small red mug', 999, ['kitchen', 'Gift']),
+        Product('PLATE-1', 'Blue plate', 1500, ['SALE']),
+        Product('MUG-*', 'Mug * special', 0),
+    ]
+
+
+@pytest.mark.parametrize('query', ['', '  \t\n  ', '""'])
+def test_empty_queries_match_all_in_input_order(products, query):
+    assert search(products, query) == products
+    assert search(products, query) is not products
+
+
+@pytest.mark.parametrize(
+    ('query', 'indices'),
+    [
+        ('MuG', [0, 1, 3]),
+        ('"blue mug"', [0]),
+        ('name:"BLUE MUG"', [0]),
+        ('"small red" mug', [1]),
+        ('name:bl"ue m"ug', [0]),
+        ('sku:mug-blue', [0]),
+        ('sku:mug', []),
+        ('tag:sAlE', [0, 2]),
+        ('tag:kit', []),
+        ('name:BLUE', [0, 2]),
+        ('sku:mug-*', [0, 1, 3]),
+        ('tag:KITCHEN*', [0, 1]),
+        ('sku:MUG-*x', []),
+        ('sku:MUG-**', [3]),
+        ('name:*', [3]),
+        ('tag:*', [0, 1, 2]),
+        ('sku:*', [0, 1, 2, 3]),
+        ('blue -tag:sale', []),
+        ('mug -tag:sale', [1, 3]),
+        ('-"blue mug"', [1, 2, 3]),
+        ('-sku:mug-*', [2]),
+        ('mug\tname:"red mug"\nprice<1000', [1]),
+    ],
+)
+def test_terms_and_combinations(products, query, indices):
+    assert search(products, query) == [products[i] for i in indices]
+
+
+@pytest.mark.parametrize(
+    ('query', 'indices'),
+    [
+        ('price<1000', [1, 3]),
+        ('price<=1000', [0, 1, 3]),
+        ('price>1000', [2]),
+        ('price>=1000', [0, 2]),
+        ('price=1000', [0]),
+        ('price=0000', [3]),
+        ('-price>=1000', [1, 3]),
+        ('price<999999999999999999999999999999999999', [0, 1, 2, 3]),
+    ],
+)
+def test_price_comparisons(products, query, indices):
+    assert search(products, query) == [products[i] for i in indices]
+
+
+def test_very_large_whole_price_is_valid(products):
+    assert search(products, 'price<' + '9' * 5000) == products
+
+
+def test_casefold_and_quoted_whitespace():
+    product = Product('STRASSE', 'Straße\nMug', 1, ['GRÜN'])
+    assert search([product], 'sku:straße tag:grün name:"STRASSE\nMUG"') == [product]
+
+
+def test_literal_stars_and_colons_in_values():
+    product = Product('A*B', 'pricey: mug', 1, ['A*B', 'two:parts'])
+    assert search([product], 'sku:A*B tag:A*B tag:"two:parts" name:"pricey:"') == [product]
+    assert search([product], 'sku:A*') == [product]
+    assert search([product], 'pricey') == [product]
+
+
+@pytest.mark.parametrize(
+    'query',
+    [
+        'color:blue', 'price:5', 'SKU:foo', ':foo',
+        'sku:', 'tag:', 'name:', 'tag:""', '-name:',
+        '-', '-""',
+        '"unclosed', 'name:"unclosed', '-"unclosed',
+        'price=', 'price<', 'price>abc', 'price<=1.5', 'price>=-1',
+        'price=+1', 'price==1', 'price><1', 'price=1x', 'price="1 0"',
+    ],
+)
+def test_invalid_queries_raise_shop_error_even_with_no_products(query):
+    with pytest.raises(ShopError):
+        search([], query)
+
+
+def test_invalid_later_term_is_not_hidden_by_a_nonmatching_term(products):
+    with pytest.raises(ShopError):
+        search(products, 'no-such-product tag:')
