@@ -13,4 +18,90 @@ class Product:
 
 def search(products: list[Product], query: str) -> list[Product]:
     """The products that match `query`, in their input order. See docs/search.md."""
-    raise NotImplementedError
+    predicates = [_parse_term(term) for term in _tokenize(query)]
+    return [product for product in products if all(test(product) for test in predicates)]
+
+
+def _tokenize(query: str) -> list[str]:
+    terms = []
+    chars = []
+    quoted = False
+    started = False
+    for char in query:
+        if char == '"':
+            quoted = not quoted
+            started = True
+        elif char.isspace() and not quoted:
+            if started:
+                terms.append(''.join(chars))
+                chars = []
+                started = False
+        else:
+            chars.append(char)
+            started = True
+    if quoted:
+        raise ShopError("unclosed quote")
+    if started:
+        terms.append(''.join(chars))
+    return terms
+
+
+_PRICE_OPERATORS = {
+    '<': operator.lt,
+    '<=': operator.le,
+    '>': operator.gt,
+    '>=': operator.ge,
+    '=': operator.eq,
+}
+_PRICE_TERM = re.compile(r'price(<=|>=|<|>|=)(.*)', re.DOTALL)
+
+
+def _parse_term(term: str) -> Callable[[Product], bool]:
+    negated = term.startswith('-')
+    if negated:
+        term = term[1:]
+        if not term:
+            raise ShopError("empty negated term")
+
+    price = _PRICE_TERM.fullmatch(term)
+    if price:
+        comparison, value = price.groups()
+        if not value.isdecimal():
+            raise ShopError("invalid price")
+        # Parse in chunks so valid long numbers are not limited by int's
+        # string conversion limit.
+        cents = 0
+        for start in range(0, len(value), 9):
+            chunk = value[start:start + 9]
+            cents = cents * 10 ** len(chunk) + int(chunk)
+        compare = _PRICE_OPERATORS[comparison]
+        predicate = lambda product: compare(product.price_cents, cents)
+    elif ':' in term:
+        field_name, value = term.split(':', 1)
+        if field_name not in ('sku', 'name', 'tag'):
+            raise ShopError("unknown search field")
+        if not value:
+            raise ShopError("empty field value")
+        value = value.casefold()
+        if field_name == 'name':
+            predicate = lambda product: value in product.name.casefold()
+        else:
+            prefix = value.endswith('*')
+            if prefix:
+                value = value[:-1]
+
+            def matches(text: str) -> bool:
+                text = text.casefold()
+                return text.startswith(value) if prefix else text == value
+
+            if field_name == 'sku':
+                predicate = lambda product: matches(product.sku)
+            else:
+                predicate = lambda product: any(matches(tag) for tag in product.tags)
+    else:
+        value = term.casefold()
+        predicate = lambda product: value in product.name.casefold()
+
+    if negated:
+        return lambda product: not predicate(product)
+    return predicate
