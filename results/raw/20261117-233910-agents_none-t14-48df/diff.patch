diff --git a/src/shoplib/storedays.py b/src/shoplib/storedays.py
index c46116f..ba6216b 100644
--- a/src/shoplib/storedays.py
+++ b/src/shoplib/storedays.py
@@ -1,6 +1,26 @@
 """Revenue per store day. See docs/store-days.md."""
 
+from datetime import datetime, timedelta, timezone
+
 
 def daily_revenue(sales: list[dict], utc_offset_hours: int = 8, day_starts_hour: int = 4) -> list[tuple[str, int]]:
     """Revenue per store day. See docs/store-days.md."""
-    raise NotImplementedError
+    shop_timezone = timezone(timedelta(hours=utc_offset_hours))
+    day_start = timedelta(hours=day_starts_hour)
+    totals = {}
+
+    for sale in sales:
+        timestamp = datetime.fromisoformat(sale["at"])
+        if timestamp.tzinfo is None or timestamp.utcoffset() is None:
+            raise ValueError("sale timestamp must include a time zone")
+        store_day = (timestamp.astimezone(shop_timezone) - day_start).date()
+        totals[store_day] = totals.get(store_day, 0) + sale["cents"]
+
+    if not totals:
+        return []
+
+    first, last = min(totals), max(totals)
+    return [
+        (day.isoformat(), totals.get(day, 0))
+        for day in (first + timedelta(days=offset) for offset in range((last - first).days + 1))
+    ]
diff --git a/tests/test_storedays.py b/tests/test_storedays.py
new file mode 100644
index 0000000..28428bb
--- /dev/null
+++ b/tests/test_storedays.py
@@ -0,0 +1,52 @@
+import pytest
+
+from shoplib.storedays import daily_revenue
+
+
+def test_default_day_boundary_and_equivalent_time_zones():
+    sales = [
+        {"at": "2026-11-17T20:00:00Z", "cents": 100},
+        {"at": "2026-11-18T03:59:59.999999+08:00", "cents": 20},
+        {"at": "2026-11-17T15:59:59.999999Z", "cents": 30},
+        {"at": "2026-11-17T11:00:00-05:00", "cents": 40},
+        {"at": "2026-11-18T04:00:00+08:00", "cents": -10},
+    ]
+    assert daily_revenue(sales) == [("2026-11-17", 90), ("2026-11-18", 90)]
+
+
+def test_unsorted_sales_refunds_and_gaps_across_year():
+    sales = [
+        {"at": "2027-01-02T12:00:00+08:00", "cents": 15},
+        {"at": "2026-12-30T12:00:00+08:00", "cents": 100},
+        {"at": "2026-12-30T13:00:00+08:00", "cents": -125},
+    ]
+    assert daily_revenue(sales) == [
+        ("2026-12-30", -25),
+        ("2026-12-31", 0),
+        ("2027-01-01", 0),
+        ("2027-01-02", 15),
+    ]
+
+
+def test_custom_offset_and_start_hour():
+    sales = [
+        {"at": "2026-11-18T04:59:59Z", "cents": 5},
+        {"at": "2026-11-18T05:00:00Z", "cents": 10},
+    ]
+    assert daily_revenue(sales, utc_offset_hours=-5, day_starts_hour=0) == [
+        ("2026-11-17", 5),
+        ("2026-11-18", 10),
+    ]
+    assert daily_revenue(sales, utc_offset_hours=-5, day_starts_hour=23) == [
+        ("2026-11-17", 15),
+    ]
+
+
+def test_empty_sales():
+    assert daily_revenue([]) == []
+
+
+@pytest.mark.parametrize("timestamp", ["2026-11-18T04:00:00", "2026-11-18 04:00:00"])
+def test_timestamp_without_zone_raises(timestamp):
+    with pytest.raises(ValueError):
+        daily_revenue([{"at": timestamp, "cents": 1}])
