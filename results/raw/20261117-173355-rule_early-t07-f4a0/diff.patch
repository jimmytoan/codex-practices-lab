 def test_percent():
@@ -7,3 +12,57 @@ def test_percent():
 
 def test_fixed_never_negative():
     assert apply_coupon(300, Coupon("FIVE", "fixed", 500)) == 0
+
+
+def test_combines_best_percent_and_all_eligible_fixed_coupons():
+    today = date(2026, 11, 17)
+    coupons = [
+        Coupon("Z_FIXED", "fixed", 100, min_subtotal_cents=1000),
+        Coupon("SMALL", "percent", 10),
+        Coupon("Z_PERCENT", "percent", 20),
+        Coupon("A_PERCENT", "percent", 20, expires=today),
+        Coupon("A_FIXED", "fixed", 50, expires=date(2026, 11, 18)),
+        Coupon("EXPIRED", "fixed", 500, expires=date(2026, 11, 16)),
+        Coupon("MINIMUM", "percent", 90, min_subtotal_cents=1001),
+    ]
+
+    assert apply_coupons(1000, coupons, today) == (
+        650, ["A_FIXED", "A_PERCENT", "Z_FIXED"]
+    )
+
+
+def test_percent_uses_half_up_rounding_before_fixed_discounts():
+    coupons = [Coupon("FIXED", "fixed", 1), Coupon("HALF", "percent", 50)]
+
+    assert apply_coupons(101, coupons, date(2026, 11, 17)) == (49, ["FIXED", "HALF"])
+
+
+def test_all_eligible_fixed_coupons_are_reported_even_when_total_is_zero():
+    coupons = [Coupon("SAME", "fixed", 500), Coupon("SAME", "fixed", 200)]
+
+    assert apply_coupons(100, coupons, date(2026, 11, 17)) == (0, ["SAME", "SAME"])
+
+
+def test_percent_discount_cannot_make_total_negative():
+    coupons = [Coupon("OVER", "percent", 150), Coupon("FIXED", "fixed", 1)]
+
+    assert apply_coupons(100, coupons, date(2026, 11, 17)) == (0, ["FIXED", "OVER"])
+
+
+def test_no_eligible_coupons_leaves_subtotal_unchanged():
+    today = date(2026, 11, 17)
+    coupons = [
+        Coupon("EXPIRED", "percent", 50, expires=date(2026, 11, 16)),
+        Coupon("MINIMUM", "fixed", 10, min_subtotal_cents=101),
+    ]
+
+    assert apply_coupons(100, coupons, today) == (100, [])
+    assert apply_coupons(0, [], today) == (0, [])
+
+
+def test_invalid_arguments_raise_shop_error():
+    today = date(2026, 11, 17)
+    with pytest.raises(ShopError):
+        apply_coupons(-1, [], today)
+    with pytest.raises(ShopError):
+        apply_coupons(100, [Coupon("BAD", "unknown", 10)], today)
