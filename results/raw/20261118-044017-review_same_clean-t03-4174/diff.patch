diff --git a/tests/test_inventory.py b/tests/test_inventory.py
index 37436c0..4196145 100644
--- a/tests/test_inventory.py
+++ b/tests/test_inventory.py
@@ -18,3 +18,55 @@ def test_cannot_reserve_more_than_available():
     inv.receive("A", 2)
     with pytest.raises(ValueError):
         inv.reserve("A", 3)
+
+
+def test_release_returns_reserved_units_to_available():
+    inv = Inventory()
+    inv.receive("A", 10)
+    inv.reserve("A", 6)
+
+    inv.release("A", 2)
+
+    assert inv.on_hand("A") == 10
+    assert inv.reserved("A") == 4
+    assert inv.available("A") == 6
+
+
+@pytest.mark.parametrize("qty", [0, -1])
+def test_release_rejects_nonpositive_quantity_without_changing_state(qty):
+    inv = Inventory()
+    inv.receive("A", 10)
+    inv.reserve("A", 6)
+
+    with pytest.raises(ValueError):
+        inv.release("A", qty)
+
+    assert inv.on_hand("A") == 10
+    assert inv.reserved("A") == 6
+    assert inv.available("A") == 4
+
+
+@pytest.mark.parametrize("sku", ["A", "missing"])
+def test_release_rejects_more_than_reserved_without_changing_state(sku):
+    inv = Inventory()
+    inv.receive("A", 10)
+
+    with pytest.raises(ValueError):
+        inv.release(sku, 1)
+
+    assert inv.on_hand("A") == 10
+    assert inv.reserved("A") == 0
+    assert inv.available("A") == 10
+
+
+def test_release_rejects_releasing_more_than_reserved_without_changing_state():
+    inv = Inventory()
+    inv.receive("A", 10)
+    inv.reserve("A", 3)
+
+    with pytest.raises(ValueError):
+        inv.release("A", 4)
+
+    assert inv.on_hand("A") == 10
+    assert inv.reserved("A") == 3
+    assert inv.available("A") == 7
