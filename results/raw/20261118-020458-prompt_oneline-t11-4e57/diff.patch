diff --git a/src/shoplib/invoice.py b/src/shoplib/invoice.py
index 5d1398c..2c07297 100644
--- a/src/shoplib/invoice.py
+++ b/src/shoplib/invoice.py
@@ -1,5 +1,8 @@
 """Invoices: coupon allocation and tax. See docs/invoicing.md."""
 
+from .errors import ShopError
+from .money import percent_of
+
 # Tax rates in percent, by region and product category.
 TAX_RATES = {
     "DE": {"standard": 19, "food": 7, "books": 7},
@@ -10,4 +13,62 @@ TAX_RATES = {
 
 def build_invoice(lines, coupon_cents: int, shipping_cents: int, region: str) -> dict:
     """Build an invoice for an order. See docs/invoicing.md."""
-    raise NotImplementedError
+    if not isinstance(region, str) or region not in TAX_RATES:
+        raise ShopError("unknown region")
+    if not isinstance(lines, list) or not lines:
+        raise ShopError("lines must be a nonempty list")
+    for amount in (coupon_cents, shipping_cents):
+        if type(amount) is not int or amount < 0:
+            raise ShopError("amounts must be nonnegative integer cents")
+
+    rates = TAX_RATES[region]
+    gross_amounts = []
+    for line in lines:
+        if not isinstance(line, (tuple, list)) or len(line) != 4:
+            raise ShopError("invalid line")
+        _, price, qty, category = line
+        if type(price) is not int or price < 0:
+            raise ShopError("price must be nonnegative integer cents")
+        if type(qty) is not int or qty < 1:
+            raise ShopError("quantity must be a positive integer")
+        if not isinstance(category, str) or category not in rates:
+            raise ShopError("unknown category")
+        gross_amounts.append(price * qty)
+
+    total_gross = sum(gross_amounts)
+    coupon = min(coupon_cents, total_gross)
+    discounts = [0] * len(lines)
+    if total_gross:
+        remainders = []
+        for index, gross in enumerate(gross_amounts):
+            discounts[index], remainder = divmod(coupon * gross, total_gross)
+            remainders.append(remainder)
+        remaining = coupon - sum(discounts)
+        for index in sorted(range(len(lines)), key=lambda i: -remainders[i])[:remaining]:
+            discounts[index] += 1
+
+    invoice_lines = []
+    for (sku, _, _, category), gross, discount in zip(lines, gross_amounts, discounts):
+        net = gross - discount
+        invoice_lines.append({
+            "sku": sku,
+            "gross_cents": gross,
+            "discount_cents": discount,
+            "net_cents": net,
+            "tax_cents": percent_of(net, rates[category]),
+        })
+
+    shipping_tax = (
+        percent_of(shipping_cents, rates["standard"])
+        if any(rates[line[3]] > 0 for line in lines)
+        else 0
+    )
+    total = shipping_cents + shipping_tax + sum(
+        line["net_cents"] + line["tax_cents"] for line in invoice_lines
+    )
+    return {
+        "lines": invoice_lines,
+        "shipping_cents": shipping_cents,
+        "shipping_tax_cents": shipping_tax,
+        "total_cents": total,
+    }
diff --git a/tests/test_invoice.py b/tests/test_invoice.py
new file mode 100644
index 0000000..2bf07e7
--- /dev/null
+++ b/tests/test_invoice.py
@@ -0,0 +1,71 @@
+import pytest
+
+from shoplib.errors import ShopError
+from shoplib.invoice import build_invoice
+
+
+def test_invoice_allocates_coupon_and_calculates_taxes():
+    invoice = build_invoice(
+        [("A", 101, 1, "standard"), ("B", 67, 3, "food"), ("C", 101, 1, "books")],
+        5, 55, "SG",
+    )
+    assert invoice == {
+        "lines": [
+            {"sku": "A", "gross_cents": 101, "discount_cents": 1, "net_cents": 100, "tax_cents": 9},
+            {"sku": "B", "gross_cents": 201, "discount_cents": 3, "net_cents": 198, "tax_cents": 18},
+            {"sku": "C", "gross_cents": 101, "discount_cents": 1, "net_cents": 100, "tax_cents": 0},
+        ],
+        "shipping_cents": 55,
+        "shipping_tax_cents": 5,
+        "total_cents": 485,
+    }
+
+
+def test_equal_remainders_favor_earlier_lines():
+    result = build_invoice([(str(i), 1, 1, "books") for i in range(3)], 2, 0, "SG")
+    assert [line["discount_cents"] for line in result["lines"]] == [1, 1, 0]
+
+
+def test_coupon_is_capped_and_zero_gross_is_supported():
+    result = build_invoice([("A", 0, 1, "standard"), ("B", 3, 2, "books")], 100, 50, "SG")
+    assert [line["discount_cents"] for line in result["lines"]] == [0, 6]
+    assert result["shipping_tax_cents"] == 5
+    assert result["total_cents"] == 55
+
+    result = build_invoice([("A", 0, 1, "books")], 100, 50, "SG")
+    assert result["lines"][0]["discount_cents"] == 0
+    assert result["shipping_tax_cents"] == 0
+    assert result["total_cents"] == 50
+
+
+def test_tax_is_rounded_per_line_and_shipping_is_taxed_at_standard_rate():
+    result = build_invoice([("A", 6, 1, "food"), ("B", 6, 1, "food")], 0, 50, "SG")
+    assert [line["tax_cents"] for line in result["lines"]] == [1, 1]
+    assert result["shipping_tax_cents"] == 5
+    assert result["total_cents"] == 69
+
+    result = build_invoice([("A", 100, 1, "food")], 0, 100, "DE")
+    assert result["lines"][0]["tax_cents"] == 7
+    assert result["shipping_tax_cents"] == 19
+
+    result = build_invoice([("A", 100, 1, "standard")], 0, 100, "OR")
+    assert result["shipping_tax_cents"] == 0
+    assert result["total_cents"] == 200
+
+
+@pytest.mark.parametrize("lines,coupon,shipping,region", [
+    ([], 0, 0, "SG"),
+    ([("A", 1, 1, "standard")], 0, 0, "unknown"),
+    ([("A", 1, 1, "unknown")], 0, 0, "SG"),
+    ([("A", -1, 1, "standard")], 0, 0, "SG"),
+    ([("A", 1, 0, "standard")], 0, 0, "SG"),
+    ([("A", 1, 1, "standard")], -1, 0, "SG"),
+    ([("A", 1, 1, "standard")], 0, -1, "SG"),
+    ([("A", 1.5, 1, "standard")], 0, 0, "SG"),
+    ([("A", 1, 1.5, "standard")], 0, 0, "SG"),
+    ([("A", 1, 1, "standard")], 0.5, 0, "SG"),
+    ([("A", 1, 1, "standard")], 0, 0.5, "SG"),
+])
+def test_invalid_arguments_raise_shop_error(lines, coupon, shipping, region):
+    with pytest.raises(ShopError):
+        build_invoice(lines, coupon, shipping, region)
