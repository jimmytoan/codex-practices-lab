diff --git a/tests/test_cart.py b/tests/test_cart.py
index 1a3d0e7..bb71a60 100644
--- a/tests/test_cart.py
+++ b/tests/test_cart.py
@@ -21,3 +21,22 @@ def test_add_same_sku_merges():
 def test_bad_qty():
     with pytest.raises(ValueError):
         Cart().add("A", 250, 0)
+
+
+def test_bulk_discount_and_subtotal():
+    cart = Cart()
+    cart.add("below", 10, 9)
+    cart.add("threshold", 10, 10)
+    cart.add("above", 10, 11)
+
+    assert cart.line_total("below") == 90
+    assert cart.line_total("threshold") == 95
+    assert cart.line_total("above") == 104  # 5.5 cents rounds up to 6
+    assert cart.subtotal() == 289
+
+
+def test_merging_quantities_applies_discount():
+    cart = Cart()
+    cart.add("A", 100, 9)
+    cart.add("A", 100)
+    assert cart.line_total("A") == 950
