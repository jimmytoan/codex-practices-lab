@@ -0,0 +1,62 @@
+import pytest
+
+from shoplib.errors import ShopError
+from shoplib.invoice import build_invoice
+
+
+def test_coupon_largest_remainders_and_invoice_totals():
+    invoice = build_invoice(
+        [("a", 101, 1, "standard"), ("b", 100, 2, "food"),
+         ("c", 101, 1, "books")], 3, 50, "DE"
+    )
+    assert invoice == {
+        "lines": [
+            {"sku": "a", "gross_cents": 101, "discount_cents": 1, "net_cents": 100, "tax_cents": 19},
+            {"sku": "b", "gross_cents": 200, "discount_cents": 1, "net_cents": 199, "tax_cents": 14},
+            {"sku": "c", "gross_cents": 101, "discount_cents": 1, "net_cents": 100, "tax_cents": 7},
+        ],
+        "shipping_cents": 50,
+        "shipping_tax_cents": 10,
+        "total_cents": 499,
+    }
+
+
+def test_remainder_ties_favor_earlier_lines():
+    invoice = build_invoice([(str(i), 1, 1, "books") for i in range(3)], 2, 0, "SG")
+    assert [line["discount_cents"] for line in invoice["lines"]] == [1, 1, 0]
+
+
+def test_coupon_is_capped_and_zero_gross_is_safe():
+    invoice = build_invoice([("a", 0, 1, "books"), ("b", 3, 2, "books")], 100, 0, "SG")
+    assert [line["discount_cents"] for line in invoice["lines"]] == [0, 6]
+    assert invoice["total_cents"] == 0
+    invoice = build_invoice([("a", 0, 1, "standard")], 10, 10, "SG")
+    assert invoice["lines"][0]["discount_cents"] == 0
+    assert invoice["shipping_tax_cents"] == 1
+
+
+def test_tax_rounds_per_line_and_shipping_depends_on_category_rate():
+    invoice = build_invoice([("a", 5, 1, "standard"), ("b", 5, 1, "standard")], 0, 5, "SG")
+    assert [line["tax_cents"] for line in invoice["lines"]] == [0, 0]
+    assert invoice["shipping_tax_cents"] == 0
+    assert invoice["total_cents"] == 15
+    invoice = build_invoice([("a", 100, 1, "books")], 0, 100, "SG")
+    assert invoice["shipping_tax_cents"] == 0
+    invoice = build_invoice([("a", 100, 1, "standard")], 100, 100, "SG")
+    assert invoice["shipping_tax_cents"] == 9
+    invoice = build_invoice([("a", 100, 1, "standard")], 0, 100, "OR")
+    assert invoice["shipping_tax_cents"] == 0
+
+
+@pytest.mark.parametrize("lines,coupon,shipping,region", [
+    ([("a", 1, 1, "standard")], 0, 0, "unknown"),
+    ([("a", 1, 1, "unknown")], 0, 0, "DE"),
+    ([], 0, 0, "DE"),
+    ([("a", 1, 0, "standard")], 0, 0, "DE"),
+    ([("a", -1, 1, "standard")], 0, 0, "DE"),
+    ([("a", 1, 1, "standard")], -1, 0, "DE"),
+    ([("a", 1, 1, "standard")], 0, -1, "DE"),
+])
+def test_invalid_arguments_raise_shop_error(lines, coupon, shipping, region):
+    with pytest.raises(ShopError):
+        build_invoice(lines, coupon, shipping, region)
