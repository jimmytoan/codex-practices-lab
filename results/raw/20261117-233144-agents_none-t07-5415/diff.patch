-from shoplib.discounts import Coupon, apply_coupon
+from datetime import date, timedelta
+
+import pytest
+
+from shoplib.discounts import Coupon, apply_coupon, apply_coupons
 
 
 def test_percent():
@@ -7,3 +11,43 @@ def test_percent():
 
 def test_fixed_never_negative():
     assert apply_coupon(300, Coupon("FIVE", "fixed", 500)) == 0
+
+
+def test_stacking_selects_best_percent_and_uses_original_subtotal():
+    today = date(2026, 1, 15)
+    coupons = [
+        Coupon("Z_TEN", "percent", 10),
+        Coupon("A_TEN", "percent", 10, expires=today),
+        Coupon("LOW", "percent", 5),
+        Coupon("FIXED", "fixed", 100, min_subtotal_cents=1005),
+        Coupon("EXPIRED", "fixed", 500, expires=today - timedelta(days=1)),
+        Coupon("TOO_HIGH", "fixed", 500, min_subtotal_cents=1006),
+    ]
+
+    # 10% of 1005 rounds half up to 101; the fixed minimum uses 1005.
+    assert apply_coupons(1005, coupons, today) == (804, ["A_TEN", "FIXED"])
+
+
+def test_all_eligible_fixed_coupons_apply_even_when_total_reaches_zero():
+    today = date(2026, 1, 15)
+    coupons = [
+        Coupon("Z", "fixed", 200),
+        Coupon("A", "fixed", 200, expires=today + timedelta(days=1)),
+        Coupon("A", "fixed", 0),
+    ]
+    assert apply_coupons(300, coupons, today) == (0, ["A", "A", "Z"])
+
+
+def test_empty_and_ineligible_coupons():
+    today = date(2026, 1, 15)
+    assert apply_coupons(0, [], today) == (0, [])
+    assert apply_coupons(100, [Coupon("LATE", "percent", 50, expires=today - timedelta(days=1))], today) == (100, [])
+
+
+def test_percent_discount_is_capped_at_zero():
+    assert apply_coupons(100, [Coupon("BIG", "percent", 150)], date(2026, 1, 15)) == (0, ["BIG"])
+
+
+def test_negative_subtotal_raises_before_applying_coupons():
+    with pytest.raises(ValueError, match="subtotal must not be negative"):
+        apply_coupons(-1, [], date(2026, 1, 15))
