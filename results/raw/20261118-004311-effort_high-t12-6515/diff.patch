+def _tokens(query: str) -> list[str]:
+    tokens = []
+    chars = []
+    quoted = False
+    active = False
+    for char in query:
+        if char == '"':
+            quoted = not quoted
+            active = True
+        elif char.isspace() and not quoted:
+            if active:
+                tokens.append("".join(chars))
+                chars = []
+                active = False
+        else:
+            chars.append(char)
+            active = True
+    if quoted:
+        raise ShopError("unclosed quote")
+    if active:
+        tokens.append("".join(chars))
+    return tokens
+
+
+def _parse_term(term: str) -> Callable[[Product], bool]:
+    negated = term.startswith("-")
+    if negated:
+        term = term[1:]
+        if not term:
+            raise ShopError("missing negated term")
+
+    if ":" in term:
+        field_name, value = term.split(":", 1)
+        if field_name not in ("sku", "tag", "name"):
+            raise ShopError("unknown search field")
+        if not value:
+            raise ShopError("empty search field value")
+        value = value.casefold()
+        if field_name == "name":
+            matches = lambda product: value in product.name.casefold()
+        else:
+            prefix = value.endswith("*")
+            if prefix:
+                value = value[:-1]
+
+            def field_matches(text: str) -> bool:
+                text = text.casefold()
+                return text.startswith(value) if prefix else text == value
+
+            if field_name == "sku":
+                matches = lambda product: field_matches(product.sku)
+            else:
+                matches = lambda product: any(field_matches(tag) for tag in product.tags)
+    elif term.startswith("price") and term[5:6] in ("<", ">", "="):
+        comparison = term[5:7] if term[5:7] in ("<=", ">=") else term[5:6]
+        value = term[5 + len(comparison):]
+        if not value.isdecimal():
+            raise ShopError("invalid price comparison")
+        # Convert in chunks so even a very long whole number is valid on Python
+        # versions that limit the length of decimal strings passed to int().
+        price = 0
+        for start in range(0, len(value), 9):
+            chunk = value[start:start + 9]
+            price = price * 10 ** len(chunk) + int(chunk)
+        compare = {"<": operator.lt, "<=": operator.le, ">": operator.gt,
+                   ">=": operator.ge, "=": operator.eq}[comparison]
+        matches = lambda product: compare(product.price_cents, price)
+    else:
+        value = term.casefold()
+        matches = lambda product: value in product.name.casefold()
+
+    if negated:
+        return lambda product: not matches(product)
+    return matches
+
+
