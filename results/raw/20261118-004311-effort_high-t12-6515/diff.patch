@@ -0,0 +1,124 @@
+import pytest
+
+from shoplib.errors import ShopError
+from shoplib.search import Product, search
+
+
+@pytest.fixture
+def products():
+    return [
+        Product("MUG-Blue", "Blue ceramic mug", 1000, ["Sale", "Kitchen"]),
+        Product("MUG-red", "Red mug: large", 1500, ["kitchen", "gift"]),
+        Product("TEA-1", "Blue tea cup", 999, ["Sale-item"]),
+        Product("STAR*1", "A * special item", 0, []),
+        Product("MUG", "BLUE MUG", 1000, ["SALE"]),
+    ]
+
+
+@pytest.mark.parametrize("query", ["", " \t\n ", '""'])
+def test_empty_query_and_empty_phrase_match_every_product(products, query):
+    assert search(products, query) == products
+
+
+@pytest.mark.parametrize(
+    ("query", "indices"),
+    [
+        ("mUg", [0, 1, 4]),
+        ('"blue mug"', [4]),
+        ('name:"blue ceramic"', [0]),
+        ('name:"mug: large"', [1]),
+        ('name:"blue"\t"mug"', [0, 4]),
+        ("sku:mug-blue", [0]),
+        ("sku:MUG", [4]),
+        ("tag:SALE", [0, 4]),
+        ("name:MuG", [0, 1, 4]),
+        ("sku:mug-*", [0, 1]),
+        ("sku:*", [0, 1, 2, 3, 4]),
+        ("sku:STAR*1", [3]),
+        ("sku:STAR**", [3]),
+        ("tag:sale*", [0, 2, 4]),
+        ("tag:*", [0, 1, 2, 4]),
+        ("name:*", [3]),
+        ("blue -tag:sale", [2]),
+        ("-sku:MUG-*", [2, 3, 4]),
+        ("-name:blue", [1, 3]),
+        ('-"blue mug"', [0, 1, 2, 3]),
+        ("blue mug tag:kitchen", [0]),
+        ("price<1000", [2, 3]),
+        ("price<=1000", [0, 2, 3, 4]),
+        ("price>1000", [1]),
+        ("price>=1000", [0, 1, 4]),
+        ("price=1000", [0, 4]),
+        ("price=0", [3]),
+        ("-price>=1000", [2, 3]),
+        ("mug price>=1000 -tag:gift", [0, 4]),
+    ],
+)
+def test_search_terms_and_combinations(products, query, indices):
+    assert search(products, query) == [products[index] for index in indices]
+
+
+def test_case_insensitive_matching_uses_unicode_case_folding():
+    product = Product("STRASSE", "Straße", 100, ["Straße"])
+    assert search([product], "strasse sku:straße tag:STRASSE") == [product]
+
+
+def test_quoted_whitespace_is_preserved_and_quotes_can_join_text():
+    product = Product("1", "blue  mug\nlarge", 0, ["special offer"])
+    assert search([product], 'name:bl"ue  mug\nlarge" tag:"special offer"') == [product]
+    assert search([product], '"blue mug"') == []
+
+
+def test_asterisks_inside_sku_and_tag_values_are_literal():
+    product = Product("A*B", "product", 0, ["sa*le"])
+    assert search([product], "sku:A*B tag:sa*le") == [product]
+    assert search([product], "sku:AB tag:sale") == []
+
+
+def test_price_accepts_very_long_whole_numbers(products):
+    assert search(products, "price<" + "9" * 5000) == products
+    assert search(products, "price=" + "0" * 5000) == [products[3]]
+
+
+@pytest.mark.parametrize(
+    "query",
+    [
+        "unknown:value",
+        "price:5",
+        "SKU:abc",
+        ":value",
+        "sku:",
+        'name:""',
+        "tag:",
+        "-",
+        '-""',
+        '"unclosed',
+        'name:"unclosed phrase',
+        'name:foo"',
+        "price<",
+        "price<=nope",
+        "price>1.5",
+        "price>=-1",
+        "price=+1",
+        "price==1",
+        "price><1",
+    ],
+)
+def test_invalid_queries_raise_shop_error_even_without_products(query):
+    with pytest.raises(ShopError):
+        search([], query)
+
+
+def test_invalid_later_term_is_not_hidden_by_an_earlier_nonmatch(products):
+    with pytest.raises(ShopError):
+        search(products, "no-product-matches tag:")
+
+
+def test_invalid_query_type_raises_shop_error(products):
+    with pytest.raises(ShopError):
+        search(products, None)
+
+
+def test_preserves_input_order_and_duplicates(products):
+    ordered = [products[4], products[0], products[4], products[1]]
+    assert search(ordered, "mug") == ordered
