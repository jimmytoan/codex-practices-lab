diff --git a/tests/test_dates.py b/tests/test_dates.py
index fbfd5f2..e501d7d 100644
--- a/tests/test_dates.py
+++ b/tests/test_dates.py
@@ -12,3 +12,21 @@ def test_forward_over_weekend():
     # Friday + 1 business day = Monday
     assert add_business_days(date(2026, 11, 13), 1) == date(2026, 11, 16)
     assert add_business_days(date(2026, 11, 16), 3) == date(2026, 11, 19)
+
+
+def test_forward_skips_holidays():
+    holidays = (day for day in [date(2026, 11, 16)])
+    assert add_business_days(date(2026, 11, 13), 1, holidays) == date(2026, 11, 17)
+
+
+def test_backward_skips_holidays_and_weekends():
+    holidays = [date(2026, 11, 16)]
+    assert add_business_days(date(2026, 11, 17), -1, holidays) == date(2026, 11, 13)
+    assert add_business_days(date(2026, 11, 17), -2, holidays) == date(2026, 11, 12)
+
+
+def test_zero_returns_start_or_next_business_day():
+    holidays = [date(2026, 11, 16), date(2026, 11, 17)]
+    assert add_business_days(date(2026, 11, 13), 0, holidays) == date(2026, 11, 13)
+    assert add_business_days(date(2026, 11, 14), 0, holidays) == date(2026, 11, 18)
+    assert add_business_days(date(2026, 11, 16), 0, holidays) == date(2026, 11, 18)
