 def test_fixed_never_negative():
     assert apply_coupon(300, Coupon("FIVE", "fixed", 500)) == 0
+
+
+def test_apply_coupons_chooses_best_percent_then_all_fixed():
+    coupons = [
+        Coupon("TEN", "percent", 10),
+        Coupon("FIFTEEN", "percent", 15),
+        Coupon("FIXED-B", "fixed", 125),
+        Coupon("FIXED-A", "fixed", 75),
+    ]
+
+    assert apply_coupons(2000, coupons, date(2026, 1, 1)) == (
+        1500,
+        ["FIFTEEN", "FIXED-A", "FIXED-B"],
+    )
+
+
+def test_apply_coupons_percent_tie_uses_code_order():
+    coupons = [
+        Coupon("ZED", "percent", 20),
+        Coupon("ALPHA", "percent", 20),
+    ]
+
+    assert apply_coupons(1000, coupons, date(2026, 1, 1)) == (800, ["ALPHA"])
+
+
+def test_apply_coupons_checks_expiry_and_minimum_against_original_subtotal():
+    coupons = [
+        Coupon("TODAY", "fixed", 100, expires=date(2026, 1, 1), min_subtotal_cents=500),
+        Coupon("EXPIRED", "fixed", 500, expires=date(2025, 12, 31)),
+        Coupon("TOO-HIGH-MIN", "fixed", 500, min_subtotal_cents=501),
+    ]
+
+    assert apply_coupons(500, coupons, date(2026, 1, 1)) == (400, ["TODAY"])
+
+
+def test_apply_coupons_clamps_total_at_zero():
+    coupons = [Coupon("A", "fixed", 800), Coupon("B", "fixed", 700)]
+
+    assert apply_coupons(1000, coupons, date(2026, 1, 1)) == (0, ["A", "B"])
+
+
+def test_apply_coupons_rejects_negative_subtotal():
+    with pytest.raises(ShopError):
+        apply_coupons(-1, [], date(2026, 1, 1))
