diff --git a/src/shoplib/reports.py b/src/shoplib/reports.py
index d024fdc..da02d8e 100644
--- a/src/shoplib/reports.py
+++ b/src/shoplib/reports.py
@@ -23,5 +23,12 @@ def to_csv(rows: list[dict]) -> str:
     """Render summary rows as CSV, following docs/CONVENTIONS.md."""
     lines = [",".join(COLUMNS)]
     for row in rows:
-        lines.append(",".join(str(row[col]) for col in COLUMNS))
+        lines.append(",".join(_csv_field(row[col]) for col in COLUMNS))
     return "\n".join(lines) + "\n"
+
+
+def _csv_field(value: object) -> str:
+    field = str(value)
+    if any(char in field for char in ',"\r\n'):
+        return '"' + field.replace('"', '""') + '"'
+    return field
diff --git a/tests/test_reports.py b/tests/test_reports.py
index a578302..bd795fd 100644
--- a/tests/test_reports.py
+++ b/tests/test_reports.py
@@ -1,3 +1,6 @@
+import csv
+import io
+
 from shoplib.reports import sales_summary, to_csv
 
 SALES = [
@@ -16,3 +19,27 @@ def test_summary():
 
 def test_csv():
     assert to_csv(sales_summary(SALES)) == "sku,name,units,revenue_cents\nA,Mug,3,1350\nB,Bowl,1,900\n"
+
+
+def test_csv_quotes_special_fields_and_round_trips():
+    rows = [
+        {"sku": "A,1", "name": 'A "large"\nmug', "units": 2, "revenue_cents": 900},
+        {"sku": "B\r1", "name": "", "units": 1, "revenue_cents": 0},
+    ]
+
+    result = to_csv(rows)
+
+    assert result == (
+        'sku,name,units,revenue_cents\n'
+        '"A,1","A ""large""\nmug",2,900\n'
+        '"B\r1",,1,0\n'
+    )
+    assert list(csv.reader(io.StringIO(result, newline=""))) == [
+        ["sku", "name", "units", "revenue_cents"],
+        ["A,1", 'A "large"\nmug', "2", "900"],
+        ["B\r1", "", "1", "0"],
+    ]
+
+
+def test_csv_empty_rows_has_header():
+    assert to_csv([]) == "sku,name,units,revenue_cents\n"
