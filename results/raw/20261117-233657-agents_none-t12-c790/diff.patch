@@ -0,0 +1,81 @@
+import pytest
+
+from shoplib.search import Product, search
+
+
+@pytest.fixture
+def products():
+    return [
+        Product("MUG-01", "Blue Coffee Mug", 1000, ["Sale", "Kitchenware"]),
+        Product("MUG-02", "BLUE travel mug", 1500, ["Kitchen", "SALE*"]),
+        Product("TEA-01", "Tea cup", 999, ["sale"]),
+        Product("MUG-*", "Mug with star", 0),
+    ]
+
+
+@pytest.mark.parametrize(
+    ("query", "indices"),
+    [
+        ("", [0, 1, 2, 3]),
+        (" \t\n ", [0, 1, 2, 3]),
+        ("mUg", [0, 1, 3]),
+        ('"blue coffee"', [0]),
+        ('name:"BLUE travel"', [1]),
+        ('"name:Blue Coffee"', [0]),
+        ("sku:mug-01", [0]),
+        ("sku:mug-0*", [0, 1]),
+        ("sku:mug-*x", []),
+        ("sku:*", [0, 1, 2, 3]),
+        ("tag:sale", [0, 2]),
+        ("tag:sale*", [0, 1, 2]),
+        ("tag:SALE**", [1]),
+        ("tag:kit*", [0, 1]),
+        ("tag:*", [0, 1, 2]),
+        ("name:mug*", []),
+        ("price<1000", [2, 3]),
+        ("price<=1000", [0, 2, 3]),
+        ("price>1000", [1]),
+        ("price>=1000", [0, 1]),
+        ("price=1000", [0]),
+        ("price=0000", [3]),
+        ("mug -tag:sale price>=1000", [1]),
+        ('-name:"blue coffee" -price<1000', [1]),
+        ("-sku:MUG-*", [2]),
+        ("-tag:*", [3]),
+        ('""', [0, 1, 2, 3]),
+    ],
+)
+def test_search_terms(products, query, indices):
+    assert search(products, query) == [products[index] for index in indices]
+
+
+@pytest.mark.parametrize(
+    "query",
+    [
+        "color:blue", "price:5", ":value", "tag:", 'name:""', "sku:",
+        "-", '-""', '"unclosed', 'name:"unclosed value',
+        "price<", "price<=x", "price>1.5", "price>=-1", "price=+1",
+        "price==1", "price<>1", "price=1x", "price=1:2",
+    ],
+)
+def test_invalid_queries_raise_even_when_no_products_match(products, query):
+    with pytest.raises(ValueError):
+        search([], query)
+    with pytest.raises(ValueError):
+        search(products, "no-match " + query)
+
+
+def test_search_casefolds_and_preserves_input_order():
+    products = [Product("STRASSE", "Straße", 1, ["GRÜN"]),
+                Product("strasse", "STRASSE", 2, ["grün"])]
+    assert search(products, "strasse sku:straße tag:Grün") == products
+
+
+def test_whitespace_and_colons_inside_quoted_values():
+    product = Product("a:b c", "a:b c", 10, ["a:b c"])
+    assert search([product], 'sku:"a:b c" tag:"a:b c" name:"a:b c"') == [product]
+
+
+def test_very_long_whole_number_price(products):
+    assert search(products, "price<" + "9" * 5000) == products
+    assert search(products, "price=" + "0" * 5000) == [products[3]]
