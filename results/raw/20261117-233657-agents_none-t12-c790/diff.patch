 """Product search. See docs/search.md."""
 
 from dataclasses import dataclass, field
+from operator import eq, ge, gt, le, lt
+import re
 
 
 @dataclass
@@ -13,4 +15,71 @@ class Product:
 
 def search(products: list[Product], query: str) -> list[Product]:
     """The products that match `query`, in their input order. See docs/search.md."""
-    raise NotImplementedError
+    tokens = []
+    token = []
+    in_quotes = False
+    started = False
+    for char in query:
+        if char == '"':
+            in_quotes = not in_quotes
+            started = True
+        elif char.isspace() and not in_quotes:
+            if started:
+                tokens.append("".join(token))
+                token = []
+                started = False
+        else:
+            token.append(char)
+            started = True
+    if in_quotes:
+        raise ValueError("unclosed quote")
+    if started:
+        tokens.append("".join(token))
+
+    comparisons = {"<": lt, "<=": le, ">": gt, ">=": ge, "=": eq}
+    terms = []
+    for token in tokens:
+        negated = token.startswith("-")
+        if negated:
+            token = token[1:]
+            if not token:
+                raise ValueError("empty negated term")
+
+        price = re.match(r"^price(<=|>=|<|>|=)(.*)$", token, re.DOTALL)
+        if price:
+            operator, value = price.groups()
+            if not re.fullmatch(r"[0-9]+", value):
+                raise ValueError("invalid price")
+            # Convert in chunks so valid prices are not subject to Python's
+            # limit on the length of a single integer-string conversion.
+            cents = 0
+            for start in range(0, len(value), 9):
+                chunk = value[start:start + 9]
+                cents = cents * (10 ** len(chunk)) + int(chunk)
+            terms.append((negated, "price", (comparisons[operator], cents)))
+        elif ":" in token:
+            field_name, value = token.split(":", 1)
+            if field_name not in {"sku", "tag", "name"}:
+                raise ValueError("unknown field")
+            if not value:
+                raise ValueError("empty field value")
+            terms.append((negated, field_name, value.casefold()))
+        else:
+            terms.append((negated, "name", token.casefold()))
+
+    def matches(product: Product, field_name: str, value: object) -> bool:
+        if field_name == "price":
+            compare, cents = value
+            return compare(product.price_cents, cents)
+        if field_name == "name":
+            return value in product.name.casefold()
+        values = [product.sku] if field_name == "sku" else product.tags
+        if value.endswith("*"):
+            return any(item.casefold().startswith(value[:-1]) for item in values)
+        return any(item.casefold() == value for item in values)
+
+    return [
+        product for product in products
+        if all(matches(product, field_name, value) != negated
+               for negated, field_name, value in terms)
+    ]
