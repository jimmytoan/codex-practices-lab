 def test_fixed_never_negative():
     assert apply_coupon(300, Coupon("FIVE", "fixed", 500)) == 0
+
+
+def test_apply_coupons_filters_expired_and_minimum_subtotal():
+    today = date(2026, 11, 18)
+    coupons = [
+        Coupon("TODAY", "fixed", 100, expires=today, min_subtotal_cents=500),
+        Coupon("EXPIRED", "fixed", 200, expires=date(2026, 11, 17)),
+        Coupon("MINIMUM", "fixed", 300, min_subtotal_cents=501),
+    ]
+
+    assert apply_coupons(500, coupons, today) == (400, ["TODAY"])
+
+
+def test_apply_coupons_chooses_highest_percent_then_code():
+    coupons = [
+        Coupon("ZED", "percent", 20),
+        Coupon("BETA", "percent", 15),
+        Coupon("ALPHA", "percent", 20),
+    ]
+
+    assert apply_coupons(1001, coupons, date(2026, 11, 18)) == (801, ["ALPHA"])
+
+
+def test_apply_coupons_applies_percent_to_original_and_stacks_fixed():
+    coupons = [
+        Coupon("TEN", "percent", 10),
+        Coupon("FIXED-B", "fixed", 125),
+        Coupon("FIXED-A", "fixed", 75),
+        Coupon("SMALLER-PERCENT", "percent", 5),
+    ]
+
+    # Ten percent of the original 1001 cents rounds half up to 100 cents.
+    assert apply_coupons(1001, coupons, date(2026, 11, 18)) == (
+        701,
+        ["FIXED-A", "FIXED-B", "TEN"],
+    )
+
+
+def test_apply_coupons_never_returns_negative():
+    coupons = [Coupon("MORE-THAN-TOTAL", "fixed", 500)]
+
+    assert apply_coupons(300, coupons, date(2026, 11, 18)) == (0, ["MORE-THAN-TOTAL"])
+
+
+def test_apply_coupons_rejects_negative_subtotal():
+    with pytest.raises(ShopError):
+        apply_coupons(-1, [], date(2026, 11, 18))
