 """Text helpers for URLs and listings."""
 
 import re
+import unicodedata
 
 
 def slugify(text: str, max_len: int = 40) -> str:
@@ -13,9 +14,27 @@ def slugify(text: str, max_len: int = 40) -> str:
     - At most `max_len` characters, cut after the other steps; a cut never
       leaves a trailing '-'.
     - If nothing is left, the slug is 'n-a'.
+    - Raise ValueError if no slug can fit within `max_len`.
     """
-    slug = re.sub(r"[^a-z0-9]+", "-", text.lower()).strip("-")
+    if max_len < 1:
+        raise ValueError("max_len is too small for a slug")
+
+    normalized = unicodedata.normalize("NFD", text.lower())
+    # Combining marks modify the preceding Latin letter; other marks still
+    # count as separators, just like other non-alphanumeric characters.
+    characters = []
+    after_latin = False
+    for char in normalized:
+        if unicodedata.category(char).startswith("M"):
+            if not after_latin:
+                characters.append(char)
+        else:
+            characters.append(char)
+            after_latin = "a" <= char <= "z"
+    slug = re.sub(r"[^a-z0-9]+", "-", "".join(characters)).strip("-")
     slug = slug[:max_len].rstrip("-")
+    if not slug and max_len < 3:
+        raise ValueError("max_len is too small for a slug")
     return slug or "n-a"
 
 
diff --git a/tests/test_textutil.py b/tests/test_textutil.py
index 4c83bb9..d5d1a8f 100644
--- a/tests/test_textutil.py
+++ b/tests/test_textutil.py
@@ -1,3 +1,5 @@
+import pytest
+
 from shoplib.textutil import slugify, truncate
 
 
@@ -6,6 +8,26 @@ def test_slugify_basic():
     assert slugify("!!!") == "n-a"
 
 
+def test_slugify_accents_and_separators():
+    assert slugify("Crème Brûlée") == "creme-brulee"
+    assert slugify("CAFE\u0301 & À LA MODE") == "cafe-a-la-mode"
+    assert slugify("  a___B / 42  ") == "a-b-42"
+    assert slugify("1\u03012") == "1-2"
+    assert slugify("東京!!!") == "n-a"
+
+
+def test_slugify_max_length():
+    assert slugify("Crème brûlée", 7) == "creme-b"
+    assert slugify("Crème brûlée", 6) == "creme"
+    assert slugify("!!!", 3) == "n-a"
+    assert slugify("a" * 41) == "a" * 40
+    assert slugify("Crème", 1) == "c"
+    assert slugify("Crème", 2) == "cr"
+    for text, max_len in (("!!!", 1), ("!!!", 2), ("a", 0), ("a", -1)):
+        with pytest.raises(ValueError, match="max_len is too small"):
+            slugify(text, max_len)
+
+
 def test_truncate():
     assert truncate("hello world", 8) == "hello..."
     assert truncate("short", 8) == "short"
