diff --git a/src/shoplib/costing.py b/src/shoplib/costing.py
index 5e8c27e..67f4350 100644
--- a/src/shoplib/costing.py
+++ b/src/shoplib/costing.py
@@ -1,6 +1,100 @@
 """Cost of goods sold with FIFO lots. See docs/costing.md."""
 
+from collections import deque
+from decimal import Decimal
+
+from .errors import ShopError
+from .money import round_cents
+
 
 def fifo_costing(events: list[dict]) -> dict:
     """Process stock events and report cost per SKU. See docs/costing.md."""
-    raise NotImplementedError
+    if not isinstance(events, list):
+        raise ShopError("events must be a list")
+
+    stock = {}
+
+    for event in events:
+        if not isinstance(event, dict):
+            raise ShopError("each event must be a dict")
+
+        event_type = event.get("type")
+        if event_type not in ("receive", "sell", "return"):
+            raise ShopError("unknown event type")
+
+        required = {"type", "sku", "qty"}
+        if event_type == "receive":
+            required.add("unit_cost_cents")
+        if not required.issubset(event):
+            raise ShopError("event is missing a required field")
+
+        sku = event["sku"]
+        try:
+            hash(sku)
+        except TypeError as exc:
+            raise ShopError("sku must be hashable") from exc
+
+        qty = event["qty"]
+        if isinstance(qty, bool) or not isinstance(qty, int) or qty < 1:
+            raise ShopError("qty must be a positive integer")
+
+        if sku not in stock:
+            stock[sku] = {
+                "lots": deque(),
+                "cogs_cents": 0,
+                "on_hand": 0,
+                "last_sale": None,
+            }
+        item = stock[sku]
+
+        if event_type == "receive":
+            unit_cost = event["unit_cost_cents"]
+            if isinstance(unit_cost, bool) or not isinstance(unit_cost, int):
+                raise ShopError("unit cost must be an integer number of cents")
+            if unit_cost < 0:
+                raise ShopError("unit cost must not be negative")
+            item["lots"].append([qty, unit_cost])
+            item["on_hand"] += qty
+        elif event_type == "sell":
+            if qty > item["on_hand"]:
+                raise ShopError("cannot sell more units than are on hand")
+
+            remaining = qty
+            sale_cost = 0
+            while remaining:
+                lot = item["lots"][0]
+                taken = min(remaining, lot[0])
+                sale_cost += taken * lot[1]
+                lot[0] -= taken
+                remaining -= taken
+                if lot[0] == 0:
+                    item["lots"].popleft()
+
+            average_unit_cost = round_cents(Decimal(sale_cost) / qty)
+            item["on_hand"] -= qty
+            item["cogs_cents"] += sale_cost
+            item["last_sale"] = {
+                "returnable_qty": qty,
+                "unit_cost_cents": average_unit_cost,
+            }
+        else:
+            last_sale = item["last_sale"]
+            if last_sale is None:
+                raise ShopError("cannot return units when there has been no sale")
+            if qty > last_sale["returnable_qty"]:
+                raise ShopError("return exceeds the most recent sale's returnable quantity")
+
+            unit_cost = last_sale["unit_cost_cents"]
+            item["lots"].append([qty, unit_cost])
+            item["on_hand"] += qty
+            item["cogs_cents"] -= qty * unit_cost
+            last_sale["returnable_qty"] -= qty
+
+    result = {}
+    for sku, item in stock.items():
+        result[sku] = {
+            "cogs_cents": item["cogs_cents"],
+            "on_hand": item["on_hand"],
+            "value_cents": sum(qty * unit_cost for qty, unit_cost in item["lots"]),
+        }
+    return result
diff --git a/tests/test_costing.py b/tests/test_costing.py
new file mode 100644
index 0000000..c73a088
--- /dev/null
+++ b/tests/test_costing.py
@@ -0,0 +1,96 @@
+from copy import deepcopy
+
+import pytest
+
+from shoplib.costing import fifo_costing
+
+
+def test_receipts_and_sales_use_fifo_lots():
+    events = [
+        {"type": "receive", "sku": "A", "qty": 2, "unit_cost_cents": 100},
+        {"type": "receive", "sku": "A", "qty": 3, "unit_cost_cents": 250},
+        {"type": "sell", "sku": "A", "qty": 4},
+    ]
+
+    assert fifo_costing(events) == {
+        "A": {"cogs_cents": 700, "on_hand": 1, "value_cents": 250}
+    }
+
+
+def test_returns_use_rounded_sale_average_and_can_be_split():
+    events = [
+        {"type": "receive", "sku": "A", "qty": 1, "unit_cost_cents": 10},
+        {"type": "receive", "sku": "A", "qty": 1, "unit_cost_cents": 11},
+        {"type": "sell", "sku": "A", "qty": 2},
+        {"type": "return", "sku": "A", "qty": 1},
+        {"type": "return", "sku": "A", "qty": 1},
+    ]
+
+    # The sale average is 10.5 cents, rounded half up to 11 cents per return.
+    assert fifo_costing(events) == {
+        "A": {"cogs_cents": -1, "on_hand": 2, "value_cents": 22}
+    }
+
+
+def test_returned_lot_is_placed_after_all_existing_lots():
+    events = [
+        {"type": "receive", "sku": "A", "qty": 1, "unit_cost_cents": 100},
+        {"type": "receive", "sku": "A", "qty": 2, "unit_cost_cents": 300},
+        {"type": "sell", "sku": "A", "qty": 2},
+        {"type": "receive", "sku": "A", "qty": 1, "unit_cost_cents": 400},
+        {"type": "return", "sku": "A", "qty": 1},
+        {"type": "sell", "sku": "A", "qty": 1},
+    ]
+
+    assert fifo_costing(events) == {
+        "A": {"cogs_cents": 500, "on_hand": 2, "value_cents": 600}
+    }
+
+
+def test_return_limit_tracks_only_the_most_recent_sale():
+    events = [
+        {"type": "receive", "sku": "A", "qty": 4, "unit_cost_cents": 100},
+        {"type": "sell", "sku": "A", "qty": 2},
+        {"type": "sell", "sku": "A", "qty": 1},
+        {"type": "return", "sku": "A", "qty": 2},
+    ]
+
+    with pytest.raises(ValueError):
+        fifo_costing(events)
+
+
+@pytest.mark.parametrize(
+    "events",
+    [
+        [{"type": "receive", "sku": "A", "qty": 0, "unit_cost_cents": 10}],
+        [{"type": "sell", "sku": "A", "qty": -1}],
+        [{"type": "return", "sku": "A", "qty": 1}],
+        [{"type": "receive", "sku": "A", "qty": 1, "unit_cost_cents": -1}],
+        [
+            {"type": "receive", "sku": "A", "qty": 1, "unit_cost_cents": 10},
+            {"type": "sell", "sku": "A", "qty": 2},
+        ],
+        [
+            {"type": "receive", "sku": "A", "qty": 1, "unit_cost_cents": 10},
+            {"type": "sell", "sku": "A", "qty": 1},
+            {"type": "return", "sku": "A", "qty": 2},
+        ],
+        [{"type": "adjust", "sku": "A", "qty": 1}],
+    ],
+)
+def test_invalid_events_raise_value_error(events):
+    with pytest.raises(ValueError):
+        fifo_costing(events)
+
+
+def test_events_are_not_modified():
+    events = [
+        {"type": "receive", "sku": "A", "qty": 2, "unit_cost_cents": 30},
+        {"type": "sell", "sku": "A", "qty": 1},
+        {"type": "return", "sku": "A", "qty": 1},
+    ]
+    original = deepcopy(events)
+
+    fifo_costing(events)
+
+    assert events == original
