@@ -0,0 +1,68 @@
+import pytest
+
+from shoplib.errors import ShopError
+from shoplib.storedays import daily_revenue
+
+
+def test_default_boundary_time_zones_and_refunds():
+    sales = [
+        {"at": "2026-11-17T20:00:00Z", "cents": 500},
+        {"at": "2026-11-18T02:30:00+08:00", "cents": 200},
+        {"at": "2026-11-17T19:59:59.999999Z", "cents": -50},
+        {"at": "2026-11-17T15:30:00-05:00", "cents": 100},
+    ]
+    assert daily_revenue(sales) == [("2026-11-17", 150), ("2026-11-18", 600)]
+
+
+def test_gaps_and_date_order_across_year_and_leap_day():
+    sales = [
+        {"at": "2024-03-01T12:00:00Z", "cents": 10},
+        {"at": "2024-02-28T12:00:00Z", "cents": -10},
+    ]
+    assert daily_revenue(sales, utc_offset_hours=0) == [
+        ("2024-02-28", -10), ("2024-02-29", 0), ("2024-03-01", 10)
+    ]
+    assert daily_revenue([
+        {"at": "2026-12-31T12:00:00Z", "cents": 1},
+        {"at": "2027-01-02T12:00:00Z", "cents": 2},
+    ], utc_offset_hours=0) == [
+        ("2026-12-31", 1), ("2027-01-01", 0), ("2027-01-02", 2)
+    ]
+
+
+def test_custom_offset_and_start_hour():
+    sales = [
+        {"at": "2026-11-18T05:59:59+02:00", "cents": 10},
+        {"at": "2026-11-18T06:00:00+02:00", "cents": 20},
+    ]
+    assert daily_revenue(sales, utc_offset_hours=-3, day_starts_hour=1) == [
+        ("2026-11-17", 10), ("2026-11-18", 20)
+    ]
+    assert daily_revenue(sales, utc_offset_hours=0, day_starts_hour=0) == [("2026-11-18", 30)]
+
+
+def test_empty_sales():
+    assert daily_revenue([]) == []
+
+
+@pytest.mark.parametrize("timestamp", [
+    "2026-11-18T02:30:00", "2026-11-18", "invalid", "2026-02-30T12:00:00Z",
+])
+def test_invalid_or_unzoned_timestamps_raise_shop_error(timestamp):
+    with pytest.raises(ShopError):
+        daily_revenue([{"at": timestamp, "cents": 100}])
+
+
+@pytest.mark.parametrize("kwargs", [
+    {"utc_offset_hours": -24}, {"utc_offset_hours": 24}, {"utc_offset_hours": 1.5},
+    {"day_starts_hour": -1}, {"day_starts_hour": 24}, {"day_starts_hour": True},
+])
+def test_invalid_day_configuration_raises_shop_error(kwargs):
+    with pytest.raises(ShopError):
+        daily_revenue([], **kwargs)
+
+
+@pytest.mark.parametrize("sales", [None, [{}], [{"at": "2026-11-18T00:00:00Z", "cents": 1.5}]])
+def test_invalid_sales_raise_shop_error(sales):
+    with pytest.raises(ShopError):
+        daily_revenue(sales)
