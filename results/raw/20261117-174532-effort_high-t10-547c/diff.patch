+        ([("a", 0, 1)], 10),
+        ([("a", -1, 1)], 10),
+        ([("a", 1, 0)], 10),
+        ([("a", 1, -1)], 10),
+        ([("a", 11, 1)], 10),
+        ([("a", 1, 1)], 0),
+        ([("a", 1, 1), ("b", 0, 1)], 10),
+        ([("a", 1.5, 1)], 10),
+        ([("a", 1, 1.5)], 10),
+        ([(1, 1, 1)], 10),
+        ([("a", 1, 1)], 10.0),
+        (None, 10),
+        ([("a", 1)], 10),
+    ],
+)
+def test_split_parcels_rejects_invalid_items(items, max_weight):
+    with pytest.raises(ShopError):
+        split_parcels(items, max_weight)
