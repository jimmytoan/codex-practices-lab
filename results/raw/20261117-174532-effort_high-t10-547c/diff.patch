+def test_split_parcels_first_fit_decreasing_and_unit_order():
+    items = [("d", 2, 1), ("b", 7, 1), ("c", 3, 1), ("a", 8, 1)]
+    assert split_parcels(items, 10) == [["a", "d"], ["b", "c"]]
+
+
+def test_split_parcels_uses_first_available_parcel():
+    items = [("a", 8, 1), ("b", 6, 1), ("c", 3, 1), ("d", 1, 1)]
+    assert split_parcels(items, 10) == [["a", "d"], ["b", "c"]]
+
+
+def test_split_parcels_sorts_equal_weights_by_sku_and_expands_quantities():
+    items = [("z", 4, 1), ("b", 4, 2), ("a", 4, 1)]
+    assert split_parcels(items, 8) == [["a", "b"], ["b", "z"]]
+
+
+def test_split_parcels_empty_and_exact_capacity():
+    assert split_parcels([], 0) == []
+    assert split_parcels([("a", 10, 2)], 10) == [["a"], ["a"]]
+
+
+@pytest.mark.parametrize(
+    "items, max_weight",
