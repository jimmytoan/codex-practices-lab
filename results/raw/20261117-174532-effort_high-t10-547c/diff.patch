 def split_parcels(items: list[tuple[str, int, int]], max_weight_g: int) -> list[list[str]]:
     """Split order items into parcels. See docs/shipping.md."""
-    raise NotImplementedError
+    if not isinstance(max_weight_g, int):
+        raise ShopError("maximum weight must be an integer")
+    if not isinstance(items, (list, tuple)):
+        raise ShopError("items must be a sequence")
+    units = []
+    for item in items:
+        if not isinstance(item, (list, tuple)) or len(item) != 3:
+            raise ShopError("each item must have a SKU, weight, and quantity")
+        sku, weight, qty = item
+        if not isinstance(sku, str):
+            raise ShopError("SKU must be a string")
