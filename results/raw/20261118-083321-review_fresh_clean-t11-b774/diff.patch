+++ b/tests/test_invoice.py
@@ -0,0 +1,72 @@
+import pytest
+
+from shoplib.errors import ShopError
+from shoplib.invoice import build_invoice
+
+
+def test_coupon_is_split_by_largest_remainder_and_input_order():
+    invoice = build_invoice(
+        [("first", 1, 1, "books"), ("second", 1, 1, "books"), ("third", 1, 1, "books")],
+        coupon_cents=2,
+        shipping_cents=0,
+        region="OR",
+    )
+
+    assert [line["discount_cents"] for line in invoice["lines"]] == [1, 1, 0]
+    assert [line["net_cents"] for line in invoice["lines"]] == [0, 0, 1]
+    assert invoice["total_cents"] == 1
+
+
+def test_coupon_is_capped_and_zero_gross_lines_receive_no_discount():
+    invoice = build_invoice(
+        [("free", 0, 1, "food"), ("item", 3, 2, "books")],
+        coupon_cents=100,
+        shipping_cents=10,
+        region="SG",
+    )
+
+    assert [line["discount_cents"] for line in invoice["lines"]] == [0, 6]
+    assert [line["gross_cents"] for line in invoice["lines"]] == [0, 6]
+    assert [line["net_cents"] for line in invoice["lines"]] == [0, 0]
+    assert invoice["shipping_tax_cents"] == 1  # The free food line still makes shipping taxable.
+
+
+def test_tax_is_rounded_per_line_and_shipping_uses_standard_rate():
+    invoice = build_invoice(
+        [("a", 3, 1, "standard"), ("b", 3, 1, "standard")],
+        coupon_cents=0,
+        shipping_cents=3,
+        region="DE",
+    )
+
+    assert [line["tax_cents"] for line in invoice["lines"]] == [1, 1]
+    assert invoice["shipping_tax_cents"] == 1
+    assert invoice["total_cents"] == 12
+
+
+def test_zero_rate_region_does_not_tax_shipping():
+    invoice = build_invoice([("book", 100, 1, "books")], 0, 50, "OR")
+
+    assert invoice["lines"][0]["tax_cents"] == 0
+    assert invoice["shipping_tax_cents"] == 0
+    assert invoice["total_cents"] == 150
+
+
+@pytest.mark.parametrize(
+    "args",
+    [
+        ([], 0, 0, "DE"),
+        ([("a", -1, 1, "food")], 0, 0, "DE"),
+        ([("a", 1, 0, "food")], 0, 0, "DE"),
+        ([("a", 1, 1, "missing")], 0, 0, "DE"),
+        ([("a", 1, 1, "food")], -1, 0, "DE"),
+        ([("a", 1, 1, "food")], 0, -1, "DE"),
+        ([("a", 1, 1, "food")], 0, 0, "missing"),
+        ([("a", 1.5, 1, "food")], 0, 0, "DE"),
+        ([("a", 1, 1.5, "food")], 0, 0, "DE"),
+        ([("a", 1, 1, "food")], 0.5, 0, "DE"),
+    ],
+)
+def test_invalid_invoice_inputs_raise_value_error(args):
+    with pytest.raises(ShopError):
+        build_invoice(*args)
