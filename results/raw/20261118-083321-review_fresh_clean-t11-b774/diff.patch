diff --git a/src/shoplib/invoice.py b/src/shoplib/invoice.py
index 5d1398c..f730627 100644
--- a/src/shoplib/invoice.py
+++ b/src/shoplib/invoice.py
@@ -1,5 +1,8 @@
 """Invoices: coupon allocation and tax. See docs/invoicing.md."""
 
+from .errors import ShopError
+from .money import percent_of
+
 # Tax rates in percent, by region and product category.
 TAX_RATES = {
     "DE": {"standard": 19, "food": 7, "books": 7},
@@ -10,4 +13,52 @@ TAX_RATES = {
 
 def build_invoice(lines, coupon_cents: int, shipping_cents: int, region: str) -> dict:
     """Build an invoice for an order. See docs/invoicing.md."""
-    raise NotImplementedError
+    if not isinstance(region, str) or region not in TAX_RATES:
+        raise ShopError(f"unknown region {region!r}")
+    try:
+        lines = list(lines)
+    except TypeError:
+        raise ShopError("lines must be a list of invoice lines") from None
+    if not lines:
+        raise ShopError("an invoice needs at least one line")
+    if (not _is_integer(coupon_cents) or not _is_integer(shipping_cents)
+            or coupon_cents < 0 or shipping_cents < 0):
+        raise ShopError("coupon and shipping must be non-negative integer cents")
+    rates = TAX_RATES[region]
+    gross = []
+    for line in lines:
+        try:
+            sku, price, qty, category = line
+        except (TypeError, ValueError):
+            raise ShopError(f"bad invoice line {line!r}") from None
+        if not _is_integer(price) or price < 0 or not _is_integer(qty) or qty < 1:
+            raise ShopError(f"bad line {sku}")
+        if not isinstance(category, str) or category not in rates:
+            raise ShopError(f"unknown category {category!r}")
+        gross.append(price * qty)
+    total_gross = sum(gross)
+    coupon = min(coupon_cents, total_gross)
+    if total_gross == 0:
+        alloc = [0] * len(gross)
+    else:
+        alloc = [coupon * g // total_gross for g in gross]
+        rema = [coupon * g % total_gross for g in gross]
+        order = sorted(range(len(gross)), key=lambda i: (-rema[i], i))
+        for i in order[: coupon - sum(alloc)]:
+            alloc[i] += 1
+    out, total, any_taxed = [], 0, False
+    for (sku, _price, _qty, category), g, d in zip(lines, gross, alloc):
+        rate = rates[category]
+        any_taxed = any_taxed or rate > 0
+        net = g - d
+        tax = percent_of(net, rate)
+        out.append({"sku": sku, "gross_cents": g, "discount_cents": d, "net_cents": net, "tax_cents": tax})
+        total += net + tax
+    shipping_tax = percent_of(shipping_cents, rates["standard"]) if any_taxed else 0
+    return {"lines": out, "shipping_cents": shipping_cents, "shipping_tax_cents": shipping_tax,
+            "total_cents": total + shipping_cents + shipping_tax}
+
+
+def _is_integer(value) -> bool:
+    """True for integer inputs, excluding bool which is not a meaningful amount or qty."""
+    return isinstance(value, int) and not isinstance(value, bool)
diff --git a/tests/test_invoice.py b/tests/test_invoice.py
