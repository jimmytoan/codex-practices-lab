@@ -0,0 +1,61 @@
+import pytest
+
+from shoplib.errors import ShopError
+from shoplib.search import Product, search
+
+
+@pytest.fixture
+def products():
+    return [
+        Product("MUG-01", "Blue ceramic mug", 1200, ["kitchen", "sale"]),
+        Product("MUG-02", "Travel mug", 1800, ["outdoors"]),
+        Product("PLATE-01", "Blue dinner plate", 900, ["kitchen"]),
+    ]
+
+
+def test_empty_query_returns_all_products_in_input_order(products):
+    assert search(products, "  \t ") == products
+
+
+def test_bare_and_quoted_terms_are_case_insensitive_and_anded(products):
+    assert search(products, 'blue "ceramic mug"') == [products[0]]
+    assert search(products, '"blue ceramic"') == [products[0]]
+
+
+def test_field_terms_and_prefixes(products):
+    assert search(products, "sku:mug-01") == [products[0]]
+    assert search(products, "sku:MUG-*") == products[:2]
+    assert search(products, "tag:KITCHEN") == [products[0], products[2]]
+    assert search(products, "tag:out*") == [products[1]]
+    assert search(products, 'name:"travel mug"') == [products[1]]
+
+
+def test_quoted_field_value_can_contain_spaces(products):
+    assert search(products, 'name:"blue ceramic" tag:sale') == [products[0]]
+
+
+def test_whole_quoted_term_is_a_name_phrase_even_if_it_looks_like_syntax():
+    product = Product("A", "sku:MUG-01 price>=1000", 1000)
+    assert search([product], '"sku:MUG-01"') == [product]
+    assert search([product], '"price>=1000"') == [product]
+
+
+def test_price_comparisons_and_negation(products):
+    assert search(products, "price>=1200 price<1800") == [products[0]]
+    assert search(products, "-tag:sale") == products[1:]
+    assert search(products, "-price=900") == products[:2]
+
+
+@pytest.mark.parametrize(
+    "query",
+    ["price:5", "color:red", "tag:", "-", "price>=1.5", 'name:"unfinished'],
+)
+def test_invalid_queries_raise_shop_error(query, products):
+    with pytest.raises(ShopError):
+        search(products, query)
+
+
+def test_star_is_ordinary_except_at_end_of_sku_or_tag_value(products):
+    products[0].sku = "MUG*01"
+    assert search(products, "sku:MUG*01") == [products[0]]
+    assert search(products, "sku:MUG**") == [products[0]]
