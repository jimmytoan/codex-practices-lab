diff --git a/src/shoplib/dates.py b/src/shoplib/dates.py
index afe6759..81ee43b 100644
--- a/src/shoplib/dates.py
+++ b/src/shoplib/dates.py
@@ -20,10 +20,19 @@ def add_business_days(start: date, n: int, holidays=()) -> date:
 
     `start` does not have to be a business day.
     """
-    # TODO: holidays and negative n are not handled yet
+    if n == 0 and is_business_day(start, holidays):
+        return start
+
     day = start
-    while n > 0:
-        day += timedelta(days=1)
-        if day.weekday() < 5:
-            n -= 1
+    direction = 1 if n >= 0 else -1
+    remaining = abs(n)
+
+    # For n == 0 and a non-business start, find the first business day after it.
+    if remaining == 0:
+        remaining = 1
+
+    while remaining:
+        day += timedelta(days=direction)
+        if is_business_day(day, holidays):
+            remaining -= 1
     return day
diff --git a/tests/test_dates.py b/tests/test_dates.py
index fbfd5f2..d372b00 100644
--- a/tests/test_dates.py
+++ b/tests/test_dates.py
@@ -12,3 +12,22 @@ def test_forward_over_weekend():
     # Friday + 1 business day = Monday
     assert add_business_days(date(2026, 11, 13), 1) == date(2026, 11, 16)
     assert add_business_days(date(2026, 11, 16), 3) == date(2026, 11, 19)
+
+
+def test_holidays_are_skipped_in_both_directions():
+    holidays = {date(2026, 11, 16)}  # Monday
+    assert add_business_days(date(2026, 11, 13), 1, holidays) == date(2026, 11, 17)
+    assert add_business_days(date(2026, 11, 17), -1, holidays) == date(2026, 11, 13)
+
+
+def test_negative_business_days_are_strictly_before_start():
+    assert add_business_days(date(2026, 11, 16), -1) == date(2026, 11, 13)
+    assert add_business_days(date(2026, 11, 15), -1) == date(2026, 11, 13)
+
+
+def test_zero_returns_start_or_first_business_day_after():
+    assert add_business_days(date(2026, 11, 16), 0) == date(2026, 11, 16)
+    assert add_business_days(date(2026, 11, 15), 0) == date(2026, 11, 16)
+    assert add_business_days(
+        date(2026, 11, 15), 0, {date(2026, 11, 16)}
+    ) == date(2026, 11, 17)
