 def test_percent():
@@ -7,3 +12,65 @@ def test_percent():
 
 def test_fixed_never_negative():
     assert apply_coupon(300, Coupon("FIVE", "fixed", 500)) == 0
+
+
+def test_apply_coupons_uses_best_percent_then_all_eligible_fixed_coupons():
+    today = date(2026, 11, 18)
+    coupons = [
+        Coupon("PERCENT-10", "percent", 10),
+        Coupon("PERCENT-20", "percent", 20),
+        Coupon("FIXED-30", "fixed", 30),
+        Coupon("FIXED-40", "fixed", 40),
+    ]
+
+    assert apply_coupons(1000, coupons, today) == (730, [
+        "FIXED-30",
+        "FIXED-40",
+        "PERCENT-20",
+    ])
+
+
+def test_apply_coupons_breaks_percent_ties_by_code_and_sorts_applied_codes():
+    today = date(2026, 11, 18)
+    coupons = [
+        Coupon("ZETA", "percent", 25),
+        Coupon("ALPHA", "percent", 25),
+        Coupon("FIXED", "fixed", 100),
+    ]
+
+    assert apply_coupons(1000, coupons, today) == (650, ["ALPHA", "FIXED"])
+
+
+def test_apply_coupons_checks_expiry_and_minimum_against_original_subtotal():
+    today = date(2026, 11, 18)
+    coupons = [
+        Coupon("EXPIRES-TODAY", "fixed", 100, expires=today),
+        Coupon("EXPIRED", "fixed", 200, expires=date(2026, 11, 17)),
+        Coupon("MIN-MET", "fixed", 300, min_subtotal_cents=1000),
+        Coupon("MIN-NOT-MET", "fixed", 400, min_subtotal_cents=1001),
+        Coupon("PERCENT", "percent", 50),
+    ]
+
+    assert apply_coupons(1000, coupons, today) == (
+        100,
+        ["EXPIRES-TODAY", "MIN-MET", "PERCENT"],
+    )
+
+
+def test_apply_coupons_uses_half_up_percent_rounding_and_never_goes_below_zero():
+    today = date(2026, 11, 18)
+    coupons = [Coupon("TEN", "percent", 10), Coupon("TOO-MUCH", "fixed", 200)]
+
+    assert apply_coupons(5, coupons, today) == (0, ["TEN", "TOO-MUCH"])
+
+
+def test_apply_coupons_rejects_negative_subtotal():
+    with pytest.raises(ShopError, match="subtotal must not be negative"):
+        apply_coupons(-1, [], date(2026, 11, 18))
+
+
+def test_apply_coupons_rejects_unknown_coupon_kind():
+    coupon = Coupon("UNKNOWN", "bogus", 10)
+
+    with pytest.raises(ShopError, match="unknown coupon kind"):
+        apply_coupons(1000, [coupon], date(2026, 11, 18))
