diff --git a/src/shoplib/discounts.py b/src/shoplib/discounts.py
index d2804c4..8a8c8a5 100644
--- a/src/shoplib/discounts.py
+++ b/src/shoplib/discounts.py
@@ -30,4 +30,28 @@ def apply_coupon(subtotal_cents: int, coupon: Coupon) -> int:
 
 def apply_coupons(subtotal_cents: int, coupons: list[Coupon], today: date) -> tuple[int, list[str]]:
     """Apply several coupons following the rules in docs/discounts.md."""
-    raise NotImplementedError
+    if subtotal_cents < 0:
+        raise ValueError("subtotal must not be negative")
+
+    percent_coupons = []
+    fixed_coupons = []
+    for coupon in coupons:
+        if coupon.expires is not None and coupon.expires < today:
+            continue
+        if subtotal_cents < coupon.min_subtotal_cents:
+            continue
+        if coupon.kind == "percent":
+            percent_coupons.append(coupon)
+        elif coupon.kind == "fixed":
+            fixed_coupons.append(coupon)
+        else:
+            raise ValueError(f"unknown coupon kind {coupon.kind!r}")
+
+    total = subtotal_cents
+    applied_codes = [coupon.code for coupon in fixed_coupons]
+    if percent_coupons:
+        chosen = min(percent_coupons, key=lambda coupon: (-coupon.value, coupon.code))
+        total -= percent_of(subtotal_cents, chosen.value)
+        applied_codes.append(chosen.code)
+    total -= sum(coupon.value for coupon in fixed_coupons)
+    return max(total, 0), sorted(applied_codes)
diff --git a/tests/test_discounts.py b/tests/test_discounts.py
index 5b20e73..de9e7b6 100644
--- a/tests/test_discounts.py
+++ b/tests/test_discounts.py
@@ -1,4 +1,8 @@
-from shoplib.discounts import Coupon, apply_coupon
+from datetime import date, timedelta
+
+import pytest
+
+from shoplib.discounts import Coupon, apply_coupon, apply_coupons
 
 
 def test_percent():
@@ -7,3 +11,54 @@ def test_percent():
 
 def test_fixed_never_negative():
     assert apply_coupon(300, Coupon("FIVE", "fixed", 500)) == 0
+
+
+def test_combines_best_percent_and_all_eligible_fixed_coupons():
+    today = date(2026, 1, 10)
+    coupons = [
+        Coupon("Z_TEN", "percent", 10),
+        Coupon("A_TEN", "percent", 10),
+        Coupon("FIVE_PERCENT", "percent", 5),
+        Coupon("FIXED_Z", "fixed", 100, min_subtotal_cents=1000),
+        Coupon("FIXED_A", "fixed", 50, expires=today),
+        Coupon("EXPIRED", "fixed", 500, expires=today - timedelta(days=1)),
+        Coupon("TOO_SMALL", "fixed", 500, min_subtotal_cents=1001),
+        Coupon("EXPIRED_PERCENT", "percent", 90, expires=today - timedelta(days=1)),
+        Coupon("MIN_PERCENT", "percent", 90, min_subtotal_cents=1001),
+    ]
+
+    assert apply_coupons(1000, coupons, today) == (
+        750, ["A_TEN", "FIXED_A", "FIXED_Z"]
+    )
+
+
+def test_percent_rounds_half_up_before_fixed_discount():
+    coupons = [Coupon("HALF", "percent", 50), Coupon("ONE", "fixed", 1)]
+    assert apply_coupons(5, coupons, date(2026, 1, 1)) == (1, ["HALF", "ONE"])
+
+
+def test_total_is_capped_at_zero_and_all_eligible_codes_are_reported():
+    coupons = [
+        Coupon("PERCENT", "percent", 100),
+        Coupon("FIXED", "fixed", 500),
+        Coupon("FIXED", "fixed", 100),
+    ]
+    assert apply_coupons(100, coupons, date(2026, 1, 1)) == (
+        0, ["FIXED", "FIXED", "PERCENT"]
+    )
+
+
+def test_no_eligible_coupons_leaves_subtotal_unchanged():
+    today = date(2026, 1, 1)
+    assert apply_coupons(100, [], today) == (100, [])
+    assert apply_coupons(100, [Coupon("NO", "fixed", 50, min_subtotal_cents=101)], today) == (100, [])
+
+
+def test_negative_subtotal_raises_even_without_coupons():
+    with pytest.raises(ValueError, match="subtotal"):
+        apply_coupons(-1, [], date(2026, 1, 1))
+
+
+def test_unknown_eligible_coupon_kind_raises():
+    with pytest.raises(ValueError, match="unknown coupon kind"):
+        apply_coupons(100, [Coupon("BAD", "other", 10)], date(2026, 1, 1))
