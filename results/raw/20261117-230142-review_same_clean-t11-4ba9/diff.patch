--- /dev/null
+++ b/tests/test_invoice.py
@@ -0,0 +1,80 @@
+import pytest
+
+from shoplib.errors import ShopError
+from shoplib.invoice import build_invoice
+
+
+def test_coupon_allocation_and_line_taxes():
+    invoice = build_invoice(
+        [("a", 50, 2, "standard"), ("b", 100, 1, "food"),
+         ("c", 100, 1, "books")],
+        2, 50, "SG",
+    )
+    assert invoice == {
+        "lines": [
+            {"sku": "a", "gross_cents": 100, "discount_cents": 1,
+             "net_cents": 99, "tax_cents": 9},
+            {"sku": "b", "gross_cents": 100, "discount_cents": 1,
+             "net_cents": 99, "tax_cents": 9},
+            {"sku": "c", "gross_cents": 100, "discount_cents": 0,
+             "net_cents": 100, "tax_cents": 0},
+        ],
+        "shipping_cents": 50,
+        "shipping_tax_cents": 5,
+        "total_cents": 371,
+    }
+
+
+def test_largest_remainder_precedes_input_order():
+    invoice = build_invoice(
+        [("small", 1, 1, "food"), ("large", 2, 1, "food")], 1, 0, "OR"
+    )
+    assert [line["discount_cents"] for line in invoice["lines"]] == [0, 1]
+    assert invoice["total_cents"] == 2
+
+
+def test_coupon_is_capped_at_gross():
+    invoice = build_invoice(
+        [("a", 1, 1, "standard"), ("b", 2, 1, "food")], 10, 10, "DE"
+    )
+    assert [line["discount_cents"] for line in invoice["lines"]] == [1, 2]
+    assert [line["tax_cents"] for line in invoice["lines"]] == [0, 0]
+    assert invoice["shipping_tax_cents"] == 2
+    assert invoice["total_cents"] == 12
+
+
+def test_zero_gross_has_zero_discounts_and_taxable_shipping():
+    invoice = build_invoice(
+        [("a", 0, 2, "standard"), ("b", 0, 1, "books")], 10, 50, "SG"
+    )
+    assert [line["discount_cents"] for line in invoice["lines"]] == [0, 0]
+    assert invoice["shipping_tax_cents"] == 5
+    assert invoice["total_cents"] == 55
+
+
+def test_tax_rounds_per_line_and_shipping_is_untaxed_for_exempt_lines():
+    taxable = build_invoice(
+        [("a", 50, 1, "standard"), ("b", 50, 1, "food")], 0, 0, "SG"
+    )
+    assert [line["tax_cents"] for line in taxable["lines"]] == [5, 5]
+    assert taxable["total_cents"] == 110
+    exempt = build_invoice([("book", 100, 1, "books")], 0, 50, "SG")
+    assert exempt["shipping_tax_cents"] == 0
+    assert exempt["total_cents"] == 150
+
+
+@pytest.mark.parametrize(
+    "lines,coupon,shipping,region",
+    [
+        ([("a", 1, 1, "food")], 0, 0, "unknown"),
+        ([], 0, 0, "DE"),
+        ([("a", 1, 1, "food")], -1, 0, "DE"),
+        ([("a", 1, 1, "food")], 0, -1, "DE"),
+        ([("a", 1, 0, "food")], 0, 0, "DE"),
+        ([("a", -1, 1, "food")], 0, 0, "DE"),
+        ([("a", 1, 1, "unknown")], 0, 0, "DE"),
+    ],
+)
+def test_invalid_arguments_raise_shop_error(lines, coupon, shipping, region):
+    with pytest.raises(ShopError):
+        build_invoice(lines, coupon, shipping, region)
