+++ b/tests/test_storedays.py
@@ -0,0 +1,43 @@
+import pytest
+
+from shoplib.errors import ShopError
+from shoplib.storedays import daily_revenue
+
+
+def test_daily_revenue_assigns_local_days_and_fills_gaps():
+    sales = [
+        {"at": "2026-11-18T02:30:00+08:00", "cents": 100},
+        {"at": "2026-11-17T20:00:00Z", "cents": 50},
+        {"at": "2026-11-19T02:00:00+08:00", "cents": -25},
+        {"at": "2026-11-21T04:00:00+08:00", "cents": 70},
+    ]
+
+    assert daily_revenue(sales) == [
+        ("2026-11-17", 100),
+        ("2026-11-18", 25),
+        ("2026-11-19", 0),
+        ("2026-11-20", 0),
+        ("2026-11-21", 70),
+    ]
+
+
+def test_daily_revenue_uses_configured_offset_and_start_hour():
+    sales = [
+        {"at": "2026-11-18T04:00:00+02:00", "cents": 15},
+        {"at": "2026-11-18T05:00:00+02:00", "cents": 30},
+    ]
+
+    assert daily_revenue(sales, utc_offset_hours=-5, day_starts_hour=0) == [
+        ("2026-11-17", 45),
+    ]
+
+
+def test_daily_revenue_without_sales_is_empty():
+    assert daily_revenue([]) == []
+
+
+def test_daily_revenue_rejects_timestamp_without_zone():
+    with pytest.raises(ShopError) as error:
+        daily_revenue([{"at": "2026-11-18T02:30:00", "cents": 100}])
+
+    assert isinstance(error.value, ValueError)
