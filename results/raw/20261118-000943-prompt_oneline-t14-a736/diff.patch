@@ -0,0 +1,48 @@
+import pytest
+
+from shoplib.errors import ShopError
+from shoplib.storedays import daily_revenue
+
+
+def test_store_days_include_boundaries_refunds_and_gaps():
+    sales = [
+        {"at": "2026-11-20T04:00:00+08:00", "cents": 700},
+        {"at": "2026-11-17T18:30:00Z", "cents": 500},
+        {"at": "2026-11-17T20:00:00Z", "cents": 300},
+        {"at": "2026-11-18T00:00:00-04:00", "cents": -100},
+    ]
+    assert daily_revenue(sales) == [
+        ("2026-11-17", 500),
+        ("2026-11-18", 200),
+        ("2026-11-19", 0),
+        ("2026-11-20", 700),
+    ]
+
+
+def test_custom_offset_and_start_and_empty_sales():
+    sales = [
+        {"at": "2026-01-01T04:59:59Z", "cents": 10},
+        {"at": "2026-01-01T05:00:00Z", "cents": 20},
+    ]
+    assert daily_revenue(sales, utc_offset_hours=-5, day_starts_hour=0) == [
+        ("2025-12-31", 10), ("2026-01-01", 20)
+    ]
+    assert daily_revenue([]) == []
+
+
+@pytest.mark.parametrize("timestamp", [
+    "2026-11-18T02:30:00", "invalid", "2026-11-18T02:30:00+08:99",
+    "2026-02-30T02:30:00Z", "2026-11-18T02:30:00+0800",
+])
+def test_invalid_timestamp_raises_shop_error(timestamp):
+    with pytest.raises(ShopError):
+        daily_revenue([{"at": timestamp, "cents": 1}])
+
+
+@pytest.mark.parametrize("sales,offset,start", [
+    (None, 8, 4), ([], 8.0, 4), ([], 8, 24), ([], 8, -1),
+    ([{}], 8, 4), ([{"at": "2026-11-18T00:00:00Z", "cents": 1.5}], 8, 4),
+])
+def test_invalid_arguments_raise_shop_error(sales, offset, start):
+    with pytest.raises(ShopError):
+        daily_revenue(sales, offset, start)
