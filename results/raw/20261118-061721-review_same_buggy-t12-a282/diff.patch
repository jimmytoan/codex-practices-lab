@@ -0,0 +1,57 @@
+import pytest
+
+from shoplib.errors import ShopError
+from shoplib.search import Product, search
+
+
+@pytest.fixture
+def products():
+    return [
+        Product("MUG-RED", "Blue Ceramic Mug", 1200, ["Kitchen", "Sale"]),
+        Product("mug-BLACK", "Blue Mug", 900, ["KITCHEN", "clearance"]),
+        Product("PLATE", "Ceramic Plate", 1500, ["Kitchenware", "Sale*"]),
+    ]
+
+
+def test_empty_queries_and_bare_quoted_and_name_terms(products):
+    assert search(products, "") == products
+    assert search(products, " \t\n") == products
+    assert search(products, "mUg") == products[:2]
+    assert search(products, '"blue ceramic"') == products[:1]
+    assert search(products, "name:ceramic") == [products[0], products[2]]
+    assert search(products, 'name:"blue mug"') == [products[1]]
+
+
+def test_sku_and_tag_matching_are_case_insensitive_with_prefixes(products):
+    assert search(products, "sku:mug-red") == products[:1]
+    assert search(products, "sku:MUG-*") == products[:2]
+    assert search(products, "tag:kitchen") == products[:2]
+    assert search(products, "tag:KIT*") == products
+    assert search(products, "tag:sale**") == [products[2]]
+
+
+def test_negation_and_price_comparisons(products):
+    assert search(products, "-tag:SALE") == products[1:]
+    assert search(products, '-"blue ceramic"') == products[1:]
+    assert search(products, "price<1200") == [products[1]]
+    assert search(products, "price<=1200") == products[:2]
+    assert search(products, "price>1200") == [products[2]]
+    assert search(products, "price>=1200") == [products[0], products[2]]
+    assert search(products, "price=1200") == [products[0]]
+
+
+@pytest.mark.parametrize(
+    "query",
+    [
+        "price:5",
+        "tag:",
+        "price=",
+        "price>1.5",
+        "-",
+        '-""',
+        'name:"unclosed',
+    ],
+)
+def test_invalid_queries_raise_shop_error(query, products):
+    with pytest.raises(ShopError):
+        search(products, query)
