@@ -0,0 +1,50 @@
+import pytest
+
+from shoplib.errors import ShopError
+from shoplib.search import Product, search
+
+
+@pytest.fixture
+def products():
+    return [
+        Product("MUG-RED", "Blue Mug Large", 1200, ["drinkware", "sale"]),
+        Product("MUG-BLUE", "Blue Cup", 800, ["drinkware"]),
+        Product("PLATE-RED", "Red Plate", 1500, ["dinnerware", "sale"]),
+    ]
+
+
+def test_search_terms_fields_and_quotes(products):
+    assert search(products, "blue") == products[:2]
+    assert search(products, '"blue mug"') == products[:1]
+    assert search(products, 'name:"BLUE MUG"') == products[:1]
+    assert search(products, "sku:mug-red") == products[:1]
+    assert search(products, "tag:SALE") == [products[0], products[2]]
+    assert search(products, "tag:drink*") == products[:2]
+    assert search(products, "sku:MUG-*") == products[:2]
+
+
+def test_search_negation_price_and_empty_query(products):
+    assert search(products, "blue -tag:sale") == products[1:2]
+    assert search(products, "price<1000") == products[1:2]
+    assert search(products, "price<=800") == products[1:2]
+    assert search(products, "price>1200") == products[2:]
+    assert search(products, "price>=1200") == [products[0], products[2]]
+    assert search(products, "price=1200") == products[:1]
+    assert search(products, "") == products
+    assert search(products, "  \t ") == products
+
+
+@pytest.mark.parametrize(
+    "query",
+    ["other:5", "price:5", "tag:", "price>=", "price>1.5", "-", '"unfinished'],
+)
+def test_search_rejects_invalid_queries(products, query):
+    with pytest.raises(ShopError):
+        search(products, query)
+
+
+def test_asterisk_is_literal_unless_it_is_the_final_character(products):
+    product = Product("STAR*SKU", "Star* Mug", 100, ["star*tag"])
+    assert search([product], "sku:star*sku") == [product]
+    assert search([product], "tag:star*tag") == [product]
+    assert search([product], 'name:"star* mug"') == [product]
