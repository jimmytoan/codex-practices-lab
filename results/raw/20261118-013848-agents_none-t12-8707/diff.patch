@@ -0,0 +1,77 @@
+import pytest
+
+from shoplib.search import Product, search
+
+
+@pytest.fixture
+def products():
+    return [
+        Product("MUG-BLUE", "Blue ceramic mug", 1000, ["Kitchen", "Sale"]),
+        Product("mug-red", "Red Mug", 1500, ["kitchenware", "Gift"]),
+        Product("BOWL-1", "BLUE bowl", 500, ["sale", "MUG*special"]),
+        Product("MUG-*", "A name: with punctuation", 0, []),
+    ]
+
+
+@pytest.mark.parametrize("query, indexes", [
+    ("", [0, 1, 2, 3]),
+    (" \t\n ", [0, 1, 2, 3]),
+    ("mUg", [0, 1]),
+    ('"blue ceramic"', [0]),
+    ('name:"BLUE ceramic"', [0]),
+    ('"name: with punctuation"', [3]),
+    ('"-not a command"', []),
+    ("sku:mug-blue", [0]),
+    ("sku:MUG", []),
+    ("sku:MUG-*", [0, 1, 3]),
+    ("sku:MUG-*x", []),
+    ("tag:KITCHEN", [0]),
+    ("tag:kitchen*", [0, 1]),
+    ("tag:mug*special", [2]),
+    ("name:MuG", [0, 1]),
+    ("name:mug*", []),
+    ("price<1000", [2, 3]),
+    ("price<=1000", [0, 2, 3]),
+    ("price>1000", [1]),
+    ("price>=1000", [0, 1]),
+    ("price=1000", [0]),
+    ("price=0000", [3]),
+    ("-tag:sale", [1, 3]),
+    ("-price>=1000", [2, 3]),
+    ('mug tag:kitchen* -name:"red mug" price>=1000', [0]),
+    ('sku:"mug-blue"', [0]),
+    ("--mug", [0, 1, 2, 3]),
+])
+def test_matching(products, query, indexes):
+    assert search(products, query) == [products[i] for i in indexes]
+
+
+@pytest.mark.parametrize("query", [
+    "other:value", "price:5", ":value", "tag:", 'name:""', "sku:",
+    "-", '-""', '"unclosed', 'tag:"unclosed',
+    "price=", "price<foo", "price<=1.5", "price>-1", "price=+1",
+    "price==1", 'price<"=1"', "price>=1x", "price=1,000",
+    "nomatch tag:", "nomatch price=bad", 'nomatch "unclosed',
+])
+def test_invalid_queries_raise_even_with_no_products(products, query):
+    for collection in (products, []):
+        with pytest.raises(ValueError):
+            search(collection, query)
+
+
+def test_case_insensitive_matching_and_order():
+    first = Product("Straße", "Straße", 1, ["Straße"])
+    second = Product("STRASSE", "STRASSE", 2, ["STRASSE"])
+    assert search([second, first, first], "strasse tag:STRASSE sku:strasse") == [
+        second, first, first
+    ]
+
+
+def test_quoted_whitespace_and_literal_punctuation():
+    product = Product("A B", "one\ttwo: three", 5, ["big sale"])
+    assert search([product], 'sku:"A B" tag:"big sale" "one\ttwo: three"') == [product]
+
+
+def test_large_whole_number_price():
+    product = Product("large", "large", 10 ** 5000)
+    assert search([product], "price=" + "1" + "0" * 5000) == [product]
