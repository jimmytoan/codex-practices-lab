 @dataclass
@@ -13,4 +15,87 @@ class Product:
 
 def search(products: list[Product], query: str) -> list[Product]:
     """The products that match `query`, in their input order. See docs/search.md."""
-    raise NotImplementedError
+    terms = [_parse_term(chars) for chars in _tokens(query)]
+    return [product for product in products if all(term(product) for term in terms)]
+
+
+def _tokens(query: str):
+    """Yield characters with their quoted state, retaining empty quoted tokens."""
+    chars = []
+    quoted = False
+    started = False
+    for char in query:
+        if char == '"':
+            quoted = not quoted
+            started = True
+        elif char.isspace() and not quoted:
+            if started:
+                yield chars
+                chars = []
+                started = False
+        else:
+            chars.append((char, quoted))
+            started = True
+    if quoted:
+        raise ValueError("unclosed quote")
+    if started:
+        yield chars
+
+
+def _parse_term(chars):
+    negated = bool(chars and chars[0] == ("-", False))
+    if negated:
+        chars = chars[1:]
+        if not chars:
+            raise ValueError("empty negated term")
+
+    text = "".join(char for char, _ in chars)
+    colon = next((i for i, (char, quoted) in enumerate(chars)
+                  if char == ":" and not quoted), None)
+    if colon is not None:
+        field_name = text[:colon]
+        value = text[colon + 1:].casefold()
+        if field_name not in ("sku", "name", "tag"):
+            raise ValueError("unknown field")
+        if not value:
+            raise ValueError("empty field value")
+        if field_name == "name":
+            matches = lambda product: value in product.name.casefold()
+        else:
+            prefix = value.endswith("*")
+            if prefix:
+                value = value[:-1]
+
+            def field_matches(candidate):
+                candidate = candidate.casefold()
+                return candidate.startswith(value) if prefix else candidate == value
+
+            if field_name == "sku":
+                matches = lambda product: field_matches(product.sku)
+            else:
+                matches = lambda product: any(field_matches(tag) for tag in product.tags)
+    elif (len(chars) > 5 and text.startswith("price")
+          and all(not quoted for _, quoted in chars[:6])
+          and text[5] in "<>="):
+        op = text[5]
+        if op in "<>" and len(chars) > 6 and chars[6] == ("=", False):
+            op += "="
+        value = text[5 + len(op):]
+        if not re.fullmatch(r"[0-9]+", value):
+            raise ValueError("invalid price")
+        # Convert in chunks so valid long integers are not limited by Python's
+        # configurable limit on decimal string-to-int conversion.
+        amount = 0
+        for start in range(0, len(value), 9):
+            chunk = value[start:start + 9]
+            amount = amount * 10 ** len(chunk) + int(chunk)
+        compare = {"<": operator.lt, "<=": operator.le, ">": operator.gt,
+                   ">=": operator.ge, "=": operator.eq}[op]
+        matches = lambda product: compare(product.price_cents, amount)
+    else:
+        value = text.casefold()
+        matches = lambda product: value in product.name.casefold()
+
+    if negated:
+        return lambda product: not matches(product)
+    return matches
