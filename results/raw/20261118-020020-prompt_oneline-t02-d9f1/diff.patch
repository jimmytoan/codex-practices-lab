-    with pytest.raises(ValueError):
+    with pytest.raises(ShopError):
         Cart().add("A", 250, 0)
+
+
+def test_bulk_discount_threshold_and_subtotal():
+    cart = Cart()
+    cart.add("A", 100, 9)
+    cart.add("B", 100, 10)
+    cart.add("C", 100, 11)
+    assert cart.line_total("A") == 900
+    assert cart.line_total("B") == 950
+    assert cart.line_total("C") == 1045
+    assert cart.subtotal() == 2895
+
+
+def test_bulk_discount_applies_after_quantities_merge():
+    cart = Cart()
+    cart.add("A", 250, 6)
+    cart.add("A", 250, 4)
+    assert cart.line_total("A") == 2375
+
+
+def test_bulk_discount_rounds_half_up_per_line():
+    cart = Cart()
+    cart.add("A", 1, 10)
+    cart.add("B", 1, 10)
+    assert cart.line_total("A") == 9
+    assert cart.line_total("B") == 9
+    assert cart.subtotal() == 18
