+++ b/tests/test_search.py
@@ -0,0 +1,68 @@
+import pytest
+
+from shoplib.search import Product, search
+
+
+@pytest.fixture
+def products():
+    return [
+        Product("MUG-01", "Blue Ceramic Mug", 1250, ["kitchen", "sale"]),
+        Product("MUG-02", "Blue Travel Cup", 900, ["travel"]),
+        Product("PLATE-01", "Ceramic Plate", 1500, ["kitchen"]),
+    ]
+
+
+def test_empty_query_and_bare_terms_preserve_input_order(products):
+    assert search(products, "  \t") == products
+    assert search(products, "blue ceramic") == [products[0]]
+
+
+def test_quotes_keep_whitespace_in_a_phrase_or_field_value(products):
+    assert search(products, '"blue travel"') == [products[1]]
+    assert search(products, 'name:"blue ceramic"') == [products[0]]
+
+
+def test_fields_are_case_insensitive_and_support_terminal_prefix_wildcards(products):
+    assert search(products, "sku:mug-01") == [products[0]]
+    assert search(products, "tag:KITCHEN") == [products[0], products[2]]
+    assert search(products, "sku:MUG-*") == products[:2]
+    assert search(products, "tag:trav*") == [products[1]]
+
+
+@pytest.mark.parametrize(
+    ("query", "expected"),
+    [
+        ("price<900", []),
+        ("price<=900", [1]),
+        ("price>900", [0, 2]),
+        ("price>=1500", [2]),
+        ("price=1250", [0]),
+    ],
+)
+def test_price_comparisons(query, expected, products):
+    assert search(products, query) == [products[index] for index in expected]
+
+
+def test_negation_applies_to_one_term_and_terms_are_conjoined(products):
+    assert search(products, "blue -tag:sale") == [products[1]]
+    assert search(products, "-price>=1250") == [products[1]]
+
+
+@pytest.mark.parametrize(
+    "query",
+    [
+        "unknown:value",
+        "price:5",
+        "tag:",
+        'tag:""',
+        "-",
+        '"unclosed',
+        "price>",
+        "price>=1.5",
+        "price=-1",
+        "price=1x",
+    ],
+)
+def test_invalid_queries_raise_value_error(query, products):
+    with pytest.raises(ValueError):
+        search(products, query)
