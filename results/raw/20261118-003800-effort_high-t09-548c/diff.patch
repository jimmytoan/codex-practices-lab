--- a/tests/test_textutil.py
+++ b/tests/test_textutil.py
@@ -1,3 +1,6 @@
+import pytest
+
+from shoplib.errors import ShopError
 from shoplib.textutil import slugify, truncate
 
 
@@ -6,6 +9,53 @@ def test_slugify_basic():
     assert slugify("!!!") == "n-a"
 
 
+@pytest.mark.parametrize(
+    ("text", "expected"),
+    [
+        ("Crème Brûlée", "creme-brulee"),
+        ("CRE\u0300ME BRU\u0302LE\u0301E", "creme-brulee"),
+        ("Łódź and smørrebrød", "lodz-and-smorrebrod"),
+        ("Ǿresund", "oresund"),
+        ("--Café!!! 42__Tea--", "cafe-42-tea"),
+        ("a\u0301b", "ab"),
+        ("1\u0301b", "1-b"),
+        ("a 中\u0301 b", "a-b"),
+        ("!!!", "n-a"),
+        ("中文 🌸", "n-a"),
+        ("", "n-a"),
+    ],
+)
+def test_slugify_normalization_and_separators(text, expected):
+    assert slugify(text) == expected
+
+
+def test_slugify_length_limit_is_applied_after_normalization():
+    assert slugify("Éléphant and tea", 4) == "elep"
+    assert slugify("Crème brûlée", 6) == "creme"
+    assert slugify("Éclair", 1) == "e"
+    assert slugify("Éclair", 2) == "ec"
+    assert slugify("a" * 41) == "a" * 40
+    assert slugify("a" * 41, 50) == "a" * 41
+    assert slugify("!!!", 3) == "n-a"
+
+
+@pytest.mark.parametrize("max_len", [0, -1, 1.5, True, None])
+def test_slugify_rejects_invalid_length(max_len):
+    with pytest.raises(ShopError):
+        slugify("test", max_len)
+
+
+@pytest.mark.parametrize("max_len", [1, 2])
+def test_slugify_rejects_limit_too_short_for_fallback(max_len):
+    with pytest.raises(ShopError):
+        slugify("!!!", max_len)
+
+
+def test_slugify_rejects_non_text():
+    with pytest.raises(ShopError):
+        slugify(None)
+
+
 def test_truncate():
     assert truncate("hello world", 8) == "hello..."
     assert truncate("short", 8) == "short"
