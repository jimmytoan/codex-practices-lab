@@ -0,0 +1,89 @@
+import pytest
+
+from shoplib.errors import ShopError
+from shoplib.search import Product, search
+
+
+@pytest.fixture
+def products():
+    return [
+        Product("MUG-Blue", "Blue Mug", 1000, ["Sale", "Kitchenware"]),
+        Product("mug-red", "Red Mug", 1500, ["Kitchen"]),
+        Product("PLATE", "Blue Plate", 999, ["SALE", "A*B"]),
+        Product("MUG-*literal", "Star * Mug", 0),
+    ]
+
+
+@pytest.mark.parametrize(
+    ("query", "indices"),
+    [
+        ("", [0, 1, 2, 3]),
+        (" \t\n", [0, 1, 2, 3]),
+        ("MuG", [0, 1, 3]),
+        ('"blue mug"', [0]),
+        ('name:"BLUE MUG"', [0]),
+        ('"blue plate" tag:sale', [2]),
+        ("sku:mug-blue", [0]),
+        ("sku:mug", []),
+        ("sku:MUG-*", [0, 1, 3]),
+        ("sku:MUG-*literal", [3]),
+        ("sku:MUG-**", [3]),
+        ("tag:SALE", [0, 2]),
+        ("tag:kitchen", [1]),
+        ("tag:KIT*", [0, 1]),
+        ("tag:A*B", [2]),
+        ("name:MuG", [0, 1, 3]),
+        ("name:*", [3]),
+        ("blue tag:sale", [0, 2]),
+        ("mug -tag:sale", [1, 3]),
+        ('-name:"blue mug"', [1, 2, 3]),
+        ("-sku:mug-*", [2]),
+        ("-blue", [1, 3]),
+        ("price<1000", [2, 3]),
+        ("price<=1000", [0, 2, 3]),
+        ("price>1000", [1]),
+        ("price>=1000", [0, 1]),
+        ("price=1000", [0]),
+        ("price=0000", [3]),
+        ("-price>=1000", [2, 3]),
+        ("mug price>=1000 price<1500", [0]),
+    ],
+)
+def test_search_terms(products, query, indices):
+    assert search(products, query) == [products[index] for index in indices]
+
+
+@pytest.mark.parametrize(
+    "query",
+    [
+        "other:value", "price:5", ":value", "SKU:abc",
+        "tag:", 'tag:""', "name:", "sku:", "-tag:",
+        "-", '-""', '"unclosed', 'name:"unclosed',
+        "price<", "price>=1.5", "price=abc", "price=-1", "price=+1",
+        "price==10", "price><10", "price=1e3", 'price="1 0"',
+    ],
+)
+@pytest.mark.parametrize("has_products", [False, True])
+def test_invalid_queries_raise_shop_error(products, query, has_products):
+    with pytest.raises(ShopError):
+        search(products if has_products else [], query)
+
+
+def test_all_terms_are_validated_even_if_an_earlier_term_matches_nothing(products):
+    with pytest.raises(ShopError):
+        search(products, "absent tag:")
+
+
+def test_preserves_order_and_does_not_modify_products(products):
+    original = products.copy()
+    assert search(products, "blue") == [products[0], products[2]]
+    assert products == original
+
+
+def test_whitespace_in_quotes_and_unicode_casefold():
+    products = [Product("STRAßE", "Blue\tMug", 1, ["GRÜN"])]
+    assert search(products, 'name:"blue\tmug" sku:strasse tag:grün') == products
+
+
+def test_long_integer_price_is_valid(products):
+    assert search(products, "price<" + "9" * 5000) == products
