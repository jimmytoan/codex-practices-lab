diff --git a/src/shoplib/invoice.py b/src/shoplib/invoice.py
index 5d1398c..36cd52f 100644
--- a/src/shoplib/invoice.py
+++ b/src/shoplib/invoice.py
@@ -1,5 +1,8 @@
 """Invoices: coupon allocation and tax. See docs/invoicing.md."""
 
+from .errors import ShopError
+from .money import percent_of
+
 # Tax rates in percent, by region and product category.
 TAX_RATES = {
     "DE": {"standard": 19, "food": 7, "books": 7},
@@ -10,4 +13,53 @@ TAX_RATES = {
 
 def build_invoice(lines, coupon_cents: int, shipping_cents: int, region: str) -> dict:
     """Build an invoice for an order. See docs/invoicing.md."""
-    raise NotImplementedError
+    if region not in TAX_RATES:
+        raise ShopError("unknown region")
+    if not lines:
+        raise ShopError("lines must not be empty")
+    if coupon_cents < 0 or shipping_cents < 0:
+        raise ShopError("coupon and shipping must not be negative")
+
+    rates = TAX_RATES[region]
+    grosses = []
+    for sku, price, qty, category in lines:
+        if category not in rates:
+            raise ShopError("unknown category")
+        if price < 0 or qty < 1:
+            raise ShopError("invalid price or quantity")
+        grosses.append(price * qty)
+
+    total_gross = sum(grosses)
+    coupon = min(coupon_cents, total_gross)
+    discounts = [0] * len(lines)
+    if total_gross:
+        shares = [divmod(coupon * gross, total_gross) for gross in grosses]
+        discounts = [share for share, _ in shares]
+        remaining = coupon - sum(discounts)
+        order = sorted(range(len(lines)), key=lambda i: (-shares[i][1], i))
+        for i in order[:remaining]:
+            discounts[i] += 1
+
+    invoice_lines = []
+    for (sku, _, _, category), gross, discount in zip(lines, grosses, discounts):
+        net = gross - discount
+        invoice_lines.append({
+            "sku": sku,
+            "gross_cents": gross,
+            "discount_cents": discount,
+            "net_cents": net,
+            "tax_cents": percent_of(net, rates[category]),
+        })
+
+    shipping_tax = (
+        percent_of(shipping_cents, rates["standard"])
+        if any(rates[category] > 0 for _, _, _, category in lines)
+        else 0
+    )
+    total = sum(line["net_cents"] + line["tax_cents"] for line in invoice_lines)
+    return {
+        "lines": invoice_lines,
+        "shipping_cents": shipping_cents,
+        "shipping_tax_cents": shipping_tax,
+        "total_cents": total + shipping_cents + shipping_tax,
+    }
diff --git a/tests/test_invoice.py b/tests/test_invoice.py
new file mode 100644
index 0000000..9736a3d
--- /dev/null
+++ b/tests/test_invoice.py
@@ -0,0 +1,85 @@
+import pytest
+
+from shoplib.errors import ShopError
+from shoplib.invoice import build_invoice
+
+
+def test_coupon_allocation_and_invoice_totals():
+    invoice = build_invoice(
+        [("A", 101, 2, "standard"), ("B", 100, 1, "food")],
+        53,
+        100,
+        "DE",
+    )
+    assert invoice == {
+        "lines": [
+            {"sku": "A", "gross_cents": 202, "discount_cents": 35,
+             "net_cents": 167, "tax_cents": 32},
+            {"sku": "B", "gross_cents": 100, "discount_cents": 18,
+             "net_cents": 82, "tax_cents": 6},
+        ],
+        "shipping_cents": 100,
+        "shipping_tax_cents": 19,
+        "total_cents": 406,
+    }
+
+
+def test_equal_remainders_go_to_earlier_lines():
+    invoice = build_invoice(
+        [("same", 1, 1, "books"), ("same", 1, 1, "books"),
+         ("last", 1, 1, "books")], 2, 0, "SG"
+    )
+    assert [line["discount_cents"] for line in invoice["lines"]] == [1, 1, 0]
+    assert invoice["total_cents"] == 1
+
+
+def test_coupon_is_capped_at_gross():
+    invoice = build_invoice(
+        [("A", 20, 2, "standard"), ("B", 10, 1, "food")], 100, 0, "DE"
+    )
+    assert [line["discount_cents"] for line in invoice["lines"]] == [40, 10]
+    assert invoice["total_cents"] == 0
+
+
+def test_zero_gross_has_no_discount_but_taxable_category_taxes_shipping():
+    invoice = build_invoice(
+        [("A", 0, 1, "standard"), ("B", 0, 2, "books")], 10, 100, "SG"
+    )
+    assert [line["discount_cents"] for line in invoice["lines"]] == [0, 0]
+    assert invoice["shipping_tax_cents"] == 9
+    assert invoice["total_cents"] == 109
+
+
+def test_tax_rounds_per_line_and_shipping():
+    invoice = build_invoice(
+        [("A", 50, 1, "standard"), ("B", 50, 1, "standard")], 0, 50, "DE"
+    )
+    assert [line["tax_cents"] for line in invoice["lines"]] == [10, 10]
+    assert invoice["shipping_tax_cents"] == 10
+    assert invoice["total_cents"] == 180
+
+
+@pytest.mark.parametrize("region, category", [("SG", "books"), ("OR", "standard")])
+def test_untaxed_categories_do_not_tax_shipping(region, category):
+    invoice = build_invoice([("A", 100, 1, category)], 0, 100, region)
+    assert invoice["lines"][0]["tax_cents"] == 0
+    assert invoice["shipping_tax_cents"] == 0
+    assert invoice["total_cents"] == 200
+
+
+@pytest.mark.parametrize(
+    "lines, coupon, shipping, region",
+    [
+        ([("A", 100, 1, "standard")], 0, 0, "unknown"),
+        ([("A", 100, 1, "unknown")], 0, 0, "DE"),
+        ([], 0, 0, "DE"),
+        ([("A", 100, 0, "standard")], 0, 0, "DE"),
+        ([("A", 100, -1, "standard")], 0, 0, "DE"),
+        ([("A", -1, 1, "standard")], 0, 0, "DE"),
+        ([("A", 100, 1, "standard")], -1, 0, "DE"),
+        ([("A", 100, 1, "standard")], 0, -1, "DE"),
+    ],
+)
+def test_invalid_arguments_raise_shop_error(lines, coupon, shipping, region):
+    with pytest.raises(ShopError):
+        build_invoice(lines, coupon, shipping, region)
