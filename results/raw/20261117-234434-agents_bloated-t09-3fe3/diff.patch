@@ -1,3 +1,6 @@
+import pytest
+
+from shoplib.errors import ShopError
 from shoplib.textutil import slugify, truncate
 
 
@@ -6,6 +9,40 @@ def test_slugify_basic():
     assert slugify("!!!") == "n-a"
 
 
+def test_slugify_accented_latin_letters():
+    assert slugify("Crème Brûlée") == "creme-brulee"
+    assert slugify("CAFE\u0301 Łódź Øresund") == "cafe-lodz-oresund"
+
+
+def test_slugify_other_characters_form_separators():
+    assert slugify("--Hi_日本語 ① there!!") == "hi-there"
+    assert slugify("東京") == "n-a"
+
+
+def test_slugify_cuts_after_normalization_without_trailing_separator():
+    assert slugify("Crème brûlée", 8) == "creme-br"
+    assert slugify("Crème brûlée", 6) == "creme"
+    assert slugify("ABC", 1) == "a"
+    assert slugify("a" * 41) == "a" * 40
+
+
+def test_slugify_fallback_respects_length_limit():
+    assert slugify("!!!", 3) == "n-a"
+    with pytest.raises(ShopError):
+        slugify("!!!", 2)
+
+
+@pytest.mark.parametrize("max_len", [0, -1, 1.5, True, None])
+def test_slugify_rejects_invalid_lengths(max_len):
+    with pytest.raises(ShopError):
+        slugify("product", max_len)
+
+
+def test_slugify_rejects_non_string_text():
+    with pytest.raises(ShopError):
+        slugify(None)
+
+
 def test_truncate():
     assert truncate("hello world", 8) == "hello..."
