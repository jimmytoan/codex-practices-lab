 """Text helpers for URLs and listings."""
 
 import re
+import unicodedata
+
+from shoplib.errors import ShopError
+
+
+def _remove_latin_accents(text: str) -> str:
+    characters = []
+    after_latin_letter = False
+    for char in unicodedata.normalize("NFD", text):
+        if unicodedata.category(char).startswith("M"):
+            if not after_latin_letter:
+                characters.append(char)
+            continue
+        name = unicodedata.name(char, "")
+        match = re.fullmatch(r"LATIN SMALL LETTER ([A-Z]) WITH .+", name)
+        if match:
+            char = match.group(1).lower()
+        characters.append(char)
+        after_latin_letter = "a" <= char <= "z"
+    return "".join(characters)
 
 
