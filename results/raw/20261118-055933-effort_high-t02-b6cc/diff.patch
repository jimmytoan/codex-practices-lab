+def test_bulk_discount_applies_to_lines_with_ten_or_more_units():
+    cart = Cart()
+    cart.add("A", 100, 10)
+    cart.add("B", 100, 9)
+
+    assert cart.line_total("A") == 950
+    assert cart.line_total("B") == 900
+    assert cart.subtotal() == 1850
+
+
+def test_bulk_discount_rounds_half_up_to_a_cent():
+    cart = Cart()
+    cart.add("A", 1, 10)
+
+    assert cart.line_total("A") == 9
+    assert cart.subtotal() == 9
+
+
