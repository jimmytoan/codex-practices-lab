diff --git a/src/shoplib/discounts.py b/src/shoplib/discounts.py
index d2804c4..2f24b3c 100644
--- a/src/shoplib/discounts.py
+++ b/src/shoplib/discounts.py
@@ -30,4 +30,32 @@ def apply_coupon(subtotal_cents: int, coupon: Coupon) -> int:
 
 def apply_coupons(subtotal_cents: int, coupons: list[Coupon], today: date) -> tuple[int, list[str]]:
     """Apply several coupons following the rules in docs/discounts.md."""
-    raise NotImplementedError
+    if subtotal_cents < 0:
+        raise ValueError("subtotal must not be negative")
+
+    eligible = [
+        coupon
+        for coupon in coupons
+        if (coupon.expires is None or today <= coupon.expires)
+        and subtotal_cents >= coupon.min_subtotal_cents
+    ]
+
+    percent_coupons = [coupon for coupon in eligible if coupon.kind == "percent"]
+    fixed_coupons = [coupon for coupon in eligible if coupon.kind == "fixed"]
+    unknown_coupons = [coupon for coupon in eligible if coupon.kind not in {"percent", "fixed"}]
+    if unknown_coupons:
+        raise ValueError(f"unknown coupon kind {unknown_coupons[0].kind!r}")
+
+    applied_codes = []
+    total_cents = subtotal_cents
+
+    if percent_coupons:
+        chosen_percent = min(percent_coupons, key=lambda coupon: (-coupon.value, coupon.code))
+        total_cents = max(subtotal_cents - percent_of(subtotal_cents, chosen_percent.value), 0)
+        applied_codes.append(chosen_percent.code)
+
+    for coupon in fixed_coupons:
+        total_cents = max(total_cents - coupon.value, 0)
+        applied_codes.append(coupon.code)
+
+    return total_cents, sorted(applied_codes)
diff --git a/tests/test_discounts.py b/tests/test_discounts.py
index 5b20e73..b05b987 100644
--- a/tests/test_discounts.py
+++ b/tests/test_discounts.py
@@ -1,4 +1,8 @@
-from shoplib.discounts import Coupon, apply_coupon
+from datetime import date
+
+import pytest
+
+from shoplib.discounts import Coupon, apply_coupon, apply_coupons
 
 
 def test_percent():
@@ -7,3 +11,60 @@ def test_percent():
 
 def test_fixed_never_negative():
     assert apply_coupon(300, Coupon("FIVE", "fixed", 500)) == 0
+
+
+def test_apply_coupons_combines_best_percent_and_all_eligible_fixed_coupons():
+    coupons = [
+        Coupon("TEN", "percent", 10),
+        Coupon("FIFTEEN", "percent", 15),
+        Coupon("FIVE", "fixed", 500),
+        Coupon("ONE", "fixed", 100),
+    ]
+
+    assert apply_coupons(2000, coupons, date(2026, 1, 1)) == (1100, ["FIFTEEN", "FIVE", "ONE"])
+
+
+def test_apply_coupons_ties_use_code_order_and_codes_are_sorted():
+    coupons = [
+        Coupon("ZED", "percent", 20),
+        Coupon("ALPHA", "percent", 20),
+        Coupon("FIXED", "fixed", 50),
+    ]
+
+    assert apply_coupons(1000, coupons, date(2026, 1, 1)) == (750, ["ALPHA", "FIXED"])
+
+
+def test_apply_coupons_uses_original_subtotal_for_minimum_and_expiry_is_inclusive():
+    coupons = [
+        Coupon("PERCENT", "percent", 10),
+        Coupon("MINIMUM", "fixed", 100, min_subtotal_cents=1000),
+        Coupon("TOO_HIGH", "fixed", 500, min_subtotal_cents=1001),
+        Coupon("EXPIRES_TODAY", "fixed", 50, expires=date(2026, 1, 1)),
+        Coupon("EXPIRED", "fixed", 500, expires=date(2025, 12, 31)),
+    ]
+
+    assert apply_coupons(1000, coupons, date(2026, 1, 1)) == (
+        750,
+        ["EXPIRES_TODAY", "MINIMUM", "PERCENT"],
+    )
+
+
+def test_apply_coupons_uses_percent_of_for_half_up_rounding():
+    assert apply_coupons(5, [Coupon("TEN", "percent", 10)], date(2026, 1, 1)) == (4, ["TEN"])
+
+
+def test_apply_coupons_never_returns_a_negative_total():
+    coupons = [Coupon("PERCENT", "percent", 100), Coupon("FIXED", "fixed", 1000)]
+
+    assert apply_coupons(500, coupons, date(2026, 1, 1)) == (0, ["FIXED", "PERCENT"])
+
+
+def test_apply_coupons_with_no_eligible_coupons_returns_original_subtotal():
+    coupons = [Coupon("MINIMUM", "fixed", 100, min_subtotal_cents=1001)]
+
+    assert apply_coupons(1000, coupons, date(2026, 1, 1)) == (1000, [])
+
+
+def test_apply_coupons_rejects_a_negative_subtotal():
+    with pytest.raises(ValueError, match="subtotal must not be negative"):
+        apply_coupons(-1, [], date(2026, 1, 1))
