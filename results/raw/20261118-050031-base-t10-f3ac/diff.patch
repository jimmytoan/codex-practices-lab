 """Shipping costs and parcel splitting. See docs/shipping.md."""
 
+from shoplib.errors import ShopError
+
 # (upper bound in grams, cost in cents)
 TIERS = [(1000, 500), (2000, 800), (5000, 1200), (20000, 2500)]
 
@@ -16,9 +18,56 @@ def shipping_cost(weight_g: int) -> int:
 
 def split_parcels(items: list[tuple[str, int, int]], max_weight_g: int) -> list[list[str]]:
     """Split order items into parcels. See docs/shipping.md."""
-    raise NotImplementedError
+    return [[sku for sku, _ in parcel] for parcel in _pack_parcels(items, max_weight_g)]
 
 
 def shipment_cost(items: list[tuple[str, int, int]], max_weight_g: int) -> int:
     """Total shipping cost of an order. See docs/shipping.md."""
-    raise NotImplementedError
+    return sum(
+        shipping_cost(sum(weight for _, weight in parcel))
+        for parcel in _pack_parcels(items, max_weight_g)
+    )
+
+
+def _pack_parcels(
+    items: list[tuple[str, int, int]], max_weight_g: int
+) -> list[list[tuple[str, int]]]:
+    """Return parcels with each packed SKU and its unit weight."""
+    units: list[tuple[str, int]] = []
+
+    if not isinstance(items, list):
+        raise ShopError("items must be a list")
+    for item in items:
+        if not isinstance(item, tuple) or len(item) != 3:
+            raise ShopError("each item must be a (sku, weight, quantity) tuple")
+        sku, weight, quantity = item
+        if not isinstance(sku, str):
+            raise ShopError("sku must be a string")
+        if type(weight) is not int or weight < 1:
+            raise ShopError("unit weight must be at least 1 gram")
+        if type(quantity) is not int or quantity < 1:
+            raise ShopError("quantity must be at least 1")
+        units.extend([(sku, weight)] * quantity)
+
+    if not units:
+        return []
+
+    if type(max_weight_g) is not int:
+        raise ShopError("maximum parcel weight must be an integer")
+
+    units.sort(key=lambda unit: (-unit[1], unit[0]))
+    parcels: list[list[tuple[str, int]]] = []
+    parcel_weights: list[int] = []
+    for unit in units:
+        sku, weight = unit
+        if weight > max_weight_g:
+            raise ShopError("unit is heavier than the maximum parcel weight")
+        for index, parcel_weight in enumerate(parcel_weights):
+            if parcel_weight + weight <= max_weight_g:
+                parcels[index].append(unit)
+                parcel_weights[index] += weight
+                break
+        else:
+            parcels.append([unit])
+            parcel_weights.append(weight)
+    return parcels
