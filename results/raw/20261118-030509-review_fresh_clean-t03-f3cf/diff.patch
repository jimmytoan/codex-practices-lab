diff --git a/tests/test_inventory.py b/tests/test_inventory.py
index 37436c0..e0e26e4 100644
--- a/tests/test_inventory.py
+++ b/tests/test_inventory.py
@@ -1,5 +1,6 @@
 import pytest
 
+from shoplib.errors import ShopError
 from shoplib.inventory import Inventory
 
 
@@ -18,3 +19,37 @@ def test_cannot_reserve_more_than_available():
     inv.receive("A", 2)
     with pytest.raises(ValueError):
         inv.reserve("A", 3)
+
+
+def test_release_returns_reserved_stock_to_available():
+    inv = Inventory()
+    inv.receive("A", 10)
+    inv.reserve("A", 6)
+    inv.receive("B", 4)
+    inv.reserve("B", 2)
+
+    inv.release("A", 2)
+    assert (inv.on_hand("A"), inv.reserved("A"), inv.available("A")) == (10, 4, 6)
+    assert (inv.on_hand("B"), inv.reserved("B"), inv.available("B")) == (4, 2, 2)
+
+    inv.release("A", 4)
+    assert (inv.on_hand("A"), inv.reserved("A"), inv.available("A")) == (10, 0, 10)
+
+
+@pytest.mark.parametrize(
+    ("sku", "qty"),
+    [("A", 0), ("A", -1), ("A", 4), ("B", 1), ("unknown", 1)],
+)
+def test_release_rejects_invalid_quantities_without_changing_stock(sku, qty):
+    inv = Inventory()
+    inv.receive("A", 10)
+    inv.reserve("A", 3)
+    inv.receive("B", 2)
+    before = {key: (inv.on_hand(key), inv.reserved(key), inv.available(key))
+              for key in ("A", "B", "unknown")}
+
+    with pytest.raises(ShopError):
+        inv.release(sku, qty)
+
+    assert {key: (inv.on_hand(key), inv.reserved(key), inv.available(key))
+            for key in before} == before
