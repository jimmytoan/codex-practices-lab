@@ -0,0 +1,42 @@
+import pytest
+
+from shoplib.errors import ShopError
+from shoplib.search import Product, search
+
+
+@pytest.fixture
+def products():
+    return [
+        Product('MUG-1', 'Blue Mug', 1000, ['Sale', 'Kitchenware']),
+        Product('MUG-2', 'Red mug', 1500, ['Kitchen']),
+        Product('BOX*3', 'Blue box', 500, ['gift*box']),
+    ]
+
+
+@pytest.mark.parametrize(('query', 'indexes'), [
+    ('', [0, 1, 2]), ('  \t', [0, 1, 2]),
+    ('MUG', [0, 1]), ('"blue mug"', [0]),
+    ('name:"blue mug"', [0]), ('blue -tag:sale', [2]),
+    ('sku:mug-1', [0]), ('tag:SALE', [0]),
+    ('sku:mug-*', [0, 1]), ('tag:kitchen*', [0, 1]),
+    ('sku:BOX*3', [2]), ('tag:gift*box', [2]),
+    ('name:mug*', []), ('-sku:mug-*', [2]),
+    ('price<1000', [2]), ('price<=1000', [0, 2]),
+    ('price>1000', [1]), ('price>=1000', [0, 1]),
+    ('price=1000', [0]), ('-price=1000', [1, 2]),
+    ('mug tag:kitchen* price>=1000', [0, 1]),
+    ('""', [0, 1, 2]),
+])
+def test_search(products, query, indexes):
+    assert search(products, query) == [products[i] for i in indexes]
+
+
+@pytest.mark.parametrize('query', [
+    'other:value', 'price:5', ':value', 'tag:', 'sku:""', 'name:',
+    '-', '-""', '"unclosed', 'name:"unclosed',
+    'price<', 'price>=abc', 'price=1.5', 'price=-1', 'price=>5',
+    'mug tag:',
+])
+def test_invalid_queries_are_rejected_even_without_products(query):
+    with pytest.raises(ShopError):
+        search([], query)
