@@ -11,6 +14,81 @@ class Product:
     tags: list[str] = field(default_factory=list)
 
 
+def _tokens(query: str) -> list[str]:
+    tokens = []
+    token = []
+    quoted = False
+    started = False
+    for char in query:
+        if char == '"':
+            quoted = not quoted
+            started = True
+        elif char.isspace() and not quoted:
+            if started:
+                tokens.append(''.join(token))
+                token = []
+                started = False
+        else:
+            token.append(char)
+            started = True
+    if quoted:
+        raise ShopError('unclosed quote')
+    if started:
+        tokens.append(''.join(token))
+    return tokens
+
+
+def _parse(token: str):
+    negate = token.startswith('-')
+    if negate:
+        token = token[1:]
+        if not token:
+            raise ShopError('empty negated term')
+
+    if ':' in token:
+        field_name, value = token.split(':', 1)
+        if field_name not in ('sku', 'name', 'tag'):
+            raise ShopError('unknown field')
+        if not value:
+            raise ShopError('empty field value')
+        return negate, field_name, value.casefold(), None
+
+    comparison = re.match(r'^price(<=|>=|<|>|=)(.*)$', token, re.DOTALL)
+    if comparison:
+        operator, value = comparison.groups()
+        if not re.fullmatch(r'[0-9]+', value):
+            raise ShopError('invalid price')
+        return negate, 'price', int(value), operator
+    return negate, 'name', token.casefold(), None
+
+
+def _matches(product: Product, term) -> bool:
+    negate, field_name, value, operator = term
+    if field_name == 'price':
+        price = product.price_cents
+        matched = {
+            '<': price < value,
+            '<=': price <= value,
+            '>': price > value,
+            '>=': price >= value,
+            '=': price == value,
+        }[operator]
+    elif field_name == 'name':
+        matched = value in product.name.casefold()
+    else:
+        candidates = [product.sku] if field_name == 'sku' else product.tags
+        prefix = value.endswith('*')
+        if prefix:
+            value = value[:-1]
+        matched = any(
+            candidate.casefold().startswith(value) if prefix
+            else candidate.casefold() == value
+            for candidate in candidates
+        )
+    return not matched if negate else matched
+
+
 def search(products: list[Product], query: str) -> list[Product]:
     """The products that match `query`, in their input order. See docs/search.md."""
-    raise NotImplementedError
+    terms = [_parse(token) for token in _tokens(query)]
