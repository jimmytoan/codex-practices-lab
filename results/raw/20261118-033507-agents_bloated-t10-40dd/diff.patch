 """Shipping costs and parcel splitting. See docs/shipping.md."""
 
+from shoplib.errors import ShopError
+
 # (upper bound in grams, cost in cents)
 TIERS = [(1000, 500), (2000, 800), (5000, 1200), (20000, 2500)]
 
@@ -16,9 +18,45 @@ def shipping_cost(weight_g: int) -> int:
 
 def split_parcels(items: list[tuple[str, int, int]], max_weight_g: int) -> list[list[str]]:
     """Split order items into parcels. See docs/shipping.md."""
-    raise NotImplementedError
+    return [
+        [sku for sku, _ in parcel]
+        for parcel in _pack_parcels(items, max_weight_g)
+    ]
 
 
 def shipment_cost(items: list[tuple[str, int, int]], max_weight_g: int) -> int:
     """Total shipping cost of an order. See docs/shipping.md."""
-    raise NotImplementedError
+    parcels = _pack_parcels(items, max_weight_g)
+    return sum(shipping_cost(sum(weight for _, weight in parcel)) for parcel in parcels)
+
+
+def _pack_parcels(
+    items: list[tuple[str, int, int]], max_weight_g: int
+) -> list[list[tuple[str, int]]]:
+    """Pack expanded units while retaining their weights for cost calculation."""
+    units: list[tuple[str, int]] = []
+    for sku, unit_weight_g, qty in items:
+        if unit_weight_g < 1:
+            raise ShopError("unit weight must be positive")
+        if qty < 1:
+            raise ShopError("quantity must be positive")
+        if unit_weight_g > max_weight_g:
+            raise ShopError("unit is heavier than the parcel limit")
+        units.extend([(sku, unit_weight_g)] * qty)
+
+    units.sort(key=lambda unit: (-unit[1], unit[0]))
+    parcels: list[list[tuple[str, int]]] = []
+    remaining_weights: list[int] = []
+
+    for unit in units:
+        sku, unit_weight_g = unit
+        for index, remaining_weight in enumerate(remaining_weights):
+            if unit_weight_g <= remaining_weight:
+                parcels[index].append(unit)
+                remaining_weights[index] -= unit_weight_g
+                break
+        else:
+            parcels.append([unit])
+            remaining_weights.append(max_weight_g - unit_weight_g)
+
+    return parcels
