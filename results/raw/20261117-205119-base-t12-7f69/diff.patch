@@ -13,4 +17,86 @@ class Product:
 
 def search(products: list[Product], query: str) -> list[Product]:
     """The products that match `query`, in their input order. See docs/search.md."""
-    raise NotImplementedError
+    terms = [_parse_term(token) for token in _tokenize(query)]
+    return [product for product in products if all(term(product) for term in terms)]
+
+
+def _tokenize(query: str) -> list[str]:
+    tokens = []
+    token = []
+    quoted = False
+    started = False
+    for char in query:
+        if char == '"':
+            quoted = not quoted
+            started = True
+        elif char.isspace() and not quoted:
+            if started:
+                tokens.append(''.join(token))
+                token = []
+                started = False
+        else:
+            token.append(char)
+            started = True
+    if quoted:
+        raise ShopError("unclosed quote")
+    if started:
+        tokens.append(''.join(token))
+    return tokens
+
+
+def _parse_term(token: str):
+    negate = token.startswith('-')
+    if negate:
+        token = token[1:]
+        if not token:
+            raise ShopError("empty negated term")
+
+    if ':' in token:
+        field_name, value = token.split(':', 1)
+        if field_name not in ('sku', 'name', 'tag'):
+            raise ShopError("unknown search field")
+        if not value:
+            raise ShopError("empty search field")
+        value = value.casefold()
+        if field_name == 'name':
+            match = lambda product: value in product.name.casefold()
+        else:
+            prefix = value.endswith('*')
+            if prefix:
+                value = value[:-1]
+
+            def matches_value(candidate):
+                candidate = candidate.casefold()
+                return candidate.startswith(value) if prefix else candidate == value
+
+            if field_name == 'sku':
+                match = lambda product: matches_value(product.sku)
+            else:
+                match = lambda product: any(matches_value(tag) for tag in product.tags)
+    elif re.match(r'price[<>=]', token):
+        comparison = re.fullmatch(r'price(<=|>=|<|>|=)([0-9]+)', token)
+        if comparison is None:
+            raise ShopError("invalid price comparison")
+        op = {
+            '<': operator.lt,
+            '<=': operator.le,
+            '>': operator.gt,
+            '>=': operator.ge,
+            '=': operator.eq,
+        }[comparison.group(1)]
+        # Convert in small chunks so valid long numbers do not hit Python's
+        # limit on converting a decimal string directly to an integer.
+        digits = comparison.group(2)
+        amount = 0
+        for start in range(0, len(digits), 9):
+            chunk = digits[start:start + 9]
+            amount = amount * 10 ** len(chunk) + int(chunk)
+        match = lambda product: op(product.price_cents, amount)
+    else:
+        value = token.casefold()
+        match = lambda product: value in product.name.casefold()
+
+    if negate:
+        return lambda product: not match(product)
+    return match
