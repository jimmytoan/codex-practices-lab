@@ -0,0 +1,85 @@
+import pytest
+
+from shoplib.errors import ShopError
+from shoplib.search import Product, search
+
+
+@pytest.fixture
+def products():
+    return [
+        Product('MUG-BLUE', 'Blue Mug', 1000, ['Sale', 'Kitchenware']),
+        Product('mug-red', 'Red mug', 1500, ['Kitchen', 'red*hot']),
+        Product('TEA', 'Blue tea cup', 999, ['Drink']),
+        Product('STAR*SKU', 'A * mug', 0, []),
+    ]
+
+
+@pytest.mark.parametrize('query', ['', '  \t\n'])
+def test_empty_query_matches_every_product_in_order(products, query):
+    assert search(products, query) == products
+
+
+@pytest.mark.parametrize(('query', 'indexes'), [
+    ('mUg', [0, 1, 3]),
+    ('"BLUE mug"', [0]),
+    ('blue mug', [0]),
+    ('name:"blue mug"', [0]),
+    ('name:UG', [0, 1, 3]),
+    ('sku:mug-blue', [0]),
+    ('sku:MUG', []),
+    ('sku:mug-*', [0, 1]),
+    ('sku:star*sku', [3]),
+    ('tag:sAlE', [0]),
+    ('tag:kitchen', [1]),
+    ('tag:kitchen*', [0, 1]),
+    ('tag:red*hot', [1]),
+    ('tag:*', [0, 1, 2]),
+    ('name:*', [3]),
+    ('-tag:sale', [1, 2, 3]),
+    ('-"blue mug"', [1, 2, 3]),
+    ('mug -sku:mug-*', [3]),
+    ('""', [0, 1, 2, 3]),
+])
+def test_text_terms(products, query, indexes):
+    assert search(products, query) == [products[i] for i in indexes]
+
+
+@pytest.mark.parametrize(('query', 'indexes'), [
+    ('price<1000', [2, 3]),
+    ('price<=1000', [0, 2, 3]),
+    ('price>1000', [1]),
+    ('price>=1000', [0, 1]),
+    ('price=1000', [0]),
+    ('price=0000', [3]),
+    ('-price>=1000', [2, 3]),
+    ('mug price>=1000 -tag:sale', [1]),
+])
+def test_price_comparisons(products, query, indexes):
+    assert search(products, query) == [products[i] for i in indexes]
+
+
+def test_casefold_and_whitespace_inside_quotes():
+    product = Product('STRASSE', 'Große\tTasse', 20, ['SÜSS'])
+    assert search([product], 'sku:straße name:"GROSSE\ttasse" tag:süss') == [product]
+
+
+def test_large_whole_number_is_valid(products):
+    assert search(products, 'price<' + '9' * 5000) == products
+
+
+@pytest.mark.parametrize('query', [
+    'colour:blue', 'price:5', ':value', 'SKU:abc',
+    'tag:', 'name:""', 'sku:', '-tag:',
+    '-', '-""',
+    '"unfinished', 'name:"unfinished',
+    'price<', 'price<=', 'price>abc', 'price>=1.5', 'price=-1',
+    'price=+1', 'price==1', 'price><1', 'price>=1x',
+])
+def test_invalid_query_raises_shop_error_even_without_products(query):
+    with pytest.raises(ShopError):
+        search([], query)
+
+
+def test_all_terms_are_validated_even_when_earlier_term_does_not_match(products):
+    with pytest.raises(ShopError):
+        search(products, 'no-such-product tag:')
