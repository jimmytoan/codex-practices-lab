diff --git a/tests/test_inventory.py b/tests/test_inventory.py
index 37436c0..9cb7185 100644
--- a/tests/test_inventory.py
+++ b/tests/test_inventory.py
@@ -1,5 +1,6 @@
 import pytest
 
+from shoplib.errors import ShopError
 from shoplib.inventory import Inventory
 
 
@@ -18,3 +19,44 @@ def test_cannot_reserve_more_than_available():
     inv.receive("A", 2)
     with pytest.raises(ValueError):
         inv.reserve("A", 3)
+
+
+def test_release_returns_reserved_units_to_available():
+    inv = Inventory()
+    inv.receive("A", 10)
+    inv.reserve("A", 6)
+
+    inv.release("A", 4)
+
+    assert inv.on_hand("A") == 10
+    assert inv.reserved("A") == 2
+    assert inv.available("A") == 8
+
+
+@pytest.mark.parametrize("qty", [0, -1])
+def test_release_requires_positive_quantity(qty):
+    inv = Inventory()
+    inv.receive("A", 5)
+    inv.reserve("A", 3)
+
+    with pytest.raises(ShopError):
+        inv.release("A", qty)
+
+    assert inv.on_hand("A") == 5
+    assert inv.reserved("A") == 3
+    assert inv.available("A") == 2
+
+
+@pytest.mark.parametrize("sku, reserved", [("A", 0), ("A", 2)])
+def test_release_cannot_exceed_reserved_units(sku, reserved):
+    inv = Inventory()
+    inv.receive(sku, 5)
+    if reserved:
+        inv.reserve(sku, reserved)
+
+    with pytest.raises(ShopError):
+        inv.release(sku, reserved + 1)
+
+    assert inv.on_hand(sku) == 5
+    assert inv.reserved(sku) == reserved
+    assert inv.available(sku) == 5 - reserved
