diff --git a/src/shoplib/costing.py b/src/shoplib/costing.py
index 5e8c27e..eb86623 100644
--- a/src/shoplib/costing.py
+++ b/src/shoplib/costing.py
@@ -1,6 +1,53 @@
 """Cost of goods sold with FIFO lots. See docs/costing.md."""
 
+from decimal import Decimal
+
+from .errors import ShopError
+from .money import round_cents
+
 
 def fifo_costing(events: list[dict]) -> dict:
     """Process stock events and report cost per SKU. See docs/costing.md."""
-    raise NotImplementedError
+    lots: dict[str, list[list[int]]] = {}
+    cogs: dict[str, int] = {}
+    last_sale: dict[str, dict] = {}
+    for ev in events:
+        kind, sku, qty = ev["type"], ev["sku"], ev["qty"]
+        if qty < 1:
+            raise ShopError("qty must be at least 1")
+        lots.setdefault(sku, [])
+        cogs.setdefault(sku, 0)
+        if kind == "receive":
+            if ev["unit_cost_cents"] < 0:
+                raise ShopError("unit cost must not be negative")
+            lots[sku].append([qty, ev["unit_cost_cents"]])
+        elif kind == "sell":
+            if qty > sum(q for q, _ in lots[sku]):
+                raise ShopError(f"not enough {sku} on hand")
+            need, cost = qty, 0
+            while need:
+                lot = lots[sku][0]
+                take = min(need, lot[0])
+                cost += take * lot[1]
+                lot[0] -= take
+                need -= take
+                if lot[0] == 0:
+                    lots[sku].pop(0)
+            cogs[sku] += cost
+            last_sale[sku] = {"qty": qty, "cost": cost, "returned": 0}
+        elif kind == "return":
+            sale = last_sale.get(sku)
+            if sale is None or qty > sale["qty"] - sale["returned"]:
+                raise ShopError(f"cannot return {qty} of {sku}")
+            whole, remainder = divmod(sale["cost"], sale["qty"])
+            # Only the comparison with one half matters for rounding. Keeping
+            # the integer part separate avoids Decimal precision limits.
+            half = Decimal(2 * remainder // sale["qty"]) / 2
+            unit = whole + round_cents(half)
+            sale["returned"] += qty
+            lots[sku].append([qty, unit])
+            cogs[sku] -= qty * unit
+        else:
+            raise ShopError(f"unknown event type {kind!r}")
+    return {sku: {"cogs_cents": cogs[sku], "on_hand": sum(q for q, _ in lots[sku]),
+                  "value_cents": sum(q * c for q, c in lots[sku])} for sku in lots}
diff --git a/tests/test_costing.py b/tests/test_costing.py
new file mode 100644
index 0000000..1167216
--- /dev/null
+++ b/tests/test_costing.py
@@ -0,0 +1,90 @@
+from copy import deepcopy
+
+import pytest
+
+from shoplib.costing import fifo_costing
+from shoplib.errors import ShopError
+
+
+def receive(sku, qty, cost):
+    return {"type": "receive", "sku": sku, "qty": qty, "unit_cost_cents": cost}
+
+
+def sell(sku, qty):
+    return {"type": "sell", "sku": sku, "qty": qty}
+
+
+def returned(sku, qty):
+    return {"type": "return", "sku": sku, "qty": qty}
+
+
+def test_fifo_sales_and_skus_do_not_mutate_events():
+    events = [receive("A", 2, 100), receive("B", 1, 0), receive("A", 2, 200),
+              sell("A", 3)]
+    original = deepcopy(events)
+    assert fifo_costing(events) == {
+        "A": {"cogs_cents": 400, "on_hand": 1, "value_cents": 200},
+        "B": {"cogs_cents": 0, "on_hand": 1, "value_cents": 0},
+    }
+    assert events == original
+    assert fifo_costing([]) == {}
+
+
+@pytest.mark.parametrize("second_cost,expected_unit", [(100, 100), (101, 101), (102, 101)])
+def test_return_average_rounds_half_up(second_cost, expected_unit):
+    events = [receive("A", 1, 100), receive("A", 1, second_cost),
+              sell("A", 2), returned("A", 1)]
+    assert fifo_costing(events)["A"] == {
+        "cogs_cents": 100 + second_cost - expected_unit,
+        "on_hand": 1,
+        "value_cents": expected_unit,
+    }
+
+
+def test_returns_go_after_all_existing_lots_in_return_order():
+    events = [receive("A", 2, 100), sell("A", 2), receive("A", 1, 200),
+              returned("A", 1), receive("A", 1, 300), returned("A", 1),
+              sell("A", 3)]
+    assert fifo_costing(events)["A"] == {
+        "cogs_cents": 600, "on_hand": 1, "value_cents": 100,
+    }
+
+
+def test_multiple_returns_and_most_recent_sale_are_tracked_per_sku():
+    events = [receive("A", 3, 100), receive("B", 1, 200), sell("A", 2),
+              sell("B", 1), returned("A", 1), returned("A", 1),
+              returned("B", 1), sell("A", 1), returned("A", 1)]
+    assert fifo_costing(events) == {
+        "A": {"cogs_cents": 0, "on_hand": 3, "value_cents": 300},
+        "B": {"cogs_cents": 0, "on_hand": 1, "value_cents": 200},
+    }
+
+
+def test_large_sale_average_does_not_lose_precision():
+    qty = 10**30
+    events = [receive("A", qty // 2 + 1, 0), receive("A", qty // 2 - 1, 1),
+              sell("A", qty), returned("A", 1)]
+    assert fifo_costing(events)["A"] == {
+        "cogs_cents": qty // 2 - 1, "on_hand": 1, "value_cents": 0,
+    }
+
+
+@pytest.mark.parametrize("events", [
+    [receive("A", 0, 1)],
+    [sell("A", -1)],
+    [returned("A", 0)],
+    [receive("A", 1, -1)],
+    [sell("A", 1)],
+    [receive("A", 1, 1), sell("A", 2)],
+    [receive("A", 1, 1), returned("A", 1)],
+    [receive("A", 2, 1), sell("A", 2), returned("A", 3)],
+    [receive("A", 2, 1), sell("A", 2), returned("A", 1), returned("A", 2)],
+    [receive("A", 2, 1), sell("A", 2), returned("A", 2), sell("A", 1),
+     returned("A", 2)],
+    [{"type": "unknown", "sku": "A", "qty": 1}],
+])
+def test_invalid_events_raise_shop_error_without_mutating_input(events):
+    original = deepcopy(events)
+    with pytest.raises(ShopError):
+        fifo_costing(events)
+    assert events == original
