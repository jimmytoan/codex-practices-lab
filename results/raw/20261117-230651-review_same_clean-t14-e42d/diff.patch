+++ b/tests/test_storedays.py
@@ -0,0 +1,53 @@
+import pytest
+
+from shoplib.errors import ShopError
+from shoplib.storedays import daily_revenue
+
+
+def test_store_day_boundaries_time_zones_refunds_and_gaps():
+    sales = [
+        {"at": "2026-11-20T04:00:00+08:00", "cents": 900},
+        {"at": "2026-11-17T20:00:00Z", "cents": 500},
+        {"at": "2026-11-17T14:59:59-05:00", "cents": -100},
+        {"at": "2026-11-18T03:59:59+08:00", "cents": 200},
+    ]
+    assert daily_revenue(sales) == [
+        ("2026-11-17", 100),
+        ("2026-11-18", 500),
+        ("2026-11-19", 0),
+        ("2026-11-20", 900),
+    ]
+
+
+def test_custom_store_timezone_and_start_hour():
+    sales = [
+        {"at": "2026-01-02T10:59:59Z", "cents": 10},
+        {"at": "2026-01-02T11:00:00Z", "cents": 20},
+    ]
+    assert daily_revenue(sales, utc_offset_hours=-5, day_starts_hour=6) == [
+        ("2026-01-01", 10),
+        ("2026-01-02", 20),
+    ]
+
+
+def test_empty_sales():
+    assert daily_revenue([]) == []
+
+
+@pytest.mark.parametrize("timestamp", ["2026-11-18T04:00:00", "invalid"])
+def test_invalid_timestamp_raises_shop_error(timestamp):
+    with pytest.raises(ShopError):
+        daily_revenue([{"at": timestamp, "cents": 100}])
+
+
+def test_invalid_utc_offset_raises_shop_error():
+    with pytest.raises(ShopError):
+        daily_revenue([], utc_offset_hours=24)
+
+
+def test_last_representable_store_day():
+    assert daily_revenue(
+        [{"at": "9999-12-31T12:00:00Z", "cents": 100}],
+        utc_offset_hours=0,
+        day_starts_hour=0,
+    ) == [("9999-12-31", 100)]
