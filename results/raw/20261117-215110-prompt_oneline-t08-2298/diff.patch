diff --git a/tests/test_cli.py b/tests/test_cli.py
index 29a7ce0..63d549c 100644
--- a/tests/test_cli.py
+++ b/tests/test_cli.py
@@ -1,5 +1,7 @@
 import json
 
+import pytest
+
 from shoplib.cli import main
 
 
@@ -8,3 +10,41 @@ def test_report_csv(tmp_path, capsys):
     path.write_text(json.dumps([{"sku": "A", "name": "Mug", "qty": 2, "unit_price_cents": 450}]))
     assert main(["report", str(path)]) == 0
     assert capsys.readouterr().out == "sku,name,units,revenue_cents\nA,Mug,2,900\n"
+
+
+def test_report_json(tmp_path, capsys):
+    path = tmp_path / "sales.json"
+    path.write_text(json.dumps([
+        {"sku": "B", "name": "Bowl", "qty": 1, "unit_price_cents": 900},
+        {"sku": "A", "name": "Mug", "qty": 2, "unit_price_cents": 450},
+        {"sku": "A", "name": "Mug", "qty": 1, "unit_price_cents": 450},
+    ]))
+    assert main(["report", "--format", "json", str(path)]) == 0
+    assert capsys.readouterr().out == (
+        '[\n'
+        '  {\n    "name": "Mug",\n    "revenue_cents": 1350,\n'
+        '    "sku": "A",\n    "units": 3\n  },\n'
+        '  {\n    "name": "Bowl",\n    "revenue_cents": 900,\n'
+        '    "sku": "B",\n    "units": 1\n  }\n]\n'
+    )
+
+
+def test_report_empty_json(tmp_path, capsys):
+    path = tmp_path / "sales.json"
+    path.write_text("[]")
+    assert main(["report", str(path), "--format", "json"]) == 0
+    assert capsys.readouterr().out == "[]\n"
+
+
+def test_report_explicit_csv(tmp_path, capsys):
+    path = tmp_path / "sales.json"
+    path.write_text("[]")
+    assert main(["report", str(path), "--format", "csv"]) == 0
+    assert capsys.readouterr().out == "sku,name,units,revenue_cents\n"
+
+
+def test_report_rejects_unknown_format(tmp_path, capsys):
+    with pytest.raises(SystemExit) as exc:
+        main(["report", str(tmp_path / "sales.json"), "--format", "xml"])
+    assert exc.value.code == 2
+    assert "invalid choice" in capsys.readouterr().err
