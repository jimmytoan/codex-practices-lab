diff --git a/src/shoplib/costing.py b/src/shoplib/costing.py
index 5e8c27e..89942ae 100644
--- a/src/shoplib/costing.py
+++ b/src/shoplib/costing.py
@@ -1,6 +1,105 @@
 """Cost of goods sold with FIFO lots. See docs/costing.md."""
 
+from collections import deque
+from decimal import Decimal
+
+from shoplib.errors import ShopError
+from shoplib.money import round_cents
+
+
+def _positive_quantity(event: dict) -> int:
+    quantity = event.get("qty")
+    if type(quantity) is not int or quantity < 1:
+        raise ShopError("quantity must be a positive integer")
+    return quantity
+
+
+def _sku(event: dict):
+    if "sku" not in event:
+        raise ShopError("event must include a sku")
+    sku = event["sku"]
+    try:
+        hash(sku)
+    except TypeError as exc:
+        raise ShopError("sku must be hashable") from exc
+    return sku
+
 
 def fifo_costing(events: list[dict]) -> dict:
     """Process stock events and report cost per SKU. See docs/costing.md."""
-    raise NotImplementedError
+    if not isinstance(events, list):
+        raise ShopError("events must be a list")
+
+    # A lot is [remaining quantity, integer unit cost in cents].
+    stock = {}
+    for event in events:
+        if not isinstance(event, dict):
+            raise ShopError("each event must be a dict")
+
+        event_type = event.get("type")
+        if event_type not in ("receive", "sell", "return"):
+            raise ShopError("unknown event type")
+
+        sku = _sku(event)
+        quantity = _positive_quantity(event)
+
+        if event_type == "receive":
+            unit_cost = event.get("unit_cost_cents")
+            if type(unit_cost) is not int or unit_cost < 0:
+                raise ShopError("unit cost must be a non-negative integer")
+
+            state = stock.setdefault(
+                sku,
+                {"lots": deque(), "cogs_cents": 0, "on_hand": 0, "latest_sale": None},
+            )
+            state["lots"].append([quantity, unit_cost])
+            state["on_hand"] += quantity
+            continue
+
+        state = stock.get(sku)
+        if event_type == "sell":
+            if state is None or state["on_hand"] < quantity:
+                raise ShopError("cannot sell more units than are on hand")
+
+            remaining = quantity
+            sale_cost = 0
+            while remaining:
+                lot_quantity, unit_cost = state["lots"][0]
+                taken = min(remaining, lot_quantity)
+                sale_cost += taken * unit_cost
+                remaining -= taken
+                lot_quantity -= taken
+                if lot_quantity:
+                    state["lots"][0][0] = lot_quantity
+                else:
+                    state["lots"].popleft()
+
+            state["on_hand"] -= quantity
+            state["cogs_cents"] += sale_cost
+            state["latest_sale"] = {
+                "unit_cost_cents": round_cents(Decimal(sale_cost) / quantity),
+                "returnable": quantity,
+            }
+            continue
+
+        # The only event type left is a customer return.
+        if state is None or state["latest_sale"] is None:
+            raise ShopError("cannot return units when there has been no sale")
+        sale = state["latest_sale"]
+        if quantity > sale["returnable"]:
+            raise ShopError("return exceeds units remaining from the most recent sale")
+
+        unit_cost = sale["unit_cost_cents"]
+        sale["returnable"] -= quantity
+        state["lots"].append([quantity, unit_cost])
+        state["on_hand"] += quantity
+        state["cogs_cents"] -= quantity * unit_cost
+
+    return {
+        sku: {
+            "cogs_cents": state["cogs_cents"],
+            "on_hand": state["on_hand"],
+            "value_cents": sum(quantity * unit_cost for quantity, unit_cost in state["lots"]),
+        }
+        for sku, state in stock.items()
+    }
diff --git a/tests/test_costing.py b/tests/test_costing.py
new file mode 100644
index 0000000..a16a8b9
--- /dev/null
+++ b/tests/test_costing.py
@@ -0,0 +1,126 @@
+import copy
+
+import pytest
+
+from shoplib.costing import fifo_costing
+from shoplib.errors import ShopError
+
+
+def test_fifo_receipts_and_sales_across_multiple_skus():
+    events = [
+        {"type": "receive", "sku": "A", "qty": 2, "unit_cost_cents": 125},
+        {"type": "receive", "sku": "B", "qty": 1, "unit_cost_cents": 80},
+        {"type": "receive", "sku": "A", "qty": 3, "unit_cost_cents": 200},
+        {"type": "sell", "sku": "A", "qty": 3},
+    ]
+
+    assert fifo_costing(events) == {
+        "A": {"cogs_cents": 450, "on_hand": 2, "value_cents": 400},
+        "B": {"cogs_cents": 0, "on_hand": 1, "value_cents": 80},
+    }
+
+
+def test_return_uses_rounded_average_cost_and_allows_multiple_returns():
+    events = [
+        {"type": "receive", "sku": "A", "qty": 1, "unit_cost_cents": 101},
+        {"type": "receive", "sku": "A", "qty": 1, "unit_cost_cents": 102},
+        {"type": "sell", "sku": "A", "qty": 2},
+        {"type": "return", "sku": "A", "qty": 1},
+        {"type": "return", "sku": "A", "qty": 1},
+    ]
+
+    # The sale average is 101.5 cents, rounded half up to 102 cents per return.
+    assert fifo_costing(events) == {
+        "A": {"cogs_cents": -1, "on_hand": 2, "value_cents": 204}
+    }
+
+
+def test_returned_lot_is_placed_after_existing_lots():
+    events = [
+        {"type": "receive", "sku": "A", "qty": 1, "unit_cost_cents": 100},
+        {"type": "sell", "sku": "A", "qty": 1},
+        {"type": "receive", "sku": "A", "qty": 1, "unit_cost_cents": 200},
+        {"type": "return", "sku": "A", "qty": 1},
+        {"type": "sell", "sku": "A", "qty": 1},
+    ]
+
+    # The next sale takes the 200-cent receipt, leaving the returned 100-cent lot.
+    assert fifo_costing(events) == {
+        "A": {"cogs_cents": 200, "on_hand": 1, "value_cents": 100}
+    }
+
+
+def test_only_the_most_recent_sale_can_be_returned():
+    events = [
+        {"type": "receive", "sku": "A", "qty": 2, "unit_cost_cents": 50},
+        {"type": "sell", "sku": "A", "qty": 1},
+        {"type": "sell", "sku": "A", "qty": 1},
+        {"type": "return", "sku": "A", "qty": 1},
+    ]
+
+    assert fifo_costing(events)["A"] == {
+        "cogs_cents": 50,
+        "on_hand": 1,
+        "value_cents": 50,
+    }
+
+
+@pytest.mark.parametrize(
+    "events",
+    [
+        [{"type": "receive", "sku": "A", "qty": 0, "unit_cost_cents": 10}],
+        [{"type": "receive", "sku": "A", "qty": -1, "unit_cost_cents": 10}],
+        [{"type": "sell", "sku": "A", "qty": 0}],
+        [{"type": "return", "sku": "A", "qty": -1}],
+        [{"type": "receive", "sku": "A", "qty": 1, "unit_cost_cents": -1}],
+        [{"type": "sell", "sku": "A", "qty": 1}],
+        [{"type": "return", "sku": "A", "qty": 1}],
+        [
+            {"type": "receive", "sku": "A", "qty": 1, "unit_cost_cents": 10},
+            {"type": "sell", "sku": "A", "qty": 2},
+        ],
+        [
+            {"type": "receive", "sku": "A", "qty": 1, "unit_cost_cents": 10},
+            {"type": "sell", "sku": "A", "qty": 1},
+            {"type": "return", "sku": "A", "qty": 2},
+        ],
+        [{"type": "adjust", "sku": "A", "qty": 1}],
+    ],
+)
+def test_invalid_events_raise_value_error(events):
+    with pytest.raises(ValueError):
+        fifo_costing(events)
+
+
+def test_events_are_not_modified():
+    events = [
+        {"type": "receive", "sku": "A", "qty": 2, "unit_cost_cents": 75},
+        {"type": "sell", "sku": "A", "qty": 1},
+        {"type": "return", "sku": "A", "qty": 1},
+    ]
+    original = copy.deepcopy(events)
+
+    fifo_costing(events)
+
+    assert events == original
+
+
+@pytest.mark.parametrize(
+    "events",
+    [
+        None,
+        [None],
+        [{"type": "receive", "qty": 1, "unit_cost_cents": 10}],
+        [{"type": "receive", "sku": "A", "unit_cost_cents": 10}],
+        [{"type": "receive", "sku": "A", "qty": 1}],
+        [{"type": "receive", "sku": [], "qty": 1, "unit_cost_cents": 10}],
+    ],
+)
+def test_malformed_events_raise_value_error(events):
+    with pytest.raises(ValueError):
+        fifo_costing(events)
+
+
+def test_shop_error_is_the_value_error_subclass_for_invalid_inputs():
+    with pytest.raises(ShopError):
+        fifo_costing([{"type": "receive", "sku": "A", "qty": 0, "unit_cost_cents": 0}])
