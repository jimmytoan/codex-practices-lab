 def test_percent():
@@ -7,3 +12,51 @@ def test_percent():
 
 def test_fixed_never_negative():
     assert apply_coupon(300, Coupon("FIVE", "fixed", 500)) == 0
+
+
+def test_combines_eligible_coupons_using_original_subtotal():
+    today = date(2026, 11, 18)
+    coupons = [
+        Coupon("Z_FIXED", "fixed", 100, expires=today, min_subtotal_cents=1000),
+        Coupon("OLD", "fixed", 900, expires=date(2026, 11, 17)),
+        Coupon("MINIMUM", "fixed", 900, min_subtotal_cents=1001),
+        Coupon("OLD_PERCENT", "percent", 90, expires=date(2026, 11, 17)),
+        Coupon("MIN_PERCENT", "percent", 90, min_subtotal_cents=1001),
+        Coupon("LOW_PERCENT", "percent", 10),
+        Coupon("B_PERCENT", "percent", 20),
+        Coupon("A_PERCENT", "percent", 20),
+        Coupon("A_FIXED", "fixed", 50, min_subtotal_cents=1000),
+    ]
+    assert apply_coupons(1000, coupons, today) == (
+        650, ["A_FIXED", "A_PERCENT", "Z_FIXED"]
+    )
+
+
+def test_percent_rounds_half_up_before_fixed_discounts():
+    coupons = [Coupon("FIXED", "fixed", 1), Coupon("PERCENT", "percent", 50)]
+    assert apply_coupons(5, coupons, date(2026, 1, 1)) == (1, ["FIXED", "PERCENT"])
+
+
+def test_all_eligible_fixed_coupons_apply_even_after_total_reaches_zero():
+    coupons = [Coupon("B", "fixed", 100), Coupon("A", "fixed", 100)]
+    assert apply_coupons(50, coupons, date(2026, 1, 1)) == (0, ["A", "B"])
+
+
+def test_percent_can_reduce_total_to_zero_and_fixed_codes_still_apply():
+    coupons = [Coupon("P", "percent", 150), Coupon("F", "fixed", 1)]
+    assert apply_coupons(50, coupons, date(2026, 1, 1)) == (0, ["F", "P"])
+
+
+def test_no_eligible_coupons_or_empty_list():
+    today = date(2026, 1, 1)
+    assert apply_coupons(100, [], today) == (100, [])
+    assert apply_coupons(100, [Coupon("OLD", "percent", 10, expires=date(2025, 12, 31))], today) == (100, [])
+    assert apply_coupons(0, [Coupon("ZERO", "fixed", 0)], today) == (0, ["ZERO"])
+
+
+def test_invalid_subtotal_and_coupon_kind_raise_shop_error():
+    today = date(2026, 1, 1)
+    with pytest.raises(ShopError):
+        apply_coupons(-1, [], today)
+    with pytest.raises(ShopError):
+        apply_coupons(100, [Coupon("BAD", "other", 10)], today)
