diff --git a/src/shoplib/invoice.py b/src/shoplib/invoice.py
index 5d1398c..00871cd 100644
--- a/src/shoplib/invoice.py
+++ b/src/shoplib/invoice.py
@@ -1,5 +1,8 @@
 """Invoices: coupon allocation and tax. See docs/invoicing.md."""
 
+from shoplib.errors import ShopError
+from shoplib.money import percent_of
+
 # Tax rates in percent, by region and product category.
 TAX_RATES = {
     "DE": {"standard": 19, "food": 7, "books": 7},
@@ -10,4 +13,58 @@ TAX_RATES = {
 
 def build_invoice(lines, coupon_cents: int, shipping_cents: int, region: str) -> dict:
     """Build an invoice for an order. See docs/invoicing.md."""
-    raise NotImplementedError
+    if region not in TAX_RATES:
+        raise ShopError(f"unknown region: {region}")
+    if not lines:
+        raise ShopError("lines must not be empty")
+    if coupon_cents < 0 or shipping_cents < 0:
+        raise ShopError("coupon and shipping amounts must be non-negative")
+
+    rates = TAX_RATES[region]
+    gross_values = []
+    for sku, unit_price_cents, qty, category in lines:
+        if category not in rates:
+            raise ShopError(f"unknown category: {category}")
+        if qty < 1:
+            raise ShopError("quantity must be at least 1")
+        if unit_price_cents < 0:
+            raise ShopError("price must be non-negative")
+        gross_values.append(unit_price_cents * qty)
+
+    total_gross = sum(gross_values)
+    coupon = min(coupon_cents, total_gross)
+    discounts = [0] * len(lines)
+    if total_gross:
+        remainders = []
+        allocated = 0
+        for i, gross in enumerate(gross_values):
+            quotient, remainder = divmod(coupon * gross, total_gross)
+            discounts[i] = quotient
+            allocated += quotient
+            remainders.append((remainder, i))
+        for _, i in sorted(remainders, key=lambda item: (-item[0], item[1]))[:coupon - allocated]:
+            discounts[i] += 1
+
+    result_lines = []
+    has_taxable_category = False
+    for (sku, _, _, category), gross, discount in zip(lines, gross_values, discounts):
+        rate = rates[category]
+        has_taxable_category = has_taxable_category or rate > 0
+        net = gross - discount
+        result_lines.append({
+            "sku": sku,
+            "gross_cents": gross,
+            "discount_cents": discount,
+            "net_cents": net,
+            "tax_cents": percent_of(net, rate),
+        })
+
+    shipping_tax = percent_of(shipping_cents, rates["standard"]) if has_taxable_category else 0
+    total = sum(line["net_cents"] + line["tax_cents"] for line in result_lines)
+    total += shipping_cents + shipping_tax
+    return {
+        "lines": result_lines,
+        "shipping_cents": shipping_cents,
+        "shipping_tax_cents": shipping_tax,
+        "total_cents": total,
+    }
diff --git a/tests/test_invoice.py b/tests/test_invoice.py
new file mode 100644
index 0000000..25a3e14
--- /dev/null
+++ b/tests/test_invoice.py
@@ -0,0 +1,48 @@
+import pytest
+
+from shoplib.invoice import build_invoice
+
+
+def test_coupon_is_capped_and_split_by_largest_remainder():
+    invoice = build_invoice(
+        [("a", 100, 1, "food"), ("b", 100, 2, "books")],
+        2, 0, "DE",
+    )
+    assert [line["discount_cents"] for line in invoice["lines"]] == [1, 1]
+    assert [line["gross_cents"] for line in invoice["lines"]] == [100, 200]
+    assert [line["net_cents"] for line in invoice["lines"]] == [99, 199]
+    assert [line["tax_cents"] for line in invoice["lines"]] == [7, 14]
+    assert invoice["shipping_tax_cents"] == 0
+
+
+def test_ties_favor_earlier_line_and_coupon_cannot_exceed_gross():
+    invoice = build_invoice(
+        [("a", 1, 1, "books"), ("b", 1, 1, "books")],
+        100, 0, "OR",
+    )
+    assert [line["discount_cents"] for line in invoice["lines"]] == [1, 1]
+    assert invoice["total_cents"] == 0
+
+
+def test_zero_gross_has_no_discount_and_shipping_tax_uses_standard_rate():
+    invoice = build_invoice([("a", 0, 3, "food")], 5, 100, "SG")
+    assert invoice["lines"][0]["discount_cents"] == 0
+    assert invoice["shipping_tax_cents"] == 9
+    assert invoice["total_cents"] == 109
+
+
+@pytest.mark.parametrize(
+    "lines,coupon,shipping,region",
+    [
+        ([("a", 1, 1, "food")], 0, 0, "XX"),
+        ([("a", 1, 1, "other")], 0, 0, "DE"),
+        ([], 0, 0, "DE"),
+        ([("a", 1, 0, "food")], 0, 0, "DE"),
+        ([("a", -1, 1, "food")], 0, 0, "DE"),
+        ([("a", 1, 1, "food")], -1, 0, "DE"),
+        ([("a", 1, 1, "food")], 0, -1, "DE"),
+    ],
+)
+def test_invalid_arguments_raise_value_error(lines, coupon, shipping, region):
+    with pytest.raises(ValueError):
+        build_invoice(lines, coupon, shipping, region)
