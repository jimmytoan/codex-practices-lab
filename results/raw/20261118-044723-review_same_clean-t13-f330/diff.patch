diff --git a/src/shoplib/costing.py b/src/shoplib/costing.py
index 5e8c27e..76ecf90 100644
--- a/src/shoplib/costing.py
+++ b/src/shoplib/costing.py
@@ -1,6 +1,54 @@
 """Cost of goods sold with FIFO lots. See docs/costing.md."""
 
+from decimal import Decimal, localcontext
+
+from .errors import ShopError
+from .money import round_cents
+
 
 def fifo_costing(events: list[dict]) -> dict:
     """Process stock events and report cost per SKU. See docs/costing.md."""
-    raise NotImplementedError
+    lots: dict[str, list[list[int]]] = {}
+    cogs: dict[str, int] = {}
+    last_sale: dict[str, dict] = {}
+    for ev in events:
+        kind, sku, qty = ev["type"], ev["sku"], ev["qty"]
+        if qty < 1:
+            raise ShopError("qty must be at least 1")
+        lots.setdefault(sku, [])
+        cogs.setdefault(sku, 0)
+        if kind == "receive":
+            if ev["unit_cost_cents"] < 0:
+                raise ShopError("unit cost must not be negative")
+            lots[sku].append([qty, ev["unit_cost_cents"]])
+        elif kind == "sell":
+            if qty > sum(q for q, _ in lots[sku]):
+                raise ShopError(f"not enough {sku} on hand")
+            need, cost = qty, 0
+            while need:
+                lot = lots[sku][0]
+                take = min(need, lot[0])
+                cost += take * lot[1]
+                lot[0] -= take
+                need -= take
+                if lot[0] == 0:
+                    lots[sku].pop(0)
+            cogs[sku] += cost
+            last_sale[sku] = {"qty": qty, "cost": cost, "returned": 0}
+        elif kind == "return":
+            sale = last_sale.get(sku)
+            if sale is None or qty > sale["qty"] - sale["returned"]:
+                raise ShopError(f"cannot return {qty} of {sku}")
+            with localcontext() as context:
+                context.prec = max(
+                    28,
+                    len(str(abs(sale["cost"]))) + len(str(sale["qty"])) + 5,
+                )
+                unit = round_cents(Decimal(sale["cost"]) / sale["qty"])
+            sale["returned"] += qty
+            lots[sku].append([qty, unit])
+            cogs[sku] -= qty * unit
+        else:
+            raise ShopError(f"unknown event type {kind!r}")
+    return {sku: {"cogs_cents": cogs[sku], "on_hand": sum(q for q, _ in lots[sku]),
+                  "value_cents": sum(q * c for q, c in lots[sku])} for sku in lots}
diff --git a/tests/test_costing.py b/tests/test_costing.py
new file mode 100644
index 0000000..7f65016
--- /dev/null
+++ b/tests/test_costing.py
@@ -0,0 +1,109 @@
+import pytest
+
+from shoplib.costing import fifo_costing
+from shoplib.errors import ShopError
+
+
+def test_sales_use_fifo_lots_and_report_remaining_inventory():
+    events = [
+        {"type": "receive", "sku": "A", "qty": 2, "unit_cost_cents": 100},
+        {"type": "receive", "sku": "A", "qty": 3, "unit_cost_cents": 250},
+        {"type": "sell", "sku": "A", "qty": 3},
+    ]
+
+    assert fifo_costing(events) == {
+        "A": {"cogs_cents": 450, "on_hand": 2, "value_cents": 500}
+    }
+
+
+def test_returns_are_appended_after_existing_lots_and_allow_partial_returns():
+    events = [
+        {"type": "receive", "sku": "A", "qty": 2, "unit_cost_cents": 101},
+        {"type": "sell", "sku": "A", "qty": 1},
+        {"type": "receive", "sku": "A", "qty": 1, "unit_cost_cents": 200},
+        {"type": "return", "sku": "A", "qty": 1},
+        {"type": "sell", "sku": "A", "qty": 2},
+    ]
+
+    assert fifo_costing(events) == {
+        "A": {"cogs_cents": 301, "on_hand": 1, "value_cents": 101}
+    }
+
+
+def test_returns_round_average_half_up_and_accumulate_against_same_sale():
+    events = [
+        {"type": "receive", "sku": "A", "qty": 2, "unit_cost_cents": 1},
+        {"type": "receive", "sku": "A", "qty": 2, "unit_cost_cents": 2},
+        {"type": "sell", "sku": "A", "qty": 4},
+        {"type": "return", "sku": "A", "qty": 1},
+        {"type": "return", "sku": "A", "qty": 1},
+    ]
+
+    assert fifo_costing(events) == {
+        "A": {"cogs_cents": 2, "on_hand": 2, "value_cents": 4}
+    }
+
+
+def test_return_average_rounding_keeps_precision_for_large_integer_amounts():
+    qty = 10**10
+    average = 10**27
+    sale_cost = average * qty + qty // 2
+    events = [
+        {"type": "receive", "sku": "A", "qty": 1, "unit_cost_cents": sale_cost},
+        {"type": "receive", "sku": "A", "qty": qty - 1, "unit_cost_cents": 0},
+        {"type": "sell", "sku": "A", "qty": qty},
+        {"type": "return", "sku": "A", "qty": 1},
+    ]
+
+    assert fifo_costing(events) == {
+        "A": {
+            "cogs_cents": sale_cost - (average + 1),
+            "on_hand": 1,
+            "value_cents": average + 1,
+        }
+    }
+
+
+def test_return_limit_uses_only_the_most_recent_sale_for_that_sku():
+    events = [
+        {"type": "receive", "sku": "A", "qty": 3, "unit_cost_cents": 100},
+        {"type": "sell", "sku": "A", "qty": 2},
+        {"type": "sell", "sku": "A", "qty": 1},
+        {"type": "return", "sku": "A", "qty": 2},
+    ]
+
+    with pytest.raises(ShopError):
+        fifo_costing(events)
+
+
+@pytest.mark.parametrize(
+    "events",
+    [
+        [{"type": "receive", "sku": "A", "qty": 0, "unit_cost_cents": 1}],
+        [{"type": "receive", "sku": "A", "qty": 1, "unit_cost_cents": -1}],
+        [{"type": "sell", "sku": "A", "qty": 1}],
+        [{"type": "return", "sku": "A", "qty": 1}],
+        [
+            {"type": "receive", "sku": "A", "qty": 1, "unit_cost_cents": 1},
+            {"type": "sell", "sku": "A", "qty": 1},
+            {"type": "return", "sku": "A", "qty": 2},
+        ],
+        [{"type": "unknown", "sku": "A", "qty": 1}],
+    ],
+)
+def test_documented_invalid_events_raise_shop_error(events):
+    with pytest.raises(ShopError):
+        fifo_costing(events)
+
+
+def test_events_are_not_modified():
+    events = [
+        {"type": "receive", "sku": "A", "qty": 2, "unit_cost_cents": 10},
+        {"type": "sell", "sku": "A", "qty": 1},
+        {"type": "return", "sku": "A", "qty": 1},
+    ]
+    original = [event.copy() for event in events]
+
+    fifo_costing(events)
+
+    assert events == original
