diff --git a/src/shoplib/orders.py b/src/shoplib/orders.py
index 8edb164..0e87707 100644
--- a/src/shoplib/orders.py
+++ b/src/shoplib/orders.py
@@ -46,3 +46,21 @@ class Order:
 
     def deliver(self) -> None:
         self._transition((SHIPPED,), DELIVERED)
+
+    def cancel(self) -> None:
+        """Cancel an unshipped order and return its reserved stock."""
+        if self.state == CANCELLED:
+            return
+        if self.state not in (NEW, PAID):
+            raise ValueError(f"cannot cancel an order in {self.state}")
+
+        # Validate the whole release before changing inventory, so a failed
+        # cancellation cannot release only part of a multi-line order.
+        for sku, qty in self.lines.items():
+            if qty <= 0 or qty > self.inventory.reserved(sku):
+                raise ValueError(f"cannot release {qty} of {sku}")
+        for sku, qty in self.lines.items():
+            self.inventory.release(sku, qty)
+
+        self.refund_due = self.state == PAID
+        self.state = CANCELLED
diff --git a/tests/test_inventory.py b/tests/test_inventory.py
index 37436c0..56e9b27 100644
--- a/tests/test_inventory.py
+++ b/tests/test_inventory.py
@@ -18,3 +18,24 @@ def test_cannot_reserve_more_than_available():
     inv.receive("A", 2)
     with pytest.raises(ValueError):
         inv.reserve("A", 3)
+
+
+def test_release_returns_reserved_units_to_available():
+    inv = Inventory()
+    inv.receive("A", 10)
+    inv.reserve("A", 4)
+    inv.release("A", 3)
+    assert inv.on_hand("A") == 10
+    assert inv.reserved("A") == 1
+    assert inv.available("A") == 9
+
+
+@pytest.mark.parametrize("sku,qty", [("A", 0), ("A", -1), ("A", 3), ("B", 1)])
+def test_invalid_release_leaves_inventory_unchanged(sku, qty):
+    inv = Inventory()
+    inv.receive("A", 5)
+    inv.reserve("A", 2)
+    before = (inv.on_hand("A"), inv.reserved("A"), inv.available("A"))
+    with pytest.raises(ValueError):
+        inv.release(sku, qty)
+    assert (inv.on_hand("A"), inv.reserved("A"), inv.available("A")) == before
diff --git a/tests/test_orders.py b/tests/test_orders.py
index d3835d1..6648680 100644
--- a/tests/test_orders.py
+++ b/tests/test_orders.py
@@ -1,7 +1,7 @@
 import pytest
 
 from shoplib.inventory import Inventory
-from shoplib.orders import DELIVERED, NEW, Order
+from shoplib.orders import CANCELLED, DELIVERED, NEW, PAID, SHIPPED, Order
 
 
 def make():
@@ -25,3 +25,47 @@ def test_cannot_ship_unpaid():
     _, order = make()
     with pytest.raises(ValueError):
         order.ship()
+
+
+def test_cancel_new_releases_stock_without_refund():
+    inv, order = make()
+    order.cancel()
+    assert order.state == CANCELLED
+    assert order.refund_due is False
+    assert inv.reserved("A") == 0
+    assert inv.available("A") == 5
+
+
+def test_cancel_paid_releases_stock_and_sets_refund_due():
+    inv, order = make()
+    order.pay()
+    order.cancel()
+    assert order.state == CANCELLED
+    assert order.refund_due is True
+    assert inv.reserved("A") == 0
+    assert inv.available("A") == 5
+
+
+def test_cancel_already_cancelled_does_not_release_twice():
+    inv, order = make()
+    order.cancel()
+    order.cancel()
+    assert inv.available("A") == 5
+    assert inv.reserved("A") == 0
+
+
+@pytest.mark.parametrize("transition,expected_state", [("ship", SHIPPED), ("deliver", DELIVERED)])
+def test_cancel_shipped_or_delivered_fails_without_changes(transition, expected_state):
+    inv, order = make()
+    order.pay()
+    if transition == "ship":
+        order.ship()
+    else:
+        order.ship()
+        order.deliver()
+
+    before = (order.state, order.refund_due, inv.on_hand("A"), inv.reserved("A"))
+    with pytest.raises(ValueError):
+        order.cancel()
+    assert (order.state, order.refund_due, inv.on_hand("A"), inv.reserved("A")) == before
+    assert order.state == expected_state
