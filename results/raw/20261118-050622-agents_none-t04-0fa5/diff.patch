diff --git a/src/shoplib/orders.py b/src/shoplib/orders.py
index 8edb164..8cb0ef3 100644
--- a/src/shoplib/orders.py
+++ b/src/shoplib/orders.py
@@ -46,3 +46,22 @@ class Order:
 
     def deliver(self) -> None:
         self._transition((SHIPPED,), DELIVERED)
+
+    def cancel(self) -> None:
+        """Cancel an unshipped order and release its reserved stock."""
+        if self.state == CANCELLED:
+            return
+        if self.state not in (NEW, PAID):
+            raise ValueError(f"cannot cancel an order in state {self.state}")
+
+        # Check every line first so an inconsistent reservation cannot cause a
+        # partial release across a multi-line order.
+        for sku, qty in self.lines.items():
+            if qty > self.inventory.reserved(sku):
+                raise ValueError(f"only {self.inventory.reserved(sku)} of {sku} reserved")
+
+        was_paid = self.state == PAID
+        for sku, qty in self.lines.items():
+            self.inventory.release(sku, qty)
+        self.state = CANCELLED
+        self.refund_due = was_paid
diff --git a/tests/test_inventory.py b/tests/test_inventory.py
index 37436c0..1edb17e 100644
--- a/tests/test_inventory.py
+++ b/tests/test_inventory.py
@@ -18,3 +18,50 @@ def test_cannot_reserve_more_than_available():
     inv.receive("A", 2)
     with pytest.raises(ValueError):
         inv.reserve("A", 3)
+
+
+def test_release_returns_reserved_stock_to_available():
+    inv = Inventory()
+    inv.receive("A", 10)
+    inv.reserve("A", 4)
+
+    inv.release("A", 3)
+
+    assert inv.on_hand("A") == 10
+    assert inv.reserved("A") == 1
+    assert inv.available("A") == 9
+
+
+@pytest.mark.parametrize("qty", [0, -1])
+def test_release_requires_positive_quantity(qty):
+    inv = Inventory()
+    inv.receive("A", 5)
+    inv.reserve("A", 2)
+    before = (inv.on_hand("A"), inv.reserved("A"))
+
+    with pytest.raises(ValueError):
+        inv.release("A", qty)
+
+    assert (inv.on_hand("A"), inv.reserved("A")) == before
+
+
+def test_release_more_than_reserved_raises_without_changes():
+    inv = Inventory()
+    inv.receive("A", 5)
+    inv.reserve("A", 2)
+    before = (inv.on_hand("A"), inv.reserved("A"))
+
+    with pytest.raises(ValueError):
+        inv.release("A", 3)
+
+    assert (inv.on_hand("A"), inv.reserved("A")) == before
+
+
+def test_release_unreserved_sku_raises_without_changes():
+    inv = Inventory()
+
+    with pytest.raises(ValueError):
+        inv.release("missing", 1)
+
+    assert inv.on_hand("missing") == 0
+    assert inv.reserved("missing") == 0
diff --git a/tests/test_orders.py b/tests/test_orders.py
index d3835d1..701c37e 100644
--- a/tests/test_orders.py
+++ b/tests/test_orders.py
@@ -1,7 +1,7 @@
 import pytest
 
 from shoplib.inventory import Inventory
-from shoplib.orders import DELIVERED, NEW, Order
+from shoplib.orders import CANCELLED, DELIVERED, NEW, PAID, SHIPPED, Order
 
 
 def make():
@@ -25,3 +25,52 @@ def test_cannot_ship_unpaid():
     _, order = make()
     with pytest.raises(ValueError):
         order.ship()
+
+
+def test_cancel_new_order_releases_stock_without_refund():
+    inv, order = make()
+
+    order.cancel()
+
+    assert order.state == CANCELLED
+    assert order.refund_due is False
+    assert inv.reserved("A") == 0
+    assert inv.available("A") == 5
+
+
+def test_cancel_paid_order_releases_stock_and_marks_refund_due():
+    inv, order = make()
+    order.pay()
+
+    order.cancel()
+
+    assert order.state == CANCELLED
+    assert order.refund_due is True
+    assert inv.reserved("A") == 0
+    assert inv.available("A") == 5
+
+
+def test_cancelling_cancelled_order_does_not_release_stock_twice():
+    inv, order = make()
+    order.cancel()
+
+    order.cancel()
+
+    assert order.state == CANCELLED
+    assert inv.reserved("A") == 0
+    assert inv.available("A") == 5
+
+
+@pytest.mark.parametrize("state", [SHIPPED, DELIVERED])
+def test_cannot_cancel_shipped_or_delivered_order(state):
+    inv, order = make()
+    order.pay()
+    order.ship()
+    if state == DELIVERED:
+        order.deliver()
+    before = (order.state, order.refund_due, inv.on_hand("A"), inv.reserved("A"))
+
+    with pytest.raises(ValueError):
+        order.cancel()
+
+    assert (order.state, order.refund_due, inv.on_hand("A"), inv.reserved("A")) == before
