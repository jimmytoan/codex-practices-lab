+def test_apply_coupons_uses_original_subtotal_for_minimum_and_allows_expiry_date():
+    today = date(2026, 1, 1)
+    coupons = [
+        Coupon("CURRENT", "fixed", 100, expires=today, min_subtotal_cents=1000),
+        Coupon("EXPIRED", "fixed", 500, expires=date(2025, 12, 31)),
+        Coupon("TOO_HIGH", "fixed", 50, min_subtotal_cents=1001),
+    ]
+
+    assert apply_coupons(1000, coupons, today) == (900, ["CURRENT"])
+
+
+def test_apply_coupons_clamps_total_and_reports_all_applicable_codes():
