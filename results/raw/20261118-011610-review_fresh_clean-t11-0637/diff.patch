@@ -0,0 +1,84 @@
+import pytest
+
+from shoplib.errors import ShopError
+from shoplib.invoice import build_invoice
+
+
+def test_invoice_allocates_largest_remainders_and_taxes_per_line():
+    invoice = build_invoice(
+        [("a", 5, 2, "standard"), ("b", 5, 1, "food"),
+         ("c", 5, 1, "books")],
+        coupon_cents=2, shipping_cents=50, region="SG",
+    )
+
+    assert invoice == {
+        "lines": [
+            {"sku": "a", "gross_cents": 10, "discount_cents": 1,
+             "net_cents": 9, "tax_cents": 1},
+            {"sku": "b", "gross_cents": 5, "discount_cents": 1,
+             "net_cents": 4, "tax_cents": 0},
+            {"sku": "c", "gross_cents": 5, "discount_cents": 0,
+             "net_cents": 5, "tax_cents": 0},
+        ],
+        "shipping_cents": 50,
+        "shipping_tax_cents": 5,
+        "total_cents": 74,
+    }
+
+
+def test_remainder_order_is_not_input_order():
+    invoice = build_invoice(
+        [("small", 1, 1, "books"), ("large", 2, 1, "books")],
+        coupon_cents=1, shipping_cents=0, region="SG",
+    )
+    assert [line["discount_cents"] for line in invoice["lines"]] == [0, 1]
+
+
+def test_coupon_is_capped_at_gross_even_with_zero_price_line():
+    invoice = build_invoice(
+        [("free", 0, 1, "books"), ("paid", 100, 2, "standard")],
+        coupon_cents=999, shipping_cents=100, region="SG",
+    )
+    assert [line["discount_cents"] for line in invoice["lines"]] == [0, 200]
+    assert invoice["shipping_tax_cents"] == 9
+    assert invoice["total_cents"] == 109
+
+
+def test_zero_gross_and_tax_exempt_shipping():
+    invoice = build_invoice(
+        [("free", 0, 1, "books")],
+        coupon_cents=10, shipping_cents=100, region="SG",
+    )
+    assert invoice == {
+        "lines": [{"sku": "free", "gross_cents": 0, "discount_cents": 0,
+                   "net_cents": 0, "tax_cents": 0}],
+        "shipping_cents": 100,
+        "shipping_tax_cents": 0,
+        "total_cents": 100,
+    }
+
+
+def test_tax_is_rounded_per_line():
+    invoice = build_invoice(
+        [("a", 6, 1, "standard"), ("b", 6, 1, "standard")],
+        coupon_cents=0, shipping_cents=0, region="SG",
+    )
+    assert [line["tax_cents"] for line in invoice["lines"]] == [1, 1]
+    assert invoice["total_cents"] == 14
+
+
+@pytest.mark.parametrize(
+    "lines,coupon,shipping,region",
+    [
+        ([("sku", 1, 1, "standard")], 0, 0, "unknown"),
+        ([], 0, 0, "SG"),
+        ([("sku", 1, 1, "unknown")], 0, 0, "SG"),
+        ([("sku", 1, 0, "standard")], 0, 0, "SG"),
+        ([("sku", -1, 1, "standard")], 0, 0, "SG"),
+        ([("sku", 1, 1, "standard")], -1, 0, "SG"),
+        ([("sku", 1, 1, "standard")], 0, -1, "SG"),
+    ],
+)
+def test_invalid_arguments_raise_shop_error(lines, coupon, shipping, region):
+    with pytest.raises(ShopError):
+        build_invoice(lines, coupon, shipping, region)
