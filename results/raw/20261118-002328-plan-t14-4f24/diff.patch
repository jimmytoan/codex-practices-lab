@@ -1,6 +1,49 @@
 """Revenue per store day. See docs/store-days.md."""
 
+from datetime import datetime, timedelta, timezone
+
+from shoplib.errors import ShopError
+
 
 def daily_revenue(sales: list[dict], utc_offset_hours: int = 8, day_starts_hour: int = 4) -> list[tuple[str, int]]:
     """Revenue per store day. See docs/store-days.md."""
-    raise NotImplementedError
+    if type(utc_offset_hours) is not int or not -24 < utc_offset_hours < 24:
+        raise ShopError("Invalid UTC offset")
+    if type(day_starts_hour) is not int or not 0 <= day_starts_hour < 24:
+        raise ShopError("Invalid store day start hour")
+
+    try:
+        sale_iter = iter(sales)
+    except TypeError as exc:
+        raise ShopError("Invalid sales") from exc
+    local_zone = timezone(timedelta(hours=utc_offset_hours))
+    totals = {}
+    for sale in sale_iter:
+        try:
+            timestamp = datetime.fromisoformat(sale["at"])
+            cents = sale["cents"]
+        except (KeyError, TypeError, ValueError) as exc:
+            raise ShopError("Invalid sale") from exc
+        if timestamp.tzinfo is None or timestamp.utcoffset() is None:
+            raise ShopError("Sale timestamp must include a time zone")
+        if type(cents) is not int:
+            raise ShopError("Sale cents must be an integer")
+        try:
+            local = timestamp.astimezone(local_zone)
+            day = local.date()
+            if local.hour < day_starts_hour:
+                day -= timedelta(days=1)
+        except (OverflowError, ValueError) as exc:
+            raise ShopError("Sale timestamp is out of range") from exc
+        totals[day] = totals.get(day, 0) + cents
+
+    if not totals:
+        return []
+
+    day, last_day = min(totals), max(totals)
+    result = []
+    while day < last_day:
+        result.append((day.isoformat(), totals.get(day, 0)))
+        day += timedelta(days=1)
+    result.append((last_day.isoformat(), totals[last_day]))
+    return result
diff --git a/tests/test_storedays.py b/tests/test_storedays.py
new file mode 100644
index 0000000..94a6a11
--- /dev/null
+++ b/tests/test_storedays.py
@@ -0,0 +1,73 @@
+import pytest
+
+from shoplib.errors import ShopError
+from shoplib.storedays import daily_revenue
+
+
+def test_empty_sales():
+    assert daily_revenue([]) == []
+
+
+def test_default_boundary_time_zones_refunds_and_gaps():
+    sales = [
+        {"at": "2026-11-20T04:00:00+08:00", "cents": 500},
+        {"at": "2026-11-17T18:30:00Z", "cents": 100},
+        {"at": "2026-11-17T19:59:59+00:00", "cents": -30},
+        {"at": "2026-11-17T20:00:00Z", "cents": 200},
+        {"at": "2026-11-17T15:00:00-05:00", "cents": -50},
+    ]
+    assert daily_revenue(sales) == [
+        ("2026-11-17", 70),
+        ("2026-11-18", 150),
+        ("2026-11-19", 0),
+        ("2026-11-20", 500),
+    ]
+
+
+def test_custom_offset_and_start_across_year_boundary():
+    sales = [
+        {"at": "2027-01-01T06:59:59Z", "cents": 10},
+        {"at": "2027-01-01T07:00:00Z", "cents": 20},
+    ]
+    assert daily_revenue(sales, utc_offset_hours=-5, day_starts_hour=2) == [
+        ("2026-12-31", 10),
+        ("2027-01-01", 20),
+    ]
+
+
+def test_midnight_start():
+    assert daily_revenue(
+        [{"at": "2026-11-18T00:00:00+08:00", "cents": 3}],
+        day_starts_hour=0,
+    ) == [("2026-11-18", 3)]
+
+
+def test_timestamp_without_zone_raises_shop_error():
+    with pytest.raises(ShopError):
+        daily_revenue([{"at": "2026-11-18T02:30:00", "cents": 100}])
+
+
+def test_invalid_sales_raises_shop_error():
+    with pytest.raises(ShopError):
+        daily_revenue(None)
+
+
+@pytest.mark.parametrize("kwargs", [
+    {"utc_offset_hours": 24},
+    {"utc_offset_hours": -24},
+    {"day_starts_hour": 24},
+    {"day_starts_hour": -1},
+])
+def test_invalid_configuration_raises_shop_error(kwargs):
+    with pytest.raises(ShopError):
+        daily_revenue([], **kwargs)
+
+
+@pytest.mark.parametrize("sale", [
+    {"at": "invalid", "cents": 100},
+    {"at": "2026-11-18T02:30:00Z", "cents": 1.5},
+    {"at": "2026-11-18T02:30:00Z"},
+])
+def test_invalid_sale_raises_shop_error(sale):
+    with pytest.raises(ShopError):
+        daily_revenue([sale])
