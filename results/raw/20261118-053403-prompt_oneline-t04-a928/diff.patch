 import pytest
 
 from shoplib.inventory import Inventory
-from shoplib.orders import DELIVERED, NEW, Order
+from shoplib.errors import ShopError
+from shoplib.orders import CANCELLED, DELIVERED, NEW, Order
 
 
 def make():
@@ -25,3 +26,55 @@ def test_cannot_ship_unpaid():
     _, order = make()
     with pytest.raises(ValueError):
         order.ship()
+
+
+def test_cancel_new_order_releases_stock_without_refund():
+    inv, order = make()
+
+    order.cancel()
+
+    assert order.state == CANCELLED
+    assert order.refund_due is False
+    assert inv.reserved("A") == 0
+    assert inv.available("A") == 5
+
+
+def test_cancel_paid_order_releases_stock_and_marks_refund_due():
+    inv, order = make()
+    order.pay()
+
+    order.cancel()
+
+    assert order.state == CANCELLED
+    assert order.refund_due is True
+    assert inv.reserved("A") == 0
+    assert inv.available("A") == 5
+
+
+def test_cancelling_twice_does_not_release_stock_twice():
+    inv, order = make()
+    order.cancel()
+
+    order.cancel()
+
+    assert order.state == CANCELLED
+    assert inv.reserved("A") == 0
+    assert inv.available("A") == 5
+
+
+@pytest.mark.parametrize("deliver", [False, True])
+def test_cannot_cancel_shipped_or_delivered_order(deliver):
+    inv, order = make()
+    order.pay()
+    order.ship()
+    if deliver:
+        order.deliver()
+    state = order.state
+    stock = (inv.on_hand("A"), inv.reserved("A"), inv.available("A"))
+
+    with pytest.raises(ShopError):
+        order.cancel()
+
+    assert order.state == state
+    assert order.refund_due is False
+    assert (inv.on_hand("A"), inv.reserved("A"), inv.available("A")) == stock
