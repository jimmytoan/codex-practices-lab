diff --git a/tests/test_inventory.py b/tests/test_inventory.py
index 37436c0..59412b0 100644
--- a/tests/test_inventory.py
+++ b/tests/test_inventory.py
@@ -1,6 +1,7 @@
 import pytest
 
 from shoplib.inventory import Inventory
+from shoplib.errors import ShopError
 
 
 def test_reserve_and_ship():
@@ -18,3 +19,43 @@ def test_cannot_reserve_more_than_available():
     inv.receive("A", 2)
     with pytest.raises(ValueError):
         inv.reserve("A", 3)
+
+
+def test_release_partial_and_full_reservation():
+    inv = Inventory()
+    inv.receive("A", 10)
+    inv.reserve("A", 4)
+    inv.receive("B", 3)
+    inv.reserve("B", 2)
+
+    inv.release("A", 2)
+    assert (inv.on_hand("A"), inv.reserved("A"), inv.available("A")) == (10, 2, 8)
+    assert (inv.on_hand("B"), inv.reserved("B"), inv.available("B")) == (3, 2, 1)
+
+    inv.release("A", 2)
+    assert (inv.on_hand("A"), inv.reserved("A"), inv.available("A")) == (10, 0, 10)
+
+
+@pytest.mark.parametrize("qty", [0, -1, 5])
+def test_invalid_release_preserves_stock(qty):
+    inv = Inventory()
+    inv.receive("A", 10)
+    inv.reserve("A", 4)
+
+    with pytest.raises(ShopError):
+        inv.release("A", qty)
+
+    assert (inv.on_hand("A"), inv.reserved("A"), inv.available("A")) == (10, 4, 6)
+
+
+@pytest.mark.parametrize("receive_first", [False, True])
+def test_cannot_release_unreserved_stock(receive_first):
+    inv = Inventory()
+    if receive_first:
+        inv.receive("A", 3)
+
+    with pytest.raises(ShopError):
+        inv.release("A", 1)
+
+    expected = 3 if receive_first else 0
+    assert (inv.on_hand("A"), inv.reserved("A"), inv.available("A")) == (expected, 0, expected)
