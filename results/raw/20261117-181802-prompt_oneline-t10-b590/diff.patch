 """Shipping costs and parcel splitting. See docs/shipping.md."""
 
+from .errors import ShopError
+
 # (upper bound in grams, cost in cents)
 TIERS = [(1000, 500), (2000, 800), (5000, 1200), (20000, 2500)]
 
 
 def shipping_cost(weight_g: int) -> int:
     """Cost in cents of one parcel of `weight_g` grams. See docs/shipping.md."""
-    if weight_g <= 0:
-        raise ValueError("weight must be positive")
+    if not isinstance(weight_g, int) or isinstance(weight_g, bool) or weight_g <= 0:
+        raise ShopError("weight must be a positive integer")
     for limit, cost in TIERS:
-        if weight_g < limit:
+        if weight_g <= limit:
             return cost
-    raise ValueError("parcel is too heavy")
+    raise ShopError("parcel is too heavy")
+
+
+def _pack_units(items: list[tuple[str, int, int]], max_weight_g: int) -> list[list[tuple[str, int]]]:
+    if not isinstance(max_weight_g, int) or isinstance(max_weight_g, bool) or max_weight_g <= 0:
+        raise ShopError("max_weight_g must be a positive integer")
+    if not isinstance(items, list):
+        raise ShopError("items must be a list")
+
+    units: list[tuple[int, str]] = []
+    for item in items:
+        if not isinstance(item, (tuple, list)) or len(item) != 3:
+            raise ShopError("each item must be a (sku, unit_weight_g, qty) tuple")
+        sku, unit_weight_g, qty = item
+        if not isinstance(sku, str):
+            raise ShopError("sku must be a string")
+        if not isinstance(unit_weight_g, int) or isinstance(unit_weight_g, bool) or unit_weight_g < 1:
+            raise ShopError("unit weight must be a positive integer")
+        if not isinstance(qty, int) or isinstance(qty, bool) or qty < 1:
+            raise ShopError("qty must be a positive integer")
+        if unit_weight_g > max_weight_g:
+            raise ShopError(f"unit {sku!r} is heavier than max_weight_g")
+        units.extend((unit_weight_g, sku) for _ in range(qty))
+
+    units.sort(key=lambda unit: (-unit[0], unit[1]))
+    parcels: list[list[tuple[str, int]]] = []
+    parcel_weights: list[int] = []
+    for unit_weight_g, sku in units:
+        for index, parcel_weight_g in enumerate(parcel_weights):
+            if parcel_weight_g + unit_weight_g <= max_weight_g:
+                parcels[index].append((sku, unit_weight_g))
+                parcel_weights[index] += unit_weight_g
+                break
+        else:
+            parcels.append([(sku, unit_weight_g)])
+            parcel_weights.append(unit_weight_g)
+    return parcels
 
 
 def split_parcels(items: list[tuple[str, int, int]], max_weight_g: int) -> list[list[str]]:
     """Split order items into parcels. See docs/shipping.md."""
-    raise NotImplementedError
+    return [[sku for sku, _ in parcel] for parcel in _pack_units(items, max_weight_g)]
 
 
 def shipment_cost(items: list[tuple[str, int, int]], max_weight_g: int) -> int:
     """Total shipping cost of an order. See docs/shipping.md."""
-    raise NotImplementedError
+    return sum(shipping_cost(sum(weight_g for _, weight_g in parcel))
+               for parcel in _pack_units(items, max_weight_g))
