+import csv
+import io
+
 from shoplib.reports import sales_summary, to_csv
 
 SALES = [
@@ -16,3 +19,25 @@ def test_summary():
 
 def test_csv():
     assert to_csv(sales_summary(SALES)) == "sku,name,units,revenue_cents\nA,Mug,3,1350\nB,Bowl,1,900\n"
+
+
+def test_csv_quotes_special_fields():
+    rows = [
+        {"sku": "A,1", "name": 'A "quoted"\nname', "units": 2, "revenue_cents": 900},
+        {"sku": "B\r2", "name": "plain", "units": 1, "revenue_cents": 450},
+    ]
+    output = to_csv(rows)
+    assert output == (
+        'sku,name,units,revenue_cents\n'
+        '"A,1","A ""quoted""\nname",2,900\n'
+        '"B\r2",plain,1,450\n'
+    )
+    assert list(csv.reader(io.StringIO(output, newline=""))) == [
+        ["sku", "name", "units", "revenue_cents"],
+        ["A,1", 'A "quoted"\nname', "2", "900"],
+        ["B\r2", "plain", "1", "450"],
+    ]
+
+
+def test_csv_empty_rows_has_header():
+    assert to_csv([]) == "sku,name,units,revenue_cents\n"
