diff --git a/tests/test_cart.py b/tests/test_cart.py
index 1a3d0e7..30790d9 100644
--- a/tests/test_cart.py
+++ b/tests/test_cart.py
@@ -1,6 +1,7 @@
 import pytest
 
 from shoplib.cart import Cart
+from shoplib.errors import ShopError
 
 
 def test_add_and_subtotal():
@@ -21,3 +22,28 @@ def test_add_same_sku_merges():
 def test_bad_qty():
     with pytest.raises(ValueError):
         Cart().add("A", 250, 0)
+
+
+@pytest.mark.parametrize(
+    ("qty", "expected"), [(9, 2250), (10, 2375), (11, 2612)]
+)
+def test_bulk_discount_threshold(qty, expected):
+    cart = Cart()
+    cart.add("A", 250, qty)
+    assert cart.line_total("A") == expected
+
+
+def test_bulk_discount_uses_merged_quantity_and_rounds_each_line():
+    cart = Cart()
+    cart.add("A", 1, 9)
+    cart.add("A", 1)
+    cart.add("B", 1, 10)
+    cart.add("C", 1, 9)
+    assert cart.line_total("A") == 9
+    assert cart.line_total("B") == 9
+    assert cart.subtotal() == 27
+
+
+def test_line_total_missing_sku_raises_shop_error():
+    with pytest.raises(ShopError):
+        Cart().line_total("missing")
