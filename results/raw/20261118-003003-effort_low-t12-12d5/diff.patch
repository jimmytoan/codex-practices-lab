 def search(products: list[Product], query: str) -> list[Product]:
     """The products that match `query`, in their input order. See docs/search.md."""
-    raise NotImplementedError
+    tokens = []
+    token = []
+    quoted = False
+    started = False
+    for char in query:
+        if char == '"':
+            quoted = not quoted
+            started = True
+        elif char.isspace() and not quoted:
+            if started:
+                tokens.append(''.join(token))
+                token = []
+                started = False
+        else:
+            token.append(char)
+            started = True
+    if quoted:
+        raise ShopError("unclosed quote")
+    if started:
+        tokens.append(''.join(token))
+
+    comparisons = {'<': operator.lt, '<=': operator.le, '>': operator.gt,
+                   '>=': operator.ge, '=': operator.eq}
+    terms = []
+    for token in tokens:
+        negated = token.startswith('-')
+        if negated:
+            token = token[1:]
+            if not token:
+                raise ShopError("empty negated term")
+        price = re.match(r'^price(<=|>=|<|>|=)(.*)$', token, re.DOTALL)
+        if price:
+            value = price.group(2)
+            if not re.fullmatch(r'[0-9]+', value):
+                raise ShopError("invalid price")
+            terms.append((negated, 'price', comparisons[price.group(1)], int(value)))
+        elif ':' in token:
+            field_name, value = token.split(':', 1)
+            if field_name not in ('sku', 'name', 'tag'):
+                raise ShopError("unknown field")
+            if not value:
+                raise ShopError("empty field value")
+            prefix = field_name in ('sku', 'tag') and value.endswith('*')
+            terms.append((negated, field_name, prefix, value[:-1].casefold() if prefix else value.casefold()))
+        else:
+            terms.append((negated, 'name', False, token.casefold()))
+
+    def matches(product, term):
+        negated, kind, operation, value = term
+        if kind == 'price':
+            matched = operation(product.price_cents, value)
+        elif kind == 'name':
+            matched = value in product.name.casefold()
+        else:
+            values = [product.sku] if kind == 'sku' else product.tags
+            matched = any(item.casefold().startswith(value) if operation
+                          else item.casefold() == value for item in values)
+        return not matched if negated else matched
+
+    return [product for product in products if all(matches(product, term) for term in terms)]
