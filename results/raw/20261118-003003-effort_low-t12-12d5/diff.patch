@@ -0,0 +1,42 @@
+import pytest
+
+from shoplib.errors import ShopError
+from shoplib.search import Product, search
+
+
+@pytest.fixture
+def products():
+    return [
+        Product('MUG-1', 'Blue Mug', 1000, ['Sale', 'Kitchen']),
+        Product('MUG-2', 'blue travel mug', 1500, ['Kitchenware']),
+        Product('CUP-1', 'Red Cup', 1000, ['sale']),
+        Product('STAR*X', 'Star* Mug', 0, ['star*x']),
+    ]
+
+
+@pytest.mark.parametrize(('query', 'indexes'), [
+    ('', [0, 1, 2, 3]), (' \t\n', [0, 1, 2, 3]),
+    ('mUg', [0, 1, 3]), ('"blue mug"', [0]),
+    ('name:"BLUE travel"', [1]), ('sku:mug-1', [0]),
+    ('tag:sALE', [0, 2]), ('sku:mug-*', [0, 1]),
+    ('tag:kit*', [0, 1]), ('sku:star*x', [3]),
+    ('tag:star*x', [3]), ('name:star*', [3]),
+    ('price<1000', [3]), ('price<=1000', [0, 2, 3]),
+    ('price>1000', [1]), ('price>=1000', [0, 1, 2]),
+    ('price=1000', [0, 2]), ('-tag:sale', [1, 3]),
+    ('mug -sku:mug-1 price>=1000', [1]),
+    ('-price>=1000', [3]), ('"name:Blue Mug"', [0]),
+])
+def test_search_terms(products, query, indexes):
+    assert search(products, query) == [products[index] for index in indexes]
+
+
+@pytest.mark.parametrize('query', [
+    'other:value', 'price:5', ':value', 'tag:', 'name:""', 'sku:',
+    '-', '-""', '"unclosed', 'name:"unclosed',
+    'price=', 'price>1.5', 'price>=-1', 'price<abc', 'price==5',
+    'mug tag:',
+])
+def test_invalid_queries_raise_even_without_products(query):
+    with pytest.raises(ShopError):
+        search([], query)
