 def make():
@@ -25,3 +25,47 @@ def test_cannot_ship_unpaid():
     _, order = make()
     with pytest.raises(ValueError):
         order.ship()
+
+
+def test_cancel_new_order_releases_stock_and_is_idempotent():
+    inv, order = make()
+
+    order.cancel()
+
+    assert order.state == CANCELLED
+    assert order.refund_due is False
+    assert inv.reserved("A") == 0
+    assert inv.available("A") == 5
+
+    order.cancel()
+    assert inv.available("A") == 5
+
+
+def test_cancel_paid_order_sets_refund_due():
+    inv, order = make()
+    order.pay()
+
+    order.cancel()
+
+    assert order.state == CANCELLED
+    assert order.refund_due is True
+    assert inv.reserved("A") == 0
+
+
+@pytest.mark.parametrize("transition", ["ship", "deliver"])
+def test_cannot_cancel_shipped_or_delivered_order(transition):
+    inv, order = make()
+    order.pay()
+    order.ship()
+    if transition == "deliver":
+        order.deliver()
+    state = order.state
+    on_hand = inv.on_hand("A")
+    reserved = inv.reserved("A")
+
+    with pytest.raises(ValueError):
+        order.cancel()
+
+    assert order.state == state
+    assert inv.on_hand("A") == on_hand
+    assert inv.reserved("A") == reserved
