diff --git a/src/shoplib/storedays.py b/src/shoplib/storedays.py
index c46116f..35e86f1 100644
--- a/src/shoplib/storedays.py
+++ b/src/shoplib/storedays.py
@@ -1,6 +1,29 @@
 """Revenue per store day. See docs/store-days.md."""
 
+from datetime import datetime, timedelta, timezone
+
 
 def daily_revenue(sales: list[dict], utc_offset_hours: int = 8, day_starts_hour: int = 4) -> list[tuple[str, int]]:
     """Revenue per store day. See docs/store-days.md."""
-    raise NotImplementedError
+    shop_timezone = timezone(timedelta(hours=utc_offset_hours))
+    day_start = timedelta(hours=day_starts_hour)
+    totals = {}
+
+    for sale in sales:
+        timestamp = datetime.fromisoformat(sale["at"])
+        if timestamp.utcoffset() is None:
+            raise ValueError("sale timestamp must include a time zone")
+        store_day = (timestamp.astimezone(shop_timezone) - day_start).date()
+        totals[store_day] = totals.get(store_day, 0) + sale["cents"]
+
+    if not totals:
+        return []
+
+    current_day = min(totals)
+    last_day = max(totals)
+    result = []
+    while True:
+        result.append((current_day.isoformat(), totals.get(current_day, 0)))
+        if current_day == last_day:
+            return result
+        current_day += timedelta(days=1)
diff --git a/tests/test_storedays.py b/tests/test_storedays.py
new file mode 100644
index 0000000..7ec7587
--- /dev/null
+++ b/tests/test_storedays.py
@@ -0,0 +1,50 @@
+import pytest
+
+from shoplib.storedays import daily_revenue
+
+
+def test_boundary_offsets_refunds_and_unordered_sales():
+    sales = [
+        {"at": "2026-11-18T04:00:00+08:00", "cents": 500},
+        {"at": "2026-11-17T20:00:00Z", "cents": -125},
+        {"at": "2026-11-17T14:59:59-05:00", "cents": 250},
+        {"at": "2026-11-18T02:30:00+08:00", "cents": 75},
+    ]
+
+    assert daily_revenue(sales) == [("2026-11-17", 325), ("2026-11-18", 375)]
+
+
+def test_gaps_across_leap_day_and_year_boundary():
+    sales = [
+        {"at": "2024-03-01T04:00:00Z", "cents": 10},
+        {"at": "2024-02-28T04:00:00Z", "cents": 20},
+    ]
+
+    assert daily_revenue(sales, utc_offset_hours=0) == [
+        ("2024-02-28", 20),
+        ("2024-02-29", 0),
+        ("2024-03-01", 10),
+    ]
+    assert daily_revenue([
+        {"at": "2026-12-31T23:00:00Z", "cents": 3},
+        {"at": "2027-01-02T01:00:00Z", "cents": 4},
+    ], utc_offset_hours=0, day_starts_hour=0) == [
+        ("2026-12-31", 3), ("2027-01-01", 0), ("2027-01-02", 4)
+    ]
+
+
+def test_custom_negative_offset_and_start_hour():
+    sales = [
+        {"at": "2026-11-18T10:59:59Z", "cents": 1},
+        {"at": "2026-11-18T11:00:00Z", "cents": 2},
+    ]
+
+    assert daily_revenue(sales, utc_offset_hours=-5, day_starts_hour=6) == [
+        ("2026-11-17", 1), ("2026-11-18", 2)
+    ]
+
+
+def test_empty_sales_and_missing_time_zone():
+    assert daily_revenue([]) == []
+    with pytest.raises(ValueError):
+        daily_revenue([{"at": "2026-11-18T04:00:00", "cents": 100}])
