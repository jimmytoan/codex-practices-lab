diff --git a/tests/test_dates.py b/tests/test_dates.py
index fbfd5f2..24db191 100644
--- a/tests/test_dates.py
+++ b/tests/test_dates.py
@@ -1,6 +1,9 @@
 from datetime import date
 
+import pytest
+
 from shoplib.dates import add_business_days, is_business_day
+from shoplib.errors import ShopError
 
 
 def test_is_business_day():
@@ -12,3 +15,48 @@ def test_forward_over_weekend():
     # Friday + 1 business day = Monday
     assert add_business_days(date(2026, 11, 13), 1) == date(2026, 11, 16)
     assert add_business_days(date(2026, 11, 16), 3) == date(2026, 11, 19)
+
+
+def test_holidays_are_skipped_in_both_directions():
+    holidays = [date(2026, 11, 16), date(2026, 11, 17)]
+    assert add_business_days(date(2026, 11, 13), 1, holidays) == date(2026, 11, 18)
+    assert add_business_days(date(2026, 11, 18), -1, holidays) == date(2026, 11, 13)
+    assert add_business_days(date(2026, 11, 13), 2, holidays) == date(2026, 11, 19)
+    assert add_business_days(date(2026, 11, 18), -2, holidays) == date(2026, 11, 12)
+
+
+def test_non_business_start_is_excluded_for_nonzero_offsets():
+    assert add_business_days(date(2026, 11, 15), 1) == date(2026, 11, 16)
+    assert add_business_days(date(2026, 11, 15), -1) == date(2026, 11, 13)
+    holiday = [date(2026, 11, 16)]
+    assert add_business_days(date(2026, 11, 16), 1, holiday) == date(2026, 11, 17)
+    assert add_business_days(date(2026, 11, 16), -1, holiday) == date(2026, 11, 13)
+
+
+def test_zero_returns_start_or_next_business_day():
+    holidays = [date(2026, 11, 16), date(2026, 11, 17)]
+    assert add_business_days(date(2026, 11, 13), 0, holidays) == date(2026, 11, 13)
+    assert add_business_days(date(2026, 11, 14), 0, holidays) == date(2026, 11, 18)
+    assert add_business_days(date(2026, 11, 16), 0, holidays) == date(2026, 11, 18)
+
+
+def test_holidays_may_be_a_generator():
+    holidays = (day for day in [date(2026, 11, 17), date(2026, 11, 16)])
+    assert add_business_days(date(2026, 11, 13), 1, holidays) == date(2026, 11, 18)
+
+
+@pytest.mark.parametrize(
+    ("start", "n", "holidays"),
+    [("2026-11-16", 1, ()), (date(2026, 11, 16), 0.5, ()),
+     (date(2026, 11, 16), 1, None)],
+)
+def test_invalid_arguments_raise_shop_error(start, n, holidays):
+    with pytest.raises(ShopError):
+        add_business_days(start, n, holidays)
+
+
+def test_out_of_range_result_raises_shop_error():
+    with pytest.raises(ShopError):
+        add_business_days(date.max, 1)
+    with pytest.raises(ShopError):
+        add_business_days(date.min, -1)
