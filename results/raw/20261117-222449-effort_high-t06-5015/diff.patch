 def is_business_day(day: date, holidays=()) -> bool:
     """Monday to Friday, and not listed in `holidays`."""
@@ -20,10 +22,28 @@ def add_business_days(start: date, n: int, holidays=()) -> date:
 
     `start` does not have to be a business day.
     """
-    # TODO: holidays and negative n are not handled yet
+    if not isinstance(start, date):
+        raise ShopError("start must be a date")
+    if not isinstance(n, int):
+        raise ShopError("n must be an integer")
+    try:
+        holidays = frozenset(holidays)
+    except TypeError as exc:
+        raise ShopError("holidays must be an iterable of dates") from exc
+
     day = start
-    while n > 0:
-        day += timedelta(days=1)
-        if day.weekday() < 5:
-            n -= 1
+    direction = -1 if n < 0 else 1
+    remaining = abs(n)
+    if remaining == 0 and is_business_day(day, holidays):
+        return day
+    if remaining == 0:
+        remaining = 1
+
+    while remaining:
+        try:
+            day += timedelta(days=direction)
