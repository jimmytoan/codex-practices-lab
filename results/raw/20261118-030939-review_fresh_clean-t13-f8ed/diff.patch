diff --git a/src/shoplib/costing.py b/src/shoplib/costing.py
index 5e8c27e..5224abf 100644
--- a/src/shoplib/costing.py
+++ b/src/shoplib/costing.py
@@ -1,6 +1,56 @@
 """Cost of goods sold with FIFO lots. See docs/costing.md."""
 
+from decimal import Decimal, localcontext
+
+from .errors import ShopError
+from .money import round_cents
+
 
 def fifo_costing(events: list[dict]) -> dict:
     """Process stock events and report cost per SKU. See docs/costing.md."""
-    raise NotImplementedError
+    lots: dict[str, list[list[int]]] = {}
+    cogs: dict[str, int] = {}
+    last_sale: dict[str, dict] = {}
+    for ev in events:
+        kind, sku, qty = ev["type"], ev["sku"], ev["qty"]
+        if qty < 1:
+            raise ShopError("qty must be at least 1")
+        lots.setdefault(sku, [])
+        cogs.setdefault(sku, 0)
+        if kind == "receive":
+            if ev["unit_cost_cents"] < 0:
+                raise ShopError("unit cost must not be negative")
+            lots[sku].append([qty, ev["unit_cost_cents"]])
+        elif kind == "sell":
+            if qty > sum(q for q, _ in lots[sku]):
+                raise ShopError(f"not enough {sku} on hand")
+            need, cost = qty, 0
+            while need:
+                lot = lots[sku][0]
+                take = min(need, lot[0])
+                cost += take * lot[1]
+                lot[0] -= take
+                need -= take
+                if lot[0] == 0:
+                    lots[sku].pop(0)
+            cogs[sku] += cost
+            last_sale[sku] = {"qty": qty, "cost": cost, "returned": 0}
+        elif kind == "return":
+            sale = last_sale.get(sku)
+            if sale is None or qty > sale["qty"] - sale["returned"]:
+                raise ShopError(f"cannot return {qty} of {sku}")
+            cost = Decimal(sale["cost"])
+            quantity = Decimal(sale["qty"])
+            with localcontext() as context:
+                # Preserve enough digits to distinguish values just below a half
+                # cent, as well as to quantize large integer costs.
+                context.prec = max(context.prec, len(cost.as_tuple().digits)
+                                   + len(quantity.as_tuple().digits) + 1)
+                unit = round_cents(cost / quantity)
+            sale["returned"] += qty
+            lots[sku].append([qty, unit])
+            cogs[sku] -= qty * unit
+        else:
+            raise ShopError(f"unknown event type {kind!r}")
+    return {sku: {"cogs_cents": cogs[sku], "on_hand": sum(q for q, _ in lots[sku]),
+                  "value_cents": sum(q * c for q, c in lots[sku])} for sku in lots}
diff --git a/tests/test_costing.py b/tests/test_costing.py
new file mode 100644
index 0000000..51f1233
--- /dev/null
+++ b/tests/test_costing.py
@@ -0,0 +1,88 @@
+from copy import deepcopy
+
+import pytest
+
+from shoplib.costing import fifo_costing
+from shoplib.errors import ShopError
+
+
+def receive(sku, qty, unit_cost):
+    return {"type": "receive", "sku": sku, "qty": qty, "unit_cost_cents": unit_cost}
+
+
+def event(kind, sku, qty):
+    return {"type": kind, "sku": sku, "qty": qty}
+
+
+def test_fifo_returns_are_new_lots_after_existing_stock():
+    events = [
+        receive("A", 2, 100), receive("B", 2, 0), receive("A", 3, 201),
+        event("sell", "A", 3), receive("A", 1, 300), event("return", "A", 1),
+        event("sell", "A", 3),
+    ]
+    original = deepcopy(events)
+    assert fifo_costing(events) == {
+        "A": {"cogs_cents": 969, "on_hand": 1, "value_cents": 134},
+        "B": {"cogs_cents": 0, "on_hand": 2, "value_cents": 0},
+    }
+    assert events == original
+
+
+def test_multiple_returns_use_most_recent_sale_average_half_up():
+    events = [receive("A", 1, 1), receive("A", 1, 2), event("sell", "A", 2),
+              event("return", "A", 1), event("return", "A", 1)]
+    assert fifo_costing(events) == {
+        "A": {"cogs_cents": -1, "on_hand": 2, "value_cents": 4}
+    }
+
+
+def test_returns_track_each_sku_and_most_recent_sale():
+    events = [receive("A", 3, 10), receive("B", 1, 20), event("sell", "A", 2),
+              event("sell", "B", 1), event("sell", "A", 1),
+              event("return", "B", 1), event("return", "A", 1)]
+    assert fifo_costing(events) == {
+        "A": {"cogs_cents": 20, "on_hand": 1, "value_cents": 10},
+        "B": {"cogs_cents": 0, "on_hand": 1, "value_cents": 20},
+    }
+
+
+def test_empty_events():
+    assert fifo_costing([]) == {}
+
+
+@pytest.mark.parametrize("events", [
+    [receive("A", 0, 1)],
+    [event("sell", "A", -1)],
+    [event("return", "A", 0)],
+    [receive("A", 1, -1)],
+    [receive("A", 1, 1), event("sell", "A", 2)],
+    [receive("A", 1, 1), event("return", "A", 1)],
+    [receive("A", 2, 1), event("sell", "A", 2),
+     event("return", "A", 1), event("return", "A", 2)],
+    [receive("A", 3, 1), event("sell", "A", 2), event("sell", "A", 1),
+     event("return", "A", 2)],
+    [event("unknown", "A", 1)],
+])
+def test_invalid_events_raise_shop_error_without_mutating_input(events):
+    original = deepcopy(events)
+    with pytest.raises(ShopError):
+        fifo_costing(events)
+    assert events == original
+
+
+def test_large_sale_average_just_below_half_cent():
+    qty = 10**28 + 1
+    cost = 5 * 10**27
+    events = [receive("A", 1, cost), receive("A", qty - 1, 0),
+              event("sell", "A", qty), event("return", "A", 1)]
+    assert fifo_costing(events) == {
+        "A": {"cogs_cents": cost, "on_hand": 1, "value_cents": 0}
+    }
+
+
+def test_large_unit_cost_can_be_returned():
+    cost = 10**28
+    events = [receive("A", 1, cost), event("sell", "A", 1), event("return", "A", 1)]
+    assert fifo_costing(events) == {
+        "A": {"cogs_cents": 0, "on_hand": 1, "value_cents": cost}
+    }
