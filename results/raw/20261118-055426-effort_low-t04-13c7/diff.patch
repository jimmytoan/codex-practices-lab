diff --git a/src/shoplib/orders.py b/src/shoplib/orders.py
index 8edb164..ae13019 100644
--- a/src/shoplib/orders.py
+++ b/src/shoplib/orders.py
@@ -1,6 +1,7 @@
 """Orders and their life cycle. See docs/order-states.md."""
 
 from .inventory import Inventory
+from .errors import ShopError
 
 NEW = "NEW"
 PAID = "PAID"
@@ -46,3 +47,23 @@ class Order:
 
     def deliver(self) -> None:
         self._transition((SHIPPED,), DELIVERED)
+
+    def cancel(self) -> None:
+        """Cancel an unshipped order and release its reserved stock."""
+        if self.state == CANCELLED:
+            return
+        if self.state not in (NEW, PAID):
+            raise ShopError(f"cannot cancel an order in state {self.state}")
+
+        # Check every line before releasing any, so failure leaves inventory
+        # and the order unchanged.
+        for sku, qty in self.lines.items():
+            if self.inventory.reserved(sku) < qty:
+                raise ShopError(f"only {self.inventory.reserved(sku)} of {sku} reserved")
+
+        for sku, qty in self.lines.items():
+            self.inventory.release(sku, qty)
+
+        if self.state == PAID:
+            self.refund_due = True
+        self.state = CANCELLED
diff --git a/tests/test_inventory.py b/tests/test_inventory.py
index 37436c0..19b5ce7 100644
--- a/tests/test_inventory.py
+++ b/tests/test_inventory.py
@@ -18,3 +18,22 @@ def test_cannot_reserve_more_than_available():
     inv.receive("A", 2)
     with pytest.raises(ValueError):
         inv.reserve("A", 3)
+
+
+def test_release_reserved_stock():
+    inv = Inventory()
+    inv.receive("A", 5)
+    inv.reserve("A", 3)
+    inv.release("A", 2)
+    assert inv.reserved("A") == 1
+    assert inv.available("A") == 4
+
+
+@pytest.mark.parametrize("qty", [0, -1, 2])
+def test_release_rejects_invalid_or_unreserved_qty(qty):
+    inv = Inventory()
+    inv.receive("A", 1)
+    with pytest.raises(ValueError):
+        inv.release("A", qty)
+    assert inv.reserved("A") == 0
+    assert inv.available("A") == 1
diff --git a/tests/test_orders.py b/tests/test_orders.py
index d3835d1..554d584 100644
--- a/tests/test_orders.py
+++ b/tests/test_orders.py
@@ -1,7 +1,7 @@
 import pytest
 
 from shoplib.inventory import Inventory
-from shoplib.orders import DELIVERED, NEW, Order
+from shoplib.orders import CANCELLED, DELIVERED, NEW, Order
 
 
 def make():
@@ -25,3 +25,56 @@ def test_cannot_ship_unpaid():
     _, order = make()
     with pytest.raises(ValueError):
         order.ship()
+
+
+def test_cancel_new_order_releases_stock():
+    inv, order = make()
+    order.cancel()
+    assert order.state == CANCELLED
+    assert order.refund_due is False
+    assert inv.reserved("A") == 0
+    assert inv.available("A") == 5
+
+
+def test_cancel_paid_order_marks_refund_due():
+    inv, order = make()
+    order.pay()
+    order.cancel()
+    assert order.state == CANCELLED
+    assert order.refund_due is True
+    assert inv.reserved("A") == 0
+    assert inv.available("A") == 5
+
+
+def test_cancel_cancelled_order_is_idempotent():
+    inv, order = make()
+    order.cancel()
+    order.cancel()
+    assert order.state == CANCELLED
+    assert inv.reserved("A") == 0
+    assert inv.available("A") == 5
+
+
+@pytest.mark.parametrize("state", ["SHIPPED", DELIVERED])
+def test_cancel_shipped_or_delivered_order_fails_without_changes(state):
+    inv, order = make()
+    order.pay()
+    order.ship()
+    if state == DELIVERED:
+        order.deliver()
+    before = (order.state, order.refund_due, inv.on_hand("A"), inv.reserved("A"))
+    with pytest.raises(ValueError):
+        order.cancel()
+    assert (order.state, order.refund_due, inv.on_hand("A"), inv.reserved("A")) == before
+
+
+def test_cancel_does_not_partially_release_if_reservation_is_missing():
+    inv = Inventory()
+    inv.receive("A", 5)
+    inv.receive("B", 5)
+    order = Order("o2", {"A": 2, "B": 2}, inv)
+    inv.release("B", 1)
+    before = (order.state, order.refund_due, inv.reserved("A"), inv.reserved("B"))
+    with pytest.raises(ValueError):
+        order.cancel()
+    assert (order.state, order.refund_due, inv.reserved("A"), inv.reserved("B")) == before
