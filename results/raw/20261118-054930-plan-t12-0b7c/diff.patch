@@ -0,0 +1,68 @@
+import pytest
+
+from shoplib.errors import ShopError
+from shoplib.search import Product, search
+
+
+@pytest.fixture
+def products():
+    return [
+        Product("MUG-01", "Blue Mug", 750, ["kitchen", "sale"]),
+        Product("MUG-02", "Blue Travel Mug", 1200, ["travel"]),
+        Product("PLATE-01", "Blue Plate", 1000, ["kitchen"]),
+        Product("CUP-01", "Red Cup", 500, ["sale"]),
+    ]
+
+
+def test_bare_words_and_quoted_phrases_match_names_in_input_order(products):
+    assert search(products, "blue") == products[:3]
+    assert search(products, '"blue mug"') == products[:1]
+    assert search(products, 'name:"travel mug"') == products[1:2]
+    assert search(products, '"blue" mug') == products[:2]
+
+
+def test_empty_query_matches_all_products(products):
+    assert search(products, " \t\n ") == products
+
+
+def test_sku_and_tag_match_case_insensitively_with_optional_prefixes(products):
+    assert search(products, "sku:mug-01") == products[:1]
+    assert search(products, "tag:KITCHEN") == [products[0], products[2]]
+    assert search(products, "sku:MUG-*") == products[:2]
+    assert search(products, "tag:sa*") == [products[0], products[3]]
+    assert search(products, "sku:M*G-01") == []
+
+
+def test_star_is_ordinary_unless_it_ends_sku_or_tag_value(products):
+    assert search(products, "name:M*g") == []
+    assert search([Product("STAR*", "Star", 1)], "sku:STAR*")
+
+
+def test_negation_applies_to_a_term_and_can_negate_a_quoted_phrase(products):
+    assert search(products, "blue -tag:sale") == [products[1], products[2]]
+    assert search(products, '-"blue mug"') == products[1:]
+
+
+def test_price_comparisons_use_integer_cents_and_support_all_operators(products):
+    assert search(products, "price<1000") == [products[0], products[3]]
+    assert search(products, "price<=1000") == [products[0], products[2], products[3]]
+    assert search(products, "price>1000") == [products[1]]
+    assert search(products, "price>=1000") == [products[1], products[2]]
+    assert search(products, "price=500") == [products[3]]
+
+
+@pytest.mark.parametrize("query", ["other:value", "price:5", "tag:", 'name:""', "-"])
+def test_invalid_fields_empty_values_and_empty_negation_raise_value_error(query, products):
+    with pytest.raises(ValueError):
+        search(products, query)
+
+
+@pytest.mark.parametrize("query", ['"not closed', "name:unclosed\"", "price>", "price>=abc", "price=1.5"])
+def test_unclosed_quotes_and_invalid_price_values_raise_value_error(query, products):
+    with pytest.raises(ValueError):
+        search(products, query)
+
+
+def test_query_errors_use_shop_error(products):
+    with pytest.raises(ShopError):
+        search(products, "tag:")
