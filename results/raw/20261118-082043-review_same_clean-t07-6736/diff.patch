 def test_percent():
@@ -7,3 +12,54 @@ def test_percent():
 
 def test_fixed_never_negative():
     assert apply_coupon(300, Coupon("FIVE", "fixed", 500)) == 0
+
+
+def test_apply_coupons_selects_best_percent_and_stacks_fixed_discounts():
+    coupons = [
+        Coupon("TEN", "percent", 10),
+        Coupon("TWENTY-B", "percent", 20),
+        Coupon("TWENTY-A", "percent", 20),
+        Coupon("FIXED-B", "fixed", 250),
+        Coupon("FIXED-A", "fixed", 150),
+    ]
+
+    assert apply_coupons(1000, coupons, date(2025, 1, 1)) == (
+        400,
+        ["FIXED-A", "FIXED-B", "TWENTY-A"],
+    )
+
+
+def test_apply_coupons_checks_expiry_and_minimum_against_original_subtotal():
+    coupons = [
+        Coupon("TODAY", "fixed", 100, expires=date(2025, 1, 1), min_subtotal_cents=500),
+        Coupon("EXPIRED", "fixed", 100, expires=date(2024, 12, 31)),
+        Coupon("TOO-HIGH", "fixed", 100, min_subtotal_cents=1001),
+        Coupon("ORIGINAL", "fixed", 100, min_subtotal_cents=1000),
+    ]
+
+    assert apply_coupons(1000, coupons, date(2025, 1, 1)) == (
+        800,
+        ["ORIGINAL", "TODAY"],
+    )
+
+
+def test_apply_coupons_calculates_percent_from_original_subtotal():
+    coupons = [Coupon("TEN", "percent", 10), Coupon("FIVE", "fixed", 5)]
+
+    assert apply_coupons(105, coupons, date(2025, 1, 1)) == (89, ["FIVE", "TEN"])
+
+
+def test_apply_coupons_clamps_total_and_sorts_codes():
+    coupons = [Coupon("Z", "fixed", 1000), Coupon("A", "fixed", 1000)]
+
+    assert apply_coupons(100, coupons, date(2025, 1, 1)) == (0, ["A", "Z"])
+
+
+def test_apply_coupons_rejects_negative_subtotal():
+    with pytest.raises(ValueError):
+        apply_coupons(-1, [], date(2025, 1, 1))
+
+
+def test_apply_coupons_rejects_unknown_coupon_kind():
+    with pytest.raises(ShopError, match="coupon kind"):
+        apply_coupons(1000, [Coupon("BAD", "bogus", 10)], date(2025, 1, 1))
