diff --git a/src/shoplib/storedays.py b/src/shoplib/storedays.py
index c46116f..2890dbf 100644
--- a/src/shoplib/storedays.py
+++ b/src/shoplib/storedays.py
@@ -1,6 +1,40 @@
 """Revenue per store day. See docs/store-days.md."""
 
+from datetime import date, datetime, timedelta, timezone
+
 
 def daily_revenue(sales: list[dict], utc_offset_hours: int = 8, day_starts_hour: int = 4) -> list[tuple[str, int]]:
-    """Revenue per store day. See docs/store-days.md."""
-    raise NotImplementedError
+    """Return total cents for each store day between the first and last sale.
+
+    A store day starts at ``day_starts_hour`` in the shop's fixed local time
+    zone, which is ``utc_offset_hours`` from UTC.
+    """
+    totals: dict[date, int] = {}
+
+    for sale in sales:
+        timestamp = sale["at"]
+        # ``fromisoformat`` accepts the ISO ``Z`` suffix on supported Python
+        # versions, and also parses the signed ``HH:MM`` offsets in the spec.
+        instant = datetime.fromisoformat(timestamp)
+        if instant.utcoffset() is None:
+            raise ValueError("sale timestamp must include a time zone")
+
+        local_time = instant.astimezone(timezone.utc).replace(tzinfo=None)
+        local_time += timedelta(hours=utc_offset_hours)
+        store_day = local_time.date()
+        if local_time.hour < day_starts_hour:
+            store_day -= timedelta(days=1)
+
+        totals[store_day] = totals.get(store_day, 0) + sale["cents"]
+
+    if not totals:
+        return []
+
+    first_day = min(totals)
+    last_day = max(totals)
+    result = []
+    store_day = first_day
+    while store_day <= last_day:
+        result.append((store_day.isoformat(), totals.get(store_day, 0)))
+        store_day += timedelta(days=1)
+    return result
diff --git a/tests/test_storedays.py b/tests/test_storedays.py
new file mode 100644
index 0000000..894de43
--- /dev/null
+++ b/tests/test_storedays.py
@@ -0,0 +1,49 @@
+import pytest
+
+from shoplib.storedays import daily_revenue
+
+
+def test_default_cutoff_and_inclusive_start_hour():
+    sales = [
+        {"at": "2026-11-18T02:30:00+08:00", "cents": 100},
+        {"at": "2026-11-18T03:59:59+08:00", "cents": 200},
+        {"at": "2026-11-18T04:00:00+08:00", "cents": 300},
+    ]
+
+    assert daily_revenue(sales) == [
+        ("2026-11-17", 300),
+        ("2026-11-18", 300),
+    ]
+
+
+def test_converts_timestamps_to_shop_fixed_offset():
+    sales = [
+        {"at": "2026-11-17T20:00:00Z", "cents": 500},
+        {"at": "2026-11-18T00:00:00-04:00", "cents": 250},
+    ]
+
+    assert daily_revenue(sales, utc_offset_hours=8, day_starts_hour=4) == [
+        ("2026-11-18", 750),
+    ]
+
+
+def test_includes_zero_total_days_and_counts_refunds():
+    sales = [
+        {"at": "2026-11-18T12:00:00Z", "cents": 1000},
+        {"at": "2026-11-20T12:00:00Z", "cents": -250},
+    ]
+
+    assert daily_revenue(sales, utc_offset_hours=0, day_starts_hour=0) == [
+        ("2026-11-18", 1000),
+        ("2026-11-19", 0),
+        ("2026-11-20", -250),
+    ]
+
+
+def test_empty_sales():
+    assert daily_revenue([]) == []
+
+
+def test_timestamp_without_zone_raises_value_error():
+    with pytest.raises(ValueError):
+        daily_revenue([{"at": "2026-11-18T12:00:00", "cents": 100}])
