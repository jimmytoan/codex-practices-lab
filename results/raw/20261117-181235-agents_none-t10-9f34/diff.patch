 def split_parcels(items: list[tuple[str, int, int]], max_weight_g: int) -> list[list[str]]:
     """Split order items into parcels. See docs/shipping.md."""
-    raise NotImplementedError
+    return [
+        [sku for sku, _weight in parcel]
+        for parcel in _pack_units(items, max_weight_g)
+    ]
+
+
+def _pack_units(
+    items: list[tuple[str, int, int]], max_weight_g: int
+) -> list[list[tuple[str, int]]]:
+    """Return packed (SKU, weight) units, preserving the documented order."""
+    units: list[tuple[str, int]] = []
+    for sku, weight_g, qty in items:
+        if qty < 1:
+            raise ValueError("quantity must be at least 1")
+        if weight_g < 1:
+            raise ValueError("weight must be at least 1")
+        if weight_g > max_weight_g:
+            raise ValueError("unit is heavier than the parcel limit")
+        units.extend([(sku, weight_g)] * qty)
+
+    units.sort(key=lambda unit: (-unit[1], unit[0]))
+
+    parcels: list[list[tuple[str, int]]] = []
+    parcel_weights: list[int] = []
+    for unit in units:
+        sku, weight_g = unit
+        for index, total_weight in enumerate(parcel_weights):
+            if total_weight + weight_g <= max_weight_g:
+                parcels[index].append(unit)
+                parcel_weights[index] += weight_g
+                break
+        else:
+            parcels.append([(sku, weight_g)])
+            parcel_weights.append(weight_g)
+
+    return parcels
 
 
 def shipment_cost(items: list[tuple[str, int, int]], max_weight_g: int) -> int:
     """Total shipping cost of an order. See docs/shipping.md."""
-    raise NotImplementedError
+    parcels = split_parcels(items, max_weight_g)
+
+    # split_parcels exposes only SKUs. Replay the same deterministic packing
+    # with weights retained so duplicate SKUs with different weights are
+    # accounted for correctly.
+    weighted_parcels = _pack_units(items, max_weight_g)
+    return sum(
+        shipping_cost(sum(weight_g for _sku, weight_g in weighted_parcel))
+        for _parcel, weighted_parcel in zip(parcels, weighted_parcels)
+    )
