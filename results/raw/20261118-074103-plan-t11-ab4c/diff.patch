diff --git a/src/shoplib/invoice.py b/src/shoplib/invoice.py
index 5d1398c..7b19f86 100644
--- a/src/shoplib/invoice.py
+++ b/src/shoplib/invoice.py
@@ -1,5 +1,8 @@
 """Invoices: coupon allocation and tax. See docs/invoicing.md."""
 
+from shoplib.errors import ShopError
+from shoplib.money import percent_of
+
 # Tax rates in percent, by region and product category.
 TAX_RATES = {
     "DE": {"standard": 19, "food": 7, "books": 7},
@@ -10,4 +13,75 @@ TAX_RATES = {
 
 def build_invoice(lines, coupon_cents: int, shipping_cents: int, region: str) -> dict:
     """Build an invoice for an order. See docs/invoicing.md."""
-    raise NotImplementedError
+    try:
+        rates = TAX_RATES[region]
+    except (KeyError, TypeError):
+        raise ShopError("unknown region") from None
+
+    def is_amount(value):
+        return isinstance(value, int) and not isinstance(value, bool)
+
+    if not is_amount(coupon_cents) or coupon_cents < 0:
+        raise ShopError("coupon must be a non-negative integer")
+    if not is_amount(shipping_cents) or shipping_cents < 0:
+        raise ShopError("shipping must be a non-negative integer")
+    if not isinstance(lines, (list, tuple)) or not lines:
+        raise ShopError("lines must not be empty")
+
+    prepared = []
+    for line in lines:
+        if not isinstance(line, (list, tuple)) or len(line) != 4:
+            raise ShopError("each line must contain sku, price, quantity and category")
+        sku, unit_price_cents, qty, category = line
+        if not is_amount(unit_price_cents) or unit_price_cents < 0:
+            raise ShopError("price must be a non-negative integer")
+        if not is_amount(qty) or qty < 1:
+            raise ShopError("quantity must be a positive integer")
+        try:
+            rate = rates[category]
+        except (KeyError, TypeError):
+            raise ShopError("unknown category") from None
+        prepared.append((sku, unit_price_cents * qty, rate))
+
+    total_gross = sum(gross for _, gross, _ in prepared)
+    capped_coupon = min(coupon_cents, total_gross)
+
+    if total_gross:
+        discounts = [capped_coupon * gross // total_gross for _, gross, _ in prepared]
+        remainders = [capped_coupon * gross % total_gross for _, gross, _ in prepared]
+        cents_left = capped_coupon - sum(discounts)
+        priority = sorted(range(len(prepared)), key=lambda i: (-remainders[i], i))
+        for index in priority[:cents_left]:
+            discounts[index] += 1
+    else:
+        discounts = [0] * len(prepared)
+
+    invoice_lines = []
+    for (sku, gross, rate), discount in zip(prepared, discounts):
+        net = gross - discount
+        invoice_lines.append(
+            {
+                "sku": sku,
+                "gross_cents": gross,
+                "discount_cents": discount,
+                "net_cents": net,
+                "tax_cents": percent_of(net, rate),
+            }
+        )
+
+    shipping_tax = (
+        percent_of(shipping_cents, rates["standard"])
+        if any(rate > 0 for _, _, rate in prepared)
+        else 0
+    )
+    total = (
+        sum(line["net_cents"] + line["tax_cents"] for line in invoice_lines)
+        + shipping_cents
+        + shipping_tax
+    )
+    return {
+        "lines": invoice_lines,
+        "shipping_cents": shipping_cents,
+        "shipping_tax_cents": shipping_tax,
+        "total_cents": total,
+    }
diff --git a/tests/test_invoice.py b/tests/test_invoice.py
new file mode 100644
index 0000000..d7b5b6e
--- /dev/null
+++ b/tests/test_invoice.py
@@ -0,0 +1,84 @@
+import pytest
+
+from shoplib.invoice import build_invoice
+
+
+def test_coupon_is_split_by_largest_remainder_with_input_order_ties():
+    invoice = build_invoice(
+        [("a", 5, 1, "books"), ("b", 3, 1, "books"), ("c", 2, 1, "books")],
+        coupon_cents=3,
+        shipping_cents=0,
+        region="SG",
+    )
+
+    assert [line["gross_cents"] for line in invoice["lines"]] == [5, 3, 2]
+    assert [line["discount_cents"] for line in invoice["lines"]] == [1, 1, 1]
+    assert sum(line["discount_cents"] for line in invoice["lines"]) == 3
+
+    tied = build_invoice(
+        [("a", 1, 1, "books"), ("b", 1, 1, "books"), ("c", 1, 1, "books")],
+        coupon_cents=2,
+        shipping_cents=0,
+        region="SG",
+    )
+    assert [line["discount_cents"] for line in tied["lines"]] == [1, 1, 0]
+
+
+def test_coupon_is_capped_and_zero_gross_lines_get_no_discount():
+    invoice = build_invoice(
+        [("zero", 0, 2, "food"), ("item", 4, 1, "food")],
+        coupon_cents=100,
+        shipping_cents=0,
+        region="OR",
+    )
+
+    assert [line["discount_cents"] for line in invoice["lines"]] == [0, 4]
+    assert [line["net_cents"] for line in invoice["lines"]] == [0, 0]
+    assert invoice["total_cents"] == 0
+
+    all_zero = build_invoice(
+        [("a", 0, 1, "food"), ("b", 0, 3, "books")],
+        coupon_cents=50,
+        shipping_cents=0,
+        region="DE",
+    )
+    assert [line["discount_cents"] for line in all_zero["lines"]] == [0, 0]
+
+
+def test_line_tax_rounds_per_line_and_shipping_tax_depends_on_taxable_category():
+    invoice = build_invoice(
+        [("a", 1, 1, "food"), ("b", 8, 1, "food"), ("book", 100, 1, "books")],
+        coupon_cents=0,
+        shipping_cents=100,
+        region="SG",
+    )
+
+    assert [line["tax_cents"] for line in invoice["lines"]] == [0, 1, 0]
+    assert invoice["shipping_tax_cents"] == 9
+    assert invoice["total_cents"] == 219
+
+    books_only = build_invoice(
+        [("book", 100, 1, "books")],
+        coupon_cents=0,
+        shipping_cents=100,
+        region="SG",
+    )
+    assert books_only["shipping_tax_cents"] == 0
+    assert books_only["total_cents"] == 200
+
+
+@pytest.mark.parametrize(
+    ("lines", "coupon", "shipping", "region"),
+    [
+        ([("a", 1, 1, "food")], 0, 0, "XX"),
+        ([("a", 1, 1, "unknown")], 0, 0, "SG"),
+        ([], 0, 0, "SG"),
+        ([("a", 1, 0, "food")], 0, 0, "SG"),
+        ([("a", -1, 1, "food")], 0, 0, "SG"),
+        ([("a", 1, 1, "food")], -1, 0, "SG"),
+        ([("a", 1, 1, "food")], 0, -1, "SG"),
+    ],
+)
+def test_invalid_invoice_arguments_raise_value_error(lines, coupon, shipping, region):
+    with pytest.raises(ValueError):
+        build_invoice(lines, coupon, shipping, region)
