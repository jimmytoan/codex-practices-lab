 def test_fixed_never_negative():
     assert apply_coupon(300, Coupon("FIVE", "fixed", 500)) == 0
+
+
+def test_apply_coupons_eligibility_selection_and_rounding():
+    today = date(2026, 11, 17)
+    coupons = [
+        Coupon("Z", "percent", 50),
+        Coupon("A", "percent", 50, expires=today),
+        Coupon("LOW", "percent", 10),
+        Coupon("EXPIRED", "percent", 90, expires=date(2026, 11, 16)),
+        Coupon("TOO_HIGH", "fixed", 100, min_subtotal_cents=334),
+        Coupon("FIXED", "fixed", 50, min_subtotal_cents=333),
+    ]
+    assert apply_coupons(333, coupons, today) == (116, ["A", "FIXED"])
+
+
+def test_apply_coupons_fixed_discounts_clamp_and_keep_all_codes():
+    coupons = [Coupon("Z", "fixed", 200), Coupon("A", "fixed", 200)]
+    assert apply_coupons(100, coupons, date(2026, 1, 1)) == (0, ["A", "Z"])
+
+
+def test_apply_coupons_without_eligible_coupons():
+    today = date(2026, 1, 1)
+    assert apply_coupons(100, [], today) == (100, [])
+    assert apply_coupons(100, [Coupon("X", "fixed", 50, min_subtotal_cents=101)], today) == (100, [])
+
+
+def test_apply_coupons_rejects_invalid_arguments():
+    today = date(2026, 1, 1)
+    with pytest.raises(ShopError):
+        apply_coupons(-1, [], today)
+    with pytest.raises(ShopError):
+        apply_coupons(100, [Coupon("BAD", "other", 10)], today)
