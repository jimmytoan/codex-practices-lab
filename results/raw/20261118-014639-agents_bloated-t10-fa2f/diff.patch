 """Shipping costs and parcel splitting. See docs/shipping.md."""
 
+from typing import TypeVar
+
+from shoplib.errors import ShopError
+
+Sku = TypeVar("Sku", bound=str)
+
 # (upper bound in grams, cost in cents)
 TIERS = [(1000, 500), (2000, 800), (5000, 1200), (20000, 2500)]
 
@@ -14,11 +20,50 @@ def shipping_cost(weight_g: int) -> int:
     raise ValueError("parcel is too heavy")
 
 
-def split_parcels(items: list[tuple[str, int, int]], max_weight_g: int) -> list[list[str]]:
+def split_parcels(items: list[tuple[Sku, int, int]], max_weight_g: int) -> list[list[Sku]]:
     """Split order items into parcels. See docs/shipping.md."""
-    raise NotImplementedError
+    units = []
+    for sku, weight_g, qty in items:
+        if weight_g < 1 or weight_g > max_weight_g:
+            raise ShopError("unit weight is invalid")
+        if qty < 1:
+            raise ShopError("quantity must be positive")
+        units.extend([(weight_g, sku)] * qty)
+
+    units.sort(key=lambda unit: (-unit[0], unit[1]))
+    parcels: list[list[Sku]] = []
+    weights: list[int] = []
+    for weight_g, sku in units:
+        for index, parcel_weight in enumerate(weights):
+            if parcel_weight + weight_g <= max_weight_g:
+                parcels[index].append(sku)
+                weights[index] += weight_g
+                break
+        else:
+            parcels.append([sku])
+            weights.append(weight_g)
+    return parcels
+
+
+class _WeightedSku(str):
+    """Keep each item's weight with its SKU through parcel splitting."""
+
+    weight_g: int
+
+    def __new__(cls, sku: str, weight_g: int) -> "_WeightedSku":
+        result = super().__new__(cls, sku)
+        result.weight_g = weight_g
+        return result
 
 
 def shipment_cost(items: list[tuple[str, int, int]], max_weight_g: int) -> int:
     """Total shipping cost of an order. See docs/shipping.md."""
-    raise NotImplementedError
+    weighted_items = [
+        (_WeightedSku(sku, weight_g), weight_g, qty)
+        for sku, weight_g, qty in items
+    ]
+    parcels = split_parcels(weighted_items, max_weight_g)
+    try:
+        return sum(shipping_cost(sum(sku.weight_g for sku in parcel)) for parcel in parcels)
+    except ValueError as exc:
+        raise ShopError(str(exc)) from exc
