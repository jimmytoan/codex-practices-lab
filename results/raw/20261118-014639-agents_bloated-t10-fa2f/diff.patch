+def test_split_parcels_uses_first_fit_decreasing_and_sku_ties():
+    items = [("z", 4, 1), ("b", 6, 1), ("a", 6, 1), ("y", 4, 1)]
+    assert split_parcels(items, 10) == [["a", "y"], ["b", "z"]]
+
+
+def test_split_parcels_expands_quantities_and_preserves_packing_order():
+    items = [("light", 2, 2), ("heavy", 6, 1), ("medium", 5, 1), ("fill", 3, 1)]
+    assert split_parcels(items, 10) == [
+        ["heavy", "fill"],
+        ["medium", "light", "light"],
+    ]
+
+
+@pytest.mark.parametrize(
+    "items, limit",
+    [
+        ([("sku", 0, 1)], 10),
+        ([("sku", -1, 1)], 10),
+        ([("sku", 11, 1)], 10),
+        ([("sku", 1, 0)], 10),
+        ([("sku", 1, -1)], 10),
+        ([("sku", 1, 1)], 0),
+    ],
+)
+def test_split_parcels_rejects_invalid_items(items, limit):
+    with pytest.raises(ShopError):
+        split_parcels(items, limit)
+    with pytest.raises(ShopError):
+        shipment_cost(items, limit)
+
+
+def test_empty_shipment():
+    assert split_parcels([], 0) == []
+    assert shipment_cost([], 0) == 0
