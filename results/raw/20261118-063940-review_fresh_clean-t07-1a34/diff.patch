 def test_percent():
@@ -7,3 +12,40 @@ def test_percent():
 
 def test_fixed_never_negative():
     assert apply_coupon(300, Coupon("FIVE", "fixed", 500)) == 0
+
+
+def test_apply_coupons_selects_one_percent_and_applies_all_eligible_fixed():
+    today = date(2026, 11, 18)
+    coupons = [
+        Coupon("PERCENT-B", "percent", 20),
+        Coupon("PERCENT-A", "percent", 20),
+        Coupon("PERCENT-BEST", "percent", 15),
+        Coupon("FIXED-B", "fixed", 400),
+        Coupon("FIXED-A", "fixed", 100),
+        Coupon("MINIMUM", "fixed", 1000, min_subtotal_cents=1001),
+        Coupon("EXPIRED", "fixed", 1000, expires=date(2026, 11, 17)),
+    ]
+
+    assert apply_coupons(1000, coupons, today) == (300, ["FIXED-A", "FIXED-B", "PERCENT-A"])
+
+
+def test_apply_coupons_uses_percent_of_original_subtotal_and_rounds_half_up():
+    today = date(2026, 11, 18)
+    coupons = [
+        Coupon("FIVE", "percent", 5),
+        Coupon("FIXED", "fixed", 1),
+    ]
+
+    assert apply_coupons(11, coupons, today) == (9, ["FIVE", "FIXED"])
+
+
+def test_apply_coupons_clamps_total_at_zero():
+    today = date(2026, 11, 18)
+    coupons = [Coupon("A", "fixed", 100), Coupon("B", "fixed", 200)]
+
+    assert apply_coupons(150, coupons, today) == (0, ["A", "B"])
+
+
+def test_apply_coupons_rejects_unknown_coupon_kind():
+    with pytest.raises(ShopError, match="unknown coupon kind"):
+        apply_coupons(1000, [Coupon("UNKNOWN", "other", 10)], date(2026, 11, 18))
