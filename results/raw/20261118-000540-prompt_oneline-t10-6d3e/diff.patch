+def _pack_parcels(
+    items: list[tuple[str, int, int]], max_weight_g: int
+) -> list[tuple[list[str], int]]:
+    units = []
+    for sku, weight, qty in items:
+        if weight < 1 or qty < 1:
+            raise ShopError("weight and quantity must be positive")
+        if weight > max_weight_g:
+            raise ShopError("unit is too heavy")
+        units.extend((sku, weight) for _ in range(qty))
+
+    units.sort(key=lambda unit: (-unit[1], unit[0]))
+    parcels: list[tuple[list[str], int]] = []
+    for sku, weight in units:
+        for index, (skus, total_weight) in enumerate(parcels):
+            if total_weight + weight <= max_weight_g:
+                skus.append(sku)
+                parcels[index] = (skus, total_weight + weight)
+                break
+        else:
+            parcels.append(([sku], weight))
+    return parcels
 
 
