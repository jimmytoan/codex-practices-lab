 @dataclass
@@ -13,4 +18,85 @@ class Product:
 
 def search(products: list[Product], query: str) -> list[Product]:
     """The products that match `query`, in their input order. See docs/search.md."""
-    raise NotImplementedError
+    predicates = [_parse_term(token) for token in _tokens(query)]
+    return [product for product in products if all(test(product) for test in predicates)]
+
+
+def _tokens(query: str) -> list[str]:
+    tokens = []
+    value = []
+    quoted = False
+    started = False
+    for char in query:
+        if char == '"':
+            quoted = not quoted
+            started = True
+        elif char.isspace() and not quoted:
+            if started:
+                tokens.append(''.join(value))
+                value = []
+                started = False
+        else:
+            value.append(char)
+            started = True
+    if quoted:
+        raise ShopError("unclosed quote")
+    if started:
+        tokens.append(''.join(value))
+    return tokens
+
+
+def _parse_term(term: str) -> Callable[[Product], bool]:
+    negated = term.startswith('-')
+    if negated:
+        term = term[1:]
+        if not term:
+            raise ShopError("empty negated term")
+
+    if ':' in term:
+        name, value = term.split(':', 1)
+        if name not in ('sku', 'name', 'tag'):
+            raise ShopError("unknown search field")
+        if not value:
+            raise ShopError("empty search field")
+        value = value.casefold()
+        if name == 'name':
+            predicate = lambda product: value in product.name.casefold()
+        else:
+            prefix = value.endswith('*')
+            if prefix:
+                value = value[:-1]
+            if name == 'sku':
+                predicate = lambda product: _matches(product.sku, value, prefix)
+            else:
+                predicate = lambda product: any(
+                    _matches(tag, value, prefix) for tag in product.tags
+                )
+    else:
+        comparison = re.match(r'^price(<=|>=|<|>|=)', term)
+        if comparison:
+            value = term[comparison.end():]
+            if not value or not value.isdecimal():
+                raise ShopError("invalid price")
+            # Parse in small chunks so valid values are not limited by Python's
+            # maximum number of digits in a string-to-int conversion.
+            cents = 0
+            for start in range(0, len(value), 9):
+                chunk = value[start:start + 9]
+                cents = cents * 10 ** len(chunk) + int(chunk)
+            compare = {'<': lt, '<=': le, '>': gt, '>=': ge, '=': eq}[
+                comparison.group(1)
+            ]
+            predicate = lambda product: compare(product.price_cents, cents)
+        else:
+            value = term.casefold()
+            predicate = lambda product: value in product.name.casefold()
+
+    if negated:
+        return lambda product: not predicate(product)
+    return predicate
+
+
+def _matches(text: str, value: str, prefix: bool) -> bool:
+    text = text.casefold()
+    return text.startswith(value) if prefix else text == value
