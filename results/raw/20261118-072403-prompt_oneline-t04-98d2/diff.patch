 def make():
@@ -25,3 +25,53 @@ def test_cannot_ship_unpaid():
     _, order = make()
     with pytest.raises(ValueError):
         order.ship()
+
+
+def test_cancel_new_order_releases_stock():
+    inv, order = make()
+
+    order.cancel()
+
+    assert order.state == CANCELLED
+    assert order.refund_due is False
+    assert inv.available("A") == 5
+    assert inv.reserved("A") == 0
+
+
+def test_cancel_paid_order_sets_refund_due():
+    inv, order = make()
+    order.pay()
+
+    order.cancel()
+
+    assert order.state == CANCELLED
+    assert order.refund_due is True
+    assert inv.available("A") == 5
+    assert inv.reserved("A") == 0
+
+
+def test_cancel_already_cancelled_is_idempotent():
+    inv, order = make()
+    order.cancel()
+
+    order.cancel()
+
+    assert order.state == CANCELLED
+    assert inv.available("A") == 5
+    assert inv.reserved("A") == 0
+
+
+@pytest.mark.parametrize("state", [SHIPPED, DELIVERED])
+def test_cancel_shipped_or_delivered_order_fails_without_changes(state):
+    inv, order = make()
+    order.pay()
+    order.ship()
+    if state == DELIVERED:
+        order.deliver()
+    before = (inv.on_hand("A"), inv.reserved("A"), inv.available("A"))
+
+    with pytest.raises(ValueError):
+        order.cancel()
+
+    assert order.state == state
+    assert (inv.on_hand("A"), inv.reserved("A"), inv.available("A")) == before
