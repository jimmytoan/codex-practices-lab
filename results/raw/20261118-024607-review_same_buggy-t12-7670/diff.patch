@@ -0,0 +1,92 @@
+import pytest
+
+from shoplib.errors import ShopError
+from shoplib.search import Product, search
+
+
+@pytest.fixture
+def products():
+    return [
+        Product("MUG-1", "Blue Mug Large", 1000, ["Sale", "Kitchenware"]),
+        Product("mug-2", "Red Mug", 1500, ["NEW"]),
+        Product("BOWL-1", "Blue Bowl", 500, ["kitchen"]),
+        Product("A*B", "Mug: Blue", 1000, ["A*B"]),
+    ]
+
+
+@pytest.mark.parametrize(
+    ("query", "indices"),
+    [
+        ("", [0, 1, 2, 3]),
+        (" \t\n", [0, 1, 2, 3]),
+        ("bLuE", [0, 2, 3]),
+        ('"blue mug"', [0]),
+        ('"mug: blue"', [3]),
+        ("mug blue", [0, 3]),
+        ("name:mug", [0, 1, 3]),
+        ('name:"blue mug"', [0]),
+        ("sku:mug-1", [0]),
+        ("sku:MUG-*", [0, 1]),
+        ("sku:a*b", [3]),
+        ("tag:sale", [0]),
+        ("tag:KITCHEN*", [0, 2]),
+        ("tag:a*b", [3]),
+        ("price<1000", [2]),
+        ("price<=1000", [0, 2, 3]),
+        ("price>1000", [1]),
+        ("price>=1000", [0, 1, 3]),
+        ("price=1000", [0, 3]),
+        ('price>="1000"', [0, 1, 3]),
+        ("-tag:sale", [1, 2, 3]),
+        ('-"blue mug"', [1, 2, 3]),
+        ("mug -tag:NEW price<=1000", [0, 3]),
+    ],
+)
+def test_search_query_rules(products, query, indices):
+    assert search(products, query) == [products[i] for i in indices]
+
+
+def test_quoted_query_syntax_is_a_bare_phrase():
+    product = Product("x", 'price>100 tag:sale -clearance', 0)
+    assert search([product], '"price>100" "tag:sale" "-clearance"') == [product]
+
+
+@pytest.mark.parametrize(
+    "query",
+    ["strasse", "name:STRASSE", "sku:STRASSE", "tag:STRASSE", "tag:STRASS*"],
+)
+def test_search_case_insensitive_unicode(query):
+    product = Product("Straße", "Straße", 0, ["Straße"])
+    assert search([product], query) == [product]
+
+
+@pytest.mark.parametrize(
+    "query",
+    [
+        '"unclosed',
+        'name:"unclosed',
+        "unknown:value",
+        "price:5",
+        ":value",
+        "sku:",
+        'tag:""',
+        "-",
+        '-""',
+        "price>",
+        'price>""',
+        'price>"abc"',
+        "price=1.5",
+        "price=-1",
+        "price==1",
+        "price>=1x",
+    ],
+)
+def test_invalid_queries_raise_shop_error_even_without_products(query):
+    with pytest.raises(ShopError):
+        search([], query)
+
+
+def test_price_comparison_accepts_very_long_whole_numbers():
+    product = Product("x", "x", 1)
+    assert search([product], "price<" + "9" * 5000) == [product]
+    assert search([product], "price=" + "0" * 5000 + "1") == [product]
