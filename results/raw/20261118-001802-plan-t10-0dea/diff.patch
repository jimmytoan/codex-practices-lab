+def test_split_parcels_equal_weights_and_quantities():
+    items = [("z", 2, 2), ("a", 2, 2), ("b", 3, 1)]
+    assert split_parcels(items, 5) == [["b", "a"], ["a", "z"], ["z"]]
+
