+def test_split_parcels_first_fit_decreasing():
+    items = [("d", 1, 1), ("b", 6, 1), ("c", 3, 1), ("a", 8, 1)]
+    assert split_parcels(items, 10) == [["a", "d"], ["b", "c"]]
