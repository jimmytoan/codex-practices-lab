@@ -0,0 +1,60 @@
+import pytest
+
+from shoplib.errors import ShopError
+from shoplib.storedays import daily_revenue
+
+
+def test_boundary_time_zones_refunds_and_gap_days():
+    sales = [
+        {"at": "2026-11-20T04:00:00+08:00", "cents": 500},
+        {"at": "2026-11-17T20:00:00Z", "cents": 100},
+        {"at": "2026-11-18T03:59:59.999999+08:00", "cents": 300},
+        {"at": "2026-11-17T12:00:00-08:00", "cents": -40},
+    ]
+    assert daily_revenue(sales) == [
+        ("2026-11-17", 300),
+        ("2026-11-18", 60),
+        ("2026-11-19", 0),
+        ("2026-11-20", 500),
+    ]
+
+
+def test_custom_timezone_and_start_hour():
+    sales = [
+        {"at": "2026-11-18T10:59:59Z", "cents": 5},
+        {"at": "2026-11-18T11:00:00Z", "cents": 7},
+    ]
+    assert daily_revenue(sales, utc_offset_hours=-5, day_starts_hour=6) == [
+        ("2026-11-17", 5), ("2026-11-18", 7),
+    ]
+
+
+def test_empty_sales_and_last_supported_date():
+    assert daily_revenue([]) == []
+    assert daily_revenue([{"at": "9999-12-31T05:00:00+08:00", "cents": 1}]) == [
+        ("9999-12-31", 1),
+    ]
+
+
+@pytest.mark.parametrize("timestamp", ["2026-11-18T04:00:00", "not a timestamp"])
+def test_invalid_timestamp_raises_shop_error(timestamp):
+    with pytest.raises(ShopError):
+        daily_revenue([{"at": timestamp, "cents": 100}])
+
+
+@pytest.mark.parametrize("kwargs", [
+    {"utc_offset_hours": 24},
+    {"utc_offset_hours": -24},
+    {"utc_offset_hours": 1.5},
+    {"day_starts_hour": -1},
+    {"day_starts_hour": 24},
+])
+def test_invalid_configuration_raises_shop_error(kwargs):
+    with pytest.raises(ShopError):
+        daily_revenue([], **kwargs)
+
+
+@pytest.mark.parametrize("sales", [None, [{}], [{"at": "2026-11-18T04:00:00Z", "cents": 1.5}]])
+def test_invalid_sales_raise_shop_error(sales):
+    with pytest.raises(ShopError):
+        daily_revenue(sales)
