 def test_percent():
@@ -7,3 +12,59 @@ def test_percent():
 
 def test_fixed_never_negative():
     assert apply_coupon(300, Coupon("FIVE", "fixed", 500)) == 0
+
+
+def test_combines_best_percent_and_all_fixed_coupons():
+    coupons = [
+        Coupon("Z_FIXED", "fixed", 100, min_subtotal_cents=1000),
+        Coupon("LOW", "percent", 5),
+        Coupon("Z_PERCENT", "percent", 10),
+        Coupon("A_PERCENT", "percent", 10),
+        Coupon("A_FIXED", "fixed", 50),
+    ]
+    assert apply_coupons(1000, coupons, date(2026, 1, 1)) == (
+        750, ["A_FIXED", "A_PERCENT", "Z_FIXED"]
+    )
+
+
+def test_expiry_and_minimum_use_inclusive_boundaries_and_original_subtotal():
+    today = date(2026, 1, 2)
+    coupons = [
+        Coupon("VALID_TODAY", "percent", 20, expires=today),
+        Coupon("MINIMUM", "fixed", 50, min_subtotal_cents=1000),
+        Coupon("EXPIRED", "fixed", 999, expires=date(2026, 1, 1)),
+        Coupon("TOO_HIGH", "fixed", 999, min_subtotal_cents=1001),
+        Coupon("FUTURE", "fixed", 10, expires=date(2026, 1, 3)),
+    ]
+    assert apply_coupons(1000, coupons, today) == (
+        740, ["FUTURE", "MINIMUM", "VALID_TODAY"]
+    )
+
+
+def test_percent_rounds_half_up_before_fixed_discounts():
+    coupons = [Coupon("HALF", "percent", 50), Coupon("ONE", "fixed", 1)]
+    assert apply_coupons(5, coupons, date(2026, 1, 1)) == (1, ["HALF", "ONE"])
+
+
+@pytest.mark.parametrize("subtotal,coupons,expected", [
+    (100, [], (100, [])),
+    (0, [Coupon("FREE", "fixed", 0)], (0, ["FREE"])),
+    (100, [Coupon("BIG", "fixed", 200), Coupon("MORE", "fixed", 1)],
+     (0, ["BIG", "MORE"])),
+    (100, [Coupon("ALL", "percent", 150), Coupon("FIXED", "fixed", 1)],
+     (0, ["ALL", "FIXED"])),
+    (100, [Coupon("SAME", "fixed", 10), Coupon("SAME", "fixed", 10)],
+     (80, ["SAME", "SAME"])),
+])
+def test_empty_and_zero_total_cases(subtotal, coupons, expected):
+    assert apply_coupons(subtotal, coupons, date(2026, 1, 1)) == expected
+
+
+def test_negative_subtotal_raises_shop_error():
+    with pytest.raises(ShopError, match="subtotal must not be negative"):
+        apply_coupons(-1, [], date(2026, 1, 1))
+
+
+def test_eligible_unknown_coupon_kind_raises_shop_error():
+    with pytest.raises(ShopError, match="unknown coupon kind"):
+        apply_coupons(100, [Coupon("BAD", "other", 10)], date(2026, 1, 1))
