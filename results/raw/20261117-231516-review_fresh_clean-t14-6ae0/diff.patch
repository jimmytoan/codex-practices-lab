+++ b/tests/test_storedays.py
@@ -0,0 +1,65 @@
+import pytest
+
+from shoplib.errors import ShopError
+from shoplib.storedays import daily_revenue
+
+
+def test_empty_sales():
+    assert daily_revenue([]) == []
+
+
+def test_default_boundary_time_zones_refunds_and_gaps():
+    sales = [
+        {"at": "2026-11-20T04:00:00+08:00", "cents": 200},
+        {"at": "2026-11-17T19:30:00Z", "cents": 100},  # 03:30 local
+        {"at": "2026-11-17T20:00:00Z", "cents": 50},  # 04:00 local
+        {"at": "2026-11-17T15:00:00-05:00", "cents": -20},
+    ]
+    assert daily_revenue(sales) == [
+        ("2026-11-17", 100),
+        ("2026-11-18", 30),
+        ("2026-11-19", 0),
+        ("2026-11-20", 200),
+    ]
+
+
+def test_custom_offset_and_start_across_year_boundary():
+    sales = [
+        {"at": "2027-01-01T06:59:59Z", "cents": 10},
+        {"at": "2027-01-01T07:00:00Z", "cents": 20},
+    ]
+    assert daily_revenue(sales, utc_offset_hours=-5, day_starts_hour=2) == [
+        ("2026-12-31", 10),
+        ("2027-01-01", 20),
+    ]
+
+
+def test_last_representable_date():
+    assert daily_revenue(
+        [{"at": "9999-12-31T04:00:00Z", "cents": 42}],
+        utc_offset_hours=0,
+    ) == [("9999-12-31", 42)]
+
+
+@pytest.mark.parametrize("timestamp", ["2026-11-18T02:30:00", "not a timestamp"])
+def test_invalid_timestamp_raises_shop_error(timestamp):
+    with pytest.raises(ShopError):
+        daily_revenue([{"at": timestamp, "cents": 100}])
+
+
+@pytest.mark.parametrize(
+    "sales, options",
+    [
+        (None, {}),
+        ([{}], {}),
+        ([{"at": "2026-11-18T04:00:00Z", "cents": 1.5}], {}),
+        ([], {"utc_offset_hours": 24}),
+        ([], {"utc_offset_hours": 1.5}),
+        ([], {"day_starts_hour": 24}),
+        ([], {"day_starts_hour": -1}),
+        ([], {"day_starts_hour": 2.5}),
+    ],
+)
+def test_invalid_arguments_raise_shop_error(sales, options):
+    with pytest.raises(ShopError):
+        daily_revenue(sales, **options)
