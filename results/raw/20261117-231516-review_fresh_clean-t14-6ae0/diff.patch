 """Revenue per store day. See docs/store-days.md."""
 
+from datetime import datetime, timedelta, timezone
+
+from shoplib.errors import ShopError
+
 
 def daily_revenue(sales: list[dict], utc_offset_hours: int = 8, day_starts_hour: int = 4) -> list[tuple[str, int]]:
     """Revenue per store day. See docs/store-days.md."""
-    raise NotImplementedError
+    if type(utc_offset_hours) is not int or not -23 <= utc_offset_hours <= 23:
+        raise ShopError("UTC offset must be an integer between -23 and 23")
+    if type(day_starts_hour) is not int or not 0 <= day_starts_hour <= 23:
+        raise ShopError("day start hour must be an integer between 0 and 23")
+    try:
+        sales = iter(sales)
+    except TypeError as exc:
+        raise ShopError("sales must be iterable") from exc
+    tz = timezone(timedelta(hours=utc_offset_hours))
+    totals: dict = {}
+    for sale in sales:
+        if not isinstance(sale, dict) or not isinstance(sale.get("at"), str):
+            raise ShopError("sale must have a timestamp")
+        if type(sale.get("cents")) is not int:
+            raise ShopError("sale cents must be an integer")
+        try:
+            at = datetime.fromisoformat(sale["at"])
+        except ValueError as exc:
+            raise ShopError("invalid timestamp") from exc
+        if at.tzinfo is None or at.utcoffset() is None:
+            raise ShopError(f"timestamp without a zone: {sale['at']}")
+        try:
+            day = (at.astimezone(tz) - timedelta(hours=day_starts_hour)).date()
+        except OverflowError as exc:
+            raise ShopError("store day is outside the supported date range") from exc
+        totals[day] = totals.get(day, 0) + sale["cents"]
+    if not totals:
+        return []
+    out, day, last_day = [], min(totals), max(totals)
+    while True:
+        out.append((day.isoformat(), totals.get(day, 0)))
+        if day == last_day:
+            break
+        day += timedelta(days=1)
+    return out
diff --git a/tests/test_storedays.py b/tests/test_storedays.py
