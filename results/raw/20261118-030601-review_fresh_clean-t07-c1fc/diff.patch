-from shoplib.discounts import Coupon, apply_coupon
+from datetime import date
+
+import pytest
+
+from shoplib.discounts import Coupon, apply_coupon, apply_coupons
+from shoplib.errors import ShopError
 
 
 def test_percent():
@@ -7,3 +12,44 @@ def test_percent():
 
 def test_fixed_never_negative():
     assert apply_coupon(300, Coupon("FIVE", "fixed", 500)) == 0
+
+
+def test_combines_eligible_coupons_using_original_subtotal():
+    today = date(2026, 1, 15)
+    coupons = [
+        Coupon("Z-TEN", "percent", 10),
+        Coupon("A-TEN", "percent", 10, expires=today),
+        Coupon("FIVE-PERCENT", "percent", 5),
+        Coupon("FIXED", "fixed", 20, min_subtotal_cents=105),
+        Coupon("EXPIRED", "fixed", 90, expires=date(2026, 1, 14)),
+        Coupon("TOO-HIGH", "fixed", 90, min_subtotal_cents=106),
+    ]
+    # 10% of 105 rounds half up to 11; the fixed coupon uses the original
+    # subtotal for eligibility even though the percentage is applied first.
+    assert apply_coupons(105, coupons, today) == (74, ["A-TEN", "FIXED"])
+
+
+def test_all_fixed_codes_are_reported_even_when_total_reaches_zero():
+    coupons = [Coupon("Z", "fixed", 200), Coupon("A", "fixed", 50),
+               Coupon("A", "fixed", 1)]
+    assert apply_coupons(100, coupons, date(2026, 1, 15)) == (0, ["A", "A", "Z"])
+
+
+def test_highest_percentage_wins_and_total_is_clamped():
+    coupons = [Coupon("A", "percent", 10), Coupon("Z", "percent", 150),
+               Coupon("FIXED", "fixed", 5)]
+    assert apply_coupons(100, coupons, date(2026, 1, 15)) == (0, ["FIXED", "Z"])
+
+
+def test_no_eligible_coupons():
+    today = date(2026, 1, 15)
+    assert apply_coupons(100, [], today) == (100, [])
+    assert apply_coupons(100, [Coupon("OLD", "percent", 50, expires=date(2026, 1, 14))], today) == (100, [])
+
+
+def test_rejects_negative_subtotal_and_unknown_coupon_kind():
+    today = date(2026, 1, 15)
+    with pytest.raises(ShopError):
+        apply_coupons(-1, [], today)
+    with pytest.raises(ShopError):
+        apply_coupons(100, [Coupon("BAD", "unknown", 10)], today)
