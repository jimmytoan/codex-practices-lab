@@ -0,0 +1,86 @@
+import pytest
+
+from shoplib.errors import ShopError
+from shoplib.invoice import build_invoice
+
+
+def test_invoice_allocates_coupon_and_calculates_each_tax_and_total():
+    invoice = build_invoice(
+        [("a", 150, 2, "standard"), ("b", 200, 1, "food"),
+         ("c", 100, 1, "books")],
+        5, 150, "DE",
+    )
+    assert invoice == {
+        "lines": [
+            {"sku": "a", "gross_cents": 300, "discount_cents": 2,
+             "net_cents": 298, "tax_cents": 57},
+            {"sku": "b", "gross_cents": 200, "discount_cents": 2,
+             "net_cents": 198, "tax_cents": 14},
+            {"sku": "c", "gross_cents": 100, "discount_cents": 1,
+             "net_cents": 99, "tax_cents": 7},
+        ],
+        "shipping_cents": 150,
+        "shipping_tax_cents": 29,
+        "total_cents": 852,
+    }
+
+
+def test_coupon_ties_go_to_earlier_lines():
+    invoice = build_invoice(
+        [("a", 1, 1, "books"), ("b", 1, 1, "books"),
+         ("c", 1, 1, "books")], 2, 0, "SG",
+    )
+    assert [line["discount_cents"] for line in invoice["lines"]] == [1, 1, 0]
+    assert invoice["total_cents"] == 1
+
+
+def test_coupon_is_capped_and_shipping_tax_depends_on_category_not_net():
+    invoice = build_invoice([("a", 100, 1, "standard")], 1000, 50, "SG")
+    assert invoice["lines"][0] == {
+        "sku": "a", "gross_cents": 100, "discount_cents": 100,
+        "net_cents": 0, "tax_cents": 0,
+    }
+    assert invoice["shipping_tax_cents"] == 5
+    assert invoice["total_cents"] == 55
+
+
+def test_zero_gross_has_no_discount_but_taxable_category_taxes_shipping():
+    invoice = build_invoice(
+        [("a", 0, 1, "standard"), ("b", 0, 2, "books")], 100, 50, "SG"
+    )
+    assert [line["discount_cents"] for line in invoice["lines"]] == [0, 0]
+    assert invoice["shipping_tax_cents"] == 5
+    assert invoice["total_cents"] == 55
+
+
+@pytest.mark.parametrize("region, category", [("SG", "books"), ("OR", "standard")])
+def test_shipping_is_untaxed_when_all_categories_are_exempt(region, category):
+    invoice = build_invoice([("a", 100, 1, category)], 0, 50, region)
+    assert invoice["shipping_tax_cents"] == 0
+    assert invoice["total_cents"] == 150
+
+
+def test_tax_is_rounded_per_line():
+    invoice = build_invoice(
+        [("a", 6, 1, "standard"), ("b", 6, 1, "food")], 0, 0, "SG"
+    )
+    assert [line["tax_cents"] for line in invoice["lines"]] == [1, 1]
+    assert invoice["total_cents"] == 14
+
+
+@pytest.mark.parametrize(
+    "lines, coupon, shipping, region",
+    [
+        ([("a", 100, 1, "standard")], 0, 0, "unknown"),
+        ([("a", 100, 1, "unknown")], 0, 0, "DE"),
+        ([], 0, 0, "DE"),
+        ([("a", 100, 0, "standard")], 0, 0, "DE"),
+        ([("a", 100, -1, "standard")], 0, 0, "DE"),
+        ([("a", -1, 1, "standard")], 0, 0, "DE"),
+        ([("a", 100, 1, "standard")], -1, 0, "DE"),
+        ([("a", 100, 1, "standard")], 0, -1, "DE"),
+    ],
+)
+def test_invalid_arguments_raise_shop_error(lines, coupon, shipping, region):
+    with pytest.raises(ShopError):
+        build_invoice(lines, coupon, shipping, region)
