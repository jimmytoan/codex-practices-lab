diff --git a/src/shoplib/orders.py b/src/shoplib/orders.py
index 8edb164..fa723e2 100644
--- a/src/shoplib/orders.py
+++ b/src/shoplib/orders.py
@@ -1,6 +1,7 @@
 """Orders and their life cycle. See docs/order-states.md."""
 
 from .inventory import Inventory
+from .errors import ShopError
 
 NEW = "NEW"
 PAID = "PAID"
@@ -46,3 +47,22 @@ class Order:
 
     def deliver(self) -> None:
         self._transition((SHIPPED,), DELIVERED)
+
+    def cancel(self) -> None:
+        """Cancel an unshipped order and return its reserved stock."""
+        if self.state == CANCELLED:
+            return
+        if self.state not in (NEW, PAID):
+            raise ShopError(f"cannot cancel an order in {self.state} state")
+
+        # Check every line before releasing any stock so a failed cancellation
+        # cannot leave some of the order's reservations released.
+        for sku, qty in self.lines.items():
+            if qty > self.inventory.reserved(sku):
+                raise ShopError(f"only {self.inventory.reserved(sku)} of {sku} reserved")
+        for sku, qty in self.lines.items():
+            self.inventory.release(sku, qty)
+
+        if self.state == PAID:
+            self.refund_due = True
+        self.state = CANCELLED
diff --git a/tests/test_inventory.py b/tests/test_inventory.py
index 37436c0..10b8dea 100644
--- a/tests/test_inventory.py
+++ b/tests/test_inventory.py
@@ -18,3 +18,29 @@ def test_cannot_reserve_more_than_available():
     inv.receive("A", 2)
     with pytest.raises(ValueError):
         inv.reserve("A", 3)
+
+
+def test_release_returns_reserved_stock_to_available():
+    inv = Inventory()
+    inv.receive("A", 10)
+    inv.reserve("A", 4)
+
+    inv.release("A", 3)
+
+    assert inv.on_hand("A") == 10
+    assert inv.reserved("A") == 1
+    assert inv.available("A") == 9
+
+
+@pytest.mark.parametrize("qty", [0, -1, 3])
+def test_invalid_release_changes_nothing(qty):
+    inv = Inventory()
+    inv.receive("A", 2)
+    inv.reserve("A", 2)
+
+    with pytest.raises(ValueError):
+        inv.release("A", qty)
+
+    assert inv.on_hand("A") == 2
+    assert inv.reserved("A") == 2
+    assert inv.available("A") == 0
diff --git a/tests/test_orders.py b/tests/test_orders.py
index d3835d1..797df59 100644
--- a/tests/test_orders.py
+++ b/tests/test_orders.py
@@ -1,7 +1,7 @@
 import pytest
 
 from shoplib.inventory import Inventory
-from shoplib.orders import DELIVERED, NEW, Order
+from shoplib.orders import CANCELLED, DELIVERED, NEW, PAID, SHIPPED, Order
 
 
 def make():
@@ -25,3 +25,78 @@ def test_cannot_ship_unpaid():
     _, order = make()
     with pytest.raises(ValueError):
         order.ship()
+
+
+def test_cancel_new_releases_stock_without_refund():
+    inv, order = make()
+
+    order.cancel()
+
+    assert order.state == CANCELLED
+    assert order.refund_due is False
+    assert inv.on_hand("A") == 5
+    assert inv.reserved("A") == 0
+    assert inv.available("A") == 5
+
+
+def test_cancel_paid_releases_stock_and_sets_refund_due():
+    inv, order = make()
+    order.pay()
+
+    order.cancel()
+
+    assert order.state == CANCELLED
+    assert order.refund_due is True
+    assert inv.reserved("A") == 0
+    assert inv.available("A") == 5
+
+
+def test_cancelling_cancelled_order_does_not_release_twice():
+    inv, order = make()
+    order.cancel()
+
+    order.cancel()
+
+    assert order.state == CANCELLED
+    assert inv.reserved("A") == 0
+    assert inv.available("A") == 5
+
+
+@pytest.mark.parametrize("terminal_state", [SHIPPED, DELIVERED])
+def test_cannot_cancel_shipped_or_delivered_order(terminal_state):
+    inv, order = make()
+    order.pay()
+    if terminal_state == SHIPPED:
+        order.ship()
+    else:
+        order.ship()
+        order.deliver()
+    state_before = order.state
+    on_hand_before = inv.on_hand("A")
+    reserved_before = inv.reserved("A")
+    available_before = inv.available("A")
+
+    with pytest.raises(ValueError):
+        order.cancel()
+
+    assert order.state == state_before
+    assert order.refund_due is False
+    assert inv.on_hand("A") == on_hand_before
+    assert inv.reserved("A") == reserved_before
+    assert inv.available("A") == available_before
+
+
+def test_failed_multiline_cancel_does_not_partially_release():
+    inv = Inventory()
+    inv.receive("A", 5)
+    inv.receive("B", 5)
+    order = Order("o2", {"A": 2, "B": 2}, inv)
+    inv.release("B", 1)
+
+    with pytest.raises(ValueError):
+        order.cancel()
+
+    assert order.state == NEW
+    assert order.refund_due is False
+    assert inv.reserved("A") == 2
+    assert inv.reserved("B") == 1
