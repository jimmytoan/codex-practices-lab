@@ -1,3 +1,6 @@
+import pytest
+
+from shoplib.errors import ShopError
 from shoplib.textutil import slugify, truncate
 
 
@@ -6,6 +9,49 @@ def test_slugify_basic():
     assert slugify("!!!") == "n-a"
 
 
+@pytest.mark.parametrize(
+    ("text", "expected"),
+    [
+        ("Crème Brûlée", "creme-brulee"),
+        ("CAFE\u0301 déjà vu", "cafe-deja-vu"),
+        ("Ångström 123", "angstrom-123"),
+        ("Łódź and smørrebrød", "lodz-and-smorrebrod"),
+        ("a\u0301\u0327b", "ab"),
+        ("one___漢字 / TWO", "one-two"),
+        ("a漢\u0301b", "a-b"),
+        ("---", "n-a"),
+        ("", "n-a"),
+    ],
+)
+def test_slugify_normalizes_and_separates(text, expected):
+    assert slugify(text) == expected
+
+
+@pytest.mark.parametrize(
+    ("text", "max_len", "expected"),
+    [
+        ("Crème Brûlée", 5, "creme"),
+        ("Crème Brûlée", 6, "creme"),
+        ("Crème Brûlée", 7, "creme-b"),
+        ("Product", 1, "p"),
+        ("Product", 2, "pr"),
+        ("!!!", 3, "n-a"),
+        ("a" * 50, 40, "a" * 40),
+    ],
+)
+def test_slugify_max_len(text, max_len, expected):
+    assert slugify(text, max_len) == expected
+
+
+@pytest.mark.parametrize(
+    "text, max_len",
+    [("product", 0), ("product", -1), ("!!!", 1), ("", 2), ("product", 1.5), (None, 3)],
+)
+def test_slugify_rejects_invalid_arguments(text, max_len):
+    with pytest.raises(ShopError):
+        slugify(text, max_len)
+
+
 def test_truncate():
     assert truncate("hello world", 8) == "hello..."
     assert truncate("short", 8) == "short"
