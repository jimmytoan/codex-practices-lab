 def test_percent():
@@ -7,3 +12,67 @@ def test_percent():
 
 def test_fixed_never_negative():
     assert apply_coupon(300, Coupon("FIVE", "fixed", 500)) == 0
+
+
+@pytest.mark.parametrize("reverse", [False, True])
+def test_combines_eligible_coupons_using_original_subtotal(reverse):
+    today = date(2026, 11, 18)
+    coupons = [
+        Coupon("B", "percent", 50),
+        Coupon("A", "percent", 50, expires=today, min_subtotal_cents=333),
+        Coupon("LOW", "percent", 40),
+        Coupon("TOO_SMALL_PERCENT", "percent", 80, min_subtotal_cents=334),
+        Coupon("EXPIRED_PERCENT", "percent", 90, expires=today - timedelta(days=1)),
+        Coupon("Z", "fixed", 20, min_subtotal_cents=333),
+        Coupon("C", "fixed", 30, expires=today + timedelta(days=1)),
+        Coupon("TOO_SMALL", "fixed", 100, min_subtotal_cents=334),
+        Coupon("EXPIRED_FIXED", "fixed", 100, expires=today - timedelta(days=1)),
+    ]
+    if reverse:
+        coupons.reverse()
+    original_coupons = coupons[:]
+
+    # 50% of 333 rounds up to 167; both fixed coupons then apply.
+    assert apply_coupons(333, coupons, today) == (116, ["A", "C", "Z"])
+    assert coupons == original_coupons
+
+
+def test_empty_and_ineligible_coupons():
+    today = date(2026, 11, 18)
+    assert apply_coupons(0, [], today) == (0, [])
+    assert apply_coupons(100, [Coupon("NO", "fixed", 50, min_subtotal_cents=101)], today) == (
+        100,
+        [],
+    )
+
+
+def test_all_eligible_codes_remain_when_discounts_exceed_subtotal():
+    coupons = [
+        Coupon("PERCENT", "percent", 100),
+        Coupon("SAME", "fixed", 200),
+        Coupon("SAME", "fixed", 300),
+    ]
+    assert apply_coupons(100, coupons, date(2026, 11, 18)) == (
+        0,
+        ["PERCENT", "SAME", "SAME"],
+    )
+
+
+def test_fixed_coupons_apply_without_a_percent_coupon():
+    coupons = [Coupon("B", "fixed", 200), Coupon("A", "fixed", 50)]
+    assert apply_coupons(300, coupons, date(2026, 11, 18)) == (50, ["A", "B"])
+
+
+def test_zero_value_coupons_still_apply():
+    coupons = [Coupon("P", "percent", 0), Coupon("F", "fixed", 0)]
+    assert apply_coupons(0, coupons, date(2026, 11, 18)) == (0, ["F", "P"])
+
+
+def test_negative_subtotal_raises_shop_error():
+    with pytest.raises(ShopError):
+        apply_coupons(-1, [], date(2026, 11, 18))
+
+
+def test_unknown_coupon_kind_raises_shop_error():
+    with pytest.raises(ShopError):
+        apply_coupons(100, [Coupon("BAD", "other", 10)], date(2026, 11, 18))
