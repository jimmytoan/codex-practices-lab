@@ -0,0 +1,80 @@
+import pytest
+
+from shoplib.errors import ShopError
+from shoplib.search import Product, search
+
+
+@pytest.fixture
+def products():
+    return [
+        Product("MUG-1", "Blue ceramic mug", 1000, ["Sale", "Kitchen"]),
+        Product("mug-2", "BLUE glass mug", 999, ["sale-item"]),
+        Product("CUP*3", "Blue mug: large", 1500, ["special*tag"]),
+        Product("PLATE", "Red plate", 1000, []),
+    ]
+
+
+@pytest.mark.parametrize(
+    ("query", "indices"),
+    [
+        ("", [0, 1, 2, 3]),
+        (" \t\n", [0, 1, 2, 3]),
+        ("bLuE", [0, 1, 2]),
+        ('"blue ceramic"', [0]),
+        ('name:"blue glass"', [1]),
+        ('"mug: large"', [2]),
+        ('name:"mug: large"', [2]),
+        ("blue mug", [0, 1, 2]),
+        ("blue -tag:sale", [1, 2]),
+        ('-name:"blue glass"', [0, 2, 3]),
+        ("sku:mug-1", [0]),
+        ("sku:MUG-*", [0, 1]),
+        ("sku:CUP*3", [2]),
+        ("tag:SALE", [0]),
+        ("tag:sale*", [0, 1]),
+        ("tag:special*tag", [2]),
+        ("name:BLUE", [0, 1, 2]),
+        ("name:blue*", []),
+        ("price<1000", [1]),
+        ("price<=1000", [0, 1, 3]),
+        ("price>1000", [2]),
+        ("price>=1000", [0, 2, 3]),
+        ("price=1000", [0, 3]),
+        ("-price=1000", [1, 2]),
+        ("price>=0999 price<1500", [0, 1, 3]),
+        ("tag:*", [0, 1, 2]),
+        ("sku:*", [0, 1, 2, 3]),
+    ],
+)
+def test_query_terms(products, query, indices):
+    assert search(products, query) == [products[i] for i in indices]
+
+
+@pytest.mark.parametrize(
+    "query",
+    [
+        '"unfinished', 'name:"unfinished', 'x "unfinished',
+        "-", '-""', "tag:", 'name:""', "-sku:",
+        "other:value", "price:5", "SKU:abc", ":value",
+        "price<", "price<=", "price>abc", "price>=1.5", "price=-1",
+        "price=+1", "price==1", "price<１２", "-price>oops",
+        "no-match tag:",
+    ],
+)
+def test_invalid_queries_raise_shop_error_even_without_products(query):
+    with pytest.raises(ShopError):
+        search([], query)
+
+
+def test_quoted_whole_term_keeps_punctuation_literal():
+    products = [Product("1", "-tag:sale price>=100", 100, [])]
+    assert search(products, '"-tag:sale" "price>=100"') == products
+
+
+def test_whitespace_in_quotes_and_casefold():
+    products = [Product("Straße", "A blue\tMug", 5, ["Straße"])]
+    assert search(products, 'name:"BLUE\tMUG" sku:STRASSE tag:STRASSE') == products
+
+
+def test_very_large_whole_price_is_valid(products):
+    assert search(products, "price<" + "9" * 5000) == products
