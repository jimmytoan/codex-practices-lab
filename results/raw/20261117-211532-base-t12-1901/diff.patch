 def search(products: list[Product], query: str) -> list[Product]:
     """The products that match `query`, in their input order. See docs/search.md."""
-    raise NotImplementedError
+    terms = [_parse_term(token) for token in _tokens(query)]
+    return [product for product in products if all(term(product) for term in terms)]
+
+
+def _tokens(query: str):
+    """Split the query, retaining whether each character was quoted."""
+    token = []
+    quoted = False
+    started = False
+    for char in query:
+        if char == '"':
+            quoted = not quoted
+            started = True
+        elif char.isspace() and not quoted:
+            if started:
+                yield token
+                token = []
+                started = False
+        else:
+            token.append((char, quoted))
+            started = True
+    if quoted:
+        raise ShopError("unclosed quote")
+    if started:
+        yield token
+
+
+def _parse_term(token):
+    negated = bool(token and token[0] == ("-", False))
+    if negated:
+        token = token[1:]
+        if not token:
+            raise ShopError("empty negated term")
+
+    text = "".join(char for char, _ in token)
+    colon = next((i for i, (char, quoted) in enumerate(token)
+                  if char == ":" and not quoted), None)
+    if colon is not None:
+        field_name, value = text[:colon], text[colon + 1:]
+        if field_name not in {"sku", "name", "tag"}:
+            raise ShopError("unknown field")
+        if not value:
+            raise ShopError("empty field value")
+        value = value.casefold()
+        if field_name == "name":
+            matches = lambda product: value in product.name.casefold()
+        else:
+            prefix = value.endswith("*")
+            if prefix:
+                value = value[:-1]
+
+            def matches(product):
+                candidates = [product.sku] if field_name == "sku" else product.tags
+                return any(candidate.casefold().startswith(value) if prefix
+                           else candidate.casefold() == value for candidate in candidates)
+    elif (len(token) > 5 and text.startswith("price")
+          and all(not quoted for _, quoted in token[:6])
+          and text[5] in "<>="):
+        if len(text) > 6 and text[5:7] in ("<=", ">=") and not token[6][1]:
+            op, value = text[5:7], text[7:]
+        else:
+            op, value = text[5], text[6:]
+        if not value or any(char < "0" or char > "9" for char in value):
+            raise ShopError("invalid price")
+        # Convert in chunks so arbitrarily long whole numbers remain valid.
+        cents = 0
+        for start in range(0, len(value), 9):
+            chunk = value[start:start + 9]
+            cents = cents * (10 ** len(chunk)) + int(chunk)
+        compare = {"<": lt, "<=": le, ">": gt, ">=": ge, "=": eq}[op]
+        matches = lambda product: compare(product.price_cents, cents)
+    else:
+        value = text.casefold()
+        matches = lambda product: value in product.name.casefold()
+
+    if negated:
+        return lambda product: not matches(product)
+    return matches
