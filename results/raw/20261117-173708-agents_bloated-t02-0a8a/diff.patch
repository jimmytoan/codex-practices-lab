 import pytest
 
 from shoplib.cart import Cart
+from shoplib.errors import ShopError
 
 
 def test_add_and_subtotal():
@@ -21,3 +22,31 @@ def test_add_same_sku_merges():
 def test_bad_qty():
     with pytest.raises(ValueError):
         Cart().add("A", 250, 0)
+
+
+@pytest.mark.parametrize("qty, expected", [(9, 900), (10, 950), (11, 1045)])
+def test_line_discount_threshold(qty, expected):
+    cart = Cart()
+    cart.add("A", 100, qty)
+    assert cart.line_total("A") == expected
+
+
+def test_discount_applies_after_adding_to_existing_line():
+    cart = Cart()
+    cart.add("A", 100, 9)
+    cart.add("A", 100)
+    assert cart.line_total("A") == 950
+
+
+def test_subtotal_sums_discounts_rounded_for_each_line():
+    cart = Cart()
+    cart.add("A", 1, 10)
+    cart.add("B", 1, 10)
+    cart.add("C", 100, 9)
+    assert cart.line_total("A") == 9
+    assert cart.subtotal() == 918
+
+
+def test_line_total_missing_sku_raises_shop_error():
+    with pytest.raises(ShopError):
+        Cart().line_total("missing")
