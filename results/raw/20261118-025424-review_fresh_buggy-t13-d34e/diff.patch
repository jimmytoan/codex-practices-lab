@@ -1,6 +1,53 @@
 """Cost of goods sold with FIFO lots. See docs/costing.md."""
 
+from decimal import Decimal, localcontext
+
+from .errors import ShopError
+from .money import round_cents
+
 
 def fifo_costing(events: list[dict]) -> dict:
     """Process stock events and report cost per SKU. See docs/costing.md."""
-    raise NotImplementedError
+    lots: dict[str, list[list[int]]] = {}
+    cogs: dict[str, int] = {}
+    last_sale: dict[str, dict] = {}
+    for ev in events:
+        kind, sku, qty = ev["type"], ev["sku"], ev["qty"]
+        if qty < 1:
+            raise ShopError("qty must be at least 1")
+        lots.setdefault(sku, [])
+        cogs.setdefault(sku, 0)
+        if kind == "receive":
+            if ev["unit_cost_cents"] < 0:
+                raise ShopError("unit cost must not be negative")
+            lots[sku].append([qty, ev["unit_cost_cents"]])
+        elif kind == "sell":
+            if qty > sum(q for q, _ in lots[sku]):
+                raise ShopError(f"not enough {sku} on hand")
+            need, cost = qty, 0
+            while need:
+                lot = lots[sku][0]
+                take = min(need, lot[0])
+                cost += take * lot[1]
+                lot[0] -= take
+                need -= take
+                if lot[0] == 0:
+                    lots[sku].pop(0)
+            cogs[sku] += cost
+            last_sale[sku] = {"qty": qty, "cost": cost, "returned": 0}
+        elif kind == "return":
+            sale = last_sale.get(sku)
+            if sale is None or qty > sale["qty"] - sale["returned"]:
+                raise ShopError(f"cannot return {qty} of {sku}")
+            cost, sold_qty = Decimal(sale["cost"]), Decimal(sale["qty"])
+            # Preserve enough precision to distinguish averages just below a half cent.
+            with localcontext() as context:
+                context.prec = max(1, cost.adjusted() + 1) + sold_qty.adjusted() + 3
+                unit = round_cents(cost / sold_qty)
+            sale["returned"] += qty
+            lots[sku].append([qty, unit])
+            cogs[sku] -= qty * unit
+        else:
+            raise ShopError(f"unknown event type {kind!r}")
+    return {sku: {"cogs_cents": cogs[sku], "on_hand": sum(q for q, _ in lots[sku]),
+                  "value_cents": sum(q * c for q, c in lots[sku])} for sku in lots}
diff --git a/tests/test_costing.py b/tests/test_costing.py
new file mode 100644
index 0000000..1bd8003
--- /dev/null
+++ b/tests/test_costing.py
@@ -0,0 +1,90 @@
+from copy import deepcopy
+
+import pytest
+
+from shoplib.costing import fifo_costing
+from shoplib.errors import ShopError
+
+
+def event(kind, sku, qty, cost=None):
+    result = {"type": kind, "sku": sku, "qty": qty}
+    if cost is not None:
+        result["unit_cost_cents"] = cost
+    return result
+
+
+def test_fifo_sales_and_independent_skus():
+    events = [event("receive", "A", 2, 100), event("receive", "B", 3, 7),
+              event("receive", "A", 3, 150), event("sell", "A", 4),
+              event("sell", "B", 1)]
+    original = deepcopy(events)
+    assert fifo_costing(events) == {
+        "A": {"cogs_cents": 500, "on_hand": 1, "value_cents": 150},
+        "B": {"cogs_cents": 7, "on_hand": 2, "value_cents": 14},
+    }
+    assert events == original
+    assert fifo_costing([]) == {}
+
+
+@pytest.mark.parametrize("second_cost, expected", [(100, 100), (101, 101), (102, 101)])
+def test_return_uses_average_cost_rounded_half_up(second_cost, expected):
+    events = [event("receive", "A", 1, 100), event("receive", "A", 1, second_cost),
+              event("sell", "A", 2), event("return", "A", 1)]
+    assert fifo_costing(events)["A"] == {
+        "cogs_cents": 100 + second_cost - expected,
+        "on_hand": 1,
+        "value_cents": expected,
+    }
+
+
+def test_return_average_just_below_half_cent_with_large_quantities():
+    n = 10**30
+    events = [event("receive", "A", n + 1, 0), event("receive", "A", n - 1, 1),
+              event("sell", "A", 2 * n), event("return", "A", 1)]
+    assert fifo_costing(events)["A"] == {
+        "cogs_cents": n - 1, "on_hand": 1, "value_cents": 0,
+    }
+
+
+def test_return_lot_follows_existing_lots():
+    events = [event("receive", "A", 2, 10), event("receive", "A", 2, 20),
+              event("sell", "A", 1), event("return", "A", 1), event("sell", "A", 2)]
+    assert fifo_costing(events)["A"] == {
+        "cogs_cents": 30, "on_hand": 2, "value_cents": 30,
+    }
+
+
+def test_multiple_returns_and_most_recent_sale_per_sku():
+    events = [event("receive", "A", 2, 100), event("receive", "A", 2, 101),
+              event("sell", "A", 4), event("receive", "B", 1, 20),
+              event("sell", "B", 1), event("return", "A", 1),
+              event("return", "A", 1), event("return", "B", 1)]
+    assert fifo_costing(events) == {
+        "A": {"cogs_cents": 200, "on_hand": 2, "value_cents": 202},
+        "B": {"cogs_cents": 0, "on_hand": 1, "value_cents": 20},
+    }
+    events.extend([event("sell", "A", 1), event("return", "A", 1)])
+    assert fifo_costing(events)["A"] == {
+        "cogs_cents": 200, "on_hand": 2, "value_cents": 202,
+    }
+
+
+@pytest.mark.parametrize("events", [
+    [event("receive", "A", 0, 1)],
+    [event("sell", "A", -1)],
+    [event("return", "A", 0)],
+    [event("receive", "A", 1, -1)],
+    [event("receive", "A", 1, 0), event("sell", "A", 2)],
+    [event("return", "A", 1)],
+    [event("receive", "A", 2, 10), event("sell", "A", 2), event("return", "A", 3)],
+    [event("receive", "A", 2, 10), event("sell", "A", 2),
+     event("return", "A", 1), event("return", "A", 2)],
+    [event("receive", "A", 3, 10), event("sell", "A", 2),
+     event("sell", "A", 1), event("return", "A", 2)],
+    [event("unknown", "A", 1)],
+])
+def test_invalid_events_raise_shop_error_without_modifying_events(events):
+    original = deepcopy(events)
+    with pytest.raises(ShopError):
+        fifo_costing(events)
+    assert events == original
