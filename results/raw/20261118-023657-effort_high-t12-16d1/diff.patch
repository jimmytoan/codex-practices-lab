@@ -13,4 +18,90 @@ class Product:
 
 def search(products: list[Product], query: str) -> list[Product]:
     """The products that match `query`, in their input order. See docs/search.md."""
-    raise NotImplementedError
+    predicates = [_parse_term(token) for token in _tokenize(query)]
+    return [product for product in products if all(test(product) for test in predicates)]
+
+
+def _tokenize(query: str) -> list[str]:
+    tokens = []
+    chars = []
+    quoted = False
+    started = False
+    for char in query:
+        if char == '"':
+            quoted = not quoted
+            started = True
+        elif char.isspace() and not quoted:
+            if started:
+                tokens.append("".join(chars))
+                chars = []
+                started = False
+        else:
+            chars.append(char)
+            started = True
+    if quoted:
+        raise ShopError("unclosed quote")
+    if started:
+        tokens.append("".join(chars))
+    return tokens
+
+
+_PRICE = re.compile(r"price(<=|>=|<|>|=)(.*)\Z", re.DOTALL)
+_COMPARISONS = {
+    "<": operator.lt,
+    "<=": operator.le,
+    ">": operator.gt,
+    ">=": operator.ge,
+    "=": operator.eq,
+}
+
+
+def _parse_term(token: str) -> Callable[[Product], bool]:
+    negated = token.startswith("-")
+    if negated:
+        token = token[1:]
+        if not token:
+            raise ShopError("empty negated term")
+
+    if ":" in token:
+        field_name, value = token.split(":", 1)
+        if field_name not in ("sku", "name", "tag"):
+            raise ShopError("unknown search field")
+        if not value:
+            raise ShopError("empty search field value")
+        value = value.casefold()
+        prefix = field_name in ("sku", "tag") and value.endswith("*")
+        if prefix:
+            value = value[:-1]
+
+        def matches(product: Product) -> bool:
+            if field_name == "name":
+                return value in product.name.casefold()
+            values = (product.sku,) if field_name == "sku" else product.tags
+            if prefix:
+                return any(item.casefold().startswith(value) for item in values)
+            return any(item.casefold() == value for item in values)
+
+    elif price_match := _PRICE.fullmatch(token):
+        comparison, value = price_match.groups()
+        if not value or any(char not in "0123456789" for char in value):
+            raise ShopError("invalid price")
+        # Parse in chunks so valid long values do not hit Python's digit limit.
+        price = 0
+        for offset in range(0, len(value), 9):
+            chunk = value[offset:offset + 9]
+            price = price * 10 ** len(chunk) + int(chunk)
+        compare = _COMPARISONS[comparison]
+
+        def matches(product: Product) -> bool:
+            return compare(product.price_cents, price)
+
+    else:
+        value = token.casefold()
+
+        def matches(product: Product) -> bool:
+            return value in product.name.casefold()
+
+    if negated:
+        return lambda product: not matches(product)
+    return matches
