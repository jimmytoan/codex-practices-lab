@@ -0,0 +1,133 @@
+import pytest
+
+from shoplib.errors import ShopError
+from shoplib.search import Product, search
+
+
+@pytest.fixture
+def products():
+    return [
+        Product("MUG-BLUE", "Blue ceramic mug", 1000, ["Sale", "Kitchen"]),
+        Product("MUG-RED", "Red mug", 1500, ["Kitchenware"]),
+        Product("PLATE", "Blue plate", 1000, ["sale"]),
+        Product("MUG-*STAR", "Blue * mug", 0, []),
+    ]
+
+
+@pytest.mark.parametrize("query", ["", "  \t\n  "])
+def test_empty_query_preserves_input_order_and_duplicates(products, query):
+    ordered = [products[2], products[0], products[2]]
+    assert search(ordered, query) == ordered
+
+
+@pytest.mark.parametrize(
+    ("query", "indexes"),
+    [
+        ("mUg", [0, 1, 3]),
+        ('"blue ceramic"', [0]),
+        ('name:"BLUE ceramic"', [0]),
+        ("mug\tBLUE", [0, 3]),
+        ("sku:mug-blue", [0]),
+        ("sku:mug", []),
+        ("sku:mug-*", [0, 1, 3]),
+        ("sku:MUG-*STAR", [3]),
+        ("sku:MUG-**", [3]),
+        ("tag:sAlE", [0, 2]),
+        ("tag:kit", []),
+        ("tag:KIT*", [0, 1]),
+        ("tag:*", [0, 1, 2]),
+        ("name:BLUE", [0, 2, 3]),
+        ("name:blue*", []),
+        ("*", [3]),
+        ("-tag:sale", [1, 3]),
+        ("-sku:mug-*", [2]),
+        ('-name:"blue ceramic"', [1, 2, 3]),
+        ('-"blue plate"', [0, 1, 3]),
+        ("mug -tag:sale price>=1000", [1]),
+        ("price<1000", [3]),
+        ("price<=1000", [0, 2, 3]),
+        ("price>1000", [1]),
+        ("price>=1000", [0, 1, 2]),
+        ("price=1000", [0, 2]),
+        ("price=0000", [3]),
+        ("-price>=1000", [3]),
+        ("price", []),
+    ],
+)
+def test_matching(products, query, indexes):
+    assert search(products, query) == [products[i] for i in indexes]
+
+
+def test_quoted_values_and_whitespace():
+    products = [
+        Product("A B", "  Two\tWords  ", 20, ["big sale", "a:b"]),
+        Product("AB", "Two Words", 20, ["big"]),
+    ]
+    assert search(products, 'sku:"a b"') == products[:1]
+    assert search(products, 'tag:"BIG SALE"') == products[:1]
+    assert search(products, 'tag:"big s*"') == products[:1]
+    assert search(products, 'name:"Two\tWords"') == products[:1]
+    assert search(products, 'tag:"a:b"') == products[:1]
+    assert search(products, '""') == products
+
+
+def test_asterisks_are_literal_except_at_the_end_of_sku_or_tag_values():
+    products = [
+        Product("A*B", "Name*", 10, ["x*y", "sale*"]),
+        Product("AXB", "Name", 10, ["xay"]),
+    ]
+    for query in ("sku:a*b", "tag:x*y", "tag:sale**", "name:Name*"):
+        assert search(products, query) == products[:1]
+
+
+def test_comparison_requires_price_and_operator_to_be_adjacent():
+    product = Product("A", "price > 5", 10)
+    assert search([product], '"price > 5"') == [product]
+    assert search([product], "price > 5") == [product]
+
+
+def test_case_insensitive_matching_uses_casefold():
+    product = Product("STRASSE", "Straße cup", 100, ["Straße"])
+    for query in ("STRASSE", "name:STRASSE", "sku:straße", "tag:STRASSE"):
+        assert search([product], query) == [product]
+
+
+def test_large_whole_number_is_a_valid_price():
+    product = Product("A", "A", 1)
+    assert search([product], "price<" + "9" * 5000) == [product]
+
+
+@pytest.mark.parametrize(
+    "query",
+    [
+        "category:mug",
+        "price:5",
+        ":value",
+        "SKU:mug",
+        "tag:",
+        'tag:""',
+        "name:",
+        "sku:",
+        "-",
+        '-""',
+        '"unclosed',
+        'name:"unclosed',
+        'mug "unclosed',
+        "price=",
+        "price<abc",
+        "price<=1.5",
+        "price>-1",
+        "price>=+1",
+        "price==1",
+        "price<>1",
+        "price=1e3",
+        "price=1_000",
+        "price> 5",
+        'price="1 000"',
+    ],
+)
+@pytest.mark.parametrize("has_products", [False, True])
+def test_invalid_queries_raise_shop_error_even_without_matches(query, has_products):
+    products = [Product("A", "A", 1)] if has_products else []
+    with pytest.raises(ShopError):
+        search(products, "never-matches " + query)
