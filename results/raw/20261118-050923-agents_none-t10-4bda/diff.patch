diff --git a/src/shoplib/shipping.py b/src/shoplib/shipping.py
index add6985..c86f0c1 100644
--- a/src/shoplib/shipping.py
+++ b/src/shoplib/shipping.py
@@ -14,11 +14,44 @@ def shipping_cost(weight_g: int) -> int:
     raise ValueError("parcel is too heavy")
 
 
+def _pack_parcels(
+    items: list[tuple[str, int, int]], max_weight_g: int
+) -> list[list[tuple[str, int]]]:
+    units: list[tuple[int, str]] = []
+    for sku, unit_weight_g, qty in items:
+        if unit_weight_g < 1:
+            raise ValueError("unit weight must be positive")
+        if qty < 1:
+            raise ValueError("quantity must be positive")
+        if unit_weight_g > max_weight_g:
+            raise ValueError("unit is heavier than the parcel limit")
+        units.extend((unit_weight_g, sku) for _ in range(qty))
+
+    units.sort(key=lambda unit: (-unit[0], unit[1]))
+
+    parcels: list[list[tuple[str, int]]] = []
+    parcel_weights: list[int] = []
+    for unit_weight_g, sku in units:
+        for index, parcel_weight_g in enumerate(parcel_weights):
+            if parcel_weight_g + unit_weight_g <= max_weight_g:
+                parcels[index].append((sku, unit_weight_g))
+                parcel_weights[index] += unit_weight_g
+                break
+        else:
+            parcels.append([(sku, unit_weight_g)])
+            parcel_weights.append(unit_weight_g)
+
+    return parcels
+
+
 def split_parcels(items: list[tuple[str, int, int]], max_weight_g: int) -> list[list[str]]:
     """Split order items into parcels. See docs/shipping.md."""
-    raise NotImplementedError
+    return [[sku for sku, _ in parcel] for parcel in _pack_parcels(items, max_weight_g)]
 
 
 def shipment_cost(items: list[tuple[str, int, int]], max_weight_g: int) -> int:
     """Total shipping cost of an order. See docs/shipping.md."""
-    raise NotImplementedError
+    return sum(
+        shipping_cost(sum(unit_weight_g for _, unit_weight_g in parcel))
+        for parcel in _pack_parcels(items, max_weight_g)
+    )
