+def test_slugify_accents():
+    assert slugify("Crème Brûlée") == "creme-brulee"
+    assert slugify("Cre\u0300me Bru\u0302le\u0301e") == "creme-brulee"
+    assert slugify("CAFÉ / déjà vu", max_len=10) == "cafe-deja"
+    assert slugify("é & 茶") == "e"
+    assert slugify("\u0301!!!") == "n-a"
