--- /dev/null
+++ b/tests/test_invoice.py
@@ -0,0 +1,85 @@
+import pytest
+
+from shoplib.invoice import build_invoice
+
+
+def test_coupon_uses_largest_remainder_and_keeps_input_order():
+    invoice = build_invoice(
+        [
+            ("first", 1, 1, "standard"),
+            ("second", 1, 1, "food"),
+            ("third", 1, 1, "books"),
+        ],
+        coupon_cents=2,
+        shipping_cents=100,
+        region="DE",
+    )
+
+    assert invoice["lines"] == [
+        {"sku": "first", "gross_cents": 1, "discount_cents": 1, "net_cents": 0, "tax_cents": 0},
+        {"sku": "second", "gross_cents": 1, "discount_cents": 1, "net_cents": 0, "tax_cents": 0},
+        {"sku": "third", "gross_cents": 1, "discount_cents": 0, "net_cents": 1, "tax_cents": 0},
+    ]
+    assert invoice["shipping_tax_cents"] == 19
+    assert invoice["total_cents"] == 120
+
+
+def test_coupon_is_capped_and_zero_gross_has_no_discount():
+    capped = build_invoice(
+        [("a", 4, 1, "books"), ("b", 6, 1, "books")],
+        coupon_cents=50,
+        shipping_cents=0,
+        region="OR",
+    )
+    assert [line["discount_cents"] for line in capped["lines"]] == [4, 6]
+    assert capped["total_cents"] == 0
+
+    invoice = build_invoice(
+        [("zero-a", 0, 1, "books"), ("zero-b", 0, 2, "food")],
+        coupon_cents=50,
+        shipping_cents=200,
+        region="OR",
+    )
+
+    assert [line["discount_cents"] for line in invoice["lines"]] == [0, 0]
+    assert invoice["shipping_tax_cents"] == 0
+    assert invoice["total_cents"] == 200
+
+
+def test_tax_rounds_per_line_and_shipping_needs_a_taxed_category():
+    invoice = build_invoice(
+        [("a", 8, 1, "books"), ("b", 8, 1, "books")],
+        coupon_cents=0,
+        shipping_cents=100,
+        region="DE",
+    )
+    assert [line["tax_cents"] for line in invoice["lines"]] == [1, 1]
+    assert invoice["shipping_tax_cents"] == 19
+    assert invoice["total_cents"] == 137
+
+    untaxed = build_invoice(
+        [("book", 100, 1, "books")],
+        coupon_cents=0,
+        shipping_cents=100,
+        region="SG",
+    )
+    assert untaxed["lines"][0]["tax_cents"] == 0
+    assert untaxed["shipping_tax_cents"] == 0
+    assert untaxed["total_cents"] == 200
+
+
+@pytest.mark.parametrize(
+    ("lines", "coupon", "shipping", "region"),
+    [
+        ([("a", 1, 1, "books")], 0, 0, "XX"),
+        ([], 0, 0, "DE"),
+        ([("a", 1, 1, "books")], -1, 0, "DE"),
+        ([("a", 1, 1, "books")], 0, -1, "DE"),
+        ([("a", 1, 0, "books")], 0, 0, "DE"),
+        ([("a", -1, 1, "books")], 0, 0, "DE"),
+        ([("a", 1, 1, "unknown")], 0, 0, "DE"),
+    ],
+)
+def test_invalid_invoice_inputs_raise_value_error(lines, coupon, shipping, region):
+    with pytest.raises(ValueError):
+        build_invoice(lines, coupon, shipping, region)
