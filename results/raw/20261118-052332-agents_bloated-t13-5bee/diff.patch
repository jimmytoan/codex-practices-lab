diff --git a/src/shoplib/costing.py b/src/shoplib/costing.py
index 5e8c27e..2e6c545 100644
--- a/src/shoplib/costing.py
+++ b/src/shoplib/costing.py
@@ -1,6 +1,95 @@
 """Cost of goods sold with FIFO lots. See docs/costing.md."""
 
+from decimal import Decimal
+
+from shoplib.errors import ShopError
+from shoplib.money import round_cents
+
 
 def fifo_costing(events: list[dict]) -> dict:
     """Process stock events and report cost per SKU. See docs/costing.md."""
-    raise NotImplementedError
+    lots_by_sku: dict[str, list[list[int]]] = {}
+    cogs_by_sku: dict[str, int] = {}
+    last_sale_by_sku: dict[str, tuple[int, int]] = {}
+
+    for event in events:
+        if not isinstance(event, dict):
+            raise ShopError("each event must be a dict")
+
+        event_type = event.get("type")
+        if event_type not in ("receive", "sell", "return"):
+            raise ShopError(f"unknown event type: {event_type}")
+
+        try:
+            sku = event["sku"]
+            hash(sku)
+        except (KeyError, TypeError):
+            raise ShopError("event must have a valid sku") from None
+
+        if sku not in lots_by_sku:
+            lots_by_sku[sku] = []
+            cogs_by_sku[sku] = 0
+
+        qty = event.get("qty")
+        if not isinstance(qty, int) or isinstance(qty, bool) or qty < 1:
+            raise ShopError("qty must be a positive integer")
+
+        if event_type == "receive":
+            unit_cost = event.get("unit_cost_cents")
+            if (
+                not isinstance(unit_cost, int)
+                or isinstance(unit_cost, bool)
+                or unit_cost < 0
+            ):
+                raise ShopError("unit_cost_cents must be a non-negative integer")
+            lots_by_sku[sku].append([qty, unit_cost])
+            continue
+
+        if event_type == "sell":
+            lots = lots_by_sku[sku]
+            on_hand = sum(lot_qty for lot_qty, _ in lots)
+            if qty > on_hand:
+                raise ShopError(
+                    f"cannot sell {qty} units of {sku}; only {on_hand} on hand"
+                )
+
+            remaining = qty
+            sale_cost = 0
+            while remaining:
+                lot_qty, unit_cost = lots[0]
+                taken = min(remaining, lot_qty)
+                sale_cost += taken * unit_cost
+                remaining -= taken
+                if taken == lot_qty:
+                    lots.pop(0)
+                else:
+                    lots[0][0] -= taken
+
+            cogs_by_sku[sku] += sale_cost
+            average_unit_cost = round_cents(Decimal(sale_cost) / qty)
+            last_sale_by_sku[sku] = (qty, average_unit_cost)
+            continue
+
+        last_sale = last_sale_by_sku.get(sku)
+        if last_sale is None:
+            raise ShopError(f"cannot return units of {sku} without a sale")
+        returnable_qty, unit_cost = last_sale
+        if qty > returnable_qty:
+            raise ShopError(
+                f"cannot return {qty} units of {sku}; only {returnable_qty} returnable"
+            )
+
+        last_sale_by_sku[sku] = (returnable_qty - qty, unit_cost)
+        lots_by_sku[sku].append([qty, unit_cost])
+        cogs_by_sku[sku] -= qty * unit_cost
+
+    result = {}
+    for sku, lots in lots_by_sku.items():
+        on_hand = sum(qty for qty, _ in lots)
+        value = sum(qty * unit_cost for qty, unit_cost in lots)
+        result[sku] = {
+            "cogs_cents": cogs_by_sku[sku],
+            "on_hand": on_hand,
+            "value_cents": value,
+        }
+    return result
diff --git a/tests/test_costing.py b/tests/test_costing.py
new file mode 100644
index 0000000..e141621
