+++ b/tests/test_costing.py
@@ -0,0 +1,109 @@
+from copy import deepcopy
+
+import pytest
+
+from shoplib.costing import fifo_costing
+
+
+def test_fifo_sales_report_cogs_on_hand_and_remaining_value():
+    events = [
+        {"type": "receive", "sku": "A", "qty": 2, "unit_cost_cents": 125},
+        {"type": "receive", "sku": "A", "qty": 3, "unit_cost_cents": 200},
+        {"type": "sell", "sku": "A", "qty": 4},
+    ]
+
+    assert fifo_costing(events) == {
+        "A": {"cogs_cents": 650, "on_hand": 1, "value_cents": 200}
+    }
+
+
+def test_return_uses_rounded_average_cost_and_can_be_split():
+    events = [
+        {"type": "receive", "sku": "A", "qty": 1, "unit_cost_cents": 100},
+        {"type": "receive", "sku": "A", "qty": 1, "unit_cost_cents": 101},
+        {"type": "sell", "sku": "A", "qty": 2},
+        {"type": "return", "sku": "A", "qty": 1},
+        {"type": "return", "sku": "A", "qty": 1},
+    ]
+
+    assert fifo_costing(events) == {
+        "A": {"cogs_cents": -1, "on_hand": 2, "value_cents": 202}
+    }
+
+
+def test_returned_units_are_placed_after_all_existing_lots():
+    events = [
+        {"type": "receive", "sku": "A", "qty": 2, "unit_cost_cents": 100},
+        {"type": "sell", "sku": "A", "qty": 1},
+        {"type": "receive", "sku": "A", "qty": 1, "unit_cost_cents": 50},
+        {"type": "return", "sku": "A", "qty": 1},
+        {"type": "sell", "sku": "A", "qty": 2},
+    ]
+
+    assert fifo_costing(events) == {
+        "A": {"cogs_cents": 150, "on_hand": 1, "value_cents": 100}
+    }
+
+
+def test_only_most_recent_sale_can_be_returned():
+    events = [
+        {"type": "receive", "sku": "A", "qty": 2, "unit_cost_cents": 10},
+        {"type": "sell", "sku": "A", "qty": 1},
+        {"type": "sell", "sku": "A", "qty": 1},
+        {"type": "return", "sku": "A", "qty": 1},
+    ]
+
+    assert fifo_costing(events) == {
+        "A": {"cogs_cents": 10, "on_hand": 1, "value_cents": 10}
+    }
+
+
+def test_skus_are_costed_independently_and_all_appearing_skus_are_reported():
+    events = [
+        {"type": "receive", "sku": "A", "qty": 2, "unit_cost_cents": 30},
+        {"type": "receive", "sku": "B", "qty": 1, "unit_cost_cents": 80},
+        {"type": "sell", "sku": "A", "qty": 1},
+    ]
+
+    assert fifo_costing(events) == {
+        "A": {"cogs_cents": 30, "on_hand": 1, "value_cents": 30},
+        "B": {"cogs_cents": 0, "on_hand": 1, "value_cents": 80},
+    }
+
+
+@pytest.mark.parametrize(
+    "events",
+    [
+        [{"type": "receive", "sku": "A", "qty": 0, "unit_cost_cents": 1}],
+        [{"type": "sell", "sku": "A", "qty": -1}],
+        [{"type": "receive", "sku": "A", "qty": 1, "unit_cost_cents": -1}],
+        [{"type": "sell", "sku": "A", "qty": 1}],
+        [{"type": "return", "sku": "A", "qty": 1}],
+        [
+            {"type": "receive", "sku": "A", "qty": 1, "unit_cost_cents": 2},
+            {"type": "return", "sku": "A", "qty": 1},
+        ],
+        [
+            {"type": "receive", "sku": "A", "qty": 1, "unit_cost_cents": 2},
+            {"type": "sell", "sku": "A", "qty": 1},
+            {"type": "return", "sku": "A", "qty": 2},
+        ],
+        [{"type": "adjust", "sku": "A", "qty": 1}],
+    ],
+)
+def test_invalid_events_raise_value_error(events):
+    with pytest.raises(ValueError):
+        fifo_costing(events)
+
+
+def test_events_are_not_modified():
+    events = [
+        {"type": "receive", "sku": "A", "qty": 2, "unit_cost_cents": 10},
+        {"type": "sell", "sku": "A", "qty": 1},
+        {"type": "return", "sku": "A", "qty": 1},
+    ]
+    original = deepcopy(events)
+
+    fifo_costing(events)
+
+    assert events == original
