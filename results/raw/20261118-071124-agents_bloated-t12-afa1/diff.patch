 """Product search. See docs/search.md."""
 
+import re
 from dataclasses import dataclass, field
 
+from shoplib.errors import ShopError
+
 
 @dataclass
 class Product:
@@ -13,4 +16,104 @@ class Product:
 
 def search(products: list[Product], query: str) -> list[Product]:
     """The products that match `query`, in their input order. See docs/search.md."""
-    raise NotImplementedError
+    terms = _parse_query(query)
+    return [product for product in products if all(_matches(product, term) for term in terms)]
+
+
+def _parse_query(query: str) -> list[tuple[bool, str, str, str | int]]:
+    """Return parsed terms as (negated, kind, operator, value)."""
+    parsed = []
+    for token in _tokens(query):
+        negated = bool(token and token[0][0] == "-" and not token[0][1])
+        if negated:
+            token = token[1:]
+        if not token:
+            raise ShopError("a negation must have a term")
+
+        separator = next(
+            (index for index, (character, quoted) in enumerate(token) if character == ":" and not quoted),
+            None,
+        )
+        if separator is not None:
+            field_name = "".join(character for character, _ in token[:separator])
+            value = "".join(character for character, _ in token[separator + 1 :])
+            if field_name not in {"sku", "name", "tag"}:
+                raise ShopError(f"unknown search field: {field_name}")
+            if not value:
+                raise ShopError(f"empty value for {field_name}")
+            parsed.append((negated, field_name, "", value))
+            continue
+
+        value = "".join(character for character, _ in token)
+        price_match = re.match(r"^price(<=|>=|<|>|=)(.*)$", value)
+        if price_match and any(quoted for _, quoted in token[: 5 + len(price_match.group(1))]):
+            price_match = None
+        if price_match:
+            operator, cents_text = price_match.groups()
+            if not re.fullmatch(r"[0-9]+", cents_text):
+                raise ShopError("price comparison must use a whole number of cents")
+            parsed.append((negated, "price", operator, int(cents_text)))
+        else:
+            parsed.append((negated, "text", "", value))
+    return parsed
+
+
+def _tokens(query: str) -> list[list[tuple[str, bool]]]:
+    """Split on unquoted whitespace and retain which characters were quoted."""
+    tokens = []
+    token = []
+    in_quote = False
+    token_started = False
+
+    for character in query:
+        if character == '"':
+            in_quote = not in_quote
+            token_started = True
+            continue
+        if character.isspace() and not in_quote:
+            if token_started:
+                tokens.append(token)
+                token = []
+                token_started = False
+            continue
+        token.append((character, in_quote))
+        token_started = True
+
+    if in_quote:
+        raise ShopError("unclosed quote in search query")
+    if token_started:
+        tokens.append(token)
+    return tokens
+
+
+def _matches(product: Product, term: tuple[bool, str, str, str | int]) -> bool:
+    negated, kind, operator, value = term
+    if kind == "text":
+        result = str(value).casefold() in product.name.casefold()
+    elif kind == "name":
+        result = str(value).casefold() in product.name.casefold()
+    elif kind == "sku":
+        result = _matches_field(product.sku, str(value))
+    elif kind == "tag":
+        result = any(_matches_field(tag, str(value)) for tag in product.tags)
+    else:
+        result = _matches_price(product.price_cents, operator, int(value))
+    return not result if negated else result
+
+
+def _matches_field(actual: str, value: str) -> bool:
+    if value.endswith("*"):
+        return actual.casefold().startswith(value[:-1].casefold())
+    return actual.casefold() == value.casefold()
+
+
+def _matches_price(price_cents: int, operator: str, cents: int) -> bool:
+    if operator == "<":
+        return price_cents < cents
+    if operator == "<=":
+        return price_cents <= cents
+    if operator == ">":
+        return price_cents > cents
+    if operator == ">=":
+        return price_cents >= cents
+    return price_cents == cents
diff --git a/tests/test_search.py b/tests/test_search.py
