@@ -0,0 +1,85 @@
+import pytest
+
+from shoplib.errors import ShopError
+from shoplib.search import Product, search
+
+
+@pytest.fixture
+def products():
+    return [
+        Product("MUG-01", "Blue ceramic mug", 1200, ["kitchen", "sale"]),
+        Product("MUG-02", "Blue travel mug", 800, ["travel"]),
+        Product("PLATE-01", "White plate", 1500, ["kitchen"]),
+    ]
+
+
+def test_bare_words_and_quoted_phrases_match_name_case_insensitively(products):
+    assert search(products, "BLUE") == products[:2]
+    assert search(products, '"ceramic mug"') == products[:1]
+    assert search(products, 'name:"TRAVEL MUG"') == products[1:2]
+
+
+def test_terms_are_combined_and_input_order_is_preserved(products):
+    assert search(products, "mug tag:kitchen") == products[:1]
+
+
+def test_sku_and_tag_values_match_exactly_unless_they_end_in_star(products):
+    assert search(products, "sku:mug-01") == products[:1]
+    assert search(products, "tag:SALE") == products[:1]
+    assert search(products, "sku:MUG-*") == products[:2]
+    assert search(products, "tag:kit*") == [products[0], products[2]]
+    assert search(products, "sku:MUG*01") == []
+
+
+@pytest.mark.parametrize(
+    ("comparison", "expected"),
+    [
+        ("price<1000", ["MUG-02"]),
+        ("price<=1200", ["MUG-01", "MUG-02"]),
+        ("price>1200", ["PLATE-01"]),
+        ("price>=1500", ["PLATE-01"]),
+        ("price=800", ["MUG-02"]),
+    ],
+)
+def test_price_comparisons_use_integer_cents(products, comparison, expected):
+    assert [product.sku for product in search(products, comparison)] == expected
+
+
+def test_negation_applies_to_a_term_and_can_follow_a_field_prefix(products):
+    assert search(products, "mug -tag:sale") == products[1:2]
+    assert search(products, '-"white plate"') == products[:2]
+
+
+def test_empty_or_whitespace_query_matches_every_product(products):
+    assert search(products, "") == products
+    assert search(products, " \t\n ") == products
+
+
+@pytest.mark.parametrize(
+    "query",
+    [
+        "price:5",
+        "color:blue",
+        "tag:",
+        "sku:\"\"",
+        "-",
+        '"never closed',
+        "price>one",
+        "price>=",
+        "price<1.5",
+    ],
+)
+def test_invalid_queries_raise_value_error(products, query):
+    with pytest.raises(ValueError):
+        search(products, query)
+
+
+def test_shop_error_is_the_invalid_query_error_type(products):
+    with pytest.raises(ShopError):
+        search(products, "name:")
+
+
+def test_quoted_text_keeps_punctuation_literal(products):
+    product = Product("SKU", "The tag:sale price>5 item", 100, [])
+    assert search([product], '"tag:sale"') == [product]
+    assert search([product], '"price>5"') == [product]
