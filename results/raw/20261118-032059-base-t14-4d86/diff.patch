@@ -1,6 +1,62 @@
 """Revenue per store day. See docs/store-days.md."""
 
+from datetime import date, datetime, timedelta, timezone
+import re
+
+from shoplib.errors import ShopError
+
+
+_ZONE_SUFFIX = re.compile(r"(?:Z|[+-]\d{2}:\d{2})$")
+
 
 def daily_revenue(sales: list[dict], utc_offset_hours: int = 8, day_starts_hour: int = 4) -> list[tuple[str, int]]:
     """Revenue per store day. See docs/store-days.md."""
-    raise NotImplementedError
+    if (
+        not isinstance(utc_offset_hours, int)
+        or isinstance(utc_offset_hours, bool)
+        or not -23 <= utc_offset_hours <= 23
+    ):
+        raise ShopError("utc_offset_hours must be an integer from -23 to 23")
+    if not isinstance(day_starts_hour, int) or isinstance(day_starts_hour, bool) or not 0 <= day_starts_hour <= 23:
+        raise ShopError("day_starts_hour must be an integer from 0 to 23")
+
+    local_zone = timezone(timedelta(hours=utc_offset_hours))
+    totals: dict[date, int] = {}
+
+    for sale in sales:
+        if not isinstance(sale, dict) or "at" not in sale or "cents" not in sale:
+            raise ShopError("each sale must contain at and cents")
+
+        timestamp = sale["at"]
+        if not isinstance(timestamp, str) or not _ZONE_SUFFIX.search(timestamp):
+            raise ShopError("sale timestamp must include a time zone")
+        try:
+            instant = datetime.fromisoformat(timestamp[:-1] + "+00:00" if timestamp.endswith("Z") else timestamp)
+        except ValueError as exc:
+            raise ShopError("sale timestamp must be ISO 8601 with a time zone") from exc
+        if instant.utcoffset() is None:
+            raise ShopError("sale timestamp must include a time zone")
+
+        cents = sale["cents"]
+        if not isinstance(cents, int) or isinstance(cents, bool):
+            raise ShopError("sale cents must be an integer")
+
+        local = instant.astimezone(local_zone)
+        store_day = local.date()
+        if local.hour < day_starts_hour:
+            store_day -= timedelta(days=1)
+        totals[store_day] = totals.get(store_day, 0) + cents
+
+    if not totals:
+        return []
+
+    first_day = min(totals)
+    last_day = max(totals)
+    results = []
+    day = first_day
+    while True:
+        results.append((day.isoformat(), totals.get(day, 0)))
+        if day == last_day:
+            break
+        day += timedelta(days=1)
+    return results
diff --git a/tests/test_storedays.py b/tests/test_storedays.py
new file mode 100644
index 0000000..8fade2b
--- /dev/null
+++ b/tests/test_storedays.py
@@ -0,0 +1,44 @@
+import pytest
+
+from shoplib.errors import ShopError
+from shoplib.storedays import daily_revenue
+
+
+def test_daily_revenue_uses_local_store_day_boundary_and_fills_gaps():
+    sales = [
+        {"at": "2026-11-17T19:00:00Z", "cents": 300},  # 03:00 on Nov 18 local
+        {"at": "2026-11-17T20:00:00Z", "cents": 1200},  # 04:00 on Nov 18 local
+        {"at": "2026-11-17T22:30:00Z", "cents": -200},  # 06:30 on Nov 18 local
+        {"at": "2026-11-21T18:00:00Z", "cents": 500},  # 02:00 on Nov 22 local
+    ]
+
+    assert daily_revenue(sales) == [
+        ("2026-11-17", 300),
+        ("2026-11-18", 1000),
+        ("2026-11-19", 0),
+        ("2026-11-20", 0),
+        ("2026-11-21", 500),
+    ]
+
+
+def test_daily_revenue_assigns_pre_start_sale_to_previous_day():
+    sales = [{"at": "2026-11-18T02:30:00+08:00", "cents": 340}]
+
+    assert daily_revenue(sales) == [("2026-11-17", 340)]
+
+
+def test_daily_revenue_converts_sale_offset_to_store_local_time():
+    sales = [{"at": "2026-11-18T03:00:00+02:00", "cents": 75}]
+
+    assert daily_revenue(sales, utc_offset_hours=-5, day_starts_hour=0) == [
+        ("2026-11-17", 75)
+    ]
+
+
+def test_daily_revenue_empty_sales():
+    assert daily_revenue([]) == []
+
+
+def test_daily_revenue_rejects_timestamp_without_zone():
+    with pytest.raises(ShopError):
+        daily_revenue([{"at": "2026-11-18T02:30:00", "cents": 100}])
