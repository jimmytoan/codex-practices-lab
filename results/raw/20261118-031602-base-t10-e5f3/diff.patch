+def test_split_parcels_uses_first_fit_decreasing_and_sku_tie_breaking():
+    items = [("z", 5, 1), ("b", 5, 1), ("c", 4, 1), ("a", 6, 1), ("d", 4, 1)]
+
+    assert split_parcels(items, 10) == [["a", "c"], ["b", "z"], ["d"]]
+
+
+def test_split_parcels_empty_and_validates_units():
+    assert split_parcels([], 10) == []
+
+    for items, max_weight_g in (
+        ([('sku', 11, 1)], 10),
+        ([('sku', 0, 1)], 10),
+        ([('sku', 1, 0)], 10),
+        ([('sku', 1, 1)], 0),
+    ):
+        with pytest.raises(ValueError):
+            split_parcels(items, max_weight_g)
+
+
+def test_shipment_cost_sums_cost_for_packed_parcels():
+    assert shipment_cost([("heavy", 600, 1), ("light", 300, 1)], 1000) == 500
+    # A repeated SKU can represent units with different weights in the input.
+    assert shipment_cost([("same", 600, 1), ("same", 400, 1)], 700) == 1000
