diff --git a/tests/test_inventory.py b/tests/test_inventory.py
index 37436c0..25b1066 100644
--- a/tests/test_inventory.py
+++ b/tests/test_inventory.py
@@ -1,6 +1,7 @@
 import pytest
 
 from shoplib.inventory import Inventory
+from shoplib.errors import ShopError
 
 
 def test_reserve_and_ship():
@@ -18,3 +19,29 @@ def test_cannot_reserve_more_than_available():
     inv.receive("A", 2)
     with pytest.raises(ValueError):
         inv.reserve("A", 3)
+
+
+def test_release_returns_reserved_stock_to_available():
+    inv = Inventory()
+    inv.receive("A", 10)
+    inv.reserve("A", 4)
+
+    inv.release("A", 2)
+    assert (inv.on_hand("A"), inv.reserved("A"), inv.available("A")) == (10, 2, 8)
+
+    inv.release("A", 2)
+    assert (inv.on_hand("A"), inv.reserved("A"), inv.available("A")) == (10, 0, 10)
+
+
+@pytest.mark.parametrize("sku, qty", [("A", 0), ("A", -1), ("A", 3), ("B", 1), ("missing", 1)])
+def test_invalid_release_changes_nothing(sku, qty):
+    inv = Inventory()
+    inv.receive("A", 5)
+    inv.reserve("A", 2)
+    inv.receive("B", 3)
+    before = (inv._on_hand.copy(), inv._reserved.copy())
+
+    with pytest.raises(ShopError):
+        inv.release(sku, qty)
+
+    assert (inv._on_hand, inv._reserved) == before
