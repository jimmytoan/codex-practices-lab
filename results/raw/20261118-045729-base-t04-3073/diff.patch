diff --git a/src/shoplib/orders.py b/src/shoplib/orders.py
index 8edb164..56c4437 100644
--- a/src/shoplib/orders.py
+++ b/src/shoplib/orders.py
@@ -1,6 +1,7 @@
 """Orders and their life cycle. See docs/order-states.md."""
 
 from .inventory import Inventory
+from .errors import ShopError
 
 NEW = "NEW"
 PAID = "PAID"
@@ -46,3 +47,24 @@ class Order:
 
     def deliver(self) -> None:
         self._transition((SHIPPED,), DELIVERED)
+
+    def cancel(self) -> None:
+        """Cancel an unshipped order and release its reserved stock."""
+        if self.state == CANCELLED:
+            return
+        if self.state not in (NEW, PAID):
+            raise ShopError(f"cannot cancel an order in state {self.state}")
+
+        # Validate the full release before changing inventory, so a stale or
+        # inconsistent reservation cannot leave a partially cancelled order.
+        for sku, qty in self.lines.items():
+            if qty <= 0 or qty > self.inventory.reserved(sku):
+                raise ShopError(f"cannot release {qty} of {sku}")
+
+        for sku, qty in self.lines.items():
+            self.inventory.release(sku, qty)
+
+        was_paid = self.state == PAID
+        self.state = CANCELLED
+        if was_paid:
+            self.refund_due = True
diff --git a/tests/test_inventory.py b/tests/test_inventory.py
index 37436c0..8070b4a 100644
--- a/tests/test_inventory.py
+++ b/tests/test_inventory.py
@@ -18,3 +18,25 @@ def test_cannot_reserve_more_than_available():
     inv.receive("A", 2)
     with pytest.raises(ValueError):
         inv.reserve("A", 3)
+
+
+def test_release_returns_reserved_units_to_available():
+    inv = Inventory()
+    inv.receive("A", 10)
+    inv.reserve("A", 4)
+    inv.release("A", 3)
+    assert inv.on_hand("A") == 10
+    assert inv.reserved("A") == 1
+    assert inv.available("A") == 9
+
+
+@pytest.mark.parametrize("qty", [0, -1, 3])
+def test_invalid_release_leaves_inventory_unchanged(qty):
+    inv = Inventory()
+    inv.receive("A", 2)
+    inv.reserve("A", 2)
+    with pytest.raises(ValueError):
+        inv.release("A", qty)
+    assert inv.on_hand("A") == 2
+    assert inv.reserved("A") == 2
+    assert inv.available("A") == 0
diff --git a/tests/test_orders.py b/tests/test_orders.py
index d3835d1..c3cb75e 100644
--- a/tests/test_orders.py
+++ b/tests/test_orders.py
@@ -1,7 +1,7 @@
 import pytest
 
 from shoplib.inventory import Inventory
-from shoplib.orders import DELIVERED, NEW, Order
+from shoplib.orders import CANCELLED, DELIVERED, NEW, PAID, SHIPPED, Order
 
 
 def make():
@@ -25,3 +25,59 @@ def test_cannot_ship_unpaid():
     _, order = make()
     with pytest.raises(ValueError):
         order.ship()
+
+
+def test_cancel_new_order_releases_stock_without_refund():
+    inv, order = make()
+    order.cancel()
+    assert order.state == CANCELLED
+    assert order.refund_due is False
+    assert inv.reserved("A") == 0
+    assert inv.available("A") == 5
+
+
+def test_cancel_paid_order_releases_stock_and_marks_refund_due():
+    inv, order = make()
+    order.pay()
+    order.cancel()
+    assert order.state == CANCELLED
+    assert order.refund_due is True
+    assert inv.reserved("A") == 0
+    assert inv.available("A") == 5
+
+
+def test_cancelling_cancelled_order_is_idempotent():
+    inv, order = make()
+    order.cancel()
+    order.cancel()
+    assert order.state == CANCELLED
+    assert inv.reserved("A") == 0
+    assert inv.available("A") == 5
+
+
+@pytest.mark.parametrize("terminal_state", [SHIPPED, DELIVERED])
+def test_cannot_cancel_shipped_or_delivered_order(terminal_state):
+    inv, order = make()
+    order.pay()
+    order.ship()
+    if terminal_state == DELIVERED:
+        order.deliver()
+    before = (order.state, order.refund_due, inv.on_hand("A"), inv.reserved("A"))
+    with pytest.raises(ValueError):
+        order.cancel()
+    assert (order.state, order.refund_due, inv.on_hand("A"), inv.reserved("A")) == before
+
+
+def test_cancel_prechecks_all_lines_before_releasing_stock():
+    inv = Inventory()
+    inv.receive("A", 5)
+    inv.receive("B", 5)
+    order = Order("o2", {"A": 2, "B": 2}, inv)
+    # Simulate a stale reservation: cancellation must not release line A first.
+    inv.release("B", 1)
+    with pytest.raises(ValueError):
+        order.cancel()
+    assert order.state == NEW
+    assert order.refund_due is False
+    assert inv.reserved("A") == 2
+    assert inv.reserved("B") == 1
