diff --git a/src/shoplib/invoice.py b/src/shoplib/invoice.py
index 5d1398c..fc86569 100644
--- a/src/shoplib/invoice.py
+++ b/src/shoplib/invoice.py
@@ -1,5 +1,8 @@
 """Invoices: coupon allocation and tax. See docs/invoicing.md."""
 
+from shoplib.errors import ShopError
+from shoplib.money import percent_of
+
 # Tax rates in percent, by region and product category.
 TAX_RATES = {
     "DE": {"standard": 19, "food": 7, "books": 7},
@@ -10,4 +13,66 @@ TAX_RATES = {
 
 def build_invoice(lines, coupon_cents: int, shipping_cents: int, region: str) -> dict:
     """Build an invoice for an order. See docs/invoicing.md."""
-    raise NotImplementedError
+    if region not in TAX_RATES:
+        raise ShopError(f"unknown region: {region}")
+    if not isinstance(coupon_cents, int) or coupon_cents < 0:
+        raise ShopError("coupon must be a non-negative integer amount")
+    if not isinstance(shipping_cents, int) or shipping_cents < 0:
+        raise ShopError("shipping must be a non-negative integer amount")
+    try:
+        lines = list(lines)
+    except TypeError as exc:
+        raise ShopError("lines must be iterable") from exc
+    if not lines:
+        raise ShopError("lines must not be empty")
+
+    rates = TAX_RATES[region]
+    prepared = []
+    for line in lines:
+        try:
+            sku, unit_price_cents, qty, category = line
+        except (TypeError, ValueError) as exc:
+            raise ShopError("each line must contain sku, price, quantity and category") from exc
+        if category not in rates:
+            raise ShopError(f"unknown category: {category}")
+        if not isinstance(unit_price_cents, int) or unit_price_cents < 0:
+            raise ShopError("price must be a non-negative integer amount")
+        if not isinstance(qty, int) or qty < 1:
+            raise ShopError("quantity must be an integer of at least 1")
+        prepared.append((sku, unit_price_cents * qty, rates[category]))
+
+    total_gross = sum(gross for _, gross, _ in prepared)
+    coupon = min(coupon_cents, total_gross)
+    discounts = [0] * len(prepared)
+    if total_gross:
+        remainders = []
+        allocated = 0
+        for i, (_, gross, _) in enumerate(prepared):
+            discounts[i], remainder = divmod(coupon * gross, total_gross)
+            allocated += discounts[i]
+            remainders.append((remainder, i))
+        for _, i in sorted(remainders, key=lambda item: (-item[0], item[1]))[:coupon - allocated]:
+            discounts[i] += 1
+
+    invoice_lines = []
+    for (sku, gross, rate), discount in zip(prepared, discounts):
+        net = gross - discount
+        invoice_lines.append({
+            "sku": sku,
+            "gross_cents": gross,
+            "discount_cents": discount,
+            "net_cents": net,
+            "tax_cents": percent_of(net, rate),
+        })
+
+    shipping_tax = percent_of(shipping_cents, rates["standard"]) if any(
+        rate > 0 for _, _, rate in prepared
+    ) else 0
+    total = (sum(line["net_cents"] + line["tax_cents"] for line in invoice_lines)
+             + shipping_cents + shipping_tax)
+    return {
+        "lines": invoice_lines,
+        "shipping_cents": shipping_cents,
+        "shipping_tax_cents": shipping_tax,
+        "total_cents": total,
+    }
diff --git a/tests/test_invoice.py b/tests/test_invoice.py
new file mode 100644
index 0000000..0463398
--- /dev/null
+++ b/tests/test_invoice.py
@@ -0,0 +1,50 @@
+import pytest
+
+from shoplib.invoice import build_invoice
+
+
+def test_coupon_is_split_by_largest_remainder_and_ties_follow_input_order():
+    invoice = build_invoice(
+        [("a", 1, 1, "books"), ("b", 1, 1, "books"), ("c", 1, 1, "books")],
+        2, 0, "SG",
+    )
+    assert [line["discount_cents"] for line in invoice["lines"]] == [1, 1, 0]
+    assert [line["net_cents"] for line in invoice["lines"]] == [0, 0, 1]
+
+
+def test_coupon_capped_zero_gross_and_per_line_tax_and_shipping_tax():
+    invoice = build_invoice(
+        [("food", 1, 1, "food"), ("book", 1, 1, "books")],
+        99, 101, "SG",
+    )
+    assert [line["discount_cents"] for line in invoice["lines"]] == [1, 1]
+    assert [line["tax_cents"] for line in invoice["lines"]] == [0, 0]
+    assert invoice["shipping_tax_cents"] == 9
+    assert invoice["total_cents"] == 110
+
+    zero = build_invoice([("free", 0, 1, "food")], 10, 25, "DE")
+    assert zero["lines"][0]["discount_cents"] == 0
+    assert zero["shipping_tax_cents"] == 5
+
+
+def test_no_shipping_tax_when_all_line_rates_are_zero():
+    invoice = build_invoice([("book", 1000, 1, "books")], 0, 500, "SG")
+    assert invoice["shipping_tax_cents"] == 0
+    assert invoice["total_cents"] == 1500
+
+
+@pytest.mark.parametrize(
+    "lines,coupon,shipping,region",
+    [
+        ([("x", 1, 1, "books")], 0, 0, "XX"),
+        ([("x", 1, 1, "nope")], 0, 0, "SG"),
+        ([], 0, 0, "SG"),
+        ([("x", 1, 0, "books")], 0, 0, "SG"),
+        ([("x", -1, 1, "books")], 0, 0, "SG"),
+        ([("x", 1, 1, "books")], -1, 0, "SG"),
+        ([("x", 1, 1, "books")], 0, -1, "SG"),
+    ],
+)
+def test_invalid_invoice_inputs_raise_value_error(lines, coupon, shipping, region):
+    with pytest.raises(ValueError):
+        build_invoice(lines, coupon, shipping, region)
