+def test_split_first_fit_decreasing_and_ties():
+    items = [("z", 4, 1), ("b", 6, 2), ("a", 6, 1), ("c", 4, 2)]
+    assert split_parcels(items, 10) == [["a", "c"], ["b", "c"], ["b", "z"]]
+
+
+def test_split_first_fit_uses_earlier_open_parcel():
+    assert split_parcels([("a", 8, 1), ("b", 7, 1), ("c", 3, 1), ("d", 2, 1)], 10) == [
+        ["a", "d"], ["b", "c"]
+    ]
+
+
+@pytest.mark.parametrize("items, limit", [
+    ([("a", 0, 1)], 10),
+    ([("a", -1, 1)], 10),
+    ([("a", 1, 0)], 10),
+    ([("a", 1, -1)], 10),
+    ([("a", 11, 1)], 10),
+    ([("a", 1, 1)], 0),
+])
+def test_invalid_items(items, limit):
+    with pytest.raises(ShopError):
+        split_parcels(items, limit)
+    with pytest.raises(ShopError):
+        shipment_cost(items, limit)
+
+
+def test_empty_order():
+    assert split_parcels([], 0) == []
+    assert shipment_cost([], 0) == 0
+
+
+def test_shipment_cost_duplicate_sku_with_different_weights():
+    items = [("x", 900, 1), ("x", 600, 1), ("x", 300, 1)]
+    assert split_parcels(items, 1200) == [["x", "x"], ["x"]]
+    assert shipment_cost(items, 1200) == shipping_cost(1200) + shipping_cost(600)
+
