diff --git a/tests/test_inventory.py b/tests/test_inventory.py
index 37436c0..6dd6669 100644
--- a/tests/test_inventory.py
+++ b/tests/test_inventory.py
@@ -18,3 +18,31 @@ def test_cannot_reserve_more_than_available():
     inv.receive("A", 2)
     with pytest.raises(ValueError):
         inv.reserve("A", 3)
+
+
+def test_release_partial_and_remaining_reservation():
+    inv = Inventory()
+    inv.receive("A", 10)
+    inv.reserve("A", 4)
+    inv.receive("B", 5)
+    inv.reserve("B", 2)
+
+    inv.release("A", 1)
+    assert (inv.on_hand("A"), inv.reserved("A"), inv.available("A")) == (10, 3, 7)
+    inv.release("A", 3)
+    assert (inv.on_hand("A"), inv.reserved("A"), inv.available("A")) == (10, 0, 10)
+    assert (inv.on_hand("B"), inv.reserved("B"), inv.available("B")) == (5, 2, 3)
+
+
+@pytest.mark.parametrize("sku, qty", [("A", 0), ("A", -1), ("A", 4), ("B", 1), ("unknown", 1)])
+def test_invalid_release_changes_nothing(sku, qty):
+    inv = Inventory()
+    inv.receive("A", 10)
+    inv.reserve("A", 3)
+    inv.receive("B", 5)
+    before = (inv._on_hand.copy(), inv._reserved.copy())
+
+    with pytest.raises(ValueError):
+        inv.release(sku, qty)
+
+    assert (inv._on_hand, inv._reserved) == before
