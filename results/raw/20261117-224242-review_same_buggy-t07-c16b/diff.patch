+from datetime import date
+
+import pytest
+
+from shoplib.discounts import Coupon, apply_coupon, apply_coupons
+from shoplib.errors import ShopError
 
 
 def test_percent():
@@ -7,3 +12,50 @@ def test_percent():
 
 def test_fixed_never_negative():
     assert apply_coupon(300, Coupon("FIVE", "fixed", 500)) == 0
+
+
+def test_coupons_include_expiry_date_and_check_original_subtotal():
+    today = date(2026, 1, 10)
+    coupons = [
+        Coupon("EXPIRES_TODAY", "percent", 10, expires=today),
+        Coupon("MINIMUM", "fixed", 100, min_subtotal_cents=1000),
+        Coupon("EXPIRED", "fixed", 200, expires=date(2026, 1, 9)),
+        Coupon("TOO_HIGH", "fixed", 300, min_subtotal_cents=1001),
+    ]
+    assert apply_coupons(1000, coupons, today) == (800, ["EXPIRES_TODAY", "MINIMUM"])
+
+
+def test_coupons_choose_highest_percent_with_code_tiebreak():
+    coupons = [
+        Coupon("Z", "percent", 20),
+        Coupon("LOW", "percent", 10),
+        Coupon("A", "percent", 20),
+    ]
+    assert apply_coupons(1000, coupons, date(2026, 1, 10)) == (800, ["A"])
+
+
+def test_coupons_round_percent_first_and_sort_all_fixed_codes():
+    coupons = [
+        Coupon("Z_FIXED", "fixed", 1),
+        Coupon("PERCENT", "percent", 50),
+        Coupon("A_FIXED", "fixed", 1),
+    ]
+    assert apply_coupons(7, coupons, date(2026, 1, 10)) == (
+        1, ["A_FIXED", "PERCENT", "Z_FIXED"]
+    )
+
+
+def test_coupons_total_never_negative_and_all_codes_are_reported():
+    coupons = [Coupon("A", "fixed", 500), Coupon("B", "fixed", 500)]
+    assert apply_coupons(100, coupons, date(2026, 1, 10)) == (0, ["A", "B"])
+    assert apply_coupons(100, [], date(2026, 1, 10)) == (100, [])
+
+
+def test_coupons_reject_negative_subtotal():
+    with pytest.raises(ShopError):
+        apply_coupons(-1, [], date(2026, 1, 10))
+
+
+def test_coupons_reject_unknown_kind():
+    with pytest.raises(ShopError):
+        apply_coupons(100, [Coupon("BAD", "unknown", 10)], date(2026, 1, 10))
