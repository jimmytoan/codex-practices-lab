diff --git a/tests/test_dates.py b/tests/test_dates.py
index fbfd5f2..b9c42e7 100644
--- a/tests/test_dates.py
+++ b/tests/test_dates.py
@@ -1,5 +1,7 @@
 from datetime import date
 
+import pytest
+
 from shoplib.dates import add_business_days, is_business_day
 
 
@@ -12,3 +14,33 @@ def test_forward_over_weekend():
     # Friday + 1 business day = Monday
     assert add_business_days(date(2026, 11, 13), 1) == date(2026, 11, 16)
     assert add_business_days(date(2026, 11, 16), 3) == date(2026, 11, 19)
+
+
+@pytest.mark.parametrize(
+    ("start", "n", "expected"),
+    [
+        (date(2026, 11, 13), 1, date(2026, 11, 18)),
+        (date(2026, 11, 13), 2, date(2026, 11, 19)),
+        (date(2026, 11, 15), 1, date(2026, 11, 18)),
+        (date(2026, 11, 18), -1, date(2026, 11, 13)),
+        (date(2026, 11, 18), -2, date(2026, 11, 12)),
+        (date(2026, 11, 15), -1, date(2026, 11, 13)),
+        (date(2026, 11, 13), 0, date(2026, 11, 13)),
+        (date(2026, 11, 14), 0, date(2026, 11, 18)),
+        (date(2026, 11, 16), 0, date(2026, 11, 18)),
+    ],
+)
+def test_business_days_with_holidays(start, n, expected):
+    holidays = (date(2026, 11, 16), date(2026, 11, 17))
+    assert add_business_days(start, n, holidays) == expected
+
+
+def test_business_days_with_holiday_iterator():
+    holidays = iter([date(2026, 11, 16), date(2026, 11, 17)])
+    assert add_business_days(date(2026, 11, 13), 1, holidays) == date(2026, 11, 18)
+
+
+def test_business_days_across_year_boundary():
+    holidays = (date(2027, 1, 1),)
+    assert add_business_days(date(2026, 12, 31), 1, holidays) == date(2027, 1, 4)
+    assert add_business_days(date(2027, 1, 4), -1, holidays) == date(2026, 12, 31)
