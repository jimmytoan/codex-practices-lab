diff --git a/tests/test_dates.py b/tests/test_dates.py
index fbfd5f2..5871a24 100644
--- a/tests/test_dates.py
+++ b/tests/test_dates.py
@@ -12,3 +12,21 @@ def test_forward_over_weekend():
     # Friday + 1 business day = Monday
     assert add_business_days(date(2026, 11, 13), 1) == date(2026, 11, 16)
     assert add_business_days(date(2026, 11, 16), 3) == date(2026, 11, 19)
+
+
+def test_forward_skips_holidays():
+    holiday = date(2026, 11, 17)
+    assert add_business_days(date(2026, 11, 16), 1, [holiday]) == date(2026, 11, 18)
+
+
+def test_negative_moves_strictly_before_start():
+    holiday = date(2026, 11, 13)
+    assert add_business_days(date(2026, 11, 16), -1, [holiday]) == date(2026, 11, 12)
+    assert add_business_days(date(2026, 11, 14), -1) == date(2026, 11, 13)
+
+
+def test_zero_returns_start_or_first_business_day_after():
+    holiday = date(2026, 11, 16)
+    assert add_business_days(date(2026, 11, 17), 0) == date(2026, 11, 17)
+    assert add_business_days(date(2026, 11, 15), 0) == date(2026, 11, 16)
+    assert add_business_days(date(2026, 11, 16), 0, [holiday]) == date(2026, 11, 17)
