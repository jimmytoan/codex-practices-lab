+++ b/tests/test_costing.py
@@ -0,0 +1,105 @@
+from copy import deepcopy
+from decimal import localcontext
+
+import pytest
+
+from shoplib.costing import fifo_costing
+from shoplib.errors import ShopError
+
+
+def test_fifo_returns_are_new_lots_and_skus_are_independent():
+    events = [
+        {"type": "receive", "sku": "A", "qty": 1, "unit_cost_cents": 100},
+        {"type": "receive", "sku": "A", "qty": 2, "unit_cost_cents": 200},
+        {"type": "receive", "sku": "B", "qty": 3, "unit_cost_cents": 7},
+        {"type": "sell", "sku": "A", "qty": 2},
+        {"type": "sell", "sku": "B", "qty": 1},
+        {"type": "return", "sku": "A", "qty": 1},
+        {"type": "receive", "sku": "A", "qty": 1, "unit_cost_cents": 300},
+        {"type": "sell", "sku": "A", "qty": 2},
+    ]
+    original = deepcopy(events)
+    assert fifo_costing(events) == {
+        "A": {"cogs_cents": 500, "on_hand": 1, "value_cents": 300},
+        "B": {"cogs_cents": 7, "on_hand": 2, "value_cents": 14},
+    }
+    assert events == original
+
+
+def test_multiple_returns_round_half_up_and_can_make_cogs_negative():
+    events = [
+        {"type": "receive", "sku": "A", "qty": 1, "unit_cost_cents": 0},
+        {"type": "receive", "sku": "A", "qty": 1, "unit_cost_cents": 1},
+        {"type": "sell", "sku": "A", "qty": 2},
+        {"type": "return", "sku": "A", "qty": 1},
+        {"type": "return", "sku": "A", "qty": 1},
+    ]
+    assert fifo_costing(events) == {
+        "A": {"cogs_cents": -1, "on_hand": 2, "value_cents": 2}
+    }
+
+
+def test_empty_events_and_zero_cost_stock():
+    assert fifo_costing([]) == {}
+    assert fifo_costing([
+        {"type": "receive", "sku": "A", "qty": 2, "unit_cost_cents": 0},
+        {"type": "sell", "sku": "A", "qty": 2},
+    ]) == {"A": {"cogs_cents": 0, "on_hand": 0, "value_cents": 0}}
+
+
+@pytest.mark.parametrize("events", [
+    [{"type": "receive", "sku": "A", "qty": 0, "unit_cost_cents": 1}],
+    [{"type": "sell", "sku": "A", "qty": -1}],
+    [{"type": "return", "sku": "A", "qty": 0}],
+    [{"type": "receive", "sku": "A", "qty": 1, "unit_cost_cents": -1}],
+    [{"type": "sell", "sku": "A", "qty": 1}],
+    [{"type": "return", "sku": "A", "qty": 1}],
+    [{"type": "unknown", "sku": "A", "qty": 1}],
+    [
+        {"type": "receive", "sku": "A", "qty": 2, "unit_cost_cents": 1},
+        {"type": "sell", "sku": "A", "qty": 2},
+        {"type": "return", "sku": "A", "qty": 1},
+        {"type": "return", "sku": "A", "qty": 2},
+    ],
+    [
+        {"type": "receive", "sku": "A", "qty": 3, "unit_cost_cents": 1},
+        {"type": "sell", "sku": "A", "qty": 2},
+        {"type": "sell", "sku": "A", "qty": 1},
+        {"type": "return", "sku": "A", "qty": 2},
+    ],
+    [
+        {"type": "receive", "sku": "A", "qty": 1, "unit_cost_cents": 1},
+        {"type": "sell", "sku": "A", "qty": 1},
+        {"type": "return", "sku": "B", "qty": 1},
+    ],
+])
+def test_errors_are_shop_errors_and_do_not_modify_events(events):
+    original = deepcopy(events)
+    with pytest.raises(ShopError):
+        fifo_costing(events)
+    assert events == original
+
+
+def test_return_average_just_below_half_a_cent():
+    qty = 10**30
+    cost = qty // 2 - 1
+    events = [
+        {"type": "receive", "sku": "A", "qty": cost, "unit_cost_cents": 1},
+        {"type": "receive", "sku": "A", "qty": qty - cost, "unit_cost_cents": 0},
+        {"type": "sell", "sku": "A", "qty": qty},
+        {"type": "return", "sku": "A", "qty": 1},
+    ]
+    with localcontext() as context:
+        context.prec = 6
+        assert fifo_costing(events) == {
+            "A": {"cogs_cents": cost, "on_hand": 1, "value_cents": 0}
+        }
+
+
+def test_return_large_unit_cost():
+    cost = 10**40
+    assert fifo_costing([
+        {"type": "receive", "sku": "A", "qty": 1, "unit_cost_cents": cost},
+        {"type": "sell", "sku": "A", "qty": 1},
+        {"type": "return", "sku": "A", "qty": 1},
+    ]) == {"A": {"cogs_cents": 0, "on_hand": 1, "value_cents": cost}}
