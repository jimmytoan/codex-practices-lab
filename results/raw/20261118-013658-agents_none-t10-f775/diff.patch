 def test_tiers():
@@ -15,3 +15,51 @@ def test_invalid_weight():
         shipping_cost(0)
     with pytest.raises(ValueError):
         shipping_cost(25000)
+
+
+def test_split_parcels_first_fit_and_unit_order():
+    items = [("z", 4, 1), ("b", 6, 1), ("a", 6, 1), ("c", 3, 2)]
+    assert split_parcels(items, 10) == [["a", "z"], ["b", "c"], ["c"]]
+
+
+@pytest.mark.parametrize("items, max_weight", [
+    ([("a", 11, 1)], 10),
+    ([("a", 0, 1)], 10),
+    ([("a", -1, 1)], 10),
+    ([("a", 1, 0)], 10),
+    ([("a", 1, -1)], 10),
+    ([("a", 1, 1)], 0),
+])
+def test_split_parcels_invalid_items(items, max_weight):
+    with pytest.raises(ValueError):
+        split_parcels(items, max_weight)
+    with pytest.raises(ValueError):
+        shipment_cost(items, max_weight)
+
+
+def test_empty_order():
+    assert split_parcels([], 0) == []
+    assert shipment_cost([], 0) == 0
+
+
+def test_shipment_cost_uses_parcel_weights_with_repeated_skus(monkeypatch):
+    weights = []
+
+    def record_weight(weight):
+        weights.append(weight)
+        return weight
+
+    monkeypatch.setattr("shoplib.shipping.shipping_cost", record_weight)
+    items = [("x", 600, 1), ("x", 400, 1), ("a", 600, 1)]
+    assert shipment_cost(items, 1000) == 1600
+    assert weights == [1000, 600]
+
+
+def test_shipment_cost_sums_shipping_costs():
+    items = [("a", 900, 2), ("b", 400, 1)]
+    assert shipment_cost(items, 1300) == shipping_cost(1300) + shipping_cost(900)
+
+
+def test_shipment_cost_propagates_shipping_cost_error():
+    with pytest.raises(ValueError):
+        shipment_cost([("a", 21000, 1)], 21000)
