@@ -0,0 +1,43 @@
+import pytest
+
+from shoplib.errors import ShopError
+from shoplib.storedays import daily_revenue
+
+
+def test_boundaries_offsets_refunds_and_gaps():
+    sales = [
+        {"at": "2026-11-18T02:30:00+08:00", "cents": 100},
+        {"at": "2026-11-17T20:00:00Z", "cents": 200},
+        {"at": "2026-11-18T04:00:00+08:00", "cents": -50},
+        {"at": "2026-11-21T00:00:00-04:00", "cents": 75},
+    ]
+    assert daily_revenue(sales) == [
+        ("2026-11-17", 100),
+        ("2026-11-18", 150),
+        ("2026-11-19", 0),
+        ("2026-11-20", 0),
+        ("2026-11-21", 75),
+    ]
+
+
+def test_custom_timezone_and_start_across_year():
+    sales = [
+        {"at": "2027-01-01T04:59:59Z", "cents": 1},
+        {"at": "2027-01-01T05:00:00Z", "cents": 2},
+    ]
+    assert daily_revenue(sales, utc_offset_hours=-5, day_starts_hour=0) == [
+        ("2026-12-31", 1), ("2027-01-01", 2)
+    ]
+    assert daily_revenue([]) == []
+
+
+@pytest.mark.parametrize("timestamp", ["2026-11-18T02:30:00", "invalidZ", "2026-11-18+08:00"])
+def test_invalid_timestamp_raises_shop_error(timestamp):
+    with pytest.raises(ShopError):
+        daily_revenue([{"at": timestamp, "cents": 1}])
+
+
+@pytest.mark.parametrize("kwargs", [{"utc_offset_hours": 24}, {"day_starts_hour": 24}])
+def test_invalid_configuration(kwargs):
+    with pytest.raises(ShopError):
+        daily_revenue([], **kwargs)
