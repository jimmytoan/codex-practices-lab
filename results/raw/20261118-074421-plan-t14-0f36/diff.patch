+++ b/tests/test_storedays.py
@@ -0,0 +1,53 @@
+import pytest
+
+from shoplib.errors import ShopError
+from shoplib.storedays import daily_revenue
+
+
+def test_empty_sales_returns_no_days():
+    assert daily_revenue([]) == []
+
+
+def test_sales_at_day_start_belong_to_new_store_day():
+    sales = [
+        {"at": "2026-11-17T20:00:00Z", "cents": 100},
+        {"at": "2026-11-18T18:30:00Z", "cents": -30},
+    ]
+
+    assert daily_revenue(sales) == [("2026-11-18", 70)]
+
+
+def test_early_local_sale_belongs_to_previous_store_day():
+    sales = [{"at": "2026-11-18T02:30:00+08:00", "cents": 425}]
+
+    assert daily_revenue(sales) == [("2026-11-17", 425)]
+
+
+def test_local_time_uses_configured_utc_offset_and_day_start():
+    sales = [{"at": "2026-11-18T02:00:00Z", "cents": 500}]
+
+    assert daily_revenue(sales, utc_offset_hours=-2, day_starts_hour=0) == [("2026-11-18", 500)]
+
+
+def test_days_without_sales_are_filled_with_zero():
+    sales = [
+        {"at": "2026-11-16T20:00:00Z", "cents": 100},
+        {"at": "2026-11-18T20:00:00Z", "cents": 250},
+    ]
+
+    assert daily_revenue(sales) == [
+        ("2026-11-17", 100),
+        ("2026-11-18", 0),
+        ("2026-11-19", 250),
+    ]
+
+
+@pytest.mark.parametrize("timestamp", ["2026-11-18T02:30:00", "2026-11-18T02:30:00+0800"])
+def test_timestamp_without_supported_explicit_zone_raises(timestamp):
+    with pytest.raises(ShopError):
+        daily_revenue([{"at": timestamp, "cents": 100}])
+
+
+def test_invalid_day_start_raises_shop_error():
+    with pytest.raises(ShopError):
+        daily_revenue([], day_starts_hour=24)
