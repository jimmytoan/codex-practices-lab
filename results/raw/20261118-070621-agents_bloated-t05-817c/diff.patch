--- a/tests/test_reports.py
+++ b/tests/test_reports.py
@@ -1,3 +1,6 @@
+import csv
+from io import StringIO
+
 from shoplib.reports import sales_summary, to_csv
 
 SALES = [
@@ -16,3 +19,15 @@ def test_summary():
 
 def test_csv():
     assert to_csv(sales_summary(SALES)) == "sku,name,units,revenue_cents\nA,Mug,3,1350\nB,Bowl,1,900\n"
+
+
+def test_csv_quotes_fields_with_csv_special_characters():
+    rows = [{"sku": "A,1", "name": 'Tea "green"\nleaf', "units": 1, "revenue_cents": 250}]
+
+    rendered = to_csv(rows)
+
+    assert rendered == 'sku,name,units,revenue_cents\n"A,1","Tea ""green""\nleaf",1,250\n'
+    assert list(csv.reader(StringIO(rendered))) == [
+        ["sku", "name", "units", "revenue_cents"],
+        ["A,1", 'Tea "green"\nleaf', "1", "250"],
+    ]
