diff --git a/src/shoplib/reports.py b/src/shoplib/reports.py
index d024fdc..afa5a61 100644
--- a/src/shoplib/reports.py
+++ b/src/shoplib/reports.py
@@ -23,5 +23,12 @@ def to_csv(rows: list[dict]) -> str:
     """Render summary rows as CSV, following docs/CONVENTIONS.md."""
     lines = [",".join(COLUMNS)]
     for row in rows:
-        lines.append(",".join(str(row[col]) for col in COLUMNS))
+        lines.append(",".join(_csv_field(row[col]) for col in COLUMNS))
     return "\n".join(lines) + "\n"
+
+
+def _csv_field(value: object) -> str:
+    text = str(value)
+    if any(character in text for character in ',"\r\n'):
+        return '"' + text.replace('"', '""') + '"'
+    return text
