 def test_percent():
@@ -7,3 +12,50 @@ def test_percent():
 
 def test_fixed_never_negative():
     assert apply_coupon(300, Coupon("FIVE", "fixed", 500)) == 0
+
+
+def test_apply_coupons_selects_highest_percent_and_combines_fixed():
+    today = date(2026, 1, 1)
+    coupons = [
+        Coupon("Z-TEN", "percent", 10),
+        Coupon("A-TEN", "percent", 10, expires=today),
+        Coupon("FIVE", "percent", 5),
+        Coupon("FIXED-B", "fixed", 200, min_subtotal_cents=1000),
+        Coupon("FIXED-A", "fixed", 100, min_subtotal_cents=1001),
+        Coupon("EXPIRED", "fixed", 500, expires=today - timedelta(days=1)),
+        Coupon("TOO-HIGH-MINIMUM", "fixed", 500, min_subtotal_cents=1002),
+    ]
+
+    assert apply_coupons(1001, coupons, today) == (601, ["A-TEN", "FIXED-A", "FIXED-B"])
+
+
+def test_percent_is_calculated_from_original_subtotal_and_rounds_half_up():
+    assert apply_coupons(5, [Coupon("TEN", "percent", 10), Coupon("ONE", "fixed", 1)], date.today()) == (
+        3,
+        ["ONE", "TEN"],
+    )
+
+
+def test_apply_coupons_clamps_total_and_lists_all_applied_fixed_coupons():
+    coupons = [Coupon("A", "fixed", 200), Coupon("B", "fixed", 300)]
+
+    assert apply_coupons(100, coupons, date.today()) == (0, ["A", "B"])
+
+
+def test_apply_coupons_without_eligible_coupons_returns_original_subtotal():
+    today = date(2026, 1, 1)
+
+    assert apply_coupons(
+        100,
+        [Coupon("EXPIRED", "percent", 50, expires=today - timedelta(days=1)),
+         Coupon("MINIMUM", "fixed", 50, min_subtotal_cents=101)],
+        today,
+    ) == (100, [])
+
+
+def test_apply_coupons_rejects_negative_subtotal_and_unknown_kind():
+    with pytest.raises(ShopError):
+        apply_coupons(-1, [], date.today())
+
+    with pytest.raises(ShopError):
+        apply_coupons(100, [Coupon("UNKNOWN", "bogus", 10)], date.today())
