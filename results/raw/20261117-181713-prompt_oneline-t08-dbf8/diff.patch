diff --git a/src/shoplib/reports.py b/src/shoplib/reports.py
index d024fdc..cc7f2cd 100644
--- a/src/shoplib/reports.py
+++ b/src/shoplib/reports.py
@@ -1,5 +1,7 @@
 """Sales reports."""
 
+import json
+
 COLUMNS = ["sku", "name", "units", "revenue_cents"]
 
 
@@ -25,3 +27,8 @@ def to_csv(rows: list[dict]) -> str:
     for row in rows:
         lines.append(",".join(str(row[col]) for col in COLUMNS))
     return "\n".join(lines) + "\n"
+
+
+def to_json(rows: list[dict]) -> str:
+    """Render summary rows as JSON, following docs/CONVENTIONS.md."""
+    return json.dumps(rows, indent=2, sort_keys=True) + "\n"
diff --git a/tests/test_cli.py b/tests/test_cli.py
index 29a7ce0..4ad4009 100644
--- a/tests/test_cli.py
+++ b/tests/test_cli.py
@@ -8,3 +8,19 @@ def test_report_csv(tmp_path, capsys):
     path.write_text(json.dumps([{"sku": "A", "name": "Mug", "qty": 2, "unit_price_cents": 450}]))
     assert main(["report", str(path)]) == 0
     assert capsys.readouterr().out == "sku,name,units,revenue_cents\nA,Mug,2,900\n"
+
+
+def test_report_json(tmp_path, capsys):
+    path = tmp_path / "sales.json"
+    path.write_text(json.dumps([{"sku": "A", "name": "Mug", "qty": 2, "unit_price_cents": 450}]))
+    assert main(["report", str(path), "--format", "json"]) == 0
+    assert capsys.readouterr().out == (
+        '[\n'
+        '  {\n'
+        '    "name": "Mug",\n'
+        '    "revenue_cents": 900,\n'
+        '    "sku": "A",\n'
+        '    "units": 2\n'
+        '  }\n'
+        ']\n'
+    )
