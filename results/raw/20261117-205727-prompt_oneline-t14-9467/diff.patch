@@ -0,0 +1,64 @@
+import pytest
+
+from shoplib.errors import ShopError
+from shoplib.storedays import daily_revenue
+
+
+def test_default_day_boundary_refunds_and_gaps():
+    sales = [
+        {"at": "2026-11-20T04:00:00+08:00", "cents": 500},
+        {"at": "2026-11-17T18:30:00Z", "cents": 1000},
+        {"at": "2026-11-17T20:00:00Z", "cents": 300},
+        {"at": "2026-11-17T23:59:59-04:00", "cents": -100},
+    ]
+    assert daily_revenue(sales) == [
+        ("2026-11-17", 1000),
+        ("2026-11-18", 200),
+        ("2026-11-19", 0),
+        ("2026-11-20", 500),
+    ]
+
+
+def test_custom_offset_and_start_cross_year():
+    sales = [
+        {"at": "2027-01-01T04:59:59Z", "cents": 50},
+        {"at": "2027-01-01T05:00:00Z", "cents": 75},
+    ]
+    assert daily_revenue(sales, utc_offset_hours=-5, day_starts_hour=0) == [
+        ("2026-12-31", 50),
+        ("2027-01-01", 75),
+    ]
+
+
+def test_no_sales_and_date_maximum():
+    assert daily_revenue([]) == []
+    assert daily_revenue([{"at": "9999-12-31T04:00:00Z", "cents": 0}], 0) == [("9999-12-31", 0)]
+
+
+@pytest.mark.parametrize("timestamp", [
+    "2026-11-18T02:30:00",
+    "2026-11-18",
+    "2026-11-18+08:00",
+    "not a timestampZ",
+    "2026-11-18T02:30:00+0800",
+    "2026-11-18T02:30:00+24:00",
+])
+def test_invalid_timestamps_raise_shop_error(timestamp):
+    with pytest.raises(ShopError):
+        daily_revenue([{"at": timestamp, "cents": 100}])
+
+
+@pytest.mark.parametrize("sales, offset, start", [
+    (None, 8, 4),
+    ([{}], 8, 4),
+    ([{"at": "2026-11-18T02:30:00Z", "cents": 1.5}], 8, 4),
+    ([{"at": "2026-11-18T02:30:00Z", "cents": True}], 8, 4),
+    ([], 24, 4),
+    ([], -24, 4),
+    ([], 8.5, 4),
+    ([], 8, -1),
+    ([], 8, 24),
+])
+def test_invalid_arguments_raise_shop_error(sales, offset, start):
+    with pytest.raises(ShopError):
+        daily_revenue(sales, offset, start)
