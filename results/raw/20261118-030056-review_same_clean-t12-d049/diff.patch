@@ -0,0 +1,101 @@
+import pytest
+
+from shoplib.errors import ShopError
+from shoplib.search import Product, search
+
+
+@pytest.fixture
+def products():
+    return [
+        Product("MUG-RED", "Large Red Mug", 1500, ["Kitchen", "Sale"]),
+        Product("MUG-BLUE", "Small Blue Mug", 1000, ["Kitchen"]),
+        Product("PLATE", "Blue Plate", 500, ["Dining", "Sale"]),
+        Product("MUG-*STAR", "A mug: special", 0, ["a*b"]),
+    ]
+
+
+@pytest.mark.parametrize("query", ["", " \t\n"])
+def test_empty_query_preserves_order(products, query):
+    assert search(products, query) == products
+
+
+@pytest.mark.parametrize(
+    ("query", "indices"),
+    [
+        ("mUg", [0, 1, 3]),
+        ('"blue mug"', [1]),
+        ('name:"BLUE MUG"', [1]),
+        ('"mug: special"', [3]),
+        ('name:"mug: special"', [3]),
+        ("sku:mug-red", [0]),
+        ("tag:KITCHEN", [0, 1]),
+        ("sku:mug-*", [0, 1, 3]),
+        ("tag:kit*", [0, 1]),
+        ("sku:mug-*star", [3]),
+        ("tag:a*b", [3]),
+        ("tag:*", [0, 1, 2, 3]),
+        ("blue tag:sale", [2]),
+        ("tag:kitchen -sku:MUG-RED", [1]),
+        ('-"blue mug"', [0, 2, 3]),
+        ("-price>=1000", [2, 3]),
+        ("price<1000", [2, 3]),
+        ("price<=1000", [1, 2, 3]),
+        ("price>1000", [0]),
+        ("price>=1000", [0, 1]),
+        ("price=001000", [1]),
+    ],
+)
+def test_query_terms(products, query, indices):
+    assert search(products, query) == [products[i] for i in indices]
+
+
+def test_quotes_protect_a_whole_term_from_query_syntax():
+    products = [Product("a", "-tag:sale price>=5", 0), Product("b", "other", 5)]
+    assert search(products, '"-tag:sale"') == [products[0]]
+    assert search(products, '"price>=5"') == [products[0]]
+
+
+@pytest.mark.parametrize("query", ["straße", "name:STRASSE", "sku:STRASSE", "tag:STRASSE", "sku:STRAS*", "tag:STRAS*"])
+def test_unicode_case_insensitive_matching(query):
+    product = Product("Straße", "Straße", 1, ["Straße"])
+    assert search([product], query) == [product]
+
+
+@pytest.mark.parametrize(
+    "query",
+    [
+        '"unclosed',
+        'name:"unclosed',
+        "color:blue",
+        "price:5",
+        "tag:",
+        'name:""',
+        "sku:",
+        "-",
+        "price<",
+        "price>=-1",
+        "price=1.5",
+        "price=abc",
+        'price>="abc"',
+        'price<"=5"',
+        "-tag:",
+    ],
+)
+@pytest.mark.parametrize("with_product", [False, True])
+def test_invalid_queries_raise_shop_error(query, with_product):
+    products = [Product("x", "example", 1)] if with_product else []
+    with pytest.raises(ShopError):
+        search(products, query)
+
+
+def test_quoted_price_value_is_validated():
+    product = Product("a", "example", 1000)
+    assert search([product], 'price>="1000"') == [product]
+
+
+def test_price_comparison_accepts_arbitrarily_large_whole_numbers():
+    products = [Product("a", "example", 1)]
+    huge = "9" * 5000
+    assert search(products, "price<" + huge) == products
+    assert search(products, "price>" + huge) == []
+    assert search(products, "price=" + "0" * 5000 + "1") == products
