+from shoplib.discounts import Coupon, apply_coupon, apply_coupons
 
 
 def test_percent():
@@ -7,3 +11,65 @@ def test_percent():
 
 def test_fixed_never_negative():
     assert apply_coupon(300, Coupon("FIVE", "fixed", 500)) == 0
+
+
+def test_apply_coupons_uses_best_percent_and_all_eligible_fixed_coupons():
+    total, codes = apply_coupons(
+        1000,
+        [
+            Coupon("TEN", "percent", 10),
+            Coupon("TWENTY", "percent", 20),
+            Coupon("FIVE", "fixed", 500),
+            Coupon("ONE", "fixed", 100),
+        ],
+        date(2026, 1, 1),
+    )
+
+    assert total == 200
+    assert codes == ["FIVE", "ONE", "TWENTY"]
+
+
+def test_apply_coupons_breaks_percent_ties_by_code_and_sorts_codes():
+    total, codes = apply_coupons(
+        1000,
+        [
+            Coupon("ZED", "percent", 10),
+            Coupon("ALPHA", "percent", 10),
+            Coupon("BETA", "fixed", 50),
+        ],
+        date(2026, 1, 1),
+    )
+
+    assert total == 850
+    assert codes == ["ALPHA", "BETA"]
+
+
+def test_apply_coupons_uses_original_subtotal_for_eligibility_and_keeps_expiry_date_valid():
+    today = date(2026, 1, 1)
+    total, codes = apply_coupons(
+        1000,
+        [
+            Coupon("PERCENT", "percent", 50),
+            Coupon("TODAY", "fixed", 100, expires=today, min_subtotal_cents=1000),
+            Coupon("TOO_LATE", "fixed", 200, expires=date(2025, 12, 31)),
+            Coupon("MINIMUM", "fixed", 300, min_subtotal_cents=1001),
+        ],
+        today,
+    )
+
+    assert total == 400
+    assert codes == ["PERCENT", "TODAY"]
+
+
+def test_apply_coupons_rounds_percent_half_up_and_never_returns_negative():
+    assert apply_coupons(5, [Coupon("TEN", "percent", 10)], date(2026, 1, 1)) == (4, ["TEN"])
+    assert apply_coupons(
+        100,
+        [Coupon("HALF", "fixed", 60), Coupon("MORE", "fixed", 80)],
+        date(2026, 1, 1),
+    ) == (0, ["HALF", "MORE"])
+
+
+def test_apply_coupons_rejects_negative_subtotal():
