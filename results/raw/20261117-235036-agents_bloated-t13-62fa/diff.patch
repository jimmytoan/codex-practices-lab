@@ -1,6 +1,94 @@
 """Cost of goods sold with FIFO lots. See docs/costing.md."""
 
+from collections import deque
+from dataclasses import dataclass, field
+from decimal import Decimal, localcontext
+
+from shoplib.errors import ShopError
+from shoplib.money import round_cents
+
+
+@dataclass
+class _Stock:
+    lots: deque = field(default_factory=deque)
+    on_hand: int = 0
+    value_cents: int = 0
+    cogs_cents: int = 0
+    returnable: int = 0
+    return_cost_cents: int = 0
+    has_sale: bool = False
+
+    def receive(self, qty: int, unit_cost: int) -> None:
+        self.lots.append((qty, unit_cost))
+        self.on_hand += qty
+        self.value_cents += qty * unit_cost
+
+    def sell(self, qty: int) -> None:
+        if qty > self.on_hand:
+            raise ShopError("not enough stock to sell")
+
+        remaining = qty
+        cost = 0
+        while remaining:
+            lot_qty, unit_cost = self.lots.popleft()
+            taken = min(remaining, lot_qty)
+            cost += taken * unit_cost
+            remaining -= taken
+            if taken < lot_qty:
+                self.lots.appendleft((lot_qty - taken, unit_cost))
+
+        self.on_hand -= qty
+        self.value_cents -= cost
+        self.cogs_cents += cost
+        self.returnable = qty
+        self.return_cost_cents = _average_cost(cost, qty)
+        self.has_sale = True
+
+    def return_units(self, qty: int) -> None:
+        if not self.has_sale:
+            raise ShopError("no sale to return")
+        if qty > self.returnable:
+            raise ShopError("return exceeds latest sale")
+        self.receive(qty, self.return_cost_cents)
+        self.cogs_cents -= qty * self.return_cost_cents
+        self.returnable -= qty
+
+
+def _average_cost(cost: int, qty: int) -> int:
+    # Keep enough precision to distinguish fractions immediately below a half.
+    with localcontext() as context:
+        context.prec = max(context.prec, len(str(cost)) + len(str(qty)) + 2)
+        return round_cents(Decimal(cost) / Decimal(qty))
+
 
 def fifo_costing(events: list[dict]) -> dict:
     """Process stock events and report cost per SKU. See docs/costing.md."""
-    raise NotImplementedError
+    stock_by_sku: dict[str, _Stock] = {}
+    for event in events:
+        event_type = event["type"]
+        if event_type not in ("receive", "sell", "return"):
+            raise ShopError("unknown event type")
+        qty = event["qty"]
+        if not isinstance(qty, int) or isinstance(qty, bool) or qty < 1:
+            raise ShopError("qty must be a positive integer")
+        if event_type == "receive":
+            unit_cost = event["unit_cost_cents"]
+            if not isinstance(unit_cost, int) or isinstance(unit_cost, bool) or unit_cost < 0:
+                raise ShopError("unit cost must be a nonnegative integer")
+
+        stock = stock_by_sku.setdefault(event["sku"], _Stock())
+        if event_type == "receive":
+            stock.receive(qty, unit_cost)
+        elif event_type == "sell":
+            stock.sell(qty)
+        else:
+            stock.return_units(qty)
+
+    return {
+        sku: {
+            "cogs_cents": stock.cogs_cents,
+            "on_hand": stock.on_hand,
+            "value_cents": stock.value_cents,
+        }
+        for sku, stock in stock_by_sku.items()
+    }
diff --git a/tests/test_costing.py b/tests/test_costing.py
new file mode 100644
index 0000000..4ae1a39
--- /dev/null
+++ b/tests/test_costing.py
@@ -0,0 +1,121 @@
+from copy import deepcopy
+
+import pytest
+
+from shoplib.costing import fifo_costing
+from shoplib.errors import ShopError
+
+
+def receive(sku, qty, cost):
+    return {"type": "receive", "sku": sku, "qty": qty, "unit_cost_cents": cost}
+
+
+def event(kind, sku, qty):
+    return {"type": kind, "sku": sku, "qty": qty}
+
+
+def test_empty_and_fifo_sales_for_separate_skus():
+    assert fifo_costing([]) == {}
+    events = [
+        receive("A", 2, 100), receive("B", 2, 0), receive("A", 3, 200),
+        event("sell", "A", 3), event("sell", "B", 2),
+        event("sell", "A", 1), receive("C", 1, 75),
+    ]
+    assert fifo_costing(events) == {
+        "A": {"cogs_cents": 600, "on_hand": 1, "value_cents": 200},
+        "B": {"cogs_cents": 0, "on_hand": 0, "value_cents": 0},
+        "C": {"cogs_cents": 0, "on_hand": 1, "value_cents": 75},
+    }
+
+
+def test_returns_use_sale_average_and_join_end_of_fifo_queue():
+    events = [
+        receive("A", 2, 100), receive("A", 2, 200), event("sell", "A", 3),
+        receive("A", 1, 300), event("return", "A", 1), event("return", "A", 1),
+        event("sell", "A", 2),
+    ]
+    assert fifo_costing(events) == {
+        "A": {"cogs_cents": 634, "on_hand": 2, "value_cents": 266}
+    }
+
+
+@pytest.mark.parametrize(
+    ("costs", "expected_cogs", "expected_value"),
+    [([1, 2], -1, 4), ([1, 1, 2], 1, 3), ([1, 2, 2], -1, 6)],
+)
+def test_return_average_rounds_half_up_for_each_unit(costs, expected_cogs, expected_value):
+    events = [receive("A", 1, cost) for cost in costs]
+    events += [event("sell", "A", len(costs)), event("return", "A", len(costs))]
+    assert fifo_costing(events)["A"] == {
+        "cogs_cents": expected_cogs, "on_hand": len(costs), "value_cents": expected_value
+    }
+
+
+def test_average_just_below_half_is_not_rounded_up():
+    qty = 10**35
+    events = [
+        receive("A", qty // 2 - 1, 1), receive("A", qty // 2 + 1, 0),
+        event("sell", "A", qty), event("return", "A", qty),
+    ]
+    assert fifo_costing(events)["A"] == {
+        "cogs_cents": qty // 2 - 1, "on_hand": qty, "value_cents": 0
+    }
+
+
+def test_new_sale_replaces_returnable_sale_and_is_independent_per_sku():
+    events = [
+        receive("A", 2, 100), event("sell", "A", 2),
+        receive("B", 1, 50), event("sell", "B", 1),
+        event("return", "A", 1), receive("A", 1, 300),
+        event("sell", "A", 2), event("return", "B", 1), event("return", "A", 1),
+    ]
+    assert fifo_costing(events) == {
+        "A": {"cogs_cents": 300, "on_hand": 1, "value_cents": 200},
+        "B": {"cogs_cents": 0, "on_hand": 1, "value_cents": 50},
+    }
+
+
+@pytest.mark.parametrize("kind", ["receive", "sell", "return"])
+@pytest.mark.parametrize("qty", [0, -1, 1.5, True])
+def test_invalid_quantities_raise_shop_error(kind, qty):
+    item = event(kind, "A", qty)
+    if kind == "receive":
+        item["unit_cost_cents"] = 1
+    with pytest.raises(ShopError):
+        fifo_costing([item])
+
+
+@pytest.mark.parametrize("cost", [-1, 0.5, True])
+def test_invalid_unit_cost_raises_shop_error(cost):
+    with pytest.raises(ShopError):
+        fifo_costing([receive("A", 1, cost)])
+
+
+@pytest.mark.parametrize(
+    "events",
+    [
+        [event("sell", "A", 1)],
+        [receive("A", 1, 100), event("sell", "A", 2)],
+        [event("return", "A", 1)],
+        [receive("A", 1, 100), event("return", "A", 1)],
+        [receive("A", 2, 100), event("sell", "A", 2), event("return", "A", 3)],
+        [receive("A", 2, 100), event("sell", "A", 2),
+         event("return", "A", 1), event("return", "A", 2)],
+        [receive("A", 3, 100), event("sell", "A", 2), event("sell", "A", 1),
+         event("return", "A", 2)],
+        [{"type": "discard", "sku": "A", "qty": 1}],
+        [{"type": "discard"}],
+    ],
+)
+def test_invalid_operations_raise_shop_error_without_modifying_events(events):
+    original = deepcopy(events)
+    with pytest.raises(ShopError):
+        fifo_costing(events)
+    assert events == original
+
+
+def test_success_does_not_modify_events():
+    events = [receive("A", 2, 100), event("sell", "A", 1), event("return", "A", 1)]
+    original = deepcopy(events)
+    fifo_costing(events)
+    assert events == original
