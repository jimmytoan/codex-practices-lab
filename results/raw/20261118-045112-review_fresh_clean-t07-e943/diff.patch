+from datetime import date
+
+import pytest
+
+from shoplib.discounts import Coupon, apply_coupon, apply_coupons
+from shoplib.errors import ShopError
 
 
 def test_percent():
@@ -7,3 +12,38 @@ def test_percent():
 
 def test_fixed_never_negative():
     assert apply_coupon(300, Coupon("FIVE", "fixed", 500)) == 0
+
+
+def test_apply_coupons_combines_one_percent_and_all_eligible_fixed():
+    coupons = [
+        Coupon("SAVE5", "fixed", 500),
+        Coupon("TEN", "percent", 10),
+        Coupon("SAVE2", "fixed", 200),
+        Coupon("TWENTY", "percent", 20),
+    ]
+
+    assert apply_coupons(5000, coupons, date(2026, 1, 1)) == (3300, ["SAVE2", "SAVE5", "TWENTY"])
+
+
+def test_apply_coupons_uses_tie_breaker_expiry_and_original_subtotal():
+    coupons = [
+        Coupon("ZED", "percent", 10),
+        Coupon("ALPHA", "percent", 10, expires=date(2026, 1, 1)),
+        Coupon("EXPIRED", "fixed", 300, expires=date(2025, 12, 31)),
+        Coupon("MINIMUM", "fixed", 500, min_subtotal_cents=1001),
+        Coupon("VALID", "fixed", 100, min_subtotal_cents=1000),
+    ]
+
+    assert apply_coupons(1000, coupons, date(2026, 1, 1)) == (800, ["ALPHA", "VALID"])
+
+
+def test_apply_coupons_rounds_percent_and_clamps_total():
+    assert apply_coupons(5, [Coupon("HALF", "percent", 10)], date(2026, 1, 1)) == (4, ["HALF"])
+    assert apply_coupons(100, [Coupon("BIG", "fixed", 101)], date(2026, 1, 1)) == (0, ["BIG"])
+
+
+def test_apply_coupons_rejects_negative_subtotal_and_unknown_kind():
+    with pytest.raises(ValueError):
+        apply_coupons(-1, [], date(2026, 1, 1))
+    with pytest.raises(ShopError):
+        apply_coupons(1000, [Coupon("BAD", "bogus", 1)], date(2026, 1, 1))
