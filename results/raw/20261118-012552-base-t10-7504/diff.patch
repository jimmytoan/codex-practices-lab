 # (upper bound in grams, cost in cents)
 TIERS = [(1000, 500), (2000, 800), (5000, 1200), (20000, 2500)]
 
@@ -16,9 +18,47 @@ def shipping_cost(weight_g: int) -> int:
 
 def split_parcels(items: list[tuple[str, int, int]], max_weight_g: int) -> list[list[str]]:
     """Split order items into parcels. See docs/shipping.md."""
-    raise NotImplementedError
+    units = []
+    for sku, weight_g, qty in items:
+        if weight_g < 1:
+            raise ShopError("weight must be positive")
+        if qty < 1:
+            raise ShopError("quantity must be positive")
+        if weight_g > max_weight_g:
+            raise ShopError("unit is too heavy")
+        units.extend([(sku, weight_g)] * qty)
+
+    units.sort(key=lambda unit: (-unit[1], unit[0]))
+    parcels: list[list[str]] = []
+    weights: list[int] = []
+    for sku, weight_g in units:
+        for index, parcel_weight in enumerate(weights):
+            if parcel_weight + weight_g <= max_weight_g:
+                parcels[index].append(sku)
+                weights[index] += weight_g
+                break
+        else:
+            parcels.append([sku])
+            weights.append(weight_g)
+    return parcels
+
+
+class _WeightedSku(str):
+    """A SKU that retains its unit weight while preserving string ordering."""
+
+    def __new__(cls, sku: str, weight_g: int):
+        result = super().__new__(cls, sku)
+        result.weight_g = weight_g
+        return result
 
 
 def shipment_cost(items: list[tuple[str, int, int]], max_weight_g: int) -> int:
     """Total shipping cost of an order. See docs/shipping.md."""
-    raise NotImplementedError
+    # A SKU can occur at different weights, so retain the weight on each unit.
+    weighted_items = [(_WeightedSku(sku, weight_g), weight_g, qty)
+                      for sku, weight_g, qty in items]
+    parcels = split_parcels(weighted_items, max_weight_g)
+    try:
+        return sum(shipping_cost(sum(sku.weight_g for sku in parcel)) for parcel in parcels)
+    except ValueError as exc:
+        raise ShopError(str(exc)) from exc
