@@ -1,5 +1,7 @@
 """Shipping costs and parcel splitting. See docs/shipping.md."""
 
+from .errors import ShopError
+
 # (upper bound in grams, cost in cents)
 TIERS = [(1000, 500), (2000, 800), (5000, 1200), (20000, 2500)]
 
@@ -14,11 +16,39 @@ def shipping_cost(weight_g: int) -> int:
     raise ValueError("parcel is too heavy")
 
 
+def _pack_parcels(items: list[tuple[str, int, int]], max_weight_g: int):
+    units = []
+    for sku, unit_weight_g, qty in items:
+        if unit_weight_g < 1:
+            raise ShopError("unit weight must be positive")
+        if qty < 1:
+            raise ShopError("quantity must be positive")
+        if unit_weight_g > max_weight_g:
+            raise ShopError("unit is heavier than the parcel limit")
+        units.extend((unit_weight_g, sku) for _ in range(qty))
+
+    units.sort(key=lambda unit: (-unit[0], unit[1]))
+    parcels = []
+    parcel_weights = []
+    for weight, sku in units:
+        for index, parcel_weight in enumerate(parcel_weights):
+            if parcel_weight + weight <= max_weight_g:
+                parcels[index].append(sku)
+                parcel_weights[index] += weight
+                break
+        else:
+            parcels.append([sku])
+            parcel_weights.append(weight)
+    return parcels, parcel_weights
+
+
 def split_parcels(items: list[tuple[str, int, int]], max_weight_g: int) -> list[list[str]]:
     """Split order items into parcels. See docs/shipping.md."""
-    raise NotImplementedError
+    parcels, _ = _pack_parcels(items, max_weight_g)
+    return parcels
 
 
 def shipment_cost(items: list[tuple[str, int, int]], max_weight_g: int) -> int:
     """Total shipping cost of an order. See docs/shipping.md."""
-    raise NotImplementedError
+    _, parcel_weights = _pack_parcels(items, max_weight_g)
+    return sum(shipping_cost(weight) for weight in parcel_weights)
