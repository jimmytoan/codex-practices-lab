--- a/src/shoplib/storedays.py
+++ b/src/shoplib/storedays.py
@@ -1,6 +1,47 @@
 """Revenue per store day. See docs/store-days.md."""
 
+from datetime import datetime, timedelta, timezone
+
+from shoplib.errors import ShopError
+
 
 def daily_revenue(sales: list[dict], utc_offset_hours: int = 8, day_starts_hour: int = 4) -> list[tuple[str, int]]:
     """Revenue per store day. See docs/store-days.md."""
-    raise NotImplementedError
+    if isinstance(utc_offset_hours, bool) or not isinstance(utc_offset_hours, int) or not -23 <= utc_offset_hours <= 23:
+        raise ShopError("utc_offset_hours must be an integer from -23 to 23")
+    if isinstance(day_starts_hour, bool) or not isinstance(day_starts_hour, int) or not 0 <= day_starts_hour <= 23:
+        raise ShopError("day_starts_hour must be an integer from 0 to 23")
+
+    totals: dict = {}
+    for sale in sales:
+        try:
+            timestamp = sale["at"]
+            cents = sale["cents"]
+            if not isinstance(timestamp, str):
+                raise TypeError
+            # fromisoformat accepts ISO 8601 offsets; normalize Z for older Python versions.
+            parsed = datetime.fromisoformat(timestamp[:-1] + "+00:00" if timestamp.endswith("Z") else timestamp)
+            if parsed.tzinfo is None or parsed.utcoffset() is None:
+                raise ShopError("timestamp must include a time zone")
+            if isinstance(cents, bool) or not isinstance(cents, int):
+                raise TypeError
+        except ShopError:
+            raise
+        except (KeyError, TypeError, ValueError, OverflowError) as exc:
+            raise ShopError("each sale needs a zoned ISO 8601 timestamp and integer cents") from exc
+
+        local_time = parsed.astimezone(timezone.utc) + timedelta(hours=utc_offset_hours)
+        store_day = local_time.date()
+        if local_time.hour < day_starts_hour:
+            store_day -= timedelta(days=1)
+        totals[store_day] = totals.get(store_day, 0) + cents
+
+    if not totals:
+        return []
+    first, last = min(totals), max(totals)
+    result = []
+    day = first
+    while day <= last:
+        result.append((day.isoformat(), totals.get(day, 0)))
+        day += timedelta(days=1)
+    return result
diff --git a/tests/test_storedays.py b/tests/test_storedays.py
new file mode 100644
