+++ b/tests/test_storedays.py
@@ -0,0 +1,33 @@
+import pytest
+
+from shoplib.errors import ShopError
+from shoplib.storedays import daily_revenue
+
+
+def test_store_day_boundary_and_exact_start_hour():
+    sales = [
+        {"at": "2026-11-18T02:30:00+08:00", "cents": 1200},
+        {"at": "2026-11-18T04:00:00+08:00", "cents": 500},
+    ]
+    assert daily_revenue(sales) == [("2026-11-17", 1200), ("2026-11-18", 500)]
+
+
+def test_convert_zoned_timestamps_to_store_timezone_and_fill_gaps():
+    sales = [
+        {"at": "2026-11-17T20:00:00Z", "cents": 1000},
+        {"at": "2026-11-20T00:00:00-05:00", "cents": -250},
+    ]
+    assert daily_revenue(sales) == [
+        ("2026-11-18", 1000),
+        ("2026-11-19", 0),
+        ("2026-11-20", -250),
+    ]
+
+
+def test_empty_sales():
+    assert daily_revenue([]) == []
+
+
+def test_timestamp_without_zone_is_rejected():
+    with pytest.raises(ShopError):
+        daily_revenue([{"at": "2026-11-18T04:00:00", "cents": 10}])
