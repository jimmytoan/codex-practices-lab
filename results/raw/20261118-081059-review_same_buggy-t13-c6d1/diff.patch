+++ b/tests/test_costing.py
@@ -0,0 +1,83 @@
+import copy
+
+import pytest
+
+from shoplib.costing import fifo_costing
+from shoplib.errors import ShopError
+
+
+def test_returned_units_are_sold_after_existing_lots():
+    events = [
+        {"type": "receive", "sku": "A", "qty": 1, "unit_cost_cents": 1},
+        {"type": "sell", "sku": "A", "qty": 1},
+        {"type": "receive", "sku": "A", "qty": 1, "unit_cost_cents": 9},
+        {"type": "return", "sku": "A", "qty": 1},
+        {"type": "sell", "sku": "A", "qty": 1},
+    ]
+
+    assert fifo_costing(events) == {
+        "A": {"cogs_cents": 9, "on_hand": 1, "value_cents": 1}
+    }
+
+
+def test_return_cost_rounds_average_unit_cost_half_up():
+    events = [
+        {"type": "receive", "sku": "A", "qty": 1, "unit_cost_cents": 1},
+        {"type": "receive", "sku": "A", "qty": 1, "unit_cost_cents": 2},
+        {"type": "sell", "sku": "A", "qty": 2},
+        {"type": "return", "sku": "A", "qty": 1},
+        {"type": "return", "sku": "A", "qty": 1},
+    ]
+
+    assert fifo_costing(events) == {
+        "A": {"cogs_cents": -1, "on_hand": 2, "value_cents": 4}
+    }
+
+
+@pytest.mark.parametrize(
+    "events",
+    [
+        [{"type": "receive", "sku": "A", "qty": 0, "unit_cost_cents": 1}],
+        [{"type": "receive", "sku": "A", "qty": 1, "unit_cost_cents": -1}],
+        [{"type": "sell", "sku": "A", "qty": 1}],
+        [{"type": "return", "sku": "A", "qty": 1}],
+        [
+            {"type": "receive", "sku": "A", "qty": 1, "unit_cost_cents": 1},
+            {"type": "sell", "sku": "A", "qty": 1},
+            {"type": "return", "sku": "A", "qty": 2},
+        ],
+        [{"type": "unknown", "sku": "A", "qty": 1}],
+    ],
+)
+def test_invalid_events_raise_value_error_without_modifying_events(events):
+    original = copy.deepcopy(events)
+
+    with pytest.raises(ShopError):
+        fifo_costing(events)
+
+    assert events == original
+
+
+def test_returns_are_limited_to_the_most_recent_sale():
+    events = [
+        {"type": "receive", "sku": "A", "qty": 2, "unit_cost_cents": 5},
+        {"type": "sell", "sku": "A", "qty": 1},
+        {"type": "sell", "sku": "A", "qty": 1},
+        {"type": "return", "sku": "A", "qty": 1},
+    ]
+
+    assert fifo_costing(events) == {
+        "A": {"cogs_cents": 5, "on_hand": 1, "value_cents": 5}
+    }
+
+
+def test_partial_returns_cannot_exceed_remaining_returnable_quantity():
+    events = [
+        {"type": "receive", "sku": "A", "qty": 2, "unit_cost_cents": 5},
+        {"type": "sell", "sku": "A", "qty": 2},
+        {"type": "return", "sku": "A", "qty": 1},
+        {"type": "return", "sku": "A", "qty": 2},
+    ]
+
+    with pytest.raises(ShopError):
+        fifo_costing(events)
