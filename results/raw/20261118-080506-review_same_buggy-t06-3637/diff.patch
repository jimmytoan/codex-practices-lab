diff --git a/tests/test_dates.py b/tests/test_dates.py
index fbfd5f2..0721c29 100644
--- a/tests/test_dates.py
+++ b/tests/test_dates.py
@@ -12,3 +12,21 @@ def test_forward_over_weekend():
     # Friday + 1 business day = Monday
     assert add_business_days(date(2026, 11, 13), 1) == date(2026, 11, 16)
     assert add_business_days(date(2026, 11, 16), 3) == date(2026, 11, 19)
+
+
+def test_holidays_are_skipped_in_both_directions():
+    holiday = date(2026, 11, 18)  # Wednesday
+    assert add_business_days(date(2026, 11, 17), 1, [holiday]) == date(2026, 11, 19)
+    assert add_business_days(date(2026, 11, 19), -1, [holiday]) == date(2026, 11, 17)
+
+
+def test_zero_returns_start_when_business_day():
+    start = date(2026, 11, 16)  # Monday
+    assert add_business_days(start, 0) == start
+
+
+def test_zero_moves_to_first_business_day_after_start():
+    assert add_business_days(date(2026, 11, 15), 0) == date(2026, 11, 16)
+    assert add_business_days(
+        date(2026, 11, 16), 0, [date(2026, 11, 16)]
+    ) == date(2026, 11, 17)
