+def test_split_first_fit_decreasing_and_sku_ties():
+    items = [("z", 4, 1), ("b", 6, 1), ("a", 6, 2), ("y", 4, 2)]
+    assert split_parcels(items, 10) == [["a", "y"], ["a", "y"], ["b", "z"]]
+    assert items == [("z", 4, 1), ("b", 6, 1), ("a", 6, 2), ("y", 4, 2)]
