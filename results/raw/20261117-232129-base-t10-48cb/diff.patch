+def test_shipment_cost_uses_each_parcel_weight(monkeypatch):
+    weights = []
+
+    def cost(weight):
+        weights.append(weight)
+        return weight * 2
+
+    monkeypatch.setattr("shoplib.shipping.shipping_cost", cost)
+    # The same SKU may have different weights on separate lines. The lighter
+    # units go into earlier parcels even after a heavier unit opened parcel 2.
+    items = [("x", 600, 2), ("x", 400, 1), ("y", 300, 1)]
+    assert split_parcels(items, 1000) == [["x", "x"], ["x", "y"]]
+    assert shipment_cost(items, 1000) == 3800
+    assert weights == [1000, 900]
