@@ -0,0 +1,62 @@
+import pytest
+
+from shoplib.errors import ShopError
+from shoplib.search import Product, search
+
+
+@pytest.fixture
+def products():
+    return [
+        Product("MUG-01", "Blue Mug Large", 1200, ["drinkware", "sale"]),
+        Product("MUG-02", "Blue Travel Cup", 999, ["drinkware"]),
+        Product("PLATE-01", "Dinner Plate", 1200, ["sale"]),
+    ]
+
+
+def test_empty_query_matches_every_product_in_input_order(products):
+    assert search(products, " \t\n") == products
+
+
+def test_bare_words_and_quoted_phrases_match_name_case_insensitively(products):
+    assert search(products, "blue") == products[:2]
+    assert search(products, '"blue mug"') == products[:1]
+    assert search(products, 'name:"TRAVEL cup"') == products[1:2]
+
+
+def test_sku_and_tag_support_exact_and_trailing_prefix_matches(products):
+    assert search(products, "sku:mug-02") == products[1:2]
+    assert search(products, "tag:SALE") == [products[0], products[2]]
+    assert search(products, "sku:MUG-*") == products[:2]
+    assert search(products, "tag:drink*") == products[:2]
+    assert search(products, "sku:MU*G") == []
+    assert search(products, "tag:sa*le") == []
+
+
+def test_price_comparisons_and_negation(products):
+    assert search(products, "price<1000") == products[1:2]
+    assert search(products, "price<=999") == products[1:2]
+    assert search(products, "price>1199") == [products[0], products[2]]
+    assert search(products, "price>=1200") == [products[0], products[2]]
+    assert search(products, "price=1200") == [products[0], products[2]]
+    assert search(products, "blue -tag:sale") == products[1:2]
+    assert search(products, '-"blue mug"') == products[1:]
+
+
+@pytest.mark.parametrize(
+    "query",
+    [
+        "color:red",  # unknown field
+        "price:5",  # price is not a field
+        "tag:",
+        'tag:""',
+        "-",
+        "price>",
+        "price>=1.5",
+        "price=abc",
+        '"unfinished',
+    ],
+)
+def test_invalid_queries_raise_shop_error(query, products):
+    with pytest.raises(ShopError):
+        search(products, query)
+
