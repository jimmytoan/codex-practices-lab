diff --git a/src/shoplib/invoice.py b/src/shoplib/invoice.py
index 5d1398c..e9c195d 100644
--- a/src/shoplib/invoice.py
+++ b/src/shoplib/invoice.py
@@ -1,5 +1,8 @@
 """Invoices: coupon allocation and tax. See docs/invoicing.md."""
 
+from .errors import ShopError
+from .money import percent_of
+
 # Tax rates in percent, by region and product category.
 TAX_RATES = {
     "DE": {"standard": 19, "food": 7, "books": 7},
@@ -10,4 +13,59 @@ TAX_RATES = {
 
 def build_invoice(lines, coupon_cents: int, shipping_cents: int, region: str) -> dict:
     """Build an invoice for an order. See docs/invoicing.md."""
-    raise NotImplementedError
+    if not isinstance(region, str) or region not in TAX_RATES:
+        raise ShopError("unknown region")
+    if not isinstance(lines, (list, tuple)) or not lines:
+        raise ShopError("lines must not be empty")
+    for amount in (coupon_cents, shipping_cents):
+        if type(amount) is not int or amount < 0:
+            raise ShopError("amount must be a nonnegative integer")
+
+    rates = TAX_RATES[region]
+    gross_amounts = []
+    for line in lines:
+        if not isinstance(line, (list, tuple)) or len(line) != 4:
+            raise ShopError("invalid line")
+        _, price, qty, category = line
+        if type(price) is not int or price < 0:
+            raise ShopError("price must be a nonnegative integer")
+        if type(qty) is not int or qty < 1:
+            raise ShopError("quantity must be a positive integer")
+        if not isinstance(category, str) or category not in rates:
+            raise ShopError("unknown category")
+        gross_amounts.append(price * qty)
+
+    total_gross = sum(gross_amounts)
+    coupon = min(coupon_cents, total_gross)
+    discounts = [0] * len(lines)
+    if total_gross:
+        allocations = [divmod(coupon * gross, total_gross) for gross in gross_amounts]
+        discounts = [allocation[0] for allocation in allocations]
+        remaining = coupon - sum(discounts)
+        order = sorted(range(len(lines)), key=lambda i: (-allocations[i][1], i))
+        for i in order[:remaining]:
+            discounts[i] += 1
+
+    invoice_lines = []
+    for (sku, _, _, category), gross, discount in zip(lines, gross_amounts, discounts):
+        net = gross - discount
+        invoice_lines.append({
+            "sku": sku,
+            "gross_cents": gross,
+            "discount_cents": discount,
+            "net_cents": net,
+            "tax_cents": percent_of(net, rates[category]),
+        })
+
+    shipping_tax = (
+        percent_of(shipping_cents, rates["standard"])
+        if any(rates[line[3]] > 0 for line in lines)
+        else 0
+    )
+    return {
+        "lines": invoice_lines,
+        "shipping_cents": shipping_cents,
+        "shipping_tax_cents": shipping_tax,
+        "total_cents": sum(line["net_cents"] + line["tax_cents"] for line in invoice_lines)
+        + shipping_cents + shipping_tax,
+    }
diff --git a/tests/test_invoice.py b/tests/test_invoice.py
new file mode 100644
index 0000000..27ea34e
--- /dev/null
+++ b/tests/test_invoice.py
@@ -0,0 +1,71 @@
+import pytest
+
+from shoplib.errors import ShopError
+from shoplib.invoice import build_invoice
+
+
+def test_invoice_allocates_coupon_by_largest_remainder_and_taxes_lines():
+    invoice = build_invoice(
+        [("A", 100, 1, "standard"), ("B", 100, 2, "food"), ("C", 300, 1, "books")],
+        5, 50, "DE",
+    )
+    assert invoice == {
+        "lines": [
+            {"sku": "A", "gross_cents": 100, "discount_cents": 1, "net_cents": 99, "tax_cents": 19},
+            {"sku": "B", "gross_cents": 200, "discount_cents": 2, "net_cents": 198, "tax_cents": 14},
+            {"sku": "C", "gross_cents": 300, "discount_cents": 2, "net_cents": 298, "tax_cents": 21},
+        ],
+        "shipping_cents": 50,
+        "shipping_tax_cents": 10,
+        "total_cents": 709,
+    }
+
+
+def test_equal_remainders_favor_earlier_lines():
+    invoice = build_invoice([(sku, 1, 1, "books") for sku in "ABC"], 2, 0, "SG")
+    assert [line["discount_cents"] for line in invoice["lines"]] == [1, 1, 0]
+    assert invoice["total_cents"] == 1
+
+
+def test_coupon_is_capped_and_taxable_category_still_taxes_shipping():
+    invoice = build_invoice([("A", 10, 2, "food"), ("B", 0, 1, "books")], 100, 50, "DE")
+    assert [line["discount_cents"] for line in invoice["lines"]] == [20, 0]
+    assert invoice["shipping_tax_cents"] == 10
+    assert invoice["total_cents"] == 60
+
+
+def test_zero_gross_and_exempt_categories_do_not_tax_shipping():
+    invoice = build_invoice([("A", 0, 1, "books")], 10, 100, "SG")
+    assert invoice["lines"][0]["discount_cents"] == 0
+    assert invoice["shipping_tax_cents"] == 0
+    assert invoice["total_cents"] == 100
+    assert build_invoice([("B", 100, 1, "standard")], 0, 100, "OR")["total_cents"] == 200
+
+
+def test_tax_is_rounded_per_line_and_shipping_half_up():
+    invoice = build_invoice([("A", 5, 1, "standard"), ("B", 5, 1, "food")], 0, 50, "SG")
+    assert [line["tax_cents"] for line in invoice["lines"]] == [0, 0]
+    assert invoice["shipping_tax_cents"] == 5
+    assert invoice["total_cents"] == 65
+
+
+@pytest.mark.parametrize(
+    "lines, coupon, shipping, region",
+    [
+        ([], 0, 0, "DE"),
+        ([("A", 1, 1, "standard")], 0, 0, "unknown"),
+        ([("A", 1, 1, "unknown")], 0, 0, "DE"),
+        ([("A", -1, 1, "standard")], 0, 0, "DE"),
+        ([("A", 1, 0, "standard")], 0, 0, "DE"),
+        ([("A", 1, 1, "standard")], -1, 0, "DE"),
+        ([("A", 1, 1, "standard")], 0, -1, "DE"),
+        ([("A", 1.5, 1, "standard")], 0, 0, "DE"),
+        ([("A", 1, 1.5, "standard")], 0, 0, "DE"),
+        ([("A", 1, 1, "standard")], 0.5, 0, "DE"),
+        ([("A", 1, 1, "standard")], 0, 0.5, "DE"),
+        ([("A", 1)], 0, 0, "DE"),
+    ],
+)
+def test_invalid_arguments_raise_shop_error(lines, coupon, shipping, region):
+    with pytest.raises(ShopError):
+        build_invoice(lines, coupon, shipping, region)
