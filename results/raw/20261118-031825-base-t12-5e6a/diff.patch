@@ -0,0 +1,71 @@
+import pytest
+
+from shoplib.search import Product, search
+
+
+@pytest.fixture
+def products():
+    return [
+        Product("MUG-01", "Blue ceramic mug", 1250, ["Kitchen", "Sale"]),
+        Product("MUG-02", "Travel Mug", 900, ["travel"]),
+        Product("PLATE-1", "Blue plate", 1000, ["Kitchen"]),
+    ]
+
+
+def test_empty_query_and_bare_words_match_names_case_insensitively(products):
+    assert search(products, " \t\n") == products
+    assert search(products, "BLUE") == [products[0], products[2]]
+    assert search(products, '"travel mug"') == [products[1]]
+
+
+def test_quotes_group_whitespace_in_whole_terms_and_field_values(products):
+    assert search(products, 'name:"ceramic mug"') == [products[0]]
+    assert search(products, '"Blue ceramic" sku:mug-01') == [products[0]]
+    assert search(products, 'tag:"kitchen"') == [products[0], products[2]]
+
+
+def test_fields_are_case_insensitive_and_sku_tag_support_prefixes(products):
+    assert search(products, "sku:mUg-01") == [products[0]]
+    assert search(products, "tag:SALE") == [products[0]]
+    assert search(products, "sku:MUG-*") == products[:2]
+    assert search(products, "tag:kit*") == [products[0], products[2]]
+    # An asterisk that is not final is an ordinary character.
+    assert search(products, "sku:MUG-*x") == []
+
+
+def test_price_comparisons_and_negation(products):
+    assert search(products, "price<1000") == [products[1]]
+    assert search(products, "price<=1000") == [products[1], products[2]]
+    assert search(products, "price>1000") == [products[0]]
+    assert search(products, "price>=1000") == [products[0], products[2]]
+    assert search(products, "price=900") == [products[1]]
+    assert search(products, "-tag:sale") == [products[1], products[2]]
+    assert search(products, "mug -price<1000") == [products[0]]
+
+
+@pytest.mark.parametrize(
+    "query",
+    [
+        "price:5",
+        "other:value",
+        ":value",
+        "sku:",
+        "name:",
+        "tag:",
+        "price>=",
+        "price>=1.5",
+        "price>=-1",
+        "price>=abc",
+        "price==1",
+        "-",
+        '"unclosed',
+    ],
+)
+def test_invalid_queries_raise_value_error(query, products):
+    with pytest.raises(ValueError):
+        search(products, query)
+
+
+def test_empty_quoted_bare_term_is_an_empty_substring(products):
+    assert search(products, '""') == products
+
