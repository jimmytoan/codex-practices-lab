 def search(products: list[Product], query: str) -> list[Product]:
     """The products that match `query`, in their input order. See docs/search.md."""
-    raise NotImplementedError
+    terms = _tokenize(query)
+    predicates = [_parse_term(term) for term in terms]
+    return [product for product in products if all(predicate(product) for predicate in predicates)]
+
+
+def _tokenize(query: str) -> list[str]:
+    """Split on unquoted whitespace and remove the quote delimiters."""
+    terms: list[str] = []
+    chars: list[str] = []
+    in_quotes = False
+    in_term = False
+
+    for char in query:
+        if char == '"':
+            in_quotes = not in_quotes
+            in_term = True
+        elif char.isspace() and not in_quotes:
+            if in_term:
+                terms.append("".join(chars))
+                chars.clear()
+                in_term = False
+        else:
+            chars.append(char)
+            in_term = True
+
+    if in_quotes:
+        raise ShopError("unclosed quote")
+    if in_term:
+        terms.append("".join(chars))
+    return terms
+
+
+def _parse_term(term: str):
+    negate = term.startswith("-")
+    if negate:
+        term = term[1:]
+        if not term:
+            raise ShopError("missing term after '-'")
+
+    comparison = re.fullmatch(r"price(<=|>=|<|>|=)(.*)", term)
+    if comparison:
+        operator, value = comparison.groups()
+        if not re.fullmatch(r"[0-9]+", value):
+            raise ShopError("price comparison must use whole cents")
+        cents = int(value)
+        compare = {
+            "<": lambda price: price < cents,
+            "<=": lambda price: price <= cents,
+            ">": lambda price: price > cents,
+            ">=": lambda price: price >= cents,
+            "=": lambda price: price == cents,
+        }[operator]
+        predicate = lambda product: compare(product.price_cents)
+    elif ":" in term:
+        field_name, value = term.split(":", 1)
+        if field_name not in {"sku", "name", "tag"}:
+            raise ShopError(f"unknown search field: {field_name}")
+        if value == "":
+            raise ShopError("search field value cannot be empty")
+
+        if field_name == "name":
+            needle = value.casefold()
+            predicate = lambda product: needle in product.name.casefold()
+        elif field_name == "sku":
+            predicate = _exact_or_prefix(value, lambda product: product.sku)
+        else:
+            predicate = _exact_or_prefix(value, lambda product: product.tags)
+    else:
+        needle = term.casefold()
+        predicate = lambda product: needle in product.name.casefold()
+
+    if negate:
+        return lambda product: not predicate(product)
+    return predicate
+
+
+def _exact_or_prefix(value: str, get_values):
+    prefix = value.endswith("*")
+    expected = (value[:-1] if prefix else value).casefold()
+
+    def matches(product):
+        value = get_values(product)
+        values = [value] if isinstance(value, str) else value
+        if prefix:
+            return any(item.casefold().startswith(expected) for item in values)
+        return any(item.casefold() == expected for item in values)
+
+    return matches
