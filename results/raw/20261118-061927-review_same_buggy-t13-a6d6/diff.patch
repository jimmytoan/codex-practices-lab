+++ b/tests/test_costing.py
@@ -0,0 +1,84 @@
+from copy import deepcopy
+
+import pytest
+
+from shoplib.costing import fifo_costing
+
+
+def test_fifo_costs_sales_across_receipts():
+    assert fifo_costing([
+        {"type": "receive", "sku": "A", "qty": 2, "unit_cost_cents": 10},
+        {"type": "receive", "sku": "A", "qty": 3, "unit_cost_cents": 20},
+        {"type": "sell", "sku": "A", "qty": 4},
+    ]) == {"A": {"cogs_cents": 60, "on_hand": 1, "value_cents": 20}}
+
+
+def test_return_uses_half_up_average_cost():
+    assert fifo_costing([
+        {"type": "receive", "sku": "A", "qty": 1, "unit_cost_cents": 1},
+        {"type": "receive", "sku": "A", "qty": 1, "unit_cost_cents": 2},
+        {"type": "sell", "sku": "A", "qty": 2},
+        {"type": "return", "sku": "A", "qty": 1},
+    ]) == {"A": {"cogs_cents": 1, "on_hand": 1, "value_cents": 2}}
+
+
+def test_returned_lot_goes_after_lots_already_on_hand():
+    assert fifo_costing([
+        {"type": "receive", "sku": "A", "qty": 1, "unit_cost_cents": 100},
+        {"type": "sell", "sku": "A", "qty": 1},
+        {"type": "receive", "sku": "A", "qty": 1, "unit_cost_cents": 300},
+        {"type": "return", "sku": "A", "qty": 1},
+        {"type": "sell", "sku": "A", "qty": 1},
+        {"type": "sell", "sku": "A", "qty": 1},
+    ]) == {"A": {"cogs_cents": 400, "on_hand": 0, "value_cents": 0}}
+
+
+def test_multiple_returns_are_limited_to_latest_sale():
+    assert fifo_costing([
+        {"type": "receive", "sku": "A", "qty": 3, "unit_cost_cents": 5},
+        {"type": "sell", "sku": "A", "qty": 2},
+        {"type": "return", "sku": "A", "qty": 1},
+        {"type": "return", "sku": "A", "qty": 1},
+        {"type": "sell", "sku": "A", "qty": 1},
+    ]) == {"A": {"cogs_cents": 5, "on_hand": 2, "value_cents": 10}}
+
+
+def test_returns_are_only_allowed_from_the_latest_sale():
+    with pytest.raises(ValueError):
+        fifo_costing([
+            {"type": "receive", "sku": "A", "qty": 2, "unit_cost_cents": 5},
+            {"type": "sell", "sku": "A", "qty": 1},
+            {"type": "sell", "sku": "A", "qty": 1},
+            {"type": "return", "sku": "A", "qty": 2},
+        ])
+
+
+@pytest.mark.parametrize("events", [
+    [{"type": "receive", "sku": "A", "qty": 0, "unit_cost_cents": 1}],
+    [{"type": "receive", "sku": "A", "qty": 1, "unit_cost_cents": -1}],
+    [{"type": "sell", "sku": "A", "qty": 1}],
+    [{"type": "return", "sku": "A", "qty": 1}],
+    [
+        {"type": "receive", "sku": "A", "qty": 1, "unit_cost_cents": 1},
+        {"type": "sell", "sku": "A", "qty": 1},
+        {"type": "return", "sku": "A", "qty": 2},
+    ],
+    [{"type": "unknown", "sku": "A", "qty": 1}],
+])
+def test_invalid_events_raise_value_error_and_are_not_modified(events):
+    original = deepcopy(events)
+    with pytest.raises(ValueError):
+        fifo_costing(events)
+    assert events == original
+
+
+def test_quantity_below_one_on_sale_is_rejected():
+    with pytest.raises(ValueError):
+        fifo_costing([{"type": "sell", "sku": "A", "qty": 0}])
+
+
+def test_successful_call_does_not_modify_events():
+    events = [{"type": "receive", "sku": "A", "qty": 1, "unit_cost_cents": 10}]
+    original = deepcopy(events)
+    fifo_costing(events)
+    assert events == original
