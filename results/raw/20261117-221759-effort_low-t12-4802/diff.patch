@@ -0,0 +1,47 @@
+import pytest
+
+from shoplib.errors import ShopError
+from shoplib.search import Product, search
+
+
+@pytest.fixture
+def products():
+    return [
+        Product('MUG-1', 'Blue Mug', 1000, ['Sale', 'ceramic']),
+        Product('mug-2', 'Dark blue mug', 1500, ['Ceramics']),
+        Product('BOWL', 'Blue bowl', 500, ['sale']),
+        Product('STAR*X', 'Red: bowl', 0, ['a*b']),
+    ]
+
+
+@pytest.mark.parametrize(('query', 'indices'), [
+    ('', [0, 1, 2, 3]), (' \t ', [0, 1, 2, 3]),
+    ('BLUE mug', [0, 1]), ('"blue mug"', [0, 1]),
+    ('name:"dark blue"', [1]), ('"Red: bowl"', [3]),
+    ('sku:mug-1', [0]), ('SKU:mug-1', None),
+    ('tag:SALE', [0, 2]), ('sku:MUG-*', [0, 1]),
+    ('tag:ceramic*', [0, 1]), ('tag:a*b', [3]),
+    ('sku:STAR*X', [3]), ('name:blue*', []),
+    ('price<1000', [2, 3]), ('price<=1000', [0, 2, 3]),
+    ('price>1000', [1]), ('price>=1000', [0, 1]),
+    ('price=1000', [0]), ('-tag:sale blue', [1]),
+    ('-price>=1000', [2, 3]), ('-"blue mug"', [2, 3]),
+])
+def test_queries(products, query, indices):
+    if indices is None:
+        with pytest.raises(ShopError):
+            search(products, query)
+    else:
+        assert search(products, query) == [products[i] for i in indices]
+
+
+@pytest.mark.parametrize('query', [
+    'other:value', 'price:5', 'tag:', 'name:""', 'sku:', '-', '-""',
+    '"unclosed', 'name:"unclosed', 'price<', 'price>=1.5', 'price=-1',
+    'price=+1', 'price>abc', 'price==1', 'missing tag:',
+])
+def test_invalid_queries(products, query):
+    with pytest.raises(ShopError):
+        search(products, query)
+    with pytest.raises(ShopError):
+        search([], query)
