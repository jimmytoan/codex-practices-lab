@@ -13,4 +17,78 @@ class Product:
 
 def search(products: list[Product], query: str) -> list[Product]:
     """The products that match `query`, in their input order. See docs/search.md."""
-    raise NotImplementedError
+    terms = [_parse_term(value, unquoted) for value, unquoted in _tokens(query)]
+    return [product for product in products if all(term(product) for term in terms)]
+
+
+def _tokens(query: str):
+    """Yield token text and the positions that were outside quotes."""
+    value, unquoted = [], []
+    quoted = False
+    started = False
+    for char in query:
+        if char == '"':
+            quoted = not quoted
+            started = True
+        elif char.isspace() and not quoted:
+            if started:
+                yield ''.join(value), unquoted
+                value, unquoted = [], []
+                started = False
+        else:
+            value.append(char)
+            unquoted.append(not quoted)
+            started = True
+    if quoted:
+        raise ShopError('unclosed quote')
+    if started:
+        yield ''.join(value), unquoted
+
+
+def _parse_term(value, unquoted):
+    negate = bool(value and value[0] == '-' and unquoted[0])
+    if negate:
+        value, unquoted = value[1:], unquoted[1:]
+        if not value:
+            raise ShopError('empty negation')
+
+    colon = next((i for i, char in enumerate(value)
+                  if char == ':' and unquoted[i]), None)
+    if colon is not None:
+        field, operand = value[:colon], value[colon + 1:]
+        if field not in ('sku', 'name', 'tag'):
+            raise ShopError('unknown field')
+        if not operand:
+            raise ShopError('empty field value')
+        operand = operand.casefold()
+        if field == 'name':
+            matches = lambda product: operand in product.name.casefold()
+        else:
+            prefix = operand.endswith('*')
+            if prefix:
+                operand = operand[:-1]
+
+            def matches(product):
+                values = [product.sku] if field == 'sku' else product.tags
+                return any(item.casefold().startswith(operand) if prefix
+                           else item.casefold() == operand for item in values)
+    else:
+        price = re.match(r'price(<=|>=|<|>|=)', value)
+        if price and all(unquoted[:price.end()]):
+            amount = value[price.end():]
+            if not re.fullmatch(r'[0-9]+', amount):
+                raise ShopError('invalid price')
+            compare = {'<': operator.lt, '<=': operator.le, '>': operator.gt,
+                       '>=': operator.ge, '=': operator.eq}[price.group(1)]
+            # Convert in small chunks so even long, valid integers work with
+            # Python's limit on decimal-to-integer string conversions.
+            cents = 0
+            for start in range(0, len(amount), 9):
+                chunk = amount[start:start + 9]
+                cents = cents * 10 ** len(chunk) + int(chunk)
+            matches = lambda product: compare(product.price_cents, cents)
+        else:
+            operand = value.casefold()
+            matches = lambda product: operand in product.name.casefold()
+
+    return (lambda product: not matches(product)) if negate else matches
