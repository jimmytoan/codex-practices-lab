diff --git a/src/shoplib/invoice.py b/src/shoplib/invoice.py
index 5d1398c..d1ca833 100644
--- a/src/shoplib/invoice.py
+++ b/src/shoplib/invoice.py
@@ -1,5 +1,8 @@
 """Invoices: coupon allocation and tax. See docs/invoicing.md."""
 
+from .errors import ShopError
+from .money import percent_of
+
 # Tax rates in percent, by region and product category.
 TAX_RATES = {
     "DE": {"standard": 19, "food": 7, "books": 7},
@@ -10,4 +13,52 @@ TAX_RATES = {
 
 def build_invoice(lines, coupon_cents: int, shipping_cents: int, region: str) -> dict:
     """Build an invoice for an order. See docs/invoicing.md."""
-    raise NotImplementedError
+    if region not in TAX_RATES:
+        raise ShopError("unknown region")
+    if not lines:
+        raise ShopError("an invoice needs at least one line")
+    if coupon_cents < 0 or shipping_cents < 0:
+        raise ShopError("coupon and shipping must not be negative")
+
+    rates = TAX_RATES[region]
+    gross_amounts = []
+    for _, price, qty, category in lines:
+        if category not in rates:
+            raise ShopError("unknown category")
+        if price < 0 or qty < 1:
+            raise ShopError("invalid price or quantity")
+        gross_amounts.append(price * qty)
+
+    total_gross = sum(gross_amounts)
+    coupon = min(coupon_cents, total_gross)
+    discounts = [0] * len(lines)
+    if total_gross:
+        allocations = [divmod(coupon * gross, total_gross) for gross in gross_amounts]
+        discounts = [amount for amount, _ in allocations]
+        remainder_order = sorted(range(len(lines)), key=lambda i: -allocations[i][1])
+        for i in remainder_order[:coupon - sum(discounts)]:
+            discounts[i] += 1
+
+    invoice_lines = []
+    for (sku, _, _, category), gross, discount in zip(lines, gross_amounts, discounts):
+        net = gross - discount
+        invoice_lines.append({
+            "sku": sku,
+            "gross_cents": gross,
+            "discount_cents": discount,
+            "net_cents": net,
+            "tax_cents": percent_of(net, rates[category]),
+        })
+
+    shipping_tax = (
+        percent_of(shipping_cents, rates["standard"])
+        if any(rates[category] > 0 for _, _, _, category in lines)
+        else 0
+    )
+    return {
+        "lines": invoice_lines,
+        "shipping_cents": shipping_cents,
+        "shipping_tax_cents": shipping_tax,
+        "total_cents": sum(line["net_cents"] + line["tax_cents"] for line in invoice_lines)
+        + shipping_cents + shipping_tax,
+    }
diff --git a/tests/test_invoice.py b/tests/test_invoice.py
