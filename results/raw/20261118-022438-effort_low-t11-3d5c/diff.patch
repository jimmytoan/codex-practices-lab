@@ -0,0 +1,60 @@
+import pytest
+
+from shoplib.errors import ShopError
+from shoplib.invoice import build_invoice
+
+
+def test_coupon_split_and_tax_by_line():
+    invoice = build_invoice(
+        [("a", 100, 2, "standard"), ("b", 100, 1, "food"), ("c", 100, 1, "books")],
+        3, 100, "DE",
+    )
+    assert invoice == {
+        "lines": [
+            {"sku": "a", "gross_cents": 200, "discount_cents": 1, "net_cents": 199, "tax_cents": 38},
+            {"sku": "b", "gross_cents": 100, "discount_cents": 1, "net_cents": 99, "tax_cents": 7},
+            {"sku": "c", "gross_cents": 100, "discount_cents": 1, "net_cents": 99, "tax_cents": 7},
+        ],
+        "shipping_cents": 100,
+        "shipping_tax_cents": 19,
+        "total_cents": 568,
+    }
+
+
+def test_largest_remainders_and_ties_use_input_order():
+    invoice = build_invoice([(str(i), price, 1, "books") for i, price in enumerate([1, 2, 2])], 2, 0, "SG")
+    assert [line["discount_cents"] for line in invoice["lines"]] == [0, 1, 1]
+    invoice = build_invoice([(str(i), 1, 1, "books") for i in range(3)], 2, 0, "SG")
+    assert [line["discount_cents"] for line in invoice["lines"]] == [1, 1, 0]
+
+
+@pytest.mark.parametrize("prices,coupon,discounts", [([0, 0], 10, [0, 0]), ([0, 3], 10, [0, 3])])
+def test_zero_gross_and_coupon_cap(prices, coupon, discounts):
+    invoice = build_invoice([(str(i), price, 1, "books") for i, price in enumerate(prices)], coupon, 0, "SG")
+    assert [line["discount_cents"] for line in invoice["lines"]] == discounts
+    assert invoice["total_cents"] == 0
+
+
+def test_tax_rounds_per_line_and_shipping_depends_on_category():
+    lines = [("a", 6, 1, "standard"), ("b", 6, 1, "standard")]
+    invoice = build_invoice(lines, 0, 6, "SG")
+    assert [line["tax_cents"] for line in invoice["lines"]] == [1, 1]
+    assert invoice["shipping_tax_cents"] == 1
+    assert invoice["total_cents"] == 21
+    assert build_invoice([("book", 100, 1, "books")], 0, 100, "SG")["shipping_tax_cents"] == 0
+    assert build_invoice([("item", 100, 1, "standard")], 0, 100, "OR")["shipping_tax_cents"] == 0
+    assert build_invoice([("item", 0, 1, "standard")], 0, 100, "SG")["shipping_tax_cents"] == 9
+
+
+@pytest.mark.parametrize("lines,coupon,shipping,region", [
+    ([("a", 1, 1, "standard")], 0, 0, "unknown"),
+    ([("a", 1, 1, "unknown")], 0, 0, "SG"),
+    ([], 0, 0, "SG"),
+    ([("a", 1, 0, "standard")], 0, 0, "SG"),
+    ([("a", -1, 1, "standard")], 0, 0, "SG"),
+    ([("a", 1, 1, "standard")], -1, 0, "SG"),
+    ([("a", 1, 1, "standard")], 0, -1, "SG"),
+])
+def test_invalid_inputs_raise_shop_error(lines, coupon, shipping, region):
+    with pytest.raises(ShopError):
+        build_invoice(lines, coupon, shipping, region)
