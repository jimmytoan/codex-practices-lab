+def test_split_uses_first_fit_decreasing_and_packing_order():
+    items = [("small", 100, 1), ("medium", 300, 1), ("large", 600, 1),
+             ("other", 500, 1), ("extra", 200, 1)]
+    assert split_parcels(items, 1000) == [
+        ["large", "medium", "small"], ["other", "extra"]
+    ]
