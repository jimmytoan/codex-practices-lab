+def test_split_sorts_equal_weights_by_sku_and_expands_quantities():
+    items = [("z", 400, 2), ("a", 400, 2), ("b", 200, 1)]
+    assert split_parcels(items, 1000) == [["a", "a", "b"], ["z", "z"]]
