@@ -1,5 +1,7 @@
 """Shipping costs and parcel splitting. See docs/shipping.md."""
 
+from shoplib.errors import ShopError
+
 # (upper bound in grams, cost in cents)
 TIERS = [(1000, 500), (2000, 800), (5000, 1200), (20000, 2500)]
 
@@ -16,9 +18,53 @@ def shipping_cost(weight_g: int) -> int:
 
 def split_parcels(items: list[tuple[str, int, int]], max_weight_g: int) -> list[list[str]]:
     """Split order items into parcels. See docs/shipping.md."""
-    raise NotImplementedError
+    units = _sorted_units(items, max_weight_g)
+    parcels: list[list[str]] = []
+    weights: list[int] = []
+    for sku, weight in units:
+        for index, parcel_weight in enumerate(weights):
+            if parcel_weight + weight <= max_weight_g:
+                parcels[index].append(sku)
+                weights[index] += weight
+                break
+        else:
+            parcels.append([sku])
+            weights.append(weight)
+    return parcels
 
 
 def shipment_cost(items: list[tuple[str, int, int]], max_weight_g: int) -> int:
     """Total shipping cost of an order. See docs/shipping.md."""
-    raise NotImplementedError
+    parcels = split_parcels(items, max_weight_g)
+    weights = [0] * len(parcels)
+    positions = [0] * len(parcels)
+
+    # Replay the packing order to recover weights, even when the same SKU
+    # occurs in multiple item lines with different unit weights.
+    for sku, weight in _sorted_units(items, max_weight_g):
+        for index, parcel in enumerate(parcels):
+            if (positions[index] < len(parcel)
+                    and parcel[positions[index]] == sku
+                    and weights[index] + weight <= max_weight_g):
+                weights[index] += weight
+                positions[index] += 1
+                break
+
+    try:
+        return sum(shipping_cost(weight) for weight in weights)
+    except ValueError as exc:
+        raise ShopError(str(exc)) from exc
+
+
+def _sorted_units(items: list[tuple[str, int, int]], max_weight_g: int) -> list[tuple[str, int]]:
+    units = []
+    for sku, weight, qty in items:
+        if qty < 1:
+            raise ShopError("quantity must be positive")
+        if weight < 1:
+            raise ShopError("weight must be positive")
+        if weight > max_weight_g:
+            raise ShopError("unit is too heavy")
+        units.extend([(sku, weight)] * qty)
+    units.sort(key=lambda unit: (-unit[1], unit[0]))
+    return units
