@@ -0,0 +1,74 @@
+import pytest
+
+from shoplib.errors import ShopError
+from shoplib.invoice import build_invoice
+
+
+def test_coupon_allocation_tax_and_total():
+    invoice = build_invoice(
+        [("a", 100, 2, "standard"), ("b", 100, 1, "food"),
+         ("c", 100, 1, "books")],
+        3, 50, "DE",
+    )
+    assert invoice == {
+        "lines": [
+            {"sku": "a", "gross_cents": 200, "discount_cents": 1,
+             "net_cents": 199, "tax_cents": 38},
+            {"sku": "b", "gross_cents": 100, "discount_cents": 1,
+             "net_cents": 99, "tax_cents": 7},
+            {"sku": "c", "gross_cents": 100, "discount_cents": 1,
+             "net_cents": 99, "tax_cents": 7},
+        ],
+        "shipping_cents": 50,
+        "shipping_tax_cents": 10,
+        "total_cents": 509,
+    }
+
+
+def test_largest_remainders_and_input_order_break_ties():
+    invoice = build_invoice(
+        [("small", 1, 1, "books"), ("big", 5, 1, "books"),
+         ("equal", 5, 1, "books")], 3, 0, "OR",
+    )
+    assert [line["discount_cents"] for line in invoice["lines"]] == [0, 2, 1]
+
+
+def test_coupon_capped_and_shipping_tax_depends_on_category_not_net():
+    invoice = build_invoice([("a", 25, 2, "standard")], 100, 50, "DE")
+    assert invoice["lines"][0] == {
+        "sku": "a", "gross_cents": 50, "discount_cents": 50,
+        "net_cents": 0, "tax_cents": 0,
+    }
+    assert invoice["shipping_tax_cents"] == 10
+    assert invoice["total_cents"] == 60
+
+
+def test_zero_gross_and_zero_rate_categories_do_not_tax_shipping():
+    invoice = build_invoice([("a", 0, 1, "books"), ("b", 0, 2, "books")], 10, 100, "SG")
+    assert [line["discount_cents"] for line in invoice["lines"]] == [0, 0]
+    assert invoice["shipping_tax_cents"] == 0
+    assert invoice["total_cents"] == 100
+
+
+def test_tax_is_rounded_half_up_per_line():
+    invoice = build_invoice([("a", 50, 1, "standard"), ("b", 50, 1, "standard")], 0, 0, "SG")
+    assert [line["tax_cents"] for line in invoice["lines"]] == [5, 5]
+    assert invoice["total_cents"] == 110
+
+
+@pytest.mark.parametrize(
+    "lines,coupon,shipping,region",
+    [
+        ([("a", 1, 1, "standard")], 0, 0, "unknown"),
+        ([("a", 1, 1, "unknown")], 0, 0, "DE"),
+        ([], 0, 0, "DE"),
+        ([("a", 1, 0, "standard")], 0, 0, "DE"),
+        ([("a", 1, -1, "standard")], 0, 0, "DE"),
+        ([("a", -1, 1, "standard")], 0, 0, "DE"),
+        ([("a", 1, 1, "standard")], -1, 0, "DE"),
+        ([("a", 1, 1, "standard")], 0, -1, "DE"),
+    ],
+)
+def test_invalid_arguments(lines, coupon, shipping, region):
+    with pytest.raises(ShopError):
+        build_invoice(lines, coupon, shipping, region)
