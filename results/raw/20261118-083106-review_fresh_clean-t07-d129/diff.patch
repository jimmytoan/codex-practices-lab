+from datetime import date
+
+import pytest
+
+from shoplib.discounts import Coupon, apply_coupon, apply_coupons
+from shoplib.errors import ShopError
 
 
 def test_percent():
@@ -7,3 +12,53 @@ def test_percent():
 
 def test_fixed_never_negative():
     assert apply_coupon(300, Coupon("FIVE", "fixed", 500)) == 0
+
+
+def test_apply_coupons_uses_best_percent_then_all_fixed_coupons():
+    coupons = [
+        Coupon("P10", "percent", 10),
+        Coupon("P20", "percent", 20),
+        Coupon("F100", "fixed", 100),
+        Coupon("F200", "fixed", 200),
+    ]
+
+    assert apply_coupons(1000, coupons, date(2026, 1, 1)) == (500, ["F100", "F200", "P20"])
+
+
+def test_apply_coupons_breaks_percent_ties_by_code_and_sorts_applied_codes():
+    coupons = [
+        Coupon("Z", "percent", 15),
+        Coupon("B", "fixed", 50),
+        Coupon("A", "percent", 15),
+    ]
+
+    assert apply_coupons(1000, coupons, date(2026, 1, 1)) == (800, ["A", "B"])
+
+
+def test_apply_coupons_expiry_is_inclusive_and_minimum_uses_original_subtotal():
+    coupons = [
+        Coupon("TODAY", "fixed", 100, expires=date(2026, 1, 1), min_subtotal_cents=1000),
+        Coupon("OLD", "fixed", 200, expires=date(2025, 12, 31)),
+        Coupon("TOO_HIGH", "fixed", 300, min_subtotal_cents=1001),
+        Coupon("PERCENT", "percent", 50),
+    ]
+
+    assert apply_coupons(1000, coupons, date(2026, 1, 1)) == (400, ["PERCENT", "TODAY"])
+
+
+def test_apply_coupons_clamps_at_zero_and_handles_no_eligible_coupons():
+    coupons = [
+        Coupon("PERCENT", "percent", 100),
+        Coupon("FIXED", "fixed", 500),
+        Coupon("EXPIRED", "fixed", 1, expires=date(2025, 12, 31)),
+    ]
+
+    assert apply_coupons(300, coupons, date(2026, 1, 1)) == (0, ["FIXED", "PERCENT"])
+    assert apply_coupons(300, [], date(2026, 1, 1)) == (300, [])
+
+
+def test_apply_coupons_rejects_negative_subtotals_and_unknown_kinds():
+    with pytest.raises(ValueError):
+        apply_coupons(-1, [], date(2026, 1, 1))
+    with pytest.raises(ShopError):
+        apply_coupons(100, [Coupon("BAD", "bogus", 1)], date(2026, 1, 1))
