@@ -0,0 +1,75 @@
+import pytest
+
+from shoplib.errors import ShopError
+from shoplib.search import Product, search
+
+
+PRODUCTS = [
+    Product("MUG-01", "Blue ceramic mug", 1000, ["drinkware", "Sale"]),
+    Product("MUG-02", "Blue travel cup", 1250, ["drinkware"]),
+    Product("PLATE-1", "Dinner plate", 500, ["sale"]),
+    Product("MUG*X", "Literal star", 100, ["star*tag"]),
+]
+
+
+def skus(query):
+    return [product.sku for product in search(PRODUCTS, query)]
+
+
+def test_empty_query_matches_everything_and_terms_are_anded_in_order():
+    assert skus("") == ["MUG-01", "MUG-02", "PLATE-1", "MUG*X"]
+    assert skus(" \t\n") == ["MUG-01", "MUG-02", "PLATE-1", "MUG*X"]
+    assert skus("blue mug") == ["MUG-01"]
+
+
+def test_quoted_phrases_and_quoted_field_values():
+    assert skus('"blue travel"') == ["MUG-02"]
+    assert skus('name:"Blue travel"') == ["MUG-02"]
+    assert skus('tag:"drinkware"') == ["MUG-01", "MUG-02"]
+    assert skus('sku:"mug-01"') == ["MUG-01"]
+
+
+def test_fields_are_case_insensitive_and_use_their_specified_match_modes():
+    assert skus("sku:mug-01") == ["MUG-01"]
+    assert skus("tag:SALE") == ["MUG-01", "PLATE-1"]
+    assert skus("name:CERAMIC") == ["MUG-01"]
+    assert skus("sku:MUG-*") == ["MUG-01", "MUG-02"]
+    assert skus("tag:drink*") == ["MUG-01", "MUG-02"]
+    assert skus("sku:MUG*X") == ["MUG*X"]
+    assert skus("sku:MUG**") == ["MUG*X"]
+    assert skus("name:star*") == []
+
+
+def test_price_comparisons_and_negation():
+    assert skus("price<500") == ["MUG*X"]
+    assert skus("price<=500") == ["PLATE-1", "MUG*X"]
+    assert skus("price>1000") == ["MUG-02"]
+    assert skus("price>=1000") == ["MUG-01", "MUG-02"]
+    assert skus("price=100") == ["MUG*X"]
+    assert skus("-tag:sale") == ["MUG-02", "MUG*X"]
+    assert skus('-"blue ceramic"') == ["MUG-02", "PLATE-1", "MUG*X"]
+
+
+@pytest.mark.parametrize(
+    "query",
+    [
+        "price:5",
+        "color:red",
+        "price>=",
+        "price>=1.5",
+        "price>=-1",
+        "tag:",
+        "sku:\"\"",
+        "-",
+        '"unfinished',
+        'name:"unfinished',
+    ],
+)
+def test_invalid_queries_raise_value_error(query):
+    with pytest.raises(ValueError):
+        search(PRODUCTS, query)
+
+
+def test_invalid_queries_use_shop_error_subclass():
+    with pytest.raises(ShopError):
+        search(PRODUCTS, "price>=1.5")
