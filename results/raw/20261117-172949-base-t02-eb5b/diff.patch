--- a/tests/test_cart.py
+++ b/tests/test_cart.py
@@ -1,6 +1,7 @@
 import pytest
 
 from shoplib.cart import Cart
+from shoplib.errors import ShopError
 
 
 def test_add_and_subtotal():
@@ -21,3 +22,39 @@ def test_add_same_sku_merges():
 def test_bad_qty():
     with pytest.raises(ValueError):
         Cart().add("A", 250, 0)
+
+
+@pytest.mark.parametrize(
+    ("qty", "expected"),
+    [(9, 2250), (10, 2375), (11, 2612)],
+)
+def test_line_discount_quantity_threshold(qty, expected):
+    cart = Cart()
+    cart.add("A", 250, qty)
+    assert cart.line_total("A") == expected
+    assert cart.subtotal() == expected
+
+
+def test_discount_rounds_each_line_half_up_in_subtotal():
+    cart = Cart()
+    cart.add("A", 1, 10)
+    cart.add("B", 1, 10)
+    cart.add("C", 1, 9)
+    assert cart.line_total("A") == 9
+    assert cart.line_total("B") == 9
+    assert cart.line_total("C") == 9
+    assert cart.subtotal() == 27
+
+
+def test_adding_same_sku_can_reach_discount_threshold():
+    cart = Cart()
+    cart.add("A", 100, 9)
+    assert cart.line_total("A") == 900
+    cart.add("A", 100)
+    assert cart.line_total("A") == 950
+    assert cart.subtotal() == 950
+
+
+def test_missing_line_total_raises_shop_error():
+    with pytest.raises(ShopError):
+        Cart().line_total("missing")
