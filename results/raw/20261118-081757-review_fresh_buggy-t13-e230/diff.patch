+++ b/tests/test_costing.py
@@ -0,0 +1,69 @@
+import pytest
+
+from shoplib.costing import fifo_costing
+from shoplib.errors import ShopError
+
+
+def test_returns_use_rounded_average_sale_cost():
+    events = [
+        {"type": "receive", "sku": "A", "qty": 1, "unit_cost_cents": 100},
+        {"type": "receive", "sku": "A", "qty": 1, "unit_cost_cents": 101},
+        {"type": "sell", "sku": "A", "qty": 2},
+        {"type": "return", "sku": "A", "qty": 1},
+    ]
+
+    assert fifo_costing(events) == {
+        "A": {"cogs_cents": 100, "on_hand": 1, "value_cents": 101}
+    }
+
+
+def test_returned_units_go_after_existing_lots_and_events_are_unchanged():
+    events = [
+        {"type": "receive", "sku": "A", "qty": 1, "unit_cost_cents": 100},
+        {"type": "receive", "sku": "A", "qty": 1, "unit_cost_cents": 200},
+        {"type": "sell", "sku": "A", "qty": 1},
+        {"type": "receive", "sku": "A", "qty": 1, "unit_cost_cents": 300},
+        {"type": "return", "sku": "A", "qty": 1},
+        {"type": "sell", "sku": "A", "qty": 1},
+    ]
+    original_events = [event.copy() for event in events]
+
+    assert fifo_costing(events) == {
+        "A": {"cogs_cents": 200, "on_hand": 2, "value_cents": 400}
+    }
+    assert events == original_events
+
+
+def test_returns_can_be_split_but_cannot_exceed_latest_sale_quantity():
+    events = [
+        {"type": "receive", "sku": "A", "qty": 3, "unit_cost_cents": 25},
+        {"type": "sell", "sku": "A", "qty": 3},
+        {"type": "return", "sku": "A", "qty": 1},
+        {"type": "return", "sku": "A", "qty": 2},
+    ]
+
+    assert fifo_costing(events) == {
+        "A": {"cogs_cents": 0, "on_hand": 3, "value_cents": 75}
+    }
+    with pytest.raises(ValueError):
+        fifo_costing(events + [{"type": "return", "sku": "A", "qty": 1}])
+
+
+@pytest.mark.parametrize(
+    "events",
+    [
+        [{"type": "receive", "sku": "A", "qty": 0, "unit_cost_cents": 10}],
+        [{"type": "receive", "sku": "A", "qty": 1, "unit_cost_cents": -1}],
+        [{"type": "sell", "sku": "A", "qty": 1}],
+        [{"type": "return", "sku": "A", "qty": 1}],
+        [
+            {"type": "receive", "sku": "A", "qty": 1, "unit_cost_cents": 10},
+            {"type": "sell", "sku": "A", "qty": 1},
+            {"type": "return", "sku": "A", "qty": 2},
+        ],
+        [{"type": "adjust", "sku": "A", "qty": 1}],
+    ],
+)
+def test_invalid_events_raise_value_error(events):
+    with pytest.raises(ShopError):
+        fifo_costing(events)
