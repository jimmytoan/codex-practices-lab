+++ b/tests/test_storedays.py
@@ -0,0 +1,80 @@
+import pytest
+
+from shoplib.errors import ShopError
+from shoplib.storedays import daily_revenue
+
+
+def test_empty_sales():
+    assert daily_revenue([]) == []
+
+
+def test_boundary_refunds_gaps_and_order():
+    sales = [
+        {"at": "2026-11-20T04:00:00+08:00", "cents": 500},
+        {"at": "2026-11-18T03:59:59+08:00", "cents": 1250},
+        {"at": "2026-11-18T04:00:00+08:00", "cents": 300},
+        {"at": "2026-11-18T02:30:00+08:00", "cents": -250},
+    ]
+    assert daily_revenue(sales) == [
+        ("2026-11-17", 1000),
+        ("2026-11-18", 300),
+        ("2026-11-19", 0),
+        ("2026-11-20", 500),
+    ]
+
+
+def test_equivalent_instants_in_different_zones():
+    sales = [
+        {"at": "2026-11-17T20:00:00Z", "cents": 100},
+        {"at": "2026-11-17T15:00:00-05:00", "cents": 200},
+        {"at": "2026-11-18T05:30:00+09:30", "cents": 300},
+    ]
+    assert daily_revenue(sales) == [("2026-11-18", 600)]
+
+
+def test_custom_offset_and_start_cross_year():
+    sales = [
+        {"at": "2027-01-01T04:59:59Z", "cents": 10},
+        {"at": "2027-01-01T05:00:00Z", "cents": 20},
+        {"at": "2027-01-03T05:00:00Z", "cents": 30},
+    ]
+    assert daily_revenue(sales, utc_offset_hours=-5, day_starts_hour=0) == [
+        ("2026-12-31", 10),
+        ("2027-01-01", 20),
+        ("2027-01-02", 0),
+        ("2027-01-03", 30),
+    ]
+
+
+def test_gap_includes_leap_day():
+    sales = [
+        {"at": "2028-02-28T04:00:00Z", "cents": 1},
+        {"at": "2028-03-01T04:00:00Z", "cents": 2},
+    ]
+    assert daily_revenue(sales, utc_offset_hours=0) == [
+        ("2028-02-28", 1), ("2028-02-29", 0), ("2028-03-01", 2)
+    ]
+
+
+@pytest.mark.parametrize("timestamp", [
+    "2026-11-18T02:30:00", "2026-11-18T02:30:00+0800",
+    "2026-11-18T02:30:00+08:60", "not a timestamp", "2026-13-18T02:30:00Z",
+])
+def test_invalid_timestamps_raise_shop_error(timestamp):
+    with pytest.raises(ShopError):
+        daily_revenue([{"at": timestamp, "cents": 100}])
+
+
+@pytest.mark.parametrize("kwargs", [
+    {"utc_offset_hours": 24}, {"utc_offset_hours": -24}, {"utc_offset_hours": 1.5},
+    {"day_starts_hour": -1}, {"day_starts_hour": 24}, {"day_starts_hour": True},
+])
+def test_invalid_day_configuration(kwargs):
+    with pytest.raises(ShopError):
+        daily_revenue([], **kwargs)
+
+
+@pytest.mark.parametrize("sales", [None, [{}], [{"at": "2026-11-18T00:00:00Z", "cents": 1.5}]])
+def test_invalid_sales(sales):
+    with pytest.raises(ShopError):
+        daily_revenue(sales)
