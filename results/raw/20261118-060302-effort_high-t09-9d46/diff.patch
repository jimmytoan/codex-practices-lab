+def test_slugify_transliterates_accents_and_keeps_non_latin_as_separator():
+    assert slugify("Crème Brûlée") == "creme-brulee"
+    assert slugify("Cafe\u0301") == "cafe"
+    assert slugify("a中b") == "a-b"
+
+
+def test_slugify_max_len_cuts_after_normalization_without_trailing_hyphen():
+    assert slugify("Crème Brûlée", max_len=7) == "creme-b"
+    assert slugify("Crème Brûlée", max_len=6) == "creme"
+
+
