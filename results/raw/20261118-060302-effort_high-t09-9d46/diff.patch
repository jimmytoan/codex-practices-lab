 """Text helpers for URLs and listings."""
 
 import re
+import unicodedata
 
 
 def slugify(text: str, max_len: int = 40) -> str:
@@ -14,7 +15,19 @@ def slugify(text: str, max_len: int = 40) -> str:
       leaves a trailing '-'.
     - If nothing is left, the slug is 'n-a'.
     """
-    slug = re.sub(r"[^a-z0-9]+", "-", text.lower()).strip("-")
+    lowered = unicodedata.normalize("NFKD", text.lower())
+    unaccented = []
+    after_ascii_letter = False
+    for char in lowered:
+        if unicodedata.combining(char):
+            if after_ascii_letter:
+                continue
+            unaccented.append(char)
+        else:
+            unaccented.append(char)
+            after_ascii_letter = char.isascii() and char.isalpha()
+
+    slug = re.sub(r"[^a-z0-9]+", "-", "".join(unaccented)).strip("-")
     slug = slug[:max_len].rstrip("-")
     return slug or "n-a"
 
diff --git a/tests/test_textutil.py b/tests/test_textutil.py
