diff --git a/src/shoplib/reports.py b/src/shoplib/reports.py
index d024fdc..0783441 100644
--- a/src/shoplib/reports.py
+++ b/src/shoplib/reports.py
@@ -23,5 +23,11 @@ def to_csv(rows: list[dict]) -> str:
     """Render summary rows as CSV, following docs/CONVENTIONS.md."""
     lines = [",".join(COLUMNS)]
     for row in rows:
-        lines.append(",".join(str(row[col]) for col in COLUMNS))
+        fields = []
+        for col in COLUMNS:
+            field = str(row[col])
+            if any(char in field for char in ',"\r\n'):
+                field = '"' + field.replace('"', '""') + '"'
+            fields.append(field)
+        lines.append(",".join(fields))
     return "\n".join(lines) + "\n"
diff --git a/tests/test_reports.py b/tests/test_reports.py
index a578302..6c28268 100644
--- a/tests/test_reports.py
+++ b/tests/test_reports.py
@@ -1,3 +1,8 @@
+import csv
+import io
+
+import pytest
+
 from shoplib.reports import sales_summary, to_csv
 
 SALES = [
@@ -16,3 +21,30 @@ def test_summary():
 
 def test_csv():
     assert to_csv(sales_summary(SALES)) == "sku,name,units,revenue_cents\nA,Mug,3,1350\nB,Bowl,1,900\n"
+
+
+@pytest.mark.parametrize(
+    ("value", "encoded"),
+    [
+        ("plain", "plain"),
+        ("", ""),
+        ("a,b", '"a,b"'),
+        ('a"b', '"a""b"'),
+        ("a\nb", '"a\nb"'),
+        ("a\rb", '"a\rb"'),
+        ("a\r\nb", '"a\r\nb"'),
+        ('a,"b"\nc', '"a,""b""\nc"'),
+    ],
+)
+def test_csv_field_escaping(value, encoded):
+    rows = [{"sku": value, "name": value, "units": value, "revenue_cents": value}]
+    result = to_csv(rows)
+    assert result == "sku,name,units,revenue_cents\n" + ",".join([encoded] * 4) + "\n"
+    assert list(csv.reader(io.StringIO(result, newline=""))) == [
+        ["sku", "name", "units", "revenue_cents"],
+        [value] * 4,
+    ]
+
+
+def test_csv_empty_rows():
+    assert to_csv([]) == "sku,name,units,revenue_cents\n"
