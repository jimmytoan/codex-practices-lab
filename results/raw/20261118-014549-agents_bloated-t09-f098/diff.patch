diff --git a/tests/test_textutil.py b/tests/test_textutil.py
index 4c83bb9..fd69fe9 100644
--- a/tests/test_textutil.py
+++ b/tests/test_textutil.py
@@ -1,3 +1,6 @@
+import pytest
+
+from shoplib.errors import ShopError
 from shoplib.textutil import slugify, truncate
 
 
@@ -6,6 +9,39 @@ def test_slugify_basic():
     assert slugify("!!!") == "n-a"
 
 
+def test_slugify_accented_letters_and_separators():
+    assert slugify(" Crème Brûlée / CAFÉ ") == "creme-brulee-cafe"
+    assert slugify("Cafe\u0301 déjà-vu") == "cafe-deja-vu"
+    assert slugify("a漢字b 12__34") == "a-b-12-34"
+    assert slugify("a\u20ddb") == "a-b"
+
+
+def test_slugify_length_limit():
+    assert slugify("one two three", 7) == "one-two"
+    assert slugify("one two three", 4) == "one"
+    assert slugify("hello", 2) == "he"
+    assert slugify("a", 1) == "a"
+    assert slugify("!", 3) == "n-a"
+    assert len(slugify("a" * 50)) == 40
+
+
+@pytest.mark.parametrize("max_len", [0, -1, 1.5, True])
+def test_slugify_rejects_invalid_length(max_len):
+    with pytest.raises(ShopError):
+        slugify("hello", max_len)
+
+
+@pytest.mark.parametrize("max_len", [1, 2])
+def test_slugify_rejects_fallback_that_does_not_fit(max_len):
+    with pytest.raises(ShopError):
+        slugify("!!!", max_len)
+
+
+def test_slugify_rejects_non_string_text():
+    with pytest.raises(ShopError):
+        slugify(None)
+
+
 def test_truncate():
     assert truncate("hello world", 8) == "hello..."
     assert truncate("short", 8) == "short"
