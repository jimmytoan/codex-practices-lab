diff --git a/src/shoplib/invoice.py b/src/shoplib/invoice.py
index 5d1398c..0c6f7e4 100644
--- a/src/shoplib/invoice.py
+++ b/src/shoplib/invoice.py
@@ -1,5 +1,8 @@
 """Invoices: coupon allocation and tax. See docs/invoicing.md."""
 
+from .errors import ShopError
+from .money import percent_of
+
 # Tax rates in percent, by region and product category.
 TAX_RATES = {
     "DE": {"standard": 19, "food": 7, "books": 7},
@@ -10,4 +13,75 @@ TAX_RATES = {
 
 def build_invoice(lines, coupon_cents: int, shipping_cents: int, region: str) -> dict:
     """Build an invoice for an order. See docs/invoicing.md."""
-    raise NotImplementedError
+    if not isinstance(region, str) or region not in TAX_RATES:
+        raise ShopError(f"unknown region {region!r}")
+    if not lines:
+        raise ShopError("invoice must have at least one line")
+    if not isinstance(coupon_cents, int) or isinstance(coupon_cents, bool):
+        raise ShopError("coupon must be an integer number of cents")
+    if not isinstance(shipping_cents, int) or isinstance(shipping_cents, bool):
+        raise ShopError("shipping must be an integer number of cents")
+    if coupon_cents < 0:
+        raise ShopError("coupon must not be negative")
+    if shipping_cents < 0:
+        raise ShopError("shipping must not be negative")
+
+    rates = TAX_RATES[region]
+    validated_lines = []
+    for line in lines:
+        try:
+            sku, unit_price_cents, qty, category = line
+        except (TypeError, ValueError):
+            raise ShopError("each line must contain sku, price, quantity and category") from None
+
+        if not isinstance(category, str) or category not in rates:
+            raise ShopError(f"unknown category {category!r} for region {region!r}")
+        if not isinstance(unit_price_cents, int) or isinstance(unit_price_cents, bool):
+            raise ShopError("price must be an integer number of cents")
+        if not isinstance(qty, int) or isinstance(qty, bool):
+            raise ShopError("quantity must be an integer")
+        if unit_price_cents < 0:
+            raise ShopError("price must not be negative")
+        if qty < 1:
+            raise ShopError("quantity must be at least 1")
+        validated_lines.append((sku, unit_price_cents * qty, rates[category]))
+
+    gross_total = sum(gross for _, gross, _ in validated_lines)
+    discount_total = min(coupon_cents, gross_total)
+    discounts = [0] * len(validated_lines)
+    if gross_total:
+        remainders = []
+        for index, (_, gross, _) in enumerate(validated_lines):
+            discounts[index], remainder = divmod(discount_total * gross, gross_total)
+            remainders.append((remainder, index))
+
+        undistributed_cents = discount_total - sum(discounts)
+        for _, index in sorted(remainders, key=lambda item: (-item[0], item[1]))[:undistributed_cents]:
+            discounts[index] += 1
+
+    invoice_lines = []
+    for (sku, gross, rate), discount in zip(validated_lines, discounts):
+        net = gross - discount
+        invoice_lines.append({
+            "sku": sku,
+            "gross_cents": gross,
+            "discount_cents": discount,
+            "net_cents": net,
+            "tax_cents": percent_of(net, rate),
+        })
+
+    shipping_tax = 0
+    if any(rate > 0 for _, _, rate in validated_lines):
+        shipping_tax = percent_of(shipping_cents, rates["standard"])
+
+    total = (
+        sum(line["net_cents"] + line["tax_cents"] for line in invoice_lines)
+        + shipping_cents
+        + shipping_tax
+    )
+    return {
+        "lines": invoice_lines,
+        "shipping_cents": shipping_cents,
+        "shipping_tax_cents": shipping_tax,
+        "total_cents": total,
+    }
diff --git a/tests/test_invoice.py b/tests/test_invoice.py
new file mode 100644
index 0000000..e9b1747
--- /dev/null
+++ b/tests/test_invoice.py
@@ -0,0 +1,99 @@
+import pytest
+
+from shoplib.invoice import build_invoice
+
+
+def test_invoice_splits_coupon_proportionally_with_input_order_ties():
+    invoice = build_invoice(
+        [("first", 1, 1, "food"), ("second", 1, 1, "food"), ("third", 1, 1, "food")],
+        coupon_cents=2,
+        shipping_cents=0,
+        region="OR",
+    )
+
+    assert [line["discount_cents"] for line in invoice["lines"]] == [1, 1, 0]
+    assert sum(line["discount_cents"] for line in invoice["lines"]) == 2
+
+
+def test_invoice_uses_largest_remainders_and_caps_coupon_at_gross():
+    invoice = build_invoice(
+        [("large", 3, 1, "food"), ("medium", 2, 1, "food"), ("small", 1, 1, "food")],
+        coupon_cents=20,
+        shipping_cents=0,
+        region="OR",
+    )
+
+    assert [line["discount_cents"] for line in invoice["lines"]] == [3, 2, 1]
+    assert [line["net_cents"] for line in invoice["lines"]] == [0, 0, 0]
+    assert invoice["total_cents"] == 0
+
+
+def test_invoice_computes_tax_per_line_and_taxes_shipping_when_any_line_is_taxable():
+    invoice = build_invoice(
+        [("food", 1000, 1, "food"), ("book", 1001, 1, "books")],
+        coupon_cents=100,
+        shipping_cents=100,
+        region="DE",
+    )
+
+    assert invoice["lines"] == [
+        {
+            "sku": "food",
+            "gross_cents": 1000,
+            "discount_cents": 50,
+            "net_cents": 950,
+            "tax_cents": 67,
+        },
+        {
+            "sku": "book",
+            "gross_cents": 1001,
+            "discount_cents": 50,
+            "net_cents": 951,
+            "tax_cents": 67,
+        },
+    ]
+    assert invoice["shipping_tax_cents"] == 19
+    assert invoice["total_cents"] == 2154
+
+
+def test_invoice_leaves_zero_gross_discounts_zero():
+    invoice = build_invoice(
+        [("free", 0, 2, "food")],
+        coupon_cents=50,
+        shipping_cents=0,
+        region="DE",
+    )
+
+    assert invoice["lines"][0]["discount_cents"] == 0
+    assert invoice["total_cents"] == 0
+
+
+def test_invoice_does_not_tax_shipping_when_all_line_rates_are_zero():
+    invoice = build_invoice(
+        [("book", 1000, 1, "books")],
+        coupon_cents=0,
+        shipping_cents=100,
+        region="SG",
+    )
+
+    assert invoice["shipping_tax_cents"] == 0
+    assert invoice["total_cents"] == 1100
+
+
+@pytest.mark.parametrize(
+    "lines,coupon,shipping,region",
+    [
+        ([("item", 1, 1, "food")], 0, 0, "XX"),
+        ([("item", 1, 1, "unknown")], 0, 0, "DE"),
+        ([], 0, 0, "DE"),
+        ([("item", 1, 0, "food")], 0, 0, "DE"),
+        ([("item", -1, 1, "food")], 0, 0, "DE"),
+        ([("item", 1, 1, "food")], -1, 0, "DE"),
+        ([("item", 1, 1, "food")], 0, -1, "DE"),
+        ([("item", 1.5, 1, "food")], 0, 0, "DE"),
+        ([("item", 1, 1.5, "food")], 0, 0, "DE"),
+    ],
+)
+def test_invoice_rejects_invalid_arguments(lines, coupon, shipping, region):
+    with pytest.raises(ValueError):
+        build_invoice(lines, coupon, shipping, region)
