 from shoplib.reports import sales_summary, to_csv
 
 SALES = [
@@ -16,3 +19,25 @@ def test_summary():
 
 def test_csv():
     assert to_csv(sales_summary(SALES)) == "sku,name,units,revenue_cents\nA,Mug,3,1350\nB,Bowl,1,900\n"
+
+
+def test_csv_quotes_special_fields_and_round_trips():
+    rows = [
+        {"sku": "A,1", "name": 'A "quoted"\nname', "units": 3, "revenue_cents": 1350},
+        {"sku": "B\r2", "name": "first\r\nsecond", "units": "", "revenue_cents": None},
+    ]
+    result = to_csv(rows)
+    assert result == (
+        'sku,name,units,revenue_cents\n'
+        '"A,1","A ""quoted""\nname",3,1350\n'
+        '"B\r2","first\r\nsecond",,None\n'
+    )
+    assert list(csv.reader(io.StringIO(result, newline=""))) == [
+        ["sku", "name", "units", "revenue_cents"],
+        ["A,1", 'A "quoted"\nname', "3", "1350"],
+        ["B\r2", "first\r\nsecond", "", "None"],
+    ]
+
+
+def test_csv_empty_rows_has_header():
+    assert to_csv([]) == "sku,name,units,revenue_cents\n"
