@@ -1,3 +1,6 @@
+import pytest
+
+from shoplib.errors import ShopError
 from shoplib.textutil import slugify, truncate
 
 
@@ -6,6 +9,55 @@ def test_slugify_basic():
     assert slugify("!!!") == "n-a"
 
 
+@pytest.mark.parametrize(
+    ("text", "expected"),
+    [
+        ("Crème Brûlée", "creme-brulee"),
+        ("CRE\u0300ME BRU\u0302LE\u0301E", "creme-brulee"),
+        ("Łódź Øresund Đà Nẵng", "lodz-oresund-da-nang"),
+        ("  À!B__123...Ç  ", "a-b-123-c"),
+        ("a\u0301b \u0301 c", "ab-c"),
+        ("red東京blue Æ œ ß", "red-blue"),
+        ("東京!!!", "n-a"),
+        ("", "n-a"),
+    ],
+)
+def test_slugify_normalizes_accents_and_separators(text, expected):
+    assert slugify(text) == expected
+
+
+@pytest.mark.parametrize(
+    ("text", "max_len", "expected"),
+    [
+        ("Crème Brûlée", 7, "creme-b"),
+        ("Crème Brûlée", 6, "creme"),
+        ("  Élève  ", 1, "e"),
+        ("Élève", 2, "el"),
+        ("!!!", 3, "n-a"),
+        ("x" * 41, 40, "x" * 40),
+    ],
+)
+def test_slugify_length_limit(text, max_len, expected):
+    assert slugify(text, max_len) == expected
+
+
+@pytest.mark.parametrize("max_len", [0, -1, 1.5, True, None])
+def test_slugify_rejects_invalid_lengths(max_len):
+    with pytest.raises(ShopError):
+        slugify("hello", max_len)
+
+
+@pytest.mark.parametrize("max_len", [1, 2])
+def test_slugify_rejects_length_too_short_for_fallback(max_len):
+    with pytest.raises(ShopError):
+        slugify("!!!", max_len)
+
+
+def test_slugify_rejects_invalid_text():
+    with pytest.raises(ShopError):
+        slugify(None)
+
+
 def test_truncate():
     assert truncate("hello world", 8) == "hello..."
     assert truncate("short", 8) == "short"
