 def test_percent():
@@ -7,3 +12,40 @@ def test_percent():
 
 def test_fixed_never_negative():
     assert apply_coupon(300, Coupon("FIVE", "fixed", 500)) == 0
+
+
+def test_combines_eligible_coupons_using_original_subtotal():
+    today = date(2026, 1, 10)
+    coupons = [
+        Coupon("Z_FIXED", "fixed", 100, expires=today, min_subtotal_cents=1000),
+        Coupon("LOW", "percent", 10),
+        Coupon("B_PERCENT", "percent", 20),
+        Coupon("A_PERCENT", "percent", 20),
+        Coupon("A_FIXED", "fixed", 50, min_subtotal_cents=1000),
+        Coupon("EXPIRED", "fixed", 100, expires=today - timedelta(days=1)),
+        Coupon("MINIMUM", "percent", 90, min_subtotal_cents=1001),
+    ]
+    assert apply_coupons(1000, coupons, today) == (
+        650, ["A_FIXED", "A_PERCENT", "Z_FIXED"]
+    )
+
+
+def test_percent_rounds_half_up_before_fixed_and_clamps_total():
+    today = date(2026, 1, 10)
+    assert apply_coupons(5, [Coupon("P", "percent", 10)], today) == (4, ["P"])
+    assert apply_coupons(5, [Coupon("P", "percent", 10), Coupon("F", "fixed", 10)], today) == (0, ["F", "P"])
+
+
+def test_no_eligible_coupons_and_zero_subtotal():
+    today = date(2026, 1, 10)
+    assert apply_coupons(0, [], today) == (0, [])
+    assert apply_coupons(0, [Coupon("F", "fixed", 1), Coupon("P", "percent", 10)], today) == (0, ["F", "P"])
+    assert apply_coupons(100, [Coupon("F", "fixed", 10, min_subtotal_cents=101)], today) == (100, [])
+
+
+def test_invalid_arguments_raise_shop_error():
+    today = date(2026, 1, 10)
+    with pytest.raises(ShopError):
+        apply_coupons(-1, [], today)
+    with pytest.raises(ShopError):
+        apply_coupons(100, [Coupon("BAD", "other", 1)], today)
