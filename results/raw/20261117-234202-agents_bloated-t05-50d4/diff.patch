@@ -1,3 +1,8 @@
+import csv
+import io
+
+import pytest
+
 from shoplib.reports import sales_summary, to_csv
 
 SALES = [
@@ -16,3 +21,25 @@ def test_summary():
 
 def test_csv():
     assert to_csv(sales_summary(SALES)) == "sku,name,units,revenue_cents\nA,Mug,3,1350\nB,Bowl,1,900\n"
+
+
+@pytest.mark.parametrize(
+    ("value", "encoded"),
+    [
+        ("red, blue", '"red, blue"'),
+        ('a "quote"', '"a ""quote"""'),
+        ("first\nsecond", '"first\nsecond"'),
+        ("first\rsecond", '"first\rsecond"'),
+        ('a,"b"\r\nc', '"a,""b""\r\nc"'),
+        ("", ""),
+    ],
+)
+def test_csv_special_fields(value, encoded):
+    row = dict.fromkeys(("sku", "name", "units", "revenue_cents"), value)
+    result = to_csv([row])
+    assert result == "sku,name,units,revenue_cents\n" + ",".join([encoded] * 4) + "\n"
+    assert list(csv.reader(io.StringIO(result, newline="")))[1] == [value] * 4
+
+
+def test_csv_empty_has_header():
+    assert to_csv([]) == "sku,name,units,revenue_cents\n"
