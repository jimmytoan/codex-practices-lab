diff --git a/src/shoplib/invoice.py b/src/shoplib/invoice.py
index 5d1398c..af0bdc1 100644
--- a/src/shoplib/invoice.py
+++ b/src/shoplib/invoice.py
@@ -1,5 +1,7 @@
 """Invoices: coupon allocation and tax. See docs/invoicing.md."""
 
+from .money import percent_of
+
 # Tax rates in percent, by region and product category.
 TAX_RATES = {
     "DE": {"standard": 19, "food": 7, "books": 7},
@@ -10,4 +12,76 @@ TAX_RATES = {
 
 def build_invoice(lines, coupon_cents: int, shipping_cents: int, region: str) -> dict:
     """Build an invoice for an order. See docs/invoicing.md."""
-    raise NotImplementedError
+    try:
+        rates = TAX_RATES[region]
+    except (KeyError, TypeError):
+        raise ValueError("unknown region") from None
+
+    if not lines:
+        raise ValueError("lines must not be empty")
+    if not isinstance(coupon_cents, int) or isinstance(coupon_cents, bool) or coupon_cents < 0:
+        raise ValueError("coupon must be a non-negative amount in cents")
+    if not isinstance(shipping_cents, int) or isinstance(shipping_cents, bool) or shipping_cents < 0:
+        raise ValueError("shipping must be a non-negative amount in cents")
+
+    prepared = []
+    for line in lines:
+        try:
+            sku, unit_price_cents, qty, category = line
+        except (TypeError, ValueError):
+            raise ValueError("each line must contain sku, price, quantity and category") from None
+
+        try:
+            rate = rates[category]
+        except (KeyError, TypeError):
+            raise ValueError("unknown category") from None
+        if not isinstance(unit_price_cents, int) or isinstance(unit_price_cents, bool) or unit_price_cents < 0:
+            raise ValueError("price must be a non-negative amount in cents")
+        if not isinstance(qty, int) or isinstance(qty, bool) or qty < 1:
+            raise ValueError("quantity must be at least 1")
+
+        gross = unit_price_cents * qty
+        prepared.append((sku, gross, rate, category))
+
+    total_gross = sum(gross for _, gross, _, _ in prepared)
+    coupon = min(coupon_cents, total_gross)
+
+    discounts = [0] * len(prepared)
+    if total_gross:
+        remainders = []
+        allocated = 0
+        for index, (_, gross, _, _) in enumerate(prepared):
+            discounts[index], remainder = divmod(coupon * gross, total_gross)
+            allocated += discounts[index]
+            remainders.append(remainder)
+
+        cents_left = coupon - allocated
+        for index in sorted(range(len(prepared)), key=lambda i: (-remainders[i], i))[:cents_left]:
+            discounts[index] += 1
+
+    invoice_lines = []
+    has_taxable_category = False
+    for (sku, gross, rate, _), discount in zip(prepared, discounts):
+        net = gross - discount
+        invoice_lines.append({
+            "sku": sku,
+            "gross_cents": gross,
+            "discount_cents": discount,
+            "net_cents": net,
+            "tax_cents": percent_of(net, rate),
+        })
+        if rate > 0:
+            has_taxable_category = True
+
+    shipping_tax = percent_of(shipping_cents, rates["standard"]) if has_taxable_category else 0
+    total = (
+        sum(line["net_cents"] + line["tax_cents"] for line in invoice_lines)
+        + shipping_cents
+        + shipping_tax
+    )
+    return {
+        "lines": invoice_lines,
+        "shipping_cents": shipping_cents,
+        "shipping_tax_cents": shipping_tax,
+        "total_cents": total,
+    }
diff --git a/tests/test_invoice.py b/tests/test_invoice.py
new file mode 100644
index 0000000..bf7a1a0
--- /dev/null
+++ b/tests/test_invoice.py
@@ -0,0 +1,60 @@
+import pytest
+
+from shoplib.invoice import build_invoice
+
+
+def test_coupon_is_split_by_largest_remainder_with_input_order_ties():
+    invoice = build_invoice(
+        [("A", 1, 1, "books"), ("B", 1, 1, "books"), ("C", 1, 1, "books")],
+        coupon_cents=2,
+        shipping_cents=0,
+        region="OR",
+    )
+
+    assert [line["discount_cents"] for line in invoice["lines"]] == [1, 1, 0]
+    assert [line["net_cents"] for line in invoice["lines"]] == [0, 0, 1]
+
+
+def test_coupon_is_capped_and_zero_gross_has_no_discount():
+    capped = build_invoice([("A", 25, 2, "books")], 100, 0, "OR")
+    assert capped["lines"][0]["discount_cents"] == 50
+    assert capped["total_cents"] == 0
+
+    zero_gross = build_invoice([("A", 0, 2, "books"), ("B", 0, 1, "food")], 5, 0, "DE")
+    assert [line["discount_cents"] for line in zero_gross["lines"]] == [0, 0]
+
+
+def test_line_tax_rounds_independently_and_shipping_uses_standard_rate():
+    invoice = build_invoice(
+        [("A", 1, 1, "food"), ("B", 1, 1, "books")],
+        coupon_cents=0,
+        shipping_cents=100,
+        region="DE",
+    )
+
+    assert [line["tax_cents"] for line in invoice["lines"]] == [0, 0]
+    assert invoice["shipping_tax_cents"] == 19
+    assert invoice["total_cents"] == 121
+
+
+def test_shipping_is_not_taxed_when_all_categories_are_zero_rated():
+    invoice = build_invoice([("A", 100, 1, "books")], 0, 100, "SG")
+    assert invoice["shipping_tax_cents"] == 0
+    assert invoice["total_cents"] == 200
+
+
+@pytest.mark.parametrize(
+    "lines,coupon,shipping,region",
+    [
+        ([("A", 1, 1, "books")], 0, 0, "XX"),
+        ([("A", 1, 1, "unknown")], 0, 0, "DE"),
+        ([], 0, 0, "DE"),
+        ([("A", 1, 0, "books")], 0, 0, "DE"),
+        ([("A", -1, 1, "books")], 0, 0, "DE"),
+        ([("A", 1, 1, "books")], -1, 0, "DE"),
+        ([("A", 1, 1, "books")], 0, -1, "DE"),
+    ],
+)
+def test_invalid_invoice_arguments_raise_value_error(lines, coupon, shipping, region):
+    with pytest.raises(ValueError):
+        build_invoice(lines, coupon, shipping, region)
