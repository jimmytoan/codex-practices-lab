@@ -0,0 +1,88 @@
+import pytest
+
+from shoplib.errors import ShopError
+from shoplib.search import Product, search
+
+
+@pytest.fixture
+def products():
+    return [
+        Product("MUG-BLUE", "Large Blue Mug", 1000, ["Sale", "Kitchen"]),
+        Product("mug-red", "Red mug", 999, ["SALE-NEW", "gift"]),
+        Product("PLATE*STAR", "Blue plate", 1500, ["Kitchen*ware"]),
+        Product("BOX", "Mug box", 1001),
+    ]
+
+
+@pytest.mark.parametrize("query", ["", "  \t\n "])
+def test_empty_query_returns_all_products_in_input_order(products, query):
+    assert search(products, query) == products
+
+
+@pytest.mark.parametrize(
+    ("query", "indexes"),
+    [
+        ("mUg", [0, 1, 3]),
+        ('"blue mug"', [0]),
+        ('name:"BLUE MUG"', [0]),
+        ("name:blue", [0, 2]),
+        ("sku:mUg-BlUe", [0]),
+        ("sku:mug", []),
+        ("sku:MUG-*", [0, 1]),
+        ("sku:PLATE*STAR", [2]),
+        ("sku:PLATE**", [2]),
+        ("tag:sAlE", [0]),
+        ("tag:sale*", [0, 1]),
+        ("tag:Kitchen*ware", [2]),
+        ("tag:Kitchen**", [2]),
+        ("tag:*", [0, 1, 2]),
+        ("price<1000", [1]),
+        ("price<=1000", [0, 1]),
+        ("price>1000", [2, 3]),
+        ("price>=1000", [0, 2, 3]),
+        ("price=1000", [0]),
+        ("price=0001000", [0]),
+        ("-tag:sale", [1, 2, 3]),
+        ("-sku:MUG-*", [2, 3]),
+        ("-price>=1000", [1]),
+        ('-"blue mug"', [1, 2, 3]),
+        ("mug tag:sale* -price>=1000", [1]),
+        ('name:"blue"\t-tag:"sale"', [2]),
+        ('""', [0, 1, 2, 3]),
+    ],
+)
+def test_search_terms(products, query, indexes):
+    assert search(products, query) == [products[index] for index in indexes]
+
+
+@pytest.mark.parametrize(
+    "query",
+    [
+        "color:blue", "price:5", ":value", "SKU:abc", "tag:", 'name:""',
+        "sku:", "-", '-""', '"unclosed', 'name:"unclosed value',
+        "price<", "price<=x", "price>1.0", "price>=-1", "price=+1",
+        "price==1", "price=>1", "price=1x", 'price="1 0"',
+    ],
+)
+def test_invalid_queries_raise_shop_error_even_without_products(query):
+    with pytest.raises(ShopError):
+        search([], query)
+
+
+def test_later_invalid_term_is_not_hidden_by_an_unmatched_term(products):
+    with pytest.raises(ShopError):
+        search(products, "no-such-product tag:")
+
+
+def test_quotes_preserve_whitespace_and_colons_in_field_values():
+    products = [Product("A B", "a\tblue: mug", 0, ["gift box"])]
+    assert search(products, 'sku:"A B" name:"blue: mug" tag:"gift box"') == products
+
+
+def test_large_whole_number_price_is_valid(products):
+    assert search(products, "price<" + "9" * 5000) == products
+
+
+def test_name_asterisk_is_literal_and_casefolding_handles_unicode():
+    products = [Product("STRASSE", "Straße * mug", 0, ["GRÜN"])]
+    assert search(products, "name:* sku:straße tag:grün") == products
