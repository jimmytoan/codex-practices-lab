diff --git a/tests/test_cart.py b/tests/test_cart.py
index 1a3d0e7..6265dcb 100644
--- a/tests/test_cart.py
+++ b/tests/test_cart.py
@@ -1,6 +1,7 @@
 import pytest
 
 from shoplib.cart import Cart
+from shoplib.errors import ShopError
 
 
 def test_add_and_subtotal():
@@ -21,3 +22,31 @@ def test_add_same_sku_merges():
 def test_bad_qty():
     with pytest.raises(ValueError):
         Cart().add("A", 250, 0)
+
+
+@pytest.mark.parametrize(
+    ("qty", "unit_price", "expected"),
+    [(9, 100, 900), (10, 100, 950), (11, 100, 1045), (10, 1, 9)],
+)
+def test_line_total_bulk_discount(qty, unit_price, expected):
+    cart = Cart()
+    cart.add("A", unit_price, qty)
+    assert cart.line_total("A") == expected
+
+
+def test_subtotal_applies_discounts_per_line_after_adding_quantities():
+    cart = Cart()
+    cart.add("A", 1, 9)
+    assert cart.line_total("A") == 9
+    cart.add("A", 1)
+    cart.add("B", 1, 10)
+    cart.add("C", 1, 9)
+    assert cart.line_total("A") == 9
+    assert cart.line_total("B") == 9
+    assert cart.line_total("C") == 9
+    assert cart.subtotal() == 27
+
+
+def test_line_total_missing_sku_raises_shop_error():
+    with pytest.raises(ShopError):
+        Cart().line_total("missing")
