@@ -0,0 +1,102 @@
+import pytest
+
+from shoplib.errors import ShopError
+from shoplib.search import Product, search
+
+
+@pytest.fixture
+def products():
+    return [
+        Product("MUG-Blue", "Big Blue Mug", 1000, ["Sale", "Kitchenware"]),
+        Product("MUG-red", "Red mug", 999, ["kitchen"]),
+        Product("TEA-1", "Blue tea", 1200, ["sale", "Tea*time"]),
+        Product("STAR*1", "A * item", 0),
+    ]
+
+
+@pytest.mark.parametrize("query", ["", "  \t\n  "])
+def test_empty_query_returns_every_product_in_order(products, query):
+    assert search(products, query) == products
+
+
+@pytest.mark.parametrize(
+    ("query", "indices"),
+    [
+        ("mUg", [0, 1]),
+        ('"BLUE mug"', [0]),
+        ('name:"blue mug"', [0]),
+        ("name:blue", [0, 2]),
+        ("sku:mug-blue", [0]),
+        ("tag:SALE", [0, 2]),
+        ("sku:mug-*", [0, 1]),
+        ("tag:kitchen*", [0, 1]),
+        ("sku:star*1", [3]),
+        ("tag:tea*time", [2]),
+        ("name:*", [3]),
+        ("tag:*", [0, 1, 2]),
+        ("blue tag:sale", [0, 2]),
+        ("blue -tag:sale", []),
+        ("-tag:sale", [1, 3]),
+        ('-name:"blue mug"', [1, 2, 3]),
+        ("-sku:mug-*", [2, 3]),
+        ("-price>=1000", [1, 3]),
+        ('""', [0, 1, 2, 3]),
+        ('name:"big blue" tag:KITCHEN*', [0]),
+        ("missing -tag:sale", []),
+    ],
+)
+def test_search_terms(products, query, indices):
+    assert search(products, query) == [products[i] for i in indices]
+
+
+@pytest.mark.parametrize(
+    ("query", "indices"),
+    [
+        ("price<1000", [1, 3]),
+        ("price<=1000", [0, 1, 3]),
+        ("price>1000", [2]),
+        ("price>=1000", [0, 2]),
+        ("price=1000", [0]),
+        ("price=0000", [3]),
+    ],
+)
+def test_price_comparisons(products, query, indices):
+    assert search(products, query) == [products[i] for i in indices]
+
+
+@pytest.mark.parametrize(
+    "query",
+    [
+        '"unclosed',
+        'name:"unclosed',
+        "unknown:value",
+        "price:5",
+        ":value",
+        "tag:",
+        'name:""',
+        "sku:",
+        "-",
+        '-""',
+        "price=",
+        "price<1.5",
+        "price>=-1",
+        "price>+1",
+        "price==1",
+        "price<=abc",
+        "price>1e3",
+        "missing tag:",
+    ],
+)
+def test_invalid_queries_are_rejected_even_without_products(products, query):
+    for candidates in (products, []):
+        with pytest.raises(ShopError):
+            search(candidates, query)
+
+
+def test_unicode_case_insensitive_matching():
+    product = Product("STRASSE", "Straße", 1, ["STRASSE"])
+    assert search([product], '"STRASSE" sku:straße tag:straße') == [product]
+
+
+def test_very_large_price_is_a_valid_whole_number(products):
+    assert search(products, "price<" + "9" * 5000) == products
