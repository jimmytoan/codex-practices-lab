@@ -13,4 +18,79 @@ class Product:
 
 def search(products: list[Product], query: str) -> list[Product]:
     """The products that match `query`, in their input order. See docs/search.md."""
-    raise NotImplementedError
+    terms = [_parse_term(token) for token in _tokens(query)]
+    return [product for product in products if all(term(product) for term in terms)]
+
+
+def _tokens(query: str) -> list[str]:
+    tokens = []
+    current = []
+    quoted = False
+    started = False
+    for char in query:
+        if char == '"':
+            quoted = not quoted
+            started = True
+        elif char.isspace() and not quoted:
+            if started:
+                tokens.append("".join(current))
+                current = []
+                started = False
+        else:
+            current.append(char)
+            started = True
+    if quoted:
+        raise ShopError("unclosed quote")
+    if started:
+        tokens.append("".join(current))
+    return tokens
+
+
+def _parse_term(token: str) -> Callable[[Product], bool]:
+    negated = token.startswith("-")
+    if negated:
+        token = token[1:]
+        if not token:
+            raise ShopError("empty negated term")
+
+    if ":" in token:
+        field_name, value = token.split(":", 1)
+        if field_name not in {"sku", "name", "tag"}:
+            raise ShopError("unknown search field")
+        if not value:
+            raise ShopError("empty field value")
+        value = value.casefold()
+        if field_name == "name":
+            matches = lambda product: value in product.name.casefold()
+        else:
+            prefix = value.endswith("*")
+            if prefix:
+                value = value[:-1]
+
+            def matches(product: Product) -> bool:
+                values = [product.sku] if field_name == "sku" else product.tags
+                if prefix:
+                    return any(item.casefold().startswith(value) for item in values)
+                return any(item.casefold() == value for item in values)
+    else:
+        price = re.fullmatch(r"price(<=|>=|<|>|=)(.*)", token, re.DOTALL)
+        if price:
+            symbol, amount = price.groups()
+            if not re.fullmatch(r"[0-9]+", amount):
+                raise ShopError("invalid price")
+            compare = {"<": operator.lt, "<=": operator.le, ">": operator.gt,
+                       ">=": operator.ge, "=": operator.eq}[symbol]
+            # Parse in chunks so Python's limit on decimal string conversion
+            # does not reject a valid, arbitrarily large whole number.
+            cents = 0
+            for start in range(0, len(amount), 9):
+                chunk = amount[start:start + 9]
+                cents = cents * 10 ** len(chunk) + int(chunk)
+            matches = lambda product: compare(product.price_cents, cents)
+        else:
+            value = token.casefold()
+            matches = lambda product: value in product.name.casefold()
+
+    if negated:
+        return lambda product: not matches(product)
+    return matches
