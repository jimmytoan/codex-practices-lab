diff --git a/src/shoplib/textutil.py b/src/shoplib/textutil.py
index 061dc23..4eee1be 100644
--- a/src/shoplib/textutil.py
+++ b/src/shoplib/textutil.py
@@ -1,6 +1,9 @@
 """Text helpers for URLs and listings."""
 
 import re
+import unicodedata
+
+from shoplib.errors import ShopError
 
 
 def slugify(text: str, max_len: int = 40) -> str:
@@ -13,8 +16,18 @@ def slugify(text: str, max_len: int = 40) -> str:
     - At most `max_len` characters, cut after the other steps; a cut never
       leaves a trailing '-'.
     - If nothing is left, the slug is 'n-a'.
+    - `max_len` must be at least 3 so the fallback also fits.
     """
-    slug = re.sub(r"[^a-z0-9]+", "-", text.lower()).strip("-")
+    if not isinstance(max_len, int) or max_len < 3:
+        raise ShopError("max_len must be an integer of at least 3")
+
+    normalized = unicodedata.normalize("NFD", text.lower())
+    unaccented = "".join(
+        character
+        for character in normalized
+        if not unicodedata.combining(character)
+    )
+    slug = re.sub(r"[^a-z0-9]+", "-", unaccented).strip("-")
     slug = slug[:max_len].rstrip("-")
     return slug or "n-a"
 
diff --git a/tests/test_textutil.py b/tests/test_textutil.py
