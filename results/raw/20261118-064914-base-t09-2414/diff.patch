--- a/tests/test_textutil.py
+++ b/tests/test_textutil.py
@@ -1,3 +1,6 @@
+import pytest
+
+from shoplib.errors import ShopError
 from shoplib.textutil import slugify, truncate
 
 
@@ -6,6 +9,22 @@ def test_slugify_basic():
     assert slugify("!!!") == "n-a"
 
 
+def test_slugify_transliterates_accented_latin_letters():
+    assert slugify("Crème Brûlée") == "creme-brulee"
+    assert slugify("NAÏVE façade") == "naive-facade"
+
+
+def test_slugify_truncates_after_normalizing_without_trailing_hyphen():
+    assert slugify("Crème Brûlée", max_len=7) == "creme-b"
+    assert slugify("Blue Mug", max_len=5) == "blue"
+
+
+@pytest.mark.parametrize("max_len", [0, 1, 2, 2.5, "3"])
+def test_slugify_requires_max_len_that_can_fit_fallback(max_len):
+    with pytest.raises(ShopError):
+        slugify("!!!", max_len=max_len)
+
+
 def test_truncate():
     assert truncate("hello world", 8) == "hello..."
     assert truncate("short", 8) == "short"
