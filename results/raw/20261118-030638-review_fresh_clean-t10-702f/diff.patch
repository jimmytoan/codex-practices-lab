+def test_split_parcels_first_fit_order_and_exact_capacity():
+    items = [("z", 4, 1), ("b", 6, 1), ("a", 6, 1), ("c", 4, 1), ("d", 2, 2)]
+    assert split_parcels(items, 12) == [["a", "b"], ["c", "z", "d", "d"]]
