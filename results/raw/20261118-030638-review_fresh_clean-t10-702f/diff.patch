 # (upper bound in grams, cost in cents)
 TIERS = [(1000, 500), (2000, 800), (5000, 1200), (20000, 2500)]
 
@@ -14,11 +16,52 @@ def shipping_cost(weight_g: int) -> int:
     raise ValueError("parcel is too heavy")
 
 
+def _pack(items, max_weight_g):
+    units = []
+    for sku, weight, qty in items:
+        if qty < 1 or weight < 1:
+            raise ShopError(f"bad item {sku}")
+        if weight > max_weight_g:
+            raise ShopError(f"{sku} is heavier than a parcel may be")
+        units.extend([(sku, weight)] * qty)
+    units.sort(key=lambda unit: (-unit[1], unit[0]))
+    parcels, loads = [], []
+    for sku, weight in units:
+        for i, load in enumerate(loads):
+            if load + weight <= max_weight_g:
+                parcels[i].append(sku)
+                loads[i] += weight
+                break
+        else:
+            parcels.append([sku])
+            loads.append(weight)
+    return parcels, loads
+
+
 def split_parcels(items: list[tuple[str, int, int]], max_weight_g: int) -> list[list[str]]:
     """Split order items into parcels. See docs/shipping.md."""
-    raise NotImplementedError
+    return _pack(items, max_weight_g)[0]
 
 
 def shipment_cost(items: list[tuple[str, int, int]], max_weight_g: int) -> int:
     """Total shipping cost of an order. See docs/shipping.md."""
-    raise NotImplementedError
+    parcels = split_parcels(items, max_weight_g)
+    # Reassociate weights with the packed SKUs in packing order. A SKU may
+    # occur in multiple input rows with different weights.
+    units = sorted(
+        ((sku, weight) for sku, weight, qty in items for _ in range(qty)),
+        key=lambda unit: (-unit[1], unit[0]),
+    )
+    loads = [0] * len(parcels)
+    positions = [0] * len(parcels)
+    for sku, weight in units:
+        for i, parcel in enumerate(parcels):
+            if (positions[i] < len(parcel) and parcel[positions[i]] == sku
+                    and loads[i] + weight <= max_weight_g):
+                loads[i] += weight
+                positions[i] += 1
+                break
+    try:
+        return sum(shipping_cost(load) for load in loads)
+    except ValueError as exc:
+        raise ShopError(str(exc)) from exc
