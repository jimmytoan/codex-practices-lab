+def test_split_parcels_uses_first_available_parcel():
+    assert split_parcels([("a", 8, 1), ("b", 7, 1), ("c", 3, 1), ("d", 2, 1)], 10) == [
+        ["a", "d"], ["b", "c"]
+    ]
+
+
+@pytest.mark.parametrize("items", [
+    [("a", 0, 1)], [("a", -1, 1)], [("a", 1, 0)],
+    [("a", 1, -1)], [("a", 11, 1)],
+])
+def test_split_parcels_rejects_invalid_items(items):
