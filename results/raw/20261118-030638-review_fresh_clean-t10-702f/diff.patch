+def test_shipment_cost_uses_split_parcels_and_preserves_weights(monkeypatch):
+    import shoplib.shipping as shipping
+
+    original = shipping.split_parcels
+    calls = []
+
+    def record_split(items, max_weight_g):
+        calls.append((items, max_weight_g))
+        return original(items, max_weight_g)
+
+    monkeypatch.setattr(shipping, "split_parcels", record_split)
+    # The 700 g unit fits in the first parcel after the 1300 g unit opens
+    # the second; parcel order is therefore different from unit order.
+    items = [("a", 1600, 1), ("a", 1300, 1), ("a", 700, 1)]
+    assert shipment_cost(items, 2400) == shipping_cost(2300) + shipping_cost(1300)
+    assert calls == [(items, 2400)]
+
+
+def test_shipment_cost_rejects_unshippable_parcel():
