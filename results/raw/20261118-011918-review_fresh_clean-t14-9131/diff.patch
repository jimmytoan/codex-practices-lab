--- a/src/shoplib/storedays.py
+++ b/src/shoplib/storedays.py
@@ -1,6 +1,29 @@
 """Revenue per store day. See docs/store-days.md."""
 
+from datetime import datetime, timedelta
+
+from shoplib.errors import ShopError
+
 
 def daily_revenue(sales: list[dict], utc_offset_hours: int = 8, day_starts_hour: int = 4) -> list[tuple[str, int]]:
     """Revenue per store day. See docs/store-days.md."""
-    raise NotImplementedError
+    totals: dict = {}
+    for sale in sales:
+        try:
+            at = datetime.fromisoformat(sale["at"])
+        except ValueError as exc:
+            raise ShopError(f"invalid timestamp: {sale['at']}") from exc
+        if at.tzinfo is None:
+            raise ShopError(f"timestamp without a zone: {sale['at']}")
+        shift = timedelta(hours=utc_offset_hours - day_starts_hour) - at.utcoffset()
+        day = (at.replace(tzinfo=None) + shift).date()
+        totals[day] = totals.get(day, 0) + sale["cents"]
+    if not totals:
+        return []
+    out, day, last = [], min(totals), max(totals)
+    while True:
+        out.append((day.isoformat(), totals.get(day, 0)))
+        if day == last:
+            break
+        day += timedelta(days=1)
+    return out
diff --git a/tests/test_storedays.py b/tests/test_storedays.py
new file mode 100644
index 0000000..f362ae1
--- /dev/null
+++ b/tests/test_storedays.py
@@ -0,0 +1,76 @@
+import pytest
+
+from shoplib.errors import ShopError
+from shoplib.storedays import daily_revenue
+
+
+def test_boundary_zones_refunds_and_gaps():
+    sales = [
+        {"at": "2026-11-21T04:00:00+08:00", "cents": 500},
+        {"at": "2026-11-17T19:59:59Z", "cents": 100},
+        {"at": "2026-11-17T12:00:00-08:00", "cents": 250},
+        {"at": "2026-11-18T04:00:00+08:00", "cents": -50},
+        {"at": "2026-11-18T02:30:00+08:00", "cents": 25},
+    ]
+    assert daily_revenue(sales) == [
+        ("2026-11-17", 125),
+        ("2026-11-18", 200),
+        ("2026-11-19", 0),
+        ("2026-11-20", 0),
+        ("2026-11-21", 500),
+    ]
+
+
+def test_custom_store_offset_and_start():
+    sales = [
+        {"at": "2026-11-18T09:59:59Z", "cents": 100},
+        {"at": "2026-11-18T10:00:00Z", "cents": 200},
+    ]
+    assert daily_revenue(sales, utc_offset_hours=-5, day_starts_hour=5) == [
+        ("2026-11-17", 100),
+        ("2026-11-18", 200),
+    ]
+
+
+def test_timestamp_offset_with_minutes():
+    sales = [
+        {"at": "2026-11-18T01:44:59+05:45", "cents": 100},
+        {"at": "2026-11-18T01:45:00+05:45", "cents": 200},
+    ]
+    assert daily_revenue(sales) == [
+        ("2026-11-17", 100),
+        ("2026-11-18", 200),
+    ]
+
+
+def test_offset_is_not_limited_to_timezone_constructor_range():
+    assert daily_revenue(
+        [{"at": "2026-11-18T00:00:00Z", "cents": 1}],
+        utc_offset_hours=24,
+        day_starts_hour=0,
+    ) == [("2026-11-19", 1)]
+
+
+def test_empty_sales():
+    assert daily_revenue([]) == []
+
+
+@pytest.mark.parametrize("timestamp", ["2026-11-18T02:30:00", "not a timestamp"])
+def test_invalid_timestamp_raises_shop_error(timestamp):
+    with pytest.raises(ShopError):
+        daily_revenue([{"at": timestamp, "cents": 100}])
+
+
+@pytest.mark.parametrize(
+    ("timestamp", "offset", "day"),
+    [
+        ("0001-01-01T00:00:00+08:00", 8, "0001-01-01"),
+        ("9999-12-31T23:59:59-01:00", -1, "9999-12-31"),
+    ],
+)
+def test_representable_dates_at_datetime_limits(timestamp, offset, day):
+    assert daily_revenue(
+        [{"at": timestamp, "cents": 100}],
+        utc_offset_hours=offset,
+        day_starts_hour=0,
+    ) == [(day, 100)]
