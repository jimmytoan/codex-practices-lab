+from datetime import date
+
+import pytest
+
+from shoplib.discounts import Coupon, apply_coupon, apply_coupons
+from shoplib.errors import ShopError
 
 
 def test_percent():
@@ -7,3 +12,38 @@ def test_percent():
 
 def test_fixed_never_negative():
     assert apply_coupon(300, Coupon("FIVE", "fixed", 500)) == 0
+
+
+def test_apply_coupons_selects_percent_and_uses_original_subtotal():
+    today = date(2026, 1, 10)
+    coupons = [
+        Coupon("Z10", "percent", 10),
+        Coupon("A10", "percent", 10, expires=today),
+        Coupon("LOW", "percent", 5),
+        Coupon("EXPIRED", "percent", 50, expires=date(2026, 1, 9)),
+        Coupon("TOO_HIGH", "percent", 90, min_subtotal_cents=106),
+        Coupon("ZFIX", "fixed", 20, min_subtotal_cents=105),
+        Coupon("AFIX", "fixed", 10),
+        Coupon("EXPIRED_FIXED", "fixed", 100, expires=date(2026, 1, 9)),
+        Coupon("MIN_FIXED", "fixed", 100, min_subtotal_cents=106),
+    ]
+    # 10% of 105 cents rounds half up to 11 cents; both fixed coupons apply.
+    assert apply_coupons(105, coupons, today) == (64, ["A10", "AFIX", "ZFIX"])
+
+
+def test_apply_coupons_clamps_total_and_reports_all_applied_codes():
+    coupons = [Coupon("B", "fixed", 100), Coupon("A", "fixed", 100)]
+    assert apply_coupons(50, coupons, date(2026, 1, 10)) == (0, ["A", "B"])
+    assert apply_coupons(50, [], date(2026, 1, 10)) == (50, [])
+
+
+def test_apply_coupons_rejects_negative_subtotal():
+    with pytest.raises(ShopError):
+        apply_coupons(-1, [], date(2026, 1, 10))
+
+
+@pytest.mark.parametrize("expires", [None, date(2026, 1, 9)])
+def test_apply_coupons_rejects_unknown_kind(expires):
+    coupon = Coupon("BAD", "unknown", 10, expires=expires)
+    with pytest.raises(ShopError, match="unknown coupon kind"):
+        apply_coupons(100, [coupon], date(2026, 1, 10))
