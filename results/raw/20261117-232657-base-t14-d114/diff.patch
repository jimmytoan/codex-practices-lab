@@ -0,0 +1,70 @@
+import pytest
+
+from shoplib.errors import ShopError
+from shoplib.storedays import daily_revenue
+
+
+def test_default_boundary_time_zones_refunds_and_gaps():
+    sales = [
+        {"at": "2026-11-20T04:00:00+08:00", "cents": 900},
+        {"at": "2026-11-17T18:30:00Z", "cents": 300},
+        {"at": "2026-11-17T19:59:59.999999Z", "cents": -50},
+        {"at": "2026-11-17T12:00:00-08:00", "cents": 100},
+        {"at": "2026-11-18T04:00:00+08:00", "cents": -20},
+    ]
+    assert daily_revenue(sales) == [
+        ("2026-11-17", 250),
+        ("2026-11-18", 80),
+        ("2026-11-19", 0),
+        ("2026-11-20", 900),
+    ]
+
+
+def test_custom_zone_and_boundary_across_year():
+    sales = [
+        {"at": "2027-01-01T06:59:59Z", "cents": 10},
+        {"at": "2027-01-01T07:00:00Z", "cents": 20},
+        {"at": "2027-01-03T01:00:00+05:30", "cents": 30},
+    ]
+    assert daily_revenue(sales, utc_offset_hours=-5, day_starts_hour=2) == [
+        ("2026-12-31", 10),
+        ("2027-01-01", 20),
+        ("2027-01-02", 30),
+    ]
+
+
+def test_midnight_boundary_and_leap_day_gap():
+    assert daily_revenue(
+        [{"at": "2024-02-28T00:00:00Z", "cents": 1},
+         {"at": "2024-03-01T00:00:00Z", "cents": 2}],
+        utc_offset_hours=0,
+        day_starts_hour=0,
+    ) == [("2024-02-28", 1), ("2024-02-29", 0), ("2024-03-01", 2)]
+
+
+def test_empty_sales():
+    assert daily_revenue([]) == []
+
+
+@pytest.mark.parametrize("timestamp", [
+    "2026-11-18T02:30:00", "2026-11-18T02:30:00+0800",
+    "2026-11-18T02:30:00+08:60", "not a timestamp", "2026-02-30T02:30:00Z",
+])
+def test_invalid_timestamp_raises_shop_error(timestamp):
+    with pytest.raises(ShopError):
+        daily_revenue([{"at": timestamp, "cents": 100}])
+
+
+@pytest.mark.parametrize("kwargs", [
+    {"utc_offset_hours": 24}, {"utc_offset_hours": -24}, {"utc_offset_hours": 1.5},
+    {"day_starts_hour": -1}, {"day_starts_hour": 24}, {"day_starts_hour": True},
+])
+def test_invalid_settings_raise_shop_error(kwargs):
+    with pytest.raises(ShopError):
+        daily_revenue([], **kwargs)
+
+
+@pytest.mark.parametrize("sales", [None, [{}], [{"at": "2026-11-18T00:00:00Z", "cents": 1.5}]])
+def test_invalid_sales_raise_shop_error(sales):
+    with pytest.raises(ShopError):
+        daily_revenue(sales)
