@@ -1,6 +1,51 @@
 """Revenue per store day. See docs/store-days.md."""
 
+from datetime import datetime, timedelta, timezone
+import re
+
+from .errors import ShopError
+
 
 def daily_revenue(sales: list[dict], utc_offset_hours: int = 8, day_starts_hour: int = 4) -> list[tuple[str, int]]:
-    """Revenue per store day. See docs/store-days.md."""
-    raise NotImplementedError
+    """Return total cents for each store day between the first and last sale."""
+    if type(utc_offset_hours) is not int or not -23 <= utc_offset_hours <= 23:
+        raise ShopError("invalid UTC offset")
+    if type(day_starts_hour) is not int or not 0 <= day_starts_hour <= 23:
+        raise ShopError("invalid store day start hour")
+    try:
+        sale_iter = iter(sales)
+    except TypeError as exc:
+        raise ShopError("invalid sales") from exc
+
+    store_zone = timezone(timedelta(hours=utc_offset_hours))
+    totals = {}
+    for sale in sale_iter:
+        if not isinstance(sale, dict) or "at" not in sale or "cents" not in sale:
+            raise ShopError("invalid sale")
+        timestamp, cents = sale["at"], sale["cents"]
+        if not isinstance(timestamp, str) or type(cents) is not int:
+            raise ShopError("invalid sale")
+        zone = re.search(r"(Z|[+-](\d{2}):(\d{2}))$", timestamp)
+        if not zone or (zone.group(2) and (int(zone.group(2)) > 23 or int(zone.group(3)) > 59)):
+            raise ShopError("invalid timestamp zone")
+        try:
+            instant = datetime.fromisoformat(timestamp)
+            if instant.tzinfo is None:
+                raise ShopError("timestamp must have a zone")
+            local = instant.astimezone(store_zone)
+            day = local.date()
+            if local.hour < day_starts_hour:
+                day -= timedelta(days=1)
+        except (ValueError, OverflowError) as exc:
+            raise ShopError("invalid timestamp") from exc
+        totals[day] = totals.get(day, 0) + cents
+
+    if not totals:
+        return []
+    day, last_day = min(totals), max(totals)
+    result = []
+    while True:
+        result.append((day.isoformat(), totals.get(day, 0)))
+        if day == last_day:
+            return result
+        day += timedelta(days=1)
