@@ -0,0 +1,64 @@
+import pytest
+
+from shoplib.search import Product, search
+
+
+@pytest.fixture
+def products():
+    return [
+        Product("MUG-RED", "Red ceramic mug", 1200, ["drinkware", "sale"]),
+        Product("MUG-BLUE", "Blue travel mug", 850, ["drinkware"]),
+        Product("PLATE", "Blue dinner plate", 1200, ["sale"]),
+    ]
+
+
+def test_bare_and_quoted_phrases_match_case_insensitive_name_substrings(products):
+    assert search(products, "MUG") == products[:2]
+    assert search(products, '"ceramic mug"') == products[:1]
+    assert search(products, 'name:"BLUE travel"') == products[1:2]
+
+
+def test_field_exact_prefix_and_name_matching(products):
+    assert search(products, "sku:mug-red") == products[:1]
+    assert search(products, "tag:SALE") == [products[0], products[2]]
+    assert search(products, "sku:MUG-*") == products[:2]
+    assert search(products, "tag:drink*") == products[:2]
+    assert search(products, "name:blue") == products[1:]
+    # A star that is not final is an ordinary character, not a wildcard.
+    assert search([Product("A*B", "Star", 1)], "sku:a*b")
+
+
+def test_price_comparisons_and_negation(products):
+    assert search(products, "price<1200") == products[1:2]
+    assert search(products, "price<=1200") == products
+    assert search(products, "price>850") == [products[0], products[2]]
+    assert search(products, "price>=1200") == [products[0], products[2]]
+    assert search(products, "price=850") == products[1:2]
+    assert search(products, "-tag:sale") == products[1:2]
+    assert search(products, '-"Blue"') == [products[0]]
+    assert search(products, "mug -tag:sale") == products[1:2]
+
+
+def test_whitespace_query_matches_everything(products):
+    assert search(products, " \t\n ") == products
+    assert search(products, "") == products
+
+
+@pytest.mark.parametrize(
+    "query",
+    [
+        "price:5",  # price is not a field
+        "color:red",  # unknown field
+        "tag:",  # empty field value
+        "sku:\"\"",  # quoted empty field value
+        "price>=abc",  # nonnumeric price
+        "price=",  # empty price
+        "price<1.5",  # not a whole number of cents
+        "-",  # missing negated term
+        '-""',  # an empty quoted phrase is still no term after '-'
+        '"unclosed',  # unclosed quote
+    ],
+)
+def test_invalid_queries_raise_value_error(products, query):
+    with pytest.raises(ValueError):
+        search(products, query)
