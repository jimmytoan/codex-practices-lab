@@ -0,0 +1,73 @@
+import pytest
+
+from shoplib.errors import ShopError
+from shoplib.search import Product, search
+
+
+@pytest.fixture
+def products():
+    return [
+        Product("MUG-1", "Blue ceramic mug", 1000, ["Sale", "Kitchenware"]),
+        Product("mug-2", "Red mug", 1500, ["SALE", "Gift"]),
+        Product("TEA*3", "Blue tea set", 999, ["Tea*Time"]),
+    ]
+
+
+@pytest.mark.parametrize(
+    ("query", "indices"),
+    [
+        ("", [0, 1, 2]),
+        (" \t\n", [0, 1, 2]),
+        ("BLUE", [0, 2]),
+        ('"ceramic mug"', [0]),
+        ('name:"CERAMIC MUG"', [0]),
+        ("name:mug", [0, 1]),
+        ("sku:Mug-1", [0]),
+        ("sku:mUg-*", [0, 1]),
+        ("sku:TEA*3", [2]),
+        ("tag:sale", [0, 1]),
+        ("tag:KITCHEN*", [0]),
+        ("tag:tea*time", [2]),
+        ("tag:tea*ti*", [2]),
+        ("price<1000", [2]),
+        ("price<=1000", [0, 2]),
+        ("price>1000", [1]),
+        ("price>=1000", [0, 1]),
+        ("price=1000", [0]),
+        ('price>="1000"', [0, 1]),
+        ("blue -tag:kitchen*", [2]),
+        ('-name:"red mug" sku:mug-*', [0]),
+        ('"sku:MUG-1"', []),
+        ('"price>=1000"', []),
+    ],
+)
+def test_search_terms(products, query, indices):
+    assert search(products, query) == [products[i] for i in indices]
+
+
+@pytest.mark.parametrize(
+    "query",
+    [
+        "unknown:x", "price:5", ":x", "tag:", 'name:""',
+        "-", '"unclosed', 'tag:"unclosed',
+        "price=", "price=1.5", "price=-1", "price=+1", "price=abc",
+        "price==1", 'price>="not a number"',
+        "no-match unknown:x", "-tag:",
+    ],
+)
+def test_search_errors_are_validated_even_without_matching_products(products, query):
+    with pytest.raises(ShopError):
+        search(products, query)
+    with pytest.raises(ShopError):
+        search([], query)
+
+
+def test_large_whole_number_price(products):
+    huge_price = "9" * 5000
+    assert search(products, "price<" + huge_price) == products
+
+
+@pytest.mark.parametrize("query", ["STRASSE", "name:STRASSE", "sku:STRASSE", "sku:STRASS*", "tag:STRASSE", "tag:STRASS*"])
+def test_unicode_case_insensitive_matching(query):
+    product = Product("Straße", "Straße", 1, ["Straße"])
+    assert search([product], query) == [product]
