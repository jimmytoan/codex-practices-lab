 def test_percent():
@@ -7,3 +12,34 @@ def test_percent():
 
 def test_fixed_never_negative():
     assert apply_coupon(300, Coupon("FIVE", "fixed", 500)) == 0
+
+
+def test_coupons_include_expiry_date_and_use_original_subtotal_for_minimum():
+    today = date(2026, 11, 18)
+    coupons = [
+        Coupon("EXPIRED", "fixed", 100, date(2026, 11, 17)),
+        Coupon("TODAY", "percent", 50, today),
+        Coupon("MINIMUM", "fixed", 100, min_subtotal_cents=1000),
+        Coupon("TOO_HIGH", "fixed", 100, min_subtotal_cents=1001),
+    ]
+    assert apply_coupons(1000, coupons, today) == (400, ["MINIMUM", "TODAY"])
+
+
+def test_percent_ties_choose_first_code_and_round_half_up():
+    coupons = [Coupon("Z", "percent", 50), Coupon("A", "percent", 50),
+               Coupon("LOW", "percent", 25)]
+    assert apply_coupons(101, coupons, date(2026, 11, 18)) == (50, ["A"])
+
+
+def test_all_fixed_coupons_apply_even_when_total_reaches_zero():
+    coupons = [Coupon("Z", "fixed", 200), Coupon("A", "fixed", 50)]
+    assert apply_coupons(100, coupons, date(2026, 11, 18)) == (0, ["A", "Z"])
+    assert apply_coupons(100, [], date(2026, 11, 18)) == (100, [])
+
+
+def test_negative_subtotal_and_unknown_coupon_kind_raise_shop_error():
+    today = date(2026, 11, 18)
+    with pytest.raises(ShopError):
+        apply_coupons(-1, [], today)
+    with pytest.raises(ShopError):
+        apply_coupons(100, [Coupon("BAD", "unknown", 10)], today)
