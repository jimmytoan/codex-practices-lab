@@ -0,0 +1,59 @@
+import pytest
+
+from shoplib.errors import ShopError
+from shoplib.storedays import daily_revenue
+
+
+def test_day_boundary_includes_exact_start():
+    sales = [
+        {"at": "2026-11-18T03:59:59.999999+08:00", "cents": 100},
+        {"at": "2026-11-18T04:00:00+08:00", "cents": 200},
+    ]
+    assert daily_revenue(sales) == [("2026-11-17", 100), ("2026-11-18", 200)]
+
+
+def test_time_zones_refunds_and_gaps():
+    sales = [
+        {"at": "2026-11-19T21:00:00-05:00", "cents": 300},
+        {"at": "2026-11-16T20:00:00Z", "cents": 100},
+        {"at": "2026-11-17T10:30:00+05:30", "cents": -40},
+    ]
+    assert daily_revenue(sales) == [
+        ("2026-11-17", 60),
+        ("2026-11-18", 0),
+        ("2026-11-19", 0),
+        ("2026-11-20", 300),
+    ]
+
+
+def test_custom_offset_and_day_start():
+    sales = [
+        {"at": "2026-11-18T10:59:59Z", "cents": 1},
+        {"at": "2026-11-18T11:00:00Z", "cents": 2},
+    ]
+    assert daily_revenue(sales, utc_offset_hours=-5, day_starts_hour=6) == [
+        ("2026-11-17", 1),
+        ("2026-11-18", 2),
+    ]
+
+
+def test_empty_sales():
+    assert daily_revenue([]) == []
+
+
+@pytest.mark.parametrize("timestamp", ["2026-11-18T04:00:00", "bad", None])
+def test_invalid_timestamps_raise_shop_error(timestamp):
+    with pytest.raises(ShopError):
+        daily_revenue([{"at": timestamp, "cents": 100}])
+
+
+def test_invalid_offset_raises_shop_error():
+    with pytest.raises(ShopError):
+        daily_revenue([], utc_offset_hours=24)
+
+
+def test_last_supported_date():
+    assert daily_revenue(
+        [{"at": "9999-12-31T12:00:00Z", "cents": 100}],
+        utc_offset_hours=0,
+    ) == [("9999-12-31", 100)]
