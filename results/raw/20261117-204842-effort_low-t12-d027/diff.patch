 """Product search. See docs/search.md."""
 
 from dataclasses import dataclass, field
+import re
 
 
 @dataclass
@@ -13,4 +14,85 @@ class Product:
 
 def search(products: list[Product], query: str) -> list[Product]:
     """The products that match `query`, in their input order. See docs/search.md."""
-    raise NotImplementedError
+    terms = _tokenize(query)
+    predicates = [_compile(term) for term in terms]
+    return [product for product in products if all(test(product) for test in predicates)]
+
+
+def _tokenize(query: str) -> list[tuple[str, list[int]]]:
+    """Return each token and the positions of its unquoted characters."""
+    result = []
+    chars: list[str] = []
+    unquoted: list[int] = []
+    quoted = False
+
+    def finish() -> None:
+        if chars:
+            result.append(("".join(chars), unquoted.copy()))
+            chars.clear()
+            unquoted.clear()
+
+    for char in query:
+        if char == '"':
+            quoted = not quoted
+        elif char.isspace() and not quoted:
+            finish()
+        else:
+            if not quoted:
+                unquoted.append(len(chars))
+            chars.append(char)
+    if quoted:
+        raise ValueError("unclosed quote")
+    finish()
+    return result
+
+
+def _compile(token: tuple[str, list[int]]):
+    text, unquoted_positions = token
+    unquoted = set(unquoted_positions)
+    negate = bool(text and text[0] == "-" and 0 in unquoted)
+    if negate:
+        text = text[1:]
+        unquoted = {position - 1 for position in unquoted if position > 0}
+        if not text:
+            raise ValueError("missing term after '-' ")
+
+    def contains(value: str):
+        return lambda product: value.casefold() in product.name.casefold()
+
+    field_colon = next((i for i, char in enumerate(text) if char == ":" and i in unquoted), None)
+    if field_colon is not None:
+        field_name, value = text[:field_colon], text[field_colon + 1:]
+        if field_name not in {"sku", "name", "tag"}:
+            raise ValueError(f"unknown search field: {field_name}")
+        if not value:
+            raise ValueError("empty field value")
+        folded = value.casefold()
+        if field_name == "name":
+            predicate = contains(value)
+        elif field_name == "sku":
+            prefix = value.endswith("*")
+            expected = value[:-1] if prefix else value
+            predicate = lambda product: (product.sku.casefold().startswith(expected.casefold())
+                                          if prefix else product.sku.casefold() == folded)
+        else:
+            prefix = value.endswith("*")
+            expected = value[:-1] if prefix else value
+            predicate = lambda product: any(tag.casefold().startswith(expected.casefold()) if prefix
+                                            else tag.casefold() == folded for tag in product.tags)
+    else:
+        match = re.fullmatch(r"price(<=|>=|<|>|=)(.*)", text)
+        if match:
+            op, raw = match.groups()
+            if not re.fullmatch(r"[0-9]+", raw):
+                raise ValueError("price comparison requires whole-number cents")
+            amount = int(raw)
+            ops = {"<": lambda n: n < amount, "<=": lambda n: n <= amount,
+                   ">": lambda n: n > amount, ">=": lambda n: n >= amount,
+                   "=": lambda n: n == amount}
+            predicate = lambda product: ops[op](product.price_cents)
+        else:
+            predicate = contains(text)
+    if negate:
+        return lambda product: not predicate(product)
+    return predicate
diff --git a/tests/test_search.py b/tests/test_search.py
