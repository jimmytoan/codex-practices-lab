+++ b/tests/test_search.py
@@ -0,0 +1,45 @@
+import pytest
+
+from shoplib.search import Product, search
+
+
+@pytest.fixture
+def products():
+    return [
+        Product("MUG-RED", "Red blue mug", 1200, ["drinkware", "sale"]),
+        Product("MUG-BLUE", "Blue mug", 999, ["Drinkware"]),
+        Product("CUP", "Cup holder", 500, ["sale"]),
+    ]
+
+
+def test_bare_and_quoted_phrases(products):
+    assert search(products, "blue") == products[:2]
+    assert search(products, '"blue mug"') == products[:2]
+    assert search(products, 'name:"red blue"') == products[:1]
+    assert search(products, '"mug cup"') == []
+
+
+def test_fields_prefixes_and_case_insensitive_matching(products):
+    assert search(products, "sku:mug-red") == products[:1]
+    assert search(products, "sku:MUG-*") == products[:2]
+    assert search(products, "tag:DRINK*") == products[:2]
+    assert search(products, "tag:Sale") == [products[0], products[2]]
+    assert search(products, "name:BLUE") == products[:2]
+    assert search(products, '"sku:mug-red"') == []
+
+
+def test_conjunction_negation_and_price(products):
+    assert search(products, "mug -tag:sale") == [products[1]]
+    assert search(products, "price>=999 price<1200") == [products[1]]
+    assert search(products, "price=500") == [products[2]]
+    assert search(products, "price>1200") == []
+    assert search(products, "   \t") == products
+
+
+@pytest.mark.parametrize("query", [
+    "color:red", "price:5", "tag:", "sku:", "-", '"unclosed',
+    "price>", "price>=abc", "price=1.5", "price< -2",
+])
+def test_invalid_queries_raise_value_error(products, query):
+    with pytest.raises(ValueError):
+        search(products, query)
