+def test_ten_or_more_units_get_five_percent_off_line_total():
+    cart = Cart()
+    cart.add("A", 101, 10)
+    cart.add("B", 101, 9)
+
+    assert cart.line_total("A") == 959
+    assert cart.line_total("B") == 909
+    assert cart.subtotal() == 1868
+
+
+def test_discount_uses_half_up_cent_rounding():
+    cart = Cart()
+    cart.add("A", 11, 10)
+
+    assert cart.line_total("A") == 104
+
