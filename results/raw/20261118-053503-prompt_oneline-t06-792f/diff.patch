--- a/src/shoplib/dates.py
+++ b/src/shoplib/dates.py
@@ -20,10 +20,18 @@ def add_business_days(start: date, n: int, holidays=()) -> date:
 
     `start` does not have to be a business day.
     """
-    # TODO: holidays and negative n are not handled yet
+    holidays = set(holidays)
     day = start
-    while n > 0:
-        day += timedelta(days=1)
-        if day.weekday() < 5:
-            n -= 1
+
+    if n == 0:
+        while not is_business_day(day, holidays):
+            day += timedelta(days=1)
+        return day
+
+    step = 1 if n > 0 else -1
+    remaining = abs(n)
+    while remaining:
+        day += timedelta(days=step)
+        if is_business_day(day, holidays):
+            remaining -= 1
     return day
diff --git a/tests/test_dates.py b/tests/test_dates.py
index fbfd5f2..b86d5a2 100644
--- a/tests/test_dates.py
+++ b/tests/test_dates.py
@@ -12,3 +12,20 @@ def test_forward_over_weekend():
     # Friday + 1 business day = Monday
     assert add_business_days(date(2026, 11, 13), 1) == date(2026, 11, 16)
     assert add_business_days(date(2026, 11, 16), 3) == date(2026, 11, 19)
+
+
+def test_holidays_are_skipped():
+    holiday = date(2026, 11, 16)
+    assert not is_business_day(holiday, {holiday})
+    assert add_business_days(date(2026, 11, 13), 1, {holiday}) == date(2026, 11, 17)
+
+
+def test_negative_business_days_move_backwards():
+    assert add_business_days(date(2026, 11, 16), -1) == date(2026, 11, 13)
+    holiday = date(2026, 11, 13)
+    assert add_business_days(date(2026, 11, 16), -1, {holiday}) == date(2026, 11, 12)
+
+
+def test_zero_moves_forward_to_a_business_day():
+    holiday = date(2026, 11, 16)
+    assert add_business_days(holiday, 0, {holiday}) == date(2026, 11, 17)
