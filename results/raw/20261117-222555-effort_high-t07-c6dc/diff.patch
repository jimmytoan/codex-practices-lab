+from datetime import date, timedelta
+
+import pytest
+
+from shoplib.discounts import Coupon, apply_coupon, apply_coupons
+from shoplib.errors import ShopError
 
 
 def test_percent():
@@ -7,3 +12,67 @@ def test_percent():
 
 def test_fixed_never_negative():
     assert apply_coupon(300, Coupon("FIVE", "fixed", 500)) == 0
+
+
+def test_apply_coupons_chooses_highest_percent_with_code_tiebreak():
+    coupons = [
+        Coupon("Z-TEN", "percent", 10),
+        Coupon("FIVE", "percent", 5),
+        Coupon("B-FIXED", "fixed", 50),
+        Coupon("A-TEN", "percent", 10),
+        Coupon("A-FIXED", "fixed", 25),
+    ]
+    expected = (825, ["A-FIXED", "A-TEN", "B-FIXED"])
+    assert apply_coupons(1000, coupons, date(2026, 1, 1)) == expected
+    assert apply_coupons(1000, list(reversed(coupons)), date(2026, 1, 1)) == expected
+
+
+def test_apply_coupons_checks_expiry_and_minimum_against_original_subtotal():
+    today = date(2026, 1, 15)
+    coupons = [
+        Coupon("EXPIRED", "percent", 90, expires=today - timedelta(days=1)),
+        Coupon("MIN-TOO-HIGH", "percent", 80, min_subtotal_cents=1001),
+        Coupon("TODAY", "percent", 20, expires=today, min_subtotal_cents=1000),
+        Coupon("FUTURE", "fixed", 100, expires=today + timedelta(days=1)),
+        Coupon("AT-MIN", "fixed", 50, min_subtotal_cents=1000),
+        Coupon("FIXED-EXPIRED", "fixed", 100, expires=today - timedelta(days=1)),
+        Coupon("FIXED-MIN-TOO-HIGH", "fixed", 100, min_subtotal_cents=1001),
+    ]
+    assert apply_coupons(1000, coupons, today) == (650, ["AT-MIN", "FUTURE", "TODAY"])
+
+
+def test_apply_coupons_uses_half_up_percent_of_original_subtotal():
+    coupons = [Coupon("FIXED", "fixed", 1), Coupon("TEN", "percent", 10)]
+    assert apply_coupons(5, coupons, date(2026, 1, 1)) == (3, ["FIXED", "TEN"])
+
+
+def test_apply_coupons_clamps_total_and_keeps_all_applied_codes():
+    coupons = [
+        Coupon("FIXED-B", "fixed", 100),
+        Coupon("ALL", "percent", 100),
+        Coupon("FIXED-A", "fixed", 100),
+        Coupon("FIXED-A", "fixed", 0),
+    ]
+    assert apply_coupons(100, coupons, date(2026, 1, 1)) == (
+        0,
+        ["ALL", "FIXED-A", "FIXED-A", "FIXED-B"],
+    )
+
+
+def test_apply_coupons_with_no_eligible_coupons():
+    today = date(2026, 1, 1)
+    assert apply_coupons(0, [], today) == (0, [])
+    assert apply_coupons(100, [Coupon("MIN", "fixed", 50, min_subtotal_cents=101)], today) == (
+        100,
+        [],
+    )
+
+
+def test_apply_coupons_rejects_negative_subtotal():
+    with pytest.raises(ShopError, match="subtotal"):
+        apply_coupons(-1, [], date(2026, 1, 1))
+
+
+def test_apply_coupons_rejects_unknown_coupon_kind():
+    with pytest.raises(ShopError, match="unknown coupon kind"):
+        apply_coupons(100, [Coupon("BAD", "unknown", 10)], date(2026, 1, 1))
