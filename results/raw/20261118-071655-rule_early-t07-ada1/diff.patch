 def test_fixed_never_negative():
     assert apply_coupon(300, Coupon("FIVE", "fixed", 500)) == 0
+
+
+def test_apply_coupons_uses_highest_percent_and_all_eligible_fixed_coupons():
+    coupons = [
+        Coupon("TEN", "percent", 10),
+        Coupon("TWENTY", "percent", 20),
+        Coupon("FIVE", "fixed", 500),
+        Coupon("TWO", "fixed", 200),
+    ]
+
+    assert apply_coupons(2000, coupons, date(2026, 1, 1)) == (900, ["FIVE", "TWENTY", "TWO"])
+
+
+def test_apply_coupons_breaks_percent_ties_by_code_and_sorts_codes():
+    coupons = [
+        Coupon("ZED", "percent", 15),
+        Coupon("ABLE", "percent", 15),
+        Coupon("BEE", "fixed", 100),
+    ]
+
+    assert apply_coupons(1000, coupons, date(2026, 1, 1)) == (750, ["ABLE", "BEE"])
+
+
+def test_apply_coupons_checks_expiry_and_minimum_against_original_subtotal():
+    today = date(2026, 1, 10)
+    coupons = [
+        Coupon("TODAY", "fixed", 100, expires=today),
+        Coupon("EXPIRED", "fixed", 100, expires=date(2026, 1, 9)),
+        Coupon("HIGH_MIN", "fixed", 100, min_subtotal_cents=1001),
+        Coupon("HALF", "percent", 50),
+        Coupon("ORIGINAL_MIN", "fixed", 100, min_subtotal_cents=1000),
+    ]
+
+    assert apply_coupons(1000, coupons, today) == (300, ["HALF", "ORIGINAL_MIN", "TODAY"])
+
+
+def test_apply_coupons_never_returns_a_negative_total():
+    coupons = [Coupon("HUGE", "fixed", 2000), Coupon("ALSO_HUGE", "fixed", 1)]
+
+    assert apply_coupons(1000, coupons, date(2026, 1, 1)) == (0, ["ALSO_HUGE", "HUGE"])
+
+
+def test_apply_coupons_returns_original_total_when_no_coupon_is_eligible():
+    coupons = [
+        Coupon("EXPIRED", "fixed", 100, expires=date(2025, 12, 31)),
+        Coupon("HIGH_MIN", "percent", 50, min_subtotal_cents=1001),
+    ]
+
+    assert apply_coupons(1000, coupons, date(2026, 1, 1)) == (1000, [])
+
+
+def test_apply_coupons_rejects_negative_subtotals():
