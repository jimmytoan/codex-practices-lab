diff --git a/src/shoplib/discounts.py b/src/shoplib/discounts.py
index d2804c4..c15f23e 100644
--- a/src/shoplib/discounts.py
+++ b/src/shoplib/discounts.py
@@ -3,6 +3,7 @@
 from dataclasses import dataclass
 from datetime import date
 
+from .errors import ShopError
 from .money import percent_of
 
 
@@ -30,4 +31,29 @@ def apply_coupon(subtotal_cents: int, coupon: Coupon) -> int:
 
 def apply_coupons(subtotal_cents: int, coupons: list[Coupon], today: date) -> tuple[int, list[str]]:
     """Apply several coupons following the rules in docs/discounts.md."""
-    raise NotImplementedError
+    if subtotal_cents < 0:
+        raise ShopError("subtotal must not be negative")
+
+    eligible = [
+        coupon
+        for coupon in coupons
+        if (coupon.expires is None or today <= coupon.expires)
+        and subtotal_cents >= coupon.min_subtotal_cents
+    ]
+    percent_coupons = [coupon for coupon in eligible if coupon.kind == "percent"]
+    fixed_coupons = [coupon for coupon in eligible if coupon.kind == "fixed"]
+    unknown_coupons = [coupon for coupon in eligible if coupon.kind not in {"percent", "fixed"}]
+    if unknown_coupons:
+        raise ShopError(f"unknown coupon kind {unknown_coupons[0].kind!r}")
+
+    applied = []
+    percent_discount = 0
+    if percent_coupons:
+        chosen_percent = min(percent_coupons, key=lambda coupon: (-coupon.value, coupon.code))
+        percent_discount = percent_of(subtotal_cents, chosen_percent.value)
+        applied.append(chosen_percent.code)
+
+    fixed_discount = sum(coupon.value for coupon in fixed_coupons)
+    applied.extend(coupon.code for coupon in fixed_coupons)
+    total_cents = max(subtotal_cents - percent_discount - fixed_discount, 0)
+    return total_cents, sorted(applied)
