@@ -0,0 +1,52 @@
+import pytest
+
+from shoplib.errors import ShopError
+from shoplib.search import Product, search
+
+
+PRODUCTS = [
+    Product("MUG-RED", "Blue Mug Deluxe", 1250, ["Sale", "Kitchenware"]),
+    Product("mug-small", "Blue mug", 999, ["sale"]),
+    Product("BOWL", "Blue bowl", 2500, ["Kitchen"]),
+]
+
+
+def test_search_matches_terms_case_insensitively_and_preserves_order():
+    assert search(PRODUCTS, '"blue mug"') == PRODUCTS[:2]
+    assert search(PRODUCTS, 'name:"blue mug"') == PRODUCTS[:2]
+    assert search(PRODUCTS, "tag:SALE") == PRODUCTS[:2]
+    assert search(PRODUCTS, "tag:sal*") == PRODUCTS[:2]
+    assert search(PRODUCTS, "sku:MUG-*") == PRODUCTS[:2]
+    assert search(PRODUCTS, "-tag:sale") == PRODUCTS[2:]
+    assert search(PRODUCTS, "   ") == PRODUCTS
+
+
+@pytest.mark.parametrize(
+    ("query", "expected"),
+    [
+        ("price<1000", PRODUCTS[1:2]),
+        ("price<=999", PRODUCTS[1:2]),
+        ("price>2000", PRODUCTS[2:]),
+        ("price>=1250", [PRODUCTS[0], PRODUCTS[2]]),
+        ("price=1250", PRODUCTS[:1]),
+    ],
+)
+def test_price_comparisons(query, expected):
+    assert search(PRODUCTS, query) == expected
+
+
+@pytest.mark.parametrize(
+    "query",
+    [
+        "unknown:value",
+        "price:5",
+        "tag:",
+        "price>",
+        "price>=1.5",
+        "-",
+        '"unclosed',
+    ],
+)
+def test_invalid_queries_raise_shop_error(query):
+    with pytest.raises(ShopError):
+        search(PRODUCTS, query)
