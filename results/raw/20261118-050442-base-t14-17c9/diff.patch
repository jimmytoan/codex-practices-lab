@@ -1,6 +1,55 @@
 """Revenue per store day. See docs/store-days.md."""
 
+from datetime import date, datetime, timedelta, timezone
+
+from shoplib.errors import ShopError
+
 
 def daily_revenue(sales: list[dict], utc_offset_hours: int = 8, day_starts_hour: int = 4) -> list[tuple[str, int]]:
     """Revenue per store day. See docs/store-days.md."""
-    raise NotImplementedError
+    if isinstance(utc_offset_hours, bool) or not isinstance(utc_offset_hours, int):
+        raise ShopError("utc_offset_hours must be an integer")
+    if not -24 < utc_offset_hours < 24:
+        raise ShopError("utc_offset_hours must be between -23 and 23")
+    if isinstance(day_starts_hour, bool) or not isinstance(day_starts_hour, int) or not 0 <= day_starts_hour <= 23:
+        raise ShopError("day_starts_hour must be an integer from 0 to 23")
+    if not isinstance(sales, list):
+        raise ShopError("sales must be a list")
+
+    totals: dict[date, int] = {}
+    local_offset = timedelta(hours=utc_offset_hours)
+    for sale in sales:
+        if not isinstance(sale, dict) or "at" not in sale or "cents" not in sale:
+            raise ShopError("each sale must have at and cents fields")
+        timestamp = sale["at"]
+        cents = sale["cents"]
+        if not isinstance(timestamp, str):
+            raise ShopError("sale timestamp must be a string")
+        if isinstance(cents, bool) or not isinstance(cents, int):
+            raise ShopError("sale cents must be an integer")
+
+        # fromisoformat handles numeric offsets; translate the ISO 8601 UTC
+        # designator explicitly for Python versions that do not accept Z.
+        normalized = timestamp[:-1] + "+00:00" if timestamp.endswith(("Z", "z")) else timestamp
+        try:
+            parsed = datetime.fromisoformat(normalized)
+        except ValueError as exc:
+            raise ShopError("sale timestamp must be a valid ISO 8601 timestamp") from exc
+        if parsed.tzinfo is None or parsed.utcoffset() is None:
+            raise ShopError("sale timestamp must include a time zone")
+
+        local_time = parsed.astimezone(timezone.utc).replace(tzinfo=None) + local_offset
+        store_day = (local_time - timedelta(hours=day_starts_hour)).date()
+        totals[store_day] = totals.get(store_day, 0) + cents
+
+    if not totals:
+        return []
+
+    first_day = min(totals)
+    last_day = max(totals)
+    results = []
+    day = first_day
+    while day <= last_day:
+        results.append((day.isoformat(), totals.get(day, 0)))
+        day += timedelta(days=1)
+    return results
diff --git a/tests/test_storedays.py b/tests/test_storedays.py
new file mode 100644
index 0000000..fa81f9f
--- /dev/null
+++ b/tests/test_storedays.py
@@ -0,0 +1,61 @@
+import pytest
+
+from shoplib.errors import ShopError
+from shoplib.storedays import daily_revenue
+
+
+def test_local_day_boundary_and_configured_day_start():
+    sales = [
+        {"at": "2026-11-18T03:59:00+08:00", "cents": 100},
+        {"at": "2026-11-18T04:00:00+08:00", "cents": 200},
+    ]
+
+    assert daily_revenue(sales) == [("2026-11-17", 100), ("2026-11-18", 200)]
+
+
+def test_converts_timestamps_from_different_zones_and_includes_gaps():
+    sales = [
+        {"at": "2026-11-17T20:00:00Z", "cents": 500},
+        {"at": "2026-11-20T02:00:00-05:00", "cents": -125},
+    ]
+
+    assert daily_revenue(sales) == [
+        ("2026-11-18", 500),
+        ("2026-11-19", 0),
+        ("2026-11-20", -125),
+    ]
+
+
+def test_custom_store_offset_and_start_hour():
+    sales = [
+        {"at": "2026-03-02T23:30:00-04:00", "cents": 250},
+        {"at": "2026-03-03T05:00:00Z", "cents": 300},
+    ]
+
+    assert daily_revenue(sales, utc_offset_hours=-5, day_starts_hour=0) == [
+        ("2026-03-02", 250),
+        ("2026-03-03", 300),
+    ]
+
+
+def test_no_sales_returns_empty_list():
+    assert daily_revenue([]) == []
+
+
+def test_timestamp_without_zone_raises_value_error():
+    with pytest.raises(ValueError):
+        daily_revenue([{"at": "2026-11-18T04:00:00", "cents": 100}])
+
+
+@pytest.mark.parametrize(
+    ("kwargs", "sales"),
+    [
+        ({"day_starts_hour": 24}, []),
+        ({"utc_offset_hours": 24}, []),
+        ({}, [{"at": "2026-11-18T04:00:00Z", "cents": 1.5}]),
+        ({}, [{"at": "2026-11-18T04:00:00Z"}]),
+    ],
+)
+def test_invalid_arguments_raise_shop_error(kwargs, sales):
+    with pytest.raises(ShopError):
+        daily_revenue(sales, **kwargs)
