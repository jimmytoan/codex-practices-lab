+def test_csv_quotes_special_field_values():
+    rows = [{
+        "sku": 'sku,"one',
+        "name": "first line\nsecond line",
+        "units": 1,
+        "revenue_cents": 0,
+    }]
+    assert to_csv(rows) == 'sku,name,units,revenue_cents\n"sku,""one","first line\nsecond line",1,0\n'
+
+
+def test_csv_quotes_carriage_return():
+    rows = [{"sku": "A", "name": "first\rsecond", "units": 1, "revenue_cents": 0}]
+    assert to_csv(rows) == 'sku,name,units,revenue_cents\nA,"first\rsecond",1,0\n'
