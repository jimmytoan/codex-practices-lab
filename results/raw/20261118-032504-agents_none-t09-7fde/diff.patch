diff --git a/tests/test_textutil.py b/tests/test_textutil.py
index 4c83bb9..6098b45 100644
--- a/tests/test_textutil.py
+++ b/tests/test_textutil.py
@@ -6,6 +6,27 @@ def test_slugify_basic():
     assert slugify("!!!") == "n-a"
 
 
+def test_slugify_removes_latin_accents():
+    assert slugify("Crème Brûlée") == "creme-brulee"
+    assert slugify("Cafe\u0301") == "cafe"
+
+
+def test_slugify_max_len_is_applied_after_slugging():
+    assert slugify("one two", max_len=4) == "one"
+    assert slugify("long name", max_len=6) == "long-n"
+    assert slugify("!!!", max_len=2) == "n"
+    assert slugify("one", max_len=0) == ""
+
+
+def test_slugify_rejects_negative_max_len():
+    try:
+        slugify("one", max_len=-1)
+    except ValueError as exc:
+        assert str(exc) == "max_len must be non-negative"
+    else:
+        raise AssertionError("expected ValueError")
+
+
 def test_truncate():
     assert truncate("hello world", 8) == "hello..."
     assert truncate("short", 8) == "short"
