+def test_split_parcels_uses_first_fit_decreasing_and_preserves_pack_order():
+    items = [("A", 6, 1), ("B", 5, 1), ("C", 4, 1), ("D", 3, 1)]
+
+    assert split_parcels(items, 10) == [["A", "C"], ["B", "D"]]
+
