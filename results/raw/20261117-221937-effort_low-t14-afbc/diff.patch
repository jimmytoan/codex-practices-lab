@@ -1,6 +1,43 @@
 """Revenue per store day. See docs/store-days.md."""
 
+from datetime import datetime, timedelta, timezone
+import re
+
+from shoplib.errors import ShopError
+
 
 def daily_revenue(sales: list[dict], utc_offset_hours: int = 8, day_starts_hour: int = 4) -> list[tuple[str, int]]:
-    """Revenue per store day. See docs/store-days.md."""
-    raise NotImplementedError
+    """Return totals for each store day between the first and last sale."""
+    if not isinstance(utc_offset_hours, int) or not -24 < utc_offset_hours < 24:
+        raise ShopError("invalid UTC offset")
+    if not isinstance(day_starts_hour, int) or not 0 <= day_starts_hour < 24:
+        raise ShopError("invalid day start hour")
+    local_zone = timezone(timedelta(hours=utc_offset_hours))
+    totals = {}
+    for sale in sales:
+        try:
+            timestamp, cents = sale["at"], sale["cents"]
+            if not isinstance(timestamp, str) or not re.search(r"(?:Z|[+-]\d{2}:\d{2})$", timestamp):
+                raise ShopError("timestamp must have a zone")
+            if not isinstance(cents, int):
+                raise ShopError("cents must be an integer")
+            parsed = datetime.fromisoformat(timestamp.replace("Z", "+00:00"))
+            if parsed.tzinfo is None:
+                raise ShopError("timestamp must have a zone")
+            local = parsed.astimezone(local_zone)
+            day = local.date()
+            if local.hour < day_starts_hour:
+                day -= timedelta(days=1)
+        except (KeyError, TypeError, ValueError, OverflowError) as exc:
+            raise ShopError("invalid sale") from exc
+        totals[day] = totals.get(day, 0) + cents
+
+    if not totals:
+        return []
+    day, last = min(totals), max(totals)
+    result = []
+    while True:
+        result.append((day.isoformat(), totals.get(day, 0)))
+        if day == last:
+            return result
+        day += timedelta(days=1)
diff --git a/tests/test_storedays.py b/tests/test_storedays.py
new file mode 100644
index 0000000..5dfae6c
--- /dev/null
+++ b/tests/test_storedays.py
@@ -0,0 +1,45 @@
+import pytest
+
+from shoplib.errors import ShopError
+from shoplib.storedays import daily_revenue
+
+
+def test_boundary_timezones_refunds_and_gaps():
+    sales = [
+        {"at": "2026-11-20T04:00:00+08:00", "cents": 100},
+        {"at": "2026-11-17T18:30:00Z", "cents": 250},  # 02:30 local
+        {"at": "2026-11-17T20:00:00Z", "cents": 80},  # 04:00 local
+        {"at": "2026-11-18T00:00:00-04:00", "cents": -30},
+        {"at": "2026-11-17T19:59:59Z", "cents": 10},
+    ]
+    assert daily_revenue(sales) == [
+        ("2026-11-17", 260),
+        ("2026-11-18", 50),
+        ("2026-11-19", 0),
+        ("2026-11-20", 100),
+    ]
+
+
+def test_custom_offset_and_start_cross_year():
+    sales = [
+        {"at": "2027-01-01T06:59:59Z", "cents": 5},
+        {"at": "2027-01-01T07:00:00Z", "cents": 7},
+    ]
+    assert daily_revenue(sales, utc_offset_hours=-5, day_starts_hour=2) == [
+        ("2026-12-31", 5), ("2027-01-01", 7)
+    ]
+
+
+def test_no_sales():
+    assert daily_revenue([]) == []
+
+
+def test_timestamp_without_zone_raises():
+    with pytest.raises(ShopError):
+        daily_revenue([{"at": "2026-11-18T02:30:00", "cents": 100}])
+
+
+@pytest.mark.parametrize("kwargs", [{"utc_offset_hours": 24}, {"day_starts_hour": 24}])
+def test_invalid_parameters(kwargs):
+    with pytest.raises(ShopError):
+        daily_revenue([], **kwargs)
