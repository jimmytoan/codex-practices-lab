@@ -1,6 +1,48 @@
 """Revenue per store day. See docs/store-days.md."""
 
+from datetime import datetime, timedelta, timezone
+import re
+
+from shoplib.errors import ShopError
+
 
 def daily_revenue(sales: list[dict], utc_offset_hours: int = 8, day_starts_hour: int = 4) -> list[tuple[str, int]]:
     """Revenue per store day. See docs/store-days.md."""
-    raise NotImplementedError
+    if type(utc_offset_hours) is not int or not -23 <= utc_offset_hours <= 23:
+        raise ShopError("invalid UTC offset")
+    if type(day_starts_hour) is not int or not 0 <= day_starts_hour <= 23:
+        raise ShopError("invalid day start hour")
+    try:
+        sales_iter = iter(sales)
+    except TypeError as exc:
+        raise ShopError("invalid sales") from exc
+
+    local_zone = timezone(timedelta(hours=utc_offset_hours))
+    totals = {}
+    for sale in sales_iter:
+        if not isinstance(sale, dict) or not isinstance(sale.get("at"), str) or type(sale.get("cents")) is not int:
+            raise ShopError("invalid sale")
+        timestamp = sale["at"]
+        if not re.search(r"(?:Z|[+-]\d{2}:\d{2})$", timestamp):
+            raise ShopError("timestamp must include a zone")
+        try:
+            parsed = datetime.fromisoformat(timestamp.replace("Z", "+00:00"))
+            if parsed.tzinfo is None:
+                raise ShopError("timestamp must include a zone")
+            local_time = parsed.astimezone(local_zone)
+            day = local_time.date()
+            if local_time.hour < day_starts_hour:
+                day -= timedelta(days=1)
+        except (ValueError, OverflowError) as exc:
+            raise ShopError("invalid timestamp") from exc
+        totals[day] = totals.get(day, 0) + sale["cents"]
+
+    if not totals:
+        return []
+    day, last_day = min(totals), max(totals)
+    result = []
+    while True:
+        result.append((day.isoformat(), totals.get(day, 0)))
+        if day == last_day:
+            return result
+        day += timedelta(days=1)
diff --git a/tests/test_storedays.py b/tests/test_storedays.py
new file mode 100644
