+++ b/tests/test_storedays.py
@@ -0,0 +1,52 @@
+import pytest
+
+from shoplib.errors import ShopError
+from shoplib.storedays import daily_revenue
+
+
+def test_default_boundary_and_refunds():
+    sales = [
+        {"at": "2026-11-17T18:30:00Z", "cents": 500},  # 02:30 local on Nov 18
+        {"at": "2026-11-17T19:59:59Z", "cents": -125},
+        {"at": "2026-11-17T20:00:00Z", "cents": 200},  # 04:00 local
+    ]
+    assert daily_revenue(sales) == [("2026-11-17", 375), ("2026-11-18", 200)]
+
+
+def test_offsets_gaps_and_date_order():
+    sales = [
+        {"at": "2027-01-02T05:00:00+03:00", "cents": 300},
+        {"at": "2026-12-30T22:00:00-04:00", "cents": 100},
+        {"at": "2026-12-31T02:00:00Z", "cents": -20},
+    ]
+    assert daily_revenue(sales, utc_offset_hours=-5, day_starts_hour=0) == [
+        ("2026-12-30", 80),
+        ("2026-12-31", 0),
+        ("2027-01-01", 300),
+    ]
+
+
+def test_no_sales_and_single_day():
+    assert daily_revenue([]) == []
+    assert daily_revenue([{"at": "2026-01-01T04:00:00+08:00", "cents": 0}]) == [("2026-01-01", 0)]
+
+
+@pytest.mark.parametrize("timestamp", ["2026-11-18T02:30:00", "2026-11-18+08:00", "badZ"])
+def test_invalid_or_unzoned_timestamp(timestamp):
+    with pytest.raises(ShopError):
+        daily_revenue([{"at": timestamp, "cents": 1}])
+
+
+@pytest.mark.parametrize("kwargs", [
+    {"utc_offset_hours": 24}, {"utc_offset_hours": -24}, {"utc_offset_hours": 1.5},
+    {"day_starts_hour": -1}, {"day_starts_hour": 24}, {"day_starts_hour": 4.5},
+])
+def test_invalid_settings(kwargs):
+    with pytest.raises(ShopError):
+        daily_revenue([], **kwargs)
+
+
+@pytest.mark.parametrize("sales", [None, [{}], [{"at": "2026-11-18T02:30:00Z", "cents": 1.5}]])
+def test_invalid_sales(sales):
+    with pytest.raises(ShopError):
+        daily_revenue(sales)
