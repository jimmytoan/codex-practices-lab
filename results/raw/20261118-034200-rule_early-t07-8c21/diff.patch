 def test_fixed_never_negative():
     assert apply_coupon(300, Coupon("FIVE", "fixed", 500)) == 0
+
+
+def test_apply_coupons_combines_best_percent_and_all_fixed_coupons():
+    coupons = [
+        Coupon("SAVE10", "percent", 10),
+        Coupon("LESS500", "fixed", 500),
+        Coupon("LESS250", "fixed", 250),
+        Coupon("SAVE5", "percent", 5),
+    ]
+
+    assert apply_coupons(10_000, coupons, date(2026, 1, 1)) == (
+        8_250,
+        ["LESS250", "LESS500", "SAVE10"],
+    )
+
+
+def test_apply_coupons_uses_original_subtotal_for_eligibility_and_expiry_is_inclusive():
+    coupons = [
+        Coupon("TODAY", "fixed", 100, expires=date(2026, 1, 1), min_subtotal_cents=1_000),
+        Coupon("EXPIRED", "fixed", 200, expires=date(2025, 12, 31)),
+        Coupon("MINIMUM", "fixed", 300, min_subtotal_cents=1_001),
+        Coupon("PERCENT", "percent", 50),
+    ]
+
+    assert apply_coupons(1_000, coupons, date(2026, 1, 1)) == (400, ["PERCENT", "TODAY"])
+
+
+def test_apply_coupons_breaks_percent_ties_by_code():
+    coupons = [
+        Coupon("ZEBRA", "percent", 20),
+        Coupon("ALPHA", "percent", 20),
+    ]
+
+    assert apply_coupons(1_000, coupons, date(2026, 1, 1)) == (800, ["ALPHA"])
+
+
+def test_apply_coupons_rounds_percent_discount_half_up_and_floors_at_zero():
+    assert apply_coupons(5, [Coupon("TEN", "percent", 10)], date(2026, 1, 1)) == (4, ["TEN"])
+    assert apply_coupons(300, [Coupon("BIG", "fixed", 500)], date(2026, 1, 1)) == (0, ["BIG"])
+
+
+def test_apply_coupons_rejects_negative_subtotal():
+    with pytest.raises(ShopError):
+        apply_coupons(-1, [], date(2026, 1, 1))
