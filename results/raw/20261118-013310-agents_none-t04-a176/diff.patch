                 reserved.append((sku, qty))
         except ValueError:
             for sku, qty in reserved:
-                inventory._reserved[sku] -= qty
+                inventory.release(sku, qty)
             raise
 
     def _transition(self, allowed_from: tuple[str, ...], to: str) -> None:
@@ -46,3 +46,13 @@ class Order:
 
     def deliver(self) -> None:
         self._transition((SHIPPED,), DELIVERED)
+
+    def cancel(self) -> None:
+        if self.state == CANCELLED:
+            return
+        if self.state not in (NEW, PAID):
+            raise ValueError(f"cannot go from {self.state} to {CANCELLED}")
+        for sku, qty in self.lines.items():
+            self.inventory.release(sku, qty)
+        self.refund_due = self.state == PAID
+        self.state = CANCELLED
diff --git a/tests/test_inventory.py b/tests/test_inventory.py
index 37436c0..7e6acbc 100644
--- a/tests/test_inventory.py
+++ b/tests/test_inventory.py
@@ -18,3 +18,22 @@ def test_cannot_reserve_more_than_available():
     inv.receive("A", 2)
     with pytest.raises(ValueError):
         inv.reserve("A", 3)
+
+
+def test_release_returns_reserved_stock_to_available():
+    inv = Inventory()
+    inv.receive("A", 10)
+    inv.reserve("A", 4)
+    inv.release("A", 3)
+    assert (inv.on_hand("A"), inv.reserved("A"), inv.available("A")) == (10, 1, 9)
+
+
+@pytest.mark.parametrize("sku, qty", [("A", 0), ("A", -1), ("A", 3), ("missing", 1)])
+def test_invalid_release_changes_nothing(sku, qty):
+    inv = Inventory()
+    inv.receive("A", 5)
+    inv.reserve("A", 2)
+    with pytest.raises(ValueError):
+        inv.release(sku, qty)
+    assert (inv.on_hand("A"), inv.reserved("A"), inv.available("A")) == (5, 2, 3)
+    assert inv.reserved("missing") == 0
diff --git a/tests/test_orders.py b/tests/test_orders.py
index d3835d1..0e4b41d 100644
--- a/tests/test_orders.py
+++ b/tests/test_orders.py
@@ -1,7 +1,7 @@
 import pytest
 
 from shoplib.inventory import Inventory
-from shoplib.orders import DELIVERED, NEW, Order
+from shoplib.orders import CANCELLED, DELIVERED, NEW, SHIPPED, Order
 
 
 def make():
@@ -25,3 +25,47 @@ def test_cannot_ship_unpaid():
     _, order = make()
     with pytest.raises(ValueError):
         order.ship()
+
+
+@pytest.mark.parametrize("paid", [False, True])
+def test_cancel_releases_each_line_once_and_preserves_other_reservations(paid):
+    inv = Inventory()
+    inv.receive("A", 10)
+    inv.receive("B", 6)
+    order = Order("o1", {"A": 2, "B": 3}, inv)
+    Order("o2", {"A": 4}, inv)
+    if paid:
+        order.pay()
+
+    order.cancel()
+    order.cancel()
+
+    assert order.state == CANCELLED
+    assert order.refund_due is paid
+    assert (inv.on_hand("A"), inv.reserved("A"), inv.available("A")) == (10, 4, 6)
+    assert (inv.on_hand("B"), inv.reserved("B"), inv.available("B")) == (6, 0, 6)
+
+
+@pytest.mark.parametrize("delivered", [False, True])
+def test_cannot_cancel_after_shipping(delivered):
+    inv, order = make()
+    order.pay()
+    order.ship()
+    if delivered:
+        order.deliver()
+    before = (inv.on_hand("A"), inv.reserved("A"), inv.available("A"))
+
+    with pytest.raises(ValueError):
+        order.cancel()
+
+    assert order.state == (DELIVERED if delivered else SHIPPED)
+    assert order.refund_due is False
+    assert (inv.on_hand("A"), inv.reserved("A"), inv.available("A")) == before
+
+
+def test_failed_order_creation_releases_previous_reservations():
+    inv = Inventory()
+    inv.receive("A", 5)
+    with pytest.raises(ValueError):
+        Order("o1", {"A": 2, "B": 1}, inv)
+    assert (inv.on_hand("A"), inv.reserved("A"), inv.available("A")) == (5, 0, 5)
