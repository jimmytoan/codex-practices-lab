+from datetime import date
+
+import pytest
+
+from shoplib.discounts import Coupon, apply_coupon, apply_coupons
 
 
 def test_percent():
@@ -7,3 +11,46 @@ def test_percent():
 
 def test_fixed_never_negative():
     assert apply_coupon(300, Coupon("FIVE", "fixed", 500)) == 0
+
+
+def test_apply_coupons_combines_best_percent_and_all_eligible_fixed_coupons():
+    coupons = [
+        Coupon("TEN", "percent", 10),
+        Coupon("TWENTY", "percent", 20),
+        Coupon("SHIP", "fixed", 125),
+        Coupon("SAVE", "fixed", 75),
+    ]
+
+    assert apply_coupons(1000, coupons, date(2025, 1, 1)) == (600, ["SAVE", "SHIP", "TWENTY"])
+
+
+def test_apply_coupons_percent_tie_uses_code_and_returns_sorted_codes():
+    coupons = [
+        Coupon("ZED", "percent", 15),
+        Coupon("ALPHA", "percent", 15),
+        Coupon("MID", "fixed", 100),
+    ]
+
+    assert apply_coupons(1000, coupons, date(2025, 1, 1)) == (750, ["ALPHA", "MID"])
+
+
+def test_apply_coupons_eligibility_uses_original_subtotal_and_expiry_is_inclusive():
+    today = date(2025, 1, 1)
+    coupons = [
+        Coupon("BOUNDARY", "fixed", 100, expires=today, min_subtotal_cents=1000),
+        Coupon("TOO_LATE", "fixed", 200, expires=date(2024, 12, 31)),
+        Coupon("TOO_HIGH_MIN", "fixed", 300, min_subtotal_cents=1001),
+    ]
+
+    assert apply_coupons(1000, coupons, today) == (900, ["BOUNDARY"])
+
+
+def test_apply_coupons_caps_combined_discounts_at_zero():
+    coupons = [Coupon("HALF", "percent", 50), Coupon("BIG", "fixed", 1000)]
+
+    assert apply_coupons(500, coupons, date(2025, 1, 1)) == (0, ["BIG", "HALF"])
+
+
+def test_apply_coupons_rejects_negative_subtotal():
+    with pytest.raises(ValueError, match="subtotal"):
+        apply_coupons(-1, [], date(2025, 1, 1))
