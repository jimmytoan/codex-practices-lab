diff --git a/src/shoplib/orders.py b/src/shoplib/orders.py
index 8edb164..a841aa5 100644
--- a/src/shoplib/orders.py
+++ b/src/shoplib/orders.py
@@ -46,3 +46,23 @@ class Order:
 
     def deliver(self) -> None:
         self._transition((SHIPPED,), DELIVERED)
+
+    def cancel(self) -> None:
+        """Cancel an unshipped order and release its reserved stock."""
+        if self.state == CANCELLED:
+            return
+        if self.state not in (NEW, PAID):
+            raise ValueError(f"cannot go from {self.state} to {CANCELLED}")
+
+        # Check every line first so a failed cancellation cannot release only
+        # part of the order's stock.
+        for sku, qty in self.lines.items():
+            reserved = self.inventory.reserved(sku)
+            if qty > reserved:
+                raise ValueError(f"only {reserved} of {sku} reserved")
+
+        was_paid = self.state == PAID
+        for sku, qty in self.lines.items():
+            self.inventory.release(sku, qty)
+        self.state = CANCELLED
+        self.refund_due = was_paid
diff --git a/tests/test_inventory.py b/tests/test_inventory.py
index 37436c0..bd613d0 100644
--- a/tests/test_inventory.py
+++ b/tests/test_inventory.py
@@ -18,3 +18,41 @@ def test_cannot_reserve_more_than_available():
     inv.receive("A", 2)
     with pytest.raises(ValueError):
         inv.reserve("A", 3)
+
+
+def test_release_returns_reserved_stock_to_available():
+    inv = Inventory()
+    inv.receive("A", 10)
+    inv.reserve("A", 4)
+
+    inv.release("A", 3)
+
+    assert inv.on_hand("A") == 10
+    assert inv.reserved("A") == 1
+    assert inv.available("A") == 9
+
+
+@pytest.mark.parametrize("qty", [0, -1])
+def test_release_requires_positive_quantity(qty):
+    inv = Inventory()
+    inv.receive("A", 5)
+    inv.reserve("A", 2)
+
+    with pytest.raises(ValueError):
+        inv.release("A", qty)
+
+    assert inv.reserved("A") == 2
+    assert inv.available("A") == 3
+
+
+@pytest.mark.parametrize("sku, qty", [("A", 3), ("B", 1)])
+def test_release_cannot_exceed_reserved_stock(sku, qty):
+    inv = Inventory()
+    inv.receive("A", 5)
+    inv.reserve("A", 2)
+
+    with pytest.raises(ValueError):
+        inv.release(sku, qty)
+
+    assert inv.reserved("A") == 2
+    assert inv.available("A") == 3
diff --git a/tests/test_orders.py b/tests/test_orders.py
index d3835d1..48a19c7 100644
--- a/tests/test_orders.py
+++ b/tests/test_orders.py
@@ -1,7 +1,7 @@
 import pytest
 
 from shoplib.inventory import Inventory
-from shoplib.orders import DELIVERED, NEW, Order
+from shoplib.orders import CANCELLED, DELIVERED, NEW, SHIPPED, Order
 
 
 def make():
@@ -25,3 +25,74 @@ def test_cannot_ship_unpaid():
     _, order = make()
     with pytest.raises(ValueError):
         order.ship()
+
+
+def test_cancel_new_order_releases_stock_without_refund():
+    inv, order = make()
+
+    order.cancel()
+
+    assert order.state == CANCELLED
+    assert order.refund_due is False
+    assert inv.reserved("A") == 0
+    assert inv.available("A") == 5
+
+
+def test_cancel_paid_order_releases_stock_and_sets_refund_due():
+    inv, order = make()
+    order.pay()
+
+    order.cancel()
+
+    assert order.state == CANCELLED
+    assert order.refund_due is True
+    assert inv.reserved("A") == 0
+    assert inv.available("A") == 5
+
+
+def test_cancelling_cancelled_order_is_a_no_op():
+    inv, order = make()
+    order.cancel()
+
+    order.cancel()
+
+    assert order.state == CANCELLED
+    assert inv.reserved("A") == 0
+    assert inv.available("A") == 5
+
+
+@pytest.mark.parametrize("finish", ["ship", "deliver"])
+def test_cannot_cancel_shipped_or_delivered_order(finish):
+    inv, order = make()
+    order.pay()
+    order.ship()
+    if finish == "deliver":
+        order.deliver()
+    state = SHIPPED if finish == "ship" else DELIVERED
+    on_hand = inv.on_hand("A")
+
+    with pytest.raises(ValueError):
+        order.cancel()
+
+    assert order.state == state
+    assert order.refund_due is False
+    assert inv.on_hand("A") == on_hand
+    assert inv.reserved("A") == 0
+
+
+def test_failed_multiline_cancel_does_not_release_stock():
+    inv = Inventory()
+    inv.receive("A", 5)
+    inv.receive("B", 5)
+    order = Order("o2", {"A": 2, "B": 2}, inv)
+    inv.ship("B", 1)
+
+    with pytest.raises(ValueError):
+        order.cancel()
+
+    assert order.state == NEW
+    assert order.refund_due is False
+    assert inv.reserved("A") == 2
+    assert inv.reserved("B") == 1
+    assert inv.available("A") == 3
+    assert inv.available("B") == 3
