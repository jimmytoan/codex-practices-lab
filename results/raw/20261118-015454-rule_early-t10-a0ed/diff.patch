+def test_split_parcels_uses_first_fit_decreasing_and_preserves_unit_order():
+    items = [("light", 2, 2), ("medium", 4, 1), ("heavy", 6, 2)]
+
+    assert split_parcels(items, 10) == [
+        ["heavy", "medium"],
+        ["heavy", "light", "light"],
+    ]
+    assert items == [("light", 2, 2), ("medium", 4, 1), ("heavy", 6, 2)]
+
+
+def test_split_parcels_breaks_equal_weight_ties_by_sku():
+    assert split_parcels([("Z", 3, 1), ("B", 3, 1), ("A", 3, 2)], 6) == [
+        ["A", "A"], ["B", "Z"]
+    ]
+
+
+def test_split_parcels_fills_the_first_parcel_that_fits():
+    assert split_parcels([("A", 7, 1), ("B", 6, 1), ("C", 3, 1)], 10) == [
+        ["A", "C"], ["B"]
+    ]
