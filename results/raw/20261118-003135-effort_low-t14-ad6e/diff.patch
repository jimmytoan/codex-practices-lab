@@ -0,0 +1,44 @@
+import pytest
+
+from shoplib.errors import ShopError
+from shoplib.storedays import daily_revenue
+
+
+def test_boundary_refunds_and_gaps_in_date_order():
+    sales = [
+        {"at": "2026-11-20T04:00:00+08:00", "cents": 300},
+        {"at": "2026-11-18T03:59:59+08:00", "cents": 100},
+        {"at": "2026-11-18T04:00:00+08:00", "cents": 200},
+        {"at": "2026-11-17T20:30:00Z", "cents": -50},
+    ]
+    assert daily_revenue(sales) == [
+        ("2026-11-17", 100), ("2026-11-18", 150),
+        ("2026-11-19", 0), ("2026-11-20", 300),
+    ]
+
+
+def test_offsets_and_custom_boundary_across_year():
+    sales = [
+        {"at": "2027-01-01T02:00:00+03:00", "cents": 5},
+        {"at": "2026-12-31T19:00:00-02:00", "cents": 7},
+    ]
+    assert daily_revenue(sales, utc_offset_hours=-5, day_starts_hour=18) == [
+        ("2026-12-30", 7), ("2026-12-31", 5),
+    ]
+
+
+def test_empty_and_midnight_boundary():
+    assert daily_revenue([]) == []
+    assert daily_revenue([{"at": "2026-01-01T00:00:00Z", "cents": 0}], 0, 0) == [("2026-01-01", 0)]
+
+
+@pytest.mark.parametrize("timestamp", ["2026-11-18T02:30:00", "2026-11-18", "invalid", "2026-11-18T02:30:00+99:00"])
+def test_invalid_or_unzoned_timestamp(timestamp):
+    with pytest.raises(ShopError):
+        daily_revenue([{"at": timestamp, "cents": 100}])
+
+
+@pytest.mark.parametrize("kwargs", [{"utc_offset_hours": 24}, {"day_starts_hour": 24}, {"day_starts_hour": -1}])
+def test_invalid_settings(kwargs):
+    with pytest.raises(ShopError):
+        daily_revenue([], **kwargs)
