 """Text helpers for URLs and listings."""
 
 import re
+import unicodedata
 
 
 def slugify(text: str, max_len: int = 40) -> str:
@@ -13,9 +14,31 @@ def slugify(text: str, max_len: int = 40) -> str:
     - At most `max_len` characters, cut after the other steps; a cut never
       leaves a trailing '-'.
     - If nothing is left, the slug is 'n-a'.
+    - `max_len` must be positive, and at least 3 if the fallback is needed.
     """
-    slug = re.sub(r"[^a-z0-9]+", "-", text.lower()).strip("-")
+    if max_len < 1:
+        raise ValueError("max_len must be positive")
+
+    letters = []
+    latin_base = False
+    for char in unicodedata.normalize("NFD", text.lower()):
+        if unicodedata.category(char).startswith("M") and latin_base:
+            continue
+
+        # Some Latin letters with a stroke or other modifier do not have a
+        # Unicode decomposition, but their names still identify the base.
+        match = re.match(
+            r"LATIN SMALL LETTER ([A-Z]) WITH ", unicodedata.name(char, "")
+        )
+        if match:
+            char = match.group(1).lower()
+        letters.append(char)
+        latin_base = "a" <= char <= "z"
+
+    slug = re.sub(r"[^a-z0-9]+", "-", "".join(letters)).strip("-")
     slug = slug[:max_len].rstrip("-")
+    if not slug and max_len < 3:
+        raise ValueError("max_len must be at least 3 for the fallback")
     return slug or "n-a"
 
 
diff --git a/tests/test_textutil.py b/tests/test_textutil.py
index 4c83bb9..8165db8 100644
--- a/tests/test_textutil.py
+++ b/tests/test_textutil.py
@@ -1,3 +1,5 @@
+import pytest
+
 from shoplib.textutil import slugify, truncate
 
 
@@ -6,6 +8,54 @@ def test_slugify_basic():
     assert slugify("!!!") == "n-a"
 
 
+@pytest.mark.parametrize(
+    ("text", "expected"),
+    [
+        ("Crème Brûlée", "creme-brulee"),
+        ("CRE\u0300ME BRU\u0302LE\u0301E", "creme-brulee"),
+        ("Łódź and Øresund", "lodz-and-oresund"),
+        ("  café—東京 42!!!", "cafe-42"),
+        ("a\u0301\u0327b", "ab"),
+        ("你好", "n-a"),
+        ("a²b", "a-b"),
+    ],
+)
+def test_slugify_accents_and_separators(text, expected):
+    assert slugify(text) == expected
+
+
+@pytest.mark.parametrize(
+    ("text", "max_len", "expected"),
+    [
+        ("Crème Brûlée", 5, "creme"),
+        ("Crème Brûlée", 6, "creme"),
+        ("Crème Brûlée", 7, "creme-b"),
+        ("Crème Brûlée", 1, "c"),
+        ("Crème Brûlée", 2, "cr"),
+        ("!!!", 3, "n-a"),
+        ("ab---cd", 3, "ab"),
+    ],
+)
+def test_slugify_max_len(text, max_len, expected):
+    assert slugify(text, max_len) == expected
+
+
+def test_slugify_default_max_len():
+    assert slugify("é" * 50) == "e" * 40
+
+
+@pytest.mark.parametrize("max_len", [-1, 0])
+def test_slugify_rejects_nonpositive_max_len(max_len):
+    with pytest.raises(ValueError, match="max_len must be positive"):
+        slugify("anything", max_len)
+
+
+@pytest.mark.parametrize("max_len", [1, 2])
+def test_slugify_rejects_max_len_too_small_for_fallback(max_len):
+    with pytest.raises(ValueError, match="max_len must be at least 3"):
+        slugify("!!!", max_len)
+
+
 def test_truncate():
     assert truncate("hello world", 8) == "hello..."
     assert truncate("short", 8) == "short"
