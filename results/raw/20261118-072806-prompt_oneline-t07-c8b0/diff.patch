 def test_percent():
@@ -7,3 +12,41 @@ def test_percent():
 
 def test_fixed_never_negative():
     assert apply_coupon(300, Coupon("FIVE", "fixed", 500)) == 0
+
+
+def test_apply_coupons_uses_highest_percent_and_all_eligible_fixed_coupons():
+    coupons = [
+        Coupon("TEN", "percent", 10),
+        Coupon("TWENTY", "percent", 20),
+        Coupon("SMALL", "fixed", 100),
+        Coupon("LARGE", "fixed", 200),
+    ]
+
+    assert apply_coupons(2000, coupons, date(2026, 1, 1)) == (1300, ["LARGE", "SMALL", "TWENTY"])
+
+
+def test_apply_coupons_breaks_percent_ties_by_code():
+    coupons = [Coupon("ZED", "percent", 10), Coupon("ALPHA", "percent", 10)]
+
+    assert apply_coupons(1000, coupons, date(2026, 1, 1)) == (900, ["ALPHA"])
+
+
+def test_apply_coupons_eligibility_uses_original_subtotal_and_includes_expiry_date():
+    coupons = [
+        Coupon("EXPIRES-TODAY", "fixed", 100, expires=date(2026, 1, 1), min_subtotal_cents=1000),
+        Coupon("EXPIRED", "fixed", 200, expires=date(2025, 12, 31)),
+        Coupon("HIGH-MINIMUM", "fixed", 300, min_subtotal_cents=1001),
+    ]
+
+    assert apply_coupons(1000, coupons, date(2026, 1, 1)) == (900, ["EXPIRES-TODAY"])
+
+
+def test_apply_coupons_floors_total_at_zero():
+    coupons = [Coupon("HALF", "percent", 50), Coupon("BIG", "fixed", 1000)]
+
+    assert apply_coupons(1000, coupons, date(2026, 1, 1)) == (0, ["BIG", "HALF"])
+
+
+def test_apply_coupons_rejects_negative_subtotal():
+    with pytest.raises(ShopError, match="subtotal"):
+        apply_coupons(-1, [], date(2026, 1, 1))
