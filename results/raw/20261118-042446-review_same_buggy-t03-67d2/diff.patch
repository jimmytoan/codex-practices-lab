diff --git a/tests/test_inventory.py b/tests/test_inventory.py
index 37436c0..ac83ef8 100644
--- a/tests/test_inventory.py
+++ b/tests/test_inventory.py
@@ -1,6 +1,7 @@
 import pytest
 
 from shoplib.inventory import Inventory
+from shoplib.errors import ShopError
 
 
 def test_reserve_and_ship():
@@ -18,3 +19,43 @@ def test_cannot_reserve_more_than_available():
     inv.receive("A", 2)
     with pytest.raises(ValueError):
         inv.reserve("A", 3)
+
+
+def test_release_returns_reserved_stock_to_available():
+    inv = Inventory()
+    inv.receive("A", 10)
+    inv.reserve("A", 4)
+
+    inv.release("A", 3)
+
+    assert inv.on_hand("A") == 10
+    assert inv.reserved("A") == 1
+    assert inv.available("A") == 9
+
+
+@pytest.mark.parametrize("qty", [0, -1])
+def test_release_requires_positive_quantity_without_changing_stock(qty):
+    inv = Inventory()
+    inv.receive("A", 10)
+    inv.reserve("A", 4)
+
+    with pytest.raises(ShopError):
+        inv.release("A", qty)
+
+    assert inv.on_hand("A") == 10
+    assert inv.reserved("A") == 4
+
+
+@pytest.mark.parametrize("sku, qty", [("A", 3), ("B", 1)])
+def test_cannot_release_more_than_reserved_or_unreserved_stock(sku, qty):
+    inv = Inventory()
+    inv.receive("A", 10)
+    inv.reserve("A", 2)
+
+    with pytest.raises(ShopError):
+        inv.release(sku, qty)
+
+    assert inv.on_hand("A") == 10
+    assert inv.reserved("A") == 2
+    assert inv.on_hand("B") == 0
+    assert inv.reserved("B") == 0
