@@ -0,0 +1,70 @@
+import pytest
+
+from shoplib.errors import ShopError
+from shoplib.search import Product, search
+
+
+@pytest.fixture
+def products():
+    return [
+        Product("MUG-01", "Large Blue Ceramic Mug", 1250, ["Sale", "Kitchen"]),
+        Product("cup-02", "Blue Mug", 999, ["gift", "S*le"]),
+        Product("plate", "Dinner Plate", 2500, []),
+    ]
+
+
+def test_empty_query_matches_every_product_in_input_order(products):
+    assert search(products, " \t\n") == products
+
+
+def test_bare_and_quoted_terms_match_name_substrings(products):
+    assert search(products, "mUg") == products[:2]
+    assert search(products, '"blue mug"') == products[1:2]
+
+
+def test_name_field_matches_case_insensitive_substring(products):
+    assert search(products, 'name:"blue mug"') == products[1:2]
+    assert search(products, "name:CERAMIC") == products[:1]
+
+
+def test_sku_and_tag_exact_and_prefix_matching_are_case_insensitive(products):
+    assert search(products, "sku:mug-01") == products[:1]
+    assert search(products, "sku:CUP-*") == products[1:2]
+    assert search(products, "tag:SALE") == products[:1]
+    assert search(products, "tag:kit*") == products[:1]
+    assert search(products, "tag:s*le") == products[1:2]
+
+
+def test_case_insensitive_matching_uses_unicode_case_folding():
+    product = Product("STRASSE", "Straße Mug", 100, ["Straße"])
+    assert search([product], "name:STRASSE") == [product]
+    assert search([product], "sku:straße") == [product]
+    assert search([product], "tag:STRASSE") == [product]
+
+
+def test_negation_applies_to_a_term_including_a_quoted_field_value(products):
+    assert search(products, "-tag:SALE") == products[1:]
+    assert search(products, '-name:"blue mug"') == [products[0], products[2]]
+
+
+@pytest.mark.parametrize(
+    ("query", "expected"),
+    [
+        ("price<1250", [1]),
+        ("price<=1250", [0, 1]),
+        ("price>1250", [2]),
+        ("price>=1250", [0, 2]),
+        ("price=1250", [0]),
+    ],
+)
+def test_price_comparisons_use_integer_cents(products, query, expected):
+    assert search(products, query) == [products[i] for i in expected]
+
+
+@pytest.mark.parametrize(
+    "query",
+    ["color:red", "price:5", "price>=1.5", "tag:", "-", '"unclosed'],
+)
+def test_invalid_queries_raise_shop_error(query, products):
+    with pytest.raises(ShopError):
+        search(products, query)
