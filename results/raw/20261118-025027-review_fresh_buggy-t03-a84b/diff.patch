--- a/tests/test_inventory.py
+++ b/tests/test_inventory.py
@@ -1,5 +1,6 @@
 import pytest
 
+from shoplib.errors import ShopError
 from shoplib.inventory import Inventory
 
 
@@ -18,3 +19,38 @@ def test_cannot_reserve_more_than_available():
     inv.receive("A", 2)
     with pytest.raises(ValueError):
         inv.reserve("A", 3)
+
+
+def test_release_returns_reserved_stock_to_available():
+    inv = Inventory()
+    inv.receive("A", 10)
+    inv.reserve("A", 4)
+    inv.release("A", 2)
+    assert (inv.on_hand("A"), inv.reserved("A"), inv.available("A")) == (10, 2, 8)
+    inv.release("A", 2)
+    assert (inv.on_hand("A"), inv.reserved("A"), inv.available("A")) == (10, 0, 10)
+
+
+@pytest.mark.parametrize("qty", [0, -1])
+@pytest.mark.parametrize("sku", ["A", "unknown"])
+def test_release_rejects_nonpositive_quantity_without_changes(sku, qty):
+    inv = Inventory()
+    inv.receive("A", 10)
+    inv.reserve("A", 4)
+    with pytest.raises(ShopError):
+        inv.release(sku, qty)
+    assert (inv.on_hand("A"), inv.reserved("A"), inv.available("A")) == (10, 4, 6)
+    assert (inv.on_hand("unknown"), inv.reserved("unknown")) == (0, 0)
+
+
+@pytest.mark.parametrize("sku,qty", [("A", 5), ("A", 11), ("B", 1), ("unknown", 1)])
+def test_release_rejects_more_than_reserved_without_changes(sku, qty):
+    inv = Inventory()
+    inv.receive("A", 10)
+    inv.reserve("A", 4)
+    inv.receive("B", 10)
+    with pytest.raises(ShopError):
+        inv.release(sku, qty)
+    assert (inv.on_hand("A"), inv.reserved("A"), inv.available("A")) == (10, 4, 6)
+    assert (inv.on_hand("B"), inv.reserved("B"), inv.available("B")) == (10, 0, 10)
+    assert (inv.on_hand("unknown"), inv.reserved("unknown")) == (0, 0)
