+def test_split_parcels_uses_first_fit_and_sorts_equal_weights_by_sku():
+    items = [("d", 200, 1), ("c", 300, 1), ("b", 600, 1), ("a", 700, 1)]
+    assert split_parcels(items, 1000) == [["a", "c"], ["b", "d"]]
+
+    items = [("z", 400, 2), ("b", 600, 1), ("a", 400, 1)]
+    assert split_parcels(items, 1000) == [["b", "a"], ["z", "z"]]
+
+
+@pytest.mark.parametrize(
+    "items, limit",
+    [
+        ([("sku", 0, 1)], 1000),
+        ([("sku", -1, 1)], 1000),
+        ([("sku", 1001, 1)], 1000),
+        ([("sku", 100, 0)], 1000),
+        ([("sku", 100, -1)], 1000),
+        ([("sku", 1, 1)], 0),
+    ],
+)
+def test_split_parcels_rejects_invalid_items(items, limit):
+    with pytest.raises(ShopError):
+        split_parcels(items, limit)
+    with pytest.raises(ShopError):
+        shipment_cost(items, limit)
+
+
+def test_empty_shipment():
+    assert split_parcels([], 0) == []
+    assert shipment_cost([], 0) == 0
+
+
+def test_shipment_cost_with_repeated_sku_at_different_weights(monkeypatch):
+    items = [("a", 1450, 1), ("a", 800, 1), ("a", 300, 1), ("a", 100, 1)]
+    assert split_parcels(items, 1750) == [["a", "a"], ["a", "a"]]
+    assert shipment_cost(items, 1750) == 1300
+
+    weights = []
+
+    def record_cost(weight):
+        weights.append(weight)
+        return 1
+
+    monkeypatch.setattr("shoplib.shipping.shipping_cost", record_cost)
+    assert shipment_cost(items, 1750) == 2
+    assert weights == [1750, 900]
+
+
+def test_shipment_cost_propagates_unsupported_parcel_weight_as_shop_error():
