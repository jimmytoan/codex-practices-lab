diff --git a/src/shoplib/orders.py b/src/shoplib/orders.py
index 8edb164..6b04a92 100644
--- a/src/shoplib/orders.py
+++ b/src/shoplib/orders.py
@@ -1,5 +1,6 @@
 """Orders and their life cycle. See docs/order-states.md."""
 
+from .errors import ShopError
 from .inventory import Inventory
 
 NEW = "NEW"
@@ -13,7 +14,7 @@ class Order:
     def __init__(self, order_id: str, lines: dict[str, int], inventory: Inventory):
         """Create an order for `lines` (sku -> qty) and reserve its stock."""
         if not lines:
-            raise ValueError("an order needs at least one line")
+            raise ShopError("an order needs at least one line")
         self.order_id = order_id
         self.lines = dict(lines)
         self.inventory = inventory
@@ -31,7 +32,7 @@ class Order:
 
     def _transition(self, allowed_from: tuple[str, ...], to: str) -> None:
         if self.state not in allowed_from:
-            raise ValueError(f"cannot go from {self.state} to {to}")
+            raise ShopError(f"cannot go from {self.state} to {to}")
         self.state = to
 
     def pay(self) -> None:
@@ -39,10 +40,29 @@ class Order:
 
     def ship(self) -> None:
         if self.state != PAID:
-            raise ValueError(f"cannot go from {self.state} to {SHIPPED}")
+            raise ShopError(f"cannot go from {self.state} to {SHIPPED}")
         for sku, qty in self.lines.items():
             self.inventory.ship(sku, qty)
         self.state = SHIPPED
 
     def deliver(self) -> None:
         self._transition((SHIPPED,), DELIVERED)
+
+    def cancel(self) -> None:
+        if self.state == CANCELLED:
+            return
+        if self.state not in (NEW, PAID):
+            raise ShopError(f"cannot go from {self.state} to {CANCELLED}")
+
+        released = []
+        try:
+            for sku, qty in self.lines.items():
+                self.inventory.release(sku, qty)
+                released.append((sku, qty))
+        except Exception:
+            for sku, qty in released:
+                self.inventory.reserve(sku, qty)
+            raise
+
+        self.refund_due = self.state == PAID
+        self.state = CANCELLED
diff --git a/tests/test_inventory.py b/tests/test_inventory.py
index 37436c0..333a6aa 100644
--- a/tests/test_inventory.py
+++ b/tests/test_inventory.py
@@ -1,5 +1,6 @@
 import pytest
 
+from shoplib.errors import ShopError
 from shoplib.inventory import Inventory
 
 
@@ -18,3 +19,25 @@ def test_cannot_reserve_more_than_available():
     inv.receive("A", 2)
     with pytest.raises(ValueError):
         inv.reserve("A", 3)
+
+
+def test_release_returns_reserved_stock_to_available():
+    inv = Inventory()
+    inv.receive("A", 10)
+    inv.reserve("A", 6)
+    inv.release("A", 2)
+    assert (inv.on_hand("A"), inv.reserved("A"), inv.available("A")) == (10, 4, 6)
+    inv.release("A", 4)
+    assert (inv.on_hand("A"), inv.reserved("A"), inv.available("A")) == (10, 0, 10)
+
+
+@pytest.mark.parametrize("sku, qty", [("A", 0), ("A", -1), ("A", 4), ("missing", 1)])
+def test_invalid_release_leaves_inventory_unchanged(sku, qty):
+    inv = Inventory()
+    inv.receive("A", 5)
+    inv.reserve("A", 3)
+    before = (inv.on_hand("A"), inv.reserved("A"), inv.available("A"))
+    with pytest.raises(ShopError):
+        inv.release(sku, qty)
+    assert (inv.on_hand("A"), inv.reserved("A"), inv.available("A")) == before
+    assert inv.reserved("missing") == 0
diff --git a/tests/test_orders.py b/tests/test_orders.py
index d3835d1..810ea5a 100644
--- a/tests/test_orders.py
+++ b/tests/test_orders.py
@@ -1,7 +1,8 @@
 import pytest
 
+from shoplib.errors import ShopError
 from shoplib.inventory import Inventory
-from shoplib.orders import DELIVERED, NEW, Order
+from shoplib.orders import CANCELLED, DELIVERED, NEW, PAID, SHIPPED, Order
 
 
 def make():
@@ -25,3 +26,73 @@ def test_cannot_ship_unpaid():
     _, order = make()
     with pytest.raises(ValueError):
         order.ship()
+
+
+@pytest.mark.parametrize("paid", [False, True])
+def test_cancel_releases_order_stock_and_is_idempotent(paid):
+    inv = Inventory()
+    inv.receive("A", 10)
+    inv.receive("B", 8)
+    order = Order("o1", {"A": 2, "B": 3}, inv)
+    other = Order("o2", {"A": 4, "B": 1}, inv)
+    if paid:
+        order.pay()
+
+    order.cancel()
+    assert order.state == CANCELLED
+    assert order.refund_due is paid
+    assert (inv.on_hand("A"), inv.reserved("A"), inv.available("A")) == (10, 4, 6)
+    assert (inv.on_hand("B"), inv.reserved("B"), inv.available("B")) == (8, 1, 7)
+
+    order.cancel()
+    assert order.state == CANCELLED
+    assert order.refund_due is paid
+    assert (inv.reserved("A"), inv.reserved("B")) == (4, 1)
+    other.pay()
+    other.ship()
+    assert (inv.on_hand("A"), inv.reserved("A")) == (6, 0)
+    assert (inv.on_hand("B"), inv.reserved("B")) == (7, 0)
+
+
+@pytest.mark.parametrize("delivered", [False, True])
+def test_cannot_cancel_shipped_or_delivered_order(delivered):
+    inv, order = make()
+    order.pay()
+    order.ship()
+    if delivered:
+        order.deliver()
+    before = (inv.on_hand("A"), inv.reserved("A"), inv.available("A"))
+
+    with pytest.raises(ShopError):
+        order.cancel()
+    assert order.state == (DELIVERED if delivered else SHIPPED)
+    assert order.refund_due is False
+    assert (inv.on_hand("A"), inv.reserved("A"), inv.available("A")) == before
+
+
+@pytest.mark.parametrize("paid", [False, True])
+def test_failed_cancel_restores_previously_released_lines(paid):
+    inv = Inventory()
+    inv.receive("A", 5)
+    inv.receive("B", 5)
+    order = Order("o1", {"A": 2, "B": 3}, inv)
+    if paid:
+        order.pay()
+    inv.release("B", 1)
+    before = [(inv.on_hand(sku), inv.reserved(sku), inv.available(sku)) for sku in ("A", "B")]
+
+    with pytest.raises(ShopError):
+        order.cancel()
+    assert order.state == (PAID if paid else NEW)
+    assert order.refund_due is False
+    assert [(inv.on_hand(sku), inv.reserved(sku), inv.available(sku)) for sku in ("A", "B")] == before
+
+
+@pytest.mark.parametrize("action", ["pay", "ship", "deliver"])
+def test_cancelled_order_cannot_progress(action):
+    inv, order = make()
+    order.cancel()
+    with pytest.raises(ShopError):
+        getattr(order, action)()
+    assert order.state == CANCELLED
+    assert (inv.on_hand("A"), inv.reserved("A"), inv.available("A")) == (5, 0, 5)
