+def test_apply_coupons_breaks_percent_ties_by_code_and_sorts_applied_codes():
+    coupons = [
+        Coupon("ZED", "percent", 15),
+        Coupon("ABLE", "percent", 15),
+        Coupon("MID", "fixed", 100),
+    ]
+
+    assert apply_coupons(1000, coupons, date(2026, 1, 1)) == (750, ["ABLE", "MID"])
+
+
+def test_apply_coupons_eligibility_uses_original_subtotal_and_inclusive_expiry():
+    coupons = [
+        Coupon("VALID-TODAY", "fixed", 200, expires=date(2026, 1, 1), min_subtotal_cents=1000),
+        Coupon("EXPIRED", "fixed", 200, expires=date(2025, 12, 31)),
+        Coupon("TOO-HIGH-MIN", "fixed", 200, min_subtotal_cents=1001),
+    ]
+
+    assert apply_coupons(1000, coupons, date(2026, 1, 1)) == (800, ["VALID-TODAY"])
