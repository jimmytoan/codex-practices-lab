diff --git a/tests/test_inventory.py b/tests/test_inventory.py
index 37436c0..c0ded25 100644
--- a/tests/test_inventory.py
+++ b/tests/test_inventory.py
@@ -18,3 +18,47 @@ def test_cannot_reserve_more_than_available():
     inv.receive("A", 2)
     with pytest.raises(ValueError):
         inv.reserve("A", 3)
+
+
+def test_release_returns_reserved_units_to_available():
+    inv = Inventory()
+    inv.receive("A", 10)
+    inv.reserve("A", 6)
+
+    inv.release("A", 2)
+
+    assert inv.on_hand("A") == 10
+    assert inv.reserved("A") == 4
+    assert inv.available("A") == 6
+
+    inv.release("A", 4)
+    assert inv.reserved("A") == 0
+    assert inv.available("A") == 10
+
+
+@pytest.mark.parametrize("qty", [0, -1])
+def test_release_requires_positive_quantity_without_changing_stock(qty):
+    inv = Inventory()
+    inv.receive("A", 5)
+    inv.reserve("A", 3)
+
+    with pytest.raises(ValueError, match="qty must be positive"):
+        inv.release("A", qty)
+
+    assert inv.on_hand("A") == 5
+    assert inv.reserved("A") == 3
+    assert inv.available("A") == 2
+
+
+@pytest.mark.parametrize("sku, qty", [("A", 3), ("B", 1)])
+def test_release_cannot_exceed_reserved_quantity(sku, qty):
+    inv = Inventory()
+    inv.receive("A", 5)
+    inv.reserve("A", 2)
+
+    with pytest.raises(ValueError):
+        inv.release(sku, qty)
+
+    assert inv.on_hand("A") == 5
+    assert inv.reserved("A") == 2
+    assert inv.available("A") == 3
