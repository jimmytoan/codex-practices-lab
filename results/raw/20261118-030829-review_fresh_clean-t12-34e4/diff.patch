@@ -0,0 +1,83 @@
+import pytest
+
+from shoplib.errors import ShopError
+from shoplib.search import Product, search
+
+
+@pytest.fixture
+def products():
+    return [
+        Product("MUG-BLUE", "Blue Mug", 1000, ["Sale", "ceramic"]),
+        Product("MUG-RED", "Red mug", 1500, ["new"]),
+        Product("PLATE", "Blue plate", 500, ["sale"]),
+        Product("MUG-*X", "A tag:sale sign", 1000, ["star*x"]),
+    ]
+
+
+@pytest.mark.parametrize("query", ["", " \t\n "])
+def test_empty_query_preserves_order(products, query):
+    assert search(products, query) == products
+
+
+@pytest.mark.parametrize(
+    ("query", "indices"),
+    [
+        ("mUG", [0, 1]),
+        ('"blue mug"', [0]),
+        ('name:"BLUE MUG"', [0]),
+        ('"tag:sale"', [3]),
+        ('"-blue"', []),
+        ("blue tag:SALE", [0, 2]),
+        ("sku:mug-blue", [0]),
+        ("sku:mug", []),
+        ("tag:sal", []),
+        ("sku:MUG-*", [0, 1, 3]),
+        ("tag:sal*", [0, 2]),
+        ("sku:MUG-*X", [3]),
+        ("tag:star*x", [3]),
+        ("name:Blue*", []),
+        ("-tag:sale", [1, 3]),
+        ('-name:"blue mug"', [1, 2, 3]),
+        ('-"blue mug"', [1, 2, 3]),
+        ("-price>=1000", [2]),
+        ("price<1000", [2]),
+        ("price<=1000", [0, 2, 3]),
+        ("price>1000", [1]),
+        ("price>=1000", [0, 1, 3]),
+        ("price=1000", [0, 3]),
+        ("price=001000", [0, 3]),
+        ('price>=10"00"', [0, 1, 3]),
+        ('"price>=1000"', []),
+    ],
+)
+def test_queries(products, query, indices):
+    assert search(products, query) == [products[i] for i in indices]
+
+
+@pytest.mark.parametrize(
+    "query",
+    [
+        "colour:blue", "price:5", ":value", "tag:", 'tag:""',
+        "name:", "sku:", "-", '"unclosed', 'name:"unclosed',
+        "price<", "price>=abc", "price=1.5", "price=-1", "price=+1",
+        "price==5", "price><5", 'price>="bad"', 'price>""',
+        "-price=oops", "-unknown:value",
+    ],
+)
+def test_invalid_queries_raise_shop_error_even_without_products(query):
+    with pytest.raises(ShopError):
+        search([], query)
+
+
+def test_unicode_case_insensitive_matching():
+    product = Product("STRAẞE", "Große Tasse", 1, ["GRÜẞE"])
+    for query in ("GROSSE", "name:grosse", "sku:strasse", "sku:stra*",
+                  "tag:grüsse", "tag:grüss*"):
+        assert search([product], query) == [product]
+
+
+def test_prices_with_more_digits_than_python_int_conversion_limit(products):
+    assert search(products, "price>" + "0" * 5000 + "999") == [
+        products[0], products[1], products[3]
+    ]
+    assert search(products, "price<" + "9" * 5000) == products
