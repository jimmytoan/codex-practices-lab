 # (upper bound in grams, cost in cents)
 TIERS = [(1000, 500), (2000, 800), (5000, 1200), (20000, 2500)]
 
@@ -14,11 +16,49 @@ def shipping_cost(weight_g: int) -> int:
     raise ValueError("parcel is too heavy")
 
 
+def _split_weighted_parcels(
+    items: list[tuple[str, int, int]], max_weight_g: int
+) -> list[list[tuple[str, int]]]:
+    units = []
+    for sku, unit_weight_g, qty in items:
+        if qty < 1:
+            raise ShopError("quantity must be at least 1")
+        if unit_weight_g < 1:
+            raise ShopError("unit weight must be positive")
+        if unit_weight_g > max_weight_g:
+            raise ShopError("unit is heavier than the parcel limit")
+        units.extend([(sku, unit_weight_g)] * qty)
+
+    units.sort(key=lambda unit: (-unit[1], unit[0]))
+
+    parcels: list[list[tuple[str, int]]] = []
+    parcel_weights: list[int] = []
+    for sku, unit_weight_g in units:
+        for index, parcel_weight_g in enumerate(parcel_weights):
+            if parcel_weight_g + unit_weight_g <= max_weight_g:
+                parcels[index].append((sku, unit_weight_g))
+                parcel_weights[index] += unit_weight_g
+                break
+        else:
+            parcels.append([(sku, unit_weight_g)])
+            parcel_weights.append(unit_weight_g)
+
+    return parcels
+
+
 def split_parcels(items: list[tuple[str, int, int]], max_weight_g: int) -> list[list[str]]:
     """Split order items into parcels. See docs/shipping.md."""
-    raise NotImplementedError
+    return [
+        [sku for sku, _ in parcel]
+        for parcel in _split_weighted_parcels(items, max_weight_g)
+    ]
 
 
 def shipment_cost(items: list[tuple[str, int, int]], max_weight_g: int) -> int:
     """Total shipping cost of an order. See docs/shipping.md."""
-    raise NotImplementedError
+    parcels = _split_weighted_parcels(items, max_weight_g)
+    parcel_costs = []
+    for parcel in parcels:
+        parcel_weight_g = sum(unit_weight_g for _, unit_weight_g in parcel)
+        parcel_costs.append(shipping_cost(parcel_weight_g))
+    return sum(parcel_costs)
