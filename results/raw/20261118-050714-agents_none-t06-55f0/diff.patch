diff --git a/tests/test_dates.py b/tests/test_dates.py
index fbfd5f2..a6b9452 100644
--- a/tests/test_dates.py
+++ b/tests/test_dates.py
@@ -12,3 +12,25 @@ def test_forward_over_weekend():
     # Friday + 1 business day = Monday
     assert add_business_days(date(2026, 11, 13), 1) == date(2026, 11, 16)
     assert add_business_days(date(2026, 11, 16), 3) == date(2026, 11, 19)
+
+
+def test_holidays_are_skipped():
+    # Tuesday is a holiday, so Monday + 1 business day = Wednesday.
+    assert add_business_days(
+        date(2026, 11, 16), 1, holidays={date(2026, 11, 17)}
+    ) == date(2026, 11, 18)
+
+
+def test_move_backward_over_weekend_and_holiday():
+    # Friday is a holiday, so Monday - 1 business day = Thursday.
+    assert add_business_days(
+        date(2026, 11, 16), -1, holidays={date(2026, 11, 13)}
+    ) == date(2026, 11, 12)
+
+
+def test_zero_returns_start_or_next_business_day():
+    assert add_business_days(date(2026, 11, 16), 0) == date(2026, 11, 16)
+    assert add_business_days(date(2026, 11, 15), 0) == date(2026, 11, 16)
+    assert add_business_days(
+        date(2026, 11, 16), 0, holidays={date(2026, 11, 16)}
+    ) == date(2026, 11, 17)
