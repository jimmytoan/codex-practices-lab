diff --git a/tests/test_inventory.py b/tests/test_inventory.py
index 37436c0..730acda 100644
--- a/tests/test_inventory.py
+++ b/tests/test_inventory.py
@@ -1,5 +1,6 @@
 import pytest
 
+from shoplib.errors import ShopError
 from shoplib.inventory import Inventory
 
 
@@ -18,3 +19,40 @@ def test_cannot_reserve_more_than_available():
     inv.receive("A", 2)
     with pytest.raises(ValueError):
         inv.reserve("A", 3)
+
+
+def test_release_partial_and_all_reserved_stock():
+    inv = Inventory()
+    inv.receive("A", 10)
+    inv.reserve("A", 4)
+
+    inv.release("A", 2)
+    assert (inv.on_hand("A"), inv.reserved("A"), inv.available("A")) == (10, 2, 8)
+
+    inv.release("A", 2)
+    assert (inv.on_hand("A"), inv.reserved("A"), inv.available("A")) == (10, 0, 10)
+
+
+@pytest.mark.parametrize("qty", [-1, 0, 5, 11])
+def test_invalid_release_preserves_stock(qty):
+    inv = Inventory()
+    inv.receive("A", 10)
+    inv.reserve("A", 4)
+
+    with pytest.raises(ShopError):
+        inv.release("A", qty)
+    assert (inv.on_hand("A"), inv.reserved("A"), inv.available("A")) == (10, 4, 6)
+
+
+@pytest.mark.parametrize("on_hand", [0, 3])
+@pytest.mark.parametrize("qty", [0, 1])
+def test_release_without_reservations_raises_and_preserves_stock(on_hand, qty):
+    inv = Inventory()
+    if on_hand:
+        inv.receive("A", on_hand)
+
+    with pytest.raises(ShopError):
+        inv.release("A", qty)
+    assert (inv.on_hand("A"), inv.reserved("A"), inv.available("A")) == (
+        on_hand, 0, on_hand
+    )
