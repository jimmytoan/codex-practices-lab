 def test_tiers():
@@ -15,3 +15,47 @@ def test_invalid_weight():
         shipping_cost(0)
     with pytest.raises(ValueError):
         shipping_cost(25000)
+
+
+def test_split_parcels_first_fit_and_unit_order():
+    items = [("z", 4, 1), ("b", 6, 1), ("a", 6, 1), ("c", 4, 2)]
+    assert split_parcels(items, 10) == [["a", "c"], ["b", "c"], ["z"]]
+
+
+def test_split_parcels_revisits_first_parcel_with_room():
+    items = [("a", 8, 1), ("b", 7, 1), ("c", 3, 1), ("d", 2, 1)]
+    assert split_parcels(items, 10) == [["a", "d"], ["b", "c"]]
+
+
+@pytest.mark.parametrize(
+    "items, limit",
+    [
+        ([("a", 0, 1)], 10),
+        ([("a", -1, 1)], 10),
+        ([("a", 1, 0)], 10),
+        ([("a", 1, -1)], 10),
+        ([("a", 11, 1)], 10),
+        ([("a", 1, 1)], 0),
+    ],
+)
+def test_invalid_items(items, limit):
+    with pytest.raises(ValueError):
+        split_parcels(items, limit)
+    with pytest.raises(ValueError):
+        shipment_cost(items, limit)
+
+
+def test_empty_order():
+    assert split_parcels([], 0) == []
+    assert shipment_cost([], 0) == 0
+
+
+def test_shipment_cost_preserves_weights_for_repeated_skus():
+    items = [("a", 1800, 1), ("a", 1100, 1), ("a", 200, 1)]
+    assert split_parcels(items, 2000) == [["a", "a"], ["a"]]
+    assert shipment_cost(items, 2000) == shipping_cost(2000) + shipping_cost(1100)
+
+
+def test_shipment_cost_propagates_parcel_weight_error():
+    with pytest.raises(ValueError):
+        shipment_cost([("a", 21000, 1)], 21000)
