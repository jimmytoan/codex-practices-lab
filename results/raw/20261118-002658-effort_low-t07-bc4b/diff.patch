 def test_fixed_never_negative():
     assert apply_coupon(300, Coupon("FIVE", "fixed", 500)) == 0
+
+
+def test_combines_eligible_coupons_using_original_subtotal():
+    today = date(2026, 5, 10)
+    coupons = [
+        Coupon("Z", "percent", 10),
+        Coupon("B", "percent", 20),
+        Coupon("A", "percent", 20, expires=today),
+        Coupon("FIX", "fixed", 100, min_subtotal_cents=1001),
+        Coupon("EXPIRED", "fixed", 999, expires=date(2026, 5, 9)),
+        Coupon("MINIMUM", "fixed", 999, min_subtotal_cents=1002),
+    ]
+    assert apply_coupons(1001, coupons, today) == (701, ["A", "FIX"])
+
+
+def test_percent_rounds_half_up_before_fixed_discounts():
+    coupons = [Coupon("P", "percent", 10), Coupon("F", "fixed", 1)]
+    assert apply_coupons(5, coupons, date(2026, 1, 1)) == (3, ["F", "P"])
+
+
+def test_all_eligible_fixed_coupons_apply_even_when_total_is_zero():
+    coupons = [Coupon("Z", "fixed", 500), Coupon("A", "fixed", 200)]
+    assert apply_coupons(100, coupons, date(2026, 1, 1)) == (0, ["A", "Z"])
+
+
+def test_no_coupons_and_negative_subtotal():
+    today = date(2026, 1, 1)
+    assert apply_coupons(123, [], today) == (123, [])
+    with pytest.raises(ShopError):
+        apply_coupons(-1, [], today)
+
+
+def test_unknown_eligible_coupon_kind_raises_shop_error():
+    with pytest.raises(ShopError):
+        apply_coupons(100, [Coupon("BAD", "other", 1)], date(2026, 1, 1))
