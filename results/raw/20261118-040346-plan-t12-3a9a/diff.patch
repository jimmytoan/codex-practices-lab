@@ -0,0 +1,66 @@
+import pytest
+
+from shoplib.errors import ShopError
+from shoplib.search import Product, search
+
+
+@pytest.fixture
+def products():
+    return [
+        Product("MUG-RED", "Red ceramic mug", 1250, ["drinkware", "sale"]),
+        Product("MUG-BLUE", "Blue mug", 1000, ["drinkware"]),
+        Product("PLATE-1", "Blue dinner plate", 750, ["tableware", "sale"]),
+    ]
+
+
+def test_bare_terms_are_case_insensitive_substrings_and_intersect(products):
+    assert search(products, "mUg blue") == [products[1]]
+    assert search(products, "") == products
+    assert search(products, "  \t") == products
+
+
+def test_quotes_wrap_whole_terms_or_field_values(products):
+    assert search(products, '"blue mug"') == [products[1]]
+    assert search(products, 'name:"blue mug"') == [products[1]]
+    # A quoted whole term remains a name search even when it contains a colon.
+    assert search(products, '"tag:sale"') == []
+
+
+def test_sku_and_tag_support_case_insensitive_exact_and_prefix_matches(products):
+    assert search(products, "sku:mug-blue") == [products[1]]
+    assert search(products, "sku:MUG-*") == products[:2]
+    assert search(products, "tag:SALE") == [products[0], products[2]]
+    assert search(products, "tag:table*") == [products[2]]
+    # An asterisk not at the end is an ordinary character.
+    assert search(products, "tag:sa*le") == []
+
+
+def test_price_comparisons_and_negation(products):
+    assert search(products, "price<1000") == [products[2]]
+    assert search(products, "price<=1000") == [products[1], products[2]]
+    assert search(products, "price>1000") == [products[0]]
+    assert search(products, "price>=1000") == products[:2]
+    assert search(products, "price=1000") == [products[1]]
+    assert search(products, "-tag:sale") == [products[1]]
+    assert search(products, "-price>=1000") == [products[2]]
+    assert search(products, '"price>=1000"') == []
+
+
+@pytest.mark.parametrize(
+    "query",
+    [
+        "unknown:value",
+        "price:5",
+        "tag:",
+        "name:",
+        "-",
+        '"unclosed',
+        "price>abc",
+        "price>=1.5",
+        "price<",
+    ],
+)
+def test_invalid_queries_raise_value_error(query, products):
+    # ShopError is the project's ValueError subtype for invalid input.
+    with pytest.raises(ShopError):
+        search(products, query)
