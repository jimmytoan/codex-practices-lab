 """Shipping costs and parcel splitting. See docs/shipping.md."""
 
+from shoplib.errors import ShopError
+
 # (upper bound in grams, cost in cents)
 TIERS = [(1000, 500), (2000, 800), (5000, 1200), (20000, 2500)]
 
@@ -14,11 +16,50 @@ def shipping_cost(weight_g: int) -> int:
     raise ValueError("parcel is too heavy")
 
 
+def _pack_units(
+    items: list[tuple[str, int, int]], max_weight_g: int
+) -> list[list[tuple[str, int]]]:
+    units = []
+    for sku, unit_weight_g, qty in items:
+        if qty < 1:
+            raise ShopError("quantity must be at least 1")
+        if unit_weight_g < 1:
+            raise ShopError("unit weight must be positive")
+        if unit_weight_g > max_weight_g:
+            raise ShopError("unit is too heavy for a parcel")
+        units.extend((unit_weight_g, sku) for _ in range(qty))
+
+    # Sorting the expanded units makes the packing order explicit, including
+    # the SKU tie-break for units with equal weight.
+    units.sort(key=lambda unit: (-unit[0], unit[1]))
+
+    parcels = []
+    parcel_weights = []
+    for unit_weight_g, sku in units:
+        for index, parcel_weight_g in enumerate(parcel_weights):
+            if parcel_weight_g + unit_weight_g <= max_weight_g:
+                parcels[index].append((sku, unit_weight_g))
+                parcel_weights[index] += unit_weight_g
+                break
+        else:
+            parcels.append([(sku, unit_weight_g)])
+            parcel_weights.append(unit_weight_g)
+
+    return parcels
+
+
 def split_parcels(items: list[tuple[str, int, int]], max_weight_g: int) -> list[list[str]]:
     """Split order items into parcels. See docs/shipping.md."""
-    raise NotImplementedError
+    return [[sku for sku, _ in parcel] for parcel in _pack_units(items, max_weight_g)]
 
 
 def shipment_cost(items: list[tuple[str, int, int]], max_weight_g: int) -> int:
     """Total shipping cost of an order. See docs/shipping.md."""
-    raise NotImplementedError
+    parcels = split_parcels(items, max_weight_g)
+    # Keep weights alongside units internally because the public parcel value
+    # contains SKUs only, and repeated SKUs need not have identical weights.
+    weighted_parcels = _pack_units(items, max_weight_g)
+    return sum(
+        shipping_cost(sum(weight for _, weight in weighted_parcel))
+        for _, weighted_parcel in zip(parcels, weighted_parcels)
+    )
