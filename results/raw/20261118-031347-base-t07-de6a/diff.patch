+def test_apply_coupons_selects_highest_percent_and_applies_all_eligible_fixed():
+    today = date(2025, 1, 10)
+    coupons = [
+        Coupon("B20", "percent", 20),
+        Coupon("A20", "percent", 20),
+        Coupon("TEN", "percent", 10),
+        Coupon("EXPIRED", "percent", 90, expires=today - timedelta(days=1)),
+        Coupon("F1", "fixed", 100, min_subtotal_cents=900),
+        Coupon("F2", "fixed", 500, expires=today, min_subtotal_cents=950),
+        Coupon("TOO-LATE", "fixed", 1, expires=today - timedelta(days=1)),
+        Coupon("TOO-HIGH", "fixed", 1, min_subtotal_cents=1001),
+    ]
+
+    # The minimums use the original subtotal, even after the percent discount.
+    assert apply_coupons(1000, coupons, today) == (200, ["A20", "F1", "F2"])
+
+
+def test_apply_coupons_percent_uses_half_up_money_helper():
+    assert apply_coupons(5, [Coupon("TEN", "percent", 10)], date.today()) == (4, ["TEN"])
+
+
+def test_apply_coupons_returns_original_subtotal_when_nothing_is_eligible():
+    today = date(2025, 1, 10)
+    coupons = [
+        Coupon("LATER", "fixed", 100, expires=today - timedelta(days=1)),
+        Coupon("MINIMUM", "percent", 50, min_subtotal_cents=101),
+    ]
+
+    assert apply_coupons(100, coupons, today) == (100, [])
+
+
+def test_apply_coupons_never_returns_a_negative_total():
+    assert apply_coupons(300, [Coupon("BIG", "fixed", 500)], date.today()) == (0, ["BIG"])
+
+
+def test_apply_coupons_rejects_negative_subtotal():
+    with pytest.raises(ShopError):
+        apply_coupons(-1, [], date.today())
