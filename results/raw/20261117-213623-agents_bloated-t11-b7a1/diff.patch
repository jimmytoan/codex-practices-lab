diff --git a/src/shoplib/invoice.py b/src/shoplib/invoice.py
index 5d1398c..9d16e0b 100644
--- a/src/shoplib/invoice.py
+++ b/src/shoplib/invoice.py
@@ -1,5 +1,8 @@
 """Invoices: coupon allocation and tax. See docs/invoicing.md."""
 
+from .errors import ShopError
+from .money import percent_of
+
 # Tax rates in percent, by region and product category.
 TAX_RATES = {
     "DE": {"standard": 19, "food": 7, "books": 7},
@@ -10,4 +13,57 @@ TAX_RATES = {
 
 def build_invoice(lines, coupon_cents: int, shipping_cents: int, region: str) -> dict:
     """Build an invoice for an order. See docs/invoicing.md."""
-    raise NotImplementedError
+    if not isinstance(region, str) or region not in TAX_RATES:
+        raise ShopError("unknown region")
+    if not isinstance(lines, list) or not lines:
+        raise ShopError("lines must be a nonempty list")
+    for amount in (coupon_cents, shipping_cents):
+        if type(amount) is not int or amount < 0:
+            raise ShopError("amount must be a nonnegative integer")
+
+    rates = TAX_RATES[region]
+    gross_amounts = []
+    for line in lines:
+        if not isinstance(line, (tuple, list)) or len(line) != 4:
+            raise ShopError("invalid line")
+        _, price, qty, category = line
+        if type(price) is not int or price < 0:
+            raise ShopError("price must be a nonnegative integer")
+        if type(qty) is not int or qty < 1:
+            raise ShopError("quantity must be a positive integer")
+        if not isinstance(category, str) or category not in rates:
+            raise ShopError("unknown category")
+        gross_amounts.append(price * qty)
+
+    total_gross = sum(gross_amounts)
+    coupon = min(coupon_cents, total_gross)
+    discounts = [0] * len(lines)
+    if total_gross:
+        allocations = [divmod(coupon * gross, total_gross) for gross in gross_amounts]
+        discounts = [allocation for allocation, _ in allocations]
+        remaining = coupon - sum(discounts)
+        order = sorted(range(len(lines)), key=lambda i: -allocations[i][1])
+        for i in order[:remaining]:
+            discounts[i] += 1
+
+    invoice_lines = []
+    for (sku, _, _, category), gross, discount in zip(lines, gross_amounts, discounts):
+        net = gross - discount
+        invoice_lines.append({
+            "sku": sku,
+            "gross_cents": gross,
+            "discount_cents": discount,
+            "net_cents": net,
+            "tax_cents": percent_of(net, rates[category]),
+        })
+
+    shipping_tax = 0
+    if any(rates[category] > 0 for _, _, _, category in lines):
+        shipping_tax = percent_of(shipping_cents, rates["standard"])
+    total = sum(line["net_cents"] + line["tax_cents"] for line in invoice_lines)
+    return {
+        "lines": invoice_lines,
+        "shipping_cents": shipping_cents,
+        "shipping_tax_cents": shipping_tax,
+        "total_cents": total + shipping_cents + shipping_tax,
+    }
diff --git a/tests/test_invoice.py b/tests/test_invoice.py
new file mode 100644
index 0000000..df51a92
--- /dev/null
+++ b/tests/test_invoice.py
@@ -0,0 +1,102 @@
+import pytest
+
+from shoplib.errors import ShopError
+from shoplib.invoice import build_invoice
+
+
+def test_invoice_splits_coupon_by_largest_remainder_and_calculates_tax():
+    invoice = build_invoice(
+        [("A", 100, 2, "standard"), ("B", 100, 1, "food"),
+         ("C", 50, 1, "books")],
+        coupon_cents=5,
+        shipping_cents=100,
+        region="DE",
+    )
+
+    assert invoice == {
+        "lines": [
+            {"sku": "A", "gross_cents": 200, "discount_cents": 3,
+             "net_cents": 197, "tax_cents": 37},
+            {"sku": "B", "gross_cents": 100, "discount_cents": 1,
+             "net_cents": 99, "tax_cents": 7},
+            {"sku": "C", "gross_cents": 50, "discount_cents": 1,
+             "net_cents": 49, "tax_cents": 3},
+        ],
+        "shipping_cents": 100,
+        "shipping_tax_cents": 19,
+        "total_cents": 511,
+    }
+
+
+def test_largest_remainders_are_ranked_before_input_order():
+    invoice = build_invoice(
+        [("A", 3, 1, "standard"), ("B", 2, 1, "standard"),
+         ("C", 1, 1, "standard")], 4, 0, "OR"
+    )
+    assert [line["discount_cents"] for line in invoice["lines"]] == [2, 1, 1]
+
+
+def test_equal_remainders_favor_earlier_lines():
+    invoice = build_invoice(
+        [("A", 1, 1, "standard"), ("B", 1, 1, "standard"),
+         ("C", 1, 1, "standard")], 2, 0, "OR"
+    )
+    assert [line["discount_cents"] for line in invoice["lines"]] == [1, 1, 0]
+
+
+def test_coupon_is_capped_and_taxable_category_still_taxes_shipping():
+    invoice = build_invoice([("A", 5, 2, "food")], 100, 100, "DE")
+    assert invoice["lines"][0] == {
+        "sku": "A", "gross_cents": 10, "discount_cents": 10,
+        "net_cents": 0, "tax_cents": 0,
+    }
+    assert invoice["shipping_tax_cents"] == 19
+    assert invoice["total_cents"] == 119
+
+
+def test_zero_gross_gives_no_discount_but_category_controls_shipping_tax():
+    invoice = build_invoice(
+        [("A", 0, 1, "books"), ("B", 0, 2, "food")], 10, 50, "SG"
+    )
+    assert [line["discount_cents"] for line in invoice["lines"]] == [0, 0]
+    assert invoice["shipping_tax_cents"] == 5
+    assert invoice["total_cents"] == 55
+
+
+@pytest.mark.parametrize("region, category", [("SG", "books"), ("OR", "standard")])
+def test_shipping_is_not_taxed_when_all_lines_are_exempt(region, category):
+    invoice = build_invoice([("A", 100, 1, category)], 0, 100, region)
+    assert invoice["shipping_tax_cents"] == 0
+    assert invoice["total_cents"] == 200
+
+
+def test_tax_is_rounded_half_up_per_line_and_for_shipping():
+    invoice = build_invoice(
+        [("A", 50, 1, "food"), ("B", 50, 1, "food")], 0, 50, "DE"
+    )
+    assert [line["tax_cents"] for line in invoice["lines"]] == [4, 4]
+    assert invoice["shipping_tax_cents"] == 10
+    assert invoice["total_cents"] == 168
+
+
+@pytest.mark.parametrize(
+    "lines, coupon, shipping, region",
+    [
+        ([("A", 1, 1, "standard")], 0, 0, "unknown"),
+        ([("A", 1, 1, "unknown")], 0, 0, "DE"),
+        ([], 0, 0, "DE"),
+        ([("A", 1, 0, "standard")], 0, 0, "DE"),
+        ([("A", 1, -1, "standard")], 0, 0, "DE"),
+        ([("A", -1, 1, "standard")], 0, 0, "DE"),
+        ([("A", 1, 1, "standard")], -1, 0, "DE"),
+        ([("A", 1, 1, "standard")], 0, -1, "DE"),
+        ([("A", 1.5, 1, "standard")], 0, 0, "DE"),
+        ([("A", 1, 1.5, "standard")], 0, 0, "DE"),
+        ([("A", 1, 1, "standard")], 0.5, 0, "DE"),
+        ([("A", 1, 1, "standard")], 0, 0.5, "DE"),
+        ([("A", 1, 1)], 0, 0, "DE"),
+    ],
+)
+def test_invalid_invoice_arguments_raise_shop_error(lines, coupon, shipping, region):
+    with pytest.raises(ShopError):
+        build_invoice(lines, coupon, shipping, region)
