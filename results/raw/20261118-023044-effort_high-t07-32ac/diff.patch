 def test_percent():
@@ -7,3 +12,68 @@ def test_percent():
 
 def test_fixed_never_negative():
     assert apply_coupon(300, Coupon("FIVE", "fixed", 500)) == 0
+
+
+def test_apply_coupons_selects_best_percent_and_applies_fixed_afterward():
+    today = date(2026, 1, 10)
+    coupons = [
+        Coupon("SMALL", "percent", 10),
+        Coupon("FIXED", "fixed", 100, min_subtotal_cents=333),
+        Coupon("BIG", "percent", 50),
+    ]
+    assert apply_coupons(333, coupons, today) == (66, ["BIG", "FIXED"])
+
+
+def test_apply_coupons_checks_expiry_and_original_subtotal():
+    today = date(2026, 1, 10)
+    coupons = [
+        Coupon("EXPIRED", "percent", 90, expires=today - timedelta(days=1)),
+        Coupon("TOO_HIGH", "percent", 80, min_subtotal_cents=1001),
+        Coupon("VALID_TODAY", "percent", 50, expires=today),
+        Coupon("AT_MINIMUM", "fixed", 100, min_subtotal_cents=1000),
+        Coupon("FUTURE", "fixed", 50, expires=today + timedelta(days=1)),
+        Coupon("FIXED_EXPIRED", "fixed", 100, expires=today - timedelta(days=1)),
+        Coupon("FIXED_TOO_HIGH", "fixed", 100, min_subtotal_cents=1001),
+    ]
+    assert apply_coupons(1000, coupons, today) == (
+        350,
+        ["AT_MINIMUM", "FUTURE", "VALID_TODAY"],
+    )
+
+
+@pytest.mark.parametrize("codes", [("Z", "A"), ("A", "Z")])
+def test_apply_coupons_breaks_percent_ties_by_code(codes):
+    coupons = [Coupon(code, "percent", 20) for code in codes]
+    assert apply_coupons(1000, coupons, date(2026, 1, 10)) == (800, ["A"])
+
+
+def test_apply_coupons_clamps_total_and_includes_all_eligible_codes():
+    coupons = [
+        Coupon("Z", "fixed", 500),
+        Coupon("A", "percent", 100),
+        Coupon("Z", "fixed", 1),
+        Coupon("ZERO", "fixed", 0),
+    ]
+    assert apply_coupons(100, coupons, date(2026, 1, 10)) == (
+        0,
+        ["A", "Z", "Z", "ZERO"],
+    )
+
+
+def test_apply_coupons_handles_empty_and_ineligible_coupons():
+    today = date(2026, 1, 10)
+    assert apply_coupons(100, [], today) == (100, [])
+    assert apply_coupons(0, [Coupon("MIN", "fixed", 10, min_subtotal_cents=1)], today) == (
+        0,
+        [],
+    )
+
+
+def test_apply_coupons_rejects_negative_subtotal():
+    with pytest.raises(ShopError):
+        apply_coupons(-1, [], date(2026, 1, 10))
+
+
+def test_apply_coupons_rejects_unknown_kind():
+    with pytest.raises(ShopError):
+        apply_coupons(100, [Coupon("BAD", "other", 10)], date(2026, 1, 10))
