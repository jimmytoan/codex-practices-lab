diff --git a/src/shoplib/invoice.py b/src/shoplib/invoice.py
index 5d1398c..1698664 100644
--- a/src/shoplib/invoice.py
+++ b/src/shoplib/invoice.py
@@ -1,5 +1,8 @@
 """Invoices: coupon allocation and tax. See docs/invoicing.md."""
 
+from .money import percent_of
+from .errors import ShopError
+
 # Tax rates in percent, by region and product category.
 TAX_RATES = {
     "DE": {"standard": 19, "food": 7, "books": 7},
@@ -10,4 +13,42 @@ TAX_RATES = {
 
 def build_invoice(lines, coupon_cents: int, shipping_cents: int, region: str) -> dict:
     """Build an invoice for an order. See docs/invoicing.md."""
-    raise NotImplementedError
+    if region not in TAX_RATES:
+        raise ShopError(f"unknown region {region!r}")
+    if not lines:
+        raise ShopError("an invoice needs at least one line")
+    if type(coupon_cents) is not int or type(shipping_cents) is not int:
+        raise ShopError("coupon and shipping must be integer cents")
+    if coupon_cents < 0 or shipping_cents < 0:
+        raise ShopError("coupon and shipping must not be negative")
+    rates = TAX_RATES[region]
+    gross = []
+    for sku, price, qty, category in lines:
+        if type(price) is not int or type(qty) is not int:
+            raise ShopError(f"bad line {sku}")
+        if qty < 1 or price < 0:
+            raise ShopError(f"bad line {sku}")
+        if category not in rates:
+            raise ShopError(f"unknown category {category!r}")
+        gross.append(price * qty)
+    total_gross = sum(gross)
+    coupon = min(coupon_cents, total_gross)
+    if total_gross == 0:
+        alloc = [0] * len(gross)
+    else:
+        alloc = [coupon * g // total_gross for g in gross]
+        rema = [coupon * g % total_gross for g in gross]
+        order = sorted(range(len(gross)), key=lambda i: (-rema[i], i))
+        for i in order[: coupon - sum(alloc)]:
+            alloc[i] += 1
+    out, total, any_taxed = [], 0, False
+    for (sku, _price, _qty, category), g, d in zip(lines, gross, alloc):
+        rate = rates[category]
+        any_taxed = any_taxed or rate > 0
+        net = g - d
+        tax = percent_of(net, rate)
+        out.append({"sku": sku, "gross_cents": g, "discount_cents": d, "net_cents": net, "tax_cents": tax})
+        total += net + tax
+    shipping_tax = percent_of(shipping_cents, rates["standard"]) if any_taxed else 0
+    return {"lines": out, "shipping_cents": shipping_cents, "shipping_tax_cents": shipping_tax,
+            "total_cents": total + shipping_cents + shipping_tax}
diff --git a/tests/test_invoice.py b/tests/test_invoice.py
new file mode 100644
index 0000000..848c67f
--- /dev/null
+++ b/tests/test_invoice.py
@@ -0,0 +1,92 @@
+import pytest
+
+from shoplib.errors import ShopError
+from shoplib.invoice import build_invoice
+
+
+def test_coupon_is_split_with_earlier_line_winning_equal_remainders():
+    invoice = build_invoice(
+        [("first", 1, 1, "books"), ("second", 1, 1, "books")],
+        coupon_cents=1,
+        shipping_cents=0,
+        region="OR",
+    )
+
+    assert [line["discount_cents"] for line in invoice["lines"]] == [1, 0]
+    assert [line["net_cents"] for line in invoice["lines"]] == [0, 1]
+
+
+def test_tax_is_calculated_on_each_line_net_after_coupon():
+    invoice = build_invoice(
+        [("food", 8, 1, "food")], coupon_cents=1, shipping_cents=0, region="DE"
+    )
+
+    assert invoice["lines"] == [
+        {
+            "sku": "food",
+            "gross_cents": 8,
+            "discount_cents": 1,
+            "net_cents": 7,
+            "tax_cents": 0,
+        }
+    ]
+    assert invoice["total_cents"] == 7
+
+
+def test_coupon_is_capped_and_shipping_tax_applies_if_any_line_is_taxed():
+    invoice = build_invoice(
+        [("food", 100, 1, "food")],
+        coupon_cents=500,
+        shipping_cents=100,
+        region="SG",
+    )
+
+    assert invoice == {
+        "lines": [
+            {
+                "sku": "food",
+                "gross_cents": 100,
+                "discount_cents": 100,
+                "net_cents": 0,
+                "tax_cents": 0,
+            }
+        ],
+        "shipping_cents": 100,
+        "shipping_tax_cents": 9,
+        "total_cents": 109,
+    }
+
+
+def test_zero_gross_lines_get_no_discount_and_untaxed_region_has_no_shipping_tax():
+    invoice = build_invoice(
+        [("zero", 0, 1, "books")],
+        coupon_cents=10,
+        shipping_cents=100,
+        region="OR",
+    )
+
+    assert invoice["lines"][0]["discount_cents"] == 0
+    assert invoice["shipping_tax_cents"] == 0
+    assert invoice["total_cents"] == 100
+
+
+@pytest.mark.parametrize(
+    "lines,coupon,shipping,region",
+    [
+        ([("x", 1, 1, "food")], 0, 0, "XX"),
+        ([], 0, 0, "DE"),
+        ([("x", 1, 0, "food")], 0, 0, "DE"),
+        ([("x", -1, 1, "food")], 0, 0, "DE"),
+        ([("x", 1, 1, "unknown")], 0, 0, "DE"),
+        ([("x", 1, 1, "food")], -1, 0, "DE"),
+        ([("x", 1, 1, "food")], 0, -1, "DE"),
+    ],
+)
+def test_invalid_invoice_inputs_raise_value_error(lines, coupon, shipping, region):
+    with pytest.raises(ValueError):
+        build_invoice(lines, coupon, shipping, region)
+
+
+def test_invalid_invoice_inputs_use_shop_error():
+    with pytest.raises(ShopError):
+        build_invoice([], 0, 0, "DE")
