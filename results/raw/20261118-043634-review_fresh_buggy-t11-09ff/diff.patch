--- /dev/null
+++ b/tests/test_invoice.py
@@ -0,0 +1,87 @@
+import pytest
+
+from shoplib.errors import ShopError
+from shoplib.invoice import build_invoice
+
+
+def test_coupon_is_split_by_largest_remainder_and_ties_favor_earlier_line():
+    invoice = build_invoice(
+        [("A", 6, 1, "books"), ("B", 4, 1, "books")],
+        coupon_cents=3,
+        shipping_cents=0,
+        region="OR",
+    )
+    assert [line["discount_cents"] for line in invoice["lines"]] == [2, 1]
+
+    tied = build_invoice(
+        [("A", 1, 1, "books"), ("B", 1, 1, "books"), ("C", 1, 1, "books")],
+        coupon_cents=2,
+        shipping_cents=0,
+        region="OR",
+    )
+    assert [line["discount_cents"] for line in tied["lines"]] == [1, 1, 0]
+
+
+def test_coupon_is_capped_and_zero_gross_lines_receive_no_discount():
+    invoice = build_invoice(
+        [("A", 0, 2, "food"), ("B", 5, 1, "food")],
+        coupon_cents=99,
+        shipping_cents=0,
+        region="OR",
+    )
+    assert [line["gross_cents"] for line in invoice["lines"]] == [0, 5]
+    assert [line["discount_cents"] for line in invoice["lines"]] == [0, 5]
+    assert [line["net_cents"] for line in invoice["lines"]] == [0, 0]
+
+
+def test_tax_is_rounded_per_line_on_net_after_coupon():
+    invoice = build_invoice(
+        [("A", 50, 1, "food"), ("B", 50, 1, "food")],
+        coupon_cents=1,
+        shipping_cents=0,
+        region="DE",
+    )
+    assert [line["discount_cents"] for line in invoice["lines"]] == [1, 0]
+    assert [line["net_cents"] for line in invoice["lines"]] == [49, 50]
+    assert [line["tax_cents"] for line in invoice["lines"]] == [3, 4]
+    assert invoice["total_cents"] == 106
+
+    separately_rounded = build_invoice(
+        [("A", 50, 1, "food"), ("B", 50, 1, "food")],
+        coupon_cents=0,
+        shipping_cents=0,
+        region="DE",
+    )
+    assert [line["tax_cents"] for line in separately_rounded["lines"]] == [4, 4]
+    assert separately_rounded["total_cents"] == 108
+
+
+def test_shipping_tax_depends_on_taxable_lines_and_uses_standard_rate():
+    untaxed = build_invoice(
+        [("A", 100, 1, "books")], coupon_cents=0, shipping_cents=100, region="SG"
+    )
+    assert untaxed["shipping_tax_cents"] == 0
+    assert untaxed["total_cents"] == 200
+
+    taxed = build_invoice(
+        [("A", 100, 1, "food")], coupon_cents=0, shipping_cents=100, region="SG"
+    )
+    assert taxed["shipping_tax_cents"] == 9
+    assert taxed["total_cents"] == 218
+
+
+@pytest.mark.parametrize(
+    "lines,coupon,shipping,region",
+    [
+        ([("A", 1, 1, "books")], 0, 0, "XX"),
+        ([("A", 1, 1, "unknown")], 0, 0, "DE"),
+        ([], 0, 0, "DE"),
+        ([("A", 1, 0, "books")], 0, 0, "DE"),
+        ([("A", -1, 1, "books")], 0, 0, "DE"),
+        ([("A", 1, 1, "books")], -1, 0, "DE"),
+        ([("A", 1, 1, "books")], 0, -1, "DE"),
+    ],
+)
+def test_invalid_invoice_arguments_raise_shop_error(lines, coupon, shipping, region):
+    with pytest.raises(ShopError):
+        build_invoice(lines, coupon, shipping, region)
