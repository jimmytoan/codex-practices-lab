diff --git a/src/shoplib/costing.py b/src/shoplib/costing.py
index 5e8c27e..5af467f 100644
--- a/src/shoplib/costing.py
+++ b/src/shoplib/costing.py
@@ -1,6 +1,98 @@
 """Cost of goods sold with FIFO lots. See docs/costing.md."""
 
+from collections import deque
+from decimal import Decimal
+
+from shoplib.money import round_cents
+
+
+def _positive_quantity(event: dict) -> int:
+    quantity = event.get("qty")
+    if isinstance(quantity, bool) or not isinstance(quantity, int) or quantity < 1:
+        raise ValueError("qty must be a positive integer")
+    return quantity
+
 
 def fifo_costing(events: list[dict]) -> dict:
     """Process stock events and report cost per SKU. See docs/costing.md."""
-    raise NotImplementedError
+    stock = {}
+
+    for event in events:
+        if not isinstance(event, dict):
+            raise ValueError("each event must be a dict")
+
+        event_type = event.get("type")
+        if event_type not in ("receive", "sell", "return"):
+            raise ValueError(f"unknown event type: {event_type!r}")
+
+        if "sku" not in event:
+            raise ValueError("event must include sku")
+        sku = event["sku"]
+        try:
+            hash(sku)
+        except TypeError as exc:
+            raise ValueError("sku must be hashable") from exc
+
+        quantity = _positive_quantity(event)
+        item = stock.setdefault(
+            sku,
+            {"lots": deque(), "cogs_cents": 0, "latest_sale": None},
+        )
+
+        if event_type == "receive":
+            unit_cost = event.get("unit_cost_cents")
+            if isinstance(unit_cost, bool) or not isinstance(unit_cost, int):
+                raise ValueError("unit_cost_cents must be an integer")
+            if unit_cost < 0:
+                raise ValueError("unit_cost_cents cannot be negative")
+            item["lots"].append([quantity, unit_cost])
+            continue
+
+        if event_type == "sell":
+            available = sum(lot[0] for lot in item["lots"])
+            if quantity > available:
+                raise ValueError(f"not enough stock for SKU {sku!r}")
+
+            remaining = quantity
+            sale_cost = 0
+            while remaining:
+                lot_quantity, unit_cost = item["lots"][0]
+                taken = min(remaining, lot_quantity)
+                sale_cost += taken * unit_cost
+                remaining -= taken
+                if taken == lot_quantity:
+                    item["lots"].popleft()
+                else:
+                    item["lots"][0][0] -= taken
+
+            item["cogs_cents"] += sale_cost
+            average_unit_cost = round_cents(Decimal(sale_cost) / quantity)
+            item["latest_sale"] = {
+                "quantity": quantity,
+                "returned": 0,
+                "unit_cost_cents": average_unit_cost,
+            }
+            continue
+
+        sale = item["latest_sale"]
+        if sale is None:
+            raise ValueError(f"SKU {sku!r} has no sale to return")
+        returnable = sale["quantity"] - sale["returned"]
+        if quantity > returnable:
+            raise ValueError(f"return exceeds units remaining from latest sale for SKU {sku!r}")
+
+        unit_cost = sale["unit_cost_cents"]
+        item["lots"].append([quantity, unit_cost])
+        item["cogs_cents"] -= quantity * unit_cost
+        sale["returned"] += quantity
+
+    result = {}
+    for sku, item in stock.items():
+        on_hand = sum(lot[0] for lot in item["lots"])
+        value_cents = sum(quantity * unit_cost for quantity, unit_cost in item["lots"])
+        result[sku] = {
+            "cogs_cents": item["cogs_cents"],
+            "on_hand": on_hand,
+            "value_cents": value_cents,
+        }
+    return result
diff --git a/tests/test_costing.py b/tests/test_costing.py
new file mode 100644
index 0000000..2e4b53d
--- /dev/null
+++ b/tests/test_costing.py
@@ -0,0 +1,101 @@
+from copy import deepcopy
+
+import pytest
+
+from shoplib.costing import fifo_costing
+
+
+def test_fifo_sales_and_inventory_value():
+    events = [
+        {"type": "receive", "sku": "A", "qty": 2, "unit_cost_cents": 100},
+        {"type": "receive", "sku": "A", "qty": 3, "unit_cost_cents": 250},
+        {"type": "sell", "sku": "A", "qty": 3},
+    ]
+
+    assert fifo_costing(events) == {
+        "A": {"cogs_cents": 450, "on_hand": 2, "value_cents": 500}
+    }
+
+
+def test_return_uses_half_up_average_and_is_added_after_existing_lots():
+    events = [
+        {"type": "receive", "sku": "A", "qty": 1, "unit_cost_cents": 2},
+        {"type": "receive", "sku": "A", "qty": 2, "unit_cost_cents": 3},
+        {"type": "sell", "sku": "A", "qty": 2},
+        {"type": "return", "sku": "A", "qty": 1},
+        {"type": "sell", "sku": "A", "qty": 1},
+    ]
+
+    # The return is valued at 3 cents (5 / 2, half up). The next sale consumes
+    # the remaining original unit at 3 cents, leaving the return lot.
+    assert fifo_costing(events) == {
+        "A": {"cogs_cents": 5, "on_hand": 1, "value_cents": 3}
+    }
+
+
+def test_partial_returns_share_sale_average_and_have_a_total_limit():
+    events = [
+        {"type": "receive", "sku": "A", "qty": 3, "unit_cost_cents": 2},
+        {"type": "sell", "sku": "A", "qty": 3},
+        {"type": "return", "sku": "A", "qty": 1},
+        {"type": "return", "sku": "A", "qty": 1},
+    ]
+
+    assert fifo_costing(events)["A"] == {
+        "cogs_cents": 2,
+        "on_hand": 2,
+        "value_cents": 4,
+    }
+    with pytest.raises(ValueError):
+        fifo_costing(events + [{"type": "return", "sku": "A", "qty": 2}])
+
+
+def test_new_sale_replaces_the_sale_that_can_be_returned():
+    events = [
+        {"type": "receive", "sku": "A", "qty": 3, "unit_cost_cents": 10},
+        {"type": "sell", "sku": "A", "qty": 1},
+        {"type": "sell", "sku": "A", "qty": 1},
+        {"type": "return", "sku": "A", "qty": 1},
+    ]
+
+    assert fifo_costing(events)["A"] == {
+        "cogs_cents": 10,
+        "on_hand": 2,
+        "value_cents": 20,
+    }
+
+
+@pytest.mark.parametrize(
+    "events",
+    [
+        [{"type": "receive", "sku": "A", "qty": 0, "unit_cost_cents": 1}],
+        [{"type": "sell", "sku": "A", "qty": -1}],
+        [{"type": "receive", "sku": "A", "qty": 1, "unit_cost_cents": -1}],
+        [{"type": "sell", "sku": "A", "qty": 1}],
+        [{"type": "return", "sku": "A", "qty": 1}],
+        [
+            {"type": "receive", "sku": "A", "qty": 1, "unit_cost_cents": 1},
+            {"type": "sell", "sku": "A", "qty": 1},
+            {"type": "return", "sku": "A", "qty": 2},
+        ],
+        [{"type": "adjust", "sku": "A", "qty": 1}],
+    ],
+)
+def test_invalid_events_raise_value_error(events):
+    original = deepcopy(events)
+    with pytest.raises(ValueError):
+        fifo_costing(events)
+    assert events == original
+
+
+def test_input_events_are_not_modified():
+    events = [
+        {"type": "receive", "sku": "A", "qty": 2, "unit_cost_cents": 50},
+        {"type": "sell", "sku": "A", "qty": 1},
+        {"type": "return", "sku": "A", "qty": 1},
+    ]
+    original = deepcopy(events)
+
+    fifo_costing(events)
+
+    assert events == original
