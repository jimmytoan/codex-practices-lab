 def test_percent():
@@ -7,3 +12,46 @@ def test_percent():
 
 def test_fixed_never_negative():
     assert apply_coupon(300, Coupon("FIVE", "fixed", 500)) == 0
+
+
+def test_combine_coupons_using_original_subtotal_and_tie_break():
+    today = date(2026, 11, 17)
+    coupons = [
+        Coupon("ZPERCENT", "percent", 20),
+        Coupon("APERCENT", "percent", 20, expires=today),
+        Coupon("LOWER", "percent", 10),
+        Coupon("FIXED", "fixed", 100, min_subtotal_cents=1000),
+        Coupon("EXPIRED", "fixed", 500, expires=date(2026, 11, 16)),
+        Coupon("MINIMUM", "fixed", 500, min_subtotal_cents=1001),
+    ]
+    assert apply_coupons(1000, coupons, today) == (700, ["APERCENT", "FIXED"])
+
+
+def test_percent_rounding_and_highest_eligible_percent():
+    today = date(2026, 11, 17)
+    coupons = [
+        Coupon("INELIGIBLE", "percent", 90, min_subtotal_cents=6),
+        Coupon("TEN", "percent", 10),
+        Coupon("FIVE", "percent", 5),
+    ]
+    assert apply_coupons(5, coupons, today) == (4, ["TEN"])
+
+
+def test_all_fixed_coupons_apply_even_when_total_reaches_zero():
+    coupons = [Coupon("B", "fixed", 200), Coupon("A", "fixed", 50),
+               Coupon("A", "fixed", 10)]
+    assert apply_coupons(100, coupons, date(2026, 11, 17)) == (0, ["A", "A", "B"])
+
+
+def test_no_coupons_and_negative_subtotal():
+    today = date(2026, 11, 17)
+    assert apply_coupons(0, [], today) == (0, [])
+    with pytest.raises(ShopError):
+        apply_coupons(-1, [], today)
+
+
+@pytest.mark.parametrize("expires", [None, date(2026, 11, 16)])
+def test_unknown_coupon_kind_is_invalid_even_if_expired(expires):
+    with pytest.raises(ShopError, match="unknown coupon kind"):
+        apply_coupons(100, [Coupon("BAD", "unknown", 10, expires=expires)],
+                      date(2026, 11, 17))
