--- a/src/shoplib/storedays.py
+++ b/src/shoplib/storedays.py
@@ -1,6 +1,47 @@
 """Revenue per store day. See docs/store-days.md."""
 
+from datetime import datetime, timedelta, timezone
+
+from shoplib.errors import ShopError
+
 
 def daily_revenue(sales: list[dict], utc_offset_hours: int = 8, day_starts_hour: int = 4) -> list[tuple[str, int]]:
     """Revenue per store day. See docs/store-days.md."""
-    raise NotImplementedError
+    if isinstance(utc_offset_hours, bool) or not isinstance(utc_offset_hours, int):
+        raise ShopError("utc_offset_hours must be an integer")
+    if isinstance(day_starts_hour, bool) or not isinstance(day_starts_hour, int) or not 0 <= day_starts_hour <= 23:
+        raise ShopError("day_starts_hour must be an integer from 0 to 23")
+
+    totals: dict[object, int] = {}
+    for sale in sales:
+        if not isinstance(sale, dict) or "at" not in sale or "cents" not in sale:
+            raise ShopError("each sale must have at and cents")
+        timestamp = sale["at"]
+        cents = sale["cents"]
+        if not isinstance(timestamp, str):
+            raise ShopError("sale timestamp must be a string")
+        if isinstance(cents, bool) or not isinstance(cents, int):
+            raise ShopError("sale cents must be an integer")
+
+        try:
+            parsed = datetime.fromisoformat(timestamp[:-1] + "+00:00" if timestamp.endswith("Z") else timestamp)
+        except ValueError as exc:
+            raise ShopError("sale timestamp must be ISO 8601") from exc
+        if parsed.utcoffset() is None:
+            raise ShopError("sale timestamp must include a time zone")
+
+        local = parsed.astimezone(timezone.utc) + timedelta(hours=utc_offset_hours)
+        store_day = local.date()
+        if local.hour < day_starts_hour:
+            store_day -= timedelta(days=1)
+        totals[store_day] = totals.get(store_day, 0) + cents
+
+    if not totals:
+        return []
+    first, last = min(totals), max(totals)
+    result = []
+    day = first
+    while day <= last:
+        result.append((day.isoformat(), totals.get(day, 0)))
+        day += timedelta(days=1)
+    return result
diff --git a/tests/test_storedays.py b/tests/test_storedays.py
new file mode 100644
index 0000000..1288d10
--- /dev/null
+++ b/tests/test_storedays.py
@@ -0,0 +1,31 @@
+import pytest
+
+from shoplib.storedays import daily_revenue
+
+
+def test_day_boundary_and_gap_days():
+    sales = [
+        {"at": "2026-11-18T04:00:00+08:00", "cents": 300},
+        {"at": "2026-11-18T02:30:00+08:00", "cents": 200},
+        {"at": "2026-11-20T12:00:00+08:00", "cents": -50},
+    ]
+    assert daily_revenue(sales) == [
+        ("2026-11-17", 200),
+        ("2026-11-18", 300),
+        ("2026-11-19", 0),
+        ("2026-11-20", -50),
+    ]
+
+
+def test_converts_timestamp_zone_to_store_zone():
+    sales = [{"at": "2026-11-17T20:00:00Z", "cents": 125}]
+    assert daily_revenue(sales) == [("2026-11-18", 125)]
+
+
+def test_timestamp_requires_zone():
+    with pytest.raises(ValueError):
+        daily_revenue([{"at": "2026-11-18T04:00:00", "cents": 100}])
+
+
+def test_empty_sales():
+    assert daily_revenue([]) == []
