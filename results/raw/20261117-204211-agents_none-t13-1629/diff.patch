diff --git a/src/shoplib/costing.py b/src/shoplib/costing.py
index 5e8c27e..d4843e8 100644
--- a/src/shoplib/costing.py
+++ b/src/shoplib/costing.py
@@ -1,6 +1,97 @@
 """Cost of goods sold with FIFO lots. See docs/costing.md."""
 
+from decimal import Decimal
+
+from .money import round_cents
+
+
+def _positive_quantity(value) -> int:
+    if isinstance(value, bool) or not isinstance(value, int) or value < 1:
+        raise ValueError("qty must be a positive integer")
+    return value
+
 
 def fifo_costing(events: list[dict]) -> dict:
     """Process stock events and report cost per SKU. See docs/costing.md."""
-    raise NotImplementedError
+    # Each lot is [quantity, unit cost in cents]. Appending lots makes both
+    # received stock and returned stock enter at the back of the FIFO queue.
+    stock = {}
+    latest_sale = {}
+
+    for event in events:
+        if not isinstance(event, dict):
+            raise ValueError("each event must be a dict")
+
+        kind = event.get("type")
+        if kind not in ("receive", "sell", "return"):
+            raise ValueError(f"unknown event type {kind!r}")
+
+        required = ("sku", "qty", "unit_cost_cents") if kind == "receive" else ("sku", "qty")
+        if any(key not in event for key in required):
+            raise ValueError(f"{kind} event is missing required fields")
+
+        sku = event["sku"]
+        try:
+            hash(sku)
+        except TypeError as exc:
+            raise ValueError("sku must be hashable") from exc
+
+        qty = _positive_quantity(event["qty"])
+        if sku not in stock:
+            stock[sku] = {"lots": [], "cogs_cents": 0}
+        sku_stock = stock[sku]
+
+        if kind == "receive":
+            unit_cost = event["unit_cost_cents"]
+            if isinstance(unit_cost, bool) or not isinstance(unit_cost, int):
+                raise ValueError("unit_cost_cents must be an integer")
+            if unit_cost < 0:
+                raise ValueError("unit_cost_cents must not be negative")
+            sku_stock["lots"].append([qty, unit_cost])
+
+        elif kind == "sell":
+            lots = sku_stock["lots"]
+            on_hand = sum(lot_qty for lot_qty, _ in lots)
+            if qty > on_hand:
+                raise ValueError(f"cannot sell {qty} units of {sku}; only {on_hand} on hand")
+
+            remaining = qty
+            sale_cost = 0
+            while remaining:
+                lot_qty, unit_cost = lots[0]
+                taken = min(remaining, lot_qty)
+                sale_cost += taken * unit_cost
+                lot_qty -= taken
+                remaining -= taken
+                if lot_qty:
+                    lots[0][0] = lot_qty
+                else:
+                    lots.pop(0)
+
+            sku_stock["cogs_cents"] += sale_cost
+            latest_sale[sku] = {"qty": qty, "returned": 0, "cost": sale_cost}
+
+        else:  # return
+            sale = latest_sale.get(sku)
+            if sale is None:
+                raise ValueError(f"cannot return {sku}: no sale has been made")
+            returnable = sale["qty"] - sale["returned"]
+            if qty > returnable:
+                raise ValueError(
+                    f"cannot return {qty} units of {sku}; only {returnable} returnable"
+                )
+
+            average_unit_cost = round_cents(Decimal(sale["cost"]) / sale["qty"])
+            sku_stock["lots"].append([qty, average_unit_cost])
+            sku_stock["cogs_cents"] -= qty * average_unit_cost
+            sale["returned"] += qty
+
+    result = {}
+    for sku, sku_stock in stock.items():
+        lots = sku_stock["lots"]
+        result[sku] = {
+            "cogs_cents": sku_stock["cogs_cents"],
+            "on_hand": sum(qty for qty, _ in lots),
+            "value_cents": sum(qty * unit_cost for qty, unit_cost in lots),
+        }
+    return result
diff --git a/tests/test_costing.py b/tests/test_costing.py
new file mode 100644
