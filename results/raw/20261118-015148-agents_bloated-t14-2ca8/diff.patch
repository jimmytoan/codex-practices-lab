+++ b/tests/test_storedays.py
@@ -0,0 +1,76 @@
+import pytest
+
+from shoplib.errors import ShopError
+from shoplib.storedays import daily_revenue
+
+
+def test_boundary_refunds_and_empty_days_in_date_order():
+    sales = [
+        {"at": "2026-11-20T04:00:00+08:00", "cents": 800},
+        {"at": "2026-11-18T03:59:59.999999+08:00", "cents": 500},
+        {"at": "2026-11-18T04:00:00+08:00", "cents": 200},
+        {"at": "2026-11-18T05:00:00+08:00", "cents": -75},
+    ]
+    assert daily_revenue(sales) == [
+        ("2026-11-17", 500),
+        ("2026-11-18", 125),
+        ("2026-11-19", 0),
+        ("2026-11-20", 800),
+    ]
+
+
+def test_timestamps_with_different_zones_and_custom_store_zone():
+    sales = [
+        {"at": "2026-01-01T07:00:00Z", "cents": 100},
+        {"at": "2026-01-01T12:30:00+05:30", "cents": 200},
+        {"at": "2025-12-31T23:00:00-08:00", "cents": -50},
+    ]
+    assert daily_revenue(sales, utc_offset_hours=-5, day_starts_hour=2) == [
+        ("2026-01-01", 250)
+    ]
+
+
+def test_custom_midnight_boundary_and_year_rollover():
+    sales = [
+        {"at": "2025-12-31T23:59:59Z", "cents": 7},
+        {"at": "2026-01-01T00:00:00Z", "cents": 9},
+    ]
+    assert daily_revenue(sales, utc_offset_hours=0, day_starts_hour=0) == [
+        ("2025-12-31", 7), ("2026-01-01", 9)
+    ]
+
+
+def test_local_date_changes_and_zero_total_still_marks_a_sale_day():
+    sales = [
+        {"at": "2026-03-01T01:00:00Z", "cents": 50},
+        {"at": "2026-03-01T01:00:00Z", "cents": -50},
+        {"at": "2026-03-03T01:00:00Z", "cents": 10},
+    ]
+    assert daily_revenue(sales, utc_offset_hours=-5, day_starts_hour=4) == [
+        ("2026-02-28", 0), ("2026-03-01", 0), ("2026-03-02", 10)
+    ]
+
+
+def test_no_sales():
+    assert daily_revenue([]) == []
+
+
+@pytest.mark.parametrize("timestamp", ["2026-11-18T02:30:00", "2026-11-18", "not a timestamp", "2026-11-18T02:30:00+0800"])
+def test_invalid_or_unzoned_timestamps_raise_shop_error(timestamp):
+    with pytest.raises(ShopError):
+        daily_revenue([{"at": timestamp, "cents": 100}])
+
+
+@pytest.mark.parametrize("kwargs", [
+    {"utc_offset_hours": 24}, {"utc_offset_hours": -24}, {"utc_offset_hours": 1.5},
+    {"day_starts_hour": -1}, {"day_starts_hour": 24}, {"day_starts_hour": True},
+])
+def test_invalid_store_configuration(kwargs):
+    with pytest.raises(ShopError):
+        daily_revenue([], **kwargs)
+
+
+@pytest.mark.parametrize("sale", [{}, {"at": "2026-01-01T00:00:00Z", "cents": 1.5}, None])
+def test_invalid_sale(sale):
+    with pytest.raises(ShopError):
+        daily_revenue([sale])
