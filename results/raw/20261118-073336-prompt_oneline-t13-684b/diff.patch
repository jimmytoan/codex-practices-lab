diff --git a/src/shoplib/costing.py b/src/shoplib/costing.py
index 5e8c27e..e58637c 100644
--- a/src/shoplib/costing.py
+++ b/src/shoplib/costing.py
@@ -1,6 +1,91 @@
 """Cost of goods sold with FIFO lots. See docs/costing.md."""
 
+from decimal import Decimal
+
+from shoplib.errors import ShopError
+from shoplib.money import round_cents
+
 
 def fifo_costing(events: list[dict]) -> dict:
     """Process stock events and report cost per SKU. See docs/costing.md."""
-    raise NotImplementedError
+    if not isinstance(events, list):
+        raise ShopError("events must be a list")
+
+    # Lots are mutable [remaining quantity, unit cost] pairs. All state is
+    # local to this call, so a failed event cannot leave caller-visible state
+    # partially updated.
+    lots: dict[str, list[list[int]]] = {}
+    cogs: dict[str, int] = {}
+    latest_sale: dict[str, list[int]] = {}
+
+    for event in events:
+        if not isinstance(event, dict):
+            raise ShopError("each event must be a dict")
+
+        event_type = event.get("type")
+        if event_type not in ("receive", "sell", "return"):
+            raise ShopError("unknown event type")
+
+        sku = event.get("sku")
+        if not isinstance(sku, str):
+            raise ShopError("sku must be a string")
+
+        qty = event.get("qty")
+        if isinstance(qty, bool) or not isinstance(qty, int) or qty < 1:
+            raise ShopError("qty must be a positive integer")
+
+        sku_lots = lots.setdefault(sku, [])
+        cogs.setdefault(sku, 0)
+
+        if event_type == "receive":
+            unit_cost = event.get("unit_cost_cents")
+            if isinstance(unit_cost, bool) or not isinstance(unit_cost, int):
+                raise ShopError("unit_cost_cents must be a non-negative integer")
+            if unit_cost < 0:
+                raise ShopError("unit_cost_cents must be non-negative")
+            sku_lots.append([qty, unit_cost])
+            continue
+
+        if event_type == "sell":
+            on_hand = sum(lot_qty for lot_qty, _ in sku_lots)
+            if qty > on_hand:
+                raise ShopError(f"cannot sell {qty} units of {sku}; only {on_hand} on hand")
+
+            remaining = qty
+            sale_cost = 0
+            for lot in sku_lots:
+                taken = min(remaining, lot[0])
+                lot[0] -= taken
+                sale_cost += taken * lot[1]
+                remaining -= taken
+                if remaining == 0:
+                    break
+
+            # Discard depleted lots while retaining FIFO order.
+            lots[sku] = [lot for lot in sku_lots if lot[0] > 0]
+            cogs[sku] += sale_cost
+            average_unit_cost = round_cents(Decimal(sale_cost) / qty)
+            latest_sale[sku] = [qty, average_unit_cost]
+            continue
+
+        sale = latest_sale.get(sku)
+        if sale is None:
+            raise ShopError(f"no sale to return for {sku}")
+        if qty > sale[0]:
+            raise ShopError(f"only {sale[0]} units of the most recent sale of {sku} are returnable")
+
+        return_unit_cost = sale[1]
+        sale[0] -= qty
+        cogs[sku] -= qty * return_unit_cost
+        # A return goes behind every lot currently on hand, so it will be sold
+        # only after those older units.
+        lots[sku].append([qty, return_unit_cost])
+
+    result = {}
+    for sku in cogs:
+        result[sku] = {
+            "cogs_cents": cogs[sku],
+            "on_hand": sum(qty for qty, _ in lots[sku]),
+            "value_cents": sum(qty * unit_cost for qty, unit_cost in lots[sku]),
+        }
+    return result
diff --git a/tests/test_costing.py b/tests/test_costing.py
new file mode 100644
index 0000000..ab62e8b
--- /dev/null
+++ b/tests/test_costing.py
@@ -0,0 +1,79 @@
+import copy
+
+import pytest
+
+from shoplib.costing import fifo_costing
+from shoplib.errors import ShopError
+
+
+def test_fifo_consumes_oldest_lots_and_reports_remaining_value():
+    events = [
+        {"type": "receive", "sku": "book", "qty": 2, "unit_cost_cents": 100},
+        {"type": "receive", "sku": "book", "qty": 3, "unit_cost_cents": 250},
+        {"type": "sell", "sku": "book", "qty": 3},
+    ]
+
+    assert fifo_costing(events) == {
+        "book": {"cogs_cents": 450, "on_hand": 2, "value_cents": 500}
+    }
+
+
+def test_partial_returns_use_rounded_average_and_become_newest_lot():
+    events = [
+        {"type": "receive", "sku": "pen", "qty": 1, "unit_cost_cents": 5},
+        {"type": "receive", "sku": "pen", "qty": 1, "unit_cost_cents": 6},
+        {"type": "sell", "sku": "pen", "qty": 2},
+        {"type": "receive", "sku": "pen", "qty": 1, "unit_cost_cents": 20},
+        {"type": "return", "sku": "pen", "qty": 1},
+        {"type": "sell", "sku": "pen", "qty": 1},
+    ]
+
+    # The return is valued at half-up(11 / 2) = 6 cents. The next sale takes
+    # the intervening 20-cent receipt first, leaving the returned lot on hand.
+    assert fifo_costing(events) == {
+        "pen": {"cogs_cents": 25, "on_hand": 1, "value_cents": 6}
+    }
+
+
+def test_returns_can_be_split_but_cannot_exceed_most_recent_sale():
+    events = [
+        {"type": "receive", "sku": "mug", "qty": 3, "unit_cost_cents": 80},
+        {"type": "sell", "sku": "mug", "qty": 3},
+        {"type": "return", "sku": "mug", "qty": 1},
+        {"type": "return", "sku": "mug", "qty": 2},
+    ]
+    assert fifo_costing(events)["mug"] == {
+        "cogs_cents": 0,
+        "on_hand": 3,
+        "value_cents": 240,
+    }
+
+    with pytest.raises(ShopError):
+        fifo_costing(events + [{"type": "return", "sku": "mug", "qty": 1}])
+
+
+@pytest.mark.parametrize(
+    "events",
+    [
+        [{"type": "receive", "sku": "x", "qty": 0, "unit_cost_cents": 1}],
+        [{"type": "receive", "sku": "x", "qty": 1, "unit_cost_cents": -1}],
+        [{"type": "sell", "sku": "x", "qty": 1}],
+        [{"type": "return", "sku": "x", "qty": 1}],
+        [{"type": "invalid", "sku": "x", "qty": 1}],
+    ],
+)
+def test_invalid_events_raise_value_error(events):
+    with pytest.raises(ValueError):
+        fifo_costing(events)
+
+
+def test_events_are_not_modified():
+    events = [
+        {"type": "receive", "sku": "x", "qty": 2, "unit_cost_cents": 7},
+        {"type": "sell", "sku": "x", "qty": 1},
+    ]
+    original = copy.deepcopy(events)
+
+    fifo_costing(events)
+
+    assert events == original
