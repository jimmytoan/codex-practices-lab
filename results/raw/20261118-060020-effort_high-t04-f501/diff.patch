diff --git a/src/shoplib/orders.py b/src/shoplib/orders.py
index 8edb164..3c21a70 100644
--- a/src/shoplib/orders.py
+++ b/src/shoplib/orders.py
@@ -1,6 +1,7 @@
 """Orders and their life cycle. See docs/order-states.md."""
 
 from .inventory import Inventory
+from .errors import ShopError
 
 NEW = "NEW"
 PAID = "PAID"
@@ -46,3 +47,26 @@ class Order:
 
     def deliver(self) -> None:
         self._transition((SHIPPED,), DELIVERED)
+
+    def cancel(self) -> None:
+        """Cancel an unshipped order and release its reserved stock."""
+        if self.state == CANCELLED:
+            return
+        if self.state not in (NEW, PAID):
+            raise ShopError(f"cannot go from {self.state} to {CANCELLED}")
+
+        # Check every line before releasing any stock so a failed cancellation
+        # cannot leave only part of the order's reservation released.
+        for sku, qty in self.lines.items():
+            if qty <= 0:
+                raise ShopError("qty must be positive")
+            reserved = self.inventory.reserved(sku)
+            if qty > reserved:
+                raise ShopError(f"only {reserved} of {sku} reserved")
+
+        previous_state = self.state
+        for sku, qty in self.lines.items():
+            self.inventory.release(sku, qty)
+
+        self.state = CANCELLED
+        self.refund_due = previous_state == PAID
diff --git a/tests/test_inventory.py b/tests/test_inventory.py
index 37436c0..fa19396 100644
--- a/tests/test_inventory.py
+++ b/tests/test_inventory.py
@@ -18,3 +18,41 @@ def test_cannot_reserve_more_than_available():
     inv.receive("A", 2)
     with pytest.raises(ValueError):
         inv.reserve("A", 3)
+
+
+def test_release_returns_reserved_stock_to_available():
+    inv = Inventory()
+    inv.receive("A", 10)
+    inv.reserve("A", 4)
+
+    inv.release("A", 3)
+
+    assert inv.on_hand("A") == 10
+    assert inv.reserved("A") == 1
+    assert inv.available("A") == 9
+
+
+@pytest.mark.parametrize("qty", [0, -1, 3])
+def test_release_rejects_invalid_quantity_without_changing_stock(qty):
+    inv = Inventory()
+    inv.receive("A", 5)
+    inv.reserve("A", 2)
+
+    with pytest.raises(ValueError):
+        inv.release("A", qty)
+
+    assert inv.on_hand("A") == 5
+    assert inv.reserved("A") == 2
+    assert inv.available("A") == 3
+
+
+def test_release_rejects_sku_with_no_reservation():
+    inv = Inventory()
+    inv.receive("A", 5)
+
+    with pytest.raises(ValueError):
+        inv.release("A", 1)
+
+    assert inv.on_hand("A") == 5
+    assert inv.reserved("A") == 0
+    assert inv.available("A") == 5
diff --git a/tests/test_orders.py b/tests/test_orders.py
index d3835d1..a3b39b4 100644
--- a/tests/test_orders.py
+++ b/tests/test_orders.py
@@ -1,7 +1,7 @@
 import pytest
 
 from shoplib.inventory import Inventory
-from shoplib.orders import DELIVERED, NEW, Order
+from shoplib.orders import CANCELLED, DELIVERED, NEW, Order
 
 
 def make():
@@ -25,3 +25,88 @@ def test_cannot_ship_unpaid():
     _, order = make()
     with pytest.raises(ValueError):
         order.ship()
+
+
+def test_cancel_new_order_releases_stock_without_refund():
+    inv, order = make()
+
+    order.cancel()
+
+    assert order.state == CANCELLED
+    assert order.refund_due is False
+    assert inv.reserved("A") == 0
+    assert inv.available("A") == 5
+
+
+def test_cancel_paid_order_releases_stock_and_marks_refund_due():
+    inv, order = make()
+    order.pay()
+
+    order.cancel()
+
+    assert order.state == CANCELLED
+    assert order.refund_due is True
+    assert inv.reserved("A") == 0
+    assert inv.available("A") == 5
+
+
+def test_cancelling_cancelled_order_is_idempotent():
+    inv, order = make()
+    order.cancel()
+    stock_after_cancel = (inv.on_hand("A"), inv.reserved("A"), inv.available("A"))
+
+    order.cancel()
+
+    assert order.state == CANCELLED
+    assert order.refund_due is False
+    assert (inv.on_hand("A"), inv.reserved("A"), inv.available("A")) == stock_after_cancel
+
+
+def test_cancelling_paid_cancelled_order_preserves_refund_and_stock():
+    inv, order = make()
+    order.pay()
+    order.cancel()
+    stock_after_cancel = (inv.on_hand("A"), inv.reserved("A"), inv.available("A"))
+
+    order.cancel()
+
+    assert order.state == CANCELLED
+    assert order.refund_due is True
+    assert (inv.on_hand("A"), inv.reserved("A"), inv.available("A")) == stock_after_cancel
+
+
+@pytest.mark.parametrize("finalize", ["ship", "deliver"])
+def test_cannot_cancel_shipped_or_delivered_order(finalize):
+    inv, order = make()
+    order.pay()
+    order.ship()
+    if finalize == "deliver":
+        order.deliver()
+    original_state = order.state
+    original_stock = (inv.on_hand("A"), inv.reserved("A"), inv.available("A"))
+
+    with pytest.raises(ValueError):
+        order.cancel()
+
+    assert order.state == original_state
+    assert order.refund_due is False
+    assert (inv.on_hand("A"), inv.reserved("A"), inv.available("A")) == original_stock
+
+
+def test_failed_multi_line_cancel_releases_no_stock():
+    inv = Inventory()
+    inv.receive("A", 5)
+    inv.receive("B", 5)
+    order = Order("o2", {"A": 2, "B": 2}, inv)
+    # Simulate an inconsistent inventory so the second line cannot be released.
+    inv.release("B", 2)
+
+    with pytest.raises(ValueError):
+        order.cancel()
+
+    assert order.state == NEW
+    assert order.refund_due is False
+    assert inv.reserved("A") == 2
+    assert inv.reserved("B") == 0
+    assert inv.available("A") == 3
+    assert inv.available("B") == 5
