--- /dev/null
+++ b/tests/test_invoice.py
@@ -0,0 +1,46 @@
+import pytest
+
+from shoplib.errors import ShopError
+from shoplib.invoice import build_invoice
+
+
+def test_coupon_largest_remainder_ties_go_to_earlier_lines():
+    invoice = build_invoice(
+        [("first", 2, 1, "books"), ("second", 2, 1, "books"), ("third", 2, 1, "books")],
+        coupon_cents=2,
+        shipping_cents=0,
+        region="DE",
+    )
+
+    assert [line["discount_cents"] for line in invoice["lines"]] == [1, 1, 0]
+
+
+def test_line_tax_uses_net_after_coupon():
+    invoice = build_invoice(
+        [("item", 3, 1, "standard")],
+        coupon_cents=1,
+        shipping_cents=100,
+        region="DE",
+    )
+
+    assert invoice["lines"][0]["net_cents"] == 2
+    assert invoice["lines"][0]["tax_cents"] == 0
+    assert invoice["shipping_tax_cents"] == 19
+    assert invoice["total_cents"] == 121
+
+
+@pytest.mark.parametrize(
+    ("lines", "coupon", "shipping", "region"),
+    [
+        ([("item", 100, 1, "standard")], 0, 0, "XX"),
+        ([], 0, 0, "DE"),
+        ([("item", 100, 1, "standard")], -1, 0, "DE"),
+        ([("item", 100, 1, "standard")], 0, -1, "DE"),
+        ([("item", 100, 0, "standard")], 0, 0, "DE"),
+        ([("item", -1, 1, "standard")], 0, 0, "DE"),
+        ([("item", 100, 1, "unknown")], 0, 0, "DE"),
+    ],
+)
+def test_invalid_invoice_arguments_raise_shop_error(lines, coupon, shipping, region):
+    with pytest.raises(ShopError):
+        build_invoice(lines, coupon, shipping, region)
