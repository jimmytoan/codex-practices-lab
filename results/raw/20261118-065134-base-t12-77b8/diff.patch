@@ -0,0 +1,80 @@
+import pytest
+
+from shoplib.search import Product, search
+
+
+@pytest.fixture
+def products():
+    return [
+        Product("MUG-001", "Blue Mug", 1250, ["sale", "ceramic"]),
+        Product("MUG-002", "Blue Mug Large", 2000, ["new", "ceramic"]),
+        Product("PLATE-001", "Blue Plate", 900, ["sale", "porcelain"]),
+    ]
+
+
+def test_bare_and_quoted_name_terms(products):
+    assert search(products, "blue mug") == products[:2]
+    assert search(products, '"blue mug"') == products[:2]
+    assert search(products, 'name:"mug large"') == products[1:2]
+    assert search(products, '"MUG-001"') == []
+    assert search(products, '"Blue Plate"') == products[2:]
+
+
+def test_field_matching_is_case_insensitive(products):
+    assert search(products, "sku:mug-001") == products[:1]
+    assert search(products, "tag:CERAMIC") == products[:2]
+    assert search(products, "name:PLATE") == products[2:]
+
+
+def test_sku_and_tag_prefix_matching(products):
+    assert search(products, "sku:MUG-*") == products[:2]
+    assert search(products, "tag:cer*") == products[:2]
+    assert search(products, "sku:M*G-001") == []
+    assert search(products, "tag:s*le") == []
+
+
+def test_price_comparisons(products):
+    assert search(products, "price<1000") == products[2:]
+    assert search(products, "price<=1250") == [products[0], products[2]]
+    assert search(products, "price>1250") == products[1:2]
+    assert search(products, "price>=1250") == products[:2]
+    assert search(products, "price=900") == products[2:]
+    assert search(products, "price>=900 price<2000") == [products[0], products[2]]
+
+
+def test_negation_and_combined_terms(products):
+    assert search(products, "blue -tag:sale") == products[1:2]
+    assert search(products, '-"blue mug"') == products[2:]
+    assert search(products, "-sku:MUG-*") == products[2:]
+
+
+def test_empty_query_matches_every_product(products):
+    assert search(products, "") == products
+    assert search(products, " \t\n") == products
+
+
+@pytest.mark.parametrize(
+    "query",
+    [
+        "price:5",
+        "other:value",
+        "tag:",
+        'tag:""',
+        "-",
+        '"unfinished',
+        "price>",
+        "price>=abc",
+        "price=1.5",
+        "price< -1",
+        "price>=-1",
+    ],
+)
+def test_invalid_query_syntax_raises_value_error(products, query):
+    with pytest.raises(ValueError):
+        search(products, query)
+
+
+def test_invalid_query_syntax_is_checked_with_no_products():
+    with pytest.raises(ValueError):
+        search([], "price>=many")
+
