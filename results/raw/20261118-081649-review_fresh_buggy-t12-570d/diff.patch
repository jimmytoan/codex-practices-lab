@@ -0,0 +1,53 @@
+import pytest
+
+from shoplib.errors import ShopError
+from shoplib.search import Product, search
+
+
+@pytest.fixture
+def products():
+    return [
+        Product("MUG-RED", "Blue ceramic mug", 1200, ["Sale", "Kitchen"]),
+        Product("MUG-BLUE", "Blue travel cup", 900, ["Featured"]),
+        Product("PLATE", "Dinner plate", 1500, ["Kitchen"]),
+    ]
+
+
+def test_search_terms_quotes_fields_prefixes_negation_and_price(products):
+    assert search(products, "blue") == products[:2]
+    assert search(products, '"blue ceramic"') == products[:1]
+    assert search(products, 'name:"CERAMIC MUG"') == products[:1]
+    assert search(products, "sku:MUG-*") == products[:2]
+    assert search(products, "tag:sa*") == products[:1]
+    assert search(products, "tag:KITCHEN") == [products[0], products[2]]
+    assert search(products, "-tag:sale") == products[1:]
+    assert search(products, "price>=1000") == [products[0], products[2]]
+    assert search(products, "price<1000") == [products[1]]
+
+
+def test_empty_query_matches_every_product(products):
+    assert search(products, "") == products
+    assert search(products, "  \t\n") == products
+
+
+def test_case_insensitive_matching_uses_unicode_case_folding():
+    product = Product("STRAẞE", "Straße mug", 500, ["Maße"])
+    assert search([product], "STRASSE") == [product]
+    assert search([product], "sku:strasse") == [product]
+    assert search([product], "tag:MASSE") == [product]
+
+
+@pytest.mark.parametrize(
+    "query",
+    [
+        "price:5",
+        "price>=1.5",
+        "tag:",
+        "-",
+        '-""',
+        '"unclosed',
+    ],
+)
+def test_invalid_queries_raise_value_error(query, products):
+    with pytest.raises(ShopError):
+        search(products, query)
