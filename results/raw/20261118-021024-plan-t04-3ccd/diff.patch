 import pytest
 
+from shoplib.errors import ShopError
 from shoplib.inventory import Inventory
-from shoplib.orders import DELIVERED, NEW, Order
+from shoplib.orders import CANCELLED, DELIVERED, NEW, PAID, SHIPPED, Order
 
 
 def make():
@@ -25,3 +26,60 @@ def test_cannot_ship_unpaid():
     _, order = make()
     with pytest.raises(ValueError):
         order.ship()
+
+
+@pytest.mark.parametrize("paid", [False, True])
+def test_cancel_releases_only_order_stock_and_is_idempotent(paid):
+    inv, order = make()
+    other = Order("o2", {"A": 1}, inv)
+    if paid:
+        order.pay()
+    order.cancel()
+    assert order.state == CANCELLED
+    assert order.refund_due is paid
+    assert (inv.on_hand("A"), inv.reserved("A"), inv.available("A")) == (5, 1, 4)
+    order.cancel()
+    assert order.state == CANCELLED
+    assert order.refund_due is paid
+    assert inv.reserved("A") == 1
+    assert other.state == NEW
+
+
+@pytest.mark.parametrize("deliver", [False, True])
+def test_cannot_cancel_shipped_or_delivered_order(deliver):
+    inv, order = make()
+    order.pay()
+    order.ship()
+    if deliver:
+        order.deliver()
+    before = (order.state, order.refund_due, inv.on_hand("A"), inv.reserved("A"), inv.available("A"))
+    assert order.state == (DELIVERED if deliver else SHIPPED)
+    with pytest.raises(ShopError):
+        order.cancel()
+    assert (order.state, order.refund_due, inv.on_hand("A"), inv.reserved("A"), inv.available("A")) == before
+
+
+def test_cancel_releases_each_order_line():
+    inv = Inventory()
+    inv.receive("A", 3)
+    inv.receive("B", 4)
+    order = Order("o1", {"A": 2, "B": 3}, inv)
+    order.cancel()
+    assert order.state == CANCELLED
+    assert (inv.reserved("A"), inv.reserved("B")) == (0, 0)
+    assert (inv.available("A"), inv.available("B")) == (3, 4)
+
+
+def test_failed_cancel_preserves_all_reservations_and_order_state():
+    inv = Inventory()
+    inv.receive("A", 3)
+    inv.receive("B", 3)
+    order = Order("o1", {"A": 2, "B": 2}, inv)
+    order.pay()
+    inv.release("B", 1)
+    with pytest.raises(ShopError):
+        order.cancel()
+    assert order.state == PAID
+    assert order.refund_due is False
+    assert (inv.reserved("A"), inv.reserved("B")) == (2, 1)
+    assert (inv.on_hand("A"), inv.on_hand("B")) == (3, 3)
