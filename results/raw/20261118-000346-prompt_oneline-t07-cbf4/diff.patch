 def test_fixed_never_negative():
     assert apply_coupon(300, Coupon("FIVE", "fixed", 500)) == 0
+
+
+def test_apply_coupons_eligibility_selection_and_order():
+    today = date(2026, 11, 18)
+    coupons = [
+        Coupon("Z-TEN", "percent", 10),
+        Coupon("A-TEN", "percent", 10, expires=today),
+        Coupon("LOW", "percent", 5),
+        Coupon("EXPIRED", "percent", 90, expires=date(2026, 11, 17)),
+        Coupon("MINIMUM", "fixed", 100, min_subtotal_cents=1000),
+        Coupon("TOO-HIGH", "fixed", 500, min_subtotal_cents=1001),
+        Coupon("FIXED", "fixed", 50),
+    ]
+    assert apply_coupons(1000, coupons, today) == (750, ["A-TEN", "FIXED", "MINIMUM"])
+
+
+def test_apply_coupons_rounds_percent_and_caps_total():
+    today = date(2026, 11, 18)
+    assert apply_coupons(5, [Coupon("HALF", "percent", 10)], today) == (4, ["HALF"])
+    assert apply_coupons(5, [Coupon("P", "percent", 50), Coupon("F", "fixed", 10)], today) == (
+        0, ["F", "P"]
+    )
+
+
+def test_apply_coupons_empty_and_duplicate_codes():
+    today = date(2026, 11, 18)
+    assert apply_coupons(0, [], today) == (0, [])
+    assert apply_coupons(100, [Coupon("SAME", "fixed", 10), Coupon("SAME", "fixed", 20)], today) == (
+        70, ["SAME", "SAME"]
+    )
+
+
+def test_apply_coupons_rejects_invalid_arguments():
+    today = date(2026, 11, 18)
+    with pytest.raises(ShopError):
+        apply_coupons(-1, [], today)
+    with pytest.raises(ShopError):
+        apply_coupons(100, [Coupon("BAD", "unknown", 10)], today)
