+++ b/tests/test_invoice.py
@@ -0,0 +1,85 @@
+import pytest
+
+from shoplib.errors import ShopError
+from shoplib.invoice import build_invoice
+
+
+def test_coupon_split_tax_and_total():
+    lines = [("a", 100, 2, "standard"), ("b", 100, 1, "food"),
+             ("c", 100, 1, "books")]
+    assert build_invoice(lines, 3, 50, "DE") == {
+        "lines": [
+            {"sku": "a", "gross_cents": 200, "discount_cents": 1,
+             "net_cents": 199, "tax_cents": 38},
+            {"sku": "b", "gross_cents": 100, "discount_cents": 1,
+             "net_cents": 99, "tax_cents": 7},
+            {"sku": "c", "gross_cents": 100, "discount_cents": 1,
+             "net_cents": 99, "tax_cents": 7},
+        ],
+        "shipping_cents": 50,
+        "shipping_tax_cents": 10,
+        "total_cents": 509,
+    }
+
+
+def test_largest_remainder_ties_go_to_earlier_lines():
+    lines = [("first", 1, 1, "books"), ("second", 1, 1, "books"),
+             ("third", 1, 1, "books")]
+    result = build_invoice(lines, 2, 0, "SG")
+    assert [line["discount_cents"] for line in result["lines"]] == [1, 1, 0]
+    assert result["total_cents"] == 1
+
+
+@pytest.mark.parametrize("coupon", [5, 100])
+def test_coupon_is_capped_at_gross(coupon):
+    result = build_invoice([("a", 2, 1, "standard"), ("b", 3, 1, "books")],
+                           coupon, 50, "DE")
+    assert [line["discount_cents"] for line in result["lines"]] == [2, 3]
+    assert result["total_cents"] == 60
+    assert result["shipping_tax_cents"] == 10
+
+
+def test_zero_gross_and_coupon():
+    result = build_invoice([("free", 0, 2, "standard"), ("book", 0, 1, "books")],
+                           100, 50, "DE")
+    assert [line["discount_cents"] for line in result["lines"]] == [0, 0]
+    assert result["total_cents"] == 60
+    result = build_invoice([("a", 10, 1, "books")], 0, 0, "SG")
+    assert result["lines"][0]["discount_cents"] == 0
+    assert result["total_cents"] == 10
+
+
+def test_tax_is_rounded_per_line_half_up():
+    result = build_invoice([("a", 50, 1, "standard"), ("b", 50, 1, "standard")],
+                           0, 0, "SG")
+    assert [line["tax_cents"] for line in result["lines"]] == [5, 5]
+    assert result["total_cents"] == 110
+
+
+@pytest.mark.parametrize("region,category,expected_tax", [
+    ("SG", "books", 0),
+    ("SG", "food", 5),
+    ("OR", "standard", 0),
+])
+def test_shipping_tax_depends_on_category_rate(region, category, expected_tax):
+    result = build_invoice([("a", 1, 1, category)], 0, 50, region)
+    assert result["shipping_tax_cents"] == expected_tax
+
+
+@pytest.mark.parametrize("lines,coupon,shipping,region", [
+    ([("a", 1, 1, "standard")], 0, 0, "unknown"),
+    ([("a", 1, 1, "unknown")], 0, 0, "DE"),
+    ([], 0, 0, "DE"),
+    ([("a", 1, 0, "standard")], 0, 0, "DE"),
+    ([("a", 1, -1, "standard")], 0, 0, "DE"),
+    ([("a", -1, 1, "standard")], 0, 0, "DE"),
+    ([("a", 1, 1, "standard")], -1, 0, "DE"),
+    ([("a", 1, 1, "standard")], 0, -1, "DE"),
+    ([("a", 1.5, 1, "standard")], 0, 0, "DE"),
+    ([("a", 1, 1.5, "standard")], 0, 0, "DE"),
+    ([("a", 1, 1, "standard")], 0.5, 0, "DE"),
+    ([("a", 1, 1, "standard")], 0, 0.5, "DE"),
+])
+def test_invalid_arguments_raise_shop_error(lines, coupon, shipping, region):
+    with pytest.raises(ShopError):
+        build_invoice(lines, coupon, shipping, region)
