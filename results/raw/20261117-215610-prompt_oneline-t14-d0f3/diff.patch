@@ -0,0 +1,59 @@
+import pytest
+
+from shoplib.errors import ShopError
+from shoplib.storedays import daily_revenue
+
+
+def test_store_days_convert_zones_combine_refunds_and_fill_gaps():
+    sales = [
+        {"at": "2026-11-21T04:00:00+08:00", "cents": 75},
+        {"at": "2026-11-18T02:30:00+08:00", "cents": 1000},
+        {"at": "2026-11-17T18:30:00Z", "cents": -200},
+        {"at": "2026-11-17T20:00:00Z", "cents": 500},
+        {"at": "2026-11-17T12:00:00-08:00", "cents": 25},
+    ]
+    assert daily_revenue(sales) == [
+        ("2026-11-17", 800),
+        ("2026-11-18", 525),
+        ("2026-11-19", 0),
+        ("2026-11-20", 0),
+        ("2026-11-21", 75),
+    ]
+
+
+def test_custom_offset_and_start_across_year_boundary():
+    sales = [
+        {"at": "2027-01-01T04:59:59Z", "cents": 10},
+        {"at": "2027-01-01T05:00:00Z", "cents": 20},
+    ]
+    assert daily_revenue(sales, utc_offset_hours=-5, day_starts_hour=0) == [
+        ("2026-12-31", 10),
+        ("2027-01-01", 20),
+    ]
+
+
+def test_empty_sales_and_date_max():
+    assert daily_revenue([]) == []
+    assert daily_revenue([{"at": "9999-12-31T12:00:00Z", "cents": 0}], 0, 0) == [
+        ("9999-12-31", 0)
+    ]
+
+
+@pytest.mark.parametrize("timestamp", [
+    "2026-11-18T02:30:00", "invalid", "2026-02-30T00:00:00Z",
+    "2026-11-18T02:30:00+08:99", "2026-11-18T02:30:00+0800", None,
+])
+def test_invalid_timestamps_raise_shop_error(timestamp):
+    with pytest.raises(ShopError):
+        daily_revenue([{"at": timestamp, "cents": 10}])
+
+
+@pytest.mark.parametrize("sales,offset,start", [
+    (None, 8, 4), ([], 24, 4), ([], -24, 4), ([], 1.5, 4),
+    ([], 8, -1), ([], 8, 24), ([], 8, True),
+    ([{}], 8, 4), ([{"at": "2026-11-18T00:00:00Z", "cents": 1.5}], 8, 4),
+    ([{"at": "2026-11-18T00:00:00Z", "cents": True}], 8, 4),
+])
+def test_invalid_arguments_raise_shop_error(sales, offset, start):
+    with pytest.raises(ShopError):
+        daily_revenue(sales, offset, start)
