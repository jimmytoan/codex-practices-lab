@@ -0,0 +1,83 @@
+import pytest
+
+from shoplib.search import Product, search
+
+
+@pytest.fixture
+def products():
+    return [
+        Product("MUG-BLUE", "Blue Mug", 1000, ["Sale", "Kitchenware"]),
+        Product("mug-red", "Red mug", 1500, ["Kitchen", "Limited*edition"]),
+        Product("BOWL", "Blue bowl", 999, []),
+        Product("MUG-*X", "sku:blue price>=1000", 0, ["star*tag"]),
+    ]
+
+
+@pytest.mark.parametrize(
+    ("query", "indices"),
+    [
+        ("", [0, 1, 2, 3]),
+        (" \t\n", [0, 1, 2, 3]),
+        ("mUg", [0, 1]),
+        ('"blue mug"', [0]),
+        ('name:"BLUE MUG"', [0]),
+        ("blue mug", [0]),
+        ("sku:mug-blue", [0]),
+        ("sku:mug", []),
+        ("sku:MUG-*", [0, 1, 3]),
+        ("sku:MUG-*X", [3]),
+        ("tag:KITCHEN", [1]),
+        ("tag:kitchen*", [0, 1]),
+        ("tag:limited*edition", [1]),
+        ("name:blue", [0, 2, 3]),
+        ("name:blue*", []),
+        ("price<1000", [2, 3]),
+        ("price<=1000", [0, 2, 3]),
+        ("price>1000", [1]),
+        ("price>=1000", [0, 1]),
+        ("price=1000", [0]),
+        ("price=0000", [3]),
+        ("-tag:sale", [1, 2, 3]),
+        ('-name:"blue mug"', [1, 2, 3]),
+        ("mug -price>=1500", [0]),
+        ('"sku:blue"', [3]),
+        ('"price>=1000"', [3]),
+    ],
+)
+def test_query_rules(products, query, indices):
+    assert search(products, query) == [products[index] for index in indices]
+
+
+@pytest.mark.parametrize(
+    "query",
+    [
+        "color:blue", "price:5", ":blue", "tag:", 'name:""', "sku:",
+        "-", '-""', '"unclosed', 'name:"unclosed',
+        "price<", "price>=", "price=abc", "price=1.5", "price=-1",
+        "price=+1", "price==1", "price><1", "price=1x", "price=١",
+        "nomatch tag:",
+    ],
+)
+@pytest.mark.parametrize("products", [[], [Product("A", "Example", 100)]])
+def test_invalid_queries_raise_even_without_matching_products(products, query):
+    with pytest.raises(ValueError):
+        search(products, query)
+
+
+def test_unicode_casefold_and_whitespace_in_quotes():
+    product = Product("STRASSE", "A  Straße mug", 50, ["GRÜN"])
+    assert search([product], 'sku:straße tag:grün name:"  STRASSE"') == [product]
+
+
+def test_quoted_values_and_empty_prefixes():
+    products = [Product("A:B", "dash - and a:b", 0, ["a:b", "two words"]),
+                Product("", "other", 0)]
+    assert search(products, 'sku:"a:b" tag:"two words"') == [products[0]]
+    assert search(products, 'name:"a:b"') == [products[0]]
+    assert search(products, '"-"') == [products[0]]
+    assert search(products, "sku:*") == products
+    assert search(products, "tag:*") == [products[0]]
+
+
+def test_large_price_value(products):
+    assert search(products, "price<" + "9" * 5000) == products
