{"type":"item.completed","item":{"id":"item_5","type":"command_execution","command":"/bin/zsh -c 'cat tests/test_inventory.py'","aggregated_output":"import pytest\n\nfrom shoplib.inventory import Inventory\n\n\ndef test_reserve_and_ship():\n    inv = Inventory()\n    inv.receive(\"A\", 10)\n    inv.reserve(\"A\", 4)\n    assert inv.available(\"A\") == 6\n    inv.ship(\"A\", 4)\n    assert inv.on_hand(\"A\") == 6\n    assert inv.reserved(\"A\") == 0\n\n\ndef test_cannot_reserve_more_than_available():\n    inv = Inventory()\n    inv.receive(\"A\", 2)\n    with pytest.raises(ValueError):\n        inv.reserve(\"A\", 3)\n","exit_code":0,"status":"completed"}}
