 def make():
@@ -25,3 +26,52 @@ def test_cannot_ship_unpaid():
     _, order = make()
     with pytest.raises(ValueError):
         order.ship()
+
+
+@pytest.mark.parametrize("paid", [False, True])
+def test_cancel_releases_only_order_stock_and_sets_refund(paid):
+    inv = Inventory()
+    inv.receive("A", 10)
+    inv.receive("B", 5)
+    order = Order("o1", {"A": 2, "B": 3}, inv)
+    other = Order("o2", {"A": 1, "B": 1}, inv)
+    if paid:
+        order.pay()
+
+    order.cancel()
+
+    assert order.state == CANCELLED
+    assert order.refund_due is paid
+    assert other.state == NEW
+    assert (inv.on_hand("A"), inv.reserved("A"), inv.available("A")) == (10, 1, 9)
+    assert (inv.on_hand("B"), inv.reserved("B"), inv.available("B")) == (5, 1, 4)
+
+    order.cancel()
+    assert order.state == CANCELLED
+    assert order.refund_due is paid
+    assert (inv.reserved("A"), inv.reserved("B")) == (1, 1)
+
+
+@pytest.mark.parametrize("delivered", [False, True])
+def test_cannot_cancel_shipped_or_delivered_order(delivered):
+    inv, order = make()
+    order.pay()
+    order.ship()
+    if delivered:
+        order.deliver()
+    before = (order.state, order.refund_due, inv.on_hand("A"), inv.reserved("A"))
+    with pytest.raises(ShopError):
+        order.cancel()
+    assert (order.state, order.refund_due, inv.on_hand("A"), inv.reserved("A")) == before
+
+
+def test_cancel_failure_does_not_release_other_lines():
+    inv = Inventory()
+    inv.receive("A", 5)
+    inv.receive("B", 5)
+    order = Order("o1", {"A": 2, "B": 2}, inv)
+    inv.release("B", 1)
+    before = (order.state, order.refund_due, dict(inv._on_hand), dict(inv._reserved))
+    with pytest.raises(ShopError):
+        order.cancel()
+    assert (order.state, order.refund_due, inv._on_hand, inv._reserved) == before
