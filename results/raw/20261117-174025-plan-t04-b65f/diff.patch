diff --git a/src/shoplib/orders.py b/src/shoplib/orders.py
index 8edb164..d0ab309 100644
--- a/src/shoplib/orders.py
+++ b/src/shoplib/orders.py
@@ -1,5 +1,6 @@
 """Orders and their life cycle. See docs/order-states.md."""
 
+from .errors import ShopError
 from .inventory import Inventory
 
 NEW = "NEW"
@@ -46,3 +47,20 @@ class Order:
 
     def deliver(self) -> None:
         self._transition((SHIPPED,), DELIVERED)
+
+    def cancel(self) -> None:
+        if self.state == CANCELLED:
+            return
+        if self.state not in (NEW, PAID):
+            raise ShopError(f"cannot go from {self.state} to {CANCELLED}")
+
+        # Check every line before releasing any stock, so failure is atomic.
+        for sku, qty in self.lines.items():
+            if qty <= 0:
+                raise ShopError("qty must be positive")
+            if qty > self.inventory.reserved(sku):
+                raise ShopError(f"only {self.inventory.reserved(sku)} of {sku} reserved")
+        for sku, qty in self.lines.items():
+            self.inventory.release(sku, qty)
+        self.refund_due = self.state == PAID
+        self.state = CANCELLED
diff --git a/tests/test_inventory.py b/tests/test_inventory.py
index 37436c0..51640ac 100644
--- a/tests/test_inventory.py
+++ b/tests/test_inventory.py
@@ -1,5 +1,6 @@
 import pytest
 
+from shoplib.errors import ShopError
 from shoplib.inventory import Inventory
 
 
@@ -18,3 +19,24 @@ def test_cannot_reserve_more_than_available():
     inv.receive("A", 2)
     with pytest.raises(ValueError):
         inv.reserve("A", 3)
+
+
+def test_release_restores_available_stock_without_changing_on_hand():
+    inv = Inventory()
+    inv.receive("A", 10)
+    inv.reserve("A", 4)
+    inv.release("A", 3)
+    assert (inv.on_hand("A"), inv.reserved("A"), inv.available("A")) == (10, 1, 9)
+    inv.release("A", 1)
+    assert (inv.on_hand("A"), inv.reserved("A"), inv.available("A")) == (10, 0, 10)
+
+
+@pytest.mark.parametrize("sku, qty", [("A", 0), ("A", -1), ("A", 3), ("missing", 1)])
+def test_invalid_release_leaves_inventory_unchanged(sku, qty):
+    inv = Inventory()
+    inv.receive("A", 5)
+    inv.reserve("A", 2)
+    before = (dict(inv._on_hand), dict(inv._reserved))
+    with pytest.raises(ShopError):
+        inv.release(sku, qty)
+    assert (inv._on_hand, inv._reserved) == before
