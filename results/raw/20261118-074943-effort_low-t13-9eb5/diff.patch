diff --git a/src/shoplib/costing.py b/src/shoplib/costing.py
index 5e8c27e..16d6ebc 100644
--- a/src/shoplib/costing.py
+++ b/src/shoplib/costing.py
@@ -1,6 +1,90 @@
 """Cost of goods sold with FIFO lots. See docs/costing.md."""
 
+from collections import deque
+from decimal import Decimal
+
+from shoplib.errors import ShopError
+from shoplib.money import round_cents
+
 
 def fifo_costing(events: list[dict]) -> dict:
     """Process stock events and report cost per SKU. See docs/costing.md."""
-    raise NotImplementedError
+    # Lots are [remaining quantity, unit cost]. Sale history is kept separately
+    # because returns always apply to that SKU's latest sale.
+    stock = {}
+    totals = {}
+    latest_sale = {}
+
+    def require_int(value, name):
+        if isinstance(value, bool) or not isinstance(value, int):
+            raise ShopError(f"{name} must be an integer")
+        return value
+
+    for event in events:
+        if not isinstance(event, dict):
+            raise ShopError("event must be a dict")
+        kind = event.get("type")
+        if kind not in ("receive", "sell", "return"):
+            raise ShopError(f"unknown event type: {kind}")
+        if "sku" not in event or "qty" not in event:
+            raise ShopError("event must include sku and qty")
+        sku = event["sku"]
+        try:
+            hash(sku)
+        except TypeError as exc:
+            raise ShopError("sku must be hashable") from exc
+        qty = require_int(event["qty"], "qty")
+        if qty < 1:
+            raise ShopError("qty must be at least 1")
+
+        if sku not in stock:
+            stock[sku] = deque()
+            totals[sku] = {"cogs_cents": 0, "on_hand": 0, "value_cents": 0}
+        state = totals[sku]
+
+        if kind == "receive":
+            if "unit_cost_cents" not in event:
+                raise ShopError("receive event must include unit_cost_cents")
+            unit_cost = require_int(event["unit_cost_cents"], "unit_cost_cents")
+            if unit_cost < 0:
+                raise ShopError("unit_cost_cents must not be negative")
+            stock[sku].append([qty, unit_cost])
+            state["on_hand"] += qty
+            state["value_cents"] += qty * unit_cost
+        elif kind == "sell":
+            if qty > state["on_hand"]:
+                raise ShopError("cannot sell more units than are on hand")
+            remaining = qty
+            sale_cost = 0
+            while remaining:
+                lot_qty, unit_cost = stock[sku][0]
+                taken = min(remaining, lot_qty)
+                sale_cost += taken * unit_cost
+                lot_qty -= taken
+                remaining -= taken
+                if lot_qty:
+                    stock[sku][0][0] = lot_qty
+                else:
+                    stock[sku].popleft()
+            state["on_hand"] -= qty
+            state["value_cents"] -= sale_cost
+            state["cogs_cents"] += sale_cost
+            latest_sale[sku] = {
+                "unit_cost": round_cents(Decimal(sale_cost) / qty),
+                "remaining": qty,
+            }
+        else:
+            sale = latest_sale.get(sku)
+            if sale is None:
+                raise ShopError("cannot return units when there has been no sale")
+            if qty > sale["remaining"]:
+                raise ShopError("return exceeds units returnable from the most recent sale")
+            unit_cost = sale["unit_cost"]
+            return_cost = qty * unit_cost
+            stock[sku].append([qty, unit_cost])
+            sale["remaining"] -= qty
+            state["on_hand"] += qty
+            state["value_cents"] += return_cost
+            state["cogs_cents"] -= return_cost
+
+    return totals
diff --git a/tests/test_costing.py b/tests/test_costing.py
new file mode 100644
index 0000000..60fdefc
--- /dev/null
+++ b/tests/test_costing.py
@@ -0,0 +1,82 @@
+import copy
+
+import pytest
+
+from shoplib.costing import fifo_costing
+
+
+def test_fifo_cogs_and_remaining_inventory():
+    events = [
+        {"type": "receive", "sku": "A", "qty": 2, "unit_cost_cents": 100},
+        {"type": "receive", "sku": "A", "qty": 3, "unit_cost_cents": 150},
+        {"type": "sell", "sku": "A", "qty": 3},
+    ]
+    assert fifo_costing(events) == {
+        "A": {"cogs_cents": 350, "on_hand": 2, "value_cents": 300}
+    }
+
+
+def test_returns_use_latest_sale_average_and_are_added_after_existing_lots():
+    events = [
+        {"type": "receive", "sku": "A", "qty": 1, "unit_cost_cents": 100},
+        {"type": "receive", "sku": "A", "qty": 2, "unit_cost_cents": 200},
+        {"type": "sell", "sku": "A", "qty": 2},  # cost 300; average 150
+        {"type": "return", "sku": "A", "qty": 1},
+        {"type": "sell", "sku": "A", "qty": 1},  # sells existing 200 lot first
+    ]
+    assert fifo_costing(events)["A"] == {
+        "cogs_cents": 350, "on_hand": 1, "value_cents": 150
+    }
+
+
+def test_return_average_rounds_half_up_and_partial_returns_accumulate():
+    events = [
+        {"type": "receive", "sku": "A", "qty": 1, "unit_cost_cents": 1},
+        {"type": "receive", "sku": "A", "qty": 1, "unit_cost_cents": 2},
+        {"type": "sell", "sku": "A", "qty": 2},
+        {"type": "return", "sku": "A", "qty": 1},
+        {"type": "return", "sku": "A", "qty": 1},
+    ]
+    assert fifo_costing(events)["A"] == {
+        "cogs_cents": -1, "on_hand": 2, "value_cents": 4
+    }
+
+
+def test_latest_sale_replaces_returnable_sale():
+    events = [
+        {"type": "receive", "sku": "A", "qty": 3, "unit_cost_cents": 10},
+        {"type": "sell", "sku": "A", "qty": 1},
+        {"type": "sell", "sku": "A", "qty": 1},
+        {"type": "return", "sku": "A", "qty": 1},
+    ]
+    assert fifo_costing(events)["A"] == {
+        "cogs_cents": 10, "on_hand": 2, "value_cents": 20
+    }
+
+
+@pytest.mark.parametrize(
+    "events",
+    [
+        [{"type": "receive", "sku": "A", "qty": 0, "unit_cost_cents": 1}],
+        [{"type": "receive", "sku": "A", "qty": 1, "unit_cost_cents": -1}],
+        [{"type": "sell", "sku": "A", "qty": 1}],
+        [{"type": "return", "sku": "A", "qty": 1}],
+        [
+            {"type": "receive", "sku": "A", "qty": 1, "unit_cost_cents": 1},
+            {"type": "sell", "sku": "A", "qty": 1},
+            {"type": "return", "sku": "A", "qty": 1},
+            {"type": "return", "sku": "A", "qty": 1},
+        ],
+        [{"type": "wat", "sku": "A", "qty": 1}],
+    ],
+)
+def test_invalid_events_raise_value_error(events):
+    with pytest.raises(ValueError):
+        fifo_costing(events)
+
+
+def test_input_events_are_not_modified():
+    events = [{"type": "receive", "sku": "A", "qty": 1, "unit_cost_cents": 7}]
+    original = copy.deepcopy(events)
+    fifo_costing(events)
+    assert events == original
