diff --git a/src/shoplib/storedays.py b/src/shoplib/storedays.py
index c46116f..2d69a63 100644
--- a/src/shoplib/storedays.py
+++ b/src/shoplib/storedays.py
@@ -1,6 +1,42 @@
 """Revenue per store day. See docs/store-days.md."""
 
+from datetime import datetime, timedelta, timezone
+
 
 def daily_revenue(sales: list[dict], utc_offset_hours: int = 8, day_starts_hour: int = 4) -> list[tuple[str, int]]:
     """Revenue per store day. See docs/store-days.md."""
-    raise NotImplementedError
+    totals: dict[str, int] = {}
+    local_offset = timedelta(hours=utc_offset_hours)
+
+    for sale in sales:
+        timestamp = sale["at"]
+        # ``fromisoformat`` accepts ``Z`` on supported Python versions, but
+        # spelling it as an explicit offset also keeps this compatible with
+        # earlier versions of the format parser.
+        if timestamp.endswith("Z"):
+            timestamp = timestamp[:-1] + "+00:00"
+        instant = datetime.fromisoformat(timestamp)
+        if instant.tzinfo is None or instant.utcoffset() is None:
+            raise ValueError("sale timestamp must include a time zone")
+
+        local_time = instant.astimezone(timezone.utc).replace(tzinfo=None) + local_offset
+        store_date = local_time.date()
+        if local_time.hour < day_starts_hour:
+            store_date -= timedelta(days=1)
+
+        day = store_date.isoformat()
+        totals[day] = totals.get(day, 0) + sale["cents"]
+
+    if not totals:
+        return []
+
+    first_day = datetime.fromisoformat(min(totals)).date()
+    last_day = datetime.fromisoformat(max(totals)).date()
+    result = []
+    current_day = first_day
+    while current_day <= last_day:
+        day = current_day.isoformat()
+        result.append((day, totals.get(day, 0)))
+        current_day += timedelta(days=1)
+
+    return result
diff --git a/tests/test_storedays.py b/tests/test_storedays.py
new file mode 100644
index 0000000..29a558e
--- /dev/null
+++ b/tests/test_storedays.py
@@ -0,0 +1,44 @@
+import pytest
+
+from shoplib.storedays import daily_revenue
+
+
+def test_assigns_sales_to_store_day_and_includes_zero_days():
+    sales = [
+        # 02:30 local on the 18th belongs to the store day that began on the 17th.
+        {"at": "2026-11-17T18:30:00Z", "cents": 500},
+        # Exactly 04:00 local starts the store day named the 18th.
+        {"at": "2026-11-17T20:00:00+00:00", "cents": 700},
+        # A refund on the 20th is included; the 19th has no sales.
+        {"at": "2026-11-20T04:00:00+08:00", "cents": -125},
+    ]
+
+    assert daily_revenue(sales) == [
+        ("2026-11-17", 500),
+        ("2026-11-18", 700),
+        ("2026-11-19", 0),
+        ("2026-11-20", -125),
+    ]
+
+
+def test_converts_timestamp_offset_before_assigning_store_day():
+    sales = [{"at": "2026-11-18T00:30:00-05:00", "cents": 250}]
+
+    assert daily_revenue(sales) == [("2026-11-18", 250)]
+
+
+def test_supports_custom_store_offset_and_start_hour():
+    sales = [{"at": "2026-11-18T08:00:00Z", "cents": 300}]
+
+    assert daily_revenue(sales, utc_offset_hours=-5, day_starts_hour=3) == [
+        ("2026-11-18", 300)
+    ]
+
+
+def test_empty_sales_returns_empty_list():
+    assert daily_revenue([]) == []
+
+
+def test_rejects_timestamp_without_timezone():
+    with pytest.raises(ValueError):
+        daily_revenue([{"at": "2026-11-18T02:30:00", "cents": 100}])
