diff --git a/src/shoplib/invoice.py b/src/shoplib/invoice.py
index 5d1398c..4dad9c0 100644
--- a/src/shoplib/invoice.py
+++ b/src/shoplib/invoice.py
@@ -1,5 +1,8 @@
 """Invoices: coupon allocation and tax. See docs/invoicing.md."""
 
+from shoplib.errors import ShopError
+from shoplib.money import percent_of
+
 # Tax rates in percent, by region and product category.
 TAX_RATES = {
     "DE": {"standard": 19, "food": 7, "books": 7},
@@ -10,4 +13,90 @@ TAX_RATES = {
 
 def build_invoice(lines, coupon_cents: int, shipping_cents: int, region: str) -> dict:
     """Build an invoice for an order. See docs/invoicing.md."""
-    raise NotImplementedError
+    try:
+        rates = TAX_RATES[region]
+    except (KeyError, TypeError):
+        raise ShopError(f"unknown region {region!r}") from None
+
+    if not isinstance(coupon_cents, int) or isinstance(coupon_cents, bool) or coupon_cents < 0:
+        raise ShopError("coupon must be a non-negative integer number of cents")
+    if not isinstance(shipping_cents, int) or isinstance(shipping_cents, bool) or shipping_cents < 0:
+        raise ShopError("shipping must be a non-negative integer number of cents")
+
+    try:
+        input_lines = list(lines)
+    except TypeError:
+        raise ShopError("lines must be a non-empty list") from None
+    if not input_lines:
+        raise ShopError("lines must not be empty")
+
+    parsed_lines = []
+    for line in input_lines:
+        try:
+            sku, unit_price_cents, qty, category = line
+        except (TypeError, ValueError):
+            raise ShopError("each line must contain sku, unit price, quantity and category") from None
+
+        if not isinstance(unit_price_cents, int) or isinstance(unit_price_cents, bool) or unit_price_cents < 0:
+            raise ShopError("unit price must be a non-negative integer number of cents")
+        if not isinstance(qty, int) or isinstance(qty, bool) or qty < 1:
+            raise ShopError("quantity must be an integer of at least 1")
+        try:
+            rate = rates[category]
+        except (KeyError, TypeError):
+            raise ShopError(f"unknown category {category!r} for region {region!r}") from None
+
+        parsed_lines.append({
+            "sku": sku,
+            "gross_cents": unit_price_cents * qty,
+            "rate": rate,
+        })
+
+    total_gross = sum(line["gross_cents"] for line in parsed_lines)
+    coupon = min(coupon_cents, total_gross)
+    discounts = [0] * len(parsed_lines)
+
+    if total_gross:
+        remainders = []
+        allocated = 0
+        for index, line in enumerate(parsed_lines):
+            share, remainder = divmod(coupon * line["gross_cents"], total_gross)
+            discounts[index] = share
+            allocated += share
+            remainders.append((remainder, index))
+
+        cents_left = coupon - allocated
+        for _, index in sorted(remainders, key=lambda item: (-item[0], item[1]))[:cents_left]:
+            discounts[index] += 1
+
+    result_lines = []
+    line_tax_total = 0
+    has_taxable_category = False
+    for line, discount in zip(parsed_lines, discounts):
+        gross = line["gross_cents"]
+        net = gross - discount
+        rate = line["rate"]
+        tax = percent_of(net, rate)
+        line_tax_total += tax
+        has_taxable_category = has_taxable_category or rate > 0
+        result_lines.append({
+            "sku": line["sku"],
+            "gross_cents": gross,
+            "discount_cents": discount,
+            "net_cents": net,
+            "tax_cents": tax,
+        })
+
+    shipping_tax = percent_of(shipping_cents, rates["standard"]) if has_taxable_category else 0
+    total = (
+        sum(line["net_cents"] for line in result_lines)
+        + line_tax_total
+        + shipping_cents
+        + shipping_tax
+    )
+    return {
+        "lines": result_lines,
+        "shipping_cents": shipping_cents,
+        "shipping_tax_cents": shipping_tax,
+        "total_cents": total,
+    }
diff --git a/tests/test_invoice.py b/tests/test_invoice.py
new file mode 100644
index 0000000..84d50dd
--- /dev/null
+++ b/tests/test_invoice.py
@@ -0,0 +1,75 @@
+import pytest
+
+from shoplib.errors import ShopError
+from shoplib.invoice import build_invoice
+
+
+def test_coupon_is_split_by_largest_remainder_with_input_order_ties():
+    invoice = build_invoice(
+        [("a", 1, 1, "books"), ("b", 1, 1, "books"), ("c", 1, 1, "books")],
+        2,
+        0,
+        "OR",
+    )
+
+    assert [line["discount_cents"] for line in invoice["lines"]] == [1, 1, 0]
+    assert sum(line["discount_cents"] for line in invoice["lines"]) == 2
+
+
+def test_coupon_uses_proportional_remainders_and_is_capped_at_gross():
+    invoice = build_invoice(
+        [("a", 5, 1, "books"), ("b", 3, 1, "books"), ("c", 2, 1, "books")],
+        6,
+        0,
+        "OR",
+    )
+    assert [line["discount_cents"] for line in invoice["lines"]] == [3, 2, 1]
+    assert sum(line["net_cents"] for line in invoice["lines"]) == 4
+
+    fully_discounted = build_invoice([("a", 5, 1, "books")], 100, 0, "OR")
+    assert fully_discounted["lines"][0]["discount_cents"] == 5
+    assert fully_discounted["total_cents"] == 0
+
+
+def test_zero_gross_lines_get_no_discount():
+    invoice = build_invoice(
+        [("a", 0, 2, "books"), ("b", 0, 1, "food")], 5, 0, "DE"
+    )
+    assert [line["discount_cents"] for line in invoice["lines"]] == [0, 0]
+
+
+def test_tax_is_rounded_per_line_and_shipping_tax_uses_standard_rate():
+    invoice = build_invoice(
+        [("a", 8, 1, "food"), ("b", 8, 1, "food")], 0, 100, "DE"
+    )
+    assert [line["tax_cents"] for line in invoice["lines"]] == [1, 1]
+    assert invoice["shipping_tax_cents"] == 19
+    assert invoice["total_cents"] == 137
+
+
+def test_shipping_tax_is_zero_when_all_line_categories_are_untaxed():
+    invoice = build_invoice([("book", 100, 1, "books")], 0, 200, "SG")
+    assert invoice["shipping_tax_cents"] == 0
+    assert invoice["total_cents"] == 300
+
+
+@pytest.mark.parametrize(
+    "lines,coupon,shipping,region",
+    [
+        ([("a", 1, 1, "books")], 0, 0, "XX"),
+        ([("a", 1, 1, "unknown")], 0, 0, "DE"),
+        ([], 0, 0, "DE"),
+        ([("a", 1, 0, "books")], 0, 0, "DE"),
+        ([("a", -1, 1, "books")], 0, 0, "DE"),
+        ([("a", 1, 1, "books")], -1, 0, "DE"),
+        ([("a", 1, 1, "books")], 0, -1, "DE"),
+    ],
+)
+def test_invalid_arguments_raise_value_error(lines, coupon, shipping, region):
+    with pytest.raises(ValueError):
+        build_invoice(lines, coupon, shipping, region)
+
+
+def test_invalid_arguments_use_shop_error():
+    with pytest.raises(ShopError):
+        build_invoice([], 0, 0, "DE")
