 """Text helpers for URLs and listings."""
 
 import re
+import unicodedata
+
+from shoplib.errors import ShopError
 
 
 def slugify(text: str, max_len: int = 40) -> str:
@@ -13,8 +16,30 @@ def slugify(text: str, max_len: int = 40) -> str:
     - At most `max_len` characters, cut after the other steps; a cut never
       leaves a trailing '-'.
     - If nothing is left, the slug is 'n-a'.
+    - `max_len` must be an integer of at least 3, to accommodate the fallback.
     """
-    slug = re.sub(r"[^a-z0-9]+", "-", text.lower()).strip("-")
+    if not isinstance(text, str):
+        raise ShopError("text must be a string")
+    if not isinstance(max_len, int) or isinstance(max_len, bool) or max_len < 3:
+        raise ShopError("max_len must be an integer of at least 3")
+
+    letters = []
+    after_latin_letter = False
+    for char in unicodedata.normalize("NFD", text.lower()):
+        if unicodedata.category(char).startswith("M"):
+            if not after_latin_letter:
+                letters.append(char)
+            continue
+
+        # Some Latin letters, such as ø, have no Unicode decomposition.
+        name = unicodedata.name(char, "")
+        match = re.fullmatch(r"LATIN SMALL LETTER ([A-Z]) WITH .+", name)
+        if match:
+            char = match.group(1).lower()
+        letters.append(char)
+        after_latin_letter = "a" <= char <= "z"
+
+    slug = re.sub(r"[^a-z0-9]+", "-", "".join(letters)).strip("-")
     slug = slug[:max_len].rstrip("-")
     return slug or "n-a"
 
diff --git a/tests/test_textutil.py b/tests/test_textutil.py
index 4c83bb9..2dca9ae 100644
--- a/tests/test_textutil.py
+++ b/tests/test_textutil.py
@@ -1,3 +1,6 @@
+import pytest
+
+from shoplib.errors import ShopError
 from shoplib.textutil import slugify, truncate
 
 
@@ -6,6 +9,32 @@ def test_slugify_basic():
     assert slugify("!!!") == "n-a"
 
 
+def test_slugify_accents_and_separators():
+    assert slugify(" Crème Brûlée, CAFÉ 42! ") == "creme-brulee-cafe-42"
+    assert slugify("Cre\u0300me Łódź Øǿ") == "creme-lodz-oo"
+    assert slugify("a中文b") == "a-b"
+    assert slugify("a-\u0301b") == "a-b"
+    assert slugify("\u0301") == "n-a"
+
+
+def test_slugify_length_and_fallback():
+    assert slugify("ab cd", 3) == "ab"
+    assert slugify("abcdef", 3) == "abc"
+    assert slugify("!!!", 3) == "n-a"
+    assert slugify("a" * 50) == "a" * 40
+
+
+@pytest.mark.parametrize("max_len", [-1, 0, 1, 2, 3.0, True, None])
+def test_slugify_invalid_max_len(max_len):
+    with pytest.raises(ShopError):
+        slugify("product", max_len)
+
+
+def test_slugify_invalid_text():
+    with pytest.raises(ShopError):
+        slugify(None)
+
+
 def test_truncate():
     assert truncate("hello world", 8) == "hello..."
     assert truncate("short", 8) == "short"
