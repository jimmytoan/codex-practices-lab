+            remaining -= 1
     return day
diff --git a/tests/test_dates.py b/tests/test_dates.py
index fbfd5f2..c872fee 100644
--- a/tests/test_dates.py
+++ b/tests/test_dates.py
@@ -12,3 +12,24 @@ def test_forward_over_weekend():
     # Friday + 1 business day = Monday
     assert add_business_days(date(2026, 11, 13), 1) == date(2026, 11, 16)
     assert add_business_days(date(2026, 11, 16), 3) == date(2026, 11, 19)
+
+
+def test_forward_skips_holidays():
+    holiday = date(2026, 11, 16)
+    assert add_business_days(date(2026, 11, 13), 1, holidays={holiday}) == date(2026, 11, 17)
+
+
+def test_backward_over_weekend_and_holiday():
+    holiday = date(2026, 11, 13)
+    assert add_business_days(date(2026, 11, 16), -1, holidays={holiday}) == date(2026, 11, 12)
+
+
+def test_zero_returns_start_when_business_day():
+    monday = date(2026, 11, 16)
+    assert add_business_days(monday, 0) == monday
+
+
+def test_zero_moves_to_next_business_day():
+    saturday = date(2026, 11, 14)
+    holiday = date(2026, 11, 16)
+    assert add_business_days(saturday, 0, holidays={holiday}) == date(2026, 11, 17)
