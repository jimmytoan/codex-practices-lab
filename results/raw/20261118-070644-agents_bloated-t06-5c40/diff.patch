+++ b/src/shoplib/dates.py
@@ -20,10 +20,16 @@ def add_business_days(start: date, n: int, holidays=()) -> date:
 
     `start` does not have to be a business day.
     """
-    # TODO: holidays and negative n are not handled yet
+    if n == 0:
+        while not is_business_day(start, holidays):
+            start += timedelta(days=1)
+        return start
+
     day = start
-    while n > 0:
-        day += timedelta(days=1)
-        if day.weekday() < 5:
-            n -= 1
+    direction = 1 if n > 0 else -1
+    remaining = abs(n)
+    while remaining:
+        day += timedelta(days=direction)
