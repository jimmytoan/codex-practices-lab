+++ b/tests/test_invoice.py
@@ -0,0 +1,88 @@
+import pytest
+
+from shoplib.errors import ShopError
+from shoplib.invoice import build_invoice
+
+
+def test_invoice_splits_coupon_and_calculates_line_and_shipping_tax():
+    invoice = build_invoice(
+        [("shirt", 100, 2, "standard"), ("food", 100, 1, "food"),
+         ("book", 50, 1, "books")],
+        50, 100, "DE",
+    )
+
+    assert invoice == {
+        "lines": [
+            {"sku": "shirt", "gross_cents": 200, "discount_cents": 29,
+             "net_cents": 171, "tax_cents": 32},
+            {"sku": "food", "gross_cents": 100, "discount_cents": 14,
+             "net_cents": 86, "tax_cents": 6},
+            {"sku": "book", "gross_cents": 50, "discount_cents": 7,
+             "net_cents": 43, "tax_cents": 3},
+        ],
+        "shipping_cents": 100,
+        "shipping_tax_cents": 19,
+        "total_cents": 460,
+    }
+
+
+def test_largest_remainders_are_ranked_and_ties_use_input_order():
+    lines = [("first", 3, 1, "standard"), ("second", 2, 1, "standard"),
+             ("third", 1, 1, "standard")]
+    invoice = build_invoice(lines, 4, 0, "OR")
+    assert [line["discount_cents"] for line in invoice["lines"]] == [2, 1, 1]
+
+    tied = [(sku, 100, 1, "standard") for sku in ("a", "b", "c")]
+    invoice = build_invoice(tied, 2, 0, "OR")
+    assert [line["discount_cents"] for line in invoice["lines"]] == [1, 1, 0]
+
+
+def test_coupon_allocation_uses_exact_integer_remainders():
+    lines = [("a", 10**18, 1, "standard"), ("b", 10**18 + 1, 1, "standard")]
+    invoice = build_invoice(lines, 1, 0, "OR")
+    assert [line["discount_cents"] for line in invoice["lines"]] == [0, 1]
+
+
+def test_coupon_is_capped_and_zero_gross_lines_receive_no_discount():
+    lines = [("free", 0, 2, "standard"), ("paid", 25, 2, "food")]
+    invoice = build_invoice(lines, 500, 0, "DE")
+    assert [line["discount_cents"] for line in invoice["lines"]] == [0, 50]
+    assert invoice["total_cents"] == 0
+
+    invoice = build_invoice([("free", 0, 1, "books")], 500, 10, "SG")
+    assert invoice["lines"][0]["discount_cents"] == 0
+    assert invoice["total_cents"] == 10
+
+
+def test_tax_is_rounded_half_up_per_line():
+    lines = [("a", 50, 1, "food"), ("b", 50, 1, "food")]
+    invoice = build_invoice(lines, 0, 0, "DE")
+    assert [line["tax_cents"] for line in invoice["lines"]] == [4, 4]
+    assert invoice["total_cents"] == 108
+
+
+def test_shipping_tax_depends_on_category_rate_even_when_line_is_free():
+    exempt = build_invoice([("book", 100, 1, "books")], 0, 50, "SG")
+    assert exempt["shipping_tax_cents"] == 0
+
+    taxable = build_invoice([("food", 0, 1, "food")], 0, 50, "SG")
+    assert taxable["shipping_tax_cents"] == 5
+    assert taxable["total_cents"] == 55
+
+    zero_rate = build_invoice([("item", 100, 1, "standard")], 0, 50, "OR")
+    assert zero_rate["shipping_tax_cents"] == 0
+
+
+@pytest.mark.parametrize("lines, coupon, shipping, region", [
+    ([("a", 1, 1, "standard")], 0, 0, "unknown"),
+    ([("a", 1, 1, "unknown")], 0, 0, "DE"),
+    ([], 0, 0, "DE"),
+    ([("a", 1, 0, "standard")], 0, 0, "DE"),
+    ([("a", 1, -1, "standard")], 0, 0, "DE"),
+    ([("a", -1, 1, "standard")], 0, 0, "DE"),
+    ([("a", 1, 1, "standard")], -1, 0, "DE"),
+    ([("a", 1, 1, "standard")], 0, -1, "DE"),
+])
+def test_invalid_arguments_raise_shop_error(lines, coupon, shipping, region):
+    with pytest.raises(ShopError):
+        build_invoice(lines, coupon, shipping, region)
