+
+def test_csv_quotes_fields_with_csv_special_characters():
+    rows = [
+        {"sku": "A,1", "name": 'A "special" name', "units": 2, "revenue_cents": 900},
+        {"sku": "B", "name": "Two\nlines", "units": 1, "revenue_cents": 450},
+    ]
+    assert to_csv(rows) == (
+        "sku,name,units,revenue_cents\n"
+        '"A,1","A ""special"" name",2,900\n'
+        'B,"Two\nlines",1,450\n'
+    )
