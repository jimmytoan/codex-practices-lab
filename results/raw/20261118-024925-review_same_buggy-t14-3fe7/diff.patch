+++ b/tests/test_storedays.py
@@ -0,0 +1,48 @@
+import pytest
+
+from shoplib.errors import ShopError
+from shoplib.storedays import daily_revenue
+
+
+def test_boundary_timezones_refunds_and_gaps():
+    sales = [
+        {"at": "2026-11-18T04:00:00+08:00", "cents": 100},
+        {"at": "2026-11-17T19:59:59.999999Z", "cents": 50},
+        {"at": "2026-11-17T20:30:00+00:00", "cents": -25},
+        {"at": "2026-11-20T00:00:00-04:00", "cents": 200},
+    ]
+    assert daily_revenue(sales) == [
+        ("2026-11-17", 50),
+        ("2026-11-18", 75),
+        ("2026-11-19", 0),
+        ("2026-11-20", 200),
+    ]
+
+
+def test_custom_offset_and_start_hour():
+    sales = [
+        {"at": "2026-11-18T09:59:59Z", "cents": 3},
+        {"at": "2026-11-18T10:00:00Z", "cents": 5},
+    ]
+    assert daily_revenue(sales, utc_offset_hours=-5, day_starts_hour=5) == [
+        ("2026-11-17", 3),
+        ("2026-11-18", 5),
+    ]
+
+
+def test_no_sales_and_maximum_date():
+    assert daily_revenue([]) == []
+    assert daily_revenue([{"at": "9999-12-31T12:00:00+08:00", "cents": 1}]) == [
+        ("9999-12-31", 1)
+    ]
+
+
+@pytest.mark.parametrize("timestamp", ["2026-11-18T05:00:00", "not a timestamp"])
+def test_invalid_timestamp_raises_shop_error(timestamp):
+    with pytest.raises(ShopError):
+        daily_revenue([{"at": timestamp, "cents": 1}])
+
+
+def test_invalid_utc_offset_raises_shop_error():
+    with pytest.raises(ShopError):
+        daily_revenue([], utc_offset_hours=24)
