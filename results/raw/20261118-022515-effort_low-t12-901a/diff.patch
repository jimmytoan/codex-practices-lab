+def _tokens(query):
+    """Yield token text and whether each character was quoted."""
+    chars, quoted_chars = [], []
+    quoted = started = False
+    for char in query:
+        if char == '"':
+            quoted = not quoted
+            started = True
+        elif char.isspace() and not quoted:
+            if started:
+                yield ''.join(chars), quoted_chars
+                chars, quoted_chars = [], []
+                started = False
+        else:
+            chars.append(char)
+            quoted_chars.append(quoted)
+            started = True
+    if quoted:
+        raise ShopError("unclosed quote")
+    if started:
+        yield ''.join(chars), quoted_chars
+
+
+def _parse_term(text, quoted):
+    negated = bool(text and text[0] == '-' and not quoted[0])
+    if negated:
+        text, quoted = text[1:], quoted[1:]
+        if not text:
+            raise ShopError("empty negation")
+
+    colon = next((i for i, char in enumerate(text)
+                  if char == ':' and not quoted[i]), None)
+    if colon is not None:
+        name, value = text[:colon], text[colon + 1:]
+        if name not in ('sku', 'tag', 'name') or any(quoted[:colon]):
+            raise ShopError("unknown field")
+        if not value:
+            raise ShopError("empty field value")
+        value = value.casefold()
+        prefix = name in ('sku', 'tag') and value.endswith('*')
+        if prefix:
+            value = value[:-1]
+        if name == 'name':
+            match = lambda product: value in product.name.casefold()
+        elif name == 'sku':
+            match = lambda product: (product.sku.casefold().startswith(value)
+                                     if prefix else product.sku.casefold() == value)
+        else:
+            match = lambda product: any(
+                tag.casefold().startswith(value) if prefix else tag.casefold() == value
+                for tag in product.tags
+            )
+    else:
+        comparison = re.match(r'^price(<=|>=|<|>|=)', text)
+        if comparison and not any(quoted[:comparison.end()]):
+            value = text[comparison.end():]
+            if not re.fullmatch(r'[0-9]+', value):
+                raise ShopError("invalid price")
+            compare = {'<': operator.lt, '<=': operator.le, '>': operator.gt,
+                       '>=': operator.ge, '=': operator.eq}[comparison.group(1)]
+            price = int(value)
+            match = lambda product: compare(product.price_cents, price)
+        else:
+            value = text.casefold()
+            match = lambda product: value in product.name.casefold()
+    if negated:
+        return lambda product: not match(product)
+    return match
+
