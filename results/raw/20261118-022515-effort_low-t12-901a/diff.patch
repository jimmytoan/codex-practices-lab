@@ -0,0 +1,56 @@
+import pytest
+
+from shoplib.errors import ShopError
+from shoplib.search import Product, search
+
+
+@pytest.fixture
+def products():
+    return [
+        Product('MUG-BLUE', 'Blue ceramic mug', 1000, ['Sale', 'Kitchen']),
+        Product('MUG-RED', 'Red mug', 1500, ['kitchenware']),
+        Product('BOWL', 'Blue bowl', 500, ['SALE']),
+        Product('STAR*X', 'Special * item', 1000, []),
+    ]
+
+
+def test_empty_and_bare_terms(products):
+    assert search(products, '  ') == products
+    assert search(products, 'BLUE mug') == [products[0]]
+    assert search(products, '"blue ceramic"') == [products[0]]
+    assert search(products, '"blue bowl"') == [products[2]]
+    assert search(products, '"missing: value"') == []
+
+
+def test_fields_and_prefixes(products):
+    assert search(products, 'sku:mug-blue') == [products[0]]
+    assert search(products, 'tag:sale') == [products[0], products[2]]
+    assert search(products, 'name:"BLUE ceramic"') == [products[0]]
+    assert search(products, 'sku:mug-*') == products[:2]
+    assert search(products, 'tag:KITCHEN*') == products[:2]
+    assert search(products, 'sku:star*x') == [products[3]]
+    assert search(products, 'name:*') == [products[3]]
+    assert search(products, 'tag:*') == products[:3]
+
+
+@pytest.mark.parametrize(('query', 'indexes'), [
+    ('price<1000', [2]), ('price<=1000', [0, 2, 3]),
+    ('price>1000', [1]), ('price>=1000', [0, 1, 3]),
+    ('price=1000', [0, 3]), ('-price=1000', [1, 2]),
+    ('-tag:sale mug', [1]), ('-"blue bowl"', [0, 1, 3]),
+])
+def test_comparisons_and_negation(products, query, indexes):
+    assert search(products, query) == [products[i] for i in indexes]
+
+
+@pytest.mark.parametrize('query', [
+    'color:blue', 'price:5', 'SKU:foo', 'tag:', 'name:""', 'sku:',
+    '-', '-""', '"unclosed', 'name:"unclosed', 'price=', 'price<abc',
+    'price>=1.5', 'price<=-1', 'price>1x', 'price==1',
+    'missing tag:',
+])
+def test_invalid_queries_raise_even_without_matches(products, query):
+    with pytest.raises(ShopError):
+        search(products, query)
+    with pytest.raises(ShopError):
+        search([], query)
