+def test_bulk_discount_applies_to_lines_with_at_least_ten_units():
+    cart = Cart()
+    cart.add("A", 100, 9)
+    cart.add("B", 100, 10)
+
+    assert cart.line_total("A") == 900
+    assert cart.line_total("B") == 950
+    assert cart.subtotal() == 1850
+
+
+def test_bulk_discount_uses_half_up_rounding_on_line_total():
+    cart = Cart()
+    cart.add("A", 1, 10)
+
+    assert cart.line_total("A") == 9
+
+
+def test_bulk_discount_counts_units_added_to_an_existing_line():
+    cart = Cart()
+    cart.add("A", 100, 6)
+    cart.add("A", 100, 4)
+
+    assert cart.line_total("A") == 950
+
