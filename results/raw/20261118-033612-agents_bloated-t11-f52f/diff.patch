diff --git a/src/shoplib/invoice.py b/src/shoplib/invoice.py
index 5d1398c..2812571 100644
--- a/src/shoplib/invoice.py
+++ b/src/shoplib/invoice.py
@@ -1,5 +1,8 @@
 """Invoices: coupon allocation and tax. See docs/invoicing.md."""
 
+from shoplib.errors import ShopError
+from shoplib.money import percent_of
+
 # Tax rates in percent, by region and product category.
 TAX_RATES = {
     "DE": {"standard": 19, "food": 7, "books": 7},
@@ -10,4 +13,70 @@ TAX_RATES = {
 
 def build_invoice(lines, coupon_cents: int, shipping_cents: int, region: str) -> dict:
     """Build an invoice for an order. See docs/invoicing.md."""
-    raise NotImplementedError
+    if region not in TAX_RATES:
+        raise ShopError(f"unknown region: {region}")
+    if not lines:
+        raise ShopError("invoice must contain at least one line")
+    if coupon_cents < 0:
+        raise ShopError("coupon amount cannot be negative")
+    if shipping_cents < 0:
+        raise ShopError("shipping amount cannot be negative")
+
+    rates = TAX_RATES[region]
+    gross_amounts = []
+    line_rates = []
+    for sku, unit_price_cents, qty, category in lines:
+        if category not in rates:
+            raise ShopError(f"unknown category: {category}")
+        if qty < 1:
+            raise ShopError("quantity must be at least 1")
+        if unit_price_cents < 0:
+            raise ShopError("unit price cannot be negative")
+        gross_amounts.append(unit_price_cents * qty)
+        line_rates.append(rates[category])
+
+    total_gross = sum(gross_amounts)
+    coupon = min(coupon_cents, total_gross)
+    if total_gross == 0:
+        discounts = [0] * len(lines)
+    else:
+        shares = [divmod(coupon * gross, total_gross) for gross in gross_amounts]
+        discounts = [share for share, _ in shares]
+        cents_left = coupon - sum(discounts)
+        remainder_order = sorted(
+            range(len(lines)), key=lambda index: (-shares[index][1], index)
+        )
+        for index in remainder_order[:cents_left]:
+            discounts[index] += 1
+
+    invoice_lines = []
+    for (sku, _, _, _), gross, discount, rate in zip(
+        lines, gross_amounts, discounts, line_rates
+    ):
+        net = gross - discount
+        invoice_lines.append(
+            {
+                "sku": sku,
+                "gross_cents": gross,
+                "discount_cents": discount,
+                "net_cents": net,
+                "tax_cents": percent_of(net, rate),
+            }
+        )
+
+    shipping_tax = (
+        percent_of(shipping_cents, rates["standard"])
+        if any(rate > 0 for rate in line_rates)
+        else 0
+    )
+    total = (
+        sum(line["net_cents"] + line["tax_cents"] for line in invoice_lines)
+        + shipping_cents
+        + shipping_tax
+    )
+    return {
+        "lines": invoice_lines,
+        "shipping_cents": shipping_cents,
+        "shipping_tax_cents": shipping_tax,
+        "total_cents": total,
+    }
diff --git a/tests/test_invoice.py b/tests/test_invoice.py
new file mode 100644
index 0000000..cde7125
--- /dev/null
+++ b/tests/test_invoice.py
@@ -0,0 +1,110 @@
+import pytest
+
+from shoplib.invoice import build_invoice
+
+
+def test_coupon_is_split_by_largest_remainder_and_input_order():
+    invoice = build_invoice(
+        [("A", 100, 1, "food"), ("B", 200, 1, "food"), ("C", 300, 1, "food")],
+        coupon_cents=5,
+        shipping_cents=0,
+        region="OR",
+    )
+
+    assert [line["discount_cents"] for line in invoice["lines"]] == [1, 2, 2]
+    assert sum(line["discount_cents"] for line in invoice["lines"]) == 5
+
+    tied = build_invoice(
+        [("A", 100, 1, "food"), ("B", 100, 1, "food"), ("C", 100, 1, "food")],
+        coupon_cents=2,
+        shipping_cents=0,
+        region="OR",
+    )
+    assert [line["discount_cents"] for line in tied["lines"]] == [1, 1, 0]
+
+
+def test_coupon_is_capped_at_order_gross_and_zero_gross_gets_no_discount():
+    invoice = build_invoice(
+        [("A", 100, 1, "food"), ("B", 200, 1, "books")],
+        coupon_cents=500,
+        shipping_cents=0,
+        region="OR",
+    )
+    assert [line["discount_cents"] for line in invoice["lines"]] == [100, 200]
+    assert [line["net_cents"] for line in invoice["lines"]] == [0, 0]
+
+    zero = build_invoice(
+        [("A", 0, 1, "food"), ("B", 0, 2, "books")],
+        coupon_cents=10,
+        shipping_cents=0,
+        region="DE",
+    )
+    assert [line["discount_cents"] for line in zero["lines"]] == [0, 0]
+
+
+def test_invoice_computes_line_tax_and_taxable_shipping():
+    invoice = build_invoice(
+        [("A", 8, 1, "food"), ("B", 8, 1, "food")],
+        coupon_cents=0,
+        shipping_cents=100,
+        region="DE",
+    )
+
+    assert invoice == {
+        "lines": [
+            {
+                "sku": "A",
+                "gross_cents": 8,
+                "discount_cents": 0,
+                "net_cents": 8,
+                "tax_cents": 1,
+            },
+            {
+                "sku": "B",
+                "gross_cents": 8,
+                "discount_cents": 0,
+                "net_cents": 8,
+                "tax_cents": 1,
+            },
+        ],
+        "shipping_cents": 100,
+        "shipping_tax_cents": 19,
+        "total_cents": 137,
+    }
+
+
+def test_shipping_is_untaxed_when_all_line_categories_are_zero_rated():
+    invoice = build_invoice(
+        [("B", 100, 1, "books")],
+        coupon_cents=0,
+        shipping_cents=100,
+        region="SG",
+    )
+    assert invoice["lines"][0]["tax_cents"] == 0
+    assert invoice["shipping_tax_cents"] == 0
+    assert invoice["total_cents"] == 200
+
+    zero_rate_region = build_invoice(
+        [("F", 100, 1, "food")],
+        coupon_cents=0,
+        shipping_cents=100,
+        region="OR",
+    )
+    assert zero_rate_region["shipping_tax_cents"] == 0
+
+
+@pytest.mark.parametrize(
+    "lines,coupon,shipping,region",
+    [
+        ([], 0, 0, "DE"),
+        ([("A", 1, 1, "food")], -1, 0, "DE"),
+        ([("A", 1, 1, "food")], 0, -1, "DE"),
+        ([("A", -1, 1, "food")], 0, 0, "DE"),
+        ([("A", 1, 0, "food")], 0, 0, "DE"),
+        ([("A", 1, 1, "unknown")], 0, 0, "DE"),
+        ([("A", 1, 1, "food")], 0, 0, "unknown"),
+    ],
+)
+def test_invalid_invoice_arguments_raise_value_error(lines, coupon, shipping, region):
+    with pytest.raises(ValueError):
+        build_invoice(lines, coupon, shipping, region)
