@@ -12,11 +13,23 @@ def slugify(text: str, max_len: int = 40) -> str:
     - No leading or trailing '-'.
     - At most `max_len` characters, cut after the other steps; a cut never
       leaves a trailing '-'.
-    - If nothing is left, the slug is 'n-a'.
+    - If nothing is left, the slug is 'n-a', shortened to fit `max_len`.
     """
-    slug = re.sub(r"[^a-z0-9]+", "-", text.lower()).strip("-")
-    slug = slug[:max_len].rstrip("-")
-    return slug or "n-a"
+    decomposed = unicodedata.normalize("NFD", text.lower())
+    unaccented = []
+    latin_base = False
+    for char in decomposed:
+        if unicodedata.category(char).startswith("M"):
+            if not latin_base:
+                unaccented.append(char)
+            continue
+        latin_base = unicodedata.name(char, "").startswith("LATIN ")
+        unaccented.append(char)
+
+    slug = re.sub(r"[^a-z0-9]+", "-", "".join(unaccented)).strip("-")
+    limit = max(0, max_len)
+    slug = slug[:limit].rstrip("-")
+    return slug or "n-a"[:limit].rstrip("-")
 
 
