+def test_slugify_accents_and_length():
+    assert slugify("Crème Brûlée") == "creme-brulee"
+    assert slugify("Cafe\u0301 au lait") == "cafe-au-lait"
+    assert slugify("Blue Mug", max_len=7) == "blue-mu"
+    assert slugify("Blue-Mug", max_len=5) == "blue"
+    assert slugify("!!!", max_len=2) == "n"
+
+
 def test_truncate():
