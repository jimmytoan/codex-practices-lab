 COLUMNS = ["sku", "name", "units", "revenue_cents"]
 
 
+def _csv_field(value: object) -> str:
+    text = str(value)
+    if any(char in text for char in ',"\r\n'):
+        return '"' + text.replace('"', '""') + '"'
+    return text
+
+
 def sales_summary(sales: list[dict]) -> list[dict]:
     """One row per SKU, sorted by SKU.
 
@@ -23,5 +30,5 @@ def to_csv(rows: list[dict]) -> str:
     """Render summary rows as CSV, following docs/CONVENTIONS.md."""
     lines = [",".join(COLUMNS)]
     for row in rows:
-        lines.append(",".join(str(row[col]) for col in COLUMNS))
+        lines.append(",".join(_csv_field(row[col]) for col in COLUMNS))
     return "\n".join(lines) + "\n"
