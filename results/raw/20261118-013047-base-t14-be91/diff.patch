--- /dev/null
+++ b/tests/test_storedays.py
@@ -0,0 +1,67 @@
+import pytest
+
+from shoplib.errors import ShopError
+from shoplib.storedays import daily_revenue
+
+
+def test_boundary_refunds_and_sales_in_any_order():
+    sales = [
+        {"at": "2026-11-18T04:00:00+08:00", "cents": 300},
+        {"at": "2026-11-18T02:30:00+08:00", "cents": 100},
+        {"at": "2026-11-18T03:59:59.999999+08:00", "cents": -40},
+        {"at": "2026-11-18T04:00:01+08:00", "cents": -50},
+    ]
+    assert daily_revenue(sales) == [("2026-11-17", 60), ("2026-11-18", 250)]
+
+
+def test_timestamp_zones_and_store_offset():
+    sales = [
+        {"at": "2026-11-18T00:00:00Z", "cents": 10},
+        {"at": "2026-11-17T19:00:00-05:00", "cents": 20},
+        {"at": "2026-11-18T05:30:00+05:30", "cents": 30},
+    ]
+    assert daily_revenue(sales, utc_offset_hours=-3, day_starts_hour=22) == [
+        ("2026-11-16", 60)
+    ]
+    assert daily_revenue(sales, utc_offset_hours=8, day_starts_hour=4) == [
+        ("2026-11-18", 60)
+    ]
+
+
+def test_gaps_across_month_and_year_and_zero_total_day():
+    sales = [
+        {"at": "2027-01-02T04:00:00Z", "cents": 0},
+        {"at": "2026-12-30T04:00:00Z", "cents": 100},
+        {"at": "2026-12-30T05:00:00Z", "cents": -100},
+    ]
+    assert daily_revenue(sales, utc_offset_hours=0) == [
+        ("2026-12-30", 0),
+        ("2026-12-31", 0),
+        ("2027-01-01", 0),
+        ("2027-01-02", 0),
+    ]
+
+
+def test_midnight_start_and_no_sales():
+    assert daily_revenue([]) == []
+    assert daily_revenue([{"at": "2026-11-18T00:00:00Z", "cents": 1}], 0, 0) == [
+        ("2026-11-18", 1)
+    ]
+
+
+@pytest.mark.parametrize("timestamp", ["2026-11-18T02:30:00", "not a date", "2026-99-18T00:00:00Z", "2026-11-18T00:00:00+08", "2026-11-18T00:00:00+01:99"])
+def test_invalid_or_unzoned_timestamp_raises_shop_error(timestamp):
+    with pytest.raises(ShopError):
+        daily_revenue([{"at": timestamp, "cents": 100}])
+
+
+@pytest.mark.parametrize("sales", [None, [{}], [{"at": "2026-11-18T00:00:00Z", "cents": 1.5}]])
+def test_invalid_sales_raise_shop_error(sales):
+    with pytest.raises(ShopError):
+        daily_revenue(sales)
+
+
+@pytest.mark.parametrize("offset,start", [(24, 4), (-24, 4), (8, -1), (8, 24), (1.5, 4), (8, True)])
+def test_invalid_store_settings_raise_shop_error(offset, start):
+    with pytest.raises(ShopError):
+        daily_revenue([], offset, start)
