 from dataclasses import dataclass, field
 
+from shoplib.errors import ShopError
+
 
 @dataclass
 class Product:
@@ -11,6 +13,112 @@ class Product:
     tags: list[str] = field(default_factory=list)
 
 
+@dataclass(frozen=True)
+class _Term:
+    kind: str
+    value: str = ""
+    negated: bool = False
+    operator: str = ""
+    price_cents: int = 0
+
+
+def _tokenize(query: str) -> list[list[tuple[str, bool]]]:
+    """Split on unquoted whitespace, retaining whether each character was quoted."""
+    tokens: list[list[tuple[str, bool]]] = []
+    token: list[tuple[str, bool]] = []
+    quoted = False
+    token_started = False
+
+    for char in query:
+        if char == '"':
+            quoted = not quoted
+            token_started = True
+        elif char.isspace() and not quoted:
+            if token_started:
+                tokens.append(token)
+                token = []
+                token_started = False
+        else:
+            token.append((char, quoted))
+            token_started = True
+
+    if quoted:
+        raise ShopError("unclosed quote")
+    if token_started:
+        tokens.append(token)
+    return tokens
+
+
+def _parse_term(token: list[tuple[str, bool]]) -> _Term:
+    negated = bool(token and token[0] == ("-", False))
+    if negated:
+        token = token[1:]
+        if not token:
+            raise ShopError("a negation must have a term")
+
+    colon = next(
+        (index for index, (char, quoted) in enumerate(token)
+         if char == ":" and not quoted),
+        None,
+    )
+    if colon is not None:
+        field_name = "".join(char for char, _ in token[:colon])
+        value = "".join(char for char, _ in token[colon + 1:])
+        if field_name not in {"sku", "name", "tag"}:
+            raise ShopError(f"unknown search field: {field_name}")
+        if not value:
+            raise ShopError(f"empty value for {field_name}")
+        return _Term(field_name, value, negated)
+
+    # A quoted whole term such as "price>=100" is a name phrase. Only
+    # recognize comparisons whose keyword and operator are outside quotes.
+    text = "".join(char for char, _ in token)
+    unquoted = [not quoted for _, quoted in token]
+    if text.startswith("price") and len(token) > 5 and all(unquoted[:5]):
+        operator = next(
+            (op for op in ("<=", ">=", "<", ">", "=")
+             if text.startswith(op, 5)
+             and all(unquoted[5:5 + len(op)])),
+            None,
+        )
+        if operator is not None:
+            amount = text[5 + len(operator):]
+            if not amount or not amount.isascii() or not amount.isdecimal():
+                raise ShopError("price comparison requires a whole number of cents")
+            return _Term("price", negated=negated, operator=operator,
+                         price_cents=int(amount))
+
+    return _Term("name", text, negated)
+
+
+def _matches(product: Product, term: _Term) -> bool:
+    if term.kind == "price":
+        comparisons = {
+            "<": product.price_cents < term.price_cents,
+            "<=": product.price_cents <= term.price_cents,
+            ">": product.price_cents > term.price_cents,
+            ">=": product.price_cents >= term.price_cents,
+            "=": product.price_cents == term.price_cents,
+        }
+        matched = comparisons[term.operator]
+    elif term.kind == "sku":
+        sku = product.sku.casefold()
+        value = term.value.casefold()
+        matched = sku.startswith(value[:-1]) if value.endswith("*") else sku == value
+    elif term.kind == "tag":
+        value = term.value.casefold()
+        if value.endswith("*"):
+            prefix = value[:-1]
+            matched = any(tag.casefold().startswith(prefix) for tag in product.tags)
+        else:
+            matched = any(tag.casefold() == value for tag in product.tags)
+    else:
+        matched = term.value.casefold() in product.name.casefold()
+    return not matched if term.negated else matched
+
+
 def search(products: list[Product], query: str) -> list[Product]:
     """The products that match `query`, in their input order. See docs/search.md."""
-    raise NotImplementedError
+    terms = [_parse_term(token) for token in _tokenize(query)]
+    return [product for product in products
+            if all(_matches(product, term) for term in terms)]
