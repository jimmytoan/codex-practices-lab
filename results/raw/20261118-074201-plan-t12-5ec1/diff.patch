@@ -0,0 +1,86 @@
+import pytest
+
+from shoplib.errors import ShopError
+from shoplib.search import Product, search
+
+
+@pytest.fixture
+def products():
+    return [
+        Product("MUG-RED", "Blue ceramic mug", 1250, ["Kitchen", "Sale"]),
+        Product("MUG-BLUE", "Blue mug set", 2000, ["Kitchen"]),
+        Product("CUP-RED", "Red cup", 999, ["Drinkware", "sale"]),
+    ]
+
+
+def test_empty_query_matches_every_product_in_input_order(products):
+    assert search(products, " \t\n") == products
+
+
+def test_bare_words_and_quoted_phrases_match_name_case_insensitively(products):
+    assert search(products, "BLUE") == products[:2]
+    assert search(products, '"ceramic mug"') == products[:1]
+    assert search(products, 'name:"mug set"') == products[1:2]
+
+
+def test_quoted_whole_term_does_not_turn_colon_into_a_field(products):
+    product = Product("X", "price:5 special", 10)
+    assert search([product], '"price:5"') == [product]
+
+
+def test_sku_and_tag_equality_are_case_insensitive(products):
+    assert search(products, "sku:mug-red") == products[:1]
+    assert search(products, "tag:KITCHEN") == products[:2]
+
+
+def test_sku_and_tag_prefix_matching_and_literal_asterisks(products):
+    literal_star = Product("MUG*RED", "Star mug", 500, ["mug*tag"])
+    all_products = products + [literal_star]
+    assert search(all_products, "sku:MUG-*") == products[:2]
+    assert search(all_products, "tag:DRINK*") == products[2:3]
+    assert search([literal_star], "sku:MUG*RED") == [literal_star]
+    assert search([literal_star], "tag:mug*tag") == [literal_star]
+
+
+@pytest.mark.parametrize(
+    ("query", "expected"),
+    [
+        ("price<1000", [2]),
+        ("price<=999", [2]),
+        ("price>1250", [1]),
+        ("price>=2000", [1]),
+        ("price=1250", [0]),
+    ],
+)
+def test_price_comparisons(query, expected, products):
+    assert search(products, query) == [products[index] for index in expected]
+
+
+def test_negation_excludes_matching_products_and_terms_are_conjoined(products):
+    assert search(products, "blue -tag:sale") == products[1:2]
+    assert search(products, "-sku:MUG-*") == products[2:]
+
+
+@pytest.mark.parametrize(
+    "query",
+    [
+        "color:red",
+        "price:5",
+        "tag:",
+        "sku:\"\"",
+        "-",
+        '"unfinished phrase',
+        "price>",
+        "price>=one-thousand",
+        "price=1.5",
+        "price<-1",
+    ],
+)
+def test_invalid_query_syntax_raises_value_error(query, products):
+    with pytest.raises(ValueError):
+        search(products, query)
+
+
+def test_search_errors_use_shop_error():
+    with pytest.raises(ShopError):
+        search([], "tag:")
