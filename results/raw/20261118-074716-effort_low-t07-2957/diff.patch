 def test_percent():
@@ -7,3 +12,51 @@ def test_percent():
 
 def test_fixed_never_negative():
     assert apply_coupon(300, Coupon("FIVE", "fixed", 500)) == 0
+
+
+def test_apply_coupons_selects_highest_percent_and_stacks_fixed_discounts():
+    coupons = [
+        Coupon("TEN", "percent", 10),
+        Coupon("FIFTEEN", "percent", 15),
+        Coupon("FIVE", "fixed", 500),
+        Coupon("TWO", "fixed", 200),
+    ]
+
+    assert apply_coupons(10_000, coupons, date(2025, 1, 1)) == (
+        7_800,
+        ["FIFTEEN", "FIVE", "TWO"],
+    )
+
+
+def test_apply_coupons_breaks_percent_ties_by_code_and_sorts_codes():
+    coupons = [Coupon("ZED", "percent", 10), Coupon("ALPHA", "percent", 10)]
+
+    assert apply_coupons(1_000, coupons, date(2025, 1, 1)) == (900, ["ALPHA"])
+
+
+def test_apply_coupons_uses_original_subtotal_for_minimums_and_percent():
+    coupons = [
+        Coupon("PERCENT", "percent", 10),
+        Coupon("FIXED", "fixed", 100, min_subtotal_cents=1_000),
+        Coupon("TOO_HIGH", "fixed", 999, min_subtotal_cents=1_001),
+    ]
+
+    assert apply_coupons(1_000, coupons, date(2025, 1, 1)) == (800, ["FIXED", "PERCENT"])
+
+
+def test_apply_coupons_expiry_date_is_inclusive():
+    coupons = [Coupon("TODAY", "fixed", 100, expires=date(2025, 1, 1))]
+
+    assert apply_coupons(500, coupons, date(2025, 1, 1)) == (400, ["TODAY"])
+    assert apply_coupons(500, coupons, date(2025, 1, 2)) == (500, [])
+
+
+def test_apply_coupons_never_returns_negative():
+    coupons = [Coupon("BIG", "fixed", 500), Coupon("SMALL", "fixed", 200)]
+
+    assert apply_coupons(300, coupons, date(2025, 1, 1)) == (0, ["BIG", "SMALL"])
+
+
+def test_apply_coupons_rejects_negative_subtotal():
+    with pytest.raises(ShopError):
+        apply_coupons(-1, [], date(2025, 1, 1))
