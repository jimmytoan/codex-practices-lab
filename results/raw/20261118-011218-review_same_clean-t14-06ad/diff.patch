+++ b/tests/test_storedays.py
@@ -0,0 +1,52 @@
+import pytest
+
+from shoplib.errors import ShopError
+from shoplib.storedays import daily_revenue
+
+
+def test_store_day_boundaries_time_zones_refunds_and_gaps():
+    sales = [
+        {"at": "2026-11-20T04:00:00+08:00", "cents": 500},
+        {"at": "2026-11-17T19:59:59Z", "cents": 100},
+        {"at": "2026-11-17T20:00:00Z", "cents": 200},
+        {"at": "2026-11-18T00:00:00-04:00", "cents": -50},
+        {"at": "2026-11-18T04:00:00+08:00", "cents": 25},
+    ]
+    assert daily_revenue(sales) == [
+        ("2026-11-17", 100),
+        ("2026-11-18", 175),
+        ("2026-11-19", 0),
+        ("2026-11-20", 500),
+    ]
+
+
+def test_custom_local_offset_and_start_hour():
+    sales = [
+        {"at": "2026-11-18T07:59:59Z", "cents": 100},
+        {"at": "2026-11-18T08:00:00Z", "cents": 200},
+    ]
+    assert daily_revenue(sales, utc_offset_hours=-5, day_starts_hour=3) == [
+        ("2026-11-17", 100),
+        ("2026-11-18", 200),
+    ]
+
+
+def test_empty_sales():
+    assert daily_revenue([]) == []
+
+
+@pytest.mark.parametrize("timestamp", ["2026-11-18T04:00:00", "not a timestamp"])
+def test_invalid_timestamp_raises_shop_error(timestamp):
+    with pytest.raises(ShopError):
+        daily_revenue([{"at": timestamp, "cents": 100}])
+
+
+def test_invalid_store_offset_raises_shop_error():
+    with pytest.raises(ShopError):
+        daily_revenue([], utc_offset_hours=24)
+
+
+def test_last_representable_store_day():
+    assert daily_revenue([{"at": "9999-12-31T04:00:00+08:00", "cents": 100}]) == [
+        ("9999-12-31", 100),
+    ]
