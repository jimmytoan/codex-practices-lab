 def split_parcels(items: list[tuple[str, int, int]], max_weight_g: int) -> list[list[str]]:
     """Split order items into parcels. See docs/shipping.md."""
-    raise NotImplementedError
+    if not isinstance(max_weight_g, int) or isinstance(max_weight_g, bool) or max_weight_g < 1:
+        raise ShopError("maximum parcel weight must be a positive integer")
+
+    units: list[tuple[int, str]] = []
+    for item in items:
+        if not isinstance(item, (tuple, list)) or len(item) != 3:
+            raise ShopError("each item must contain a SKU, unit weight, and quantity")
+        sku, unit_weight_g, qty = item
+        if not isinstance(sku, str):
+            raise ShopError("SKU must be a string")
+        if not isinstance(unit_weight_g, int) or isinstance(unit_weight_g, bool) or unit_weight_g < 1:
+            raise ShopError("unit weight must be a positive integer")
+        if not isinstance(qty, int) or isinstance(qty, bool) or qty < 1:
+            raise ShopError("quantity must be a positive integer")
+        if unit_weight_g > max_weight_g:
+            raise ShopError("unit is heavier than the maximum parcel weight")
+        units.extend([(unit_weight_g, sku)] * qty)
+
+    units.sort(key=lambda unit: (-unit[0], unit[1]))
+
+    parcels: list[list[str]] = []
+    parcel_weights: list[int] = []
+    for unit_weight_g, sku in units:
+        for index, current_weight_g in enumerate(parcel_weights):
+            if current_weight_g + unit_weight_g <= max_weight_g:
+                parcels[index].append(sku)
+                parcel_weights[index] += unit_weight_g
+                break
+        else:
+            parcels.append([sku])
+            parcel_weights.append(unit_weight_g)
+
+    return parcels
 
 
