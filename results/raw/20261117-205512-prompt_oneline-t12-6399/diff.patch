@@ -0,0 +1,72 @@
+import pytest
+
+from shoplib.errors import ShopError
+from shoplib.search import Product, search
+
+
+@pytest.fixture
+def products():
+    return [
+        Product("MUG-1", "Blue Mug Large", 1000, ["Sale", "Kitchenware"]),
+        Product("mug-2", "Red mug", 1500, ["Kitchen"]),
+        Product("PLATE-1", "Blue Plate", 1000, ["sale"]),
+        Product("STAR*X", "Price: special", 500),
+    ]
+
+
+@pytest.mark.parametrize("query", ["", "  \t\n  "])
+def test_empty_query_returns_all_in_order(products, query):
+    assert search(products, query) == products
+    assert search(products, query) is not products
+
+
+@pytest.mark.parametrize(
+    ("query", "indices"),
+    [
+        ("BLUE", [0, 2]),
+        ('"bLuE mUg"', [0]),
+        ('name:"blue mug"', [0]),
+        ("mug blue", [0]),
+        ("sku:mug-1", [0]),
+        ("sku:MUG-*", [0, 1]),
+        ("sku:STAR*X", [3]),
+        ("tag:sale", [0, 2]),
+        ("tag:kitchen", [1]),
+        ("tag:kitchen*", [0, 1]),
+        ("name:PLATE", [2]),
+        ("name:mug*", []),
+        ("mug -tag:sale", [1]),
+        ('-"blue mug"', [1, 2, 3]),
+        ('"Price: special"', [3]),
+        ('name:"Price: special"', [3]),
+        ("price<1000", [3]),
+        ("price<=1000", [0, 2, 3]),
+        ("price>1000", [1]),
+        ("price>=1000", [0, 1, 2]),
+        ("price=1000", [0, 2]),
+        ("-price=1000", [1, 3]),
+        ("sku:*", [0, 1, 2, 3]),
+        ("tag:*", [0, 1, 2]),
+    ],
+)
+def test_matching_terms(products, query, indices):
+    assert search(products, query) == [products[i] for i in indices]
+
+
+@pytest.mark.parametrize(
+    "query",
+    ["other:value", "price:5", "tag:", 'name:""', "sku:", "-", '-""',
+     '"unclosed', 'name:"unclosed', "price>", "price>=1.5", "price=abc",
+     "price< -1", "price>-1", "price==1", "price>=1x", 'price>="1\n"',
+     "missing tag:"],
+)
+@pytest.mark.parametrize("empty_products", [True, False])
+def test_invalid_queries_raise_shop_error(products, query, empty_products):
+    with pytest.raises(ShopError):
+        search([] if empty_products else products, query)
+
+
+def test_colons_and_operators_inside_quotes_are_literal():
+    products = [Product("x", "price>=100 -tag:sale foo:bar", 50)]
+    for query in ['"price>=100"', '"-tag:sale"', '"foo:bar"']:
+        assert search(products, query) == products
