@@ -13,4 +18,83 @@ class Product:
 
 def search(products: list[Product], query: str) -> list[Product]:
     """The products that match `query`, in their input order. See docs/search.md."""
-    raise NotImplementedError
+    terms = [_parse_term(text, unquoted) for text, unquoted in _tokens(query)]
+    return [product for product in products if all(term(product) for term in terms)]
+
+
+def _tokens(query: str) -> list[tuple[str, list[bool]]]:
+    """Split on unquoted whitespace and retain which characters were quoted."""
+    tokens: list[tuple[str, list[bool]]] = []
+    chars: list[str] = []
+    unquoted: list[bool] = []
+    in_quote = False
+    started = False
+    for char in query:
+        if char == '"':
+            in_quote = not in_quote
+            started = True
+        elif char.isspace() and not in_quote:
+            if started:
+                tokens.append(("".join(chars), unquoted))
+                chars, unquoted = [], []
+                started = False
+        else:
+            chars.append(char)
+            unquoted.append(not in_quote)
+            started = True
+    if in_quote:
+        raise ShopError("unclosed quote")
+    if started:
+        tokens.append(("".join(chars), unquoted))
+    return tokens
+
+
+def _parse_term(text: str, unquoted: list[bool]) -> Callable[[Product], bool]:
+    negate = bool(text and text[0] == "-" and unquoted[0])
+    if negate:
+        text, unquoted = text[1:], unquoted[1:]
+        if not text:
+            raise ShopError("empty negated term")
+
+    colon = next((i for i, char in enumerate(text) if char == ":" and unquoted[i]), -1)
+    if colon != -1:
+        field_name, value = text[:colon], text[colon + 1:]
+        if field_name not in ("sku", "name", "tag"):
+            raise ShopError("unknown search field")
+        if not value:
+            raise ShopError("empty search field value")
+        value = value.casefold()
+        if field_name == "name":
+            match = lambda product: value in product.name.casefold()
+        else:
+            prefix = value.endswith("*")
+            target = value[:-1] if prefix else value
+
+            def matches(candidate: str) -> bool:
+                candidate = candidate.casefold()
+                return candidate.startswith(target) if prefix else candidate == target
+
+            if field_name == "sku":
+                match = lambda product: matches(product.sku)
+            else:
+                match = lambda product: any(matches(tag) for tag in product.tags)
+    else:
+        price = re.fullmatch(r"price(<=|>=|<|>|=)(.*)", text, re.DOTALL)
+        if price and all(unquoted[:price.start(2)]):
+            comparison, value = price.groups()
+            if not re.fullmatch(r"[0-9]+", value):
+                raise ShopError("price must be a whole number of cents")
+            try:
+                amount = int(value)
+            except ValueError as exc:
+                raise ShopError("price must be a whole number of cents") from exc
+            compare = {"<": operator.lt, "<=": operator.le, ">": operator.gt,
+                       ">=": operator.ge, "=": operator.eq}[comparison]
+            match = lambda product: compare(product.price_cents, amount)
+        else:
+            value = text.casefold()
+            match = lambda product: value in product.name.casefold()
+
+    if negate:
+        return lambda product: not match(product)
+    return match
