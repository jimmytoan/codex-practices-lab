+from datetime import date
+
+import pytest
+
+from shoplib.discounts import Coupon, apply_coupon, apply_coupons
+from shoplib.errors import ShopError
 
 
 def test_percent():
@@ -7,3 +12,56 @@ def test_percent():
 
 def test_fixed_never_negative():
     assert apply_coupon(300, Coupon("FIVE", "fixed", 500)) == 0
+
+
+def test_combines_best_percent_and_all_eligible_fixed_coupons():
+    today = date(2026, 11, 17)
+    coupons = [
+        Coupon("Z_TEN", "percent", 10),
+        Coupon("A_TEN", "percent", 10, expires=today),
+        Coupon("LOW", "percent", 5),
+        Coupon("EXPIRED", "percent", 90, expires=date(2026, 11, 16)),
+        Coupon("MINIMUM", "fixed", 40, min_subtotal_cents=105),
+        Coupon("TOO_HIGH", "fixed", 100, min_subtotal_cents=106),
+        Coupon("FIXED", "fixed", 5, expires=date(2026, 11, 18)),
+        Coupon("OLD_FIXED", "fixed", 100, expires=date(2026, 11, 16)),
+    ]
+
+    assert apply_coupons(105, coupons, today) == (49, ["A_TEN", "FIXED", "MINIMUM"])
+
+
+def test_higher_percent_wins_even_when_its_code_sorts_later():
+    coupons = [Coupon("A", "percent", 5), Coupon("Z", "percent", 20)]
+    assert apply_coupons(1000, coupons, date(2026, 11, 17)) == (800, ["Z"])
+
+
+def test_total_is_capped_at_zero_and_all_fixed_codes_are_retained():
+    coupons = [
+        Coupon("PERCENT", "percent", 100),
+        Coupon("FIXED", "fixed", 10),
+        Coupon("FIXED", "fixed", 20),
+        Coupon("ZERO", "fixed", 0),
+    ]
+    assert apply_coupons(100, coupons, date(2026, 11, 17)) == (
+        0, ["FIXED", "FIXED", "PERCENT", "ZERO"]
+    )
+
+
+def test_no_eligible_coupons_and_empty_list_leave_subtotal_unchanged():
+    today = date(2026, 11, 17)
+    assert apply_coupons(100, [], today) == (100, [])
+    assert apply_coupons(100, [Coupon("LATER", "fixed", 10, min_subtotal_cents=101)], today) == (100, [])
+
+
+def test_zero_subtotal_can_have_eligible_coupons():
+    assert apply_coupons(0, [Coupon("ZERO", "percent", 10)], date(2026, 11, 17)) == (0, ["ZERO"])
+
+
+def test_negative_subtotal_raises_shop_error():
+    with pytest.raises(ShopError):
+        apply_coupons(-1, [], date(2026, 11, 17))
+
+
+def test_unknown_coupon_kind_raises_shop_error():
+    with pytest.raises(ShopError):
+        apply_coupons(100, [Coupon("BAD", "other", 10)], date(2026, 11, 17))
