@@ -0,0 +1,72 @@
+import pytest
+
+from shoplib.errors import ShopError
+from shoplib.search import Product, search
+
+
+@pytest.fixture
+def products():
+    return [
+        Product("MUG-01", "Blue mug", 1250, ["kitchen", "sale"]),
+        Product("MUG-02", "Blue travel mug", 2200, ["kitchen"]),
+        Product("CUP-01", "Red cup", 800, ["sale"]),
+    ]
+
+
+def test_empty_query_matches_all_and_preserves_order(products):
+    assert search(products, " \t\n") == products
+
+
+def test_terms_are_anded_and_bare_words_search_names(products):
+    assert search(products, "blue mug") == products[:2]
+    assert search(products, "blue red") == []
+
+
+def test_quoted_phrases_and_field_values_keep_spaces(products):
+    assert search(products, '"travel mug"') == [products[1]]
+    assert search(products, 'name:"travel mug"') == [products[1]]
+
+
+def test_fields_are_case_insensitive_and_support_prefixes(products):
+    assert search(products, "sku:mug-01") == [products[0]]
+    assert search(products, "sku:MUG-*") == products[:2]
+    assert search(products, "tag:SALE") == [products[0], products[2]]
+    assert search(products, "tag:kit*") == products[:2]
+
+
+@pytest.mark.parametrize(
+    ("query", "expected"),
+    [
+        ("price<1000", ["CUP-01"]),
+        ("price<=1250", ["MUG-01", "CUP-01"]),
+        ("price>1250", ["MUG-02"]),
+        ("price>=1250", ["MUG-01", "MUG-02"]),
+        ("price=800", ["CUP-01"]),
+    ],
+)
+def test_price_comparisons(products, query, expected):
+    assert [product.sku for product in search(products, query)] == expected
+
+
+def test_negative_terms_exclude_matching_products(products):
+    assert search(products, "mug -tag:sale") == [products[1]]
+    assert search(products, "-price>=2000") == [products[0], products[2]]
+
+
+@pytest.mark.parametrize(
+    "query",
+    [
+        "other:value",
+        "price:5",
+        "tag:",
+        "name:",
+        "sku:",
+        "price>1.5",
+        "price>=",
+        "-",
+        '"unclosed',
+    ],
+)
+def test_invalid_queries_raise_shop_error(products, query):
+    with pytest.raises(ShopError):
+        search(products, query)
