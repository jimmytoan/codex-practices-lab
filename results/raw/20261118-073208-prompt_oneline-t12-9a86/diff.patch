 @dataclass
@@ -13,4 +16,90 @@ class Product:
 
 def search(products: list[Product], query: str) -> list[Product]:
     """The products that match `query`, in their input order. See docs/search.md."""
-    raise NotImplementedError
+    if not isinstance(query, str):
+        raise ShopError("query must be a string")
+
+    terms = _tokenize(query)
+    predicates = [_compile_term(term) for term in terms]
+    return [product for product in products if all(predicate(product) for predicate in predicates)]
+
+
+def _tokenize(query: str) -> list[str]:
+    """Split on whitespace outside quotes, removing quote delimiters."""
+    terms: list[str] = []
+    current: list[str] = []
+    in_quotes = False
+    started = False
+
+    for char in query:
+        if char == '"':
+            in_quotes = not in_quotes
+            started = True
+        elif char.isspace() and not in_quotes:
+            if started:
+                terms.append("".join(current))
+                current = []
+                started = False
+        else:
+            current.append(char)
+            started = True
+
+    if in_quotes:
+        raise ShopError("unclosed quote")
+    if started:
+        terms.append("".join(current))
+    return terms
+
+
+def _compile_term(term: str):
+    negate = term.startswith("-")
+    if negate:
+        term = term[1:]
+        if not term:
+            raise ShopError("'-' must be followed by a term")
+
+    if ":" in term:
+        field_name, value = term.split(":", 1)
+        if field_name not in {"sku", "name", "tag"}:
+            raise ShopError(f"unknown search field {field_name!r}")
+        if not value:
+            raise ShopError("search field value must not be empty")
+        value_folded = value.casefold()
+        if field_name == "sku":
+            if value.endswith("*"):
+                prefix = value[:-1].casefold()
+                matches = lambda product: product.sku.casefold().startswith(prefix)
+            else:
+                matches = lambda product: product.sku.casefold() == value_folded
+        elif field_name == "tag":
+            if value.endswith("*"):
+                prefix = value[:-1].casefold()
+                matches = lambda product: any(tag.casefold().startswith(prefix) for tag in product.tags)
+            else:
+                matches = lambda product: any(tag.casefold() == value_folded for tag in product.tags)
+        else:
+            matches = lambda product: value_folded in product.name.casefold()
+    else:
+        price = re.fullmatch(r"price(<=|>=|<|>|=)(.*)", term)
+        if price:
+            operator, raw_value = price.groups()
+            if not re.fullmatch(r"[0-9]+", raw_value):
+                raise ShopError("price comparison requires a whole number of cents")
+            cents = int(raw_value)
+            if operator == "<":
+                matches = lambda product: product.price_cents < cents
+            elif operator == "<=":
+                matches = lambda product: product.price_cents <= cents
+            elif operator == ">":
+                matches = lambda product: product.price_cents > cents
+            elif operator == ">=":
+                matches = lambda product: product.price_cents >= cents
+            else:
+                matches = lambda product: product.price_cents == cents
+        else:
+            value_folded = term.casefold()
+            matches = lambda product: value_folded in product.name.casefold()
+
+    if negate:
+        return lambda product: not matches(product)
+    return matches
