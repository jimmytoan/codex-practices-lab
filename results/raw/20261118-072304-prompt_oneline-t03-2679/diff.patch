diff --git a/src/shoplib/inventory.py b/src/shoplib/inventory.py
index 69cd1dc..8a2ea08 100644
--- a/src/shoplib/inventory.py
+++ b/src/shoplib/inventory.py
@@ -1,5 +1,7 @@
 """Stock levels: on hand, reserved for orders, and available."""
 
+from .errors import ShopError
+
 
 class Inventory:
     def __init__(self):
@@ -32,10 +34,15 @@ class Inventory:
         """Give `qty` reserved units back to available.
 
         `qty` must be positive. Releasing more than is currently reserved for
-        the SKU (including a SKU with nothing reserved) raises ValueError and
+        the SKU (including a SKU with nothing reserved) raises ShopError and
         changes nothing.
         """
-        raise NotImplementedError
+        if qty <= 0:
+            raise ShopError("qty must be positive")
+        reserved = self.reserved(sku)
+        if qty > reserved:
+            raise ShopError(f"only {reserved} of {sku} reserved")
+        self._reserved[sku] = reserved - qty
 
     def ship(self, sku: str, qty: int) -> None:
         """Ship `qty` reserved units: they leave both reserved and on hand."""
diff --git a/tests/test_inventory.py b/tests/test_inventory.py
index 37436c0..a66b49e 100644
--- a/tests/test_inventory.py
+++ b/tests/test_inventory.py
@@ -18,3 +18,41 @@ def test_cannot_reserve_more_than_available():
     inv.receive("A", 2)
     with pytest.raises(ValueError):
         inv.reserve("A", 3)
+
+
+def test_release_returns_reserved_units_to_available():
+    inv = Inventory()
+    inv.receive("A", 10)
+    inv.reserve("A", 6)
+
+    inv.release("A", 2)
+
+    assert inv.on_hand("A") == 10
+    assert inv.reserved("A") == 4
+    assert inv.available("A") == 6
+
+
+@pytest.mark.parametrize("qty", [0, -1])
+def test_release_requires_positive_quantity(qty):
+    inv = Inventory()
+    inv.receive("A", 5)
+    inv.reserve("A", 3)
+
+    with pytest.raises(ValueError):
+        inv.release("A", qty)
+
+    assert inv.reserved("A") == 3
+    assert inv.available("A") == 2
+
+
+@pytest.mark.parametrize("sku", ["A", "missing"])
+def test_cannot_release_more_than_reserved_and_failure_changes_nothing(sku):
+    inv = Inventory()
+    inv.receive("A", 5)
+    inv.reserve("A", 2)
+    before = (inv.on_hand("A"), inv.reserved("A"), inv.available("A"))
+
+    with pytest.raises(ValueError):
+        inv.release(sku, 3)
+
+    assert (inv.on_hand("A"), inv.reserved("A"), inv.available("A")) == before
