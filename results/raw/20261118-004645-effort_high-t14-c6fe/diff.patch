+++ b/tests/test_storedays.py
@@ -0,0 +1,127 @@
+import pytest
+
+from shoplib.errors import ShopError
+from shoplib.storedays import daily_revenue
+
+
+def test_default_boundary_includes_start_and_excludes_previous_instant():
+    sales = [
+        {"at": "2026-11-18T03:59:59.999999+08:00", "cents": 120},
+        {"at": "2026-11-18T04:00:00+08:00", "cents": 200},
+        {"at": "2026-11-19T03:59:59+08:00", "cents": -50},
+        {"at": "2026-11-19T04:00:00+08:00", "cents": 300},
+    ]
+    assert daily_revenue(sales) == [
+        ("2026-11-17", 120),
+        ("2026-11-18", 150),
+        ("2026-11-19", 300),
+    ]
+
+
+def test_timestamp_zones_are_converted_to_store_time():
+    sales = [
+        {"at": "2026-11-17T20:00:00Z", "cents": 1},
+        {"at": "2026-11-17T15:00:00-05:00", "cents": 2},
+        {"at": "2026-11-18T05:00:00+09:00", "cents": 4},
+        {"at": "2026-11-18T01:29:59+05:30", "cents": 8},
+    ]
+    assert daily_revenue(sales) == [("2026-11-17", 8), ("2026-11-18", 7)]
+
+
+def test_custom_store_offset_and_midnight_boundary():
+    sales = [
+        {"at": "2026-11-18T04:59:59Z", "cents": 10},
+        {"at": "2026-11-18T05:00:00Z", "cents": 20},
+    ]
+    assert daily_revenue(sales, utc_offset_hours=-5, day_starts_hour=0) == [
+        ("2026-11-17", 10),
+        ("2026-11-18", 20),
+    ]
+
+
+def test_custom_late_day_start():
+    sales = [
+        {"at": "2026-11-18T22:59:59Z", "cents": 10},
+        {"at": "2026-11-18T23:00:00Z", "cents": 20},
+        {"at": "2026-11-19T22:59:59Z", "cents": 30},
+    ]
+    assert daily_revenue(sales, utc_offset_hours=0, day_starts_hour=23) == [
+        ("2026-11-17", 10),
+        ("2026-11-18", 50),
+    ]
+
+
+def test_gaps_zero_totals_refunds_and_unsorted_sales_across_years():
+    sales = [
+        {"at": "2027-01-02T12:00:00Z", "cents": -25},
+        {"at": "2026-12-30T12:00:00Z", "cents": 10**20},
+        {"at": "2027-01-01T12:00:00Z", "cents": 50},
+        {"at": "2027-01-01T13:00:00Z", "cents": -50},
+    ]
+    assert daily_revenue(sales, utc_offset_hours=0) == [
+        ("2026-12-30", 10**20),
+        ("2026-12-31", 0),
+        ("2027-01-01", 0),
+        ("2027-01-02", -25),
+    ]
+
+
+def test_empty_sales():
+    assert daily_revenue([]) == []
+
+
+@pytest.mark.parametrize(
+    "timestamp",
+    [
+        "2026-11-18T02:30:00",
+        "2026-11-18",
+        "2026-11-18+08:00",
+        "2026-11-18T02:30:00+0800",
+        "2026-11-18T02:30:00+08:99",
+        "2026-02-30T02:30:00Z",
+        "not a timestamp",
+        None,
+    ],
+)
+def test_invalid_timestamps_raise_shop_error(timestamp):
+    with pytest.raises(ShopError):
+        daily_revenue([{"at": timestamp, "cents": 100}])
+
+
+@pytest.mark.parametrize("offset", [-24, 24, 1.5, True, None])
+def test_invalid_store_offsets_raise_shop_error(offset):
+    with pytest.raises(ShopError):
+        daily_revenue([], utc_offset_hours=offset)
+
+
+@pytest.mark.parametrize("hour", [-1, 24, 1.5, True, None])
+def test_invalid_day_start_hours_raise_shop_error(hour):
+    with pytest.raises(ShopError):
+        daily_revenue([], day_starts_hour=hour)
+
+
+@pytest.mark.parametrize(
+    "sales",
+    [None, [None], [{}], [{"at": "2026-11-18T02:30:00Z"}],
+     [{"at": "2026-11-18T02:30:00Z", "cents": 1.5}],
+     [{"at": "2026-11-18T02:30:00Z", "cents": True}]],
+)
+def test_invalid_sales_raise_shop_error(sales):
+    with pytest.raises(ShopError):
+        daily_revenue(sales)
+
+
+def test_last_supported_date_does_not_overflow_when_filling_days():
+    sales = [
+        {"at": "9999-12-30T12:00:00Z", "cents": 1},
+        {"at": "9999-12-31T12:00:00Z", "cents": 2},
+    ]
+    assert daily_revenue(sales, utc_offset_hours=0) == [
+        ("9999-12-30", 1),
+        ("9999-12-31", 2),
+    ]
+
+
+def test_store_day_outside_supported_dates_raises_shop_error():
+    with pytest.raises(ShopError):
+        daily_revenue([{"at": "0001-01-01T01:00:00Z", "cents": 1}], utc_offset_hours=0)
