@@ -1,6 +1,59 @@
 """Revenue per store day. See docs/store-days.md."""
 
+import re
+from datetime import datetime, timedelta, timezone
+
+from shoplib.errors import ShopError
+
+
+_ZONE = re.compile(r"(?:Z|[+-](?:[01][0-9]|2[0-3]):[0-5][0-9])$")
+
 
 def daily_revenue(sales: list[dict], utc_offset_hours: int = 8, day_starts_hour: int = 4) -> list[tuple[str, int]]:
-    """Revenue per store day. See docs/store-days.md."""
-    raise NotImplementedError
+    """Return totals for each store day from the first sale to the last."""
+    if type(utc_offset_hours) is not int or not -23 <= utc_offset_hours <= 23:
+        raise ShopError("invalid UTC offset")
+    if type(day_starts_hour) is not int or not 0 <= day_starts_hour <= 23:
+        raise ShopError("invalid store day start hour")
+
+    try:
+        sales_iter = iter(sales)
+    except TypeError as exc:
+        raise ShopError("invalid sales") from exc
+
+    local_zone = timezone(timedelta(hours=utc_offset_hours))
+    totals = {}
+    for sale in sales_iter:
+        if not isinstance(sale, dict) or "at" not in sale or "cents" not in sale:
+            raise ShopError("invalid sale")
+        timestamp, cents = sale["at"], sale["cents"]
+        if not isinstance(timestamp, str) or not _ZONE.search(timestamp):
+            raise ShopError("timestamp must have a valid zone")
+        if type(cents) is not int:
+            raise ShopError("cents must be an integer")
+        try:
+            at = datetime.fromisoformat(timestamp)
+        except ValueError as exc:
+            raise ShopError("invalid timestamp") from exc
+        if at.tzinfo is None or at.utcoffset() is None:
+            raise ShopError("timestamp must have a valid zone")
+        try:
+            local = at.astimezone(local_zone)
+            store_day = local.date()
+            if local.hour < day_starts_hour:
+                store_day -= timedelta(days=1)
+        except OverflowError as exc:
+            raise ShopError("timestamp outside supported dates") from exc
+        totals[store_day] = totals.get(store_day, 0) + cents
+
+    if not totals:
+        return []
+
+    day = min(totals)
+    last = max(totals)
+    result = []
+    while day < last:
+        result.append((day.isoformat(), totals.get(day, 0)))
+        day += timedelta(days=1)
+    result.append((last.isoformat(), totals[last]))
+    return result
diff --git a/tests/test_storedays.py b/tests/test_storedays.py
