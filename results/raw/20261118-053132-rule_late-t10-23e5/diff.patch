@@ -16,9 +16,46 @@ def shipping_cost(weight_g: int) -> int:
 
 def split_parcels(items: list[tuple[str, int, int]], max_weight_g: int) -> list[list[str]]:
     """Split order items into parcels. See docs/shipping.md."""
-    raise NotImplementedError
+    return [
+        [sku for sku, _ in parcel]
+        for parcel in _split_weighted_parcels(items, max_weight_g)
+    ]
 
 
 def shipment_cost(items: list[tuple[str, int, int]], max_weight_g: int) -> int:
     """Total shipping cost of an order. See docs/shipping.md."""
-    raise NotImplementedError
+    return sum(
+        shipping_cost(sum(unit_weight for _, unit_weight in parcel))
+        for parcel in _split_weighted_parcels(items, max_weight_g)
+    )
+
+
+def _split_weighted_parcels(
+    items: list[tuple[str, int, int]], max_weight_g: int
+) -> list[list[tuple[str, int]]]:
+    """Pack individual units while retaining weights for shipment pricing."""
+    units = []
+    for sku, unit_weight_g, quantity in items:
+        if quantity < 1:
+            raise ValueError("quantity must be positive")
+        if unit_weight_g < 1:
+            raise ValueError("weight must be positive")
+        if unit_weight_g > max_weight_g:
+            raise ValueError("unit is heavier than the parcel limit")
+        units.extend([(sku, unit_weight_g)] * quantity)
+
+    units.sort(key=lambda unit: (-unit[1], unit[0]))
+
+    parcels: list[list[tuple[str, int]]] = []
+    parcel_weights: list[int] = []
+    for unit in units:
+        for index, parcel_weight in enumerate(parcel_weights):
+            if parcel_weight + unit[1] <= max_weight_g:
+                parcels[index].append(unit)
+                parcel_weights[index] += unit[1]
+                break
+        else:
+            parcels.append([unit])
+            parcel_weights.append(unit[1])
+
+    return parcels
