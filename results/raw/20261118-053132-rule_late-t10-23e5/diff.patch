+def test_split_parcels_sorts_heaviest_first_and_equal_weights_by_sku():
+    items = [("z", 500, 1), ("a", 500, 1), ("m", 700, 1)]
+
+    assert split_parcels(items, 2000) == [["m", "a", "z"]]
+
+
+def test_split_parcels_uses_first_open_parcel_with_enough_room():
+    items = [
+        ("A", 6, 1),
+        ("B", 5, 1),
+        ("C", 4, 1),
+        ("D", 4, 1),
+        ("E", 2, 1),
+    ]
+
+    assert split_parcels(items, 10) == [["A", "C"], ["B", "D"], ["E"]]
+
+
+def test_split_parcels_expands_quantities_and_allows_exact_limit():
+    assert split_parcels([("book", 4, 3)], 8) == [["book", "book"], ["book"]]
+    assert split_parcels([("box", 8, 1)], 8) == [["box"]]
