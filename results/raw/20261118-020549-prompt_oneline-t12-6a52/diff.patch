@@ -0,0 +1,60 @@
+import pytest
+
+from shoplib.errors import ShopError
+from shoplib.search import Product, search
+
+
+@pytest.fixture
+def products():
+    return [
+        Product("MUG-1", "Blue Mug Large", 1000, ["Sale", "Kitchen"]),
+        Product("MUG-2", "Red mug", 1500, ["Kitchen"]),
+        Product("BOWL-1", "Blue Bowl", 500, ["sale*", "Home"]),
+        Product("MUG-*X", "Blue mug small", 999, []),
+    ]
+
+
+def test_empty_query_and_input_order(products):
+    assert search(products, "  \t ") == products
+    assert search(products, "mUg") == [products[0], products[1], products[3]]
+
+
+def test_quoted_phrases_and_combined_terms(products):
+    assert search(products, '"blue mug" tag:KITCHEN') == [products[0]]
+    assert search(products, 'name:"blue mug" -"small"') == [products[0]]
+    assert search(products, 'name:"Blue Mug" price>=1000') == [products[0]]
+
+
+@pytest.mark.parametrize(
+    ("query", "indices"),
+    [
+        ("sku:mug-1", [0]),
+        ("sku:mug-*", [0, 1, 3]),
+        ("sku:MUG-*X", [3]),
+        ("tag:sale", [0]),
+        ("tag:sal*", [0, 2]),
+        ("tag:sale*e", []),
+        ("name:BLUE", [0, 2, 3]),
+        ("-tag:sale", [1, 2, 3]),
+        ("-sku:mug-*", [2]),
+        ("price<1000", [2, 3]),
+        ("price<=1000", [0, 2, 3]),
+        ("price>1000", [1]),
+        ("price>=1000", [0, 1]),
+        ("price=1000", [0]),
+        ("-price=1000", [1, 2, 3]),
+    ],
+)
+def test_term_matching(products, query, indices):
+    assert search(products, query) == [products[index] for index in indices]
+
+
+@pytest.mark.parametrize(
+    "query",
+    ["category:mug", "price:5", "tag:", 'name:""', "-", '-""',
+     '"unclosed', 'name:"unclosed', "price<", "price>=1.5", "price=-1",
+     "price=1x", "mug price>=abc"],
+)
+def test_invalid_queries_raise_shop_error_even_without_products(query):
+    with pytest.raises(ShopError):
+        search([], query)
