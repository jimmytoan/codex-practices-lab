diff --git a/tests/test_inventory.py b/tests/test_inventory.py
index 37436c0..58bf048 100644
--- a/tests/test_inventory.py
+++ b/tests/test_inventory.py
@@ -1,6 +1,7 @@
 import pytest
 
 from shoplib.inventory import Inventory
+from shoplib.errors import ShopError
 
 
 def test_reserve_and_ship():
@@ -18,3 +19,47 @@ def test_cannot_reserve_more_than_available():
     inv.receive("A", 2)
     with pytest.raises(ValueError):
         inv.reserve("A", 3)
+
+
+def test_release_partial_and_all_reserved_stock():
+    inv = Inventory()
+    inv.receive("A", 10)
+    inv.reserve("A", 4)
+    inv.receive("B", 5)
+    inv.reserve("B", 2)
+
+    inv.release("A", 1)
+    assert (inv.on_hand("A"), inv.reserved("A"), inv.available("A")) == (10, 3, 7)
+    assert (inv.on_hand("B"), inv.reserved("B"), inv.available("B")) == (5, 2, 3)
+
+    inv.release("A", 3)
+    assert (inv.on_hand("A"), inv.reserved("A"), inv.available("A")) == (10, 0, 10)
+    inv.reserve("A", 10)
+    assert inv.reserved("A") == 10
+
+
+@pytest.mark.parametrize("qty", [0, -1])
+def test_release_requires_positive_quantity(qty):
+    inv = Inventory()
+    inv.receive("A", 10)
+    inv.reserve("A", 4)
+
+    with pytest.raises(ShopError):
+        inv.release("A", qty)
+
+    assert (inv.on_hand("A"), inv.reserved("A"), inv.available("A")) == (10, 4, 6)
+
+
+@pytest.mark.parametrize("sku, qty", [("A", 5), ("B", 1), ("unknown", 1)])
+def test_release_cannot_exceed_reserved_stock(sku, qty):
+    inv = Inventory()
+    inv.receive("A", 10)
+    inv.reserve("A", 4)
+    inv.receive("B", 5)
+
+    with pytest.raises(ShopError):
+        inv.release(sku, qty)
+
+    assert (inv.on_hand("A"), inv.reserved("A"), inv.available("A")) == (10, 4, 6)
+    assert (inv.on_hand("B"), inv.reserved("B"), inv.available("B")) == (5, 0, 5)
+    assert (inv.on_hand("unknown"), inv.reserved("unknown"), inv.available("unknown")) == (0, 0, 0)
