diff --git a/src/shoplib/orders.py b/src/shoplib/orders.py
index 8edb164..53b7556 100644
--- a/src/shoplib/orders.py
+++ b/src/shoplib/orders.py
@@ -1,5 +1,6 @@
 """Orders and their life cycle. See docs/order-states.md."""
 
+from .errors import ShopError
 from .inventory import Inventory
 
 NEW = "NEW"
@@ -46,3 +47,22 @@ class Order:
 
     def deliver(self) -> None:
         self._transition((SHIPPED,), DELIVERED)
+
+    def cancel(self) -> None:
+        """Cancel an unshipped order and release its reserved stock."""
+        if self.state == CANCELLED:
+            return
+        if self.state not in (NEW, PAID):
+            raise ShopError(f"cannot cancel an order in {self.state}")
+
+        # Check every line first so a stale reservation cannot partially
+        # release a multi-line order.
+        for sku, qty in self.lines.items():
+            if qty <= 0 or self.inventory.reserved(sku) < qty:
+                raise ShopError(f"cannot release {qty} of {sku}")
+
+        for sku, qty in self.lines.items():
+            self.inventory.release(sku, qty)
+
+        self.refund_due = self.state == PAID
+        self.state = CANCELLED
diff --git a/tests/test_inventory.py b/tests/test_inventory.py
index 37436c0..648a893 100644
--- a/tests/test_inventory.py
+++ b/tests/test_inventory.py
@@ -18,3 +18,38 @@ def test_cannot_reserve_more_than_available():
     inv.receive("A", 2)
     with pytest.raises(ValueError):
         inv.reserve("A", 3)
+
+
+def test_release_returns_reserved_units_to_available():
+    inv = Inventory()
+    inv.receive("A", 10)
+    inv.reserve("A", 4)
+
+    inv.release("A", 3)
+
+    assert inv.on_hand("A") == 10
+    assert inv.reserved("A") == 1
+    assert inv.available("A") == 9
+
+
+@pytest.mark.parametrize("qty", [0, -1])
+def test_release_requires_positive_quantity(qty):
+    inv = Inventory()
+    inv.receive("A", 2)
+    inv.reserve("A", 1)
+
+    with pytest.raises(ValueError):
+        inv.release("A", qty)
+
+    assert inv.reserved("A") == 1
+
+
+def test_release_cannot_exceed_reserved_quantity():
+    inv = Inventory()
+    inv.receive("A", 2)
+    inv.reserve("A", 1)
+
+    with pytest.raises(ValueError):
+        inv.release("A", 2)
+
+    assert inv.reserved("A") == 1
