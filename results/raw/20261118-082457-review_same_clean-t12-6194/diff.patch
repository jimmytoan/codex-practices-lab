@@ -0,0 +1,61 @@
+import pytest
+
+from shoplib.errors import ShopError
+from shoplib.search import Product, search
+
+
+@pytest.fixture
+def products():
+    return [
+        Product("MUG-1", "Blue mug", 1250, ["Kitchen", "Sale"]),
+        Product("MUG-2", "Mug with blue handle", 900, ["Kitchen"]),
+        Product("CUP-1", "Red cup", 500, ["Sale"]),
+    ]
+
+
+def test_terms_match_names_fields_quotes_and_prefixes(products):
+    assert search(products, "blue mug") == products[:2]
+    assert search(products, '"blue mug"') == [products[0]]
+    assert search(products, 'name:"blue handle"') == [products[1]]
+    assert search(products, "sku:mug-*") == products[:2]
+    assert search(products, "tag:sal*") == [products[0], products[2]]
+    assert search(products, "tag:k*t") == []
+    assert search(products, "tag:ki*tchen") == []
+    assert search(products, "name:BLUE") == [products[0], products[1]]
+    assert search(products, "tag:SALE") == [products[0], products[2]]
+
+
+def test_price_comparisons_and_negation(products):
+    assert search(products, "price<900") == [products[2]]
+    assert search(products, "price<=900") == [products[1], products[2]]
+    assert search(products, "price>900") == [products[0]]
+    assert search(products, "price>=900") == products[:2]
+    assert search(products, "price=900") == [products[1]]
+    assert search(products, "-tag:sale") == [products[1]]
+    assert search(products, '-"blue mug"') == [products[1], products[2]]
+    assert search(products, "-price>=900") == [products[2]]
+
+
+def test_empty_query_matches_all_and_terms_are_combined(products):
+    assert search(products, "") == products
+    assert search(products, " \t\n ") == products
+    assert search(products, "mug tag:kitchen price<1000") == [products[1]]
+
+
+@pytest.mark.parametrize(
+    "query",
+    [
+        "price:5",
+        "other:value",
+        "tag:",
+        "price>=",
+        "price>=1.5",
+        "price>=-1",
+        "-",
+        '-""',
+        'name:"blue mug',
+    ],
+)
+def test_invalid_queries_raise_shop_error(query, products):
+    with pytest.raises(ShopError):
+        search(products, query)
