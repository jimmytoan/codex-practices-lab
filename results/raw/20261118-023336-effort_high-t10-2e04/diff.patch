+
+
+def test_split_parcels_uses_first_fit_decreasing():
+    items = [("d", 200, 1), ("b", 500, 1), ("c", 300, 1), ("a", 600, 1)]
+    assert split_parcels(items, 1000) == [["a", "c"], ["b", "d"]]
+
+
+def test_split_parcels_sorts_ties_by_sku_and_expands_quantities():
+    items = [("z", 400, 1), ("b", 400, 2), ("a", 400, 1)]
+    assert split_parcels(items, 800) == [["a", "b"], ["b", "z"]]
+
+
+def test_split_parcels_fills_exact_capacity_and_handles_empty_items():
+    assert split_parcels([("b", 300, 1), ("a", 700, 1)], 1000) == [["a", "b"]]
+    assert split_parcels([], 0) == []
+
+
+@pytest.mark.parametrize(
+    "items, max_weight",
+    [
+        ([("a", 0, 1)], 100),
+        ([("a", -1, 1)], 100),
+        ([("a", 1, 0)], 100),
+        ([("a", 1, -1)], 100),
+        ([("a", 101, 1)], 100),
+        ([("a", 1, 1)], 0),
+    ],
+)
+def test_invalid_parcel_items_raise_shop_error(items, max_weight):
+    with pytest.raises(ShopError):
+        split_parcels(items, max_weight)
+    with pytest.raises(ShopError):
+        shipment_cost(items, max_weight)
+
+
+def test_shipment_cost_sums_parcel_costs():
+    items = [("a", 850, 1), ("b", 600, 1), ("c", 300, 1)]
+    assert split_parcels(items, 1200) == [["a", "c"], ["b"]]
+    assert shipment_cost(items, 1200) == shipping_cost(1150) + shipping_cost(600)
+    assert shipment_cost([("a", 1000, 1)], 1000) == shipping_cost(1000)
+    assert shipment_cost([], 0) == 0
+
+
+def test_shipment_cost_handles_same_sku_with_different_weights():
+    items = [("a", 850, 1), ("z", 300, 1), ("z", 600, 1)]
+    assert split_parcels(items, 1200) == [["a", "z"], ["z"]]
+    assert shipment_cost(items, 1200) == shipping_cost(1150) + shipping_cost(600)
+
+
+def test_shipment_cost_raises_shop_error_for_uncostable_parcel():
