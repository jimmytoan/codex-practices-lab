 """Shipping costs and parcel splitting. See docs/shipping.md."""
 
+from shoplib.errors import ShopError
+
 # (upper bound in grams, cost in cents)
 TIERS = [(1000, 500), (2000, 800), (5000, 1200), (20000, 2500)]
 
 
 def shipping_cost(weight_g: int) -> int:
     """Cost in cents of one parcel of `weight_g` grams. See docs/shipping.md."""
-    if weight_g <= 0:
-        raise ValueError("weight must be positive")
+    if not isinstance(weight_g, int) or isinstance(weight_g, bool) or weight_g <= 0:
+        raise ShopError("weight must be a positive integer")
     for limit, cost in TIERS:
-        if weight_g < limit:
+        if weight_g <= limit:
             return cost
-    raise ValueError("parcel is too heavy")
+    raise ShopError("parcel is too heavy")
+
+
+def _pack_units(
+    items: list[tuple[str, int, int]], max_weight_g: int
+) -> list[list[tuple[str, int]]]:
+    """Return packed (SKU, weight) units in parcel and packing order."""
+    if (
+        not isinstance(max_weight_g, int)
+        or isinstance(max_weight_g, bool)
+        or max_weight_g < 1
+    ):
+        raise ShopError("maximum weight must be a positive integer")
+    if not isinstance(items, list):
+        raise ShopError("items must be a list")
+
+    units = []
+    for item in items:
+        if not isinstance(item, (tuple, list)) or len(item) != 3:
+            raise ShopError("each item must contain a SKU, weight, and quantity")
+        sku, weight_g, quantity = item
+        if not isinstance(sku, str):
+            raise ShopError("SKU must be a string")
+        if (
+            not isinstance(weight_g, int)
+            or isinstance(weight_g, bool)
+            or weight_g < 1
+        ):
+            raise ShopError("weight must be a positive integer")
+        if (
+            not isinstance(quantity, int)
+            or isinstance(quantity, bool)
+            or quantity < 1
+        ):
+            raise ShopError("quantity must be a positive integer")
+        if weight_g > max_weight_g:
+            raise ShopError("unit is heavier than the maximum parcel weight")
+        units.extend([(sku, weight_g)] * quantity)
+
+    # Sort by descending weight, then ascending SKU as specified.
+    units.sort(key=lambda unit: (-unit[1], unit[0]))
+
+    parcels: list[list[tuple[str, int]]] = []
+    parcel_weights: list[int] = []
+    for unit in units:
+        sku, weight_g = unit
+        for index, parcel_weight in enumerate(parcel_weights):
+            if parcel_weight + weight_g <= max_weight_g:
+                parcels[index].append(unit)
+                parcel_weights[index] += weight_g
+                break
+        else:
+            parcels.append([unit])
+            parcel_weights.append(weight_g)
+    return parcels
 
 
 def split_parcels(items: list[tuple[str, int, int]], max_weight_g: int) -> list[list[str]]:
     """Split order items into parcels. See docs/shipping.md."""
-    raise NotImplementedError
+    return [[sku for sku, _ in parcel] for parcel in _pack_units(items, max_weight_g)]
 
 
 def shipment_cost(items: list[tuple[str, int, int]], max_weight_g: int) -> int:
     """Total shipping cost of an order. See docs/shipping.md."""
-    raise NotImplementedError
+    return sum(
+        shipping_cost(sum(weight_g for _, weight_g in parcel))
+        for parcel in _pack_units(items, max_weight_g)
+    )
