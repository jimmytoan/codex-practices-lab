+
+
+def test_apply_coupons_uses_best_percent_then_all_eligible_fixed_coupons():
+    coupons = [
+        Coupon("TEN", "percent", 10),
+        Coupon("FIVE", "percent", 5),
+        Coupon("FIXED-B", "fixed", 200),
+        Coupon("FIXED-A", "fixed", 100),
+    ]
+
+    assert apply_coupons(2000, coupons, date(2025, 1, 1)) == (
+        1500,
+        ["FIXED-A", "FIXED-B", "TEN"],
+    )
+
+
+def test_apply_coupons_breaks_percent_ties_by_code_and_rounds_percent_half_up():
+    coupons = [
+        Coupon("ZED", "percent", 10),
+        Coupon("ALPHA", "percent", 10),
+    ]
+
+    assert apply_coupons(5, coupons, date(2025, 1, 1)) == (4, ["ALPHA"])
+
+
+def test_apply_coupons_checks_expiry_and_minimum_against_original_subtotal():
+    coupons = [
+        Coupon("TODAY", "fixed", 100, expires=date(2025, 1, 1)),
+        Coupon("EXPIRED", "fixed", 100, expires=date(2024, 12, 31)),
+        Coupon("MINIMUM", "fixed", 100, min_subtotal_cents=1001),
+        Coupon("ORIGINAL", "fixed", 400, min_subtotal_cents=900),
+        Coupon("HALF", "percent", 50),
+    ]
+
+    assert apply_coupons(1000, coupons, date(2025, 1, 1)) == (
+        0,
+        ["HALF", "ORIGINAL", "TODAY"],
+    )
+
+
+def test_apply_coupons_returns_original_total_when_none_are_eligible():
+    coupons = [
+        Coupon("EXPIRED", "percent", 50, expires=date(2024, 12, 31)),
+        Coupon("TOO-HIGH", "fixed", 500, min_subtotal_cents=1001),
+    ]
+
+    assert apply_coupons(1000, coupons, date(2025, 1, 1)) == (1000, [])
+
+
+def test_apply_coupons_never_returns_a_negative_total():
+    coupons = [Coupon("HALF", "percent", 50), Coupon("BIG", "fixed", 1000)]
+
+    assert apply_coupons(1000, coupons, date(2025, 1, 1)) == (0, ["BIG", "HALF"])
