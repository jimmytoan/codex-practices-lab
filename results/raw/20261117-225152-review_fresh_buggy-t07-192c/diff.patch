 def test_percent():
@@ -7,3 +12,44 @@ def test_percent():
 
 def test_fixed_never_negative():
     assert apply_coupon(300, Coupon("FIVE", "fixed", 500)) == 0
+
+
+def test_apply_coupons_expiration_and_original_minimum():
+    today = date(2026, 1, 10)
+    coupons = [
+        Coupon("EXPIRES_TODAY", "percent", 50, expires=today),
+        Coupon("EXPIRED", "fixed", 100, expires=today - timedelta(days=1)),
+        Coupon("FUTURE", "fixed", 10, expires=today + timedelta(days=1)),
+        Coupon("MINIMUM", "fixed", 20, min_subtotal_cents=100),
+        Coupon("TOO_SMALL", "fixed", 100, min_subtotal_cents=101),
+    ]
+    assert apply_coupons(100, coupons, today) == (
+        20, ["EXPIRES_TODAY", "FUTURE", "MINIMUM"]
+    )
+
+
+def test_apply_coupons_selects_highest_percent_and_breaks_ties_by_code():
+    coupons = [
+        Coupon("Z", "percent", 10),
+        Coupon("LOWER", "percent", 9),
+        Coupon("A", "percent", 10),
+    ]
+    assert apply_coupons(105, coupons, date(2026, 1, 10)) == (94, ["A"])
+
+
+def test_apply_coupons_clamps_total_and_lists_all_fixed_coupons():
+    coupons = [Coupon("Z", "fixed", 100), Coupon("A", "fixed", 10)]
+    assert apply_coupons(50, coupons, date(2026, 1, 10)) == (0, ["A", "Z"])
+
+
+def test_apply_coupons_empty_and_negative_subtotal():
+    today = date(2026, 1, 10)
+    assert apply_coupons(100, [], today) == (100, [])
+    with pytest.raises(ShopError):
+        apply_coupons(-1, [], today)
+
+
+@pytest.mark.parametrize("expires", [None, date(2026, 1, 9)])
+def test_apply_coupons_rejects_unknown_kind(expires):
+    with pytest.raises(ShopError):
+        apply_coupons(100, [Coupon("BAD", "unknown", 10, expires=expires)], date(2026, 1, 10))
