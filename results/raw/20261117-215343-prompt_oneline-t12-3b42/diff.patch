@@ -0,0 +1,66 @@
+import pytest
+
+from shoplib.errors import ShopError
+from shoplib.search import Product, search
+
+
+@pytest.fixture
+def products():
+    return [
+        Product("MUG-01", "Blue Mug Large", 1000, ["Sale", "Kitchenware"]),
+        Product("mug-02", "Red Mug", 500, ["kitchen"]),
+        Product("PLATE-1", "Blue Plate", 1500, ["SALE"]),
+        Product("STAR*X", "A: B", 1000, ["star*x"]),
+    ]
+
+
+@pytest.mark.parametrize("query", ["", " \t\n "])
+def test_empty_query_matches_everything_in_order(products, query):
+    assert search(products, query) == products
+    assert search(products, query) is not products
+
+
+def test_terms_phrases_and_fields_are_combined(products):
+    assert search(products, 'mUg "BLUE MUG" name:"mug large" tag:sALE') == [products[0]]
+    assert search(products, 'name:"red mug" sku:MUG-02 tag:KITCHEN') == [products[1]]
+    assert search(products, '"A: B"') == [products[3]]
+    assert search(products, 'name:"A: B"') == [products[3]]
+
+
+def test_prefix_exact_and_literal_stars(products):
+    assert search(products, "sku:mug-*") == products[:2]
+    assert search(products, "tag:KITCHEN*") == products[:2]
+    assert search(products, "tag:kitchen") == [products[1]]
+    assert search(products, "sku:star*x tag:STAR*X") == [products[3]]
+    assert search(products, "name:Mug*") == []
+
+
+@pytest.mark.parametrize(
+    ("query", "indices"),
+    [("price<1000", [1]), ("price<=1000", [0, 1, 3]),
+     ("price>1000", [2]), ("price>=1000", [0, 2, 3]),
+     ("price=1000", [0, 3])],
+)
+def test_price_comparisons(products, query, indices):
+    assert search(products, query) == [products[i] for i in indices]
+
+
+def test_price_comparison_accepts_long_whole_numbers(products):
+    assert search(products, "price<" + "9" * 5000) == products
+
+
+def test_negation_applies_to_each_kind_of_term(products):
+    assert search(products, 'mug -tag:sale -price>=1000') == [products[1]]
+    assert search(products, '-"blue mug" -sku:plate* -name:"A: B"') == [products[1]]
+    assert search(products, '"-tag:sale"') == []
+
+
+@pytest.mark.parametrize(
+    "query",
+    ["other:x", "price:5", "tag:", 'name:""', "sku:", "-", '-""',
+     '"unclosed', 'name:"unclosed', "price=", "price>=1.5", "price<abc",
+     "price==1", "price>-1"],
+)
+def test_invalid_queries_raise_shop_error_even_without_products(query):
+    with pytest.raises(ShopError):
+        search([], query)
