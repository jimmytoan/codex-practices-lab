@@ -13,4 +17,83 @@ class Product:
 
 def search(products: list[Product], query: str) -> list[Product]:
     """The products that match `query`, in their input order. See docs/search.md."""
-    raise NotImplementedError
+    terms = [_parse_term(token) for token in _tokenize(query)]
+    return [product for product in products if all(term(product) for term in terms)]
+
+
+def _tokenize(query: str) -> list[list[tuple[str, bool]]]:
+    """Keep track of quoted characters so their syntax stays literal."""
+    tokens = []
+    token = []
+    quoted = False
+    started = False
+    for char in query:
+        if char == '"':
+            quoted = not quoted
+            started = True
+        elif char.isspace() and not quoted:
+            if started:
+                tokens.append(token)
+                token = []
+                started = False
+        else:
+            token.append((char, quoted))
+            started = True
+    if quoted:
+        raise ShopError("unclosed quote")
+    if started:
+        tokens.append(token)
+    return tokens
+
+
+def _parse_term(token: list[tuple[str, bool]]):
+    negated = bool(token and token[0] == ("-", False))
+    if negated:
+        token = token[1:]
+        if not token:
+            raise ShopError("empty negated term")
+
+    value = "".join(char for char, _ in token)
+    colon = next((i for i, (char, quoted) in enumerate(token)
+                  if char == ":" and not quoted), None)
+    if colon is not None:
+        field_name = value[:colon]
+        field_value = value[colon + 1:].casefold()
+        if field_name not in {"sku", "name", "tag"}:
+            raise ShopError(f"unknown search field: {field_name}")
+        if not field_value:
+            raise ShopError("empty search field value")
+        if field_name == "name":
+            match = lambda product: field_value in product.name.casefold()
+        else:
+            prefix = field_value.endswith("*")
+            if prefix:
+                field_value = field_value[:-1]
+
+            def match(product):
+                values = [product.sku] if field_name == "sku" else product.tags
+                if prefix:
+                    return any(item.casefold().startswith(field_value) for item in values)
+                return any(item.casefold() == field_value for item in values)
+    elif (len(token) > 5 and value.startswith("price")
+          and all(not quoted for _, quoted in token[:6])
+          and value[5] in "<>="):
+        comparison = re.fullmatch(r"price(<=|>=|<|>|=)([0-9]+)", value)
+        if comparison is None:
+            raise ShopError("invalid price comparison")
+        operation = {"<": operator.lt, "<=": operator.le, ">": operator.gt,
+                     ">=": operator.ge, "=": operator.eq}[comparison.group(1)]
+        digits = comparison.group(2)
+        # Parse in small chunks so even very long whole-number values work.
+        price = 0
+        for start in range(0, len(digits), 9):
+            chunk = digits[start:start + 9]
+            price = price * (10 ** len(chunk)) + int(chunk)
+        match = lambda product: operation(product.price_cents, price)
+    else:
+        value = value.casefold()
+        match = lambda product: value in product.name.casefold()
+
+    if negated:
+        return lambda product: not match(product)
+    return match
diff --git a/tests/test_search.py b/tests/test_search.py
