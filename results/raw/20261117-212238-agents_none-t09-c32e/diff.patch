diff --git a/tests/test_textutil.py b/tests/test_textutil.py
index 4c83bb9..df063e9 100644
--- a/tests/test_textutil.py
+++ b/tests/test_textutil.py
@@ -1,3 +1,5 @@
+import pytest
+
 from shoplib.textutil import slugify, truncate
 
 
@@ -6,6 +8,29 @@ def test_slugify_basic():
     assert slugify("!!!") == "n-a"
 
 
+def test_slugify_accented_latin_letters():
+    assert slugify("Crème Brûlée") == "creme-brulee"
+    assert slugify("CAFE\u0301 and Việt") == "cafe-and-viet"
+    assert slugify("a\u0301\u0323b") == "ab"
+
+
+def test_slugify_other_characters_are_separators():
+    assert slugify("--Crème__茶\u0301!42--") == "creme-42"
+    assert slugify("a\u0301β\u0301b") == "a-b"
+    assert slugify("a\ufe0fb") == "a-b"
+
+
+def test_slugify_length_limit():
+    assert slugify("Crème Brûlée", 7) == "creme-b"
+    assert slugify("Crème Brûlée", 6) == "creme"
+    assert slugify("ABC", 1) == "a"
+    assert slugify("!!!", 3) == "n-a"
+    assert slugify("!!!", 40) == "n-a"
+    for text, max_len in [("abc", 0), ("!!!", 1), ("!!!", 2), ("abc", -1)]:
+        with pytest.raises(ValueError):
+            slugify(text, max_len)
+
+
 def test_truncate():
     assert truncate("hello world", 8) == "hello..."
     assert truncate("short", 8) == "short"
