@@ -0,0 +1,81 @@
+import pytest
+
+from shoplib.errors import ShopError
+from shoplib.search import Product, search
+
+
+@pytest.fixture
+def products():
+    return [
+        Product("MUG-RED", "Bright Blue Mug", 1200, ["Sale", "Drinkware"]),
+        Product("CUP-01", "Blue cup", 999, ["Featured"]),
+        Product("BOWL-2", "Ceramic bowl", 1000, ["SALE"]),
+    ]
+
+
+def test_empty_query_and_bare_terms_are_case_insensitive_substrings(products):
+    assert search(products, "") == products
+    assert search(products, "  \t\n") == products
+    assert search(products, "BLUE mug") == products[:1]
+    assert search(products, "cup") == products[1:2]
+
+
+def test_quotes_group_terms_and_field_values(products):
+    assert search(products, '"blue mug"') == products[:1]
+    assert search(products, '"mug blue"') == []
+    assert search(products, 'name:"blue mug"') == products[:1]
+    assert search(products, 'name:"blue"') == products[:2]
+
+
+def test_sku_and_tag_exact_and_prefix_matches_are_case_insensitive(products):
+    assert search(products, "sku:mUg-ReD") == products[:1]
+    assert search(products, "sku:MUG-*") == products[:1]
+    assert search(products, "tag:sAlE") == [products[0], products[2]]
+    assert search(products, "tag:dr*") == products[:1]
+    assert search(products, "tag:* ") == products
+    assert search(products, "tag:sale*") == [products[0], products[2]]
+    # An asterisk anywhere except the final position is an ordinary character.
+    assert search(products, "tag:sa*le") == []
+
+
+def test_price_comparisons_use_integer_cents(products):
+    assert search(products, "price<1000") == products[1:2]
+    assert search(products, "price<=1000") == products[1:]
+    assert search(products, "price>1000") == products[:1]
+    assert search(products, "price>=1000") == [products[0], products[2]]
+    assert search(products, "price=999") == products[1:2]
+    assert search(products, "price=01000") == products[2:3]
+
+
+def test_negation_applies_to_one_term_and_can_negate_a_quoted_phrase(products):
+    assert search(products, "-tag:sale") == products[1:2]
+    assert search(products, ' -"blue mug" ') == products[1:]
+    assert search(products, "-name:blue") == products[2:]
+
+
+@pytest.mark.parametrize(
+    "query",
+    [
+        "unknown:value",
+        "price:5",
+        "tag:",
+        "name:",
+        "sku:",
+        "-",
+        '-""',
+        "price>",
+        "price>=abc",
+        "price=1.5",
+        "price<-1",
+        '"unclosed',
+        'name:"unclosed',
+    ],
+)
+def test_invalid_queries_raise_value_error(query, products):
+    with pytest.raises(ValueError):
+        search(products, query)
+
+
+def test_invalid_queries_use_shop_error(products):
+    with pytest.raises(ShopError):
+        search(products, "tag:")
