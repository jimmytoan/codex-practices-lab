-from shoplib.discounts import Coupon, apply_coupon
+from datetime import date
+
+import pytest
+
+from shoplib.discounts import Coupon, apply_coupon, apply_coupons
+from shoplib.errors import ShopError
 
 
 def test_percent():
@@ -7,3 +12,50 @@ def test_percent():
 
 def test_fixed_never_negative():
     assert apply_coupon(300, Coupon("FIVE", "fixed", 500)) == 0
+
+
+def test_combines_best_percent_and_all_eligible_fixed_coupons():
+    today = date(2026, 6, 15)
+    coupons = [
+        Coupon("Z-TWENTY", "percent", 20),
+        Coupon("A-TWENTY", "percent", 20, expires=today),
+        Coupon("TEN", "percent", 10),
+        Coupon("FIXED-B", "fixed", 125, min_subtotal_cents=1000),
+        Coupon("FIXED-A", "fixed", 75),
+        Coupon("EXPIRED", "fixed", 100, expires=date(2026, 6, 14)),
+        Coupon("TOO-SMALL", "fixed", 100, min_subtotal_cents=1001),
+        Coupon("EXPIRED-PERCENT", "percent", 90, expires=date(2026, 6, 14)),
+        Coupon("MIN-PERCENT", "percent", 90, min_subtotal_cents=1001),
+    ]
+    assert apply_coupons(1000, coupons, today) == (
+        600, ["A-TWENTY", "FIXED-A", "FIXED-B"]
+    )
+
+
+def test_percent_rounds_half_up_before_fixed_discount():
+    coupons = [Coupon("HALF", "percent", 50), Coupon("FIXED", "fixed", 1)]
+    assert apply_coupons(5, coupons, date(2026, 1, 1)) == (1, ["FIXED", "HALF"])
+
+
+def test_all_fixed_coupons_apply_even_after_total_reaches_zero():
+    coupons = [Coupon("Z", "fixed", 100), Coupon("A", "fixed", 200)]
+    assert apply_coupons(50, coupons, date(2026, 1, 1)) == (0, ["A", "Z"])
+
+
+def test_no_coupons_or_no_eligible_coupons():
+    today = date(2026, 1, 1)
+    assert apply_coupons(0, [], today) == (0, [])
+    assert apply_coupons(100, [Coupon("LATER", "fixed", 20, min_subtotal_cents=101)], today) == (100, [])
+
+
+def test_duplicate_fixed_codes_are_reported_for_each_coupon():
+    coupons = [Coupon("SAME", "fixed", 10), Coupon("SAME", "fixed", 20)]
+    assert apply_coupons(100, coupons, date(2026, 1, 1)) == (70, ["SAME", "SAME"])
+
+
+def test_negative_subtotal_and_unknown_coupon_kind_raise_shop_error():
+    today = date(2026, 1, 1)
+    with pytest.raises(ShopError):
+        apply_coupons(-1, [], today)
+    with pytest.raises(ShopError):
+        apply_coupons(100, [Coupon("BAD", "unknown", 10)], today)
