@@ -1,5 +1,7 @@
 """Shipping costs and parcel splitting. See docs/shipping.md."""
 
+from .errors import ShopError
+
 # (upper bound in grams, cost in cents)
 TIERS = [(1000, 500), (2000, 800), (5000, 1200), (20000, 2500)]
 
@@ -16,9 +18,38 @@ def shipping_cost(weight_g: int) -> int:
 
 def split_parcels(items: list[tuple[str, int, int]], max_weight_g: int) -> list[list[str]]:
     """Split order items into parcels. See docs/shipping.md."""
-    raise NotImplementedError
+    return [[sku for sku, _ in parcel] for parcel in _pack_units(items, max_weight_g)]
+
+
+def _pack_units(items: list[tuple[str, int, int]], max_weight_g: int) -> list[list[tuple[str, int]]]:
+    if max_weight_g < 1:
+        raise ShopError("maximum parcel weight must be positive")
+
+    units: list[tuple[str, int]] = []
+    for sku, weight_g, qty in items:
+        if weight_g < 1:
+            raise ShopError("item weight must be positive")
+        if qty < 1:
+            raise ShopError("quantity must be positive")
+        if weight_g > max_weight_g:
+            raise ShopError("item is heavier than the parcel limit")
+        units.extend([(sku, weight_g)] * qty)
+
+    units.sort(key=lambda unit: (-unit[1], unit[0]))
+    parcels: list[list[tuple[str, int]]] = []
+    weights: list[int] = []
+    for unit in units:
+        for index, weight in enumerate(weights):
+            if weight + unit[1] <= max_weight_g:
+                parcels[index].append(unit)
+                weights[index] += unit[1]
+                break
+        else:
+            parcels.append([unit])
+            weights.append(unit[1])
+    return parcels
 
 
 def shipment_cost(items: list[tuple[str, int, int]], max_weight_g: int) -> int:
     """Total shipping cost of an order. See docs/shipping.md."""
-    raise NotImplementedError
+    return sum(shipping_cost(sum(weight for _, weight in parcel)) for parcel in _pack_units(items, max_weight_g))
