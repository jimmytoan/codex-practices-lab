diff --git a/src/shoplib/invoice.py b/src/shoplib/invoice.py
index 5d1398c..023b039 100644
--- a/src/shoplib/invoice.py
+++ b/src/shoplib/invoice.py
@@ -1,5 +1,8 @@
 """Invoices: coupon allocation and tax. See docs/invoicing.md."""
 
+from .errors import ShopError
+from .money import percent_of
+
 # Tax rates in percent, by region and product category.
 TAX_RATES = {
     "DE": {"standard": 19, "food": 7, "books": 7},
@@ -10,4 +13,64 @@ TAX_RATES = {
 
 def build_invoice(lines, coupon_cents: int, shipping_cents: int, region: str) -> dict:
     """Build an invoice for an order. See docs/invoicing.md."""
-    raise NotImplementedError
+    if not isinstance(region, str) or region not in TAX_RATES:
+        raise ShopError(f"unknown region: {region}")
+    if not isinstance(lines, list) or not lines:
+        raise ShopError("lines must be a non-empty list")
+    if type(coupon_cents) is not int or coupon_cents < 0:
+        raise ShopError("coupon amount must be a non-negative integer")
+    if type(shipping_cents) is not int or shipping_cents < 0:
+        raise ShopError("shipping amount must be a non-negative integer")
+
+    rates = TAX_RATES[region]
+    validated_lines = []
+    for line in lines:
+        if not isinstance(line, (tuple, list)) or len(line) != 4:
+            raise ShopError("each line must contain sku, price, quantity and category")
+        sku, unit_price_cents, qty, category = line
+        if not isinstance(category, str) or category not in rates:
+            raise ShopError(f"unknown category: {category}")
+        if type(unit_price_cents) is not int or unit_price_cents < 0:
+            raise ShopError("unit price must be a non-negative integer")
+        if type(qty) is not int or qty < 1:
+            raise ShopError("quantity must be a positive integer")
+        validated_lines.append((sku, unit_price_cents * qty, rates[category]))
+
+    total_gross = sum(gross for _, gross, _ in validated_lines)
+    coupon = min(coupon_cents, total_gross)
+    discounts = [0] * len(validated_lines)
+    if total_gross:
+        remainders = []
+        for index, (_, gross, _) in enumerate(validated_lines):
+            discounts[index], remainder = divmod(coupon * gross, total_gross)
+            remainders.append((remainder, index))
+
+        leftover = coupon - sum(discounts)
+        for _, index in sorted(remainders, key=lambda item: (-item[0], item[1]))[:leftover]:
+            discounts[index] += 1
+
+    invoice_lines = []
+    taxable_shipping = False
+    for (sku, gross, rate), discount in zip(validated_lines, discounts):
+        net = gross - discount
+        invoice_lines.append({
+            "sku": sku,
+            "gross_cents": gross,
+            "discount_cents": discount,
+            "net_cents": net,
+            "tax_cents": percent_of(net, rate),
+        })
+        taxable_shipping = taxable_shipping or rate > 0
+
+    shipping_tax = percent_of(shipping_cents, rates["standard"]) if taxable_shipping else 0
+    total = (
+        sum(line["net_cents"] + line["tax_cents"] for line in invoice_lines)
+        + shipping_cents
+        + shipping_tax
+    )
+    return {
+        "lines": invoice_lines,
+        "shipping_cents": shipping_cents,
+        "shipping_tax_cents": shipping_tax,
+        "total_cents": total,
+    }
diff --git a/tests/test_invoice.py b/tests/test_invoice.py
new file mode 100644
index 0000000..8fc6060
--- /dev/null
+++ b/tests/test_invoice.py
@@ -0,0 +1,73 @@
+import pytest
+
+from shoplib.errors import ShopError
+from shoplib.invoice import build_invoice
+
+
+def test_coupon_uses_largest_remainder_and_preserves_input_order():
+    invoice = build_invoice(
+        [("A", 100, 1, "books"), ("B", 100, 1, "books"), ("C", 100, 1, "books")],
+        coupon_cents=2,
+        shipping_cents=0,
+        region="OR",
+    )
+
+    assert [line["discount_cents"] for line in invoice["lines"]] == [1, 1, 0]
+    assert [line["sku"] for line in invoice["lines"]] == ["A", "B", "C"]
+    assert invoice["total_cents"] == 298
+
+
+def test_coupon_is_capped_at_gross_and_zero_gross_has_no_discount():
+    invoice = build_invoice(
+        [("A", 0, 2, "food"), ("B", 100, 1, "books")],
+        coupon_cents=500,
+        shipping_cents=0,
+        region="OR",
+    )
+
+    assert [line["discount_cents"] for line in invoice["lines"]] == [0, 100]
+    assert [line["net_cents"] for line in invoice["lines"]] == [0, 0]
+    assert invoice["total_cents"] == 0
+
+
+def test_tax_is_rounded_per_line_and_shipping_uses_standard_rate():
+    invoice = build_invoice(
+        [("A", 7, 1, "books"), ("B", 7, 1, "books")],
+        coupon_cents=0,
+        shipping_cents=100,
+        region="DE",
+    )
+
+    assert [line["tax_cents"] for line in invoice["lines"]] == [0, 0]
+    assert invoice["shipping_tax_cents"] == 19
+    assert invoice["total_cents"] == 133
+
+
+def test_shipping_is_not_taxed_when_all_line_rates_are_zero():
+    invoice = build_invoice(
+        [("A", 100, 1, "books")],
+        coupon_cents=0,
+        shipping_cents=100,
+        region="SG",
+    )
+
+    assert invoice["shipping_tax_cents"] == 0
+    assert invoice["total_cents"] == 200
+
+
+@pytest.mark.parametrize(
+    ("lines", "coupon", "shipping", "region"),
+    [
+        ([("A", 100, 1, "books")], 0, 0, "XX"),
+        ([("A", 100, 1, "unknown")], 0, 0, "DE"),
+        ([], 0, 0, "DE"),
+        ([("A", 100, 0, "books")], 0, 0, "DE"),
+        ([("A", -1, 1, "books")], 0, 0, "DE"),
+        ([("A", 100, 1, "books")], -1, 0, "DE"),
+        ([("A", 100, 1, "books")], 0, -1, "DE"),
+        ([("A", 100, 1, [])], 0, 0, "DE"),
+    ],
+)
+def test_invalid_invoice_arguments_raise_shop_error(lines, coupon, shipping, region):
+    with pytest.raises(ShopError):
+        build_invoice(lines, coupon, shipping, region)
