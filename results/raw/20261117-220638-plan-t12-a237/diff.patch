@@ -0,0 +1,76 @@
+import pytest
+
+from shoplib.errors import ShopError
+from shoplib.search import Product, search
+
+
+@pytest.fixture
+def products():
+    return [
+        Product("MUG-1", "Blue Mug Large", 1000, ["Sale", "Kitchen"]),
+        Product("mug-2", "Small blue mug", 500, ["kitchenware"]),
+        Product("CUP*3", "Red cup", 1000, ["limited*edition"]),
+        Product("OTHER", "Blue: mug - special", 1500, []),
+    ]
+
+
+@pytest.mark.parametrize("query", ["", " \t\n "])
+def test_empty_query_returns_every_product_in_order(products, query):
+    assert search(products, query) == products
+
+
+@pytest.mark.parametrize(
+    ("query", "indices"),
+    [
+        ("BLUE mug", [0, 1, 3]),
+        ('"blue mug"', [0, 1]),
+        ('name:"BLUE MUG"', [0, 1]),
+        ('"blue: mug"', [3]),
+        ('name:"blue: mug"', [3]),
+        ('"- special"', [3]),
+        ("sku:mUg-1", [0]),
+        ("sku:mug", []),
+        ("sku:mug-*", [0, 1]),
+        ("sku:cup*3", [2]),
+        ("tag:KITCHEN", [0]),
+        ("tag:kitchen*", [0, 1]),
+        ("tag:limited*edition", [2]),
+        ("name:blue*", []),
+        ("-tag:sale", [1, 2, 3]),
+        ('-name:"blue mug"', [2, 3]),
+        ("blue -tag:sale price<1500", [1]),
+        ("price<1000", [1]),
+        ("price<=1000", [0, 1, 2]),
+        ("price>1000", [3]),
+        ("price>=1000", [0, 2, 3]),
+        ("price=1000", [0, 2]),
+        ("-price=1000", [1, 3]),
+        ("price=01000", [0, 2]),
+    ],
+)
+def test_query_matching(products, query, indices):
+    assert search(products, query) == [products[index] for index in indices]
+
+
+@pytest.mark.parametrize(
+    "query",
+    [
+        "unknown:value", "price:5", ":value", "SKU:value",
+        "sku:", "name:", "tag:", 'tag:""',
+        "-", '-""', '"unclosed', 'name:"unclosed',
+        "price=", "price<1.5", "price>=-1", "price=+1", "price>abc",
+        "price==100", 'price>="1\n2"',
+    ],
+)
+def test_invalid_query_raises_shop_error_even_without_products(query):
+    with pytest.raises(ShopError):
+        search([], query)
+
+
+def test_all_terms_are_validated_even_when_an_earlier_term_does_not_match(products):
+    with pytest.raises(ShopError):
+        search(products, "no-match tag:")
+
+
+def test_very_large_whole_number_is_a_valid_price(products):
+    assert search(products, "price<" + "9" * 5000) == products
