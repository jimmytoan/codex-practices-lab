@@ -0,0 +1,85 @@
+import pytest
+
+from shoplib.errors import ShopError
+from shoplib.search import Product, search
+
+
+@pytest.fixture
+def products():
+    return [
+        Product("MUG-01", "Blue Ceramic Mug", 1250, ["kitchen", "sale"]),
+        Product("MUG-02", "Blue Travel Cup", 999, ["travel"]),
+        Product("PLATE-1", "White Dinner Plate", 1500, ["kitchen"]),
+    ]
+
+
+def test_empty_query_and_bare_terms_match_in_input_order(products):
+    assert search(products, " \t\n") == products
+    assert search(products, "BLUE mug") == [products[0]]
+
+
+def test_quotes_group_bare_and_field_values(products):
+    assert search(products, '"blue ceramic"') == [products[0]]
+    assert search(products, 'name:"blue travel"') == [products[1]]
+    assert search(products, '"blue mug"') == []
+
+
+def test_fields_are_case_insensitive_and_have_the_specified_match_rules(products):
+    assert search(products, "SKU:mug-01") == [products[0]]
+    assert search(products, "name:ceramic") == [products[0]]
+    assert search(products, "tag:KITCHEN") == [products[0], products[2]]
+
+
+def test_sku_and_tag_trailing_star_are_prefix_matches(products):
+    assert search(products, "sku:MUG-*") == products[:2]
+    assert search(products, "tag:kit*") == [products[0], products[2]]
+    assert search(products, "sku:M*G-01") == []
+    assert search(products, "tag:sal*e") == []
+
+
+def test_negation_applies_to_each_term(products):
+    assert search(products, "-tag:sale") == products[1:]
+    assert search(products, '-name:"blue mug"') == products
+    assert search(products, "blue -tag:travel") == [products[0]]
+
+
+@pytest.mark.parametrize(
+    ("query", "expected"),
+    [
+        ("price<1000", ["MUG-02"]),
+        ("price<=999", ["MUG-02"]),
+        ("price>1250", ["PLATE-1"]),
+        ("price>=1250", ["MUG-01", "PLATE-1"]),
+        ("price=1500", ["PLATE-1"]),
+        ("-price>=1250", ["MUG-02"]),
+    ],
+)
+def test_price_comparisons_use_whole_cents(products, query, expected):
+    assert [product.sku for product in search(products, query)] == expected
+
+
+@pytest.mark.parametrize(
+    "query",
+    [
+        "other:value",
+        "price:5",
+        ":value",
+        "tag:",
+        'name:""',
+        "-",
+        '"never closes',
+        "price>",
+        "price>=1.5",
+        "price=abc",
+        "price<=-1",
+        "price>12c",
+    ],
+)
+def test_invalid_query_syntax_raises_value_error(products, query):
+    with pytest.raises(ValueError):
+        search(products, query)
+
+
+def test_validation_happens_even_when_no_products_are_supplied():
+    with pytest.raises(ShopError):
+        search([], "tag:")
