@@ -13,4 +16,97 @@ class Product:
 
 def search(products: list[Product], query: str) -> list[Product]:
     """The products that match `query`, in their input order. See docs/search.md."""
-    raise NotImplementedError
+    terms = _parse_query(query)
+    return [product for product in products if all(_matches(product, term) for term in terms)]
+
+
+def _tokens(query: str) -> list[str]:
+    """Split on whitespace outside quotes and remove the quote characters."""
+    tokens: list[str] = []
+    token: list[str] = []
+    quoted = False
+    started = False
+
+    for char in query:
+        if char == '"':
+            quoted = not quoted
+            started = True
+        elif char.isspace() and not quoted:
+            if started:
+                tokens.append("".join(token))
+                token = []
+                started = False
+        else:
+            token.append(char)
+            started = True
+
+    if quoted:
+        raise ShopError("unclosed quote")
+    if started:
+        tokens.append("".join(token))
+    return tokens
+
+
+def _parse_query(query: str) -> list[tuple[str, str, bool]]:
+    """Return (kind, value, negated) conditions, validating query syntax."""
+    terms: list[tuple[str, str, bool]] = []
+    for token in _tokens(query):
+        negated = token.startswith("-")
+        if negated:
+            token = token[1:]
+            if not token:
+                raise ShopError("'-' must be followed by a term")
+
+        price_match = re.fullmatch(r"price(<=|>=|<|>|=)(.*)", token, re.IGNORECASE)
+        if price_match:
+            operator, value = price_match.groups()
+            if not value.isascii() or not value.isdigit():
+                raise ShopError("price comparison must use a whole number of cents")
+            terms.append(("price" + operator, value, negated))
+            continue
+
+        if ":" in token:
+            field_name, value = token.split(":", 1)
+            field_name = field_name.casefold()
+            if field_name not in {"sku", "name", "tag"}:
+                raise ShopError(f"unknown search field: {field_name}")
+            if not value:
+                raise ShopError("field value cannot be empty")
+            terms.append((field_name, value, negated))
+        else:
+            terms.append(("word", token, negated))
+    return terms
+
+
+def _matches(product: Product, term: tuple[str, str, bool]) -> bool:
+    kind, value, negated = term
+    folded_value = value.casefold()
+
+    if kind == "word":
+        matched = folded_value in product.name.casefold()
+    elif kind == "name":
+        matched = folded_value in product.name.casefold()
+    elif kind == "sku":
+        sku = product.sku.casefold()
+        if value.endswith("*"):
+            matched = sku.startswith(value[:-1].casefold())
+        else:
+            matched = sku == folded_value
+    elif kind == "tag":
+        if value.endswith("*"):
+            prefix = value[:-1].casefold()
+            matched = any(tag.casefold().startswith(prefix) for tag in product.tags)
+        else:
+            matched = any(tag.casefold() == folded_value for tag in product.tags)
+    else:
+        amount = int(value)
+        operators = {
+            "price<": product.price_cents < amount,
+            "price<=": product.price_cents <= amount,
+            "price>": product.price_cents > amount,
+            "price>=": product.price_cents >= amount,
+            "price=": product.price_cents == amount,
+        }
+        matched = operators[kind]
+
+    return not matched if negated else matched
