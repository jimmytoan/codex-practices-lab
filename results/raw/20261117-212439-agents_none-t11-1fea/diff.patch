diff --git a/src/shoplib/invoice.py b/src/shoplib/invoice.py
index 5d1398c..77edd0d 100644
--- a/src/shoplib/invoice.py
+++ b/src/shoplib/invoice.py
@@ -1,5 +1,7 @@
 """Invoices: coupon allocation and tax. See docs/invoicing.md."""
 
+from .money import percent_of
+
 # Tax rates in percent, by region and product category.
 TAX_RATES = {
     "DE": {"standard": 19, "food": 7, "books": 7},
@@ -10,4 +12,53 @@ TAX_RATES = {
 
 def build_invoice(lines, coupon_cents: int, shipping_cents: int, region: str) -> dict:
     """Build an invoice for an order. See docs/invoicing.md."""
-    raise NotImplementedError
+    if region not in TAX_RATES:
+        raise ValueError("unknown region")
+    if not lines:
+        raise ValueError("lines must not be empty")
+    if coupon_cents < 0 or shipping_cents < 0:
+        raise ValueError("coupon and shipping must not be negative")
+
+    rates = TAX_RATES[region]
+    gross_amounts = []
+    for _, price, qty, category in lines:
+        if category not in rates:
+            raise ValueError("unknown category")
+        if price < 0 or qty < 1:
+            raise ValueError("invalid price or quantity")
+        gross_amounts.append(price * qty)
+
+    total_gross = sum(gross_amounts)
+    coupon = min(coupon_cents, total_gross)
+    discounts = [0] * len(lines)
+    if total_gross:
+        allocations = [divmod(coupon * gross, total_gross) for gross in gross_amounts]
+        discounts = [amount for amount, _ in allocations]
+        remaining = coupon - sum(discounts)
+        order = sorted(range(len(lines)), key=lambda i: (-allocations[i][1], i))
+        for i in order[:remaining]:
+            discounts[i] += 1
+
+    invoice_lines = []
+    for (sku, _, _, category), gross, discount in zip(lines, gross_amounts, discounts):
+        net = gross - discount
+        invoice_lines.append({
+            "sku": sku,
+            "gross_cents": gross,
+            "discount_cents": discount,
+            "net_cents": net,
+            "tax_cents": percent_of(net, rates[category]),
+        })
+
+    shipping_tax = (
+        percent_of(shipping_cents, rates["standard"])
+        if any(rates[category] > 0 for _, _, _, category in lines)
+        else 0
+    )
+    total = sum(line["net_cents"] + line["tax_cents"] for line in invoice_lines)
+    return {
+        "lines": invoice_lines,
+        "shipping_cents": shipping_cents,
+        "shipping_tax_cents": shipping_tax,
+        "total_cents": total + shipping_cents + shipping_tax,
+    }
diff --git a/tests/test_invoice.py b/tests/test_invoice.py
new file mode 100644
index 0000000..74b3224
--- /dev/null
+++ b/tests/test_invoice.py
@@ -0,0 +1,78 @@
+import pytest
+
+from shoplib.invoice import build_invoice
+
+
+def test_proportional_coupon_tax_and_total():
+    lines = [("a", 100, 3, "standard"), ("b", 200, 1, "food"),
+             ("c", 100, 1, "books")]
+    assert build_invoice(lines, 101, 50, "DE") == {
+        "lines": [
+            {"sku": "a", "gross_cents": 300, "discount_cents": 50,
+             "net_cents": 250, "tax_cents": 48},
+            {"sku": "b", "gross_cents": 200, "discount_cents": 34,
+             "net_cents": 166, "tax_cents": 12},
+            {"sku": "c", "gross_cents": 100, "discount_cents": 17,
+             "net_cents": 83, "tax_cents": 6},
+        ],
+        "shipping_cents": 50,
+        "shipping_tax_cents": 10,
+        "total_cents": 625,
+    }
+    assert lines == [("a", 100, 3, "standard"), ("b", 200, 1, "food"),
+                     ("c", 100, 1, "books")]
+
+
+def test_equal_remainders_favor_earlier_lines():
+    invoice = build_invoice([(str(i), 1, 1, "books") for i in range(3)], 2, 0, "SG")
+    assert [line["discount_cents"] for line in invoice["lines"]] == [1, 1, 0]
+    assert invoice["total_cents"] == 1
+
+
+def test_coupon_is_capped_and_shipping_tax_depends_on_category():
+    invoice = build_invoice([("a", 10, 1, "standard"), ("b", 20, 1, "books")],
+                            100, 100, "SG")
+    assert [line["discount_cents"] for line in invoice["lines"]] == [10, 20]
+    assert [line["net_cents"] for line in invoice["lines"]] == [0, 0]
+    assert invoice["shipping_tax_cents"] == 9
+    assert invoice["total_cents"] == 109
+
+
+def test_zero_gross_still_uses_categories_for_shipping_tax():
+    invoice = build_invoice([("a", 0, 2, "standard"), ("b", 0, 1, "books")],
+                            100, 100, "SG")
+    assert [line["discount_cents"] for line in invoice["lines"]] == [0, 0]
+    assert invoice["shipping_tax_cents"] == 9
+    assert invoice["total_cents"] == 109
+
+
+@pytest.mark.parametrize("region, category", [("SG", "books"), ("OR", "standard")])
+def test_shipping_is_untaxed_when_no_category_is_taxable(region, category):
+    invoice = build_invoice([("a", 100, 1, category)], 0, 100, region)
+    assert invoice["shipping_tax_cents"] == 0
+    assert invoice["total_cents"] == 200
+
+
+def test_tax_is_rounded_half_up_per_line_and_on_shipping():
+    invoice = build_invoice([("a", 50, 1, "standard"), ("b", 50, 1, "standard")],
+                            0, 50, "SG")
+    assert [line["tax_cents"] for line in invoice["lines"]] == [5, 5]
+    assert invoice["shipping_tax_cents"] == 5
+    assert invoice["total_cents"] == 165
+
+
+@pytest.mark.parametrize("lines, coupon, shipping, region", [
+    ([("a", 1, 1, "standard")], 0, 0, "unknown"),
+    ([("a", 1, 1, "unknown")], 0, 0, "SG"),
+    ([], 0, 0, "SG"),
+    ([("a", 1, 0, "standard")], 0, 0, "SG"),
+    ([("a", 1, -1, "standard")], 0, 0, "SG"),
+    ([("a", -1, 1, "standard")], 0, 0, "SG"),
+    ([("a", 1, 1, "standard")], -1, 0, "SG"),
+    ([("a", 1, 1, "standard")], 0, -1, "SG"),
+])
+def test_invalid_arguments_raise_value_error(lines, coupon, shipping, region):
+    original = lines.copy()
+    with pytest.raises(ValueError):
+        build_invoice(lines, coupon, shipping, region)
+    assert lines == original
