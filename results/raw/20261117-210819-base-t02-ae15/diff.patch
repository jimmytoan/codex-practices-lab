diff --git a/tests/test_cart.py b/tests/test_cart.py
index 1a3d0e7..f2740ee 100644
--- a/tests/test_cart.py
+++ b/tests/test_cart.py
@@ -1,6 +1,7 @@
 import pytest
 
 from shoplib.cart import Cart
+from shoplib.errors import ShopError
 
 
 def test_add_and_subtotal():
@@ -19,5 +20,36 @@ def test_add_same_sku_merges():
 
 
 def test_bad_qty():
-    with pytest.raises(ValueError):
+    with pytest.raises(ShopError):
         Cart().add("A", 250, 0)
+
+
+def test_bulk_discount_threshold_and_rounding():
+    cart = Cart()
+    cart.add("under", 1, 9)
+    cart.add("threshold", 1, 10)
+    cart.add("above", 10, 11)
+
+    assert cart.line_total("under") == 9
+    assert cart.line_total("threshold") == 9  # 0.5 cent discount rounds up
+    assert cart.line_total("above") == 104  # 5.5 cent discount rounds up
+    assert cart.subtotal() == 122
+
+
+def test_merged_quantity_qualifies_for_discount():
+    cart = Cart()
+    cart.add("A", 250, 9)
+    assert cart.subtotal() == 2250
+    cart.add("A", 250)
+    assert cart.line_total("A") == 2375
+    assert cart.subtotal() == 2375
+
+
+def test_cart_invalid_operations_raise_shop_error():
+    cart = Cart()
+    with pytest.raises(ShopError):
+        cart.add("A", -1)
+    with pytest.raises(ShopError):
+        cart.remove("missing")
+    with pytest.raises(ShopError):
+        cart.line_total("missing")
