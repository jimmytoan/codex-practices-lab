diff --git a/src/shoplib/costing.py b/src/shoplib/costing.py
index 5e8c27e..0a57746 100644
--- a/src/shoplib/costing.py
+++ b/src/shoplib/costing.py
@@ -1,6 +1,104 @@
 """Cost of goods sold with FIFO lots. See docs/costing.md."""
 
+from collections import deque
+from decimal import Decimal, localcontext
+
+from shoplib.errors import ShopError
+from shoplib.money import round_cents
+
+
+def _positive_quantity(value: object) -> int:
+    if type(value) is not int or value < 1:
+        raise ShopError("quantity must be a positive integer")
+    return value
+
+
+def _unit_cost(value: object) -> int:
+    if type(value) is not int or value < 0:
+        raise ShopError("unit cost must be a non-negative integer number of cents")
+    return value
+
 
 def fifo_costing(events: list[dict]) -> dict:
     """Process stock events and report cost per SKU. See docs/costing.md."""
-    raise NotImplementedError
+    inventory: dict[object, dict] = {}
+
+    for event in events:
+        if not isinstance(event, dict):
+            raise ShopError("each event must be a dictionary")
+
+        event_type = event.get("type")
+        if event_type not in ("receive", "sell", "return"):
+            raise ShopError("unknown event type")
+
+        try:
+            sku = event["sku"]
+            hash(sku)
+        except (KeyError, TypeError):
+            raise ShopError("event must have a hashable SKU") from None
+
+        if sku not in inventory:
+            inventory[sku] = {
+                "lots": deque(),
+                "on_hand": 0,
+                "cogs_cents": 0,
+                "last_sale": None,
+            }
+        state = inventory[sku]
+
+        qty = _positive_quantity(event.get("qty"))
+
+        if event_type == "receive":
+            unit_cost_cents = _unit_cost(event.get("unit_cost_cents"))
+            state["lots"].append([qty, unit_cost_cents])
+            state["on_hand"] += qty
+            continue
+
+        if event_type == "sell":
+            if qty > state["on_hand"]:
+                raise ShopError("cannot sell more units than are on hand")
+
+            sale_cost = 0
+            units_to_sell = qty
+            while units_to_sell:
+                lot_qty, unit_cost_cents = state["lots"][0]
+                units_from_lot = min(units_to_sell, lot_qty)
+                sale_cost += units_from_lot * unit_cost_cents
+                units_to_sell -= units_from_lot
+                lot_qty -= units_from_lot
+                if lot_qty:
+                    state["lots"][0][0] = lot_qty
+                else:
+                    state["lots"].popleft()
+
+            state["on_hand"] -= qty
+            state["cogs_cents"] += sale_cost
+            with localcontext() as context:
+                context.prec = max(28, len(str(sale_cost)) + len(str(qty)) + 10)
+                average_unit_cost = round_cents(Decimal(sale_cost) / qty)
+            state["last_sale"] = {
+                "returnable_qty": qty,
+                "unit_cost_cents": average_unit_cost,
+            }
+            continue
+
+        last_sale = state["last_sale"]
+        if last_sale is None:
+            raise ShopError("cannot return units when the SKU has had no sale")
+        if qty > last_sale["returnable_qty"]:
+            raise ShopError("return exceeds the most recent sale's returnable quantity")
+
+        last_sale["returnable_qty"] -= qty
+        return_unit_cost = last_sale["unit_cost_cents"]
+        state["lots"].append([qty, return_unit_cost])
+        state["on_hand"] += qty
+        state["cogs_cents"] -= qty * return_unit_cost
+
+    return {
+        sku: {
+            "cogs_cents": state["cogs_cents"],
+            "on_hand": state["on_hand"],
+            "value_cents": sum(qty * cost for qty, cost in state["lots"]),
+        }
+        for sku, state in inventory.items()
+    }
diff --git a/tests/test_costing.py b/tests/test_costing.py
new file mode 100644
index 0000000..d516ac6
--- /dev/null
+++ b/tests/test_costing.py
@@ -0,0 +1,104 @@
+import copy
+
+import pytest
+
+from shoplib.costing import fifo_costing
+
+
+def test_receipts_and_sales_use_fifo_lot_costs():
+    events = [
+        {"type": "receive", "sku": "A", "qty": 2, "unit_cost_cents": 100},
+        {"type": "receive", "sku": "A", "qty": 2, "unit_cost_cents": 250},
+        {"type": "sell", "sku": "A", "qty": 3},
+    ]
+
+    assert fifo_costing(events) == {
+        "A": {"cogs_cents": 450, "on_hand": 1, "value_cents": 250}
+    }
+
+
+def test_return_uses_rounded_average_sale_cost_and_reduces_cogs():
+    events = [
+        {"type": "receive", "sku": "A", "qty": 1, "unit_cost_cents": 0},
+        {"type": "receive", "sku": "A", "qty": 1, "unit_cost_cents": 1},
+        {"type": "sell", "sku": "A", "qty": 2},
+        {"type": "return", "sku": "A", "qty": 1},
+    ]
+
+    assert fifo_costing(events) == {
+        "A": {"cogs_cents": 0, "on_hand": 1, "value_cents": 1}
+    }
+
+
+def test_returned_lot_goes_after_existing_lots():
+    events = [
+        {"type": "receive", "sku": "A", "qty": 2, "unit_cost_cents": 100},
+        {"type": "sell", "sku": "A", "qty": 2},
+        {"type": "receive", "sku": "A", "qty": 1, "unit_cost_cents": 300},
+        {"type": "return", "sku": "A", "qty": 1},
+        {"type": "sell", "sku": "A", "qty": 1},
+    ]
+
+    assert fifo_costing(events) == {
+        "A": {"cogs_cents": 400, "on_hand": 1, "value_cents": 100}
+    }
+
+
+def test_multiple_returns_can_be_made_against_the_same_sale():
+    events = [
+        {"type": "receive", "sku": "A", "qty": 4, "unit_cost_cents": 10},
+        {"type": "sell", "sku": "A", "qty": 2},
+        {"type": "sell", "sku": "A", "qty": 2},
+        {"type": "return", "sku": "A", "qty": 1},
+        {"type": "return", "sku": "A", "qty": 1},
+    ]
+
+    assert fifo_costing(events) == {
+        "A": {"cogs_cents": 20, "on_hand": 2, "value_cents": 20}
+    }
+
+
+def test_only_the_most_recent_sale_is_returnable():
+    events = [
+        {"type": "receive", "sku": "A", "qty": 4, "unit_cost_cents": 10},
+        {"type": "sell", "sku": "A", "qty": 2},
+        {"type": "sell", "sku": "A", "qty": 1},
+        {"type": "return", "sku": "A", "qty": 2},
+    ]
+
+    with pytest.raises(ValueError):
+        fifo_costing(events)
+
+
+@pytest.mark.parametrize(
+    "events",
+    [
+        [{"type": "receive", "sku": "A", "qty": 0, "unit_cost_cents": 1}],
+        [{"type": "receive", "sku": "A", "qty": -1, "unit_cost_cents": 1}],
+        [{"type": "receive", "sku": "A", "qty": 1, "unit_cost_cents": -1}],
+        [{"type": "sell", "sku": "A", "qty": 1}],
+        [{"type": "return", "sku": "A", "qty": 1}],
+        [
+            {"type": "receive", "sku": "A", "qty": 1, "unit_cost_cents": 10},
+            {"type": "sell", "sku": "A", "qty": 1},
+            {"type": "return", "sku": "A", "qty": 2},
+        ],
+        [{"type": "adjust", "sku": "A", "qty": 1}],
+    ],
+)
+def test_invalid_events_raise_value_error(events):
+    with pytest.raises(ValueError):
+        fifo_costing(events)
+
+
+def test_events_are_not_modified():
+    events = [
+        {"type": "receive", "sku": "A", "qty": 2, "unit_cost_cents": 75},
+        {"type": "sell", "sku": "A", "qty": 1},
+        {"type": "return", "sku": "A", "qty": 1},
+    ]
+    original = copy.deepcopy(events)
+
+    fifo_costing(events)
+
+    assert events == original
