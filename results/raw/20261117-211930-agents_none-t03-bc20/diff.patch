diff --git a/tests/test_inventory.py b/tests/test_inventory.py
index 37436c0..01de141 100644
--- a/tests/test_inventory.py
+++ b/tests/test_inventory.py
@@ -18,3 +18,33 @@ def test_cannot_reserve_more_than_available():
     inv.receive("A", 2)
     with pytest.raises(ValueError):
         inv.reserve("A", 3)
+
+
+@pytest.mark.parametrize("qty", [2, 4])
+def test_release_returns_reserved_stock_to_available(qty):
+    inv = Inventory()
+    inv.receive("A", 10)
+    inv.reserve("A", 4)
+    inv.receive("B", 3)
+    inv.reserve("B", 1)
+
+    inv.release("A", qty)
+
+    assert inv.on_hand("A") == 10
+    assert inv.reserved("A") == 4 - qty
+    assert inv.available("A") == 6 + qty
+    assert (inv.on_hand("B"), inv.reserved("B"), inv.available("B")) == (3, 1, 2)
+
+
+@pytest.mark.parametrize("sku, qty", [("A", 0), ("A", -1), ("A", 5), ("B", 1), ("missing", 1)])
+def test_invalid_release_changes_nothing(sku, qty):
+    inv = Inventory()
+    inv.receive("A", 10)
+    inv.reserve("A", 4)
+    inv.receive("B", 3)
+    before = (inv._on_hand.copy(), inv._reserved.copy())
+
+    with pytest.raises(ValueError):
+        inv.release(sku, qty)
+
+    assert (inv._on_hand, inv._reserved) == before
