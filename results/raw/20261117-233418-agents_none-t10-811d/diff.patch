 """Shipping costs and parcel splitting. See docs/shipping.md."""
 
+from typing import cast
+
 # (upper bound in grams, cost in cents)
 TIERS = [(1000, 500), (2000, 800), (5000, 1200), (20000, 2500)]
 
@@ -16,9 +18,45 @@ def shipping_cost(weight_g: int) -> int:
 
 def split_parcels(items: list[tuple[str, int, int]], max_weight_g: int) -> list[list[str]]:
     """Split order items into parcels. See docs/shipping.md."""
-    raise NotImplementedError
+    units = []
+    for sku, weight, qty in items:
+        if weight < 1 or qty < 1 or weight > max_weight_g:
+            raise ValueError("invalid item weight or quantity")
+        units.extend((sku, weight) for _ in range(qty))
+
+    units.sort(key=lambda unit: (-unit[1], unit[0]))
+    parcels: list[list[str]] = []
+    weights: list[int] = []
+    for sku, weight in units:
+        for index, parcel_weight in enumerate(weights):
+            if parcel_weight + weight <= max_weight_g:
+                parcels[index].append(sku)
+                weights[index] += weight
+                break
+        else:
+            parcels.append([sku])
+            weights.append(weight)
+    return parcels
+
+
+class _WeightedSKU(str):
+    """A SKU carrying its unit weight while preserving string ordering."""
+
+    def __new__(cls, sku: str, weight_g: int):
+        instance = super().__new__(cls, sku)
+        instance.weight_g = weight_g
+        return instance
 
 
 def shipment_cost(items: list[tuple[str, int, int]], max_weight_g: int) -> int:
     """Total shipping cost of an order. See docs/shipping.md."""
-    raise NotImplementedError
+    # Keep each unit's weight attached to its SKU, including when the same SKU
+    # appears in multiple item rows with different weights.
+    weighted_items: list[tuple[str, int, int]] = [
+        (_WeightedSKU(sku, weight), weight, qty) for sku, weight, qty in items
+    ]
+    parcels = split_parcels(weighted_items, max_weight_g)
+    return sum(
+        shipping_cost(sum(cast(_WeightedSKU, sku).weight_g for sku in parcel))
+        for parcel in parcels
+    )
