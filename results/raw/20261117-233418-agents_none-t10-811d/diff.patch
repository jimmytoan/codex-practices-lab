+def test_split_parcels_first_fit_decreasing_and_sku_tiebreak():
+    items = [("z", 4, 1), ("b", 6, 1), ("a", 6, 1), ("c", 4, 2), ("d", 2, 1)]
+    assert split_parcels(items, 10) == [["a", "c"], ["b", "c"], ["z", "d"]]
+
+
+def test_split_parcels_fills_first_available_parcel():
+    assert split_parcels([("a", 8, 1), ("b", 7, 1), ("c", 2, 1), ("d", 1, 1)], 10) == [
+        ["a", "c"], ["b", "d"]
+    ]
+
+
+@pytest.mark.parametrize("items, limit", [
+    ([("x", 0, 1)], 10),
+    ([("x", -1, 1)], 10),
+    ([("x", 1, 0)], 10),
+    ([("x", 1, -1)], 10),
+    ([("x", 11, 1)], 10),
+    ([("x", 1, 1)], 0),
+])
+def test_invalid_items(items, limit):
+    with pytest.raises(ValueError):
+        split_parcels(items, limit)
+    with pytest.raises(ValueError):
+        shipment_cost(items, limit)
+
+
+def test_empty_order():
+    assert split_parcels([], 0) == []
+    assert shipment_cost([], 0) == 0
+
+
+def test_shipment_cost_uses_parcel_weights_with_repeated_skus():
+    items = [("a", 1800, 1), ("z", 1500, 1), ("z", 200, 1)]
+    assert split_parcels(items, 2000) == [["a", "z"], ["z"]]
+    assert shipment_cost(items, 2000) == shipping_cost(2000) + shipping_cost(1500)
+
