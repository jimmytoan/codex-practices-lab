diff --git a/src/shoplib/dates.py b/src/shoplib/dates.py
index afe6759..f12bc9c 100644
--- a/src/shoplib/dates.py
+++ b/src/shoplib/dates.py
@@ -20,10 +20,17 @@ def add_business_days(start: date, n: int, holidays=()) -> date:
 
     `start` does not have to be a business day.
     """
-    # TODO: holidays and negative n are not handled yet
+    holidays = set(holidays)
     day = start
-    while n > 0:
-        day += timedelta(days=1)
-        if day.weekday() < 5:
-            n -= 1
+    if n == 0:
+        while not is_business_day(day, holidays):
+            day += timedelta(days=1)
+        return day
+
+    direction = 1 if n > 0 else -1
+    remaining = abs(n)
+    while remaining:
+        day += timedelta(days=direction)
+        if is_business_day(day, holidays):
+            remaining -= 1
     return day
diff --git a/tests/test_dates.py b/tests/test_dates.py
index fbfd5f2..63a9348 100644
--- a/tests/test_dates.py
+++ b/tests/test_dates.py
@@ -12,3 +12,27 @@ def test_forward_over_weekend():
     # Friday + 1 business day = Monday
     assert add_business_days(date(2026, 11, 13), 1) == date(2026, 11, 16)
     assert add_business_days(date(2026, 11, 16), 3) == date(2026, 11, 19)
+
+
+def test_forward_skips_holidays_and_start():
+    holidays = (date(2026, 11, 16), date(2026, 11, 17))
+    assert add_business_days(date(2026, 11, 13), 1, holidays) == date(2026, 11, 18)
+    assert add_business_days(date(2026, 11, 16), 1, holidays) == date(2026, 11, 18)
+
+
+def test_backward_skips_weekends_and_holidays():
+    holidays = (date(2026, 11, 13), date(2026, 11, 12))
+    assert add_business_days(date(2026, 11, 16), -1, holidays) == date(2026, 11, 11)
+    assert add_business_days(date(2026, 11, 15), -2, holidays) == date(2026, 11, 10)
+
+
+def test_zero_returns_start_or_next_business_day():
+    holidays = (date(2026, 11, 16), date(2026, 11, 17))
+    assert add_business_days(date(2026, 11, 18), 0, holidays) == date(2026, 11, 18)
+    assert add_business_days(date(2026, 11, 16), 0, holidays) == date(2026, 11, 18)
+    assert add_business_days(date(2026, 11, 14), 0, holidays) == date(2026, 11, 18)
+
+
+def test_holidays_can_be_an_iterator():
+    holidays = iter([date(2026, 11, 16), date(2026, 11, 17)])
+    assert add_business_days(date(2026, 11, 13), 1, holidays) == date(2026, 11, 18)
