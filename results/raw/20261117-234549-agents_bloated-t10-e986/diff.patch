+def test_split_parcels_uses_first_parcel_with_room():
+    items = [("a", 8, 1), ("b", 7, 1), ("c", 3, 1), ("d", 2, 1)]
+    assert split_parcels(items, 10) == [["a", "d"], ["b", "c"]]
+
