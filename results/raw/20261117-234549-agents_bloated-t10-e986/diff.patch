+def test_split_parcels_first_fit_decreasing_and_unit_order():
+    items = [("z", 4, 2), ("b", 6, 1), ("a", 6, 1), ("c", 2, 2)]
+    assert split_parcels(items, 10) == [["a", "z"], ["b", "z"], ["c", "c"]]
