@@ -0,0 +1,72 @@
+import pytest
+
+from shoplib.errors import ShopError
+from shoplib.search import Product, search
+
+
+@pytest.fixture
+def products():
+    return [
+        Product("MUG-1", "Blue Mug", 1000, ["Sale", "Kitchen"]),
+        Product("MUG-2", "blue travel mug", 1500, ["kitchenware"]),
+        Product("PLATE-1", "Red Plate", 500, ["SALE"]),
+        Product("MUG-*3", "Star* Mug", 1000, ["star*tag"]),
+        Product("OTHER", "A tag:sale and price>=1000 sign", 0),
+    ]
+
+
+@pytest.mark.parametrize(
+    ("query", "indices"),
+    [
+        ("", [0, 1, 2, 3, 4]),
+        (" \t\n", [0, 1, 2, 3, 4]),
+        ("BLue", [0, 1]),
+        ('"blue mug"', [0]),
+        ('name:"BLUE MUG"', [0]),
+        ("blue mug", [0, 1]),
+        ("sku:mug-1", [0]),
+        ("tag:sale", [0, 2]),
+        ("sku:MUG-*", [0, 1, 3]),
+        ("tag:KITCHEN*", [0, 1]),
+        ("sku:MUG-*3", [3]),
+        ("tag:star*tag", [3]),
+        ("name:star*", [3]),
+        ("sku:*", [0, 1, 2, 3, 4]),
+        ("tag:*", [0, 1, 2, 3]),
+        ("price<1000", [2, 4]),
+        ("price<=1000", [0, 2, 3, 4]),
+        ("price>1000", [1]),
+        ("price>=1000", [0, 1, 3]),
+        ("price=1000", [0, 3]),
+        ("-tag:sale", [1, 3, 4]),
+        ("-price>=1000", [2, 4]),
+        ('-"blue mug"', [1, 2, 3, 4]),
+        ("mug -tag:sale price>=1000", [1, 3]),
+        ('"tag:sale"', [4]),
+        ('"price>=1000"', [4]),
+    ],
+)
+def test_matching(products, query, indices):
+    assert search(products, query) == [products[index] for index in indices]
+
+
+@pytest.mark.parametrize(
+    "query",
+    [
+        "color:blue", "price:5", "tag:", 'name:""', "sku:",
+        "-", '-""', '"unclosed', 'name:"unclosed',
+        "price<", "price<=abc", "price>1.5", "price>=-1", "price=1x",
+        "price==5", "-price>=nope", "mug tag:",
+    ],
+)
+def test_invalid_queries_raise_even_without_products(query):
+    with pytest.raises(ShopError):
+        search([], query)
+
+
+def test_large_whole_number_price(products):
+    assert search(products, "price<" + "9" * 5000) == products
+
+
+def test_empty_quoted_phrase_matches_every_name(products):
+    assert search(products, '""') == products
