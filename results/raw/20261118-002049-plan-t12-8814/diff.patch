 @dataclass
@@ -13,4 +17,87 @@ class Product:
 
 def search(products: list[Product], query: str) -> list[Product]:
     """The products that match `query`, in their input order. See docs/search.md."""
-    raise NotImplementedError
+    terms = [_parse_term(token) for token in _tokenize(query)]
+    return [product for product in products if all(_matches(product, term) for term in terms)]
+
+
+def _tokenize(query: str) -> list[list[tuple[str, bool]]]:
+    """Keep track of quoted characters so quoted terms remain literal."""
+    tokens = []
+    token = []
+    quoted = False
+    started = False
+    for char in query:
+        if char == '"':
+            quoted = not quoted
+            started = True
+        elif char.isspace() and not quoted:
+            if started:
+                tokens.append(token)
+                token = []
+                started = False
+        else:
+            token.append((char, quoted))
+            started = True
+    if quoted:
+        raise ShopError("unclosed quote")
+    if started:
+        tokens.append(token)
+    return tokens
+
+
+def _parse_term(token: list[tuple[str, bool]]) -> tuple:
+    negated = bool(token and token[0] == ("-", False))
+    if negated:
+        token = token[1:]
+        if not token:
+            raise ShopError("empty negated term")
+
+    value = "".join(char for char, _ in token)
+    for index, (char, quoted) in enumerate(token):
+        if char == ":" and not quoted:
+            field_name, field_value = value[:index], value[index + 1:]
+            if field_name not in {"sku", "name", "tag"}:
+                raise ShopError("unknown search field")
+            if not field_value:
+                raise ShopError("empty field value")
+            return (field_name, field_value.casefold(), negated)
+
+    comparison = re.match(r"price(<=|>=|<|>|=)", value)
+    if comparison and not any(quoted for _, quoted in token[:comparison.end()]):
+        amount = value[comparison.end():]
+        if not re.fullmatch(r"[0-9]+", amount):
+            raise ShopError("invalid price")
+        # Convert in chunks to support whole numbers of any length.
+        cents = 0
+        for start in range(0, len(amount), 9):
+            chunk = amount[start:start + 9]
+            cents = cents * (10 ** len(chunk)) + int(chunk)
+        return ("price", (_COMPARISONS[comparison.group(1)], cents), negated)
+
+    return ("name", value.casefold(), negated)
+
+
+_COMPARISONS = {
+    "<": operator.lt,
+    "<=": operator.le,
+    ">": operator.gt,
+    ">=": operator.ge,
+    "=": operator.eq,
+}
+
+
+def _matches(product: Product, term: tuple) -> bool:
+    field_name, value, negated = term
+    if field_name == "price":
+        comparison, cents = value
+        matched = comparison(product.price_cents, cents)
+    elif field_name == "name":
+        matched = value in product.name.casefold()
+    else:
+        candidates = [product.sku] if field_name == "sku" else product.tags
+        if value.endswith("*"):
+            matched = any(candidate.casefold().startswith(value[:-1]) for candidate in candidates)
+        else:
+            matched = any(candidate.casefold() == value for candidate in candidates)
+    return not matched if negated else matched
