@@ -0,0 +1,70 @@
+import pytest
+
+from shoplib.search import Product, search
+
+
+@pytest.fixture
+def products():
+    return [
+        Product("MUG-RED", "Blue Mug", 1000, ["Ceramic", "Sale"]),
+        Product("MUG-BLUE", "Blue Mug Travel", 1500, ["Travel", "sale"]),
+        Product("CUP", "Red Cup", 999, ["Kitchen"]),
+        Product("MUG*STAR", "Starred Mug", 2500, ["star*tag"]),
+    ]
+
+
+def test_empty_query_and_bare_terms_match_names_in_input_order(products):
+    assert search(products, " \t ") == products
+    assert search(products, "BLUE mug") == products[:2]
+    assert search(products, '"Blue Mug"') == products[:2]
+
+
+def test_fields_and_quoted_field_values(products):
+    assert search(products, "sku:mug-red") == products[:1]
+    assert search(products, 'name:"blue mug" tag:SALE') == products[:2]
+    assert search(products, "tag:ceramic") == products[:1]
+    assert search(products, '"sku:mug-red"') == []
+
+
+def test_sku_and_tag_prefixes_and_literal_asterisks(products):
+    assert search(products, "sku:MUG-*") == products[:2]
+    assert search(products, "tag:sal*") == products[:2]
+    assert search(products, "sku:MUG*STAR") == products[3:]
+
+
+def test_negation_applies_to_a_term(products):
+    assert search(products, "-tag:sale") == products[2:]
+    assert search(products, '-"Blue Mug"') == products[2:]
+
+
+@pytest.mark.parametrize(
+    ("comparison", "expected"),
+    [
+        ("price<1000", ["CUP"]),
+        ("price<=1000", ["MUG-RED", "CUP"]),
+        ("price>1000", ["MUG-BLUE", "MUG*STAR"]),
+        ("price>=1000", ["MUG-RED", "MUG-BLUE", "MUG*STAR"]),
+        ("price=1500", ["MUG-BLUE"]),
+    ],
+)
+def test_price_comparisons(products, comparison, expected):
+    assert [product.sku for product in search(products, comparison)] == expected
+
+
+@pytest.mark.parametrize(
+    "query",
+    [
+        "color:blue",
+        "price:5",
+        "tag:",
+        "price>=",
+        "price>=abc",
+        "price>=1.5",
+        "-",
+        '"unclosed',
+    ],
+)
+def test_invalid_queries_raise_value_error(products, query):
+    with pytest.raises(ValueError):
+        search(products, query)
+
