 """Product search. See docs/search.md."""
 
 from dataclasses import dataclass, field
+import re
+
+from shoplib.errors import ShopError
 
 
 @dataclass
@@ -11,6 +14,120 @@ class Product:
     tags: list[str] = field(default_factory=list)
 
 
+@dataclass(frozen=True)
+class _Term:
+    kind: str
+    value: str | int
+    negated: bool = False
+    operator: str | None = None
+
+
+_PRICE_COMPARISON = re.compile(r"price(<=|>=|<|>|=)(.*)")
+_FIELDS = {"sku", "name", "tag"}
+
+
+def _tokenize(query: str) -> list[str]:
+    """Split on whitespace outside quotes, retaining quotes for parsing."""
+    tokens: list[str] = []
+    current: list[str] = []
+    in_quotes = False
+
+    for character in query:
+        if character == '"':
+            in_quotes = not in_quotes
+            current.append(character)
+        elif character.isspace() and not in_quotes:
+            if current:
+                tokens.append("".join(current))
+                current = []
+        else:
+            current.append(character)
+
+    if in_quotes:
+        raise ShopError("unclosed quote")
+    if current:
+        tokens.append("".join(current))
+    return tokens
+
+
+def _first_unquoted_colon(text: str) -> int:
+    in_quotes = False
+    for index, character in enumerate(text):
+        if character == '"':
+            in_quotes = not in_quotes
+        elif character == ":" and not in_quotes:
+            return index
+    return -1
+
+
+def _without_quotes(text: str) -> str:
+    return text.replace('"', "")
+
+
+def _parse_term(token: str) -> _Term:
+    negated = token.startswith("-")
+    body = token[1:] if negated else token
+    if not body:
+        raise ShopError("- must be followed by a term")
+
+    colon = _first_unquoted_colon(body)
+    if colon >= 0:
+        kind = body[:colon]
+        if kind not in _FIELDS:
+            raise ShopError("unknown search field")
+        value = _without_quotes(body[colon + 1 :])
+        if not value:
+            raise ShopError("field value must not be empty")
+        return _Term(kind, value, negated)
+
+    # A quoted whole term is always a name phrase, even if it resembles a
+    # field or a price comparison.
+    if not body.startswith('"'):
+        comparison = _PRICE_COMPARISON.fullmatch(body)
+        if comparison:
+            operator, cents = comparison.groups()
+            if not cents.isascii() or not cents.isdigit():
+                raise ShopError("price comparison requires whole cents")
+            return _Term("price", int(cents), negated, operator)
+
+    return _Term("name", _without_quotes(body), negated)
+
+
+def _matches(term: _Term, product: Product) -> bool:
+    value = term.value
+    if term.kind == "price":
+        cents = int(value)
+        if term.operator == "<":
+            matched = product.price_cents < cents
+        elif term.operator == "<=":
+            matched = product.price_cents <= cents
+        elif term.operator == ">":
+            matched = product.price_cents > cents
+        elif term.operator == ">=":
+            matched = product.price_cents >= cents
+        else:
+            matched = product.price_cents == cents
+    elif term.kind == "sku":
+        sku = product.sku.casefold()
+        target = str(value).casefold()
+        if target.endswith("*"):
+            matched = sku.startswith(target[:-1])
+        else:
+            matched = sku == target
+    elif term.kind == "tag":
+        target = str(value).casefold()
+        if target.endswith("*"):
+            prefix = target[:-1]
+            matched = any(tag.casefold().startswith(prefix) for tag in product.tags)
+        else:
+            matched = any(tag.casefold() == target for tag in product.tags)
+    else:
+        matched = str(value).casefold() in product.name.casefold()
+
+    return not matched if term.negated else matched
+
+
 def search(products: list[Product], query: str) -> list[Product]:
     """The products that match `query`, in their input order. See docs/search.md."""
-    raise NotImplementedError
+    terms = [_parse_term(token) for token in _tokenize(query)]
+    return [product for product in products if all(_matches(term, product) for term in terms)]
