+def test_apply_coupons_selects_percent_and_includes_eligible_fixed_coupons():
+    today = date(2026, 11, 18)
+    coupons = [
+        Coupon("Z-TWENTY", "percent", 20),
+        Coupon("A-TWENTY", "percent", 20),
+        Coupon("TEN", "percent", 10),
