@@ -1,3 +1,6 @@
+import pytest
+
+from shoplib.errors import ShopError
 from shoplib.textutil import slugify, truncate
 
 
@@ -6,6 +9,19 @@ def test_slugify_basic():
     assert slugify("!!!") == "n-a"
 
 
+def test_slugify_removes_latin_accents():
+    assert slugify("Crème Brûlée") == "creme-brulee"
+
+
+def test_slugify_truncates_without_a_trailing_separator():
+    assert slugify("abcdef-ghi", max_len=7) == "abcdef"
+
+
+def test_slugify_requires_room_for_fallback():
+    with pytest.raises(ShopError):
+        slugify("!!!", max_len=2)
+
+
 def test_truncate():
     assert truncate("hello world", 8) == "hello..."
     assert truncate("short", 8) == "short"
