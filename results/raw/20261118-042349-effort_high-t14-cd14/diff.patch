@@ -1,6 +1,75 @@
 """Revenue per store day. See docs/store-days.md."""
 
+from datetime import date, datetime, timedelta, timezone
+
+from shoplib.errors import ShopError
+
+
+def _parse_timestamp(value: object) -> datetime:
+    """Parse an ISO 8601 timestamp and require an explicit time zone."""
+    if not isinstance(value, str):
+        raise ShopError("sale timestamp must be a string")
+
+    try:
+        timestamp = datetime.fromisoformat(
+            value[:-1] + "+00:00" if value.endswith("Z") else value
+        )
+    except ValueError as exc:
+        raise ShopError("sale timestamp must be ISO 8601") from exc
+
+    if timestamp.tzinfo is None or timestamp.utcoffset() is None:
+        raise ShopError("sale timestamp must include a time zone")
+    return timestamp
+
 
 def daily_revenue(sales: list[dict], utc_offset_hours: int = 8, day_starts_hour: int = 4) -> list[tuple[str, int]]:
     """Revenue per store day. See docs/store-days.md."""
-    raise NotImplementedError
+    if not isinstance(utc_offset_hours, int) or isinstance(utc_offset_hours, bool):
+        raise ShopError("UTC offset must be an integer number of hours")
+    if not isinstance(day_starts_hour, int) or isinstance(day_starts_hour, bool):
+        raise ShopError("day start must be an integer hour")
+    if not 0 <= day_starts_hour <= 23:
+        raise ShopError("day start must be between 0 and 23")
+
+    totals: dict[date, int] = {}
+    try:
+        sale_iterator = iter(sales)
+    except TypeError as exc:
+        raise ShopError("sales must be iterable") from exc
+
+    for sale in sale_iterator:
+        if not isinstance(sale, dict):
+            raise ShopError("each sale must be a mapping")
+        try:
+            timestamp = _parse_timestamp(sale["at"])
+            cents = sale["cents"]
+        except KeyError as exc:
+            raise ShopError("each sale must have 'at' and 'cents' fields") from exc
+
+        if not isinstance(cents, int) or isinstance(cents, bool):
+            raise ShopError("sale cents must be an integer")
+
+        try:
+            local_time = timestamp.astimezone(timezone.utc).replace(tzinfo=None)
+            local_time += timedelta(hours=utc_offset_hours)
+            store_day = local_time.date()
+            if local_time.hour < day_starts_hour:
+                store_day -= timedelta(days=1)
+        except (OverflowError, ValueError) as exc:
+            raise ShopError("sale timestamp is outside the supported date range") from exc
+
+        totals[store_day] = totals.get(store_day, 0) + cents
+
+    if not totals:
+        return []
+
+    first_day = min(totals)
+    last_day = max(totals)
+    result = []
+    store_day = first_day
+    while True:
+        result.append((store_day.isoformat(), totals.get(store_day, 0)))
+        if store_day == last_day:
+            break
+        store_day += timedelta(days=1)
+    return result
diff --git a/tests/test_storedays.py b/tests/test_storedays.py
new file mode 100644
index 0000000..79a5394
--- /dev/null
+++ b/tests/test_storedays.py
@@ -0,0 +1,39 @@
+import pytest
+
+from shoplib.storedays import daily_revenue
+
+
+def test_daily_revenue_uses_store_day_boundary_and_fills_gaps():
+    sales = [
+        {"at": "2026-11-18T02:30:00+08:00", "cents": 1200},
+        {"at": "2026-11-17T20:00:00Z", "cents": 300},
+        {"at": "2026-11-20T04:00:00+08:00", "cents": -50},
+    ]
+
+    assert daily_revenue(sales) == [
+        ("2026-11-17", 1200),
+        ("2026-11-18", 300),
+        ("2026-11-19", 0),
+        ("2026-11-20", -50),
+    ]
+
+
+def test_daily_revenue_converts_timestamps_to_configured_local_time():
+    sales = [
+        {"at": "2026-11-18T06:59:00Z", "cents": 100},
+        {"at": "2026-11-18T07:00:00Z", "cents": 200},
+    ]
+
+    assert daily_revenue(sales, utc_offset_hours=-5, day_starts_hour=2) == [
+        ("2026-11-17", 100),
+        ("2026-11-18", 200),
+    ]
+
+
+def test_daily_revenue_empty_sales():
+    assert daily_revenue([]) == []
+
+
+def test_daily_revenue_requires_a_timezone():
+    with pytest.raises(ValueError):
+        daily_revenue([{"at": "2026-11-18T02:30:00", "cents": 100}])
