-from shoplib.discounts import Coupon, apply_coupon
+from datetime import date
+
+import pytest
+
+from shoplib.discounts import Coupon, apply_coupon, apply_coupons
+from shoplib.errors import ShopError
 
 
 def test_percent():
@@ -7,3 +12,37 @@ def test_percent():
 
 def test_fixed_never_negative():
     assert apply_coupon(300, Coupon("FIVE", "fixed", 500)) == 0
+
+
+def test_apply_coupons_selects_best_percent_and_applies_fixed_afterward():
+    today = date(2026, 1, 10)
+    coupons = [
+        Coupon("Z-TEN", "percent", 10),
+        Coupon("A-TEN", "percent", 10),
+        Coupon("LOW", "percent", 5),
+        Coupon("FIXED", "fixed", 30, min_subtotal_cents=105),
+        Coupon("EXPIRED", "fixed", 99, expires=date(2026, 1, 9)),
+        Coupon("TOO-HIGH", "fixed", 99, min_subtotal_cents=106),
+        Coupon("TODAY", "fixed", 4, expires=today),
+    ]
+    # 10% of 105 is 10.5 cents, rounded up; the fixed minimum uses 105.
+    assert apply_coupons(105, coupons, today) == (60, ["A-TEN", "FIXED", "TODAY"])
+
+
+def test_apply_coupons_clamps_total_and_keeps_all_applied_codes():
+    coupons = [Coupon("Z", "fixed", 500), Coupon("A", "fixed", 1)]
+    assert apply_coupons(100, coupons, date(2026, 1, 1)) == (0, ["A", "Z"])
+
+
+def test_apply_coupons_without_eligible_coupons():
+    today = date(2026, 1, 1)
+    assert apply_coupons(100, [], today) == (100, [])
+    assert apply_coupons(100, [Coupon("OLD", "percent", 50, expires=date(2025, 12, 31))], today) == (100, [])
+
+
+def test_apply_coupons_rejects_invalid_arguments():
+    today = date(2026, 1, 1)
+    with pytest.raises(ShopError):
+        apply_coupons(-1, [], today)
+    with pytest.raises(ShopError):
+        apply_coupons(100, [Coupon("BAD", "unknown", 1)], today)
