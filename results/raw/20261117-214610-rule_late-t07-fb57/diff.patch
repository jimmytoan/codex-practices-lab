+++ b/tests/test_discounts.py
@@ -1,4 +1,8 @@
-from shoplib.discounts import Coupon, apply_coupon
+from datetime import date
+
+import pytest
+
+from shoplib.discounts import Coupon, apply_coupon, apply_coupons
 
 
 def test_percent():
@@ -7,3 +11,46 @@ def test_percent():
 
 def test_fixed_never_negative():
     assert apply_coupon(300, Coupon("FIVE", "fixed", 500)) == 0
+
+
+def test_apply_coupons_combines_best_percent_and_all_eligible_fixed():
+    today = date(2025, 6, 15)
+    coupons = [
+        Coupon("Z-PERCENT", "percent", 50),
+        Coupon("SMALL", "percent", 10),
+        Coupon("B-FIXED", "fixed", 50, expires=today, min_subtotal_cents=333),
+        Coupon("A-PERCENT", "percent", 50),
+        Coupon("A-FIXED", "fixed", 20, min_subtotal_cents=333),
+        Coupon("EXPIRED", "fixed", 100, expires=date(2025, 6, 14)),
+        Coupon("TOO-EARLY", "percent", 90, min_subtotal_cents=334),
+    ]
+
+    assert apply_coupons(333, coupons, today) == (
+        96, ["A-FIXED", "A-PERCENT", "B-FIXED"]
+    )
+
+
+def test_apply_coupons_caps_total_but_reports_all_eligible_codes():
+    coupons = [Coupon("B", "fixed", 500), Coupon("A", "fixed", 100)]
+
+    assert apply_coupons(100, coupons, date(2025, 6, 15)) == (0, ["A", "B"])
+
+
+def test_apply_coupons_with_no_eligible_coupons():
+    coupons = [
+        Coupon("EXPIRED", "percent", 10, expires=date(2025, 6, 14)),
+        Coupon("MINIMUM", "fixed", 10, min_subtotal_cents=101),
+    ]
+
+    assert apply_coupons(100, coupons, date(2025, 6, 15)) == (100, [])
+    assert apply_coupons(0, [], date(2025, 6, 15)) == (0, [])
+
+
+def test_apply_coupons_rejects_negative_subtotal():
+    with pytest.raises(ValueError, match="subtotal"):
+        apply_coupons(-1, [], date(2025, 6, 15))
+
+
+def test_apply_coupons_rejects_unknown_eligible_kind():
+    with pytest.raises(ValueError, match="unknown coupon kind"):
+        apply_coupons(100, [Coupon("BAD", "other", 10)], date(2025, 6, 15))
