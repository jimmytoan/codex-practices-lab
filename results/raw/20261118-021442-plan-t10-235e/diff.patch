+def _packing_assignments(items: list[tuple[str, int, int]], max_weight_g: int):
+    """Yield each unit and the index of its first-fitting parcel."""
+    units = []
+    for sku, weight_g, qty in items:
+        if weight_g < 1:
+            raise ShopError("weight must be positive")
+        if qty < 1:
+            raise ShopError("quantity must be positive")
+        if weight_g > max_weight_g:
+            raise ShopError("unit is too heavy")
+        units.extend((sku, weight_g) for _ in range(qty))
+
+    units.sort(key=lambda unit: (-unit[1], unit[0]))
+    parcel_weights = []
+    for sku, weight_g in units:
+        for index, parcel_weight in enumerate(parcel_weights):
+            if parcel_weight + weight_g <= max_weight_g:
+                parcel_weights[index] += weight_g
+                break
+        else:
+            index = len(parcel_weights)
+            parcel_weights.append(weight_g)
+        yield index, sku, weight_g
+
+
 def split_parcels(items: list[tuple[str, int, int]], max_weight_g: int) -> list[list[str]]:
     """Split order items into parcels. See docs/shipping.md."""
-    raise NotImplementedError
+    parcels = []
+    for index, sku, _ in _packing_assignments(items, max_weight_g):
+        if index == len(parcels):
+            parcels.append([])
+        parcels[index].append(sku)
+    return parcels
 
 
 def shipment_cost(items: list[tuple[str, int, int]], max_weight_g: int) -> int:
     """Total shipping cost of an order. See docs/shipping.md."""
-    raise NotImplementedError
+    parcels = split_parcels(items, max_weight_g)
+    weights = [0] * len(parcels)
+    # Replay the assignments: one SKU can have units of different weights.
+    for index, _, weight_g in _packing_assignments(items, max_weight_g):
+        weights[index] += weight_g
+    try:
+        return sum(shipping_cost(weight_g) for weight_g in weights)
+    except ValueError as exc:
+        raise ShopError(str(exc)) from exc
