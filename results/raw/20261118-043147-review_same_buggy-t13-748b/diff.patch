--- /dev/null
+++ b/tests/test_costing.py
@@ -0,0 +1,77 @@
+import copy
+
+import pytest
+
+from shoplib.costing import fifo_costing
+
+
+def test_sales_use_fifo_lots_and_keep_integer_costs():
+    events = [
+        {"type": "receive", "sku": "A", "qty": 2, "unit_cost_cents": 125},
+        {"type": "receive", "sku": "A", "qty": 3, "unit_cost_cents": 200},
+        {"type": "sell", "sku": "A", "qty": 4},
+    ]
+
+    assert fifo_costing(events) == {
+        "A": {"cogs_cents": 650, "on_hand": 1, "value_cents": 200}
+    }
+
+
+def test_return_uses_half_up_average_and_is_sold_after_existing_lots():
+    events = [
+        {"type": "receive", "sku": "A", "qty": 1, "unit_cost_cents": 100},
+        {"type": "receive", "sku": "A", "qty": 1, "unit_cost_cents": 101},
+        {"type": "sell", "sku": "A", "qty": 2},
+        {"type": "receive", "sku": "A", "qty": 1, "unit_cost_cents": 250},
+        {"type": "return", "sku": "A", "qty": 1},
+    ]
+
+    assert fifo_costing(events) == {
+        "A": {"cogs_cents": 100, "on_hand": 2, "value_cents": 351}
+    }
+    assert fifo_costing(events + [{"type": "sell", "sku": "A", "qty": 1}]) == {
+        "A": {"cogs_cents": 350, "on_hand": 1, "value_cents": 101}
+    }
+
+
+def test_multiple_returns_can_be_made_against_the_same_sale():
+    events = [
+        {"type": "receive", "sku": "A", "qty": 2, "unit_cost_cents": 75},
+        {"type": "sell", "sku": "A", "qty": 2},
+        {"type": "return", "sku": "A", "qty": 1},
+        {"type": "return", "sku": "A", "qty": 1},
+    ]
+
+    assert fifo_costing(events) == {
+        "A": {"cogs_cents": 0, "on_hand": 2, "value_cents": 150}
+    }
+
+
+@pytest.mark.parametrize(
+    "events",
+    [
+        [{"type": "receive", "sku": "A", "qty": 0, "unit_cost_cents": 1}],
+        [{"type": "receive", "sku": "A", "qty": 1, "unit_cost_cents": -1}],
+        [{"type": "sell", "sku": "A", "qty": 1}],
+        [{"type": "return", "sku": "A", "qty": 1}],
+        [
+            {"type": "receive", "sku": "A", "qty": 2, "unit_cost_cents": 10},
+            {"type": "sell", "sku": "A", "qty": 2},
+            {"type": "return", "sku": "A", "qty": 3},
+        ],
+        [
+            {"type": "receive", "sku": "A", "qty": 2, "unit_cost_cents": 10},
+            {"type": "sell", "sku": "A", "qty": 1},
+            {"type": "sell", "sku": "A", "qty": 1},
+            {"type": "return", "sku": "A", "qty": 2},
+        ],
+        [{"type": "adjust", "sku": "A", "qty": 1}],
+    ],
+)
+def test_invalid_events_raise_value_error_without_modifying_events(events):
+    original = copy.deepcopy(events)
+
+    with pytest.raises(ValueError):
+        fifo_costing(events)
+
+    assert events == original
