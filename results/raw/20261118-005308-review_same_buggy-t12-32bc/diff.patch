@@ -0,0 +1,90 @@
+import pytest
+
+from shoplib.errors import ShopError
+from shoplib.search import Product, search
+
+
+@pytest.fixture
+def products():
+    return [
+        Product("MUG-1", "Blue Mug", 1000, ["Sale", "Kitchen"]),
+        Product("MUG-2", "Red Mug", 1500, ["SALE", "Gift"]),
+        Product("PLATE", "Blue Plate", 2000, ["Kitchen"]),
+    ]
+
+
+@pytest.mark.parametrize(
+    ("query", "indices"),
+    [
+        ("", [0, 1, 2]),
+        (" \t\n", [0, 1, 2]),
+        ("mUg", [0, 1]),
+        ('"blue mug"', [0]),
+        ('name:"BLUE m"', [0]),
+        ("name:ug", [0, 1]),
+        ("sku:mug-1", [0]),
+        ("sku:mug-*", [0, 1]),
+        ("tag:sale", [0, 1]),
+        ("tag:SA*", [0, 1]),
+        ("blue tag:kitchen", [0, 2]),
+        ("mug -tag:sale", []),
+        ("-tag:sale", [2]),
+        ('-"blue mug"', [1, 2]),
+        ("price<1500", [0]),
+        ("price<=1500", [0, 1]),
+        ("price>1500", [2]),
+        ("price>=1500", [1, 2]),
+        ("price=1500", [1]),
+        ("-price>=1500", [0]),
+        ('price>="1500"', [1, 2]),
+    ],
+)
+def test_matching(products, query, indices):
+    assert search(products, query) == [products[i] for i in indices]
+
+
+def test_literals_and_unicode_casefold():
+    products = [
+        Product("STRAßE*X", "Straße price>=5 -tag:sale", 5, ["Groß*X"]),
+        Product("STRASSE", "Other", 5, ["GROSS"]),
+    ]
+    assert search(products, "STRASSE") == products[:1]
+    assert search(products, "name:STRASSE") == products[:1]
+    assert search(products, "sku:strasse*x") == products[:1]
+    assert search(products, "tag:gross*x") == products[:1]
+    assert search(products, "sku:strasse*") == products
+    assert search(products, "tag:gross*") == products
+    assert search(products, '"price>=5"') == products[:1]
+    assert search(products, '"-tag:sale"') == products[:1]
+
+
+@pytest.mark.parametrize(
+    "query",
+    [
+        '"unclosed',
+        'name:"unclosed',
+        "-",
+        "sku:",
+        'tag:""',
+        "name:",
+        "unknown:value",
+        "price:5",
+        "price>",
+        "price>=-1",
+        "price=1.5",
+        "price=abc",
+        "price==1",
+        'price>=""',
+        'price>"=1"',
+        "mug -tag:",
+    ],
+)
+def test_errors_are_checked_even_without_products(query):
+    with pytest.raises(ShopError):
+        search([], query)
+
+
+def test_large_whole_number_price():
+    product = Product("sku", "name", 1)
+    assert search([product], "price<" + "9" * 5000) == [product]
+    assert search([product], "price=" + "0" * 5000 + "1") == [product]
