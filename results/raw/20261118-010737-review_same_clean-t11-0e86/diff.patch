@@ -0,0 +1,75 @@
+import pytest
+
+from shoplib.errors import ShopError
+from shoplib.invoice import build_invoice
+
+
+def test_invoice_splits_coupon_and_taxes_each_line_and_shipping():
+    invoice = build_invoice(
+        [("a", 50, 2, "standard"), ("b", 100, 1, "food"), ("c", 100, 1, "books")],
+        coupon_cents=2,
+        shipping_cents=50,
+        region="DE",
+    )
+    assert invoice == {
+        "lines": [
+            {"sku": "a", "gross_cents": 100, "discount_cents": 1, "net_cents": 99, "tax_cents": 19},
+            {"sku": "b", "gross_cents": 100, "discount_cents": 1, "net_cents": 99, "tax_cents": 7},
+            {"sku": "c", "gross_cents": 100, "discount_cents": 0, "net_cents": 100, "tax_cents": 7},
+        ],
+        "shipping_cents": 50,
+        "shipping_tax_cents": 10,
+        "total_cents": 391,
+    }
+
+
+def test_largest_remainder_wins_before_input_order():
+    invoice = build_invoice(
+        [("a", 1, 1, "books"), ("b", 2, 1, "books"), ("c", 3, 1, "books")],
+        2, 0, "OR",
+    )
+    assert [line["discount_cents"] for line in invoice["lines"]] == [0, 1, 1]
+    assert invoice["total_cents"] == 4
+
+
+@pytest.mark.parametrize("prices,coupon,discounts", [
+    ([1, 2, 0], 10, [1, 2, 0]),
+    ([0, 0], 10, [0, 0]),
+    ([1, 2], 0, [0, 0]),
+])
+def test_coupon_caps_and_zero_gross(prices, coupon, discounts):
+    lines = [(str(i), price, 1, "books") for i, price in enumerate(prices)]
+    invoice = build_invoice(lines, coupon, 0, "OR")
+    assert [line["discount_cents"] for line in invoice["lines"]] == discounts
+    assert invoice["total_cents"] == sum(prices) - sum(discounts)
+
+
+def test_tax_is_rounded_half_up_per_line():
+    invoice = build_invoice([("a", 50, 1, "food"), ("b", 50, 1, "food")], 0, 0, "SG")
+    assert [line["tax_cents"] for line in invoice["lines"]] == [5, 5]
+    assert invoice["total_cents"] == 110
+
+
+@pytest.mark.parametrize("region,lines,expected_tax", [
+    ("SG", [("book", 100, 1, "books")], 0),
+    ("SG", [("book", 100, 1, "books"), ("food", 0, 1, "food")], 5),
+    ("OR", [("item", 100, 1, "standard")], 0),
+])
+def test_shipping_tax_depends_on_category_rates(region, lines, expected_tax):
+    invoice = build_invoice(lines, 1000, 50, region)
+    assert invoice["shipping_tax_cents"] == expected_tax
+    assert invoice["total_cents"] == 50 + expected_tax
+
+
+@pytest.mark.parametrize("lines,coupon,shipping,region", [
+    ([("a", 1, 1, "standard")], 0, 0, "unknown"),
+    ([], 0, 0, "DE"),
+    ([("a", 1, 1, "unknown")], 0, 0, "DE"),
+    ([("a", 1, 0, "standard")], 0, 0, "DE"),
+    ([("a", -1, 1, "standard")], 0, 0, "DE"),
+    ([("a", 1, 1, "standard")], -1, 0, "DE"),
+    ([("a", 1, 1, "standard")], 0, -1, "DE"),
+])
+def test_invalid_inputs_raise_shop_error(lines, coupon, shipping, region):
+    with pytest.raises(ShopError):
+        build_invoice(lines, coupon, shipping, region)
