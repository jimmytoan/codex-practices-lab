+++ b/tests/test_costing.py
@@ -0,0 +1,102 @@
+from copy import deepcopy
+
+import pytest
+
+from shoplib.costing import fifo_costing
+from shoplib.errors import ShopError
+
+
+def test_fifo_sales_and_independent_skus():
+    events = [
+        {"type": "receive", "sku": "A", "qty": 2, "unit_cost_cents": 100},
+        {"type": "receive", "sku": "B", "qty": 1, "unit_cost_cents": 70},
+        {"type": "receive", "sku": "A", "qty": 3, "unit_cost_cents": 200},
+        {"type": "sell", "sku": "A", "qty": 3},
+        {"type": "sell", "sku": "B", "qty": 1},
+        {"type": "return", "sku": "A", "qty": 1},
+        {"type": "return", "sku": "B", "qty": 1},
+    ]
+    original = deepcopy(events)
+    assert fifo_costing(events) == {
+        "A": {"cogs_cents": 267, "on_hand": 3, "value_cents": 533},
+        "B": {"cogs_cents": 0, "on_hand": 1, "value_cents": 70},
+    }
+    assert events == original
+    assert fifo_costing([]) == {}
+
+
+@pytest.mark.parametrize(
+    ("costs", "expected_unit"),
+    [([1, 1, 2], 1), ([1, 2], 2), ([1, 2, 2], 2)],
+)
+def test_returns_use_rounded_average_for_each_unit(costs, expected_unit):
+    events = [
+        {"type": "receive", "sku": "A", "qty": 1, "unit_cost_cents": cost}
+        for cost in costs
+    ]
+    events.extend([
+        {"type": "sell", "sku": "A", "qty": len(costs)},
+        {"type": "return", "sku": "A", "qty": 1},
+        {"type": "return", "sku": "A", "qty": len(costs) - 1},
+    ])
+    assert fifo_costing(events) == {
+        "A": {
+            "cogs_cents": sum(costs) - len(costs) * expected_unit,
+            "on_hand": len(costs),
+            "value_cents": len(costs) * expected_unit,
+        }
+    }
+
+
+def test_return_average_close_to_half_cent():
+    half = 10**28
+    events = [
+        {"type": "receive", "sku": "A", "qty": half - 1, "unit_cost_cents": 1},
+        {"type": "receive", "sku": "A", "qty": half + 1, "unit_cost_cents": 0},
+        {"type": "sell", "sku": "A", "qty": 2 * half},
+        {"type": "return", "sku": "A", "qty": 1},
+    ]
+    assert fifo_costing(events)["A"] == {
+        "cogs_cents": half - 1, "on_hand": 1, "value_cents": 0,
+    }
+
+
+def test_return_lots_are_sold_after_existing_stock():
+    events = [
+        {"type": "receive", "sku": "A", "qty": 1, "unit_cost_cents": 100},
+        {"type": "sell", "sku": "A", "qty": 1},
+        {"type": "receive", "sku": "A", "qty": 1, "unit_cost_cents": 200},
+        {"type": "return", "sku": "A", "qty": 1},
+        {"type": "sell", "sku": "A", "qty": 1},
+    ]
+    assert fifo_costing(events)["A"] == {
+        "cogs_cents": 200, "on_hand": 1, "value_cents": 100,
+    }
+
+
+@pytest.mark.parametrize("events", [
+    [{"type": "receive", "sku": "A", "qty": 0, "unit_cost_cents": 1}],
+    [{"type": "sell", "sku": "A", "qty": -1}],
+    [{"type": "return", "sku": "A", "qty": 0}],
+    [{"type": "receive", "sku": "A", "qty": 1, "unit_cost_cents": -1}],
+    [{"type": "sell", "sku": "A", "qty": 1}],
+    [{"type": "return", "sku": "A", "qty": 1}],
+    [{"type": "unknown", "sku": "A", "qty": 1}],
+    [
+        {"type": "receive", "sku": "A", "qty": 3, "unit_cost_cents": 0},
+        {"type": "sell", "sku": "A", "qty": 2},
+        {"type": "return", "sku": "A", "qty": 1},
+        {"type": "return", "sku": "A", "qty": 2},
+    ],
+    [
+        {"type": "receive", "sku": "A", "qty": 3, "unit_cost_cents": 1},
+        {"type": "sell", "sku": "A", "qty": 2},
+        {"type": "sell", "sku": "A", "qty": 1},
+        {"type": "return", "sku": "A", "qty": 2},
+    ],
+])
+def test_invalid_events_raise_shop_error_without_modifying_input(events):
+    original = deepcopy(events)
+    with pytest.raises(ShopError):
+        fifo_costing(events)
+    assert events == original
