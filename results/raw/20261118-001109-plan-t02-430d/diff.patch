diff --git a/tests/test_cart.py b/tests/test_cart.py
index 1a3d0e7..798b382 100644
--- a/tests/test_cart.py
+++ b/tests/test_cart.py
@@ -1,6 +1,7 @@
 import pytest
 
 from shoplib.cart import Cart
+from shoplib.errors import ShopError
 
 
 def test_add_and_subtotal():
@@ -21,3 +22,28 @@ def test_add_same_sku_merges():
 def test_bad_qty():
     with pytest.raises(ValueError):
         Cart().add("A", 250, 0)
+
+
+def test_bulk_discount_and_subtotal():
+    cart = Cart()
+    cart.add("under", 101, 9)
+    cart.add("threshold", 101, 10)
+    cart.add("above", 200, 11)
+
+    assert cart.line_total("under") == 909
+    assert cart.line_total("threshold") == 959  # 50.5 cents rounds up
+    assert cart.line_total("above") == 2090
+    assert cart.subtotal() == 3958
+
+
+def test_merged_quantity_qualifies_for_discount():
+    cart = Cart()
+    cart.add("A", 100, 9)
+    assert cart.line_total("A") == 900
+    cart.add("A", 100)
+    assert cart.line_total("A") == 950
+
+
+def test_line_total_missing_sku_raises_shop_error():
+    with pytest.raises(ShopError):
+        Cart().line_total("missing")
