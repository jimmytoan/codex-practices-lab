+++ b/tests/test_reports.py
@@ -1,3 +1,8 @@
+import csv
+import io
+
+import pytest
+
 from shoplib.reports import sales_summary, to_csv
 
 SALES = [
@@ -16,3 +21,30 @@ def test_summary():
 
 def test_csv():
     assert to_csv(sales_summary(SALES)) == "sku,name,units,revenue_cents\nA,Mug,3,1350\nB,Bowl,1,900\n"
+
+
+@pytest.mark.parametrize(
+    ("value", "escaped"),
+    [
+        ("plain", "plain"),
+        ("", ""),
+        ("a,b", '"a,b"'),
+        ('a"b', '"a""b"'),
+        ("a\nb", '"a\nb"'),
+        ("a\rb", '"a\rb"'),
+        ('a,"b"\r\nc', '"a,""b""\r\nc"'),
+    ],
+)
+def test_csv_escapes_fields(value, escaped):
+    rows = [{"sku": value, "name": value, "units": value, "revenue_cents": value}]
+    output = to_csv(rows)
+
+    assert output == "sku,name,units,revenue_cents\n" + ",".join([escaped] * 4) + "\n"
+    assert list(csv.reader(io.StringIO(output, newline=""))) == [
+        ["sku", "name", "units", "revenue_cents"],
+        [value] * 4,
+    ]
+
+
+def test_csv_empty_report_has_header():
+    assert to_csv([]) == "sku,name,units,revenue_cents\n"
