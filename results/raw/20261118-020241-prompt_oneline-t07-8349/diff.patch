+def test_apply_coupons_selects_best_percent_and_applies_fixed_to_original_eligibility():
+    today = date(2026, 11, 18)
+    coupons = [
+        Coupon("Z_TEN", "percent", 10),
+        Coupon("A_TEN", "percent", 10),
+        Coupon("FIVE", "percent", 5),
+        Coupon("FIXED", "fixed", 100, expires=today, min_subtotal_cents=1005),
+        Coupon("EXPIRED", "fixed", 200, expires=date(2026, 11, 17)),
+        Coupon("MINIMUM", "fixed", 200, min_subtotal_cents=1006),
+    ]
+
+    assert apply_coupons(1005, coupons, today) == (804, ["A_TEN", "FIXED"])
+
+
+def test_apply_coupons_floors_total_but_includes_all_eligible_codes():
+    coupons = [Coupon("Z", "fixed", 400), Coupon("A", "fixed", 300)]
+    assert apply_coupons(500, coupons, date(2026, 1, 1)) == (0, ["A", "Z"])
+
+
+def test_apply_coupons_with_no_eligible_coupons():
+    today = date(2026, 1, 1)
+    assert apply_coupons(100, [], today) == (100, [])
+    assert apply_coupons(100, [Coupon("OLD", "fixed", 50, expires=date(2025, 12, 31))], today) == (100, [])
+
+
+def test_apply_coupons_rejects_negative_subtotal_and_unknown_eligible_kind():
+    today = date(2026, 1, 1)
+    with pytest.raises(ShopError):
+        apply_coupons(-1, [], today)
+    with pytest.raises(ShopError):
+        apply_coupons(100, [Coupon("BAD", "other", 1)], today)
