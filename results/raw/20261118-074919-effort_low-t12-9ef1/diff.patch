@@ -0,0 +1,42 @@
+import pytest
+
+from shoplib.search import Product, search
+
+
+PRODUCTS = [
+    Product("MUG-01", "Blue Mug", 1200, ["drinkware", "sale"]),
+    Product("MUG-02", "Blue Travel Mug", 1800, ["drinkware"]),
+    Product("BOWL-1", "Blue Bowl", 900, ["sale"]),
+]
+
+
+def test_bare_and_quoted_terms_match_name_in_input_order():
+    assert search(PRODUCTS, 'blue "travel mug"') == [PRODUCTS[1]]
+    assert search(PRODUCTS, '"blue mug"') == [PRODUCTS[0]]
+    assert search(PRODUCTS, "   ") == PRODUCTS
+
+
+def test_fields_prefixes_and_negation():
+    assert search(PRODUCTS, 'sku:MUG-* name:"blue travel"') == [PRODUCTS[1]]
+    assert search(PRODUCTS, "tag:sale") == [PRODUCTS[0], PRODUCTS[2]]
+    assert search(PRODUCTS, "-tag:sale") == [PRODUCTS[1]]
+    assert search(PRODUCTS, "sku:MUG-*") == PRODUCTS[:2]
+    assert search(PRODUCTS, "sku:MUG-0*") == PRODUCTS[:2]
+    assert search(PRODUCTS, "sku:MUG-0* -price>=1800") == [PRODUCTS[0]]
+
+
+def test_price_comparisons():
+    assert search(PRODUCTS, "price<1200") == [PRODUCTS[2]]
+    assert search(PRODUCTS, "price<=1200") == [PRODUCTS[0], PRODUCTS[2]]
+    assert search(PRODUCTS, "price>1200") == [PRODUCTS[1]]
+    assert search(PRODUCTS, "price>=1200") == PRODUCTS[:2]
+    assert search(PRODUCTS, "price=900") == [PRODUCTS[2]]
+
+
+@pytest.mark.parametrize("query", [
+    "price:5", "color:red", "sku:", "tag:", "name:", "-", '"unclosed',
+    "price>nope", "price>=1.5", "price=", "price<-1",
+])
+def test_invalid_queries_raise_value_error(query):
+    with pytest.raises(ValueError):
+        search(PRODUCTS, query)
