 """Product search. See docs/search.md."""
 
 from dataclasses import dataclass, field
+import re
 
 
 @dataclass
@@ -13,4 +14,83 @@ class Product:
 
 def search(products: list[Product], query: str) -> list[Product]:
     """The products that match `query`, in their input order. See docs/search.md."""
-    raise NotImplementedError
+    terms = _tokenize(query)
+    predicates = [_compile_term(term) for term in terms]
+    return [product for product in products if all(test(product) for test in predicates)]
+
+
+def _tokenize(query: str) -> list[str]:
+    """Split on unquoted whitespace, removing quote delimiters."""
+    result: list[str] = []
+    token: list[str] = []
+    quoted = False
+    started = False
+    for char in query:
+        if char == '"':
+            quoted = not quoted
+            started = True
+        elif char.isspace() and not quoted:
+            if started:
+                result.append("".join(token))
+                token = []
+                started = False
+        else:
+            token.append(char)
+            started = True
+    if quoted:
+        raise ValueError("unclosed quote")
+    if started:
+        result.append("".join(token))
+    return result
+
+
+def _compile_term(term: str):
+    negate = term.startswith("-")
+    if negate:
+        term = term[1:]
+        if not term:
+            raise ValueError("negation requires a term")
+
+    comparison = re.match(r"^price(<=|>=|<|>|=)(.*)$", term, re.IGNORECASE)
+    if comparison:
+        operator, value = comparison.groups()
+        if not re.fullmatch(r"[0-9]+", value):
+            raise ValueError("price comparison requires whole cents")
+        cents = int(value)
+        checks = {
+            "<": lambda price: price < cents,
+            "<=": lambda price: price <= cents,
+            ">": lambda price: price > cents,
+            ">=": lambda price: price >= cents,
+            "=": lambda price: price == cents,
+        }
+        predicate = lambda product: checks[operator](product.price_cents)
+    elif ":" in term:
+        field_name, value = term.split(":", 1)
+        field_name = field_name.lower()
+        if field_name not in {"sku", "name", "tag"}:
+            raise ValueError(f"unknown search field: {field_name}")
+        if not value:
+            raise ValueError("field value cannot be empty")
+        if field_name == "sku":
+            predicate = _equal_or_prefix(value, lambda product: [product.sku])
+        elif field_name == "tag":
+            predicate = _equal_or_prefix(value, lambda product: product.tags)
+        else:
+            needle = value.casefold()
+            predicate = lambda product: needle in product.name.casefold()
+    else:
+        needle = term.casefold()
+        predicate = lambda product: needle in product.name.casefold()
+
+    if negate:
+        return lambda product: not predicate(product)
+    return predicate
+
+
+def _equal_or_prefix(value: str, values):
+    if value.endswith("*"):
+        prefix = value[:-1].casefold()
+        return lambda product: any(item.casefold().startswith(prefix) for item in values(product))
+    expected = value.casefold()
+    return lambda product: any(item.casefold() == expected for item in values(product))
