@@ -0,0 +1,78 @@
+import pytest
+
+from shoplib.errors import ShopError
+from shoplib.search import Product, search
+
+
+@pytest.fixture
+def products():
+    return [
+        Product("MUG-1", "Blue Mug Large", 1000, ["Sale", "Kitchenware"]),
+        Product("mug-2", "blue mug", 1500, ["CLEARANCE"]),
+        Product("CUP*3", "Red Cup", 2000, ["Sale*special"]),
+        Product("X", 'Literal -sale price>100 tag:sale', 0, []),
+    ]
+
+
+@pytest.mark.parametrize(
+    ("query", "indices"),
+    [
+        ("", [0, 1, 2, 3]),
+        (" \t\n", [0, 1, 2, 3]),
+        ("BLUE mug", [0, 1]),
+        ('"blue mug"', [0, 1]),
+        ('name:"BLUE MUG"', [0, 1]),
+        ("name:blue", [0, 1]),
+        ("sku:mug-1", [0]),
+        ("sku:MUG-*", [0, 1]),
+        ("sku:CUP*3", [2]),
+        ("tag:sale", [0]),
+        ("tag:SALE*", [0, 2]),
+        ("tag:sale*special", [2]),
+        ("price<1000", [3]),
+        ("price<=1000", [0, 3]),
+        ("price>1000", [1, 2]),
+        ("price>=1000", [0, 1, 2]),
+        ("price=1000", [0]),
+        ('price>="1000"', [0, 1, 2]),
+        ("-tag:sale", [1, 2, 3]),
+        ('-"blue mug"', [2, 3]),
+        ("-price>=1500", [0, 3]),
+        ("mug -tag:sale price>=1000", [1]),
+        ('"-sale"', [3]),
+        ('"tag:sale"', [3]),
+        ('"price>100"', [3]),
+        ("price=0000000001000", [0]),
+    ],
+)
+def test_search_query_terms(products, query, indices):
+    assert search(products, query) == [products[i] for i in indices]
+
+
+@pytest.mark.parametrize(
+    "query",
+    [
+        '"unclosed',
+        'name:"unclosed',
+        "unknown:value",
+        "price:5",
+        "tag:",
+        'name:""',
+        "-",
+        '-""',
+        "price>",
+        "price=1.5",
+        "price=-1",
+        "price>=abc",
+        'price>="abc"',
+        'price>=""',
+    ],
+)
+def test_invalid_queries_raise_shop_error_even_without_products(query):
+    with pytest.raises(ShopError):
+        search([], query)
+
+
+def test_price_comparisons_accept_large_whole_numbers(products):
+    assert search(products, "price<" + "9" * 5000) == products
+    assert search(products, "price=" + "0" * 5000 + "1000") == [products[0]]
