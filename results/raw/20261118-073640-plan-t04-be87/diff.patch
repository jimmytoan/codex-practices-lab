@@ -1,7 +1,7 @@
 import pytest
 
 from shoplib.inventory import Inventory
-from shoplib.orders import DELIVERED, NEW, Order
+from shoplib.orders import CANCELLED, DELIVERED, NEW, PAID, SHIPPED, Order
 
 
 def make():
@@ -25,3 +25,57 @@ def test_cannot_ship_unpaid():
     _, order = make()
     with pytest.raises(ValueError):
         order.ship()
+
+
+def test_cancel_new_order_releases_stock_without_refund():
+    inv, order = make()
+    order.cancel()
+    assert order.state == CANCELLED
+    assert order.refund_due is False
+    assert inv.reserved("A") == 0
+    assert inv.available("A") == 5
+
+
+def test_cancel_paid_order_releases_stock_and_sets_refund_due():
+    inv, order = make()
+    order.pay()
+    order.cancel()
+    assert order.state == CANCELLED
+    assert order.refund_due is True
+    assert inv.reserved("A") == 0
+    assert inv.available("A") == 5
+
+
+def test_cancel_cancelled_order_does_nothing():
+    inv, order = make()
+    order.cancel()
+    order.cancel()
+    assert order.state == CANCELLED
+    assert order.refund_due is False
+    assert inv.reserved("A") == 0
+    assert inv.available("A") == 5
+
+
+@pytest.mark.parametrize("state", [SHIPPED, DELIVERED])
+def test_cannot_cancel_shipped_or_delivered_order(state):
+    inv, order = make()
+    order.pay()
+    order.ship()
+    if state == DELIVERED:
+        order.deliver()
+    before = (order.state, order.refund_due, inv.on_hand("A"), inv.reserved("A"))
+    with pytest.raises(ValueError):
+        order.cancel()
+    assert (order.state, order.refund_due, inv.on_hand("A"), inv.reserved("A")) == before
+
+
+def test_failed_multiline_cancellation_does_not_partially_release():
+    inv = Inventory()
+    inv.receive("A", 5)
+    inv.receive("B", 5)
+    order = Order("o2", {"A": 2, "B": 2}, inv)
+    inv.release("B", 1)
+    before = (order.state, order.refund_due, inv.reserved("A"), inv.reserved("B"))
+    with pytest.raises(ValueError):
+        order.cancel()
+    assert (order.state, order.refund_due, inv.reserved("A"), inv.reserved("B")) == before
