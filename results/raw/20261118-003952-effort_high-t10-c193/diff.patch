+def test_split_parcels_expands_units_and_sorts_equal_weights_by_sku():
+    items = [("D", 4, 1), ("B", 6, 2), ("A", 6, 1), ("C", 4, 2)]
+
+    assert split_parcels(items, 10) == [["A", "C"], ["B", "C"], ["B", "D"]]
+    assert items == [("D", 4, 1), ("B", 6, 2), ("A", 6, 1), ("C", 4, 2)]
+
+
+def test_split_parcels_uses_first_open_parcel_with_room():
+    items = [("last", 1, 1), ("middle", 3, 1), ("c", 5, 1),
+             ("b", 6, 1), ("a", 8, 1)]
+
+    assert split_parcels(items, 10) == [["a", "last"], ["b", "middle"], ["c"]]
+
+
+def test_empty_shipment():
+    assert split_parcels([], 0) == []
+    assert shipment_cost([], 0) == 0
+
+
+@pytest.mark.parametrize("items,max_weight", [
