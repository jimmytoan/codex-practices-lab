+    ([("a", 1, -1)], 10),
+    ([("a", 0, 1)], 10),
+    ([("a", -1, 1)], 10),
+    ([("a", 11, 1)], 10),
+    ([("a", 1, 1)], 0),
+    ([("valid", 1, 1), ("invalid", 1, 0)], 10),
+])
+def test_invalid_items_raise_shop_error(items, max_weight):
+    with pytest.raises(ShopError):
+        split_parcels(items, max_weight)
+    with pytest.raises(ShopError):
+        shipment_cost(items, max_weight)
+
