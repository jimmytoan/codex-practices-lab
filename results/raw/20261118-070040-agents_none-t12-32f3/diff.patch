+++ b/tests/test_search.py
@@ -0,0 +1,78 @@
+import pytest
+
+from shoplib.search import Product, search
+
+
+@pytest.fixture
+def products():
+    return [
+        Product("MUG-001", "Blue Ceramic Mug", 1250, ["kitchen", "sale"]),
+        Product("MUG-002", "Blue Travel Cup", 900, ["travel"]),
+        Product("PLATE-1", "White Dinner Plate", 1500, ["kitchen"]),
+    ]
+
+
+def test_empty_query_matches_all_in_input_order(products):
+    assert search(products, " \t\n") == products
+
+
+def test_bare_terms_are_case_insensitive_substrings_and_conjunctive(products):
+    assert search(products, "BLUE mug") == [products[0]]
+    assert search(products, "blue plate") == []
+
+
+def test_quotes_group_bare_phrase_and_field_value(products):
+    assert search(products, '"blue ceramic"') == [products[0]]
+    assert search(products, 'name:"blue travel"') == [products[1]]
+    assert search(products, '"blue: ceramic"') == []
+    assert search(products, '""') == products
+    assert search(products, '-""') == []
+
+
+def test_sku_and_tag_exact_and_prefix_matches(products):
+    assert search(products, "sku:mug-001") == [products[0]]
+    assert search(products, "tag:SALE") == [products[0]]
+    assert search(products, "sku:MUG-*") == products[:2]
+    assert search(products, "tag:kit*") == [products[0], products[2]]
+    assert search(products, "sku:M*G-*") == []
+
+
+def test_star_is_ordinary_except_at_end_of_sku_or_tag_value(products):
+    products[0].name = "MUG* special"
+    products[0].sku = "MUG*"
+    assert search(products, "MUG*") == [products[0]]
+    assert search(products, "sku:MUG**") == [products[0]]
+    assert search(products, "name:MUG*") == [products[0]]
+
+
+def test_price_comparisons_and_negation(products):
+    assert search(products, "price<1000") == [products[1]]
+    assert search(products, "price<=900") == [products[1]]
+    assert search(products, "price>1250") == [products[2]]
+    assert search(products, "price>=1250") == [products[0], products[2]]
+    assert search(products, "price=1500") == [products[2]]
+    assert search(products, "-tag:sale") == products[1:]
+    assert search(products, "-name:blue") == [products[2]]
+    assert search(products, "-price>=1000") == [products[1]]
+    assert search(products, '-"price>=1000"') == products
+
+
+@pytest.mark.parametrize(
+    "query",
+    [
+        "price:5",
+        "unknown:value",
+        ":value",
+        "tag:",
+        "sku:\"\"",
+        "-",
+        '"unfinished',
+        "price>=",
+        "price>1.5",
+        "price<=-1",
+        "price=one",
+    ],
+)
+def test_invalid_queries_raise_value_error(products, query):
+    with pytest.raises(ValueError):
+        search(products, query)
