@@ -0,0 +1,50 @@
+import pytest
+
+from shoplib.search import Product, search
+
+
+@pytest.fixture
+def products():
+    return [
+        Product("MUG-01", "Blue ceramic mug", 1200, ["kitchen", "sale"]),
+        Product("MUG-02", "Blue travel mug", 999, ["travel"]),
+        Product("PLATE-1", "Red plate", 1500, ["kitchen"]),
+    ]
+
+
+def test_bare_terms_are_substrings_and_all_terms_must_match(products):
+    assert search(products, "BLUE mug") == products[:2]
+    assert search(products, "blue plate") == []
+    assert search(products, "   \t") == products
+
+
+def test_quotes_group_phrase_and_field_value(products):
+    assert search(products, '"blue ceramic"') == products[:1]
+    assert search(products, 'name:"travel mug"') == products[1:2]
+    assert search(products, '"blue mug"') == []
+
+
+def test_sku_tag_and_prefix_matching(products):
+    assert search(products, "sku:mug-01") == products[:1]
+    assert search(products, "tag:KITCHEN") == [products[0], products[2]]
+    assert search(products, "sku:MUG-*") == products[:2]
+    assert search(products, "tag:trav*") == products[1:2]
+    assert search(products, "sku:MUG-*1") == []
+
+
+def test_price_comparisons_and_negation(products):
+    assert search(products, "price>=1000") == [products[0], products[2]]
+    assert search(products, "price<1000") == products[1:2]
+    assert search(products, "price=1200") == products[:1]
+    assert search(products, "-tag:sale") == products[1:]
+    assert search(products, "-blue") == [products[2]]
+    assert search(products, "-price>=1000") == products[1:2]
+
+
+@pytest.mark.parametrize("query", [
+    "other:value", "price:5", "tag:", "sku:", "-", '"unfinished',
+    "price>1.5", "price<=", "price=abc",
+])
+def test_invalid_queries_raise_value_error(products, query):
+    with pytest.raises(ValueError):
+        search(products, query)
