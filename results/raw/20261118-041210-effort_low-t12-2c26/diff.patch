 @dataclass
@@ -13,4 +14,80 @@ class Product:
 
 def search(products: list[Product], query: str) -> list[Product]:
     """The products that match `query`, in their input order. See docs/search.md."""
-    raise NotImplementedError
+    terms = _tokenize(query)
+    predicates = [_compile(term) for term in terms]
+    return [product for product in products if all(test(product) for test in predicates)]
+
+
+def _tokenize(query: str) -> list[str]:
+    """Split on unquoted whitespace and remove quote delimiters."""
+    terms: list[str] = []
+    current: list[str] = []
+    quoted = False
+    active = False
+    for char in query:
+        if char == '"':
+            quoted = not quoted
+            active = True
+        elif char.isspace() and not quoted:
+            if active:
+                terms.append("".join(current))
+                current = []
+                active = False
+        else:
+            current.append(char)
+            active = True
+    if quoted:
+        raise ValueError("unclosed quote")
+    if active:
+        terms.append("".join(current))
+    return terms
+
+
+def _compile(term: str):
+    negate = term.startswith("-")
+    if negate:
+        term = term[1:]
+        if not term:
+            raise ValueError("missing term after '-'")
+
+    price = re.fullmatch(r"price(<=|>=|<|>|=)(.*)", term, re.IGNORECASE)
+    if price:
+        op, value = price.groups()
+        if not re.fullmatch(r"\d+", value):
+            raise ValueError("price comparison requires whole cents")
+        cents = int(value)
+        compare = {
+            "<": lambda p: p.price_cents < cents,
+            "<=": lambda p: p.price_cents <= cents,
+            ">": lambda p: p.price_cents > cents,
+            ">=": lambda p: p.price_cents >= cents,
+            "=": lambda p: p.price_cents == cents,
+        }[op]
+        return _maybe_negate(compare, negate)
+
+    if ":" in term:
+        field_name, value = term.split(":", 1)
+        field_name = field_name.lower()
+        if field_name not in {"sku", "name", "tag"}:
+            raise ValueError(f"unknown search field: {field_name}")
+        if not value:
+            raise ValueError("field value cannot be empty")
+        folded = value.casefold()
+        prefix = field_name in {"sku", "tag"} and value.endswith("*")
+        if prefix:
+            folded = value[:-1].casefold()
+        if field_name == "sku":
+            test = (lambda p: p.sku.casefold().startswith(folded)) if prefix else (lambda p: p.sku.casefold() == folded)
+        elif field_name == "tag":
+            test = (lambda p: any(t.casefold().startswith(folded) for t in p.tags)) if prefix else (lambda p: any(t.casefold() == folded for t in p.tags))
+        else:
+            test = lambda p: folded in p.name.casefold()
+        return _maybe_negate(test, negate)
+
+    folded = term.casefold()
+    return _maybe_negate(lambda p: folded in p.name.casefold(), negate)
+
+
+def _maybe_negate(test, negate: bool):
+    return (lambda product: not test(product)) if negate else test
