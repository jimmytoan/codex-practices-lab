@@ -0,0 +1,73 @@
+import pytest
+
+from shoplib.errors import ShopError
+from shoplib.search import Product, search
+
+
+@pytest.fixture
+def products():
+    return [
+        Product("MUG-01", "Blue Mug", 1000, ["Sale", "Kitchen"]),
+        Product("mug-02", "Red mug", 1500, ["kitchenware"]),
+        Product("PLATE*3", "Blue plate", 999, ["sale*item"]),
+        Product("STRASSE", "Straße cup", 0, ["GROSS"]),
+    ]
+
+
+@pytest.mark.parametrize(
+    ("query", "indices"),
+    [
+        ("", [0, 1, 2, 3]),
+        (" \t\n", [0, 1, 2, 3]),
+        ("MUG", [0, 1]),
+        ('"blue mug"', [0]),
+        ('name:"blue mug"', [0]),
+        ("blue mug", [0]),
+        ("sku:mug-01", [0]),
+        ("sku:MUG-*", [0, 1]),
+        ("tag:KITCHEN", [0]),
+        ("tag:kitchen*", [0, 1]),
+        ("sku:PLATE*3", [2]),
+        ("tag:sale*item", [2]),
+        ("name:m*g", []),
+        ("price<1000", [2, 3]),
+        ("price<=1000", [0, 2, 3]),
+        ("price>1000", [1]),
+        ("price>=1000", [0, 1]),
+        ("price=1000", [0]),
+        ('price>="1000"', [0, 1]),
+        ("-tag:sale", [1, 2, 3]),
+        ('-name:"blue mug"', [1, 2, 3]),
+        ("-price>=1000", [2, 3]),
+        ('"tag:sale"', []),
+        ('"-tag:sale"', []),
+        ("STRASSE", [3]),
+        ("sku:straße", [3]),
+        ("tag:groß", [3]),
+        ("name:STRASSE", [3]),
+    ],
+)
+def test_search_terms(products, query, indices):
+    assert search(products, query) == [products[i] for i in indices]
+
+
+@pytest.mark.parametrize(
+    "query",
+    [
+        "unknown:value", "price:5", "tag:", 'name:""', "sku:",
+        "-", '"unclosed', 'name:"unclosed', "price>", "price=1.5",
+        "price>=-1", "price<=abc", "price==5", 'price>="abc"',
+        '-price>"not a number"',
+    ],
+)
+def test_search_errors_even_without_products_or_after_a_nonmatching_term(products, query):
+    for data, expression in (([], query), (products, "no-match " + query)):
+        with pytest.raises(ShopError):
+            search(data, expression)
+
+
+def test_search_handles_large_price_literals():
+    huge = 10 ** 5000
+    products = [Product("large", "Large", huge), Product("small", "Small", 1)]
+    assert search(products, "price>=" + "1" + "0" * 5000) == products[:1]
+    assert search(products, "price=" + "0" * 5000 + "1") == products[1:]
