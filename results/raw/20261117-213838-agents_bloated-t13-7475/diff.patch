diff --git a/src/shoplib/costing.py b/src/shoplib/costing.py
index 5e8c27e..d27a1af 100644
--- a/src/shoplib/costing.py
+++ b/src/shoplib/costing.py
@@ -1,6 +1,96 @@
 """Cost of goods sold with FIFO lots. See docs/costing.md."""
 
+from collections import deque
+from dataclasses import dataclass, field
+from decimal import Decimal, localcontext
+
+from shoplib.errors import ShopError
+from shoplib.money import round_cents
+
+
+@dataclass
+class _Stock:
+    lots: deque = field(default_factory=deque)
+    on_hand: int = 0
+    value_cents: int = 0
+    cogs_cents: int = 0
+    returnable: int = 0
+    sale_unit_cost: int = 0
+
+    def receive(self, qty: int, unit_cost: int) -> None:
+        self.lots.append((qty, unit_cost))
+        self.on_hand += qty
+        self.value_cents += qty * unit_cost
+
+    def sell(self, qty: int) -> None:
+        if qty > self.on_hand:
+            raise ShopError("not enough stock")
+
+        remaining = qty
+        sale_cost = 0
+        while remaining:
+            lot_qty, unit_cost = self.lots.popleft()
+            taken = min(remaining, lot_qty)
+            sale_cost += taken * unit_cost
+            remaining -= taken
+            if taken < lot_qty:
+                self.lots.appendleft((lot_qty - taken, unit_cost))
+
+        self.on_hand -= qty
+        self.value_cents -= sale_cost
+        self.cogs_cents += sale_cost
+        self.returnable = qty
+        # Keep enough precision to distinguish either side of a half cent.
+        with localcontext() as context:
+            context.prec = max(Decimal(sale_cost).adjusted(), Decimal(qty).adjusted()) + 3
+            self.sale_unit_cost = round_cents(Decimal(sale_cost) / Decimal(qty))
+
+    def return_units(self, qty: int) -> None:
+        if qty > self.returnable:
+            raise ShopError("not enough units returnable from the latest sale")
+        self.returnable -= qty
+        self.receive(qty, self.sale_unit_cost)
+        self.cogs_cents -= qty * self.sale_unit_cost
+
 
 def fifo_costing(events: list[dict]) -> dict:
     """Process stock events and report cost per SKU. See docs/costing.md."""
-    raise NotImplementedError
+    stocks = {}
+    for event in events:
+        if not isinstance(event, dict):
+            raise ShopError("event must be a dict")
+        event_type = event.get("type")
+        if event_type not in ("receive", "sell", "return"):
+            raise ShopError("unknown event type")
+        if "sku" not in event:
+            raise ShopError("sku is required")
+        sku = event["sku"]
+        try:
+            hash(sku)
+        except TypeError as exc:
+            raise ShopError("sku must be hashable") from exc
+
+        qty = event.get("qty")
+        if type(qty) is not int or qty < 1:
+            raise ShopError("qty must be a positive integer")
+        if event_type == "receive":
+            unit_cost = event.get("unit_cost_cents")
+            if type(unit_cost) is not int or unit_cost < 0:
+                raise ShopError("unit cost must be a nonnegative integer")
+
+        stock = stocks.setdefault(sku, _Stock())
+        if event_type == "receive":
+            stock.receive(qty, unit_cost)
+        elif event_type == "sell":
+            stock.sell(qty)
+        else:
+            stock.return_units(qty)
+
+    return {
+        sku: {
+            "cogs_cents": stock.cogs_cents,
+            "on_hand": stock.on_hand,
+            "value_cents": stock.value_cents,
+        }
+        for sku, stock in stocks.items()
+    }
diff --git a/tests/test_costing.py b/tests/test_costing.py
new file mode 100644
index 0000000..ccb3c00
--- /dev/null
+++ b/tests/test_costing.py
@@ -0,0 +1,108 @@
+from copy import deepcopy
+
+import pytest
+
+from shoplib.costing import fifo_costing
+from shoplib.errors import ShopError
+
+
+def receive(sku, qty, cost):
+    return {"type": "receive", "sku": sku, "qty": qty, "unit_cost_cents": cost}
+
+
+def sell(sku, qty):
+    return {"type": "sell", "sku": sku, "qty": qty}
+
+
+def return_units(sku, qty):
+    return {"type": "return", "sku": sku, "qty": qty}
+
+
+def test_empty_events():
+    assert fifo_costing([]) == {}
+
+
+def test_fifo_across_lots_and_independent_skus():
+    events = [
+        receive("A", 2, 100), receive("B", 1, 7), receive("A", 3, 250),
+        sell("A", 3), sell("B", 1),
+    ]
+    original = deepcopy(events)
+    assert fifo_costing(events) == {
+        "A": {"cogs_cents": 450, "on_hand": 2, "value_cents": 500},
+        "B": {"cogs_cents": 7, "on_hand": 0, "value_cents": 0},
+    }
+    assert events == original
+
+
+def test_returns_use_sale_average_and_are_sold_after_existing_lots():
+    events = [
+        receive("A", 1, 100), receive("A", 1, 201), receive("A", 1, 400),
+        sell("A", 2), return_units("A", 1), return_units("A", 1),
+        sell("A", 2),
+    ]
+    assert fifo_costing(events) == {
+        "A": {"cogs_cents": 550, "on_hand": 1, "value_cents": 151},
+    }
+
+
+def test_return_rounding_can_make_cogs_negative():
+    events = [receive("A", 1, 1), receive("A", 1, 2), sell("A", 2), return_units("A", 2)]
+    assert fifo_costing(events)["A"] == {
+        "cogs_cents": -1, "on_hand": 2, "value_cents": 4,
+    }
+
+
+def test_resold_returns_use_the_new_sales_average():
+    events = [
+        receive("A", 2, 1), receive("A", 2, 4), sell("A", 3),
+        return_units("A", 1), sell("A", 2), return_units("A", 1),
+    ]
+    assert fifo_costing(events)["A"] == {
+        "cogs_cents": 7, "on_hand": 1, "value_cents": 3,
+    }
+
+
+def test_average_below_half_cent_is_not_rounded_up_for_large_sales():
+    qty = 10**30 + 1
+    events = [receive("A", qty - 1, 0), receive("A", 1, qty // 2), sell("A", qty), return_units("A", 1)]
+    assert fifo_costing(events)["A"] == {
+        "cogs_cents": qty // 2, "on_hand": 1, "value_cents": 0,
+    }
+
+
+def test_latest_sale_is_tracked_per_sku_and_receipts_do_not_replace_it():
+    events = [
+        receive("A", 3, 100), receive("B", 2, 50), sell("A", 2), sell("B", 2),
+        sell("A", 1), receive("A", 1, 200), return_units("B", 2), return_units("A", 1),
+    ]
+    assert fifo_costing(events) == {
+        "A": {"cogs_cents": 200, "on_hand": 2, "value_cents": 300},
+        "B": {"cogs_cents": 0, "on_hand": 2, "value_cents": 100},
+    }
+
+
+@pytest.mark.parametrize("events", [
+    [receive("A", 0, 1)],
+    [sell("A", -1)],
+    [return_units("A", 0)],
+    [receive("A", 1, -1)],
+    [sell("A", 1)],
+    [receive("A", 1, 1), sell("A", 2)],
+    [return_units("A", 1)],
+    [receive("A", 1, 1), return_units("A", 1)],
+    [receive("B", 1, 1), sell("B", 1), return_units("A", 1)],
+    [receive("A", 2, 1), sell("A", 2), return_units("A", 3)],
+    [receive("A", 2, 1), sell("A", 2), return_units("A", 1), return_units("A", 2)],
+    [receive("A", 3, 1), sell("A", 2), sell("A", 1), return_units("A", 2)],
+    [receive("A", 2, 1), sell("A", 1), sell("A", 1), return_units("A", 1), return_units("A", 1)],
+    [{"type": "unknown", "sku": "A", "qty": 1}],
+    [receive("A", 1.5, 1)],
+    [receive("A", 1, 1.5)],
+    [{"type": "receive", "qty": 1, "unit_cost_cents": 1}],
+])
+def test_invalid_events_raise_shop_error_without_modifying_input(events):
+    original = deepcopy(events)
+    with pytest.raises(ShopError):
+        fifo_costing(events)
+    assert events == original
