 def test_percent():
@@ -7,3 +12,35 @@ def test_percent():
 
 def test_fixed_never_negative():
     assert apply_coupon(300, Coupon("FIVE", "fixed", 500)) == 0
+
+
+def test_apply_coupons_selects_eligible_coupons_and_uses_original_subtotal():
+    today = date(2026, 6, 15)
+    coupons = [
+        Coupon("Z-PERCENT", "percent", 10),
+        Coupon("A-PERCENT", "percent", 10, expires=today),
+        Coupon("LOW", "percent", 5),
+        Coupon("EXPIRED", "percent", 99, expires=date(2026, 6, 14)),
+        Coupon("MINIMUM", "fixed", 10, min_subtotal_cents=105),
+        Coupon("TOO-HIGH", "fixed", 100, min_subtotal_cents=106),
+        Coupon("FIXED", "fixed", 20),
+    ]
+    # 10% of 105 cents rounds half up to 11; the minimum uses 105, not 94.
+    assert apply_coupons(105, coupons, today) == (64, ["A-PERCENT", "FIXED", "MINIMUM"])
+
+
+def test_apply_coupons_clamps_total_and_reports_all_applied_codes():
+    coupons = [Coupon("Z", "fixed", 200), Coupon("A", "fixed", 150)]
+    assert apply_coupons(100, coupons, date(2026, 6, 15)) == (0, ["A", "Z"])
+    assert apply_coupons(100, [], date(2026, 6, 15)) == (100, [])
+
+
+def test_apply_coupons_rejects_negative_subtotal():
+    with pytest.raises(ShopError):
+        apply_coupons(-1, [], date(2026, 6, 15))
+
+
+@pytest.mark.parametrize("expires", [None, date(2026, 6, 14)])
+def test_apply_coupons_rejects_unknown_kind(expires):
+    with pytest.raises(ShopError, match="unknown coupon kind"):
+        apply_coupons(100, [Coupon("BAD", "other", 10, expires=expires)], date(2026, 6, 15))
