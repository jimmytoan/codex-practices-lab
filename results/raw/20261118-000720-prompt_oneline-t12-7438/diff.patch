 def search(products: list[Product], query: str) -> list[Product]:
     """The products that match `query`, in their input order. See docs/search.md."""
-    raise NotImplementedError
+    terms = [_parse_term(token) for token in _tokens(query)]
+    return [product for product in products if all(_matches(product, term) for term in terms)]
+
+
+def _tokens(query: str) -> list[str]:
+    tokens = []
+    current = []
+    quoted = False
+    started = False
+    for char in query:
+        if char == '"':
+            quoted = not quoted
+            started = True
+        elif char.isspace() and not quoted:
+            if started:
+                tokens.append("".join(current))
+                current = []
+                started = False
+        else:
+            current.append(char)
+            started = True
+    if quoted:
+        raise ShopError("unclosed quote")
+    if started:
+        tokens.append("".join(current))
+    return tokens
+
+
+_PRICE_OPERATORS = {
+    "<": operator.lt,
+    "<=": operator.le,
+    ">": operator.gt,
+    ">=": operator.ge,
+    "=": operator.eq,
+}
+
+
+def _parse_term(token: str) -> tuple:
+    negated = token.startswith("-")
+    if negated:
+        token = token[1:]
+        if not token:
+            raise ShopError("empty negated term")
+
+    if ":" in token:
+        field_name, value = token.split(":", 1)
+        if field_name not in ("sku", "tag", "name"):
+            raise ShopError("unknown search field")
+        if not value:
+            raise ShopError("empty search value")
+        return negated, field_name, value.casefold()
+
+    if re.match(r"^price[<>=]", token):
+        match = re.fullmatch(r"price(<=|>=|<|>|=)([0-9]+)", token)
+        if not match:
+            raise ShopError("invalid price comparison")
+        try:
+            price = int(match.group(2))
+        except ValueError as exc:
+            raise ShopError("invalid price comparison") from exc
+        return negated, "price", (_PRICE_OPERATORS[match.group(1)], price)
+
+    return negated, "name", token.casefold()
+
+
+def _matches(product: Product, term: tuple) -> bool:
+    negated, field_name, value = term
+    if field_name == "price":
+        compare, price = value
+        matched = compare(product.price_cents, price)
+    elif field_name == "name":
+        matched = value in product.name.casefold()
+    else:
+        candidates = [product.sku] if field_name == "sku" else product.tags
+        if value.endswith("*"):
+            matched = any(candidate.casefold().startswith(value[:-1]) for candidate in candidates)
+        else:
+            matched = any(candidate.casefold() == value for candidate in candidates)
+    return not matched if negated else matched
