@@ -0,0 +1,64 @@
+import pytest
+
+from shoplib.errors import ShopError
+from shoplib.search import Product, search
+
+
+@pytest.fixture
+def products():
+    return [
+        Product("MUG-BLUE", "Blue Ceramic Mug", 1000, ["Sale", "Kitchen"]),
+        Product("MUG-RED", "Red Mug", 1500, ["Kitchen"]),
+        Product("BOWL", "Blue Bowl", 500, ["sale", "star*tag"]),
+        Product("MUG-*SPECIAL", "Blue Mug", 1000, []),
+    ]
+
+
+def test_blank_query_returns_all_in_order(products):
+    assert search(products, " \t\n") == products
+    assert search(products, "") == products
+    assert search(products, "") is not products
+
+
+def test_words_phrases_and_fields_combine(products):
+    assert search(products, 'BLUE mug tag:KITCHEN') == [products[0]]
+    assert search(products, 'name:"blue ceramic"') == [products[0]]
+    assert search(products, '"Blue Bowl"') == [products[2]]
+    assert search(products, 'sku:mug-red') == [products[1]]
+    assert search(products, 'tag:sale') == [products[0], products[2]]
+
+
+def test_prefixes_and_literal_asterisks(products):
+    assert search(products, 'sku:mug-*') == [products[0], products[1], products[3]]
+    assert search(products, 'tag:kit*') == [products[0], products[1]]
+    assert search(products, 'sku:MUG-*SPECIAL') == [products[3]]
+    assert search(products, 'tag:star*tag') == [products[2]]
+    assert search(products, 'name:mug*') == []
+
+
+@pytest.mark.parametrize(
+    ('query', 'indices'),
+    [('price<1000', [2]), ('price<=1000', [0, 2, 3]),
+     ('price>1000', [1]), ('price>=1000', [0, 1, 3]),
+     ('price=1000', [0, 3]), ('-price>=1000', [2])],
+)
+def test_price_comparisons(products, query, indices):
+    assert search(products, query) == [products[index] for index in indices]
+
+
+def test_negation_and_quoted_field_values(products):
+    assert search(products, 'mug -tag:sale -sku:mug-red') == [products[3]]
+    assert search(products, '-"blue mug"') == products[:3]
+    assert search(products, 'tag:"star*tag"') == [products[2]]
+
+
+@pytest.mark.parametrize('query', [
+    'color:blue', 'price:5', 'tag:', 'name:""', '-', '-""',
+    '"unclosed', 'name:"unclosed', 'price>=', 'price=1.5',
+    'price<abc', 'price>=-1', 'price==5',
+])
+def test_invalid_query_raises_shop_error_even_without_matches(products, query):
+    with pytest.raises(ShopError):
+        search([], query)
+    with pytest.raises(ShopError):
+        search(products, 'no-such-name ' + query)
