@@ -0,0 +1,51 @@
+import pytest
+
+from shoplib.search import Product, search
+
+
+@pytest.fixture
+def products():
+    return [
+        Product("MUG-001", "Blue Ceramic Mug", 1250, ["Kitchen", "Sale"]),
+        Product("MUG-002", "Blue Travel Cup", 900, ["Kitchen"]),
+        Product("BOOK-001", "Blue Mug Guide", 1500, ["Books", "SALE"]),
+    ]
+
+
+def test_empty_query_and_bare_words_match_in_order(products):
+    assert search(products, " \t\n") == products
+    assert search(products, "blue mug") == [products[0], products[2]]
+    assert search(products, '"blue mug"') == [products[2]]
+
+
+def test_fields_and_quoted_values(products):
+    assert search(products, "sku:mug-001") == [products[0]]
+    assert search(products, "tag:kitchen") == products[:2]
+    assert search(products, "tag:sal*") == [products[0], products[2]]
+    assert search(products, 'name:"mug"') == [products[0], products[2]]
+    assert search(products, 'name:"blue travel"') == [products[1]]
+
+
+def test_price_comparisons_and_negation(products):
+    assert search(products, "price>=1250") == [products[0], products[2]]
+    assert search(products, "price<1000") == [products[1]]
+    assert search(products, "-tag:sale") == [products[1]]
+    assert search(products, '-"blue mug"') == [products[0], products[1]]
+
+
+@pytest.mark.parametrize(
+    "query",
+    [
+        "other:value",
+        "price:5",
+        "tag:",
+        "-",
+        '"unclosed',
+        "price>=",
+        "price<1.5",
+        "price=+1",
+    ],
+)
+def test_invalid_queries_raise_value_error(products, query):
+    with pytest.raises(ValueError):
+        search(products, query)
