 from shoplib.reports import sales_summary, to_csv
 
 SALES = [
@@ -16,3 +19,25 @@ def test_summary():
 
 def test_csv():
     assert to_csv(sales_summary(SALES)) == "sku,name,units,revenue_cents\nA,Mug,3,1350\nB,Bowl,1,900\n"
+
+
+def test_csv_quotes_special_characters_in_every_column():
+    rows = [
+        {"sku": "A,B", "name": 'A "large" mug', "units": "1\n2", "revenue_cents": "3\r4"},
+        {"sku": '', "name": 'comma, quote" and\r\nnewline', "units": 0, "revenue_cents": None},
+    ]
+    output = to_csv(rows)
+    assert output == (
+        'sku,name,units,revenue_cents\n'
+        '"A,B","A ""large"" mug","1\n2","3\r4"\n'
+        ',"comma, quote"" and\r\nnewline",0,None\n'
+    )
+    assert list(csv.reader(io.StringIO(output, newline=""))) == [
+        ["sku", "name", "units", "revenue_cents"],
+        ["A,B", 'A "large" mug', "1\n2", "3\r4"],
+        ["", 'comma, quote" and\r\nnewline', "0", "None"],
+    ]
+
+
+def test_csv_empty_rows_keeps_header():
+    assert to_csv([]) == "sku,name,units,revenue_cents\n"
