+++ b/tests/test_storedays.py
@@ -0,0 +1,47 @@
+import pytest
+
+from shoplib.errors import ShopError
+from shoplib.storedays import daily_revenue
+
+
+def test_daily_revenue_uses_store_day_boundary_and_fills_gaps():
+    sales = [
+        {"at": "2026-11-18T02:30:00+08:00", "cents": 900},
+        {"at": "2026-11-18T04:00:00+08:00", "cents": 500},
+        {"at": "2026-11-20T12:00:00+08:00", "cents": -100},
+    ]
+
+    assert daily_revenue(sales) == [
+        ("2026-11-17", 900),
+        ("2026-11-18", 500),
+        ("2026-11-19", 0),
+        ("2026-11-20", -100),
+    ]
+
+
+def test_daily_revenue_converts_timestamp_to_configured_local_offset():
+    sales = [{"at": "2026-11-17T20:30:00Z", "cents": 250}]
+
+    assert daily_revenue(sales, utc_offset_hours=-5, day_starts_hour=0) == [
+        ("2026-11-17", 250)
+    ]
+
+
+def test_daily_revenue_empty_input():
+    assert daily_revenue([]) == []
+
+
+@pytest.mark.parametrize(
+    "sales,kwargs",
+    [
+        ([{"at": "2026-11-18T04:00:00", "cents": 10}], {}),
+        ([{"at": "not-a-timestampZ", "cents": 10}], {}),
+        ([{"at": "2026-11-18T04:00:00Z", "cents": 1.5}], {}),
+        ([{"at": "2026-11-18T04:00:00Z"}], {}),
+        ([], {"day_starts_hour": 24}),
+        ([], {"utc_offset_hours": 8.0}),
+    ],
+)
+def test_daily_revenue_rejects_invalid_arguments(sales, kwargs):
+    with pytest.raises(ShopError):
+        daily_revenue(sales, **kwargs)
