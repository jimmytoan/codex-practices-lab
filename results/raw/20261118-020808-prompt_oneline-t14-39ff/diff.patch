@@ -0,0 +1,56 @@
+import pytest
+
+from shoplib.errors import ShopError
+from shoplib.storedays import daily_revenue
+
+
+def test_store_day_boundaries_refunds_and_empty_days():
+    sales = [
+        {"at": "2026-11-20T04:00:00+08:00", "cents": 300},
+        {"at": "2026-11-17T18:30:00Z", "cents": 500},  # 02:30 local
+        {"at": "2026-11-17T20:00:00Z", "cents": 200},  # 04:00 local
+        {"at": "2026-11-18T03:59:59+08:00", "cents": -50},
+        {"at": "2026-11-17T15:00:00-05:00", "cents": -25},
+    ]
+    assert daily_revenue(sales) == [
+        ("2026-11-17", 450),
+        ("2026-11-18", 175),
+        ("2026-11-19", 0),
+        ("2026-11-20", 300),
+    ]
+
+
+def test_custom_offset_and_start_across_year_boundary():
+    sales = [
+        {"at": "2027-01-01T05:59:00Z", "cents": 1},
+        {"at": "2027-01-01T06:00:00Z", "cents": 2},
+    ]
+    assert daily_revenue(sales, utc_offset_hours=-5, day_starts_hour=1) == [
+        ("2026-12-31", 1), ("2027-01-01", 2)
+    ]
+
+
+def test_empty_sales():
+    assert daily_revenue([]) == []
+
+
+@pytest.mark.parametrize("timestamp", [
+    "2026-11-18T02:30:00", "2026-11-18T02:30:00+0800", "invalidZ",
+    "2026-13-18T02:30:00Z", "2026-11-18+04:00",
+])
+def test_invalid_or_unzoned_timestamps_raise_shop_error(timestamp):
+    with pytest.raises(ShopError):
+        daily_revenue([{"at": timestamp, "cents": 1}])
+
+
+@pytest.mark.parametrize("sales, offset, start", [
+    (None, 8, 4),
+    ([{}], 8, 4),
+    ([{"at": "2026-11-18T00:00:00Z", "cents": 1.5}], 8, 4),
+    ([], 8.5, 4),
+    ([], 8, -1),
+    ([], 8, 24),
+])
+def test_invalid_arguments_raise_shop_error(sales, offset, start):
+    with pytest.raises(ShopError):
+        daily_revenue(sales, offset, start)
