+
+def test_apply_coupons_combines_best_percent_and_all_eligible_fixed():
+    coupons = [
+        Coupon("TEN", "percent", 10),
+        Coupon("TWENTY", "percent", 20),
+        Coupon("A-FIVE", "fixed", 500),
+        Coupon("B-FIVE", "fixed", 500),
+    ]
+
+    assert apply_coupons(5000, coupons, date(2026, 1, 1)) == (
+        3000,
+        ["A-FIVE", "B-FIVE", "TWENTY"],
+    )
+
+
+def test_apply_coupons_percent_tie_breaks_by_code():
+    coupons = [Coupon("ZED", "percent", 15), Coupon("ALPHA", "percent", 15)]
+
+    assert apply_coupons(1000, coupons, date(2026, 1, 1)) == (850, ["ALPHA"])
+
+
+def test_apply_coupons_eligibility_uses_original_subtotal_and_includes_expiry_day():
+    coupons = [
+        Coupon("VALID", "fixed", 100, expires=date(2026, 1, 1), min_subtotal_cents=1000),
+        Coupon("TOO-LATE", "fixed", 200, expires=date(2025, 12, 31)),
+        Coupon("TOO-HIGH-MIN", "fixed", 300, min_subtotal_cents=1001),
+    ]
+
+    assert apply_coupons(1000, coupons, date(2026, 1, 1)) == (900, ["VALID"])
+
+
+def test_apply_coupons_clamps_total_at_zero():
+    coupons = [Coupon("BIG", "fixed", 1000)]
+
+    assert apply_coupons(100, coupons, date(2026, 1, 1)) == (0, ["BIG"])
+
+
+def test_apply_coupons_rejects_negative_subtotal():
