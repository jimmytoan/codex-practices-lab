diff --git a/src/shoplib/invoice.py b/src/shoplib/invoice.py
index 5d1398c..ebc104c 100644
--- a/src/shoplib/invoice.py
+++ b/src/shoplib/invoice.py
@@ -1,5 +1,8 @@
 """Invoices: coupon allocation and tax. See docs/invoicing.md."""
 
+from .errors import ShopError
+from .money import percent_of
+
 # Tax rates in percent, by region and product category.
 TAX_RATES = {
     "DE": {"standard": 19, "food": 7, "books": 7},
@@ -10,4 +13,70 @@ TAX_RATES = {
 
 def build_invoice(lines, coupon_cents: int, shipping_cents: int, region: str) -> dict:
     """Build an invoice for an order. See docs/invoicing.md."""
-    raise NotImplementedError
+    if not isinstance(region, str) or region not in TAX_RATES:
+        raise ShopError(f"unknown region {region!r}")
+    if not isinstance(lines, (list, tuple)) or not lines:
+        raise ShopError("lines must not be empty")
+    if not _is_integer(coupon_cents) or coupon_cents < 0:
+        raise ShopError("coupon must be a non-negative integer amount")
+    if not _is_integer(shipping_cents) or shipping_cents < 0:
+        raise ShopError("shipping must be a non-negative integer amount")
+
+    rates = TAX_RATES[region]
+    line_data = []
+    for line in lines:
+        if not isinstance(line, (list, tuple)) or len(line) != 4:
+            raise ShopError("each line must contain sku, price, quantity and category")
+        sku, unit_price_cents, qty, category = line
+        if not _is_integer(unit_price_cents) or unit_price_cents < 0:
+            raise ShopError("price must be a non-negative integer amount")
+        if not _is_integer(qty) or qty < 1:
+            raise ShopError("quantity must be an integer of at least 1")
+        if not isinstance(category, str) or category not in rates:
+            raise ShopError(f"unknown category {category!r} for region {region}")
+        line_data.append((sku, unit_price_cents * qty, rates[category]))
+
+    total_gross = sum(gross for _, gross, _ in line_data)
+    coupon = min(coupon_cents, total_gross)
+    discounts = [0] * len(line_data)
+    if total_gross:
+        remainders = []
+        allocated = 0
+        for index, (_, gross, _) in enumerate(line_data):
+            discount, remainder = divmod(coupon * gross, total_gross)
+            discounts[index] = discount
+            allocated += discount
+            remainders.append((remainder, index))
+        for _, index in sorted(remainders, key=lambda item: (-item[0], item[1]))[:coupon - allocated]:
+            discounts[index] += 1
+
+    invoice_lines = []
+    has_taxable_category = False
+    for (sku, gross, rate), discount in zip(line_data, discounts):
+        net = gross - discount
+        invoice_lines.append({
+            "sku": sku,
+            "gross_cents": gross,
+            "discount_cents": discount,
+            "net_cents": net,
+            "tax_cents": percent_of(net, rate),
+        })
+        has_taxable_category = has_taxable_category or rate > 0
+
+    shipping_tax = percent_of(shipping_cents, rates["standard"]) if has_taxable_category else 0
+    total = (
+        sum(line["net_cents"] + line["tax_cents"] for line in invoice_lines)
+        + shipping_cents
+        + shipping_tax
+    )
+    return {
+        "lines": invoice_lines,
+        "shipping_cents": shipping_cents,
+        "shipping_tax_cents": shipping_tax,
+        "total_cents": total,
+    }
+
+
+def _is_integer(value) -> bool:
+    """Return whether a value is an integer amount, excluding booleans."""
+    return isinstance(value, int) and not isinstance(value, bool)
diff --git a/tests/test_invoice.py b/tests/test_invoice.py
