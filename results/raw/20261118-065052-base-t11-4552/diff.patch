@@ -0,0 +1,87 @@
+import pytest
+
+from shoplib.errors import ShopError
+from shoplib.invoice import build_invoice
+
+
+def test_coupon_is_split_by_largest_remainder_and_ties_keep_input_order():
+    invoice = build_invoice(
+        [("A", 1, 1, "books"), ("B", 1, 1, "books"), ("C", 1, 1, "books")],
+        coupon_cents=2,
+        shipping_cents=0,
+        region="OR",
+    )
+
+    assert [line["discount_cents"] for line in invoice["lines"]] == [1, 1, 0]
+    assert sum(line["discount_cents"] for line in invoice["lines"]) == 2
+
+
+def test_coupon_split_is_proportional_and_capped_at_gross():
+    invoice = build_invoice(
+        [("A", 100, 1, "books"), ("B", 300, 1, "books")],
+        coupon_cents=900,
+        shipping_cents=0,
+        region="OR",
+    )
+
+    assert [line["discount_cents"] for line in invoice["lines"]] == [100, 300]
+    assert [line["net_cents"] for line in invoice["lines"]] == [0, 0]
+    assert invoice["total_cents"] == 0
+
+
+def test_coupon_with_zero_gross_allocates_no_discount():
+    invoice = build_invoice(
+        [("A", 0, 1, "books"), ("B", 0, 2, "food")],
+        coupon_cents=50,
+        shipping_cents=0,
+        region="DE",
+    )
+
+    assert [line["discount_cents"] for line in invoice["lines"]] == [0, 0]
+
+
+def test_tax_is_rounded_per_line_and_shipping_tax_uses_standard_rate():
+    invoice = build_invoice(
+        [("A", 10, 1, "food"), ("B", 10, 1, "food"), ("C", 100, 1, "books")],
+        coupon_cents=0,
+        shipping_cents=100,
+        region="DE",
+    )
+
+    assert [line["tax_cents"] for line in invoice["lines"]] == [1, 1, 7]
+    assert invoice["shipping_tax_cents"] == 19
+    assert invoice["total_cents"] == 248
+
+
+def test_shipping_is_not_taxed_when_every_line_rate_is_zero():
+    invoice = build_invoice(
+        [("A", 100, 1, "books")],
+        coupon_cents=0,
+        shipping_cents=200,
+        region="OR",
+    )
+
+    assert invoice["shipping_tax_cents"] == 0
+    assert invoice["total_cents"] == 300
+
+
+@pytest.mark.parametrize(
+    "args",
+    [
+        ([("A", 100, 1, "books")], 0, 0, "XX"),
+        ([("A", 100, 1, "clothing")], 0, 0, "DE"),
+        ([], 0, 0, "DE"),
+        ([("A", 100, 0, "books")], 0, 0, "DE"),
+        ([("A", -1, 1, "books")], 0, 0, "DE"),
+        ([("A", 100, 1, "books")], -1, 0, "DE"),
+        ([("A", 100, 1, "books")], 0, -1, "DE"),
+    ],
+)
+def test_invalid_invoice_inputs_raise_value_error(args):
+    with pytest.raises(ValueError):
+        build_invoice(*args)
+
+
+def test_invalid_invoice_inputs_use_shop_error():
+    with pytest.raises(ShopError):
+        build_invoice([], 0, 0, "DE")
