@@ -1,6 +1,7 @@
 import pytest
 
 from shoplib.cart import Cart
+from shoplib.errors import ShopError
 
 
 def test_add_and_subtotal():
@@ -21,3 +22,29 @@ def test_add_same_sku_merges():
 def test_bad_qty():
     with pytest.raises(ValueError):
         Cart().add("A", 250, 0)
+
+
+def test_bulk_discount_applies_per_line_and_rounds_half_up():
+    cart = Cart()
+    cart.add("under", 1, 9)
+    cart.add("threshold", 1, 10)
+    cart.add("over", 101, 11)
+
+    assert cart.line_total("under") == 9
+    assert cart.line_total("threshold") == 9
+    assert cart.line_total("over") == 1055
+    assert cart.subtotal() == 1073
+
+
+def test_adding_same_sku_can_reach_bulk_threshold():
+    cart = Cart()
+    cart.add("A", 250, 9)
+    assert cart.line_total("A") == 2250
+    cart.add("A", 250)
+    assert cart.line_total("A") == 2375
+    assert cart.subtotal() == 2375
+
+
+def test_missing_line_total_raises_shop_error():
+    with pytest.raises(ShopError):
+        Cart().line_total("missing")
