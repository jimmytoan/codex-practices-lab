@@ -0,0 +1,67 @@
+import pytest
+
+from shoplib.search import Product, search
+
+
+@pytest.fixture
+def products():
+    return [
+        Product("MUG-RED", "Blue Mug Large", 1250, ["sale", "Kitchen"]),
+        Product("mug-blue", "Blue kettle", 900, ["featured", "kitchen"]),
+        Product("CUP", "Travel mug blue", 1000, ["sale-kit"]),
+    ]
+
+
+def test_bare_terms_and_quoted_phrases(products):
+    assert search(products, "blue mug") == [products[0], products[2]]
+    assert search(products, '"blue mug"') == [products[0]]
+    assert search(products, 'name:"mug blue"') == [products[2]]
+    assert search(products, "  \t ") == products
+
+
+def test_fields_prefixes_and_negation(products):
+    assert search(products, "sku:mug-red") == [products[0]]
+    assert search(products, "sku:MUG-*") == products[:2]
+    assert search(products, "tag:KIT*") == products[:2]
+    assert search(products, "name:MUG") == [products[0], products[2]]
+    assert search(products, "-tag:sale") == [products[1], products[2]]
+    assert search(products, '-"blue mug"') == [products[1], products[2]]
+
+
+def test_star_is_ordinary_except_at_the_end_of_sku_or_tag_value():
+    product = Product("MUG*X", "Star mug", 100, ["sale*now"])
+    assert search([product], "sku:MUG*X") == [product]
+    assert search([product], "tag:sale*now") == [product]
+
+
+@pytest.mark.parametrize(
+    ("term", "expected"),
+    [
+        ("price<1000", [1]),
+        ("price<=1000", [1, 2]),
+        ("price>1000", [0]),
+        ("price>=1000", [0, 2]),
+        ("price=1000", [2]),
+    ],
+)
+def test_price_comparisons(products, term, expected):
+    assert search(products, term) == [products[i] for i in expected]
+
+
+@pytest.mark.parametrize(
+    "query",
+    [
+        "other:value",
+        "price:5",
+        "price>=",
+        "price>=1.5",
+        'price>="oops"',
+        "tag:",
+        'tag:""',
+        "-",
+        '"unclosed',
+    ],
+)
+def test_invalid_queries_raise_value_error(query):
+    with pytest.raises(ValueError):
+        search([], query)
