@@ -0,0 +1,68 @@
+import pytest
+
+from shoplib.errors import ShopError
+from shoplib.invoice import build_invoice
+
+
+def test_coupon_allocation_and_per_line_tax():
+    invoice = build_invoice(
+        [("a", 250, 2, "standard"), ("b", 300, 1, "food"),
+         ("c", 200, 1, "books")],
+        7, 100, "DE",
+    )
+    assert invoice == {
+        "lines": [
+            {"sku": "a", "gross_cents": 500, "discount_cents": 4,
+             "net_cents": 496, "tax_cents": 94},
+            {"sku": "b", "gross_cents": 300, "discount_cents": 2,
+             "net_cents": 298, "tax_cents": 21},
+            {"sku": "c", "gross_cents": 200, "discount_cents": 1,
+             "net_cents": 199, "tax_cents": 14},
+        ],
+        "shipping_cents": 100,
+        "shipping_tax_cents": 19,
+        "total_cents": 1241,
+    }
+
+
+def test_equal_remainders_favor_earlier_lines():
+    invoice = build_invoice([(sku, 1, 1, "books") for sku in "abc"], 2, 0, "SG")
+    assert [line["discount_cents"] for line in invoice["lines"]] == [1, 1, 0]
+    assert invoice["total_cents"] == 1
+
+
+def test_coupon_is_capped_and_shipping_tax_depends_on_category():
+    invoice = build_invoice([("a", 100, 1, "standard"), ("b", 50, 1, "books")],
+                            500, 100, "SG")
+    assert [line["discount_cents"] for line in invoice["lines"]] == [100, 50]
+    assert invoice["shipping_tax_cents"] == 9
+    assert invoice["total_cents"] == 109
+
+
+def test_zero_gross_and_tax_exempt_shipping():
+    invoice = build_invoice([("a", 0, 2, "books"), ("b", 0, 1, "books")],
+                            20, 100, "SG")
+    assert [line["discount_cents"] for line in invoice["lines"]] == [0, 0]
+    assert invoice["shipping_tax_cents"] == 0
+    assert invoice["total_cents"] == 100
+
+
+def test_line_tax_rounds_half_up_before_summing():
+    invoice = build_invoice([("a", 50, 1, "standard"), ("b", 50, 1, "standard")],
+                            0, 0, "DE")
+    assert [line["tax_cents"] for line in invoice["lines"]] == [10, 10]
+    assert invoice["total_cents"] == 120
+
+
+@pytest.mark.parametrize("lines,coupon,shipping,region", [
+    ([("a", 1, 1, "standard")], 0, 0, "unknown"),
+    ([("a", 1, 1, "unknown")], 0, 0, "DE"),
+    ([], 0, 0, "DE"),
+    ([("a", 1, 0, "standard")], 0, 0, "DE"),
+    ([("a", -1, 1, "standard")], 0, 0, "DE"),
+    ([("a", 1, 1, "standard")], -1, 0, "DE"),
+    ([("a", 1, 1, "standard")], 0, -1, "DE"),
+])
+def test_invalid_arguments_raise_shop_error(lines, coupon, shipping, region):
+    with pytest.raises(ShopError):
+        build_invoice(lines, coupon, shipping, region)
