+
+
+def test_split_first_fit_decreasing_and_sku_ties():
+    items = [("z", 4, 2), ("b", 6, 1), ("a", 6, 1), ("c", 2, 1)]
+    assert split_parcels(items, 10) == [["a", "z"], ["b", "z"], ["c"]]
+
+
+def test_split_fills_first_available_parcel():
+    assert split_parcels([("a", 8, 1), ("b", 7, 1), ("c", 3, 1),
+                          ("d", 2, 1)], 10) == [["a", "d"], ["b", "c"]]
+
+
+@pytest.mark.parametrize("items, limit", [
+    ([("a", 0, 1)], 10), ([("a", -1, 1)], 10),
+    ([("a", 1, 0)], 10), ([("a", 1, -1)], 10),
+    ([("a", 11, 1)], 10), ([("a", 1, 1)], 0),
+])
+def test_invalid_items(items, limit):
+    with pytest.raises(ShopError):
+        split_parcels(items, limit)
+    with pytest.raises(ShopError):
+        shipment_cost(items, limit)
+
+
+def test_empty_shipment():
+    assert split_parcels([], 0) == []
+    assert shipment_cost([], 0) == 0
+
+
+def test_shipment_cost_tracks_repeated_sku_with_different_weights():
+    items = [("x", 1100, 1), ("y", 900, 1), ("x", 400, 1)]
+    assert split_parcels(items, 1500) == [["x", "x"], ["y"]]
+    assert shipment_cost(items, 1500) == shipping_cost(1500) + shipping_cost(900)
+
+
+def test_shipment_cost_propagates_shipping_cost_error():
