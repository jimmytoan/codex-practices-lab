 import pytest
 
+from shoplib.errors import ShopError
 from shoplib.inventory import Inventory
 
 
@@ -18,3 +19,28 @@ def test_cannot_reserve_more_than_available():
     inv.receive("A", 2)
     with pytest.raises(ValueError):
         inv.reserve("A", 3)
+
+
+def test_release_restores_availability_without_changing_on_hand():
+    inv = Inventory()
+    inv.receive("A", 10)
+    inv.reserve("A", 4)
+
+    inv.release("A", 2)
+    assert (inv.on_hand("A"), inv.reserved("A"), inv.available("A")) == (10, 2, 8)
+
+    inv.release("A", 2)
+    assert (inv.on_hand("A"), inv.reserved("A"), inv.available("A")) == (10, 0, 10)
+
+
+@pytest.mark.parametrize("sku, qty", [("A", 0), ("A", -1), ("A", 3), ("missing", 1)])
+def test_invalid_release_leaves_inventory_unchanged(sku, qty):
+    inv = Inventory()
+    inv.receive("A", 5)
+    inv.reserve("A", 2)
+
+    with pytest.raises(ShopError):
+        inv.release(sku, qty)
+
+    assert (inv.on_hand("A"), inv.reserved("A"), inv.available("A")) == (5, 2, 3)
+    assert (inv.on_hand("missing"), inv.reserved("missing")) == (0, 0)
