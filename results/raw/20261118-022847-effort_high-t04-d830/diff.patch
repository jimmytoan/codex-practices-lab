 import pytest
 
+from shoplib.errors import ShopError
 from shoplib.inventory import Inventory
-from shoplib.orders import DELIVERED, NEW, Order
+from shoplib.orders import CANCELLED, DELIVERED, NEW, PAID, SHIPPED, Order
 
 
 def make():
@@ -25,3 +26,74 @@ def test_cannot_ship_unpaid():
     _, order = make()
     with pytest.raises(ValueError):
         order.ship()
+
+
+@pytest.mark.parametrize("paid", [False, True])
+def test_cancel_releases_all_lines_and_sets_refund_only_for_paid_orders(paid):
+    inv = Inventory()
+    inv.receive("A", 5)
+    inv.receive("B", 4)
+    order = Order("o1", {"A": 2, "B": 3}, inv)
+    other = Order("o2", {"A": 1, "B": 1}, inv)
+    if paid:
+        order.pay()
+
+    order.cancel()
+
+    assert order.state == CANCELLED
+    assert order.refund_due is paid
+    assert (inv.on_hand("A"), inv.reserved("A"), inv.available("A")) == (5, 1, 4)
+    assert (inv.on_hand("B"), inv.reserved("B"), inv.available("B")) == (4, 1, 3)
+    assert other.state == NEW
+
+    order.cancel()
+    assert order.state == CANCELLED
+    assert order.refund_due is paid
+    assert (inv.reserved("A"), inv.reserved("B")) == (1, 1)
+
+
+@pytest.mark.parametrize("delivered", [False, True])
+def test_cannot_cancel_shipped_or_delivered_order(delivered):
+    inv, order = make()
+    order.pay()
+    order.ship()
+    if delivered:
+        order.deliver()
+    before = (inv.on_hand("A"), inv.reserved("A"), inv.available("A"), order.refund_due)
+
+    with pytest.raises(ShopError):
+        order.cancel()
+
+    assert order.state == (DELIVERED if delivered else SHIPPED)
+    assert (inv.on_hand("A"), inv.reserved("A"), inv.available("A"), order.refund_due) == before
+
+
+@pytest.mark.parametrize("paid", [False, True])
+def test_failed_cancel_restores_previously_released_lines(paid):
+    inv = Inventory()
+    inv.receive("A", 3)
+    inv.receive("B", 3)
+    order = Order("o1", {"A": 2, "B": 2}, inv)
+    if paid:
+        order.pay()
+    inv.release("B", 1)
+    before = [(inv.on_hand(sku), inv.reserved(sku), inv.available(sku)) for sku in ("A", "B")]
+
+    with pytest.raises(ShopError):
+        order.cancel()
+
+    assert order.state == (PAID if paid else NEW)
+    assert order.refund_due is False
+    assert [(inv.on_hand(sku), inv.reserved(sku), inv.available(sku)) for sku in ("A", "B")] == before
+
+
+@pytest.mark.parametrize("operation", ["pay", "ship", "deliver"])
+def test_cannot_advance_cancelled_order(operation):
+    inv, order = make()
+    order.cancel()
+
+    with pytest.raises(ValueError):
+        getattr(order, operation)()
+
+    assert order.state == CANCELLED
+    assert (inv.on_hand("A"), inv.reserved("A"), inv.available("A")) == (5, 0, 5)
