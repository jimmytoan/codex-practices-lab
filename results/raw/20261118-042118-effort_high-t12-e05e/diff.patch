@@ -0,0 +1,72 @@
+import pytest
+
+from shoplib.errors import ShopError
+from shoplib.search import Product, search
+
+
+@pytest.fixture
+def products():
+    return [
+        Product("MUG-01", "Blue Mug", 1250, ["drinkware", "sale"]),
+        Product("MUG-02", "BLUE ceramic cup", 900, ["drinkware"]),
+        Product("PLATE-01", "Blue plate", 1500, ["tableware", "sale"]),
+    ]
+
+
+def test_bare_words_and_quoted_phrases_are_case_insensitive(products):
+    assert search(products, "blue mug") == [products[0]]
+    assert search(products, '"blue mug"') == [products[0]]
+    assert search(products, 'name:"blue ce"') == [products[1]]
+    assert search(products, '"BLUE ceramic"') == [products[1]]
+
+
+def test_fields_prefixes_and_ordinary_asterisks(products):
+    assert search(products, "sku:mug-01") == [products[0]]
+    assert search(products, "sku:MUG-*") == products[:2]
+    assert search(products, "tag:SALE") == [products[0], products[2]]
+    assert search(products, "tag:drink*") == products[:2]
+    assert search(products, "sku:MUG*01") == []
+    assert search(products, "name:blue*") == []
+    literal_star = Product("MUG*01", "Star Mug", 700)
+    assert search([products[0], literal_star], "sku:MUG*01") == [literal_star]
+
+
+def test_price_comparisons_and_negation(products):
+    assert search(products, "price>=1000") == [products[0], products[2]]
+    assert search(products, "price<900") == []
+    assert search(products, "price<=900") == [products[1]]
+    assert search(products, "price>1250") == [products[2]]
+    assert search(products, "price=900") == [products[1]]
+    assert search(products, "blue -tag:sale") == [products[1]]
+    assert search(products, "-\"Blue mug\"") == products[1:]
+    assert search(products, "-price>1000") == [products[1]]
+
+
+def test_empty_query_matches_all_products(products):
+    assert search(products, "") == products
+    assert search(products, " \t\n") == products
+
+
+@pytest.mark.parametrize(
+    "query",
+    [
+        "price:5",
+        "category:drinkware",
+        "price>=one",
+        "price>=1.5",
+        "price=",
+        "tag:",
+        'name:""',
+        "-",
+        '"unclosed',
+        'name:"unclosed',
+    ],
+)
+def test_invalid_queries_raise_value_error(products, query):
+    with pytest.raises(ValueError):
+        search(products, query)
+
+
+def test_invalid_queries_use_shop_error(products):
+    with pytest.raises(ShopError):
+        search(products, "sku:")
