+
+def test_apply_coupons_keeps_coupon_valid_on_expiration_date():
+    today = date(2026, 5, 1)
+    coupon = Coupon("TODAY", "fixed", 100, expires=today)
+
+    assert apply_coupons(500, [coupon], today) == (400, ["TODAY"])
+
+
+def test_apply_coupons_selects_highest_percent_then_code_order():
+    coupons = [
+        Coupon("ZED", "percent", 20),
+        Coupon("BETA", "percent", 20),
+        Coupon("ALPHA", "percent", 10),
+    ]
+
+    assert apply_coupons(1000, coupons, date(2026, 5, 1)) == (800, ["BETA"])
+
+
+def test_apply_coupons_uses_original_subtotal_for_minimum_and_percent():
+    coupons = [
+        Coupon("PCT", "percent", 25),
+        Coupon("FIX", "fixed", 200, min_subtotal_cents=1000),
+        Coupon("TOO_HIGH_MIN", "fixed", 1, min_subtotal_cents=1001),
+    ]
+
+    assert apply_coupons(1000, coupons, date(2026, 5, 1)) == (550, ["FIX", "PCT"])
+
+
+def test_apply_coupons_fixed_discounts_never_make_total_negative():
+    coupons = [Coupon("ONE", "fixed", 300), Coupon("TWO", "fixed", 400)]
+
+    assert apply_coupons(500, coupons, date(2026, 5, 1)) == (0, ["ONE", "TWO"])
+
+
+def test_apply_coupons_rejects_negative_subtotal():
