diff --git a/src/shoplib/invoice.py b/src/shoplib/invoice.py
index 5d1398c..3166691 100644
--- a/src/shoplib/invoice.py
+++ b/src/shoplib/invoice.py
@@ -1,5 +1,8 @@
 """Invoices: coupon allocation and tax. See docs/invoicing.md."""
 
+from .errors import ShopError
+from .money import percent_of
+
 # Tax rates in percent, by region and product category.
 TAX_RATES = {
     "DE": {"standard": 19, "food": 7, "books": 7},
@@ -10,4 +13,81 @@ TAX_RATES = {
 
 def build_invoice(lines, coupon_cents: int, shipping_cents: int, region: str) -> dict:
     """Build an invoice for an order. See docs/invoicing.md."""
-    raise NotImplementedError
+    if not isinstance(region, str) or region not in TAX_RATES:
+        raise ShopError("unknown region")
+
+    rates = TAX_RATES[region]
+    try:
+        invoice_lines = list(lines)
+    except TypeError as exc:
+        raise ShopError("lines must be iterable") from exc
+    if not invoice_lines:
+        raise ShopError("lines must not be empty")
+
+    if not _is_integer(coupon_cents) or coupon_cents < 0:
+        raise ShopError("coupon must be a nonnegative integer")
+    if not _is_integer(shipping_cents) or shipping_cents < 0:
+        raise ShopError("shipping must be a nonnegative integer")
+
+    parsed_lines = []
+    gross_amounts = []
+    for line in invoice_lines:
+        try:
+            sku, unit_price_cents, qty, category = line
+        except (TypeError, ValueError) as exc:
+            raise ShopError("each line must have four fields") from exc
+
+        if not _is_integer(unit_price_cents) or unit_price_cents < 0:
+            raise ShopError("price must be a nonnegative integer")
+        if not _is_integer(qty) or qty < 1:
+            raise ShopError("quantity must be an integer of at least 1")
+        if not isinstance(category, str) or category not in rates:
+            raise ShopError("unknown category")
+
+        gross = unit_price_cents * qty
+        parsed_lines.append((sku, gross, rates[category]))
+        gross_amounts.append(gross)
+
+    total_gross = sum(gross_amounts)
+    coupon = min(coupon_cents, total_gross)
+    discounts = [0] * len(parsed_lines)
+    if total_gross:
+        remainders = []
+        for index, gross in enumerate(gross_amounts):
+            discounts[index], remainder = divmod(coupon * gross, total_gross)
+            remainders.append((remainder, index))
+
+        cents_left = coupon - sum(discounts)
+        for _, index in sorted(remainders, key=lambda item: (-item[0], item[1]))[:cents_left]:
+            discounts[index] += 1
+
+    result_lines = []
+    shipping_is_taxable = False
+    for (sku, gross, rate), discount in zip(parsed_lines, discounts):
+        net = gross - discount
+        tax = percent_of(net, rate)
+        result_lines.append({
+            "sku": sku,
+            "gross_cents": gross,
+            "discount_cents": discount,
+            "net_cents": net,
+            "tax_cents": tax,
+        })
+        shipping_is_taxable = shipping_is_taxable or rate > 0
+
+    shipping_tax = percent_of(shipping_cents, rates["standard"]) if shipping_is_taxable else 0
+    total = (
+        sum(line["net_cents"] + line["tax_cents"] for line in result_lines)
+        + shipping_cents
+        + shipping_tax
+    )
+    return {
+        "lines": result_lines,
+        "shipping_cents": shipping_cents,
+        "shipping_tax_cents": shipping_tax,
+        "total_cents": total,
+    }
+
+
+def _is_integer(value) -> bool:
+    return isinstance(value, int) and not isinstance(value, bool)
diff --git a/tests/test_invoice.py b/tests/test_invoice.py
