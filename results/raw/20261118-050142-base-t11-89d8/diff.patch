+++ b/tests/test_invoice.py
@@ -0,0 +1,102 @@
+import pytest
+
+from shoplib.errors import ShopError
+from shoplib.invoice import build_invoice
+
+
+def test_coupon_is_capped_and_split_by_largest_remainder():
+    invoice = build_invoice(
+        [("a", 100, 1, "food"), ("b", 200, 1, "books"), ("c", 300, 1, "food")],
+        coupon_cents=5,
+        shipping_cents=0,
+        region="DE",
+    )
+
+    assert [line["discount_cents"] for line in invoice["lines"]] == [1, 2, 2]
+    assert sum(line["discount_cents"] for line in invoice["lines"]) == 5
+
+    capped = build_invoice([("a", 40, 1, "food"), ("b", 60, 1, "books")], 500, 0, "DE")
+    assert [line["discount_cents"] for line in capped["lines"]] == [40, 60]
+    assert [line["net_cents"] for line in capped["lines"]] == [0, 0]
+
+
+def test_equal_coupon_remainders_favor_earlier_line():
+    invoice = build_invoice(
+        [("first", 1, 1, "food"), ("second", 1, 1, "food"), ("third", 1, 1, "food")],
+        coupon_cents=1,
+        shipping_cents=0,
+        region="DE",
+    )
+
+    assert [line["discount_cents"] for line in invoice["lines"]] == [1, 0, 0]
+
+
+def test_zero_gross_lines_get_no_coupon_discount():
+    invoice = build_invoice([("a", 0, 3, "food"), ("b", 0, 1, "books")], 10, 0, "DE")
+
+    assert [line["gross_cents"] for line in invoice["lines"]] == [0, 0]
+    assert [line["discount_cents"] for line in invoice["lines"]] == [0, 0]
+
+
+def test_line_tax_uses_net_and_rounds_per_line():
+    invoice = build_invoice(
+        [("a", 8, 1, "food"), ("b", 8, 1, "books")],
+        coupon_cents=1,
+        shipping_cents=0,
+        region="DE",
+    )
+
+    assert [line["net_cents"] for line in invoice["lines"]] == [7, 8]
+    assert [line["tax_cents"] for line in invoice["lines"]] == [0, 1]
+
+
+def test_shipping_tax_depends_on_taxable_line_categories():
+    exempt_only = build_invoice([("book", 100, 1, "books")], 0, 101, "SG")
+    assert exempt_only["shipping_tax_cents"] == 0
+
+    mixed = build_invoice(
+        [("book", 100, 1, "books"), ("food", 100, 1, "food")], 0, 101, "SG"
+    )
+    assert mixed["shipping_tax_cents"] == 9
+
+    no_tax = build_invoice([("book", 100, 1, "books")], 0, 101, "OR")
+    assert no_tax["shipping_tax_cents"] == 0
+
+
+def test_invoice_total_sums_line_nets_taxes_and_shipping():
+    invoice = build_invoice([("food", 1000, 1, "food")], 100, 250, "DE")
+
+    assert invoice == {
+        "lines": [{
+            "sku": "food",
+            "gross_cents": 1000,
+            "discount_cents": 100,
+            "net_cents": 900,
+            "tax_cents": 63,
+        }],
+        "shipping_cents": 250,
+        "shipping_tax_cents": 48,
+        "total_cents": 1261,
+    }
+
+
+@pytest.mark.parametrize(
+    "lines,coupon,shipping,region",
+    [
+        ([("a", 10, 1, "food")], 0, 0, "XX"),
+        ([("a", 10, 1, "unknown")], 0, 0, "DE"),
+        ([], 0, 0, "DE"),
+        ([("a", 10, 0, "food")], 0, 0, "DE"),
+        ([("a", -1, 1, "food")], 0, 0, "DE"),
+        ([("a", 10, 1, "food")], -1, 0, "DE"),
+        ([("a", 10, 1, "food")], 0, -1, "DE"),
+    ],
+)
+def test_invalid_invoice_inputs_raise_value_error(lines, coupon, shipping, region):
+    with pytest.raises(ValueError):
+        build_invoice(lines, coupon, shipping, region)
+
+
+def test_invalid_inputs_use_shop_error_subclass():
+    with pytest.raises(ShopError):
+        build_invoice([], 0, 0, "DE")
