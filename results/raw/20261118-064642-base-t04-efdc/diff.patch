@@ -1,6 +1,7 @@
 """Orders and their life cycle. See docs/order-states.md."""
 
 from .inventory import Inventory
+from .errors import ShopError
 
 NEW = "NEW"
 PAID = "PAID"
@@ -13,7 +14,7 @@ class Order:
     def __init__(self, order_id: str, lines: dict[str, int], inventory: Inventory):
         """Create an order for `lines` (sku -> qty) and reserve its stock."""
         if not lines:
-            raise ValueError("an order needs at least one line")
+            raise ShopError("an order needs at least one line")
         self.order_id = order_id
         self.lines = dict(lines)
         self.inventory = inventory
@@ -24,14 +25,14 @@ class Order:
             for sku, qty in self.lines.items():
                 inventory.reserve(sku, qty)
                 reserved.append((sku, qty))
-        except ValueError:
+        except ShopError:
             for sku, qty in reserved:
                 inventory._reserved[sku] -= qty
             raise
 
     def _transition(self, allowed_from: tuple[str, ...], to: str) -> None:
         if self.state not in allowed_from:
-            raise ValueError(f"cannot go from {self.state} to {to}")
+            raise ShopError(f"cannot go from {self.state} to {to}")
         self.state = to
 
     def pay(self) -> None:
@@ -39,10 +40,30 @@ class Order:
 
     def ship(self) -> None:
         if self.state != PAID:
-            raise ValueError(f"cannot go from {self.state} to {SHIPPED}")
+            raise ShopError(f"cannot go from {self.state} to {SHIPPED}")
         for sku, qty in self.lines.items():
             self.inventory.ship(sku, qty)
         self.state = SHIPPED
 
     def deliver(self) -> None:
         self._transition((SHIPPED,), DELIVERED)
+
+    def cancel(self) -> None:
+        """Cancel an unshipped order and release its reserved stock."""
+        if self.state == CANCELLED:
+            return
+        if self.state not in (NEW, PAID):
+            raise ShopError(f"cannot cancel an order in {self.state} state")
+
+        # Validate the complete order before releasing any line, so a failed
+        # cancellation leaves both inventory and order state unchanged.
+        for sku, qty in self.lines.items():
+            reserved = self.inventory.reserved(sku)
+            if qty > reserved:
+                raise ShopError(f"only {reserved} of {sku} reserved")
+
+        for sku, qty in self.lines.items():
+            self.inventory.release(sku, qty)
+        if self.state == PAID:
+            self.refund_due = True
+        self.state = CANCELLED
diff --git a/tests/test_inventory.py b/tests/test_inventory.py
index 37436c0..53292e5 100644
--- a/tests/test_inventory.py
+++ b/tests/test_inventory.py
@@ -18,3 +18,44 @@ def test_cannot_reserve_more_than_available():
     inv.receive("A", 2)
     with pytest.raises(ValueError):
         inv.reserve("A", 3)
+
+
+def test_release_returns_reserved_stock_to_available():
+    inv = Inventory()
+    inv.receive("A", 10)
+    inv.reserve("A", 4)
+
+    inv.release("A", 2)
+
+    assert inv.on_hand("A") == 10
+    assert inv.reserved("A") == 2
+    assert inv.available("A") == 8
+
+    inv.release("A", 2)
+    assert inv.reserved("A") == 0
+    assert inv.available("A") == 10
+
+
+@pytest.mark.parametrize("qty", [0, -1])
+def test_release_requires_positive_quantity(qty):
+    inv = Inventory()
+    inv.receive("A", 5)
+    inv.reserve("A", 3)
+
+    with pytest.raises(ValueError):
+        inv.release("A", qty)
+
+    assert inv.reserved("A") == 3
+    assert inv.available("A") == 2
+
+
+def test_cannot_release_more_than_reserved():
+    inv = Inventory()
+    inv.receive("A", 5)
+    inv.reserve("A", 2)
+
+    with pytest.raises(ValueError):
+        inv.release("A", 3)
+
+    assert inv.reserved("A") == 2
+    assert inv.available("A") == 3
diff --git a/tests/test_orders.py b/tests/test_orders.py
index d3835d1..45069cf 100644
--- a/tests/test_orders.py
+++ b/tests/test_orders.py
@@ -1,7 +1,7 @@
 import pytest
 
 from shoplib.inventory import Inventory
-from shoplib.orders import DELIVERED, NEW, Order
+from shoplib.orders import CANCELLED, DELIVERED, NEW, Order
 
 
 def make():
@@ -25,3 +25,77 @@ def test_cannot_ship_unpaid():
     _, order = make()
     with pytest.raises(ValueError):
         order.ship()
+
+
+def test_cancel_new_order_releases_stock_without_refund():
+    inv, order = make()
+
+    order.cancel()
+
+    assert order.state == CANCELLED
+    assert order.refund_due is False
+    assert inv.on_hand("A") == 5
+    assert inv.reserved("A") == 0
+    assert inv.available("A") == 5
+
+
+def test_cancel_paid_order_releases_stock_and_marks_refund_due():
+    inv, order = make()
+    order.pay()
+
+    order.cancel()
+
+    assert order.state == CANCELLED
+    assert order.refund_due is True
+    assert inv.on_hand("A") == 5
+    assert inv.reserved("A") == 0
+    assert inv.available("A") == 5
+
+
+def test_cancel_cancelled_order_does_nothing():
+    inv, order = make()
+    order.cancel()
+    inventory_state = (inv.on_hand("A"), inv.reserved("A"), inv.available("A"))
+
+    order.cancel()
+
+    assert order.state == CANCELLED
+    assert order.refund_due is False
+    assert (inv.on_hand("A"), inv.reserved("A"), inv.available("A")) == inventory_state
+
+
+@pytest.mark.parametrize(
+    "finalize",
+    [
+        lambda order: (order.pay(), order.ship()),
+        lambda order: (order.pay(), order.ship(), order.deliver()),
+    ],
+)
+def test_cannot_cancel_shipped_or_delivered_order(finalize):
+    inv, order = make()
+    finalize(order)
+    state = order.state
+    inventory_state = (inv.on_hand("A"), inv.reserved("A"), inv.available("A"))
+
+    with pytest.raises(ValueError):
+        order.cancel()
+
+    assert order.state == state
+    assert order.refund_due is False
+    assert (inv.on_hand("A"), inv.reserved("A"), inv.available("A")) == inventory_state
+
+
+def test_cancel_validates_all_lines_before_releasing_any_stock():
+    inv = Inventory()
+    inv.receive("A", 5)
+    inv.receive("B", 5)
+    order = Order("o2", {"A": 2, "B": 2}, inv)
+    inv._reserved["B"] = 1
+
+    with pytest.raises(ValueError):
+        order.cancel()
+
+    assert order.state == NEW
+    assert order.refund_due is False
+    assert inv.reserved("A") == 2
+    assert inv.reserved("B") == 1
