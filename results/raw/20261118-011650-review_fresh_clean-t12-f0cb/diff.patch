@@ -0,0 +1,88 @@
+import pytest
+
+from shoplib.errors import ShopError
+from shoplib.search import Product, search
+
+
+@pytest.fixture
+def products():
+    return [
+        Product("MUG-1", "Blue Mug", 1000, ["Sale", "Kitchen"]),
+        Product("mug-2", "Red Mug", 999, ["kitchenware"]),
+        Product("PLATE*3", "Blue Plate", 1500, ["sale*item"]),
+        Product("MUG-3", "Blue Mug", 1000, []),
+    ]
+
+
+@pytest.mark.parametrize(
+    ("query", "indices"),
+    [
+        ("", [0, 1, 2, 3]),
+        (" \t\n", [0, 1, 2, 3]),
+        ("mUg", [0, 1, 3]),
+        ('"BLUE mug"', [0, 3]),
+        ('name:"blue mug"', [0, 3]),
+        ("blue mug", [0, 3]),
+        ("sku:mug-1", [0]),
+        ("sku:mug-*", [0, 1, 3]),
+        ("sku:plate*3", [2]),
+        ("tag:sALE", [0]),
+        ("tag:KITCHEN*", [0, 1]),
+        ("tag:sale*item", [2]),
+        ("name:blu*", []),
+        ("-tag:sale blue", [2, 3]),
+        ('-"blue mug"', [1, 2]),
+        ("price<1000", [1]),
+        ("price<=1000", [0, 1, 3]),
+        ("price>1000", [2]),
+        ("price>=1000", [0, 2, 3]),
+        ("price=1000", [0, 3]),
+        ("-price=1000", [1, 2]),
+        ('price>="1000"', [0, 2, 3]),
+        ("price<0001000", [1]),
+    ],
+)
+def test_search_matches(products, query, indices):
+    assert search(products, query) == [products[i] for i in indices]
+
+
+@pytest.mark.parametrize(
+    "query",
+    [
+        '"unclosed',
+        'name:"unclosed',
+        "color:blue",
+        "price:5",
+        "tag:",
+        'name:""',
+        "-",
+        "-sku:",
+        "price>",
+        "price=1.5",
+        "price=-1",
+        "price=1x",
+        'price>="oops"',
+        'price>=""',
+        "mug unknown:value",
+    ],
+)
+def test_invalid_queries_raise_shop_error_even_without_products(query):
+    with pytest.raises(ShopError):
+        search([], query)
+
+
+def test_quoted_text_is_literal():
+    product = Product("other", "-tag:sale price>=5 color:blue", 0)
+    assert search([product], '"-tag:sale"') == [product]
+    assert search([product], '"price>=5"') == [product]
+    assert search([product], '"color:blue"') == [product]
+
+
+def test_arbitrarily_large_price_comparison(products):
+    assert search(products, "price<" + "9" * 5000) == products
+
+
+@pytest.mark.parametrize("query", ["STRASSE", "name:STRASSE", "sku:STRASSE", "tag:STRASSE", "sku:STRASS*", "tag:STRASS*"])
+def test_unicode_case_insensitive_matching(query):
+    product = Product("Straße", "Straße", 100, ["Straße"])
+    assert search([product], query) == [product]
