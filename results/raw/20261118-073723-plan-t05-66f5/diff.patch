+def test_csv_quotes_fields_with_csv_special_characters():
+    rows = [
+        {"sku": "A,1", "name": 'Mug "large"', "units": 2, "revenue_cents": 900},
+        {"sku": "B", "name": "Cup\nblue", "units": 1, "revenue_cents": 450},
+    ]
+    assert to_csv(rows) == (
+        'sku,name,units,revenue_cents\n'
+        '"A,1","Mug ""large""",2,900\n'
+        'B,"Cup\nblue",1,450\n'
+    )
