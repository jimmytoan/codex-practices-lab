@@ -1,5 +1,6 @@
 """Orders and their life cycle. See docs/order-states.md."""
 
+from .errors import ShopError
 from .inventory import Inventory
 
 NEW = "NEW"
@@ -13,7 +14,7 @@ class Order:
     def __init__(self, order_id: str, lines: dict[str, int], inventory: Inventory):
         """Create an order for `lines` (sku -> qty) and reserve its stock."""
         if not lines:
-            raise ValueError("an order needs at least one line")
+            raise ShopError("an order needs at least one line")
         self.order_id = order_id
         self.lines = dict(lines)
         self.inventory = inventory
@@ -24,14 +25,14 @@ class Order:
             for sku, qty in self.lines.items():
                 inventory.reserve(sku, qty)
                 reserved.append((sku, qty))
-        except ValueError:
+        except ShopError:
             for sku, qty in reserved:
                 inventory._reserved[sku] -= qty
             raise
 
     def _transition(self, allowed_from: tuple[str, ...], to: str) -> None:
         if self.state not in allowed_from:
-            raise ValueError(f"cannot go from {self.state} to {to}")
+            raise ShopError(f"cannot go from {self.state} to {to}")
         self.state = to
 
     def pay(self) -> None:
@@ -39,10 +40,31 @@ class Order:
 
     def ship(self) -> None:
         if self.state != PAID:
-            raise ValueError(f"cannot go from {self.state} to {SHIPPED}")
+            raise ShopError(f"cannot go from {self.state} to {SHIPPED}")
         for sku, qty in self.lines.items():
             self.inventory.ship(sku, qty)
         self.state = SHIPPED
 
     def deliver(self) -> None:
         self._transition((SHIPPED,), DELIVERED)
+
+    def cancel(self) -> None:
+        """Cancel an unshipped order and release its reserved stock."""
+        if self.state == CANCELLED:
+            return
+        if self.state not in (NEW, PAID):
+            raise ShopError(f"cannot cancel an order in state {self.state}")
+
+        # Check all lines first so an inconsistent reservation cannot result in
+        # only part of a multi-line order being released.
+        for sku, qty in self.lines.items():
+            if qty <= 0:
+                raise ShopError("qty must be positive")
+            if qty > self.inventory.reserved(sku):
+                raise ShopError(f"only {self.inventory.reserved(sku)} of {sku} reserved")
+
+        for sku, qty in self.lines.items():
+            self.inventory.release(sku, qty)
+
+        self.refund_due = self.state == PAID
+        self.state = CANCELLED
diff --git a/tests/test_inventory.py b/tests/test_inventory.py
index 37436c0..b6d421b 100644
--- a/tests/test_inventory.py
+++ b/tests/test_inventory.py
@@ -18,3 +18,41 @@ def test_cannot_reserve_more_than_available():
     inv.receive("A", 2)
     with pytest.raises(ValueError):
         inv.reserve("A", 3)
+
+
+def test_release_returns_reserved_stock_to_available():
+    inv = Inventory()
+    inv.receive("A", 10)
+    inv.reserve("A", 4)
+
+    inv.release("A", 3)
+
+    assert inv.on_hand("A") == 10
+    assert inv.reserved("A") == 1
+    assert inv.available("A") == 9
+
+
+@pytest.mark.parametrize("qty", [0, -1, 3])
+def test_invalid_release_changes_nothing(qty):
+    inv = Inventory()
+    inv.receive("A", 10)
+    inv.reserve("A", 2)
+
+    with pytest.raises(ValueError):
+        inv.release("A", qty)
+
+    assert inv.on_hand("A") == 10
+    assert inv.reserved("A") == 2
+    assert inv.available("A") == 8
+
+
+def test_release_from_unreserved_sku_fails():
+    inv = Inventory()
+    inv.receive("A", 2)
+
+    with pytest.raises(ValueError):
+        inv.release("A", 1)
+
+    assert inv.on_hand("A") == 2
+    assert inv.reserved("A") == 0
+    assert inv.available("A") == 2
diff --git a/tests/test_orders.py b/tests/test_orders.py
index d3835d1..bfc6543 100644
--- a/tests/test_orders.py
+++ b/tests/test_orders.py
@@ -1,7 +1,7 @@
 import pytest
 
 from shoplib.inventory import Inventory
-from shoplib.orders import DELIVERED, NEW, Order
+from shoplib.orders import CANCELLED, DELIVERED, NEW, SHIPPED, Order
 
 
 def make():
@@ -25,3 +25,72 @@ def test_cannot_ship_unpaid():
     _, order = make()
     with pytest.raises(ValueError):
         order.ship()
+
+
+def test_cancel_new_order_releases_stock_without_refund():
+    inv, order = make()
+
+    order.cancel()
+
+    assert order.state == CANCELLED
+    assert order.refund_due is False
+    assert inv.on_hand("A") == 5
+    assert inv.reserved("A") == 0
+    assert inv.available("A") == 5
+
+
+def test_cancel_paid_order_releases_stock_and_marks_refund_due():
+    inv, order = make()
+    order.pay()
+
+    order.cancel()
+
+    assert order.state == CANCELLED
+    assert order.refund_due is True
+    assert inv.on_hand("A") == 5
+    assert inv.reserved("A") == 0
+    assert inv.available("A") == 5
+
+
+def test_cancel_releases_each_order_line():
+    inv = Inventory()
+    inv.receive("A", 3)
+    inv.receive("B", 4)
+    order = Order("o2", {"A": 1, "B": 2}, inv)
+
+    order.cancel()
+
+    assert order.state == CANCELLED
+    assert (inv.reserved("A"), inv.reserved("B")) == (0, 0)
+    assert (inv.available("A"), inv.available("B")) == (3, 4)
+
+
+def test_cancelling_cancelled_order_does_nothing():
+    inv, order = make()
+    order.cancel()
+    inv.reserve("A", 1)
+
+    order.cancel()
+
+    assert order.state == CANCELLED
+    assert order.refund_due is False
+    assert inv.reserved("A") == 1
+    assert inv.available("A") == 4
+
+
+@pytest.mark.parametrize("state", [SHIPPED, DELIVERED])
+def test_cannot_cancel_shipped_or_delivered_order(state):
+    inv, order = make()
+    order.pay()
+    order.ship()
+    if state == DELIVERED:
+        order.deliver()
+    previous_state = order.state
+    previous_stock = (inv.on_hand("A"), inv.reserved("A"), inv.available("A"))
+
+    with pytest.raises(ValueError):
+        order.cancel()
+
+    assert order.state == previous_state
+    assert order.refund_due is False
+    assert (inv.on_hand("A"), inv.reserved("A"), inv.available("A")) == previous_stock
