diff --git a/tests/test_dates.py b/tests/test_dates.py
index fbfd5f2..628b1cd 100644
--- a/tests/test_dates.py
+++ b/tests/test_dates.py
@@ -12,3 +12,16 @@ def test_forward_over_weekend():
     # Friday + 1 business day = Monday
     assert add_business_days(date(2026, 11, 13), 1) == date(2026, 11, 16)
     assert add_business_days(date(2026, 11, 16), 3) == date(2026, 11, 19)
+
+
+def test_holidays_are_skipped_in_both_directions():
+    holiday = date(2026, 11, 16)  # Monday
+    assert add_business_days(date(2026, 11, 13), 1, [holiday]) == date(2026, 11, 17)
+    assert add_business_days(date(2026, 11, 17), -1, [holiday]) == date(2026, 11, 13)
+
+
+def test_zero_returns_start_only_when_it_is_a_business_day():
+    assert add_business_days(date(2026, 11, 17), 0) == date(2026, 11, 17)
+    assert add_business_days(date(2026, 11, 15), 0) == date(2026, 11, 16)
+    holiday = date(2026, 11, 16)
+    assert add_business_days(holiday, 0, [holiday]) == date(2026, 11, 17)
