+import csv
+import io
+
 from shoplib.reports import sales_summary, to_csv
 
 SALES = [
@@ -16,3 +19,25 @@ def test_summary():
 
 def test_csv():
     assert to_csv(sales_summary(SALES)) == "sku,name,units,revenue_cents\nA,Mug,3,1350\nB,Bowl,1,900\n"
+
+
+def test_csv_special_characters():
+    rows = [
+        {"sku": "A,B", "name": 'A "large" mug', "units": "1\n2", "revenue_cents": 1350},
+        {"sku": "C\rD", "name": 'comma, quote" and\r\nnewline', "units": "", "revenue_cents": 0},
+    ]
+    result = to_csv(rows)
+    assert result == (
+        'sku,name,units,revenue_cents\n'
+        '"A,B","A ""large"" mug","1\n2",1350\n'
+        '"C\rD","comma, quote"" and\r\nnewline",,0\n'
+    )
+    assert list(csv.reader(io.StringIO(result, newline=""))) == [
+        ["sku", "name", "units", "revenue_cents"],
+        ["A,B", 'A "large" mug', "1\n2", "1350"],
+        ["C\rD", 'comma, quote" and\r\nnewline', "", "0"],
+    ]
+
+
+def test_csv_empty_rows():
+    assert to_csv([]) == "sku,name,units,revenue_cents\n"
