 def slugify(text: str, max_len: int = 40) -> str:
@@ -13,8 +16,21 @@ def slugify(text: str, max_len: int = 40) -> str:
     - At most `max_len` characters, cut after the other steps; a cut never
       leaves a trailing '-'.
     - If nothing is left, the slug is 'n-a'.
+    - `max_len` must be at least 3 to accommodate the fallback.
     """
-    slug = re.sub(r"[^a-z0-9]+", "-", text.lower()).strip("-")
+    if max_len < 3:
+        raise ShopError("max_len must be at least 3")
+
+    chars = []
+    latin_base = False
+    for char in unicodedata.normalize("NFD", text.lower()):
+        if unicodedata.category(char).startswith("M"):
+            if latin_base:
+                continue
+        else:
+            latin_base = "a" <= char <= "z"
+        chars.append(char)
+    slug = re.sub(r"[^a-z0-9]+", "-", "".join(chars)).strip("-")
     slug = slug[:max_len].rstrip("-")
     return slug or "n-a"
 
diff --git a/tests/test_textutil.py b/tests/test_textutil.py
index 4c83bb9..8c5b24c 100644
--- a/tests/test_textutil.py
+++ b/tests/test_textutil.py
@@ -1,3 +1,6 @@
+import pytest
+
+from shoplib.errors import ShopError
 from shoplib.textutil import slugify, truncate
 
 
@@ -6,6 +9,24 @@ def test_slugify_basic():
     assert slugify("!!!") == "n-a"
 
 
+def test_slugify_accents_and_separators():
+    assert slugify(" Crème Brûlée / CAFÉ ") == "creme-brulee-cafe"
+    assert slugify("Cafe\u0301 -- déjà") == "cafe-deja"
+    assert slugify("a中b") == "a-b"
+    assert slugify("a\u0301b") == "ab"
+    assert slugify("\u0301") == "n-a"
+
+
+def test_slugify_max_len():
+    assert slugify("Crème brûlée", 7) == "creme-b"
+    assert slugify("Crème brûlée", 6) == "creme"
+    assert slugify("!!!", 3) == "n-a"
+    assert len(slugify("a" * 50)) == 40
+    for limit in (2, 0, -1):
+        with pytest.raises(ShopError):
+            slugify("anything", limit)
+
+
 def test_truncate():
     assert truncate("hello world", 8) == "hello..."
     assert truncate("short", 8) == "short"
