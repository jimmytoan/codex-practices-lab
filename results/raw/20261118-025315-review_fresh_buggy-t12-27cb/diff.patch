@@ -0,0 +1,68 @@
+import pytest
+
+from shoplib.errors import ShopError
+from shoplib.search import Product, search
+
+
+@pytest.fixture
+def products():
+    return [
+        Product("MUG-RED", "Large Red Mug", 1000, ["Sale", "Kitchenware"]),
+        Product("mug-blue", "Small Blue Mug", 1500, ["CLEARANCE"]),
+        Product("TEA*SET", "Blue Tea Set", 2000, ["Gift*Box"]),
+    ]
+
+
+@pytest.mark.parametrize(
+    ("query", "indices"),
+    [
+        ("", [0, 1, 2]),
+        (" \t\n", [0, 1, 2]),
+        ("mUg", [0, 1]),
+        ('"blue mug"', [1]),
+        ('name:"BLUE MUG"', [1]),
+        ("name:red", [0]),
+        ("sku:MUG-RED", [0]),
+        ("sku:mug-*", [0, 1]),
+        ("sku:tea*set", [2]),
+        ("tag:SALE", [0]),
+        ("tag:kitchen*", [0]),
+        ("tag:gift*box", [2]),
+        ("price<1500", [0]),
+        ("price<=1500", [0, 1]),
+        ("price>1500", [2]),
+        ("price>=1500", [1, 2]),
+        ("price=1500", [1]),
+        ('price>="1500"', [1, 2]),
+        ("mug -tag:sale price<=1500", [1]),
+        ('-"blue mug"', [0, 2]),
+        ('"tag:sale"', []),
+        ('"price>=1000"', []),
+    ],
+)
+def test_search_terms(products, query, indices):
+    assert search(products, query) == [products[i] for i in indices]
+
+
+@pytest.mark.parametrize(
+    "query",
+    [
+        "color:blue", "price:5", "tag:", 'name:""', "sku:", "-",
+        '"unclosed', 'tag:"unclosed', "price<", "price>=-1", "price=1.5",
+        "price=abc", 'price>="abc"', 'price>""', "-price=abc",
+    ],
+)
+def test_invalid_query_is_rejected_even_without_products(query):
+    with pytest.raises(ShopError):
+        search([], query)
+
+
+def test_price_accepts_arbitrarily_long_whole_numbers(products):
+    assert search(products, "price<" + "9" * 5000) == products
+    assert search(products, "price>=" + "0" * 5000 + "1500") == products[1:]
+
+
+@pytest.mark.parametrize("query", ["strasse", "name:STRASSE", "sku:STRASSE", "sku:STRAS*", "tag:STRASSE", "tag:STRAS*"])
+def test_case_insensitive_matching_uses_unicode_case_folding(query):
+    product = Product("Straße", "Straße", 1, ["Straße"])
+    assert search([product], query) == [product]
