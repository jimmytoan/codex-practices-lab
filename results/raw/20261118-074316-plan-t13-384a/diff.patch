+++ b/tests/test_costing.py
@@ -0,0 +1,102 @@
+import copy
+
+import pytest
+
+from shoplib.costing import fifo_costing
+
+
+def test_fifo_sales_report_cogs_on_hand_and_value_per_sku():
+    events = [
+        {"type": "receive", "sku": "A", "qty": 2, "unit_cost_cents": 100},
+        {"type": "receive", "sku": "A", "qty": 3, "unit_cost_cents": 250},
+        {"type": "receive", "sku": "B", "qty": 1, "unit_cost_cents": 50},
+        {"type": "sell", "sku": "A", "qty": 3},
+    ]
+
+    assert fifo_costing(events) == {
+        "A": {"cogs_cents": 450, "on_hand": 2, "value_cents": 500},
+        "B": {"cogs_cents": 0, "on_hand": 1, "value_cents": 50},
+    }
+
+
+def test_return_uses_rounded_average_cost_and_can_be_split():
+    events = [
+        {"type": "receive", "sku": "A", "qty": 1, "unit_cost_cents": 100},
+        {"type": "receive", "sku": "A", "qty": 1, "unit_cost_cents": 101},
+        {"type": "sell", "sku": "A", "qty": 2},
+        {"type": "return", "sku": "A", "qty": 1},
+        {"type": "return", "sku": "A", "qty": 1},
+    ]
+
+    # 201 / 2 rounds half up to 101 cents for each returned unit.
+    assert fifo_costing(events)["A"] == {
+        "cogs_cents": -1,
+        "on_hand": 2,
+        "value_cents": 202,
+    }
+
+
+def test_return_is_appended_after_existing_lots():
+    events = [
+        {"type": "receive", "sku": "A", "qty": 1, "unit_cost_cents": 100},
+        {"type": "sell", "sku": "A", "qty": 1},
+        {"type": "receive", "sku": "A", "qty": 1, "unit_cost_cents": 200},
+        {"type": "return", "sku": "A", "qty": 1},
+        {"type": "sell", "sku": "A", "qty": 1},
+    ]
+
+    # The 200-cent lot is sold before the returned 100-cent lot.
+    assert fifo_costing(events)["A"] == {
+        "cogs_cents": 200,
+        "on_hand": 1,
+        "value_cents": 100,
+    }
+
+
+def test_returns_apply_only_to_the_most_recent_sale():
+    events = [
+        {"type": "receive", "sku": "A", "qty": 1, "unit_cost_cents": 100},
+        {"type": "sell", "sku": "A", "qty": 1},
+        {"type": "receive", "sku": "A", "qty": 1, "unit_cost_cents": 200},
+        {"type": "sell", "sku": "A", "qty": 1},
+        {"type": "return", "sku": "A", "qty": 1},
+    ]
+
+    assert fifo_costing(events)["A"] == {
+        "cogs_cents": 100,
+        "on_hand": 1,
+        "value_cents": 200,
+    }
+
+
+@pytest.mark.parametrize(
+    "events",
+    [
+        [{"type": "receive", "sku": "A", "qty": 0, "unit_cost_cents": 100}],
+        [{"type": "receive", "sku": "A", "qty": 1, "unit_cost_cents": -1}],
+        [{"type": "sell", "sku": "A", "qty": 1}],
+        [{"type": "return", "sku": "A", "qty": 1}],
+        [
+            {"type": "receive", "sku": "A", "qty": 1, "unit_cost_cents": 100},
+            {"type": "sell", "sku": "A", "qty": 1},
+            {"type": "return", "sku": "A", "qty": 2},
+        ],
+        [{"type": "adjust", "sku": "A", "qty": 1}],
+    ],
+)
+def test_invalid_events_raise_value_error(events):
+    with pytest.raises(ValueError):
+        fifo_costing(events)
+
+
+def test_events_are_not_modified():
+    events = [
+        {"type": "receive", "sku": "A", "qty": 2, "unit_cost_cents": 75},
+        {"type": "sell", "sku": "A", "qty": 1},
+        {"type": "return", "sku": "A", "qty": 1},
+    ]
+    original = copy.deepcopy(events)
+
+    fifo_costing(events)
+
+    assert events == original
