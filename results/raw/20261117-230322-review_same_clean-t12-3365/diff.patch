@@ -0,0 +1,75 @@
+import pytest
+
+from shoplib.errors import ShopError
+from shoplib.search import Product, search
+
+
+@pytest.fixture
+def products():
+    return [
+        Product("MUG-1", "Blue Mug", 1000, ["Sale", "Kitchen"]),
+        Product("MUG-2", "Red mug", 1500, ["kitchenware"]),
+        Product("TEA*3", "Tea: green", 500, ["Tea*leaf"]),
+        Product("MUG-10", "Blue plate", 1000),
+    ]
+
+
+@pytest.mark.parametrize(
+    ("query", "skus"),
+    [
+        ("", ["MUG-1", "MUG-2", "TEA*3", "MUG-10"]),
+        (" \t\n", ["MUG-1", "MUG-2", "TEA*3", "MUG-10"]),
+        ("mUG", ["MUG-1", "MUG-2"]),
+        ('"bLUe mUG"', ["MUG-1"]),
+        ('name:"BLUE mug"', ["MUG-1"]),
+        ('"Tea: green"', ["TEA*3"]),
+        ("sku:mug-1", ["MUG-1"]),
+        ("sku:mug-*", ["MUG-1", "MUG-2", "MUG-10"]),
+        ("sku:tea*3", ["TEA*3"]),
+        ("tag:KITCHEN", ["MUG-1"]),
+        ("tag:kitchen*", ["MUG-1", "MUG-2"]),
+        ("tag:tea*leaf", ["TEA*3"]),
+        ("name:blue", ["MUG-1", "MUG-10"]),
+        ("price<1000", ["TEA*3"]),
+        ("price<=1000", ["MUG-1", "TEA*3", "MUG-10"]),
+        ("price>1000", ["MUG-2"]),
+        ("price>=1000", ["MUG-1", "MUG-2", "MUG-10"]),
+        ("price=1000", ["MUG-1", "MUG-10"]),
+        ('price>="1000"', ["MUG-1", "MUG-2", "MUG-10"]),
+        ("mug -tag:sale", ["MUG-2"]),
+        ('-"blue mug"', ["MUG-2", "TEA*3", "MUG-10"]),
+        ("-price>=1000", ["TEA*3"]),
+        ("sku:mug-* price=1000 -name:plate", ["MUG-1"]),
+    ],
+)
+def test_search_terms(products, query, skus):
+    assert [product.sku for product in search(products, query)] == skus
+
+
+@pytest.mark.parametrize(
+    "query",
+    [
+        "color:blue", "price:5", "tag:", 'name:""', "-", '-""',
+        '"unclosed', 'name:"unclosed', "price=", "price=1.5",
+        "price=-1", "price>=abc", 'price>="abc"', 'price<""',
+        "-tag:", "-price=abc",
+    ],
+)
+def test_invalid_terms_raise_shop_error_even_without_products(query):
+    with pytest.raises(ShopError):
+        search([], query)
+
+
+def test_whole_quoted_operator_is_a_literal_phrase():
+    product = Product("1", "price>=1000 and -tag:sale", 50)
+    assert search([product], '"price>=1000" "-tag:sale"') == [product]
+
+
+def test_valid_price_longer_than_python_integer_conversion_limit(products):
+    assert search(products, "price<" + "9" * 5000) == products
+
+
+@pytest.mark.parametrize("query", ["STRASSE", "name:STRASSE", "sku:STRASSE", "sku:STRASS*", "tag:STRASSE", "tag:STRASS*"])
+def test_case_insensitive_matching_with_unicode(query):
+    product = Product("Straße", "Straße", 100, ["Straße"])
+    assert search([product], query) == [product]
