diff --git a/src/shoplib/invoice.py b/src/shoplib/invoice.py
index 5d1398c..95aa7a4 100644
--- a/src/shoplib/invoice.py
+++ b/src/shoplib/invoice.py
@@ -1,5 +1,8 @@
 """Invoices: coupon allocation and tax. See docs/invoicing.md."""
 
+from .errors import ShopError
+from .money import percent_of
+
 # Tax rates in percent, by region and product category.
 TAX_RATES = {
     "DE": {"standard": 19, "food": 7, "books": 7},
@@ -10,4 +13,60 @@ TAX_RATES = {
 
 def build_invoice(lines, coupon_cents: int, shipping_cents: int, region: str) -> dict:
     """Build an invoice for an order. See docs/invoicing.md."""
-    raise NotImplementedError
+    if not isinstance(region, str) or region not in TAX_RATES:
+        raise ShopError("unknown region")
+    if not isinstance(lines, list) or not lines:
+        raise ShopError("lines must be a nonempty list")
+    if type(coupon_cents) is not int or coupon_cents < 0:
+        raise ShopError("coupon must be nonnegative integer cents")
+    if type(shipping_cents) is not int or shipping_cents < 0:
+        raise ShopError("shipping must be nonnegative integer cents")
+
+    rates = TAX_RATES[region]
+    gross_amounts = []
+    for line in lines:
+        if not isinstance(line, (tuple, list)) or len(line) != 4:
+            raise ShopError("invalid line")
+        _, price, qty, category = line
+        if type(price) is not int or price < 0:
+            raise ShopError("price must be nonnegative integer cents")
+        if type(qty) is not int or qty < 1:
+            raise ShopError("quantity must be a positive integer")
+        if not isinstance(category, str) or category not in rates:
+            raise ShopError("unknown category")
+        gross_amounts.append(price * qty)
+
+    total_gross = sum(gross_amounts)
+    coupon = min(coupon_cents, total_gross)
+    discounts = [0] * len(lines)
+    if total_gross:
+        shares = [divmod(coupon * gross, total_gross) for gross in gross_amounts]
+        discounts = [share for share, _ in shares]
+        remaining = coupon - sum(discounts)
+        order = sorted(range(len(lines)), key=lambda i: (-shares[i][1], i))
+        for i in order[:remaining]:
+            discounts[i] += 1
+
+    invoice_lines = []
+    for (sku, _, _, category), gross, discount in zip(lines, gross_amounts, discounts):
+        net = gross - discount
+        invoice_lines.append({
+            "sku": sku,
+            "gross_cents": gross,
+            "discount_cents": discount,
+            "net_cents": net,
+            "tax_cents": percent_of(net, rates[category]),
+        })
+
+    shipping_tax = (
+        percent_of(shipping_cents, rates["standard"])
+        if any(rates[line[3]] > 0 for line in lines)
+        else 0
+    )
+    total = sum(line["net_cents"] + line["tax_cents"] for line in invoice_lines)
+    return {
+        "lines": invoice_lines,
+        "shipping_cents": shipping_cents,
+        "shipping_tax_cents": shipping_tax,
+        "total_cents": total + shipping_cents + shipping_tax,
+    }
diff --git a/tests/test_invoice.py b/tests/test_invoice.py
new file mode 100644
index 0000000..810f567
--- /dev/null
+++ b/tests/test_invoice.py
@@ -0,0 +1,91 @@
+import pytest
+
+from shoplib.errors import ShopError
+from shoplib.invoice import build_invoice
+
+
+def test_proportional_coupon_and_tax_by_category():
+    invoice = build_invoice(
+        [("a", 250, 2, "standard"), ("b", 300, 1, "food"), ("c", 200, 1, "books")],
+        101,
+        101,
+        "DE",
+    )
+    assert invoice == {
+        "lines": [
+            {"sku": "a", "gross_cents": 500, "discount_cents": 51, "net_cents": 449, "tax_cents": 85},
+            {"sku": "b", "gross_cents": 300, "discount_cents": 30, "net_cents": 270, "tax_cents": 19},
+            {"sku": "c", "gross_cents": 200, "discount_cents": 20, "net_cents": 180, "tax_cents": 13},
+        ],
+        "shipping_cents": 101,
+        "shipping_tax_cents": 19,
+        "total_cents": 1136,
+    }
+
+
+def test_largest_remainders_and_ties_follow_input_order():
+    lines = [("a", 1, 1, "books"), ("b", 2, 1, "books"), ("c", 2, 1, "books")]
+    invoice = build_invoice(lines, 2, 0, "OR")
+    assert [line["discount_cents"] for line in invoice["lines"]] == [0, 1, 1]
+
+    invoice = build_invoice([("a", 1, 1, "books"), ("b", 1, 1, "books"), ("c", 1, 1, "books")], 2, 0, "OR")
+    assert [line["discount_cents"] for line in invoice["lines"]] == [1, 1, 0]
+
+
+def test_coupon_is_capped_and_shipping_tax_depends_on_category_not_net():
+    invoice = build_invoice([("a", 100, 2, "food"), ("b", 0, 1, "books")], 500, 50, "SG")
+    assert [line["discount_cents"] for line in invoice["lines"]] == [200, 0]
+    assert [line["net_cents"] for line in invoice["lines"]] == [0, 0]
+    assert invoice["shipping_tax_cents"] == 5
+    assert invoice["total_cents"] == 55
+
+
+def test_zero_gross_and_zero_rate_shipping():
+    invoice = build_invoice([("a", 0, 3, "books"), ("b", 0, 1, "books")], 10, 50, "SG")
+    assert [line["discount_cents"] for line in invoice["lines"]] == [0, 0]
+    assert invoice["shipping_tax_cents"] == 0
+    assert invoice["total_cents"] == 50
+
+
+@pytest.mark.parametrize("region, category", [("SG", "books"), ("OR", "standard")])
+def test_shipping_is_not_taxed_when_all_categories_are_exempt(region, category):
+    invoice = build_invoice([("a", 100, 1, category)], 0, 50, region)
+    assert invoice["lines"][0]["tax_cents"] == 0
+    assert invoice["shipping_tax_cents"] == 0
+    assert invoice["total_cents"] == 150
+
+
+def test_taxable_zero_gross_line_makes_shipping_taxable():
+    invoice = build_invoice([("a", 0, 1, "food")], 10, 50, "SG")
+    assert invoice["lines"][0]["discount_cents"] == 0
+    assert invoice["shipping_tax_cents"] == 5
+    assert invoice["total_cents"] == 55
+
+
+def test_tax_rounds_half_up_per_line_and_on_shipping():
+    invoice = build_invoice([("a", 50, 1, "food"), ("b", 50, 1, "standard")], 0, 50, "SG")
+    assert [line["tax_cents"] for line in invoice["lines"]] == [5, 5]
+    assert invoice["shipping_tax_cents"] == 5
+    assert invoice["total_cents"] == 165
+
+
+@pytest.mark.parametrize(
+    "lines, coupon, shipping, region",
+    [
+        ([("a", 1, 1, "standard")], 0, 0, "unknown"),
+        ([("a", 1, 1, "unknown")], 0, 0, "DE"),
+        ([], 0, 0, "DE"),
+        ([("a", 1, 0, "standard")], 0, 0, "DE"),
+        ([("a", -1, 1, "standard")], 0, 0, "DE"),
+        ([("a", 1, 1, "standard")], -1, 0, "DE"),
+        ([("a", 1, 1, "standard")], 0, -1, "DE"),
+        ([("a", 1.5, 1, "standard")], 0, 0, "DE"),
+        ([("a", 1, 1.5, "standard")], 0, 0, "DE"),
+        ([("a", 1, 1, "standard")], 0.5, 0, "DE"),
+        ([("a", 1, 1, "standard")], 0, 0.5, "DE"),
+        ([("a", 1, 1)], 0, 0, "DE"),
+    ],
+)
+def test_invalid_arguments_raise_shop_error(lines, coupon, shipping, region):
+    with pytest.raises(ShopError):
+        build_invoice(lines, coupon, shipping, region)
