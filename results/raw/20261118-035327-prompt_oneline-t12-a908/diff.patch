@@ -0,0 +1,62 @@
+import pytest
+
+from shoplib.errors import ShopError
+from shoplib.search import Product, search
+
+
+@pytest.fixture
+def products():
+    return [
+        Product("MUG-001", "Blue Ceramic Mug", 1250, ["kitchen", "sale"]),
+        Product("MUG-002", "Blue Travel Mug", 1800, ["travel"]),
+        Product("PLATE-001", "Blue Plate", 900, ["kitchen"]),
+        Product("CUP*", "Red Cup", 500, ["clearance"]),
+    ]
+
+
+def test_bare_words_match_name_and_all_terms_must_match(products):
+    assert search(products, "blue mug") == products[:2]
+    assert search(products, "BLUE ceramic") == [products[0]]
+    assert search(products, "   ") == products
+
+
+def test_quoted_phrases_and_field_values_can_contain_spaces(products):
+    assert search(products, '"blue ceramic"') == [products[0]]
+    assert search(products, 'name:"travel mug"') == [products[1]]
+
+
+def test_sku_tag_name_and_prefix_fields(products):
+    assert search(products, "sku:mug-001") == [products[0]]
+    assert search(products, "sku:MUG-*") == products[:2]
+    assert search(products, "tag:KITCHEN") == [products[0], products[2]]
+    assert search(products, "tag:sal*") == [products[0]]
+    assert search(products, "sku:CUP*") == [products[3]]
+    assert search(products, "name:BLUE") == products[:3]
+
+
+@pytest.mark.parametrize(
+    ("query", "expected"),
+    [
+        ("price<900", [3]),
+        ("price<=900", [2, 3]),
+        ("price>1250", [1]),
+        ("price>=1250", [0, 1]),
+        ("price=500", [3]),
+    ],
+)
+def test_price_comparisons(products, query, expected):
+    assert search(products, query) == [products[index] for index in expected]
+
+
+def test_negation_and_combined_terms(products):
+    assert search(products, "blue -tag:sale") == [products[1], products[2]]
+    assert search(products, "-price>=1250") == [products[2], products[3]]
+
+
+@pytest.mark.parametrize(
+    "query",
+    ["tag:", "name:", "price:5", "bogus:value", "price>=1.5", "price>abc", "-", '"unfinished'],
+)
+def test_invalid_queries_raise_shop_error(products, query):
+    with pytest.raises(ShopError):
+        search(products, query)
