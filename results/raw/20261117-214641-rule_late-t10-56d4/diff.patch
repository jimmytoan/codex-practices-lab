 def test_tiers():
@@ -15,3 +15,45 @@ def test_invalid_weight():
         shipping_cost(0)
     with pytest.raises(ValueError):
         shipping_cost(25000)
+
+
+def test_split_parcels_first_fit_decreasing_and_unit_order():
+    items = [("z", 2, 2), ("b", 7, 1), ("a", 8, 1), ("a", 2, 1)]
+    assert split_parcels(items, 10) == [["a", "a"], ["b", "z"], ["z"]]
+    assert items == [("z", 2, 2), ("b", 7, 1), ("a", 8, 1), ("a", 2, 1)]
+
+
+def test_split_parcels_fills_first_available_parcel():
+    assert split_parcels([("a", 8, 1), ("b", 7, 1), ("c", 2, 2),
+                          ("d", 1, 1)], 10) == [["a", "c"], ["b", "c", "d"]]
+
+
+@pytest.mark.parametrize("items, limit", [
+    ([("a", 1, 0)], 10),
+    ([("a", 1, -1)], 10),
+    ([("a", 0, 1)], 10),
+    ([("a", -1, 1)], 10),
+    ([("a", 11, 1)], 10),
+    ([("a", 1, 1)], 0),
+])
+def test_invalid_parcel_items(items, limit):
+    with pytest.raises(ValueError):
+        split_parcels(items, limit)
+    with pytest.raises(ValueError):
+        shipment_cost(items, limit)
+
+
+def test_empty_shipment():
+    assert split_parcels([], 0) == []
+    assert shipment_cost([], 0) == 0
+
+
+def test_shipment_cost_uses_each_parcel_weight():
+    items = [("a", 800, 1), ("a", 600, 1), ("a", 200, 1)]
+    assert split_parcels(items, 1000) == [["a", "a"], ["a"]]
+    assert shipment_cost(items, 1000) == shipping_cost(1000) + shipping_cost(600)
+
+
+def test_shipment_cost_propagates_invalid_parcel_weight():
+    with pytest.raises(ValueError):
+        shipment_cost([("a", 20001, 1)], 25000)
