@@ -1,3 +1,6 @@
+import pytest
+
+from shoplib.errors import ShopError
 from shoplib.textutil import slugify, truncate
 
 
@@ -6,6 +9,57 @@ def test_slugify_basic():
     assert slugify("!!!") == "n-a"
 
 
+@pytest.mark.parametrize(
+    ("text", "expected"),
+    [
+        ("Crème Brûlée", "creme-brulee"),
+        ("CAFÉ / À LA CARTE", "cafe-a-la-carte"),
+        ("Cafe\u0301 and A\u030angstro\u0308m", "cafe-and-angstrom"),
+        ("Łódź and Ǿ", "lodz-and-o"),
+        ("  déjà___vu! 42  ", "deja-vu-42"),
+        ("a💡b ① c", "a-b-c"),
+        ("x\ufe0fy", "x-y"),
+        ("1\u03012", "1-2"),
+        ("\u0301!!!", "n-a"),
+    ],
+)
+def test_slugify_accents_and_separators(text, expected):
+    assert slugify(text) == expected
+
+
+@pytest.mark.parametrize(
+    ("text", "max_len", "expected"),
+    [
+        ("Crème Brûlée", 5, "creme"),
+        ("Crème Brûlée", 6, "creme"),
+        ("Crème Brûlée", 7, "creme-b"),
+        ("Hello", 1, "h"),
+        ("Hello", 2, "he"),
+        ("!!!", 3, "n-a"),
+        ("a" * 50, 40, "a" * 40),
+    ],
+)
+def test_slugify_length_limit(text, max_len, expected):
+    assert slugify(text, max_len) == expected
+
+
+@pytest.mark.parametrize("max_len", [0, -1, 1.5, True, None])
+def test_slugify_rejects_invalid_length(max_len):
+    with pytest.raises(ShopError):
+        slugify("test", max_len)
+
+
+@pytest.mark.parametrize("max_len", [1, 2])
+def test_slugify_rejects_length_too_short_for_fallback(max_len):
+    with pytest.raises(ShopError):
+        slugify("!!!", max_len)
+
+
+def test_slugify_rejects_non_string_text():
+    with pytest.raises(ShopError):
+        slugify(None)
+
+
 def test_truncate():
     assert truncate("hello world", 8) == "hello..."
     assert truncate("short", 8) == "short"
