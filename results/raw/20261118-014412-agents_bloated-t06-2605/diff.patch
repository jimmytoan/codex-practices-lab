diff --git a/tests/test_dates.py b/tests/test_dates.py
index fbfd5f2..1077ddc 100644
--- a/tests/test_dates.py
+++ b/tests/test_dates.py
@@ -1,5 +1,7 @@
 from datetime import date
 
+import pytest
+
 from shoplib.dates import add_business_days, is_business_day
 
 
@@ -12,3 +14,19 @@ def test_forward_over_weekend():
     # Friday + 1 business day = Monday
     assert add_business_days(date(2026, 11, 13), 1) == date(2026, 11, 16)
     assert add_business_days(date(2026, 11, 16), 3) == date(2026, 11, 19)
+
+
+@pytest.mark.parametrize(
+    ("start", "n", "holidays", "expected"),
+    [
+        (date(2026, 11, 13), 1, [date(2026, 11, 16)], date(2026, 11, 17)),
+        (date(2026, 11, 16), 1, [date(2026, 11, 16)], date(2026, 11, 17)),
+        (date(2026, 11, 16), -1, [date(2026, 11, 13)], date(2026, 11, 12)),
+        (date(2026, 11, 15), -2, [], date(2026, 11, 12)),
+        (date(2026, 11, 16), 0, [], date(2026, 11, 16)),
+        (date(2026, 11, 14), 0, [date(2026, 11, 16)], date(2026, 11, 17)),
+        (date(2026, 11, 13), 0, [date(2026, 11, 13), date(2026, 11, 16)], date(2026, 11, 17)),
+    ],
+)
+def test_add_business_days(start, n, holidays, expected):
+    assert add_business_days(start, n, iter(holidays)) == expected
