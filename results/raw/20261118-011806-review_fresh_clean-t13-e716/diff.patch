diff --git a/src/shoplib/costing.py b/src/shoplib/costing.py
index 5e8c27e..96363e2 100644
--- a/src/shoplib/costing.py
+++ b/src/shoplib/costing.py
@@ -1,6 +1,53 @@
 """Cost of goods sold with FIFO lots. See docs/costing.md."""
 
+from decimal import Decimal
+
+from .errors import ShopError
+from .money import round_cents
+
 
 def fifo_costing(events: list[dict]) -> dict:
     """Process stock events and report cost per SKU. See docs/costing.md."""
-    raise NotImplementedError
+    lots: dict[str, list[list[int]]] = {}
+    cogs: dict[str, int] = {}
+    last_sale: dict[str, dict] = {}
+    for ev in events:
+        kind, sku, qty = ev["type"], ev["sku"], ev["qty"]
+        if type(qty) is not int or qty < 1:
+            raise ShopError("qty must be a positive integer")
+        lots.setdefault(sku, [])
+        cogs.setdefault(sku, 0)
+        if kind == "receive":
+            if type(ev["unit_cost_cents"]) is not int or ev["unit_cost_cents"] < 0:
+                raise ShopError("unit cost must be a non-negative integer")
+            lots[sku].append([qty, ev["unit_cost_cents"]])
+        elif kind == "sell":
+            if qty > sum(q for q, _ in lots[sku]):
+                raise ShopError(f"not enough {sku} on hand")
+            need, cost = qty, 0
+            while need:
+                lot = lots[sku][0]
+                take = min(need, lot[0])
+                cost += take * lot[1]
+                lot[0] -= take
+                need -= take
+                if lot[0] == 0:
+                    lots[sku].pop(0)
+            cogs[sku] += cost
+            last_sale[sku] = {"qty": qty, "cost": cost, "returned": 0}
+        elif kind == "return":
+            sale = last_sale.get(sku)
+            if sale is None or qty > sale["qty"] - sale["returned"]:
+                raise ShopError(f"cannot return {qty} of {sku}")
+            whole, remainder = divmod(sale["cost"], sale["qty"])
+            # Compare the fraction exactly before rounding, independent of the
+            # Decimal context's precision and the size of the sale.
+            fraction = Decimal("0.5") if 2 * remainder >= sale["qty"] else Decimal(0)
+            unit = whole + round_cents(fraction)
+            sale["returned"] += qty
+            lots[sku].append([qty, unit])
+            cogs[sku] -= qty * unit
+        else:
+            raise ShopError(f"unknown event type {kind!r}")
+    return {sku: {"cogs_cents": cogs[sku], "on_hand": sum(q for q, _ in lots[sku]),
+                  "value_cents": sum(q * c for q, c in lots[sku])} for sku in lots}
diff --git a/tests/test_costing.py b/tests/test_costing.py
new file mode 100644
index 0000000..9b061c8
--- /dev/null
+++ b/tests/test_costing.py
@@ -0,0 +1,96 @@
+from copy import deepcopy
+
+import pytest
+
+from shoplib.costing import fifo_costing
+from shoplib.errors import ShopError
+
+
+def test_fifo_returns_are_averaged_and_join_the_back_of_the_queue():
+    events = [
+        {"type": "receive", "sku": "A", "qty": 2, "unit_cost_cents": 100},
+        {"type": "receive", "sku": "A", "qty": 3, "unit_cost_cents": 201},
+        {"type": "receive", "sku": "B", "qty": 1, "unit_cost_cents": 7},
+        {"type": "sell", "sku": "A", "qty": 4},
+        {"type": "sell", "sku": "B", "qty": 1},
+        {"type": "return", "sku": "A", "qty": 1},
+        {"type": "return", "sku": "A", "qty": 2},
+        {"type": "receive", "sku": "A", "qty": 1, "unit_cost_cents": 300},
+        {"type": "sell", "sku": "A", "qty": 2},
+        {"type": "return", "sku": "B", "qty": 1},
+    ]
+    original = deepcopy(events)
+    assert fifo_costing(events) == {
+        "A": {"cogs_cents": 501, "on_hand": 3, "value_cents": 602},
+        "B": {"cogs_cents": 0, "on_hand": 1, "value_cents": 7},
+    }
+    assert events == original
+
+
+def test_returns_are_limited_to_the_most_recent_sale():
+    events = [
+        {"type": "receive", "sku": "A", "qty": 4, "unit_cost_cents": 10},
+        {"type": "sell", "sku": "A", "qty": 3},
+        {"type": "return", "sku": "A", "qty": 2},
+        {"type": "sell", "sku": "A", "qty": 1},
+        {"type": "return", "sku": "A", "qty": 1},
+        {"type": "return", "sku": "A", "qty": 1},
+    ]
+    with pytest.raises(ShopError):
+        fifo_costing(events)
+
+
+def test_return_average_rounds_half_up_even_when_all_units_are_returned():
+    events = [
+        {"type": "receive", "sku": "A", "qty": 1, "unit_cost_cents": 0},
+        {"type": "receive", "sku": "A", "qty": 1, "unit_cost_cents": 1},
+        {"type": "sell", "sku": "A", "qty": 2},
+        {"type": "return", "sku": "A", "qty": 2},
+    ]
+    assert fifo_costing(events) == {
+        "A": {"cogs_cents": -1, "on_hand": 2, "value_cents": 2}
+    }
+
+
+def test_return_average_uses_exact_arithmetic_for_large_sales():
+    n = 10**30
+    events = [
+        {"type": "receive", "sku": "A", "qty": n, "unit_cost_cents": 1},
+        {"type": "receive", "sku": "A", "qty": n + 1, "unit_cost_cents": 0},
+        {"type": "sell", "sku": "A", "qty": 2 * n + 1},
+        {"type": "return", "sku": "A", "qty": 1},
+        {"type": "receive", "sku": "B", "qty": 1, "unit_cost_cents": n},
+        {"type": "sell", "sku": "B", "qty": 1},
+        {"type": "return", "sku": "B", "qty": 1},
+    ]
+    assert fifo_costing(events) == {
+        "A": {"cogs_cents": n, "on_hand": 1, "value_cents": 0},
+        "B": {"cogs_cents": 0, "on_hand": 1, "value_cents": n},
+    }
+
+
+@pytest.mark.parametrize("events", [
+    [{"type": "receive", "sku": "A", "qty": 0, "unit_cost_cents": 1}],
+    [{"type": "sell", "sku": "A", "qty": -1}],
+    [{"type": "receive", "sku": "A", "qty": 1, "unit_cost_cents": -1}],
+    [{"type": "sell", "sku": "A", "qty": 1}],
+    [{"type": "return", "sku": "A", "qty": 1}],
+    [
+        {"type": "receive", "sku": "A", "qty": 2, "unit_cost_cents": 1},
+        {"type": "sell", "sku": "A", "qty": 2},
+        {"type": "return", "sku": "A", "qty": 1},
+        {"type": "return", "sku": "A", "qty": 2},
+    ],
+    [{"type": "other", "sku": "A", "qty": 1}],
+    [{"type": "receive", "sku": "A", "qty": 1.5, "unit_cost_cents": 1}],
+    [{"type": "receive", "sku": "A", "qty": 1, "unit_cost_cents": 1.5}],
+])
+def test_invalid_events_raise_shop_error_and_leave_input_unchanged(events):
+    original = deepcopy(events)
+    with pytest.raises(ShopError):
+        fifo_costing(events)
+    assert events == original
+
+
+def test_empty_events():
+    assert fifo_costing([]) == {}
