@@ -0,0 +1,58 @@
+import pytest
+
+from shoplib.errors import ShopError
+from shoplib.storedays import daily_revenue
+
+
+def test_day_boundary_time_zones_refunds_and_gaps():
+    sales = [
+        {"at": "2026-11-20T04:00:00+08:00", "cents": 500},
+        {"at": "2026-11-17T20:00:00Z", "cents": 200},
+        {"at": "2026-11-18T03:59:59+08:00", "cents": 100},
+        {"at": "2026-11-17T15:30:00-04:00", "cents": -50},
+    ]
+    assert daily_revenue(sales) == [
+        ("2026-11-17", 50),
+        ("2026-11-18", 200),
+        ("2026-11-19", 0),
+        ("2026-11-20", 500),
+    ]
+
+
+def test_custom_offset_and_start_hour():
+    sales = [
+        {"at": "2026-11-18T11:59:59Z", "cents": 1},
+        {"at": "2026-11-18T12:00:00Z", "cents": 2},
+    ]
+    assert daily_revenue(sales, utc_offset_hours=-5, day_starts_hour=7) == [
+        ("2026-11-17", 1),
+        ("2026-11-18", 2),
+    ]
+
+
+def test_no_sales():
+    assert daily_revenue([]) == []
+
+
+@pytest.mark.parametrize("timestamp", ["2026-11-18T04:00:00", "invalid"])
+def test_invalid_timestamp_raises_shop_error(timestamp):
+    with pytest.raises(ShopError):
+        daily_revenue([{"at": timestamp, "cents": 100}])
+
+
+@pytest.mark.parametrize("kwargs", [
+    {"utc_offset_hours": 24},
+    {"utc_offset_hours": -24},
+    {"day_starts_hour": 24},
+    {"day_starts_hour": -1},
+])
+def test_invalid_hours_raise_shop_error(kwargs):
+    with pytest.raises(ShopError):
+        daily_revenue([], **kwargs)
+
+
+def test_last_representable_date():
+    assert daily_revenue(
+        [{"at": "9999-12-31T12:00:00Z", "cents": 123}],
+        utc_offset_hours=0,
+    ) == [("9999-12-31", 123)]
