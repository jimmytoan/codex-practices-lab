diff --git a/tests/test_inventory.py b/tests/test_inventory.py
index 37436c0..7caa2f8 100644
--- a/tests/test_inventory.py
+++ b/tests/test_inventory.py
@@ -1,5 +1,6 @@
 import pytest
 
+from shoplib.errors import ShopError
 from shoplib.inventory import Inventory
 
 
@@ -18,3 +19,42 @@ def test_cannot_reserve_more_than_available():
     inv.receive("A", 2)
     with pytest.raises(ValueError):
         inv.reserve("A", 3)
+
+
+def test_release_returns_reserved_stock_to_available():
+    inv = Inventory()
+    inv.receive("A", 10)
+    inv.reserve("A", 4)
+    inv.receive("B", 3)
+    inv.reserve("B", 2)
+
+    inv.release("A", 2)
+    assert (inv.on_hand("A"), inv.reserved("A"), inv.available("A")) == (10, 2, 8)
+    assert (inv.on_hand("B"), inv.reserved("B"), inv.available("B")) == (3, 2, 1)
+
+    inv.release("A", 2)
+    assert (inv.on_hand("A"), inv.reserved("A"), inv.available("A")) == (10, 0, 10)
+
+
+@pytest.mark.parametrize("qty", [0, -1])
+def test_release_requires_positive_quantity(qty):
+    inv = Inventory()
+    inv.receive("A", 5)
+    inv.reserve("A", 3)
+
+    with pytest.raises(ShopError):
+        inv.release("A", qty)
+    assert (inv.on_hand("A"), inv.reserved("A"), inv.available("A")) == (5, 3, 2)
+
+
+@pytest.mark.parametrize("sku, qty", [("A", 4), ("B", 1), ("unknown", 1)])
+def test_release_cannot_exceed_reservations(sku, qty):
+    inv = Inventory()
+    inv.receive("A", 5)
+    inv.reserve("A", 3)
+    inv.receive("B", 2)
+    before = {s: (inv.on_hand(s), inv.reserved(s), inv.available(s)) for s in ("A", "B", "unknown")}
+
+    with pytest.raises(ShopError):
+        inv.release(sku, qty)
+    assert {s: (inv.on_hand(s), inv.reserved(s), inv.available(s)) for s in before} == before
