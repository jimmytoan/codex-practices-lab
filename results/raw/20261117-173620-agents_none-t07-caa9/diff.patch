-from shoplib.discounts import Coupon, apply_coupon
+from datetime import date, timedelta
+
+import pytest
+
+from shoplib.discounts import Coupon, apply_coupon, apply_coupons
 
 
 def test_percent():
@@ -7,3 +11,46 @@ def test_percent():
 
 def test_fixed_never_negative():
     assert apply_coupon(300, Coupon("FIVE", "fixed", 500)) == 0
+
+
+def test_apply_coupons_uses_best_percent_then_all_eligible_fixed():
+    today = date(2026, 11, 17)
+    coupons = [
+        Coupon("FIVE", "percent", 5),
+        Coupon("Z-TEN", "percent", 10),
+        Coupon("FIFTY", "fixed", 50, min_subtotal_cents=1005),
+        Coupon("A-TEN", "percent", 10, expires=today),
+        Coupon("TWENTY", "fixed", 20),
+        Coupon("EXPIRED", "fixed", 500, expires=today - timedelta(days=1)),
+        Coupon("EXPIRED-PERCENT", "percent", 90, expires=today - timedelta(days=1)),
+        Coupon("MINIMUM", "fixed", 500, min_subtotal_cents=1006),
+        Coupon("MINIMUM-PERCENT", "percent", 90, min_subtotal_cents=1006),
+    ]
+    # 10% of 1005 rounds half up to 101; the fixed minimum uses 1005.
+    assert apply_coupons(1005, coupons, today) == (
+        834, ["A-TEN", "FIFTY", "TWENTY"]
+    )
+
+
+def test_apply_coupons_keeps_all_applied_codes_when_total_is_zero():
+    coupons = [
+        Coupon("Z", "fixed", 200),
+        Coupon("B", "fixed", 100),
+        Coupon("A", "percent", 150),
+        Coupon("B", "fixed", 0),
+    ]
+    assert apply_coupons(100, coupons, date(2026, 1, 1)) == (
+        0, ["A", "B", "B", "Z"]
+    )
+
+
+def test_apply_coupons_empty_and_ineligible():
+    today = date(2026, 1, 1)
+    assert apply_coupons(0, [], today) == (0, [])
+    expired = Coupon("LATER", "percent", 10, expires=today - timedelta(days=1))
+    assert apply_coupons(100, [expired], today) == (100, [])
+
+
+def test_apply_coupons_rejects_negative_subtotal():
+    with pytest.raises(ValueError):
+        apply_coupons(-1, [], date(2026, 1, 1))
