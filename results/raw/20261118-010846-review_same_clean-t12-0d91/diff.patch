@@ -0,0 +1,81 @@
+import pytest
+
+from shoplib.errors import ShopError
+from shoplib.search import Product, search
+
+
+@pytest.fixture
+def products():
+    return [
+        Product("MUG-BLUE", "Blue Mug", 1000, ["Sale", "Kitchen"]),
+        Product("MUG-RED", "Red Mug", 1500, ["Kitchen", "gift"]),
+        Product("PLATE", "Blue Plate", 500, ["Sale"]),
+    ]
+
+
+@pytest.mark.parametrize(
+    ("query", "indices"),
+    [
+        ("", [0, 1, 2]),
+        (" \t\n", [0, 1, 2]),
+        ("BLUE", [0, 2]),
+        ('"blue mug"', [0]),
+        ('name:"BLUE MUG"', [0]),
+        ('"tag:sale"', []),
+        ("sku:mug-blue", [0]),
+        ("tag:sAlE", [0, 2]),
+        ("sku:MUG-*", [0, 1]),
+        ("tag:kit*", [0, 1]),
+        ("tag:*", [0, 1, 2]),
+        ("name:blu*", []),
+        ("sku:MU*BLUE", []),
+        ("blue tag:sale -sku:PLATE", [0]),
+        ('-"blue mug"', [1, 2]),
+        ("-tag:sale", [1]),
+        ("price<1000", [2]),
+        ("price<=1000", [0, 2]),
+        ("price>1000", [1]),
+        ("price>=1000", [0, 1]),
+        ("price=1000", [0]),
+        ('price>="1000"', [0, 1]),
+        ("-price>=1000", [2]),
+    ],
+)
+def test_matching(products, query, indices):
+    assert search(products, query) == [products[i] for i in indices]
+
+
+@pytest.mark.parametrize(
+    "query",
+    [
+        "unknown:value", "price:5", "tag:", 'name:""', "sku:",
+        "-", '"unclosed', 'tag:"unclosed',
+        "price<", "price>=-1", "price=1.5", "price=1x", "price==1",
+        'price>="nope"', 'price=""',
+    ],
+)
+def test_invalid_queries_raise_shop_error_even_without_products(query):
+    with pytest.raises(ShopError):
+        search([], query)
+
+
+def test_literal_asterisks_and_quoted_syntax():
+    product = Product("A*B", 'price>=10 -sale tag:sale', 10, ["a*b"])
+    assert search([product], "sku:A*B tag:a*b") == [product]
+    assert search([product], '"price>=10" "-sale" "tag:sale"') == [product]
+    assert search([Product("x", "x", 10)], "tag:*") == []
+
+
+def test_unicode_case_insensitive_matching():
+    product = Product("Straße-1", "Straße Mug", 10, ["Straße"])
+    for query in ("STRASSE", "name:STRASSE", "sku:STRASSE-1", "sku:STRASSE*",
+                  "tag:STRASSE", "tag:STRASSE*"):
+        assert search([product], query) == [product]
+
+
+def test_price_comparisons_accept_very_large_whole_numbers():
+    amount = "1" + "0" * 5000
+    product = Product("x", "x", 10 ** 5000)
+    assert search([product], "price=" + amount) == [product]
+    assert search([product], "price<" + amount) == []
+    assert search([Product("y", "y", 0)], "price=" + "0" * 5000) != []
