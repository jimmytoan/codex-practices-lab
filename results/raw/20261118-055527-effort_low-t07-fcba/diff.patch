+
+def test_apply_coupons_eligibility_uses_original_subtotal_and_includes_expiry_day():
+    coupons = [
+        Coupon("MIN", "fixed", 100, min_subtotal_cents=1000),
+        Coupon("EXPIRED", "fixed", 100, expires=date(2024, 12, 31)),
+        Coupon("TODAY", "fixed", 100, expires=date(2025, 1, 1)),
+    ]
+    assert apply_coupons(1000, coupons, date(2025, 1, 1)) == (800, ["MIN", "TODAY"])
+
+
+def test_apply_coupons_percent_tie_breaks_by_code_and_clamps_at_zero():
