+def test_apply_coupons_chooses_highest_percent_then_all_fixed():
+    coupons = [
+        Coupon("TEN", "percent", 10),
+        Coupon("TWENTY", "percent", 20),
+        Coupon("B", "fixed", 125),
+        Coupon("A", "fixed", 75),
+    ]
+    assert apply_coupons(1000, coupons, date(2025, 1, 1)) == (600, ["A", "B", "TWENTY"])
