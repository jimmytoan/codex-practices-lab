diff --git a/src/shoplib/costing.py b/src/shoplib/costing.py
index 5e8c27e..9518b1d 100644
--- a/src/shoplib/costing.py
+++ b/src/shoplib/costing.py
@@ -1,6 +1,87 @@
 """Cost of goods sold with FIFO lots. See docs/costing.md."""
 
+from collections import deque
+from decimal import Decimal, localcontext
+
+from shoplib.errors import ShopError
+from shoplib.money import round_cents
+
 
 def fifo_costing(events: list[dict]) -> dict:
     """Process stock events and report cost per SKU. See docs/costing.md."""
-    raise NotImplementedError
+    if not isinstance(events, list):
+        raise ShopError("events must be a list")
+    stock = {}
+
+    for event in events:
+        if not isinstance(event, dict):
+            raise ShopError("event must be a dict")
+        event_type = event.get("type")
+        if event_type not in ("receive", "sell", "return"):
+            raise ShopError("unknown event type")
+        if "sku" not in event:
+            raise ShopError("missing sku")
+        sku = event["sku"]
+        try:
+            hash(sku)
+        except TypeError as exc:
+            raise ShopError("sku must be hashable") from exc
+        qty = event.get("qty")
+        if type(qty) is not int or qty < 1:
+            raise ShopError("qty must be a positive integer")
+
+        if event_type == "receive":
+            unit_cost = event.get("unit_cost_cents")
+            if type(unit_cost) is not int or unit_cost < 0:
+                raise ShopError("unit cost must be a nonnegative integer")
+
+        state = stock.setdefault(sku, {
+            "lots": deque(), "on_hand": 0, "cogs_cents": 0, "last_sale": None,
+        })
+        if event_type == "receive":
+            state["lots"].append((qty, unit_cost))
+            state["on_hand"] += qty
+        elif event_type == "sell":
+            if qty > state["on_hand"]:
+                raise ShopError("insufficient stock")
+            remaining = qty
+            sale_cost = 0
+            while remaining:
+                lot_qty, unit_cost = state["lots"].popleft()
+                taken = min(remaining, lot_qty)
+                sale_cost += taken * unit_cost
+                remaining -= taken
+                if taken < lot_qty:
+                    state["lots"].appendleft((lot_qty - taken, unit_cost))
+            state["on_hand"] -= qty
+            state["cogs_cents"] += sale_cost
+
+            # Compare the remainder exactly so division cannot round a value
+            # just below half a cent up to the half-cent boundary.
+            whole, remainder = divmod(sale_cost, qty)
+            with localcontext() as context:
+                context.prec = max(context.prec, len(str(whole)) + 2)
+                average = Decimal(whole)
+                if remainder * 2 >= qty:
+                    average += Decimal("0.5")
+                return_cost = round_cents(average)
+            state["last_sale"] = [qty, return_cost]
+        else:
+            last_sale = state["last_sale"]
+            if last_sale is None:
+                raise ShopError("no sale to return")
+            if qty > last_sale[0]:
+                raise ShopError("return exceeds most recent sale")
+            last_sale[0] -= qty
+            state["lots"].append((qty, last_sale[1]))
+            state["on_hand"] += qty
+            state["cogs_cents"] -= qty * last_sale[1]
+
+    return {
+        sku: {
+            "cogs_cents": state["cogs_cents"],
+            "on_hand": state["on_hand"],
+            "value_cents": sum(qty * cost for qty, cost in state["lots"]),
+        }
+        for sku, state in stock.items()
+    }
diff --git a/tests/test_costing.py b/tests/test_costing.py
new file mode 100644
index 0000000..1382b50
--- /dev/null
+++ b/tests/test_costing.py
@@ -0,0 +1,117 @@
+from copy import deepcopy
+
+import pytest
+
+from shoplib.costing import fifo_costing
+from shoplib.errors import ShopError
+
+
+def test_fifo_costing_tracks_lots_and_skus_without_changing_events():
+    events = [
+        {"type": "receive", "sku": "A", "qty": 2, "unit_cost_cents": 100},
+        {"type": "receive", "sku": "B", "qty": 3, "unit_cost_cents": 25},
+        {"type": "receive", "sku": "A", "qty": 3, "unit_cost_cents": 200},
+        {"type": "sell", "sku": "A", "qty": 3},
+        {"type": "sell", "sku": "B", "qty": 3},
+    ]
+    original = deepcopy(events)
+    assert fifo_costing(events) == {
+        "A": {"cogs_cents": 400, "on_hand": 2, "value_cents": 400},
+        "B": {"cogs_cents": 75, "on_hand": 0, "value_cents": 0},
+    }
+    assert events == original
+    assert fifo_costing([]) == {}
+
+
+def test_returns_round_half_up_and_are_sold_after_existing_lots():
+    events = [
+        {"type": "receive", "sku": "A", "qty": 1, "unit_cost_cents": 1},
+        {"type": "receive", "sku": "A", "qty": 1, "unit_cost_cents": 2},
+        {"type": "sell", "sku": "A", "qty": 2},
+        {"type": "receive", "sku": "A", "qty": 1, "unit_cost_cents": 10},
+        {"type": "return", "sku": "A", "qty": 1},
+        {"type": "return", "sku": "A", "qty": 1},
+    ]
+    assert fifo_costing(events) == {
+        "A": {"cogs_cents": -1, "on_hand": 3, "value_cents": 14},
+    }
+    events.append({"type": "sell", "sku": "A", "qty": 2})
+    assert fifo_costing(events) == {
+        "A": {"cogs_cents": 11, "on_hand": 1, "value_cents": 2},
+    }
+
+
+def test_return_only_applies_to_most_recent_sale_per_sku():
+    events = [
+        {"type": "receive", "sku": "A", "qty": 3, "unit_cost_cents": 4},
+        {"type": "receive", "sku": "B", "qty": 1, "unit_cost_cents": 7},
+        {"type": "sell", "sku": "A", "qty": 2},
+        {"type": "sell", "sku": "A", "qty": 1},
+        {"type": "sell", "sku": "B", "qty": 1},
+        {"type": "return", "sku": "A", "qty": 1},
+        {"type": "return", "sku": "B", "qty": 1},
+    ]
+    assert fifo_costing(events) == {
+        "A": {"cogs_cents": 8, "on_hand": 1, "value_cents": 4},
+        "B": {"cogs_cents": 0, "on_hand": 1, "value_cents": 7},
+    }
+    with pytest.raises(ShopError):
+        fifo_costing(events + [{"type": "return", "sku": "A", "qty": 1}])
+
+
+def test_average_just_below_half_cent_does_not_round_up():
+    qty = 10**30
+    events = [
+        {"type": "receive", "sku": "A", "qty": qty // 2 - 1, "unit_cost_cents": 1},
+        {"type": "receive", "sku": "A", "qty": qty // 2 + 1, "unit_cost_cents": 0},
+        {"type": "sell", "sku": "A", "qty": qty},
+        {"type": "return", "sku": "A", "qty": 1},
+    ]
+    assert fifo_costing(events)["A"] == {
+        "cogs_cents": qty // 2 - 1, "on_hand": 1, "value_cents": 0,
+    }
+
+
+def test_return_average_supports_large_costs():
+    cost = 10**35
+    events = [
+        {"type": "receive", "sku": "A", "qty": 1, "unit_cost_cents": cost},
+        {"type": "receive", "sku": "A", "qty": 1, "unit_cost_cents": cost + 1},
+        {"type": "sell", "sku": "A", "qty": 2},
+        {"type": "return", "sku": "A", "qty": 1},
+    ]
+    assert fifo_costing(events)["A"] == {
+        "cogs_cents": cost, "on_hand": 1, "value_cents": cost + 1,
+    }
+
+
+def test_invalid_events_container_raises_shop_error():
+    with pytest.raises(ShopError):
+        fifo_costing(None)
+
+
+@pytest.mark.parametrize("events", [
+    [{"type": "receive", "sku": "A", "qty": 0, "unit_cost_cents": 0}],
+    [{"type": "sell", "sku": "A", "qty": -1}],
+    [{"type": "return", "sku": "A", "qty": 0}],
+    [{"type": "receive", "sku": "A", "qty": 1, "unit_cost_cents": -1}],
+    [{"type": "sell", "sku": "A", "qty": 1}],
+    [{"type": "return", "sku": "A", "qty": 1}],
+    [{"type": "unknown", "sku": "A", "qty": 1}],
+    [
+        {"type": "receive", "sku": "A", "qty": 2, "unit_cost_cents": 1},
+        {"type": "sell", "sku": "A", "qty": 2},
+        {"type": "return", "sku": "A", "qty": 1},
+        {"type": "return", "sku": "A", "qty": 2},
+    ],
+    [{"type": "receive", "sku": "A", "qty": 1.5, "unit_cost_cents": 1}],
+    [{"type": "receive", "sku": "A", "qty": 1, "unit_cost_cents": 0.5}],
+    [{"type": "receive", "qty": 1, "unit_cost_cents": 1}],
+    [{"type": "receive", "sku": [], "qty": 1, "unit_cost_cents": 1}],
+    [None],
+])
+def test_invalid_events_raise_shop_error_without_changing_input(events):
+    original = deepcopy(events)
+    with pytest.raises(ShopError):
+        fifo_costing(events)
+    assert events == original
