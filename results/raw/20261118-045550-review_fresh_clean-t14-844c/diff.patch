@@ -0,0 +1,39 @@
+import pytest
+
+from shoplib.errors import ShopError
+from shoplib.storedays import daily_revenue
+
+
+def test_store_day_uses_local_start_hour_and_includes_exact_boundary():
+    sales = [
+        {"at": "2026-11-17T19:59:59Z", "cents": 100},
+        {"at": "2026-11-17T20:00:00+00:00", "cents": 200},
+        {"at": "2026-11-18T00:00:00-05:00", "cents": 300},
+    ]
+
+    assert daily_revenue(sales) == [
+        ("2026-11-17", 100),
+        ("2026-11-18", 500),
+    ]
+
+
+def test_daily_revenue_fills_gaps_and_counts_refunds():
+    sales = [
+        {"at": "2026-11-17T04:00:00+08:00", "cents": 1000},
+        {"at": "2026-11-19T04:00:00+08:00", "cents": -250},
+    ]
+
+    assert daily_revenue(sales) == [
+        ("2026-11-17", 1000),
+        ("2026-11-18", 0),
+        ("2026-11-19", -250),
+    ]
+
+
+def test_daily_revenue_without_sales_is_empty():
+    assert daily_revenue([]) == []
+
+
+def test_timestamp_without_zone_raises_shop_error():
+    with pytest.raises(ShopError, match="timestamp without a zone"):
+        daily_revenue([{"at": "2026-11-18T02:30:00", "cents": 100}])
