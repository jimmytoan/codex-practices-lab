@@ -0,0 +1,71 @@
+import pytest
+
+from shoplib.errors import ShopError
+from shoplib.search import Product, search
+
+
+@pytest.fixture
+def products():
+    return [
+        Product("MUG-001", "Blue mug", 1200, ["kitchen", "sale"]),
+        Product("MUG-002", "Blue travel cup", 1800, ["kitchen"]),
+        Product("PLATE-001", "Red plate", 800, ["sale"]),
+    ]
+
+
+def test_bare_terms_and_empty_query_match_in_input_order(products):
+    assert search(products, "blue mug") == [products[0]]
+    assert search(products, "") == products
+    assert search(products, "  \t ") == products
+
+
+def test_quoted_phrase_and_quoted_field_value(products):
+    assert search(products, '"blue mug"') == [products[0]]
+    assert search(products, 'name:"blue travel"') == [products[1]]
+
+
+def test_sku_and_tag_match_case_insensitively(products):
+    assert search(products, "sku:mug-001") == [products[0]]
+    assert search(products, "tag:SALE") == [products[0], products[2]]
+
+
+def test_sku_and_tag_prefix_match_only_when_value_ends_in_star(products):
+    assert search(products, "sku:MUG-*") == products[:2]
+    assert search(products, "tag:kit*") == products[:2]
+    products[0].tags.append("sa*le")
+    assert search(products, "tag:sa*le") == [products[0]]
+
+
+def test_price_comparisons_cover_all_operators(products):
+    assert search(products, "price<1200") == [products[2]]
+    assert search(products, "price<=1200") == [products[0], products[2]]
+    assert search(products, "price>1200") == [products[1]]
+    assert search(products, "price>=1200") == products[:2]
+    assert search(products, "price=800") == [products[2]]
+
+
+def test_terms_are_combined_and_can_be_negated(products):
+    assert search(products, "blue -tag:sale") == [products[1]]
+    assert search(products, "-price>=1200") == [products[2]]
+    assert search(products, "-\"blue mug\"") == products[1:]
+
+
+@pytest.mark.parametrize(
+    "query",
+    [
+        "price:5",
+        "unknown:value",
+        "tag:",
+        "name:\"\"",
+        "-",
+        '"unclosed',
+        "price>=",
+        "price>1.5",
+        "price<=-1",
+        "price=one",
+    ],
+)
+def test_invalid_queries_raise_value_error(query, products):
+    with pytest.raises(ShopError):
+        search(products, query)
+
