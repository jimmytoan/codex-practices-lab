diff --git a/src/shoplib/invoice.py b/src/shoplib/invoice.py
index 5d1398c..e28f9fb 100644
--- a/src/shoplib/invoice.py
+++ b/src/shoplib/invoice.py
@@ -1,5 +1,8 @@
 """Invoices: coupon allocation and tax. See docs/invoicing.md."""
 
+from shoplib.errors import ShopError
+from shoplib.money import percent_of
+
 # Tax rates in percent, by region and product category.
 TAX_RATES = {
     "DE": {"standard": 19, "food": 7, "books": 7},
@@ -10,4 +13,61 @@ TAX_RATES = {
 
 def build_invoice(lines, coupon_cents: int, shipping_cents: int, region: str) -> dict:
     """Build an invoice for an order. See docs/invoicing.md."""
-    raise NotImplementedError
+    if region not in TAX_RATES:
+        raise ShopError(f"unknown region: {region}")
+    if not lines:
+        raise ShopError("lines must not be empty")
+    if coupon_cents < 0:
+        raise ShopError("coupon must not be negative")
+    if shipping_cents < 0:
+        raise ShopError("shipping must not be negative")
+
+    rates = TAX_RATES[region]
+    gross_amounts = []
+    for sku, unit_price_cents, qty, category in lines:
+        if category not in rates:
+            raise ShopError(f"unknown category: {category}")
+        if qty < 1:
+            raise ShopError("quantity must be at least 1")
+        if unit_price_cents < 0:
+            raise ShopError("price must not be negative")
+        gross_amounts.append(unit_price_cents * qty)
+
+    total_gross = sum(gross_amounts)
+    coupon = min(coupon_cents, total_gross)
+    discounts = [0] * len(lines)
+    if total_gross:
+        remainders = []
+        allocated = 0
+        for index, gross in enumerate(gross_amounts):
+            quotient, remainder = divmod(coupon * gross, total_gross)
+            discounts[index] = quotient
+            allocated += quotient
+            remainders.append((remainder, index))
+        for _, index in sorted(remainders, key=lambda item: (-item[0], item[1]))[:coupon - allocated]:
+            discounts[index] += 1
+
+    result_lines = []
+    line_tax_total = 0
+    for (sku, _, _, category), gross, discount in zip(lines, gross_amounts, discounts):
+        net = gross - discount
+        tax = percent_of(net, rates[category])
+        line_tax_total += tax
+        result_lines.append({
+            "sku": sku,
+            "gross_cents": gross,
+            "discount_cents": discount,
+            "net_cents": net,
+            "tax_cents": tax,
+        })
+
+    shipping_tax = percent_of(shipping_cents, rates["standard"]) if any(
+        rates[line[3]] > 0 for line in lines
+    ) else 0
+    total = sum(line["net_cents"] for line in result_lines) + line_tax_total + shipping_cents + shipping_tax
+    return {
+        "lines": result_lines,
+        "shipping_cents": shipping_cents,
+        "shipping_tax_cents": shipping_tax,
+        "total_cents": total,
+    }
diff --git a/tests/test_invoice.py b/tests/test_invoice.py
new file mode 100644
index 0000000..5e96527
--- /dev/null
+++ b/tests/test_invoice.py
@@ -0,0 +1,53 @@
+import pytest
+
+from shoplib.errors import ShopError
+from shoplib.invoice import build_invoice
+
+
+def test_coupon_is_split_by_largest_remainder_and_ties_keep_input_order():
+    invoice = build_invoice(
+        [("a", 100, 1, "books"), ("b", 100, 1, "books"), ("c", 100, 1, "books")],
+        coupon_cents=2,
+        shipping_cents=0,
+        region="OR",
+    )
+    assert [line["discount_cents"] for line in invoice["lines"]] == [1, 1, 0]
+    assert [line["net_cents"] for line in invoice["lines"]] == [99, 99, 100]
+    assert invoice["total_cents"] == 298
+
+
+def test_coupon_is_capped_and_zero_gross_allocates_no_discount():
+    capped = build_invoice([("a", 25, 2, "food")], 100, 0, "OR")
+    assert capped["lines"][0]["discount_cents"] == 50
+    zero = build_invoice([("a", 0, 1, "food"), ("b", 0, 2, "books")], 20, 0, "DE")
+    assert [line["discount_cents"] for line in zero["lines"]] == [0, 0]
+
+
+def test_tax_is_rounded_per_line_and_shipping_tax_depends_on_taxable_category():
+    invoice = build_invoice(
+        [("a", 3, 1, "food"), ("b", 3, 1, "food")], 0, 101, "DE"
+    )
+    assert [line["tax_cents"] for line in invoice["lines"]] == [0, 0]
+    assert invoice["shipping_tax_cents"] == 19
+    assert invoice["total_cents"] == 126
+
+    exempt_region = build_invoice([("book", 100, 1, "books")], 0, 50, "SG")
+    assert exempt_region["shipping_tax_cents"] == 0
+    assert exempt_region["total_cents"] == 150
+
+
+@pytest.mark.parametrize(
+    "lines,coupon,shipping,region",
+    [
+        ([("a", 1, 1, "books")], 0, 0, "XX"),
+        ([("a", 1, 1, "unknown")], 0, 0, "DE"),
+        ([], 0, 0, "DE"),
+        ([("a", 1, 0, "books")], 0, 0, "DE"),
+        ([("a", -1, 1, "books")], 0, 0, "DE"),
+        ([("a", 1, 1, "books")], -1, 0, "DE"),
+        ([("a", 1, 1, "books")], 0, -1, "DE"),
+    ],
+)
+def test_invalid_invoice_inputs_raise(lines, coupon, shipping, region):
+    with pytest.raises(ValueError):
+        build_invoice(lines, coupon, shipping, region)
