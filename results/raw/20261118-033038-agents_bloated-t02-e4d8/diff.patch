+def test_ten_or_more_units_get_five_percent_off_line_total():
+    cart = Cart()
+    cart.add("A", 250, 9)
+    cart.add("B", 250, 10)
+    cart.add("C", 250, 12)
+
+    assert cart.line_total("A") == 2250
+    assert cart.line_total("B") == 2375
+    assert cart.line_total("C") == 2850
+    assert cart.subtotal() == 7475
+
+
+def test_quantity_added_to_same_sku_can_reach_discount_threshold():
+    cart = Cart()
+    cart.add("A", 250, 8)
+    cart.add("A", 250, 2)
+
+    assert cart.line_total("A") == 2375
+
+
 def test_bad_qty():
     with pytest.raises(ValueError):
         Cart().add("A", 250, 0)
