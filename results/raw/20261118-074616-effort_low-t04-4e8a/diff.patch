@@ -1,6 +1,7 @@
 """Orders and their life cycle. See docs/order-states.md."""
 
 from .inventory import Inventory
+from .errors import ShopError
 
 NEW = "NEW"
 PAID = "PAID"
@@ -13,7 +14,7 @@ class Order:
     def __init__(self, order_id: str, lines: dict[str, int], inventory: Inventory):
         """Create an order for `lines` (sku -> qty) and reserve its stock."""
         if not lines:
-            raise ValueError("an order needs at least one line")
+            raise ShopError("an order needs at least one line")
         self.order_id = order_id
         self.lines = dict(lines)
         self.inventory = inventory
@@ -31,7 +32,7 @@ class Order:
 
     def _transition(self, allowed_from: tuple[str, ...], to: str) -> None:
         if self.state not in allowed_from:
-            raise ValueError(f"cannot go from {self.state} to {to}")
+            raise ShopError(f"cannot go from {self.state} to {to}")
         self.state = to
 
     def pay(self) -> None:
@@ -39,10 +40,27 @@ class Order:
 
     def ship(self) -> None:
         if self.state != PAID:
-            raise ValueError(f"cannot go from {self.state} to {SHIPPED}")
+            raise ShopError(f"cannot go from {self.state} to {SHIPPED}")
         for sku, qty in self.lines.items():
             self.inventory.ship(sku, qty)
         self.state = SHIPPED
 
     def deliver(self) -> None:
         self._transition((SHIPPED,), DELIVERED)
+
+    def cancel(self) -> None:
+        if self.state == CANCELLED:
+            return
+        if self.state not in (NEW, PAID):
+            raise ShopError(f"cannot cancel an order in {self.state}")
+
+        # Check every line before changing inventory so a failed release cannot
+        # leave a multi-line order partially cancelled.
+        for sku, qty in self.lines.items():
+            if qty > self.inventory.reserved(sku):
+                raise ShopError(f"only {self.inventory.reserved(sku)} of {sku} reserved")
+        for sku, qty in self.lines.items():
+            self.inventory.release(sku, qty)
+        if self.state == PAID:
+            self.refund_due = True
+        self.state = CANCELLED
diff --git a/tests/test_inventory.py b/tests/test_inventory.py
index 37436c0..8d53189 100644
--- a/tests/test_inventory.py
+++ b/tests/test_inventory.py
@@ -18,3 +18,25 @@ def test_cannot_reserve_more_than_available():
     inv.receive("A", 2)
     with pytest.raises(ValueError):
         inv.reserve("A", 3)
+
+
+def test_release_returns_reserved_stock_to_available():
+    inv = Inventory()
+    inv.receive("A", 10)
+    inv.reserve("A", 4)
+    inv.release("A", 3)
+    assert inv.on_hand("A") == 10
+    assert inv.reserved("A") == 1
+    assert inv.available("A") == 9
+
+
+@pytest.mark.parametrize("qty,reserve_qty", [(0, 1), (-1, 1), (2, 1), (1, 0)])
+def test_release_rejects_invalid_or_unreserved_quantity(qty, reserve_qty):
+    inv = Inventory()
+    inv.receive("A", 10)
+    if reserve_qty:
+        inv.reserve("A", reserve_qty)
+    before = (inv.on_hand("A"), inv.reserved("A"), inv.available("A"))
+    with pytest.raises(ValueError):
+        inv.release("A", qty)
+    assert (inv.on_hand("A"), inv.reserved("A"), inv.available("A")) == before
diff --git a/tests/test_orders.py b/tests/test_orders.py
