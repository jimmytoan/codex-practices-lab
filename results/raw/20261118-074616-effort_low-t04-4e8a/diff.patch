@@ -1,7 +1,7 @@
 import pytest
 
 from shoplib.inventory import Inventory
-from shoplib.orders import DELIVERED, NEW, Order
+from shoplib.orders import CANCELLED, DELIVERED, NEW, PAID, SHIPPED, Order
 
 
 def make():
@@ -25,3 +25,51 @@ def test_cannot_ship_unpaid():
     _, order = make()
     with pytest.raises(ValueError):
         order.ship()
+
+
+def test_cancel_new_releases_stock_and_is_idempotent():
+    inv, order = make()
+    order.cancel()
+    assert order.state == CANCELLED
+    assert order.refund_due is False
+    assert inv.reserved("A") == 0
+    assert inv.available("A") == 5
+    order.cancel()
+    assert inv.available("A") == 5
+
+
+def test_cancel_paid_releases_stock_and_marks_refund_due():
+    inv, order = make()
+    order.pay()
+    order.cancel()
+    assert order.state == CANCELLED
+    assert order.refund_due is True
+    assert inv.reserved("A") == 0
+    assert inv.available("A") == 5
+
+
+@pytest.mark.parametrize("state", [SHIPPED, DELIVERED])
+def test_cannot_cancel_shipped_or_delivered_order(state):
+    inv, order = make()
+    order.pay()
+    order.ship()
+    if state == DELIVERED:
+        order.deliver()
+    before = (order.state, order.refund_due, inv.on_hand("A"), inv.reserved("A"))
+    with pytest.raises(ValueError):
+        order.cancel()
+    assert (order.state, order.refund_due, inv.on_hand("A"), inv.reserved("A")) == before
+
+
+def test_cancel_preflights_all_lines_before_releasing():
+    inv = Inventory()
+    inv.receive("A", 5)
+    inv.receive("B", 5)
+    order = Order("o2", {"A": 2, "B": 2}, inv)
+    inv._reserved["B"] = 1
+    before_a = inv.reserved("A")
+    with pytest.raises(ValueError):
+        order.cancel()
+    assert order.state == NEW
+    assert inv.reserved("A") == before_a
+    assert inv.reserved("B") == 1
