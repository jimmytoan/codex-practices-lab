diff --git a/tests/test_inventory.py b/tests/test_inventory.py
index 37436c0..777414f 100644
--- a/tests/test_inventory.py
+++ b/tests/test_inventory.py
@@ -1,5 +1,6 @@
 import pytest
 
+from shoplib.errors import ShopError
 from shoplib.inventory import Inventory
 
 
@@ -18,3 +19,43 @@ def test_cannot_reserve_more_than_available():
     inv.receive("A", 2)
     with pytest.raises(ValueError):
         inv.reserve("A", 3)
+
+
+def test_release_returns_reserved_units_to_available():
+    inv = Inventory()
+    inv.receive("A", 10)
+    inv.reserve("A", 6)
+
+    inv.release("A", 2)
+
+    assert inv.on_hand("A") == 10
+    assert inv.reserved("A") == 4
+    assert inv.available("A") == 6
+
+
+@pytest.mark.parametrize("qty", [0, -1])
+def test_release_requires_positive_quantity_without_changing_stock(qty):
+    inv = Inventory()
+    inv.receive("A", 10)
+    inv.reserve("A", 4)
+
+    with pytest.raises(ShopError):
+        inv.release("A", qty)
+
+    assert inv.on_hand("A") == 10
+    assert inv.reserved("A") == 4
+    assert inv.available("A") == 6
+
+
+@pytest.mark.parametrize("sku, reserved, qty", [("A", 3, 4), ("B", 0, 1)])
+def test_release_cannot_exceed_reserved_quantity_or_change_stock(sku, reserved, qty):
+    inv = Inventory()
+    inv.receive("A", 10)
+    if reserved:
+        inv.reserve("A", reserved)
+    before = (inv.on_hand(sku), inv.reserved(sku), inv.available(sku))
+
+    with pytest.raises(ShopError):
+        inv.release(sku, qty)
+
+    assert (inv.on_hand(sku), inv.reserved(sku), inv.available(sku)) == before
