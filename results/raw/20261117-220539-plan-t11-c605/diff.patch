diff --git a/src/shoplib/invoice.py b/src/shoplib/invoice.py
index 5d1398c..91a9c24 100644
--- a/src/shoplib/invoice.py
+++ b/src/shoplib/invoice.py
@@ -1,5 +1,8 @@
 """Invoices: coupon allocation and tax. See docs/invoicing.md."""
 
+from .errors import ShopError
+from .money import percent_of
+
 # Tax rates in percent, by region and product category.
 TAX_RATES = {
     "DE": {"standard": 19, "food": 7, "books": 7},
@@ -10,4 +13,53 @@ TAX_RATES = {
 
 def build_invoice(lines, coupon_cents: int, shipping_cents: int, region: str) -> dict:
     """Build an invoice for an order. See docs/invoicing.md."""
-    raise NotImplementedError
+    if region not in TAX_RATES:
+        raise ShopError("unknown region")
+    if not lines:
+        raise ShopError("lines must not be empty")
+    if coupon_cents < 0 or shipping_cents < 0:
+        raise ShopError("coupon and shipping must not be negative")
+
+    rates = TAX_RATES[region]
+    gross_amounts = []
+    for _, price, qty, category in lines:
+        if category not in rates:
+            raise ShopError("unknown category")
+        if price < 0 or qty < 1:
+            raise ShopError("price must be nonnegative and quantity positive")
+        gross_amounts.append(price * qty)
+
+    total_gross = sum(gross_amounts)
+    coupon = min(coupon_cents, total_gross)
+    discounts = [0] * len(lines)
+    if total_gross:
+        shares = [divmod(coupon * gross, total_gross) for gross in gross_amounts]
+        discounts = [share for share, _ in shares]
+        remaining = coupon - sum(discounts)
+        order = sorted(range(len(lines)), key=lambda i: shares[i][1], reverse=True)
+        for i in order[:remaining]:
+            discounts[i] += 1
+
+    invoice_lines = []
+    for (sku, _, _, category), gross, discount in zip(lines, gross_amounts, discounts):
+        net = gross - discount
+        invoice_lines.append({
+            "sku": sku,
+            "gross_cents": gross,
+            "discount_cents": discount,
+            "net_cents": net,
+            "tax_cents": percent_of(net, rates[category]),
+        })
+
+    shipping_tax = (
+        percent_of(shipping_cents, rates["standard"])
+        if any(rates[category] > 0 for _, _, _, category in lines)
+        else 0
+    )
+    total = sum(line["net_cents"] + line["tax_cents"] for line in invoice_lines)
+    return {
+        "lines": invoice_lines,
+        "shipping_cents": shipping_cents,
+        "shipping_tax_cents": shipping_tax,
+        "total_cents": total + shipping_cents + shipping_tax,
+    }
diff --git a/tests/test_invoice.py b/tests/test_invoice.py
new file mode 100644
index 0000000..b6cb91d
--- /dev/null
+++ b/tests/test_invoice.py
@@ -0,0 +1,80 @@
+import pytest
+
+from shoplib.errors import ShopError
+from shoplib.invoice import build_invoice
+
+
+def test_coupon_allocation_taxes_and_total():
+    invoice = build_invoice(
+        [("a", 100, 3, "standard"), ("b", 200, 1, "food"), ("c", 100, 1, "books")],
+        101,
+        50,
+        "DE",
+    )
+    assert invoice == {
+        "lines": [
+            {"sku": "a", "gross_cents": 300, "discount_cents": 50, "net_cents": 250, "tax_cents": 48},
+            {"sku": "b", "gross_cents": 200, "discount_cents": 34, "net_cents": 166, "tax_cents": 12},
+            {"sku": "c", "gross_cents": 100, "discount_cents": 17, "net_cents": 83, "tax_cents": 6},
+        ],
+        "shipping_cents": 50,
+        "shipping_tax_cents": 10,
+        "total_cents": 625,
+    }
+
+
+def test_equal_remainders_favor_earlier_lines():
+    invoice = build_invoice(
+        [("first", 1, 1, "books"), ("second", 1, 1, "books"), ("third", 1, 1, "books")],
+        2, 0, "SG",
+    )
+    assert [line["discount_cents"] for line in invoice["lines"]] == [1, 1, 0]
+    assert invoice["total_cents"] == 1
+
+
+def test_coupon_is_capped_at_gross_and_zero_gross_gets_no_discount():
+    lines = [("a", 100, 1, "books"), ("free", 0, 2, "books"), ("b", 50, 2, "books")]
+    invoice = build_invoice(lines, 500, 10, "SG")
+    assert [line["discount_cents"] for line in invoice["lines"]] == [100, 0, 100]
+    assert [line["net_cents"] for line in invoice["lines"]] == [0, 0, 0]
+    assert invoice["total_cents"] == 10
+
+    invoice = build_invoice([("free", 0, 1, "books")], 500, 10, "SG")
+    assert invoice["lines"][0]["discount_cents"] == 0
+    assert invoice["total_cents"] == 10
+
+
+def test_tax_is_rounded_per_line_and_shipping():
+    invoice = build_invoice(
+        [("a", 6, 1, "standard"), ("b", 6, 1, "food")], 0, 6, "SG"
+    )
+    assert [line["tax_cents"] for line in invoice["lines"]] == [1, 1]
+    assert invoice["shipping_tax_cents"] == 1
+    assert invoice["total_cents"] == 21
+
+
+def test_shipping_tax_depends_on_category_rate_even_for_free_lines():
+    exempt = build_invoice([("book", 100, 1, "books")], 0, 100, "SG")
+    assert exempt["shipping_tax_cents"] == 0
+    taxable = build_invoice([("book", 100, 1, "books"), ("free", 0, 1, "food")], 0, 100, "SG")
+    assert taxable["shipping_tax_cents"] == 9
+    no_tax_region = build_invoice([("item", 100, 1, "standard")], 0, 100, "OR")
+    assert no_tax_region["shipping_tax_cents"] == 0
+
+
+@pytest.mark.parametrize(
+    "lines,coupon,shipping,region",
+    [
+        ([("a", 1, 1, "standard")], 0, 0, "unknown"),
+        ([("a", 1, 1, "unknown")], 0, 0, "SG"),
+        ([], 0, 0, "SG"),
+        ([("a", 1, 0, "standard")], 0, 0, "SG"),
+        ([("a", 1, -1, "standard")], 0, 0, "SG"),
+        ([("a", -1, 1, "standard")], 0, 0, "SG"),
+        ([("a", 1, 1, "standard")], -1, 0, "SG"),
+        ([("a", 1, 1, "standard")], 0, -1, "SG"),
+    ],
+)
+def test_invalid_arguments_raise_shop_error(lines, coupon, shipping, region):
+    with pytest.raises(ShopError):
+        build_invoice(lines, coupon, shipping, region)
