-from shoplib.discounts import Coupon, apply_coupon
+from datetime import date
+
+import pytest
+
+from shoplib.discounts import Coupon, apply_coupon, apply_coupons
+from shoplib.errors import ShopError
 
 
 def test_percent():
@@ -7,3 +12,50 @@ def test_percent():
 
 def test_fixed_never_negative():
     assert apply_coupon(300, Coupon("FIVE", "fixed", 500)) == 0
+
+
+def test_combines_best_percent_and_all_eligible_fixed_coupons():
+    today = date(2026, 11, 17)
+    coupons = [
+        Coupon("Z_TEN", "percent", 10),
+        Coupon("A_TEN", "percent", 10, expires=today),
+        Coupon("LOW", "percent", 5),
+        Coupon("EXPIRED", "percent", 90, expires=date(2026, 11, 16)),
+        Coupon("MINIMUM", "percent", 80, min_subtotal_cents=1002),
+        Coupon("FIXED_B", "fixed", 200, min_subtotal_cents=1001),
+        Coupon("FIXED_A", "fixed", 100, expires=today),
+        Coupon("EXPIRED_FIXED", "fixed", 200, expires=date(2026, 11, 16)),
+        Coupon("HIGH_MIN_FIXED", "fixed", 200, min_subtotal_cents=1002),
+    ]
+    assert apply_coupons(1001, coupons, today) == (
+        601, ["A_TEN", "FIXED_A", "FIXED_B"]
+    )
+
+
+def test_percentage_rounds_half_up_before_fixed_discounts():
+    coupons = [Coupon("FIXED", "fixed", 1), Coupon("HALF", "percent", 50)]
+    assert apply_coupons(5, coupons, date(2026, 1, 1)) == (1, ["FIXED", "HALF"])
+
+
+def test_all_eligible_fixed_codes_are_reported_when_total_hits_zero():
+    coupons = [Coupon("B", "fixed", 500), Coupon("A", "fixed", 50)]
+    assert apply_coupons(100, coupons, date(2026, 1, 1)) == (0, ["A", "B"])
+
+
+def test_empty_and_ineligible_coupons():
+    today = date(2026, 1, 1)
+    assert apply_coupons(0, [], today) == (0, [])
+    assert apply_coupons(100, [Coupon("LATE", "fixed", 50, min_subtotal_cents=101)], today) == (100, [])
+
+
+def test_duplicate_fixed_codes_are_reported_for_each_coupon():
+    coupons = [Coupon("SAME", "fixed", 10), Coupon("SAME", "fixed", 20)]
+    assert apply_coupons(100, coupons, date(2026, 1, 1)) == (70, ["SAME", "SAME"])
+
+
+def test_invalid_subtotal_and_coupon_kind_raise_shop_error():
+    today = date(2026, 1, 1)
+    with pytest.raises(ShopError):
+        apply_coupons(-1, [], today)
+    with pytest.raises(ShopError):
+        apply_coupons(100, [Coupon("BAD", "unknown", 10)], today)
