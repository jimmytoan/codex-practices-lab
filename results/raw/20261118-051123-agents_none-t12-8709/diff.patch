@@ -0,0 +1,64 @@
+import pytest
+
+from shoplib.search import Product, search
+
+
+@pytest.fixture
+def products():
+    return [
+        Product("MUG-01", "Blue Travel Mug", 1200, ["drinkware", "sale"]),
+        Product("MUG-02", "Blue ceramic mug", 900, ["drinkware"]),
+        Product("CUP-01", "Red cup", 500, ["sale"]),
+    ]
+
+
+def test_empty_query_and_bare_terms_match_in_input_order(products):
+    assert search(products, "  \t ") == products
+    assert search(products, '"travel mug"') == [products[0]]
+    assert search(products, "MUG blue") == products[:2]
+    assert search(products, '"blue ceramic"') == [products[1]]
+
+
+def test_fields_are_case_insensitive_and_quoted_values_keep_spaces(products):
+    assert search(products, "sku:mug-02") == [products[1]]
+    assert search(products, "tag:SALE") == [products[0], products[2]]
+    assert search(products, 'name:"blue ceramic"') == [products[1]]
+    assert search(products, 'tag:"drinkware"') == products[:2]
+
+
+def test_prefix_fields_and_other_asterisks(products):
+    assert search(products, "sku:MUG-*") == products[:2]
+    assert search(products, "tag:dri*") == products[:2]
+    assert search(products, "sku:MUG*01") == []
+    assert search(products, "name:*") == []
+
+
+def test_price_comparisons_and_negation(products):
+    assert search(products, "price<900") == [products[2]]
+    assert search(products, "price<=900") == [products[1], products[2]]
+    assert search(products, "price>900") == [products[0]]
+    assert search(products, "price>=900") == products[:2]
+    assert search(products, "price=500") == [products[2]]
+    assert search(products, "-tag:sale") == [products[1]]
+    assert search(products, '-name:"travel mug"') == products[1:]
+
+
+@pytest.mark.parametrize(
+    "query",
+    [
+        "other:value",
+        "price:5",
+        "tag:",
+        'tag:""',
+        "-",
+        '"not closed',
+        "price>",
+        "price>=one",
+        "price<1.5",
+        "price=-1",
+    ],
+)
+def test_invalid_queries_raise_value_error(products, query):
+    with pytest.raises(ValueError):
+        search(products, query)
+
