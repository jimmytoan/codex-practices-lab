 """Product search. See docs/search.md."""
 
 from dataclasses import dataclass, field
+import re
+from typing import Callable
 
 
 @dataclass
@@ -11,6 +13,111 @@ class Product:
     tags: list[str] = field(default_factory=list)
 
 
+def _tokens(query: str) -> list[str]:
+    """Split on unquoted whitespace, retaining quotes for syntax checks."""
+    tokens: list[str] = []
+    current: list[str] = []
+    quoted = False
+
+    for char in query:
+        if char == '"':
+            quoted = not quoted
+            current.append(char)
+        elif char.isspace() and not quoted:
+            if current:
+                tokens.append("".join(current))
+                current = []
+        else:
+            current.append(char)
+
+    if quoted:
+        raise ValueError("unclosed quote")
+    if current:
+        tokens.append("".join(current))
+    return tokens
+
+
+def _unquote(value: str) -> str:
+    """Remove quote delimiters from a token or field value."""
+    return value.replace('"', "")
+
+
+def _outside_colon(token: str) -> int:
+    quoted = False
+    for index, char in enumerate(token):
+        if char == '"':
+            quoted = not quoted
+        elif char == ":" and not quoted:
+            return index
+    return -1
+
+
+def _compile_term(token: str) -> tuple[Callable[[Product], bool], bool]:
+    negated = token.startswith("-")
+    if negated:
+        token = token[1:]
+        if not token:
+            raise ValueError("negation requires a term")
+
+    colon = _outside_colon(token)
+    if colon >= 0:
+        field_name = token[:colon]
+        value = _unquote(token[colon + 1 :])
+        if field_name not in {"sku", "name", "tag"}:
+            raise ValueError(f"unknown search field: {field_name}")
+        if value == "":
+            raise ValueError("field value cannot be empty")
+
+        folded = value.casefold()
+        if field_name == "sku":
+            if value.endswith("*"):
+                prefix = value[:-1].casefold()
+                return lambda product: product.sku.casefold().startswith(prefix), negated
+            return lambda product: product.sku.casefold() == folded, negated
+        if field_name == "tag":
+            if value.endswith("*"):
+                prefix = value[:-1].casefold()
+                return (
+                    lambda product: any(tag.casefold().startswith(prefix) for tag in product.tags),
+                    negated,
+                )
+            return (
+                lambda product: any(tag.casefold() == folded for tag in product.tags),
+                negated,
+            )
+        return lambda product: folded in product.name.casefold(), negated
+
+    # A quoted whole token is ordinary name text, even if it resembles a
+    # price comparison. Otherwise price comparisons must be contiguous.
+    if not token.startswith('"'):
+        match = re.fullmatch(r"price(<=|>=|<|>|=)(.*)", token)
+        if match:
+            operator, raw_value = match.groups()
+            if re.fullmatch(r"[0-9]+", raw_value) is None:
+                raise ValueError("price comparison requires a whole number of cents")
+            cents = int(raw_value)
+            comparisons: dict[str, Callable[[int, int], bool]] = {
+                "<": lambda price, amount: price < amount,
+                "<=": lambda price, amount: price <= amount,
+                ">": lambda price, amount: price > amount,
+                ">=": lambda price, amount: price >= amount,
+                "=": lambda price, amount: price == amount,
+            }
+            compare = comparisons[operator]
+            return lambda product: compare(product.price_cents, cents), negated
+
+    phrase = _unquote(token).casefold()
+    return lambda product: phrase in product.name.casefold(), negated
+
+
 def search(products: list[Product], query: str) -> list[Product]:
     """The products that match `query`, in their input order. See docs/search.md."""
-    raise NotImplementedError
+    terms = [_compile_term(token) for token in _tokens(query)]
+    return [
+        product
+        for product in products
+        if all(
+            not predicate(product) if negated else predicate(product)
+            for predicate, negated in terms
+        )
+    ]
diff --git a/tests/test_search.py b/tests/test_search.py
