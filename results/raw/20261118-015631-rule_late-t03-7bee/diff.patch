diff --git a/tests/test_inventory.py b/tests/test_inventory.py
index 37436c0..7ab64e5 100644
--- a/tests/test_inventory.py
+++ b/tests/test_inventory.py
@@ -18,3 +18,43 @@ def test_cannot_reserve_more_than_available():
     inv.receive("A", 2)
     with pytest.raises(ValueError):
         inv.reserve("A", 3)
+
+
+def test_release_returns_reserved_stock_to_available():
+    inv = Inventory()
+    inv.receive("A", 10)
+    inv.reserve("A", 4)
+    inv.receive("B", 3)
+    inv.reserve("B", 2)
+
+    inv.release("A", 2)
+    assert (inv.on_hand("A"), inv.reserved("A"), inv.available("A")) == (10, 2, 8)
+    assert (inv.on_hand("B"), inv.reserved("B"), inv.available("B")) == (3, 2, 1)
+
+    inv.release("A", 2)
+    assert (inv.on_hand("A"), inv.reserved("A"), inv.available("A")) == (10, 0, 10)
+
+
+@pytest.mark.parametrize("qty", [0, -1])
+def test_release_rejects_nonpositive_quantity_without_changes(qty):
+    inv = Inventory()
+    inv.receive("A", 10)
+    inv.reserve("A", 4)
+
+    with pytest.raises(ValueError):
+        inv.release("A", qty)
+    assert (inv.on_hand("A"), inv.reserved("A"), inv.available("A")) == (10, 4, 6)
+
+
+@pytest.mark.parametrize("sku, qty", [("A", 5), ("B", 1), ("unknown", 1)])
+def test_release_rejects_more_than_reserved_without_changes(sku, qty):
+    inv = Inventory()
+    inv.receive("A", 10)
+    inv.reserve("A", 4)
+    inv.receive("B", 3)
+
+    with pytest.raises(ValueError):
+        inv.release(sku, qty)
+    assert (inv.on_hand("A"), inv.reserved("A"), inv.available("A")) == (10, 4, 6)
+    assert (inv.on_hand("B"), inv.reserved("B"), inv.available("B")) == (3, 0, 3)
+    assert (inv.on_hand("unknown"), inv.reserved("unknown"), inv.available("unknown")) == (0, 0, 0)
