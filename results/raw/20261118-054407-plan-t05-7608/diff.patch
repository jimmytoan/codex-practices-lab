+
+
+def test_csv_quotes_fields_with_csv_special_characters():
+    rows = [
+        {"sku": "A,1", "name": 'Mug "large"', "units": 1, "revenue_cents": 100},
+        {"sku": "B", "name": "Line\nbreak", "units": 2, "revenue_cents": 200},
+    ]
+
+    assert to_csv(rows) == (
+        'sku,name,units,revenue_cents\n'
+        '"A,1","Mug ""large""",1,100\n'
+        'B,"Line\nbreak",2,200\n'
+    )
