diff --git a/src/shoplib/orders.py b/src/shoplib/orders.py
index 8edb164..a358b08 100644
--- a/src/shoplib/orders.py
+++ b/src/shoplib/orders.py
@@ -1,5 +1,6 @@
 """Orders and their life cycle. See docs/order-states.md."""
 
+from .errors import ShopError
 from .inventory import Inventory
 
 NEW = "NEW"
@@ -13,7 +14,7 @@ class Order:
     def __init__(self, order_id: str, lines: dict[str, int], inventory: Inventory):
         """Create an order for `lines` (sku -> qty) and reserve its stock."""
         if not lines:
-            raise ValueError("an order needs at least one line")
+            raise ShopError("an order needs at least one line")
         self.order_id = order_id
         self.lines = dict(lines)
         self.inventory = inventory
@@ -31,7 +32,7 @@ class Order:
 
     def _transition(self, allowed_from: tuple[str, ...], to: str) -> None:
         if self.state not in allowed_from:
-            raise ValueError(f"cannot go from {self.state} to {to}")
+            raise ShopError(f"cannot go from {self.state} to {to}")
         self.state = to
 
     def pay(self) -> None:
@@ -39,10 +40,28 @@ class Order:
 
     def ship(self) -> None:
         if self.state != PAID:
-            raise ValueError(f"cannot go from {self.state} to {SHIPPED}")
+            raise ShopError(f"cannot go from {self.state} to {SHIPPED}")
         for sku, qty in self.lines.items():
             self.inventory.ship(sku, qty)
         self.state = SHIPPED
 
     def deliver(self) -> None:
         self._transition((SHIPPED,), DELIVERED)
+
+    def cancel(self) -> None:
+        """Cancel an unshipped order and release its reserved stock."""
+        if self.state == CANCELLED:
+            return
+        if self.state not in (NEW, PAID):
+            raise ShopError(f"cannot cancel an order in {self.state} state")
+
+        # Validate every reservation first so an inconsistent inventory cannot
+        # cause a partial release for a multi-line order.
+        for sku, qty in self.lines.items():
+            if self.inventory.reserved(sku) < qty:
+                raise ShopError(f"only {self.inventory.reserved(sku)} of {sku} reserved")
+        for sku, qty in self.lines.items():
+            self.inventory.release(sku, qty)
+
+        self.refund_due = self.state == PAID
+        self.state = CANCELLED
diff --git a/tests/test_inventory.py b/tests/test_inventory.py
index 37436c0..a674742 100644
--- a/tests/test_inventory.py
+++ b/tests/test_inventory.py
@@ -18,3 +18,22 @@ def test_cannot_reserve_more_than_available():
     inv.receive("A", 2)
     with pytest.raises(ValueError):
         inv.reserve("A", 3)
+
+
+def test_release_reserved_stock():
+    inv = Inventory()
+    inv.receive("A", 10)
+    inv.reserve("A", 4)
+    inv.release("A", 3)
+    assert inv.reserved("A") == 1
+    assert inv.available("A") == 9
+
+
+def test_release_rejects_invalid_amount_without_changing_stock():
+    inv = Inventory()
+    inv.receive("A", 10)
+    inv.reserve("A", 4)
+    with pytest.raises(ValueError):
+        inv.release("A", 5)
+    assert inv.reserved("A") == 4
+    assert inv.available("A") == 6
diff --git a/tests/test_orders.py b/tests/test_orders.py
index d3835d1..f69dee5 100644
--- a/tests/test_orders.py
+++ b/tests/test_orders.py
@@ -1,7 +1,7 @@
 import pytest
 
 from shoplib.inventory import Inventory
-from shoplib.orders import DELIVERED, NEW, Order
+from shoplib.orders import CANCELLED, DELIVERED, NEW, Order
 
 
 def make():
@@ -25,3 +25,47 @@ def test_cannot_ship_unpaid():
     _, order = make()
     with pytest.raises(ValueError):
         order.ship()
+
+
+def test_cancel_new_order_releases_reserved_stock():
+    inv, order = make()
+    order.cancel()
+    assert order.state == CANCELLED
+    assert order.refund_due is False
+    assert inv.reserved("A") == 0
+    assert inv.available("A") == 5
+
+
+def test_cancel_paid_order_sets_refund_due():
+    inv, order = make()
+    order.pay()
+    order.cancel()
+    assert order.state == CANCELLED
+    assert order.refund_due is True
+    assert inv.reserved("A") == 0
+    assert inv.available("A") == 5
+
+
+def test_cancelled_order_can_be_cancelled_again_without_releasing_twice():
+    inv, order = make()
+    order.cancel()
+    order.cancel()
+    assert order.state == CANCELLED
+    assert inv.reserved("A") == 0
+    assert inv.available("A") == 5
+
+
+@pytest.mark.parametrize("finish", [lambda order: order.ship(), lambda order: (order.ship(), order.deliver())])
+def test_cannot_cancel_shipped_or_delivered_order(finish):
+    inv, order = make()
+    order.pay()
+    finish(order)
+    state = order.state
+    reserved = inv.reserved("A")
+    available = inv.available("A")
+    with pytest.raises(ValueError):
+        order.cancel()
+    assert order.state == state
+    assert order.refund_due is False
+    assert inv.reserved("A") == reserved
+    assert inv.available("A") == available
