+
+
+def test_apply_coupons_uses_best_eligible_percent_and_all_fixed_coupons():
+    coupons = [
+        Coupon("TEN", "percent", 10),
+        Coupon("FIFTEEN", "percent", 15),
+        Coupon("FIVE", "fixed", 500),
+        Coupon("TWO", "fixed", 200),
+    ]
+
+    assert apply_coupons(5000, coupons, date(2026, 1, 1)) == (3550, ["FIFTEEN", "FIVE", "TWO"])
+
+
+def test_apply_coupons_breaks_percent_ties_by_code():
+    coupons = [Coupon("ZED", "percent", 20), Coupon("ALPHA", "percent", 20)]
+
+    assert apply_coupons(1000, coupons, date(2026, 1, 1)) == (800, ["ALPHA"])
+
+
+def test_apply_coupons_checks_expiry_and_minimum_against_original_subtotal():
+    coupons = [
+        Coupon("EXPIRED", "fixed", 100, expires=date(2025, 12, 31)),
+        Coupon("VALID_TODAY", "fixed", 100, expires=date(2026, 1, 1)),
+        Coupon("MINIMUM", "fixed", 100, min_subtotal_cents=1001),
+    ]
+
+    assert apply_coupons(1000, coupons, date(2026, 1, 1)) == (900, ["VALID_TODAY"])
+
+
+def test_apply_coupons_never_returns_a_negative_total():
+    coupons = [Coupon("BIG", "fixed", 500), Coupon("ALSO_BIG", "fixed", 600)]
+
+    assert apply_coupons(1000, coupons, date(2026, 1, 1)) == (0, ["ALSO_BIG", "BIG"])
+
+
+def test_apply_coupons_rejects_negative_subtotal():
+    with pytest.raises(ShopError):
+        apply_coupons(-1, [], date(2026, 1, 1))
