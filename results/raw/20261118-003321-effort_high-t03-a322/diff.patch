diff --git a/tests/test_inventory.py b/tests/test_inventory.py
index 37436c0..5b85374 100644
--- a/tests/test_inventory.py
+++ b/tests/test_inventory.py
@@ -1,5 +1,6 @@
 import pytest
 
+from shoplib.errors import ShopError
 from shoplib.inventory import Inventory
 
 
@@ -18,3 +19,42 @@ def test_cannot_reserve_more_than_available():
     inv.receive("A", 2)
     with pytest.raises(ValueError):
         inv.reserve("A", 3)
+
+
+def test_release_partial_and_all_reserved_stock():
+    inv = Inventory()
+    inv.receive("A", 10)
+    inv.reserve("A", 4)
+    inv.receive("B", 5)
+    inv.reserve("B", 2)
+
+    assert inv.release("A", 1) is None
+    assert (inv.on_hand("A"), inv.reserved("A"), inv.available("A")) == (10, 3, 7)
+
+    assert inv.release("A", 3) is None
+    assert (inv.on_hand("A"), inv.reserved("A"), inv.available("A")) == (10, 0, 10)
+    assert (inv.on_hand("B"), inv.reserved("B"), inv.available("B")) == (5, 2, 3)
+
+
+@pytest.mark.parametrize(
+    ("sku", "qty"),
+    [("A", 0), ("A", -1), ("A", 5), ("B", 1), ("missing", 1)],
+)
+def test_invalid_release_leaves_inventory_unchanged(sku, qty):
+    inv = Inventory()
+    inv.receive("A", 10)
+    inv.reserve("A", 4)
+    inv.receive("B", 5)
+    before = {
+        item: (inv.on_hand(item), inv.reserved(item), inv.available(item))
+        for item in ("A", "B", "missing")
+    }
+
+    with pytest.raises(ShopError):
+        inv.release(sku, qty)
+
+    after = {
+        item: (inv.on_hand(item), inv.reserved(item), inv.available(item))
+        for item in ("A", "B", "missing")
+    }
+    assert after == before
