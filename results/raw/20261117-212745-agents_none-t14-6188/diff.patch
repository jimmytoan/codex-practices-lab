diff --git a/src/shoplib/storedays.py b/src/shoplib/storedays.py
index c46116f..fb09f6a 100644
--- a/src/shoplib/storedays.py
+++ b/src/shoplib/storedays.py
@@ -1,6 +1,32 @@
 """Revenue per store day. See docs/store-days.md."""
 
+from datetime import datetime, timedelta, timezone
+
 
 def daily_revenue(sales: list[dict], utc_offset_hours: int = 8, day_starts_hour: int = 4) -> list[tuple[str, int]]:
     """Revenue per store day. See docs/store-days.md."""
-    raise NotImplementedError
+    shop_timezone = timezone(timedelta(hours=utc_offset_hours))
+    totals = {}
+
+    for sale in sales:
+        timestamp = datetime.fromisoformat(sale["at"])
+        if timestamp.utcoffset() is None:
+            raise ValueError("Sale timestamp must include a time zone")
+
+        local_time = timestamp.astimezone(shop_timezone)
+        store_day = local_time.date()
+        if local_time.hour < day_starts_hour:
+            store_day -= timedelta(days=1)
+        totals[store_day] = totals.get(store_day, 0) + sale["cents"]
+
+    if not totals:
+        return []
+
+    day = min(totals)
+    last_day = max(totals)
+    result = []
+    while True:
+        result.append((day.isoformat(), totals.get(day, 0)))
+        if day == last_day:
+            return result
+        day += timedelta(days=1)
diff --git a/tests/test_storedays.py b/tests/test_storedays.py
new file mode 100644
index 0000000..0df5f3b
--- /dev/null
+++ b/tests/test_storedays.py
@@ -0,0 +1,63 @@
+import pytest
+
+from shoplib.storedays import daily_revenue
+
+
+def test_empty_sales():
+    assert daily_revenue([]) == []
+
+
+def test_boundary_refunds_and_gaps_in_date_order():
+    sales = [
+        {"at": "2026-11-20T04:00:00+08:00", "cents": 250},
+        {"at": "2026-11-18T03:59:59.999999+08:00", "cents": 100},
+        {"at": "2026-11-18T04:00:00+08:00", "cents": 40},
+        {"at": "2026-11-18T02:30:00+08:00", "cents": -30},
+    ]
+    assert daily_revenue(sales) == [
+        ("2026-11-17", 70),
+        ("2026-11-18", 40),
+        ("2026-11-19", 0),
+        ("2026-11-20", 250),
+    ]
+
+
+def test_timestamp_offsets_represent_the_same_instant():
+    sales = [
+        {"at": "2026-11-17T20:00:00Z", "cents": 1},
+        {"at": "2026-11-18T01:30:00+05:30", "cents": 2},
+        {"at": "2026-11-17T15:00:00-05:00", "cents": 3},
+    ]
+    assert daily_revenue(sales) == [("2026-11-18", 6)]
+
+
+def test_custom_shop_offset_and_start_across_leap_day():
+    sales = [
+        {"at": "2024-03-01T09:00:00Z", "cents": 10},
+        {"at": "2024-02-28T10:00:00Z", "cents": 20},
+    ]
+    assert daily_revenue(sales, utc_offset_hours=-5, day_starts_hour=5) == [
+        ("2024-02-28", 20),
+        ("2024-02-29", 10),
+    ]
+
+
+def test_gap_across_year_end_and_midnight_start():
+    sales = [
+        {"at": "2026-12-31T00:00:00Z", "cents": 10},
+        {"at": "2027-01-02T00:00:00Z", "cents": 20},
+    ]
+    assert daily_revenue(sales, utc_offset_hours=0, day_starts_hour=0) == [
+        ("2026-12-31", 10),
+        ("2027-01-01", 0),
+        ("2027-01-02", 20),
+    ]
+
+
+def test_timestamp_without_zone_raises_value_error():
+    sales = [
+        {"at": "2026-11-18T04:00:00Z", "cents": 10},
+        {"at": "2026-11-18T04:00:00", "cents": 20},
+    ]
+    with pytest.raises(ValueError):
+        daily_revenue(sales)
