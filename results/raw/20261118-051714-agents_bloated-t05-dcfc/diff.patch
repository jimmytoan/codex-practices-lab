+def test_csv_quotes_fields_that_need_escaping():
+    rows = [{
+        "sku": "A,1",
+        "name": 'Mug "Deluxe"',
+        "units": 3,
+        "revenue_cents": "1350\nrefund",
+    }]
+
+    assert to_csv(rows) == (
+        'sku,name,units,revenue_cents\n'
+        '"A,1","Mug ""Deluxe""",3,"1350\nrefund"\n'
+    )
