 def test_percent():
@@ -7,3 +12,58 @@ def test_percent():
 
 def test_fixed_never_negative():
     assert apply_coupon(300, Coupon("FIVE", "fixed", 500)) == 0
+
+
+def test_apply_coupons_chooses_highest_percent_and_stacks_fixed_coupons():
+    coupons = [
+        Coupon("SAVE10", "percent", 10),
+        Coupon("SAVE20B", "percent", 20),
+        Coupon("SAVE20A", "percent", 20),
+        Coupon("FIXED1", "fixed", 125),
+        Coupon("FIXED2", "fixed", 75),
+    ]
+
+    assert apply_coupons(1000, coupons, date(2025, 1, 1)) == (
+        600,
+        ["FIXED1", "FIXED2", "SAVE20A"],
+    )
+
+
+def test_apply_coupons_uses_original_subtotal_and_includes_expiry_date():
+    coupons = [
+        Coupon("PERCENT", "percent", 50),
+        Coupon("MINIMUM", "fixed", 100, min_subtotal_cents=1000),
+        Coupon("EXPIRES_TODAY", "fixed", 50, expires=date(2025, 1, 1)),
+        Coupon("EXPIRED", "fixed", 500, expires=date(2024, 12, 31)),
+        Coupon("TOO_HIGH_MINIMUM", "fixed", 500, min_subtotal_cents=1001),
+    ]
+
+    assert apply_coupons(1000, coupons, date(2025, 1, 1)) == (
+        350,
+        ["EXPIRES_TODAY", "MINIMUM", "PERCENT"],
+    )
+
+
+def test_apply_coupons_rounds_percent_half_up_and_clamps_at_zero():
+    assert apply_coupons(1, [Coupon("HALF_CENT", "percent", 50)], date.today()) == (
+        0,
+        ["HALF_CENT"],
+    )
+    assert apply_coupons(100, [Coupon("BIG", "fixed", 200)], date.today()) == (
+        0,
+        ["BIG"],
+    )
+
+
+def test_apply_coupons_with_no_eligible_coupons_returns_original_total():
+    coupons = [
+        Coupon("EXPIRED", "fixed", 100, expires=date(2024, 12, 31)),
+        Coupon("MINIMUM", "fixed", 100, min_subtotal_cents=1001),
+    ]
+
+    assert apply_coupons(1000, coupons, date(2025, 1, 1)) == (1000, [])
+
+
+def test_apply_coupons_rejects_negative_subtotal():
+    with pytest.raises(ShopError):
+        apply_coupons(-1, [], date.today())
