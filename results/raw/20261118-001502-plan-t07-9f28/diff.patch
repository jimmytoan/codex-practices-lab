-from shoplib.discounts import Coupon, apply_coupon
+from datetime import date
+
+import pytest
+
+from shoplib.discounts import Coupon, apply_coupon, apply_coupons
+from shoplib.errors import ShopError
 
 
 def test_percent():
@@ -7,3 +12,51 @@ def test_percent():
 
 def test_fixed_never_negative():
     assert apply_coupon(300, Coupon("FIVE", "fixed", 500)) == 0
+
+
+def test_apply_coupons_selects_best_percent_and_applies_all_fixed():
+    coupons = [
+        Coupon("Z20", "percent", 20),
+        Coupon("TEN", "percent", 10),
+        Coupon("B_FIXED", "fixed", 100),
+        Coupon("A20", "percent", 20),
+        Coupon("A_FIXED", "fixed", 200),
+    ]
+    assert apply_coupons(1000, coupons, date(2026, 1, 1)) == (
+        500, ["A20", "A_FIXED", "B_FIXED"]
+    )
+
+
+def test_apply_coupons_eligibility_uses_original_subtotal_and_inclusive_expiry():
+    today = date(2026, 1, 2)
+    coupons = [
+        Coupon("PERCENT", "percent", 50, expires=today),
+        Coupon("MINIMUM", "fixed", 100, min_subtotal_cents=1000),
+        Coupon("EXPIRED", "fixed", 200, expires=date(2026, 1, 1)),
+        Coupon("TOO_HIGH", "fixed", 200, min_subtotal_cents=1001),
+        Coupon("FUTURE", "fixed", 50, expires=date(2026, 1, 3)),
+    ]
+    assert apply_coupons(1000, coupons, today) == (350, ["FUTURE", "MINIMUM", "PERCENT"])
+
+
+def test_apply_coupons_rounds_percent_half_up_before_fixed_discounts():
+    coupons = [Coupon("HALF", "percent", 50), Coupon("FIXED", "fixed", 1)]
+    assert apply_coupons(5, coupons, date(2026, 1, 1)) == (1, ["FIXED", "HALF"])
+
+
+def test_apply_coupons_floors_total_but_reports_all_applied_codes():
+    coupons = [Coupon("P", "percent", 100), Coupon("B", "fixed", 1), Coupon("A", "fixed", 2)]
+    assert apply_coupons(100, coupons, date(2026, 1, 1)) == (0, ["A", "B", "P"])
+
+
+def test_apply_coupons_empty_and_ineligible():
+    today = date(2026, 1, 1)
+    assert apply_coupons(0, [], today) == (0, [])
+    assert apply_coupons(100, [Coupon("NO", "percent", 10, min_subtotal_cents=101)], today) == (100, [])
+
+
+def test_apply_coupons_rejects_invalid_arguments():
+    with pytest.raises(ShopError):
+        apply_coupons(-1, [], date(2026, 1, 1))
+    with pytest.raises(ShopError):
+        apply_coupons(100, [Coupon("BAD", "unknown", 10)], date(2026, 1, 1))
