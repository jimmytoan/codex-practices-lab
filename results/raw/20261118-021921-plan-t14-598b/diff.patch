+++ b/tests/test_storedays.py
@@ -0,0 +1,63 @@
+import pytest
+
+from shoplib.errors import ShopError
+from shoplib.storedays import daily_revenue
+
+
+def test_default_boundary_and_refunds():
+    sales = [
+        {"at": "2026-11-17T20:00:00Z", "cents": 500},
+        {"at": "2026-11-17T19:59:59Z", "cents": 300},
+        {"at": "2026-11-18T02:30:00+08:00", "cents": -100},
+        {"at": "2026-11-18T04:00:00+08:00", "cents": 50},
+    ]
+    assert daily_revenue(sales) == [("2026-11-17", 200), ("2026-11-18", 550)]
+
+
+def test_zones_custom_boundary_and_gap_across_year():
+    sales = [
+        {"at": "2027-01-02T09:00:00+02:00", "cents": 400},
+        {"at": "2026-12-31T02:00:00-05:00", "cents": 200},
+        {"at": "2026-12-31T06:59:59Z", "cents": 100},
+        {"at": "2026-12-31T07:00:00Z", "cents": -50},
+    ]
+    assert daily_revenue(sales, utc_offset_hours=-5, day_starts_hour=2) == [
+        ("2026-12-30", 100),
+        ("2026-12-31", 150),
+        ("2027-01-01", 0),
+        ("2027-01-02", 400),
+    ]
+
+
+def test_midnight_boundary_and_leap_day_gap():
+    sales = [
+        {"at": "2024-03-01T00:00:00Z", "cents": 3},
+        {"at": "2024-02-28T23:59:59Z", "cents": 2},
+    ]
+    assert daily_revenue(sales, utc_offset_hours=0, day_starts_hour=0) == [
+        ("2024-02-28", 2), ("2024-02-29", 0), ("2024-03-01", 3)
+    ]
+
+
+def test_empty_sales():
+    assert daily_revenue([]) == []
+
+
+@pytest.mark.parametrize("timestamp", ["2026-11-18T02:30:00", "bad timestamp"])
+def test_invalid_or_unzoned_timestamp_raises_shop_error(timestamp):
+    with pytest.raises(ShopError):
+        daily_revenue([{"at": timestamp, "cents": 100}])
+
+
+@pytest.mark.parametrize("sales, offset, start", [
+    (None, 8, 4),
+    ([{}], 8, 4),
+    ([{"at": "2026-11-18T00:00:00Z", "cents": 1.5}], 8, 4),
+    ([], 24, 4),
+    ([], -24, 4),
+    ([], 8, -1),
+    ([], 8, 24),
+])
+def test_invalid_arguments_raise_shop_error(sales, offset, start):
+    with pytest.raises(ShopError):
+        daily_revenue(sales, utc_offset_hours=offset, day_starts_hour=start)
