+++ b/tests/test_invoice.py
@@ -0,0 +1,70 @@
+import pytest
+
+from shoplib.errors import ShopError
+from shoplib.invoice import build_invoice
+
+
+def test_coupon_allocation_and_taxes():
+    invoice = build_invoice(
+        [("a", 101, 1, "standard"), ("b", 25, 2, "food"),
+         ("c", 50, 1, "books")], 5, 100, "DE"
+    )
+    assert invoice == {
+        "lines": [
+            {"sku": "a", "gross_cents": 101, "discount_cents": 3,
+             "net_cents": 98, "tax_cents": 19},
+            {"sku": "b", "gross_cents": 50, "discount_cents": 1,
+             "net_cents": 49, "tax_cents": 3},
+            {"sku": "c", "gross_cents": 50, "discount_cents": 1,
+             "net_cents": 49, "tax_cents": 3},
+        ],
+        "shipping_cents": 100,
+        "shipping_tax_cents": 19,
+        "total_cents": 340,
+    }
+
+
+def test_equal_remainders_go_to_earlier_lines():
+    invoice = build_invoice([(str(i), 100, 1, "books") for i in range(3)], 2, 0, "SG")
+    assert [line["discount_cents"] for line in invoice["lines"]] == [1, 1, 0]
+
+
+def test_coupon_is_capped_and_taxable_category_still_taxes_shipping():
+    invoice = build_invoice([("a", 3, 2, "standard"), ("b", 4, 1, "books")], 99, 100, "SG")
+    assert [line["discount_cents"] for line in invoice["lines"]] == [6, 4]
+    assert invoice["shipping_tax_cents"] == 9
+    assert invoice["total_cents"] == 109
+
+
+def test_zero_gross_and_untaxed_shipping():
+    invoice = build_invoice([("a", 0, 1, "books"), ("b", 0, 2, "books")], 10, 100, "SG")
+    assert [line["discount_cents"] for line in invoice["lines"]] == [0, 0]
+    assert invoice["shipping_tax_cents"] == 0
+    assert invoice["total_cents"] == 100
+
+
+def test_tax_is_rounded_per_line():
+    invoice = build_invoice([("a", 6, 1, "standard"), ("b", 6, 1, "standard")], 0, 0, "SG")
+    assert [line["tax_cents"] for line in invoice["lines"]] == [1, 1]
+    assert invoice["total_cents"] == 14
+
+
+@pytest.mark.parametrize(
+    "lines,coupon,shipping,region",
+    [
+        ([("a", 1, 1, "standard")], 0, 0, "unknown"),
+        ([], 0, 0, "DE"),
+        ([("a", 1, 1, "unknown")], 0, 0, "DE"),
+        ([("a", 1, 0, "standard")], 0, 0, "DE"),
+        ([("a", -1, 1, "standard")], 0, 0, "DE"),
+        ([("a", 1, 1, "standard")], -1, 0, "DE"),
+        ([("a", 1, 1, "standard")], 0, -1, "DE"),
+        ([("a", 1.5, 1, "standard")], 0, 0, "DE"),
+        ([("a", 1, 1.5, "standard")], 0, 0, "DE"),
+        ([("a", 1, 1, "standard")], 0.5, 0, "DE"),
+        ([("a", 1, 1, "standard")], 0, 0.5, "DE"),
+    ],
+)
+def test_invalid_arguments_raise_shop_error(lines, coupon, shipping, region):
+    with pytest.raises(ShopError):
+        build_invoice(lines, coupon, shipping, region)
