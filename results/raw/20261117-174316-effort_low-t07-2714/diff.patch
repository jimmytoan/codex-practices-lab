 def test_percent():
@@ -7,3 +12,38 @@ def test_percent():
 
 def test_fixed_never_negative():
     assert apply_coupon(300, Coupon("FIVE", "fixed", 500)) == 0
+
+
+def test_combines_eligible_coupons_using_original_subtotal():
+    today = date(2026, 1, 10)
+    coupons = [
+        Coupon("Z", "percent", 10),
+        Coupon("B", "percent", 20),
+        Coupon("A", "percent", 20, expires=today),
+        Coupon("FIX", "fixed", 100, min_subtotal_cents=1000),
+        Coupon("EXPIRED", "fixed", 100, expires=today - timedelta(days=1)),
+        Coupon("MINIMUM", "fixed", 100, min_subtotal_cents=1001),
+    ]
+    assert apply_coupons(1000, coupons, today) == (700, ["A", "FIX"])
+
+
+def test_rounds_percent_half_up_before_fixed_and_keeps_all_codes():
+    today = date(2026, 1, 10)
+    coupons = [Coupon("P", "percent", 50), Coupon("F", "fixed", 1)]
+    assert apply_coupons(5, coupons, today) == (1, ["F", "P"])
+    coupons.append(Coupon("BIG", "fixed", 100))
+    assert apply_coupons(5, coupons, today) == (0, ["BIG", "F", "P"])
+
+
+def test_empty_and_ineligible_coupons():
+    today = date(2026, 1, 10)
+    assert apply_coupons(0, [], today) == (0, [])
+    assert apply_coupons(100, [Coupon("NO", "percent", 10, min_subtotal_cents=101)], today) == (100, [])
+
+
+def test_invalid_subtotal_and_coupon_kind():
+    today = date(2026, 1, 10)
+    with pytest.raises(ShopError):
+        apply_coupons(-1, [], today)
+    with pytest.raises(ShopError):
+        apply_coupons(100, [Coupon("BAD", "unknown", 1)], today)
