@@ -0,0 +1,62 @@
+import pytest
+
+from shoplib.errors import ShopError
+from shoplib.invoice import build_invoice
+
+
+def test_coupon_allocation_and_tax_per_line():
+    invoice = build_invoice([
+        ("a", 101, 2, "standard"),
+        ("b", 101, 1, "food"),
+        ("c", 101, 1, "books"),
+    ], 3, 50, "DE")
+    assert invoice == {
+        "lines": [
+            {"sku": "a", "gross_cents": 202, "discount_cents": 1, "net_cents": 201, "tax_cents": 38},
+            {"sku": "b", "gross_cents": 101, "discount_cents": 1, "net_cents": 100, "tax_cents": 7},
+            {"sku": "c", "gross_cents": 101, "discount_cents": 1, "net_cents": 100, "tax_cents": 7},
+        ],
+        "shipping_cents": 50,
+        "shipping_tax_cents": 10,
+        "total_cents": 513,
+    }
+
+
+def test_largest_remainder_and_ties_follow_input_order():
+    invoice = build_invoice([(str(i), price, 1, "books") for i, price in enumerate([1, 2, 2])], 2, 0, "SG")
+    assert [line["discount_cents"] for line in invoice["lines"]] == [0, 1, 1]
+    invoice = build_invoice([(str(i), 1, 1, "books") for i in range(3)], 2, 0, "SG")
+    assert [line["discount_cents"] for line in invoice["lines"]] == [1, 1, 0]
+
+
+def test_coupon_cap_and_zero_gross():
+    invoice = build_invoice([("a", 2, 2, "food"), ("b", 1, 1, "food")], 99, 0, "DE")
+    assert [line["discount_cents"] for line in invoice["lines"]] == [4, 1]
+    assert invoice["total_cents"] == 0
+    invoice = build_invoice([("a", 0, 1, "food"), ("b", 0, 2, "books")], 99, 10, "DE")
+    assert [line["discount_cents"] for line in invoice["lines"]] == [0, 0]
+    assert invoice["shipping_tax_cents"] == 2
+
+
+def test_tax_rounds_per_line_and_shipping_depends_on_category_rate():
+    invoice = build_invoice([("a", 50, 1, "food"), ("b", 50, 1, "food")], 0, 50, "SG")
+    assert [line["tax_cents"] for line in invoice["lines"]] == [5, 5]
+    assert invoice["shipping_tax_cents"] == 5
+    assert invoice["total_cents"] == 165
+    assert build_invoice([("a", 100, 1, "books")], 0, 100, "SG")["shipping_tax_cents"] == 0
+    assert build_invoice([("a", 100, 1, "standard")], 0, 100, "OR")["shipping_tax_cents"] == 0
+
+
+@pytest.mark.parametrize("lines,coupon,shipping,region", [
+    ([("a", 1, 1, "food")], 0, 0, "unknown"),
+    ([("a", 1, 1, "unknown")], 0, 0, "DE"),
+    ([], 0, 0, "DE"),
+    ([("a", 1, 0, "food")], 0, 0, "DE"),
+    ([("a", 1, -1, "food")], 0, 0, "DE"),
+    ([("a", -1, 1, "food")], 0, 0, "DE"),
+    ([("a", 1, 1, "food")], -1, 0, "DE"),
+    ([("a", 1, 1, "food")], 0, -1, "DE"),
+])
+def test_invalid_arguments(lines, coupon, shipping, region):
+    with pytest.raises(ShopError):
+        build_invoice(lines, coupon, shipping, region)
