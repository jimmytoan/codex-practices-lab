 """Text helpers for URLs and listings."""
 
 import re
+import unicodedata
+
+from shoplib.errors import ShopError
 
 
 def slugify(text: str, max_len: int = 40) -> str:
@@ -13,8 +16,23 @@ def slugify(text: str, max_len: int = 40) -> str:
     - At most `max_len` characters, cut after the other steps; a cut never
       leaves a trailing '-'.
     - If nothing is left, the slug is 'n-a'.
+    - `max_len` must be at least 3 so the fallback slug fits.
     """
-    slug = re.sub(r"[^a-z0-9]+", "-", text.lower()).strip("-")
+    if not isinstance(max_len, int) or isinstance(max_len, bool) or max_len < 3:
+        raise ShopError("max_len must be at least 3")
+
+    normalized = unicodedata.normalize("NFD", text.lower())
+    unaccented_chars = []
+    previous_base_is_latin = False
+    for char in normalized:
+        if unicodedata.category(char).startswith("M"):
+            if not previous_base_is_latin:
+                unaccented_chars.append(char)
+        else:
+            unaccented_chars.append(char)
+            previous_base_is_latin = char.isascii() and char.isalpha()
+    unaccented = "".join(unaccented_chars)
+    slug = re.sub(r"[^a-z0-9]+", "-", unaccented).strip("-")
     slug = slug[:max_len].rstrip("-")
     return slug or "n-a"
 
diff --git a/tests/test_textutil.py b/tests/test_textutil.py
index 4c83bb9..f81eab7 100644
--- a/tests/test_textutil.py
+++ b/tests/test_textutil.py
@@ -1,3 +1,6 @@
+import pytest
+
+from shoplib.errors import ShopError
 from shoplib.textutil import slugify, truncate
 
 
@@ -6,6 +9,21 @@ def test_slugify_basic():
     assert slugify("!!!") == "n-a"
 
 
+def test_slugify_unaccents_latin_letters():
+    assert slugify("Crème Brûlée") == "creme-brulee"
+    assert slugify("Cafe\u0301 Noe\u0308l") == "cafe-noel"
+
+
+def test_slugify_max_len_is_applied_after_slug_creation():
+    assert slugify("Hello---World", max_len=7) == "hello-w"
+    assert slugify("Hello-World", max_len=6) == "hello"
+
+
+def test_slugify_requires_room_for_fallback_slug():
+    with pytest.raises(ShopError):
+        slugify("anything", max_len=2)
+
+
 def test_truncate():
     assert truncate("hello world", 8) == "hello..."
     assert truncate("short", 8) == "short"
