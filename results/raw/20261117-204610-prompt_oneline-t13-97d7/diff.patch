@@ -0,0 +1,63 @@
+import copy
+
+import pytest
+
+from shoplib.costing import fifo_costing
+from shoplib.errors import ShopError
+
+
+def test_fifo_sale_and_return_lot_is_appended_after_existing_stock():
+    events = [
+        {"type": "receive", "sku": "A", "qty": 2, "unit_cost_cents": 101},
+        {"type": "receive", "sku": "A", "qty": 2, "unit_cost_cents": 200},
+        {"type": "sell", "sku": "A", "qty": 3},
+        {"type": "return", "sku": "A", "qty": 2},
+        {"type": "sell", "sku": "A", "qty": 2},
+    ]
+    original_events = copy.deepcopy(events)
+
+    assert fifo_costing(events) == {
+        "A": {"cogs_cents": 468, "on_hand": 1, "value_cents": 134}
+    }
+    assert events == original_events
+
+
+def test_return_average_unit_cost_rounds_half_up():
+    events = [
+        {"type": "receive", "sku": "A", "qty": 1, "unit_cost_cents": 0},
+        {"type": "receive", "sku": "A", "qty": 1, "unit_cost_cents": 1},
+        {"type": "sell", "sku": "A", "qty": 2},
+        {"type": "return", "sku": "A", "qty": 1},
+    ]
+
+    assert fifo_costing(events)["A"] == {
+        "cogs_cents": 0,
+        "on_hand": 1,
+        "value_cents": 1,
+    }
+
+
+@pytest.mark.parametrize(
+    "events",
+    [
+        [{"type": "receive", "sku": "A", "qty": 0, "unit_cost_cents": 10}],
+        [{"type": "receive", "sku": "A", "qty": 1, "unit_cost_cents": -1}],
+        [{"type": "sell", "sku": "A", "qty": 1}],
+        [{"type": "receive", "sku": "A", "qty": 1, "unit_cost_cents": 1}, {"type": "sell", "sku": "A", "qty": 2}],
+        [{"type": "return", "sku": "A", "qty": 1}],
+        [
+            {"type": "receive", "sku": "A", "qty": 1, "unit_cost_cents": 1},
+            {"type": "sell", "sku": "A", "qty": 1},
+            {"type": "return", "sku": "A", "qty": 2},
+        ],
+        [{"type": "adjust", "sku": "A", "qty": 1}],
+    ],
+)
+def test_invalid_events_raise_shop_error(events):
+    with pytest.raises(ShopError):
+        fifo_costing(events)
+
+
+def test_malformed_event_raises_shop_error():
+    with pytest.raises(ShopError):
+        fifo_costing([{"type": "receive", "sku": "A", "qty": 1}])
