 def test_percent():
@@ -7,3 +12,37 @@ def test_percent():
 
 def test_fixed_never_negative():
     assert apply_coupon(300, Coupon("FIVE", "fixed", 500)) == 0
+
+
+def test_apply_coupons_selects_best_eligible_percent_and_all_eligible_fixed():
+    today = date(2025, 1, 1)
+    coupons = [
+        Coupon("Z50", "percent", 50),
+        Coupon("B50", "percent", 50),
+        Coupon("A50", "percent", 50),
+        Coupon("BIGGER_BUT_INELIGIBLE", "percent", 90, min_subtotal_cents=1002),
+        Coupon("FIXED", "fixed", 200, min_subtotal_cents=1001),
+        Coupon("EXPIRED", "fixed", 300, expires=date(2024, 12, 31)),
+        Coupon("TOO_HIGH_MINIMUM", "fixed", 400, min_subtotal_cents=1002),
+    ]
+
+    # 50% of 1001 rounds half up to 501; the fixed coupon then takes 200.
+    assert apply_coupons(1001, coupons, today) == (300, ["A50", "FIXED"])
+
+
+def test_apply_coupons_expiry_date_is_inclusive():
+    today = date(2025, 1, 1)
+    coupon = Coupon("TODAY", "fixed", 250, expires=today)
+
+    assert apply_coupons(1000, [coupon], today) == (750, ["TODAY"])
+
+
+def test_apply_coupons_clamps_total_and_sorts_applied_codes():
+    coupons = [Coupon("Z", "fixed", 600), Coupon("A", "fixed", 500)]
+
+    assert apply_coupons(1000, coupons, date(2025, 1, 1)) == (0, ["A", "Z"])
+
+
+def test_apply_coupons_rejects_negative_subtotal():
+    with pytest.raises(ShopError):
+        apply_coupons(-1, [], date(2025, 1, 1))
