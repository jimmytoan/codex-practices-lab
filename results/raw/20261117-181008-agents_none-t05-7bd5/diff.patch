+
+
+def test_csv_quotes_fields_with_csv_special_characters():
+    rows = [
+        {"sku": "A", "name": "Cup, mug", "units": 1, "revenue_cents": 100},
+        {"sku": "B", "name": 'A "fancy" bowl', "units": 1, "revenue_cents": 200},
+        {"sku": "C", "name": "Line 1\nLine 2", "units": 1, "revenue_cents": 300},
+    ]
+
+    assert to_csv(rows) == (
+        "sku,name,units,revenue_cents\n"
+        'A,"Cup, mug",1,100\n'
+        'B,"A ""fancy"" bowl",1,200\n'
+        'C,"Line 1\nLine 2",1,300\n'
+    )
