diff --git a/tests/test_inventory.py b/tests/test_inventory.py
index 37436c0..7c77dc0 100644
--- a/tests/test_inventory.py
+++ b/tests/test_inventory.py
@@ -1,5 +1,6 @@
 import pytest
 
+from shoplib.errors import ShopError
 from shoplib.inventory import Inventory
 
 
@@ -18,3 +19,41 @@ def test_cannot_reserve_more_than_available():
     inv.receive("A", 2)
     with pytest.raises(ValueError):
         inv.reserve("A", 3)
+
+
+def test_release_returns_reserved_units_to_available():
+    inv = Inventory()
+    inv.receive("A", 10)
+    inv.reserve("A", 6)
+
+    inv.release("A", 4)
+
+    assert inv.on_hand("A") == 10
+    assert inv.reserved("A") == 2
+    assert inv.available("A") == 8
+
+
+@pytest.mark.parametrize("qty", [0, -1])
+def test_release_rejects_nonpositive_quantity_without_changes(qty):
+    inv = Inventory()
+    inv.receive("A", 10)
+    inv.reserve("A", 4)
+    before = (inv.on_hand("A"), inv.reserved("A"), inv.available("A"))
+
+    with pytest.raises(ShopError):
+        inv.release("A", qty)
+
+    assert (inv.on_hand("A"), inv.reserved("A"), inv.available("A")) == before
+
+
+@pytest.mark.parametrize("sku, qty", [("A", 3), ("missing", 1)])
+def test_release_rejects_more_than_reserved_without_changes(sku, qty):
+    inv = Inventory()
+    inv.receive("A", 10)
+    inv.reserve("A", 2)
+    before = (inv.on_hand("A"), inv.reserved("A"), inv.available("A"))
+
+    with pytest.raises(ShopError):
+        inv.release(sku, qty)
+
+    assert (inv.on_hand("A"), inv.reserved("A"), inv.available("A")) == before
