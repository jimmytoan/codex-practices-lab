diff --git a/src/shoplib/costing.py b/src/shoplib/costing.py
index 5e8c27e..763c034 100644
--- a/src/shoplib/costing.py
+++ b/src/shoplib/costing.py
@@ -1,6 +1,64 @@
 """Cost of goods sold with FIFO lots. See docs/costing.md."""
 
+from collections import deque
+from decimal import Decimal, localcontext
+
+from shoplib.errors import ShopError
+from shoplib.money import round_cents
+
 
 def fifo_costing(events: list[dict]) -> dict:
     """Process stock events and report cost per SKU. See docs/costing.md."""
-    raise NotImplementedError
+    stock = {}
+    for event in events:
+        kind = event["type"]
+        if kind not in ("receive", "sell", "return"):
+            raise ShopError("unknown event type")
+        qty = event["qty"]
+        if qty < 1:
+            raise ShopError("qty must be positive")
+        sku = event["sku"]
+        state = stock.setdefault(sku, {"lots": deque(), "on_hand": 0,
+                                       "cogs": 0, "sale": None})
+        if kind == "receive":
+            cost = event["unit_cost_cents"]
+            if cost < 0:
+                raise ShopError("unit cost must be nonnegative")
+            state["lots"].append((qty, cost))
+            state["on_hand"] += qty
+        elif kind == "sell":
+            if qty > state["on_hand"]:
+                raise ShopError("not enough stock")
+            remaining = qty
+            sale_cost = 0
+            while remaining:
+                lot_qty, cost = state["lots"].popleft()
+                taken = min(remaining, lot_qty)
+                sale_cost += taken * cost
+                remaining -= taken
+                if taken < lot_qty:
+                    state["lots"].appendleft((lot_qty - taken, cost))
+            state["on_hand"] -= qty
+            state["cogs"] += sale_cost
+            # Enough precision to distinguish either side of a half-cent,
+            # even for large quantities and costs.
+            with localcontext() as context:
+                context.prec = len(str(sale_cost)) + len(str(qty)) + 2
+                average = round_cents(Decimal(sale_cost) / Decimal(qty))
+            state["sale"] = (qty, average)
+        else:
+            if state["sale"] is None:
+                raise ShopError("no sale to return")
+            returnable, cost = state["sale"]
+            if qty > returnable:
+                raise ShopError("too many units returned")
+            state["sale"] = (returnable - qty, cost)
+            state["lots"].append((qty, cost))
+            state["on_hand"] += qty
+            state["cogs"] -= qty * cost
+
+    return {
+        sku: {"cogs_cents": state["cogs"], "on_hand": state["on_hand"],
+              "value_cents": sum(qty * cost for qty, cost in state["lots"])}
+        for sku, state in stock.items()
+    }
diff --git a/tests/test_costing.py b/tests/test_costing.py
new file mode 100644
index 0000000..1c8754b
--- /dev/null
+++ b/tests/test_costing.py
@@ -0,0 +1,88 @@
+from copy import deepcopy
+
+import pytest
+
+from shoplib.costing import fifo_costing
+from shoplib.errors import ShopError
+
+
+def test_fifo_and_independent_skus():
+    events = [
+        {"type": "receive", "sku": "A", "qty": 2, "unit_cost_cents": 100},
+        {"type": "receive", "sku": "B", "qty": 1, "unit_cost_cents": 0},
+        {"type": "receive", "sku": "A", "qty": 3, "unit_cost_cents": 200},
+        {"type": "sell", "sku": "A", "qty": 3},
+    ]
+    original = deepcopy(events)
+    assert fifo_costing(events) == {
+        "A": {"cogs_cents": 400, "on_hand": 2, "value_cents": 400},
+        "B": {"cogs_cents": 0, "on_hand": 1, "value_cents": 0},
+    }
+    assert events == original
+    assert fifo_costing([]) == {}
+
+
+def test_returns_use_rounded_sale_average_and_join_end_of_queue():
+    events = [
+        {"type": "receive", "sku": "A", "qty": 1, "unit_cost_cents": 100},
+        {"type": "receive", "sku": "A", "qty": 3, "unit_cost_cents": 101},
+        {"type": "sell", "sku": "A", "qty": 2},
+        {"type": "return", "sku": "A", "qty": 1},
+        {"type": "return", "sku": "A", "qty": 1},
+        {"type": "receive", "sku": "A", "qty": 1, "unit_cost_cents": 200},
+        {"type": "sell", "sku": "A", "qty": 3},
+    ]
+    assert fifo_costing(events) == {
+        "A": {"cogs_cents": 302, "on_hand": 2, "value_cents": 301}
+    }
+
+
+def test_returned_lots_are_after_existing_lots_with_different_costs():
+    events = [
+        {"type": "receive", "sku": "A", "qty": 1, "unit_cost_cents": 10},
+        {"type": "receive", "sku": "A", "qty": 2, "unit_cost_cents": 20},
+        {"type": "sell", "sku": "A", "qty": 1},
+        {"type": "return", "sku": "A", "qty": 1},
+        {"type": "sell", "sku": "A", "qty": 2},
+        {"type": "return", "sku": "A", "qty": 1},
+    ]
+    assert fifo_costing(events) == {
+        "A": {"cogs_cents": 20, "on_hand": 2, "value_cents": 30}
+    }
+
+
+@pytest.mark.parametrize("events", [
+    [{"type": kind, "sku": "A", "qty": qty, "unit_cost_cents": 1}]
+    for kind in ("receive", "sell", "return") for qty in (0, -1)
+] + [
+    [{"type": "receive", "sku": "A", "qty": 1, "unit_cost_cents": -1}],
+    [{"type": "sell", "sku": "A", "qty": 1}],
+    [{"type": "return", "sku": "A", "qty": 1}],
+    [{"type": "unknown", "sku": "A", "qty": 1}],
+    [{"type": "receive", "sku": "A", "qty": 2, "unit_cost_cents": 1},
+     {"type": "sell", "sku": "A", "qty": 2},
+     {"type": "return", "sku": "A", "qty": 1},
+     {"type": "return", "sku": "A", "qty": 2}],
+    [{"type": "receive", "sku": "A", "qty": 3, "unit_cost_cents": 1},
+     {"type": "sell", "sku": "A", "qty": 2},
+     {"type": "sell", "sku": "A", "qty": 1},
+     {"type": "return", "sku": "A", "qty": 2}],
+])
+def test_invalid_events_raise_shop_error_without_mutating_input(events):
+    original = deepcopy(events)
+    with pytest.raises(ShopError):
+        fifo_costing(events)
+    assert events == original
+
+
+def test_average_rounds_below_half_with_large_quantity():
+    qty = 10**30 + 1
+    events = [
+        {"type": "receive", "sku": "A", "qty": qty // 2 + 1, "unit_cost_cents": 0},
+        {"type": "receive", "sku": "A", "qty": qty // 2, "unit_cost_cents": 1},
+        {"type": "sell", "sku": "A", "qty": qty},
+        {"type": "return", "sku": "A", "qty": 1},
+    ]
+    assert fifo_costing(events)["A"] == {
+        "cogs_cents": qty // 2, "on_hand": 1, "value_cents": 0
+    }
