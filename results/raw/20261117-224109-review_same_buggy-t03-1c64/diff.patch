diff --git a/tests/test_inventory.py b/tests/test_inventory.py
index 37436c0..ac1b86d 100644
--- a/tests/test_inventory.py
+++ b/tests/test_inventory.py
@@ -1,6 +1,7 @@
 import pytest
 
 from shoplib.inventory import Inventory
+from shoplib.errors import ShopError
 
 
 def test_reserve_and_ship():
@@ -18,3 +19,41 @@ def test_cannot_reserve_more_than_available():
     inv.receive("A", 2)
     with pytest.raises(ValueError):
         inv.reserve("A", 3)
+
+
+def test_release_returns_reserved_stock_to_available():
+    inv = Inventory()
+    inv.receive("A", 10)
+    inv.reserve("A", 4)
+
+    inv.release("A", 2)
+    assert (inv.on_hand("A"), inv.reserved("A"), inv.available("A")) == (10, 2, 8)
+
+    inv.release("A", 2)
+    assert (inv.on_hand("A"), inv.reserved("A"), inv.available("A")) == (10, 0, 10)
+
+
+@pytest.mark.parametrize("qty", [0, -1, 5, 11])
+def test_invalid_release_leaves_stock_unchanged(qty):
+    inv = Inventory()
+    inv.receive("A", 10)
+    inv.reserve("A", 4)
+
+    with pytest.raises(ShopError):
+        inv.release("A", qty)
+
+    assert (inv.on_hand("A"), inv.reserved("A"), inv.available("A")) == (10, 4, 6)
+
+
+@pytest.mark.parametrize("qty", [0, 1])
+@pytest.mark.parametrize("receive_stock", [False, True])
+def test_release_without_reservation_raises_shop_error(qty, receive_stock):
+    inv = Inventory()
+    if receive_stock:
+        inv.receive("A", 10)
+
+    with pytest.raises(ShopError):
+        inv.release("A", qty)
+
+    on_hand = 10 if receive_stock else 0
+    assert (inv.on_hand("A"), inv.reserved("A"), inv.available("A")) == (on_hand, 0, on_hand)
