+++ b/tests/test_storedays.py
@@ -0,0 +1,78 @@
+import pytest
+
+from shoplib.errors import ShopError
+from shoplib.storedays import daily_revenue
+
+
+def test_empty_sales():
+    assert daily_revenue([]) == []
+
+
+def test_boundary_refunds_and_missing_days_in_date_order():
+    sales = [
+        {"at": "2026-11-20T04:00:00+08:00", "cents": 300},
+        {"at": "2026-11-18T03:59:59.999999+08:00", "cents": 1000},
+        {"at": "2026-11-18T04:00:00+08:00", "cents": 500},
+        {"at": "2026-11-18T02:30:00+08:00", "cents": -250},
+    ]
+    assert daily_revenue(sales) == [
+        ("2026-11-17", 750),
+        ("2026-11-18", 500),
+        ("2026-11-19", 0),
+        ("2026-11-20", 300),
+    ]
+
+
+def test_timestamp_zones_represent_the_same_instant():
+    sales = [
+        {"at": "2026-11-17T20:00:00Z", "cents": 100},
+        {"at": "2026-11-17T15:00:00-05:00", "cents": 200},
+        {"at": "2026-11-18T05:30:00+09:30", "cents": -50},
+    ]
+    assert daily_revenue(sales) == [("2026-11-18", 250)]
+
+
+def test_custom_offset_and_start_hour_across_year_boundary():
+    sales = [
+        {"at": "2027-01-01T02:59:59Z", "cents": 10},
+        {"at": "2027-01-01T03:00:00Z", "cents": 20},
+    ]
+    assert daily_revenue(sales, utc_offset_hours=-5, day_starts_hour=22) == [
+        ("2026-12-30", 10),
+        ("2026-12-31", 20),
+    ]
+
+
+def test_midnight_boundary_and_leap_day_gap():
+    sales = [
+        {"at": "2024-03-01T00:00:00Z", "cents": 5},
+        {"at": "2024-02-28T23:59:59Z", "cents": 3},
+    ]
+    assert daily_revenue(sales, utc_offset_hours=0, day_starts_hour=0) == [
+        ("2024-02-28", 3), ("2024-02-29", 0), ("2024-03-01", 5)
+    ]
+
+
+@pytest.mark.parametrize("timestamp", [
+    "2026-11-18T02:30:00",
+    "2026-11-18+08:00",
+    "not-a-timestamp",
+    "2026-11-18T02:30:00+08:60",
+])
+def test_invalid_or_unzoned_timestamp(timestamp):
+    with pytest.raises(ShopError):
+        daily_revenue([{"at": timestamp, "cents": 100}])
+
+
+@pytest.mark.parametrize("sales, offset, start", [
+    (None, 8, 4),
+    ([{}], 8, 4),
+    ([{"at": "2026-11-18T02:30:00Z", "cents": 1.5}], 8, 4),
+    ([], 24, 4),
+    ([], -24, 4),
+    ([], 8, 24),
+    ([], 8, -1),
+])
+def test_invalid_arguments(sales, offset, start):
+    with pytest.raises(ShopError):
+        daily_revenue(sales, offset, start)
