+from shoplib.discounts import Coupon, apply_coupon, apply_coupons
+from shoplib.errors import ShopError
 
 
 def test_percent():
@@ -7,3 +12,54 @@ def test_percent():
 
 def test_fixed_never_negative():
     assert apply_coupon(300, Coupon("FIVE", "fixed", 500)) == 0
+
+
+def test_expiration_is_inclusive():
+    today = date(2026, 1, 2)
+    coupons = [
+        Coupon("EXPIRED", "fixed", 10, date(2026, 1, 1)),
+        Coupon("TODAY", "fixed", 20, today),
+        Coupon("FUTURE", "fixed", 30, date(2026, 1, 3)),
+        Coupon("NO_EXPIRY", "fixed", 40),
+    ]
+    assert apply_coupons(100, coupons, today) == (10, ["FUTURE", "NO_EXPIRY", "TODAY"])
+
+
+@pytest.mark.parametrize("codes", [("Z", "A"), ("A", "Z")])
+def test_equal_percent_uses_first_code(codes):
+    coupons = [Coupon(code, "percent", 10) for code in codes]
+    assert apply_coupons(100, coupons, date(2026, 1, 2)) == (90, ["A"])
+
+
+def test_combines_highest_eligible_percent_and_all_eligible_fixed():
+    coupons = [
+        Coupon("LOW", "percent", 5),
+        Coupon("HIGH", "percent", 50, min_subtotal_cents=101),
+        Coupon("WIN", "percent", 10, min_subtotal_cents=100),
+        Coupon("Z_FIXED", "fixed", 20, min_subtotal_cents=100),
+        Coupon("A_FIXED", "fixed", 5, min_subtotal_cents=100),
+        Coupon("INELIGIBLE", "fixed", 50, min_subtotal_cents=101),
+    ]
+    assert apply_coupons(100, coupons, date(2026, 1, 2)) == (
+        65, ["A_FIXED", "WIN", "Z_FIXED"]
+    )
+
+
+def test_rounds_percentage_half_up_and_clamps_after_all_coupons():
+    today = date(2026, 1, 2)
+    assert apply_coupons(5, [Coupon("TEN", "percent", 10)], today) == (4, ["TEN"])
+    assert apply_coupons(5, [Coupon("B", "fixed", 10), Coupon("A", "fixed", 1)], today) == (
+        0, ["A", "B"]
+    )
+    assert apply_coupons(0, [], today) == (0, [])
+
+
+def test_negative_subtotal_raises_shop_error():
+    with pytest.raises(ShopError):
+        apply_coupons(-1, [], date(2026, 1, 2))
+
+
+@pytest.mark.parametrize("expires", [None, date(2026, 1, 1)])
+def test_unknown_kind_raises_shop_error_even_if_expired(expires):
+    with pytest.raises(ShopError):
+        apply_coupons(100, [Coupon("BAD", "other", 10, expires)], date(2026, 1, 2))
