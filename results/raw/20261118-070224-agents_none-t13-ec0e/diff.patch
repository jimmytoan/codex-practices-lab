diff --git a/src/shoplib/costing.py b/src/shoplib/costing.py
index 5e8c27e..2feb2c0 100644
--- a/src/shoplib/costing.py
+++ b/src/shoplib/costing.py
@@ -1,6 +1,107 @@
 """Cost of goods sold with FIFO lots. See docs/costing.md."""
 
+from collections import deque
+from decimal import Decimal
+
+from shoplib.money import round_cents
+
 
 def fifo_costing(events: list[dict]) -> dict:
     """Process stock events and report cost per SKU. See docs/costing.md."""
-    raise NotImplementedError
+    inventory = {}
+
+    def quantity(value) -> bool:
+        # bool is an int subclass, but it is not a meaningful unit count.
+        return isinstance(value, int) and not isinstance(value, bool) and value >= 1
+
+    def unit_cost(value) -> bool:
+        return isinstance(value, int) and not isinstance(value, bool) and value >= 0
+
+    def state_for(sku):
+        if sku not in inventory:
+            inventory[sku] = {
+                "lots": deque(),
+                "cogs_cents": 0,
+                "on_hand": 0,
+                "most_recent_sale": None,
+            }
+        return inventory[sku]
+
+    for event in events:
+        if not isinstance(event, dict):
+            raise ValueError("each event must be a dict")
+
+        event_type = event.get("type")
+        if event_type not in ("receive", "sell", "return"):
+            raise ValueError(f"unknown event type: {event_type!r}")
+
+        try:
+            sku = event["sku"]
+            qty = event["qty"]
+        except KeyError as exc:
+            raise ValueError(f"missing event field: {exc.args[0]}") from None
+
+        if not quantity(qty):
+            raise ValueError("quantity must be a positive integer")
+
+        if event_type == "receive":
+            try:
+                cost = event["unit_cost_cents"]
+            except KeyError:
+                raise ValueError("missing event field: unit_cost_cents") from None
+            if not unit_cost(cost):
+                raise ValueError("unit cost must be a non-negative integer number of cents")
+
+            state = state_for(sku)
+            state["lots"].append([qty, cost])
+            state["on_hand"] += qty
+            continue
+
+        state = state_for(sku)
+
+        if event_type == "sell":
+            if qty > state["on_hand"]:
+                raise ValueError("cannot sell more units than are on hand")
+
+            units_left = qty
+            sale_cost = 0
+            while units_left:
+                lot_qty, cost = state["lots"][0]
+                taken = min(units_left, lot_qty)
+                sale_cost += taken * cost
+                units_left -= taken
+                lot_qty -= taken
+                if lot_qty:
+                    state["lots"][0][0] = lot_qty
+                else:
+                    state["lots"].popleft()
+
+            state["on_hand"] -= qty
+            state["cogs_cents"] += sale_cost
+            state["most_recent_sale"] = {
+                "qty": qty,
+                "returnable": qty,
+                "unit_cost_cents": round_cents(Decimal(sale_cost) / qty),
+            }
+            continue
+
+        sale = state["most_recent_sale"]
+        if sale is None:
+            raise ValueError("cannot return units when the SKU has had no sale")
+        if qty > sale["returnable"]:
+            raise ValueError("return exceeds units still returnable from the most recent sale")
+
+        return_cost = sale["unit_cost_cents"]
+        state["lots"].append([qty, return_cost])
+        state["on_hand"] += qty
+        state["cogs_cents"] -= qty * return_cost
+        sale["returnable"] -= qty
+
+    return {
+        sku: {
+            "cogs_cents": state["cogs_cents"],
+            "on_hand": state["on_hand"],
+            "value_cents": sum(qty * cost for qty, cost in state["lots"]),
+        }
+        for sku, state in inventory.items()
+    }
diff --git a/tests/test_costing.py b/tests/test_costing.py
new file mode 100644
index 0000000..6f0670b
--- /dev/null
+++ b/tests/test_costing.py
@@ -0,0 +1,93 @@
+import copy
+
+import pytest
+
+from shoplib.costing import fifo_costing
+
+
+def test_receive_and_sell_uses_oldest_lots_first():
+    events = [
+        {"type": "receive", "sku": "A", "qty": 2, "unit_cost_cents": 100},
+        {"type": "receive", "sku": "A", "qty": 3, "unit_cost_cents": 250},
+        {"type": "sell", "sku": "A", "qty": 4},
+    ]
+
+    assert fifo_costing(events) == {
+        "A": {"cogs_cents": 700, "on_hand": 1, "value_cents": 250}
+    }
+
+
+def test_returns_use_rounded_sale_average_and_are_added_after_existing_lots():
+    events = [
+        {"type": "receive", "sku": "A", "qty": 1, "unit_cost_cents": 100},
+        {"type": "receive", "sku": "A", "qty": 1, "unit_cost_cents": 101},
+        {"type": "sell", "sku": "A", "qty": 2},
+        {"type": "receive", "sku": "A", "qty": 1, "unit_cost_cents": 300},
+        {"type": "return", "sku": "A", "qty": 1},
+        {"type": "sell", "sku": "A", "qty": 1},
+    ]
+
+    # The sale average is 100.5 cents, rounded half up to 101. The later
+    # receipt is sold before the returned unit because returns join the tail.
+    assert fifo_costing(events) == {
+        "A": {"cogs_cents": 400, "on_hand": 1, "value_cents": 101}
+    }
+
+
+def test_multiple_returns_can_draw_from_same_most_recent_sale():
+    events = [
+        {"type": "receive", "sku": "A", "qty": 3, "unit_cost_cents": 125},
+        {"type": "sell", "sku": "A", "qty": 3},
+        {"type": "return", "sku": "A", "qty": 1},
+        {"type": "return", "sku": "A", "qty": 2},
+    ]
+
+    assert fifo_costing(events) == {
+        "A": {"cogs_cents": 0, "on_hand": 3, "value_cents": 375}
+    }
+
+
+def test_latest_sale_is_the_only_returnable_sale():
+    events = [
+        {"type": "receive", "sku": "A", "qty": 4, "unit_cost_cents": 100},
+        {"type": "sell", "sku": "A", "qty": 3},
+        {"type": "sell", "sku": "A", "qty": 1},
+        {"type": "return", "sku": "A", "qty": 2},
+    ]
+
+    with pytest.raises(ValueError):
+        fifo_costing(events)
+
+
+@pytest.mark.parametrize(
+    "events",
+    [
+        [{"type": "receive", "sku": "A", "qty": 0, "unit_cost_cents": 10}],
+        [{"type": "receive", "sku": "A", "qty": 1, "unit_cost_cents": -1}],
+        [{"type": "sell", "sku": "A", "qty": 1}],
+        [{"type": "return", "sku": "A", "qty": 1}],
+        [
+            {"type": "receive", "sku": "A", "qty": 1, "unit_cost_cents": 10},
+            {"type": "sell", "sku": "A", "qty": 1},
+            {"type": "return", "sku": "A", "qty": 1},
+            {"type": "return", "sku": "A", "qty": 1},
+        ],
+        [{"type": "adjust", "sku": "A", "qty": 1}],
+    ],
+)
+def test_invalid_events_raise_value_error(events):
+    with pytest.raises(ValueError):
+        fifo_costing(events)
+
+
+def test_events_are_not_modified():
+    events = [
+        {"type": "receive", "sku": "A", "qty": 2, "unit_cost_cents": 20},
+        {"type": "sell", "sku": "A", "qty": 1},
+        {"type": "return", "sku": "A", "qty": 1},
+    ]
+    original = copy.deepcopy(events)
+
+    fifo_costing(events)
+
+    assert events == original
