+def test_split_parcels_first_fit_and_inclusive_capacity():
+    items = [("small", 2, 1), ("medium", 5, 1), ("large", 6, 1),
+             ("filler", 4, 1), ("other", 3, 1)]
+    assert split_parcels(items, 10) == [["large", "filler"],
+                                       ["medium", "other", "small"]]
+
+
+def test_split_parcels_sorts_equal_weights_by_sku_and_expands_quantity():
+    items = [("z", 3, 2), ("a", 3, 2), ("heavy", 4, 1)]
+    assert split_parcels(items, 10) == [["heavy", "a", "a"], ["z", "z"]]
+
+
+@pytest.mark.parametrize("items, limit", [
+    ([("a", 0, 1)], 10),
+    ([("a", -1, 1)], 10),
+    ([("a", 1, 0)], 10),
+    ([("a", 1, -1)], 10),
+    ([("a", 11, 1)], 10),
+    ([("a", 1, 1)], 0),
+])
+def test_invalid_parcel_items(items, limit):
+    with pytest.raises(ShopError):
+        split_parcels(items, limit)
+    with pytest.raises(ShopError):
+        shipment_cost(items, limit)
+
+
+def test_empty_shipment():
+    assert split_parcels([], 0) == []
+    assert shipment_cost([], 0) == 0
