@@ -0,0 +1,79 @@
+import pytest
+
+from shoplib.search import Product, search
+
+
+@pytest.fixture
+def products():
+    return [
+        Product("MUG-RED", "Blue travel mug", 900, ["Sale", "drinkware"]),
+        Product("MUG-BLU", "Mug in blue", 1200, ["new", "drinkware"]),
+        Product("CUP-1", "Blue cup", 1500, ["sale"]),
+        Product("PLATE", "Red plate", 1000),
+    ]
+
+
+def test_empty_query_matches_all_and_results_keep_input_order(products):
+    assert search(products, " \t\n") == products
+    assert search(products, "blue") == products[:3]
+
+
+def test_bare_terms_and_quoted_phrases_match_name_case_insensitively(products):
+    assert search(products, "BLUE") == products[:3]
+    assert search(products, '"blue travel"') == products[:1]
+    assert search(products, 'name:"IN BLUE"') == products[1:2]
+    # A quoted whole term is a name phrase, even when it contains a colon.
+    assert search(products, '"tag:sale"') == []
+
+
+def test_field_matching_and_prefixes(products):
+    assert search(products, "sku:mug-red") == products[:1]
+    assert search(products, "tag:SALE") == [products[0], products[2]]
+    assert search(products, "sku:MUG-*") == products[:2]
+    assert search(products, "tag:drink*") == products[:2]
+    assert search(products, "sku:MUG") == []
+    # A star anywhere other than the final character remains literal.
+    with_star = Product("MU*G-1", "Star mug", 500)
+    assert search([with_star], "sku:MU*G-*") == [with_star]
+    assert search([with_star], "sku:MU?G-*") == []
+
+
+def test_negation_applies_to_a_term(products):
+    assert search(products, "blue -tag:sale") == [products[1]]
+    assert search(products, "-sku:MUG-*") == products[2:]
+    assert search(products, '-"blue travel"') == products[1:]
+
+
+@pytest.mark.parametrize(
+    ("query", "expected"),
+    [
+        ("price<1000", [0]),
+        ("price<=1000", [0, 3]),
+        ("price>1000", [1, 2]),
+        ("price>=1000", [1, 2, 3]),
+        ("price=1000", [3]),
+        ("-price<1000", [1, 2, 3]),
+    ],
+)
+def test_price_comparisons(products, query, expected):
+    assert search(products, query) == [products[index] for index in expected]
+
+
+@pytest.mark.parametrize(
+    "query",
+    [
+        "other:value",
+        "price:5",
+        "tag:",
+        'name:""',
+        "-",
+        '"unclosed',
+        "price>",
+        "price>=one",
+        "price<1.5",
+        "price>=-1",
+    ],
+)
+def test_invalid_queries_raise_value_error(products, query):
+    with pytest.raises(ValueError):
+        search(products, query)
