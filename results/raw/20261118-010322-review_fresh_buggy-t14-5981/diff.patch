@@ -1,6 +1,32 @@
 """Revenue per store day. See docs/store-days.md."""
 
+from datetime import datetime, timedelta, timezone
+
+from shoplib.errors import ShopError
+
 
 def daily_revenue(sales: list[dict], utc_offset_hours: int = 8, day_starts_hour: int = 4) -> list[tuple[str, int]]:
     """Revenue per store day. See docs/store-days.md."""
-    raise NotImplementedError
+    try:
+        tz = timezone(timedelta(hours=utc_offset_hours))
+    except (ValueError, OverflowError) as exc:
+        raise ShopError("invalid UTC offset") from exc
+    totals: dict = {}
+    for sale in sales:
+        try:
+            at = datetime.fromisoformat(sale["at"])
+        except ValueError as exc:
+            raise ShopError("invalid timestamp") from exc
+        if at.tzinfo is None:
+            raise ShopError(f"timestamp without a zone: {sale['at']}")
+        day = (at.astimezone(tz) - timedelta(hours=day_starts_hour)).date()
+        totals[day] = totals.get(day, 0) + sale["cents"]
+    if not totals:
+        return []
+    out, day, last_day = [], min(totals), max(totals)
+    while True:
+        out.append((day.isoformat(), totals.get(day, 0)))
+        if day == last_day:
+            break
+        day += timedelta(days=1)
+    return out
diff --git a/tests/test_storedays.py b/tests/test_storedays.py
new file mode 100644
index 0000000..29f9016
--- /dev/null
+++ b/tests/test_storedays.py
@@ -0,0 +1,57 @@
+import pytest
+
+from shoplib.errors import ShopError
+from shoplib.storedays import daily_revenue
+
+
+def test_boundary_and_time_zones():
+    sales = [
+        {"at": "2026-11-17T19:59:59.999999Z", "cents": 100},
+        {"at": "2026-11-17T20:00:00Z", "cents": 200},
+        {"at": "2026-11-18T02:30:00+06:00", "cents": -50},
+        {"at": "2026-11-17T23:00:00-05:00", "cents": 25},
+    ]
+    assert daily_revenue(sales) == [("2026-11-17", 100), ("2026-11-18", 175)]
+
+
+def test_gaps_and_unsorted_sales():
+    sales = [
+        {"at": "2026-11-21T04:00:00+08:00", "cents": 50},
+        {"at": "2026-11-18T02:30:00+08:00", "cents": 100},
+        {"at": "2026-11-17T04:00:00+08:00", "cents": -100},
+    ]
+    assert daily_revenue(sales) == [
+        ("2026-11-17", 0),
+        ("2026-11-18", 0),
+        ("2026-11-19", 0),
+        ("2026-11-20", 0),
+        ("2026-11-21", 50),
+    ]
+
+
+def test_custom_offset_and_start_hour():
+    sales = [
+        {"at": "2026-11-18T13:59:59Z", "cents": 1},
+        {"at": "2026-11-18T14:00:00Z", "cents": 2},
+    ]
+    assert daily_revenue(sales, utc_offset_hours=-5, day_starts_hour=9) == [
+        ("2026-11-17", 1), ("2026-11-18", 2)
+    ]
+
+
+def test_empty_sales_and_last_representable_date():
+    assert daily_revenue([]) == []
+    assert daily_revenue([{"at": "9999-12-31T04:00:00+08:00", "cents": 1}]) == [
+        ("9999-12-31", 1)
+    ]
+
+
+@pytest.mark.parametrize("timestamp", ["2026-11-18T04:00:00", "not a timestamp"])
+def test_invalid_timestamps_raise_shop_error(timestamp):
+    with pytest.raises(ShopError):
+        daily_revenue([{"at": timestamp, "cents": 1}])
+
+
+def test_invalid_offset_raises_shop_error():
+    with pytest.raises(ShopError):
+        daily_revenue([], utc_offset_hours=24)
