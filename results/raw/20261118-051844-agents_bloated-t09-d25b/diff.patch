@@ -12,11 +15,22 @@ def slugify(text: str, max_len: int = 40) -> str:
     - No leading or trailing '-'.
     - At most `max_len` characters, cut after the other steps; a cut never
       leaves a trailing '-'.
-    - If nothing is left, the slug is 'n-a'.
+    - If nothing is left, the slug is 'n-a', shortened to fit `max_len` when
+      `max_len` is less than 3.
     """
-    slug = re.sub(r"[^a-z0-9]+", "-", text.lower()).strip("-")
-    slug = slug[:max_len].rstrip("-")
-    return slug or "n-a"
+    if not isinstance(text, str):
+        raise ShopError("text must be a string")
+    if not isinstance(max_len, int) or isinstance(max_len, bool) or max_len < 1:
+        raise ShopError("max_len must be a positive integer")
+
+    decomposed = unicodedata.normalize("NFD", text.lower())
+    unaccented = "".join(
+        character
+        for character in decomposed
+        if unicodedata.category(character) != "Mn"
+    )
+    slug = re.sub(r"[^a-z0-9]+", "-", unaccented).strip("-") or "n-a"
+    return slug[:max_len].rstrip("-")
 
 
