--- a/tests/test_textutil.py
+++ b/tests/test_textutil.py
@@ -1,3 +1,6 @@
+import pytest
+
+from shoplib.errors import ShopError
 from shoplib.textutil import slugify, truncate
 
 
@@ -6,6 +9,23 @@ def test_slugify_basic():
     assert slugify("!!!") == "n-a"
 
 
+def test_slugify_removes_accents_before_replacing_punctuation():
+    assert slugify("Crème Brûlée") == "creme-brulee"
+    assert slugify("CAFÉ au Lait") == "cafe-au-lait"
+
+
+def test_slugify_max_len_applies_to_transliterated_slug_and_fallback():
+    assert slugify("Crème Brûlée", max_len=7) == "creme-b"
+    assert slugify("Crème Brûlée", max_len=6) == "creme"
+    assert slugify("!!!", max_len=2) == "n"
+    assert slugify("!!!", max_len=1) == "n"
+
+
+def test_slugify_rejects_non_positive_max_len():
+    with pytest.raises(ShopError):
+        slugify("mug", max_len=0)
+
+
 def test_truncate():
     assert truncate("hello world", 8) == "hello..."
     assert truncate("short", 8) == "short"
