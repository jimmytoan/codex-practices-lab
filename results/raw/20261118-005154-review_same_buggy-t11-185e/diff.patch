index 0000000..f6c499b
--- /dev/null
+++ b/tests/test_invoice.py
@@ -0,0 +1,74 @@
+import pytest
+
+from shoplib.errors import ShopError
+from shoplib.invoice import build_invoice
+
+
+def test_allocation_net_tax_and_total():
+    invoice = build_invoice(
+        [("a", 100, 1, "standard"), ("b", 100, 2, "food"),
+         ("c", 300, 1, "books")],
+        5, 100, "DE",
+    )
+    assert invoice == {
+        "lines": [
+            {"sku": "a", "gross_cents": 100, "discount_cents": 1,
+             "net_cents": 99, "tax_cents": 19},
+            {"sku": "b", "gross_cents": 200, "discount_cents": 2,
+             "net_cents": 198, "tax_cents": 14},
+            {"sku": "c", "gross_cents": 300, "discount_cents": 2,
+             "net_cents": 298, "tax_cents": 21},
+        ],
+        "shipping_cents": 100,
+        "shipping_tax_cents": 19,
+        "total_cents": 768,
+    }
+
+
+def test_equal_remainders_favor_earlier_line():
+    invoice = build_invoice(
+        [("a", 100, 1, "books"), ("b", 100, 1, "books")], 1, 0, "SG"
+    )
+    assert [line["discount_cents"] for line in invoice["lines"]] == [1, 0]
+
+
+def test_coupon_is_capped_and_tax_is_on_net():
+    invoice = build_invoice([("a", 100, 1, "standard")], 150, 100, "DE")
+    assert invoice["lines"][0] == {
+        "sku": "a", "gross_cents": 100, "discount_cents": 100,
+        "net_cents": 0, "tax_cents": 0,
+    }
+    assert invoice["shipping_tax_cents"] == 19
+    assert invoice["total_cents"] == 119
+
+
+def test_zero_gross_and_untaxed_shipping():
+    invoice = build_invoice([("a", 0, 2, "books")], 50, 100, "SG")
+    assert invoice["lines"][0]["discount_cents"] == 0
+    assert invoice["shipping_tax_cents"] == 0
+    assert invoice["total_cents"] == 100
+
+
+def test_tax_is_rounded_per_line():
+    invoice = build_invoice(
+        [("a", 6, 1, "standard"), ("b", 6, 1, "standard")], 0, 0, "SG"
+    )
+    assert [line["tax_cents"] for line in invoice["lines"]] == [1, 1]
+    assert invoice["total_cents"] == 14
+
+
+@pytest.mark.parametrize(
+    "lines, coupon, shipping, region",
+    [
+        ([("a", 100, 1, "standard")], 0, 0, "unknown"),
+        ([], 0, 0, "DE"),
+        ([("a", 100, 1, "unknown")], 0, 0, "DE"),
+        ([("a", 100, 0, "standard")], 0, 0, "DE"),
+        ([("a", -1, 1, "standard")], 0, 0, "DE"),
+        ([("a", 100, 1, "standard")], -1, 0, "DE"),
+        ([("a", 100, 1, "standard")], 0, -1, "DE"),
+    ],
+)
+def test_invalid_arguments_raise_shop_error(lines, coupon, shipping, region):
+    with pytest.raises(ShopError):
+        build_invoice(lines, coupon, shipping, region)
