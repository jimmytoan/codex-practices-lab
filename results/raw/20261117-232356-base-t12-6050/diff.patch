@@ -0,0 +1,96 @@
+import pytest
+
+from shoplib.errors import ShopError
+from shoplib.search import Product, search
+
+
+@pytest.fixture
+def products():
+    return [
+        Product("MUG-BLUE", "Large Blue Mug", 1000, ["Sale", "Kitchen"]),
+        Product("MUG-RED", "Small red mug", 999, ["Kitchenware"]),
+        Product("PLATE", "Blue plate", 1500, ["SALE", "Dining"]),
+        Product("STAR*BOX", "A name:with colon", 0, ["star*tag"]),
+    ]
+
+
+@pytest.mark.parametrize("query", ["", "  \t\n  ", '""'])
+def test_empty_query(products, query):
+    assert search(products, query) == products
+
+
+def test_words_phrases_and_order(products):
+    assert search(products, "mUg") == products[:2]
+    assert search(products, '"BLUE MUG"') == products[:1]
+    assert search(products, '  blue\t"large blue"  ') == products[:1]
+    assert search(products, '"name:with colon"') == products[3:]
+    assert search([Product("x", "Straße", 0)], "STRASSE")[0].name == "Straße"
+
+
+@pytest.mark.parametrize(
+    ("query", "indices"),
+    [
+        ("sku:mug-blue", [0]),
+        ("sku:mug", []),
+        ("sku:MUG-*", [0, 1]),
+        ("sku:STAR*BOX", [3]),
+        ("sku:STAR*B*", [3]),
+        ("tag:sale", [0, 2]),
+        ("tag:kitchen", [0]),
+        ("tag:KITCHEN*", [0, 1]),
+        ("tag:star*tag", [3]),
+        ('tag:"kitCHEN*"', [0, 1]),
+        ('sku:"MUG-*"', [0, 1]),
+        ('name:"blue mug"', [0]),
+        ('name:"name:with colon"', [3]),
+        ("name:mug*", []),
+    ],
+)
+def test_fields_and_prefixes(products, query, indices):
+    assert search(products, query) == [products[i] for i in indices]
+
+
+@pytest.mark.parametrize(
+    ("query", "indices"),
+    [
+        ("price<1000", [1, 3]),
+        ("price<=1000", [0, 1, 3]),
+        ("price>1000", [2]),
+        ("price>=1000", [0, 2]),
+        ("price=1000", [0]),
+        ("price=0000", [3]),
+        ("price<" + "9" * 5000, [0, 1, 2, 3]),
+    ],
+)
+def test_price_comparisons(products, query, indices):
+    assert search(products, query) == [products[i] for i in indices]
+
+
+def test_combined_and_negated_terms(products):
+    assert search(products, "mug -tag:sale price<1000") == products[1:2]
+    assert search(products, '-"blue mug" -price>=1500') == [products[1], products[3]]
+    assert search(products, '-sku:MUG-*') == products[2:]
+    assert search([Product("x", "-tag:sale", 0)], '"-tag:sale"')
+
+
+def test_empty_tags_and_quoted_whitespace():
+    products = [Product("x", "blue  mug\nlarge", 1), Product("y", "blue mug", 1, [""])]
+    assert search(products, '"blue  mug\nlarge"') == products[:1]
+    assert search(products, "tag:*") == products[1:]
+    assert search(products, "-tag:*") == products[:1]
+
+
+@pytest.mark.parametrize(
+    "query",
+    [
+        "unknown:value", "price:5", ":value", "tag:", 'name:""', "sku:",
+        "-", '-""', '"unclosed', 'name:"unclosed',
+        "price<", "price<=abc", "price>1.0", "price>=-1", "price=+1",
+        "price==10", "price<>10", "price=1e3", "price=１２",
+        "no-match tag:",
+    ],
+)
+@pytest.mark.parametrize("empty_products", [False, True])
+def test_invalid_queries_raise_shop_error(products, query, empty_products):
+    with pytest.raises(ShopError):
+        search([] if empty_products else products, query)
