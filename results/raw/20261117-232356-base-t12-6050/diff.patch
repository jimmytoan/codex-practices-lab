@@ -13,4 +16,94 @@ class Product:
 
 def search(products: list[Product], query: str) -> list[Product]:
     """The products that match `query`, in their input order. See docs/search.md."""
-    raise NotImplementedError
+    terms = [_parse_term(text, quoted) for text, quoted in _tokens(query)]
+    return [product for product in products if all(term(product) for term in terms)]
+
+
+def _tokens(query):
+    """Split a query while remembering which characters were quoted."""
+    text = []
+    quoted = []
+    in_quotes = False
+    started = False
+    for char in query:
+        if char == '"':
+            in_quotes = not in_quotes
+            started = True
+        elif char.isspace() and not in_quotes:
+            if started:
+                yield "".join(text), quoted
+                text, quoted, started = [], [], False
+        else:
+            text.append(char)
+            quoted.append(in_quotes)
+            started = True
+    if in_quotes:
+        raise ShopError("unclosed quote")
+    if started:
+        yield "".join(text), quoted
+
+
+def _parse_term(text, quoted):
+    negate = bool(text and text[0] == "-" and not quoted[0])
+    if negate:
+        text, quoted = text[1:], quoted[1:]
+        if not text:
+            raise ShopError("empty negated term")
+
+    colon = next((i for i, c in enumerate(text) if c == ":" and not quoted[i]), -1)
+    if colon != -1:
+        field_name, value = text[:colon], text[colon + 1 :]
+        if field_name not in ("sku", "tag", "name"):
+            raise ShopError("unknown field")
+        if not value:
+            raise ShopError("empty field value")
+        value = value.casefold()
+        prefix = field_name in ("sku", "tag") and value.endswith("*")
+        if prefix:
+            value = value[:-1]
+
+        def matches(product):
+            if field_name == "name":
+                return value in product.name.casefold()
+            candidates = [product.sku] if field_name == "sku" else product.tags
+            return any(
+                candidate.casefold().startswith(value) if prefix
+                else candidate.casefold() == value
+                for candidate in candidates
+            )
+
+    else:
+        comparison = re.match(r"price(<=|>=|<|>|=)", text)
+        if comparison and not any(quoted[: comparison.end()]):
+            operator = comparison.group(1)
+            number = text[comparison.end() :]
+            if not re.fullmatch(r"[0-9]+", number):
+                raise ShopError("invalid price")
+            # Convert in chunks so valid long numbers are not subject to the
+            # interpreter's limit on decimal string-to-integer conversions.
+            price = 0
+            for i in range(0, len(number), 9):
+                chunk = number[i : i + 9]
+                price = price * 10 ** len(chunk) + int(chunk)
+
+            def matches(product):
+                actual = product.price_cents
+                if operator == "<":
+                    return actual < price
+                if operator == "<=":
+                    return actual <= price
+                if operator == ">":
+                    return actual > price
+                if operator == ">=":
+                    return actual >= price
+                return actual == price
+        else:
+            value = text.casefold()
+
+            def matches(product):
+                return value in product.name.casefold()
+
+    if negate:
+        return lambda product: not matches(product)
+    return matches
diff --git a/tests/test_search.py b/tests/test_search.py
