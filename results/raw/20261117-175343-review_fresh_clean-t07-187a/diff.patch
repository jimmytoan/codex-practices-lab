+from datetime import date
+
+import pytest
+
+from shoplib.discounts import Coupon, apply_coupon, apply_coupons
+from shoplib.errors import ShopError
 
 
 def test_percent():
@@ -7,3 +12,40 @@ def test_percent():
 
 def test_fixed_never_negative():
     assert apply_coupon(300, Coupon("FIVE", "fixed", 500)) == 0
+
+
+def test_apply_coupons_selects_percent_and_checks_original_subtotal():
+    today = date(2026, 6, 1)
+    coupons = [
+        Coupon("Z", "percent", 10),
+        Coupon("A", "percent", 10, expires=today),
+        Coupon("LOW", "percent", 5),
+        Coupon("EXPIRED", "percent", 90, expires=date(2026, 5, 31)),
+        Coupon("MIN", "fixed", 20, min_subtotal_cents=105),
+        Coupon("TOO_HIGH", "fixed", 50, min_subtotal_cents=106),
+        Coupon("FIXED", "fixed", 3),
+    ]
+    # 10% of 105 rounds half up to 11; the minimum uses the original 105.
+    assert apply_coupons(105, coupons, today) == (71, ["A", "FIXED", "MIN"])
+
+
+def test_apply_coupons_clamps_total_but_reports_all_applied_codes():
+    coupons = [Coupon("P", "percent", 50), Coupon("Z", "fixed", 100), Coupon("A", "fixed", 10)]
+    assert apply_coupons(100, coupons, date(2026, 1, 1)) == (0, ["A", "P", "Z"])
+
+
+def test_apply_coupons_empty_or_ineligible():
+    today = date(2026, 1, 1)
+    assert apply_coupons(0, [], today) == (0, [])
+    assert apply_coupons(100, [Coupon("LATE", "fixed", 5, expires=date(2025, 12, 31))], today) == (100, [])
+
+
+def test_apply_coupons_rejects_negative_subtotal():
+    with pytest.raises(ShopError):
+        apply_coupons(-1, [], date(2026, 1, 1))
+
+
+@pytest.mark.parametrize("expires", [None, date(2025, 12, 31)])
+def test_apply_coupons_rejects_unknown_kind(expires):
+    with pytest.raises(ShopError):
+        apply_coupons(100, [Coupon("BAD", "unknown", 10, expires=expires)], date(2026, 1, 1))
