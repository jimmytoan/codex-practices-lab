+def test_shipment_cost_uses_weights_of_individual_units():
+    # The lighter "same" unit goes into an earlier parcel than the heavier one.
+    items = [("x", 2200, 1), ("same", 1900, 1), ("same", 800, 1), ("y", 100, 1)]
+    assert split_parcels(items, 3000) == [["x", "same"], ["same", "y"]]
