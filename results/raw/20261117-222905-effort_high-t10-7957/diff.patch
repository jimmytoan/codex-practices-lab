--- a/src/shoplib/shipping.py
+++ b/src/shoplib/shipping.py
@@ -1,5 +1,7 @@
 """Shipping costs and parcel splitting. See docs/shipping.md."""
 
+from .errors import ShopError
+
 # (upper bound in grams, cost in cents)
 TIERS = [(1000, 500), (2000, 800), (5000, 1200), (20000, 2500)]
 
@@ -16,9 +18,56 @@ def shipping_cost(weight_g: int) -> int:
 
 def split_parcels(items: list[tuple[str, int, int]], max_weight_g: int) -> list[list[str]]:
     """Split order items into parcels. See docs/shipping.md."""
-    raise NotImplementedError
+    _validate_items(items, max_weight_g)
+    units = sorted(
+        ((sku, weight) for sku, weight, qty in items for _ in range(qty)),
+        key=lambda unit: (-unit[1], unit[0]),
+    )
+    parcels: list[list[str]] = []
+    weights: list[int] = []
+    for sku, weight in units:
+        for index, parcel_weight in enumerate(weights):
+            if parcel_weight + weight <= max_weight_g:
+                parcels[index].append(sku)
+                weights[index] += weight
+                break
+        else:
+            parcels.append([sku])
+            weights.append(weight)
+    return parcels
 
 
 def shipment_cost(items: list[tuple[str, int, int]], max_weight_g: int) -> int:
     """Total shipping cost of an order. See docs/shipping.md."""
-    raise NotImplementedError
+    _validate_items(items, max_weight_g)
+    # Preserve each unit's weight even when a SKU occurs at different weights.
+    weighted_items = [(_WeightedSku(sku, weight), weight, qty) for sku, weight, qty in items]
+    parcels = split_parcels(weighted_items, max_weight_g)
+    try:
+        return sum(shipping_cost(sum(sku.weight_g for sku in parcel)) for parcel in parcels)
+    except ValueError as exc:
+        raise ShopError(str(exc)) from exc
+
+
+class _WeightedSku(str):
+    """A SKU that retains its unit weight while it is packed."""
+
+    def __new__(cls, sku: str, weight_g: int):
+        result = super().__new__(cls, sku)
+        result.weight_g = weight_g
+        return result
+
+
+def _validate_items(items: list[tuple[str, int, int]], max_weight_g: int) -> None:
+    if not isinstance(items, list) or not isinstance(max_weight_g, int):
+        raise ShopError("items must be a list and max weight must be an integer")
+    for item in items:
+        if not isinstance(item, (tuple, list)) or len(item) != 3:
+            raise ShopError("each item must contain a SKU, weight, and quantity")
+        sku, weight, qty = item
+        if not isinstance(sku, str) or not isinstance(weight, int) or not isinstance(qty, int):
+            raise ShopError("SKU must be text and weight and quantity must be integers")
+        if qty < 1 or weight < 1:
+            raise ShopError("weight and quantity must be positive")
+        if weight > max_weight_g:
+            raise ShopError("unit exceeds maximum parcel weight")
