+def test_split_first_fit_decreasing_and_quantity():
+    items = [("D", 2, 2), ("C", 3, 1), ("B", 5, 1), ("A", 6, 1)]
+    assert split_parcels(items, 10) == [["A", "C"], ["B", "D", "D"]]
+    assert items == [("D", 2, 2), ("C", 3, 1), ("B", 5, 1), ("A", 6, 1)]
+
+
+def test_split_equal_weight_sorts_sku_and_fills_at_capacity():
+    items = [("z", 5, 1), ("a", 5, 2), ("b", 5, 1)]
+    assert split_parcels(items, 10) == [["a", "a"], ["b", "z"]]
+
+
+def test_split_uses_first_fit_even_when_another_parcel_is_tighter():
+    items = [("a", 8, 1), ("b", 6, 1), ("c", 3, 1), ("d", 1, 1)]
+    assert split_parcels(items, 10) == [["a", "d"], ["b", "c"]]
+
+
+def test_empty_shipment():
+    assert split_parcels([], 0) == []
+    assert shipment_cost([], 0) == 0
+
+
+@pytest.mark.parametrize("function", [split_parcels, shipment_cost])
