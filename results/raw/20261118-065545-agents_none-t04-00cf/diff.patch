diff --git a/src/shoplib/orders.py b/src/shoplib/orders.py
index 8edb164..51c4624 100644
--- a/src/shoplib/orders.py
+++ b/src/shoplib/orders.py
@@ -46,3 +46,22 @@ class Order:
 
     def deliver(self) -> None:
         self._transition((SHIPPED,), DELIVERED)
+
+    def cancel(self) -> None:
+        if self.state == CANCELLED:
+            return
+        if self.state not in (NEW, PAID):
+            raise ValueError(f"cannot cancel an order in {self.state}")
+
+        # Check every line before releasing any stock so an invalid reservation
+        # cannot leave a multi-line order only partially cancelled.
+        for sku, qty in self.lines.items():
+            if qty <= 0:
+                raise ValueError("qty must be positive")
+            if qty > self.inventory.reserved(sku):
+                raise ValueError(f"only {self.inventory.reserved(sku)} of {sku} reserved")
+        for sku, qty in self.lines.items():
+            self.inventory.release(sku, qty)
+
+        self.refund_due = self.state == PAID
+        self.state = CANCELLED
diff --git a/tests/test_inventory.py b/tests/test_inventory.py
index 37436c0..c3d99ad 100644
--- a/tests/test_inventory.py
+++ b/tests/test_inventory.py
@@ -18,3 +18,29 @@ def test_cannot_reserve_more_than_available():
     inv.receive("A", 2)
     with pytest.raises(ValueError):
         inv.reserve("A", 3)
+
+
+def test_release_returns_reserved_stock_to_available():
+    inv = Inventory()
+    inv.receive("A", 10)
+    inv.reserve("A", 4)
+    inv.release("A", 3)
+    assert inv.on_hand("A") == 10
+    assert inv.reserved("A") == 1
+    assert inv.available("A") == 9
+
+
+@pytest.mark.parametrize("qty", [0, -1])
+def test_release_requires_positive_quantity(qty):
+    inv = Inventory()
+    with pytest.raises(ValueError):
+        inv.release("A", qty)
+
+
+def test_cannot_release_more_than_reserved():
+    inv = Inventory()
+    inv.receive("A", 2)
+    inv.reserve("A", 1)
+    with pytest.raises(ValueError):
+        inv.release("A", 2)
+    assert inv.reserved("A") == 1
diff --git a/tests/test_orders.py b/tests/test_orders.py
index d3835d1..6461774 100644
--- a/tests/test_orders.py
+++ b/tests/test_orders.py
@@ -1,7 +1,7 @@
 import pytest
 
 from shoplib.inventory import Inventory
-from shoplib.orders import DELIVERED, NEW, Order
+from shoplib.orders import CANCELLED, DELIVERED, NEW, SHIPPED, Order
 
 
 def make():
@@ -25,3 +25,60 @@ def test_cannot_ship_unpaid():
     _, order = make()
     with pytest.raises(ValueError):
         order.ship()
+
+
+def test_cancel_new_order_releases_stock_without_refund():
+    inv, order = make()
+    order.cancel()
+    assert order.state == CANCELLED
+    assert order.refund_due is False
+    assert inv.on_hand("A") == 5
+    assert inv.reserved("A") == 0
+    assert inv.available("A") == 5
+
+
+def test_cancel_paid_order_releases_stock_and_sets_refund():
+    inv, order = make()
+    order.pay()
+    order.cancel()
+    assert order.state == CANCELLED
+    assert order.refund_due is True
+    assert inv.on_hand("A") == 5
+    assert inv.reserved("A") == 0
+    assert inv.available("A") == 5
+
+
+def test_cancel_already_cancelled_does_not_release_stock_twice():
+    inv, order = make()
+    order.cancel()
+    order.cancel()
+    assert order.state == CANCELLED
+    assert inv.reserved("A") == 0
+
+
+def test_cancel_does_not_partially_release_if_a_line_is_not_reserved():
+    inv = Inventory()
+    inv.receive("A", 5)
+    inv.receive("B", 5)
+    order = Order("o1", {"A": 2, "B": 2}, inv)
+    inv.release("B", 2)
+    before = (order.state, inv.reserved("A"), inv.reserved("B"))
+    with pytest.raises(ValueError):
+        order.cancel()
+    assert (order.state, inv.reserved("A"), inv.reserved("B")) == before
+
+
+@pytest.mark.parametrize("state", [SHIPPED, DELIVERED])
+def test_cannot_cancel_shipped_or_delivered_order(state):
+    inv, order = make()
+    if state == SHIPPED:
+        order.pay()
+        order.ship()
+    else:
+        order.pay()
+        order.ship()
+        order.deliver()
+    before = (order.state, order.refund_due, inv.on_hand("A"), inv.reserved("A"))
+    with pytest.raises(ValueError):
+        order.cancel()
+    assert (order.state, order.refund_due, inv.on_hand("A"), inv.reserved("A")) == before
