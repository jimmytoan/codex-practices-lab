 def test_percent():
@@ -7,3 +11,60 @@ def test_percent():
 
 def test_fixed_never_negative():
     assert apply_coupon(300, Coupon("FIVE", "fixed", 500)) == 0
+
+
+def test_apply_coupons_chooses_highest_percent_and_all_fixed():
+    coupons = [
+        Coupon("TEN", "percent", 10),
+        Coupon("FIFTEEN", "percent", 15),
+        Coupon("A-FIVE", "fixed", 500),
+        Coupon("B-TWO", "fixed", 200),
+    ]
+
+    assert apply_coupons(10_000, coupons, date(2025, 1, 1)) == (
+        7_800,
+        ["A-FIVE", "B-TWO", "FIFTEEN"],
+    )
+
+
+def test_apply_coupons_breaks_percent_ties_by_code():
+    coupons = [
+        Coupon("ZED", "percent", 20),
+        Coupon("ALPHA", "percent", 20),
+    ]
+
+    assert apply_coupons(1_000, coupons, date(2025, 1, 1)) == (800, ["ALPHA"])
+
+
+def test_apply_coupons_eligibility_uses_original_subtotal_and_expiry_is_inclusive():
+    coupons = [
+        Coupon("PERCENT", "percent", 50),
+        Coupon("MINIMUM", "fixed", 100, min_subtotal_cents=1_000),
+        Coupon("EXPIRED", "fixed", 500, expires=date(2024, 12, 31)),
+        Coupon("EXPIRES-TODAY", "fixed", 100, expires=date(2025, 1, 1)),
+    ]
+
+    assert apply_coupons(1_000, coupons, date(2025, 1, 1)) == (
+        300,
+        ["EXPIRES-TODAY", "MINIMUM", "PERCENT"],
+    )
+
+
+def test_apply_coupons_returns_original_subtotal_when_none_are_eligible():
+    coupons = [
+        Coupon("TOO-LATE", "fixed", 100, expires=date(2024, 12, 31)),
+        Coupon("TOO-EXPENSIVE", "percent", 50, min_subtotal_cents=1_001),
+    ]
+
+    assert apply_coupons(1_000, coupons, date(2025, 1, 1)) == (1_000, [])
+
+
+def test_apply_coupons_never_returns_a_negative_total():
+    coupons = [Coupon("HALF", "percent", 50), Coupon("BIG", "fixed", 800)]
+
+    assert apply_coupons(1_000, coupons, date(2025, 1, 1)) == (0, ["BIG", "HALF"])
+
+
+def test_apply_coupons_rejects_negative_subtotal():
+    with pytest.raises(ValueError, match="subtotal"):
