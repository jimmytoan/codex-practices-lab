@@ -1,6 +1,59 @@
 """Revenue per store day. See docs/store-days.md."""
 
+import re
+from datetime import datetime, timedelta
+
+from shoplib.errors import ShopError
+
+
+_ZONE = re.compile(r"(Z|[+-]([0-9]{2}):([0-9]{2}))$")
+
 
 def daily_revenue(sales: list[dict], utc_offset_hours: int = 8, day_starts_hour: int = 4) -> list[tuple[str, int]]:
-    """Revenue per store day. See docs/store-days.md."""
-    raise NotImplementedError
+    """Total sales by store day, including zeroes for days without sales."""
+    if not isinstance(utc_offset_hours, int) or isinstance(utc_offset_hours, bool):
+        raise ShopError("UTC offset must be an integer number of hours")
+    if (
+        not isinstance(day_starts_hour, int)
+        or isinstance(day_starts_hour, bool)
+        or not 0 <= day_starts_hour <= 23
+    ):
+        raise ShopError("day start must be an hour from 0 to 23")
+    try:
+        shop_offset = timedelta(hours=utc_offset_hours)
+        sale_iter = iter(sales)
+    except (OverflowError, TypeError) as exc:
+        raise ShopError("invalid sales or UTC offset") from exc
+
+    totals = {}
+    for sale in sale_iter:
+        if not isinstance(sale, dict) or "at" not in sale or "cents" not in sale:
+            raise ShopError("each sale must have a timestamp and cents")
+        timestamp, cents = sale["at"], sale["cents"]
+        if not isinstance(timestamp, str):
+            raise ShopError("timestamp must be a string with a zone")
+        if not isinstance(cents, int) or isinstance(cents, bool):
+            raise ShopError("sale amount must be integer cents")
+        zone = _ZONE.search(timestamp)
+        if zone is None or (
+            zone.group(2) is not None
+            and (int(zone.group(2)) > 23 or int(zone.group(3)) > 59)
+        ):
+            raise ShopError("timestamp must have a valid zone")
+        try:
+            at = datetime.fromisoformat(timestamp)
+            if at.utcoffset() is None:
+                raise ShopError("timestamp must have a zone")
+            local = at.replace(tzinfo=None) + (shop_offset - at.utcoffset())
+            day = local.date()
+            if local.hour < day_starts_hour:
+                day -= timedelta(days=1)
+        except (ValueError, OverflowError) as exc:
+            raise ShopError("invalid timestamp or store day") from exc
+        totals[day] = totals.get(day, 0) + cents
+
+    if not totals:
+        return []
+    first, last = min(totals), max(totals)
+    days = (first + timedelta(days=offset) for offset in range((last - first).days + 1))
+    return [(day.isoformat(), totals.get(day, 0)) for day in days]
diff --git a/tests/test_storedays.py b/tests/test_storedays.py
new file mode 100644
index 0000000..d39ba4c
--- /dev/null
+++ b/tests/test_storedays.py
@@ -0,0 +1,107 @@
+import pytest
+
+from shoplib.errors import ShopError
+from shoplib.storedays import daily_revenue
+
+
+def test_empty_sales():
+    assert daily_revenue([]) == []
+
+
+def test_default_day_boundary_and_refunds():
+    sales = [
+        {"at": "2026-11-18T02:30:00+08:00", "cents": 500},
+        {"at": "2026-11-18T03:59:59.999999+08:00", "cents": -125},
+        {"at": "2026-11-18T04:00:00+08:00", "cents": 200},
+        {"at": "2026-11-18T23:59:00+08:00", "cents": 50},
+    ]
+    assert daily_revenue(sales) == [("2026-11-17", 375), ("2026-11-18", 250)]
+
+
+def test_equivalent_instants_with_different_zones():
+    sales = [
+        {"at": "2026-11-17T20:00:00Z", "cents": 100},
+        {"at": "2026-11-18T01:30:00+05:30", "cents": 200},
+        {"at": "2026-11-17T13:00:00-07:00", "cents": -50},
+        {"at": "2026-11-18T00:00:00+00:00", "cents": 10},
+    ]
+    assert daily_revenue(sales) == [("2026-11-18", 260)]
+
+
+def test_custom_shop_offset_and_day_start():
+    sales = [
+        {"at": "2027-01-01T04:59:59Z", "cents": 10},
+        {"at": "2027-01-01T05:00:00Z", "cents": 20},
+    ]
+    assert daily_revenue(sales, utc_offset_hours=-5, day_starts_hour=0) == [
+        ("2026-12-31", 10),
+        ("2027-01-01", 20),
+    ]
+    assert daily_revenue(sales, utc_offset_hours=-5, day_starts_hour=23) == [
+        ("2026-12-31", 30)
+    ]
+
+
+def test_unordered_sales_include_gap_and_zero_amount_endpoints():
+    sales = [
+        {"at": "2024-03-01T04:00:00Z", "cents": 0},
+        {"at": "2024-02-27T04:00:00Z", "cents": 0},
+        {"at": "2024-02-29T04:00:00Z", "cents": -300},
+    ]
+    assert daily_revenue(sales, utc_offset_hours=0) == [
+        ("2024-02-27", 0),
+        ("2024-02-28", 0),
+        ("2024-02-29", -300),
+        ("2024-03-01", 0),
+    ]
+
+
+@pytest.mark.parametrize("timestamp", [
+    "2026-11-18T02:30:00",
+    "2026-11-18",
+    "2026-11-18+08:00",
+    "2026-11-18T02:30:00+0800",
+    "2026-11-18T02:30:00+08",
+    "2026-11-18T02:30:00+01:60",
+    "2026-11-18T02:30:00-00:99",
+    "2026-11-18T02:30:00+24:00",
+    "2026-02-30T02:30:00Z",
+    "not a timestamp",
+])
+def test_invalid_or_missing_timestamp_zone_raises_shop_error(timestamp):
+    with pytest.raises(ShopError):
+        daily_revenue([{"at": timestamp, "cents": 100}])
+
+
+@pytest.mark.parametrize("sale", [
+    {},
+    {"at": "2026-11-18T02:30:00Z"},
+    {"cents": 100},
+    {"at": None, "cents": 100},
+    {"at": "2026-11-18T02:30:00Z", "cents": 1.5},
+    {"at": "2026-11-18T02:30:00Z", "cents": True},
+    None,
+])
+def test_invalid_sales_raise_shop_error(sale):
+    with pytest.raises(ShopError):
+        daily_revenue([sale])
+
+
+@pytest.mark.parametrize("offset,start", [(0, -1), (0, 24), (0, 1.5), (0, True), (1.5, 4), (True, 4)])
+def test_invalid_parameters_raise_shop_error(offset, start):
+    with pytest.raises(ShopError):
+        daily_revenue([], utc_offset_hours=offset, day_starts_hour=start)
+
+
+def test_timezone_conversion_near_supported_date_limits():
+    assert daily_revenue(
+        [{"at": "0001-01-01T00:00:00+08:00", "cents": 10}], day_starts_hour=0
+    ) == [("0001-01-01", 10)]
+    assert daily_revenue(
+        [{"at": "9999-12-31T23:59:59+08:00", "cents": 20}], day_starts_hour=0
+    ) == [("9999-12-31", 20)]
+
+
+def test_store_day_outside_supported_date_range_raises_shop_error():
+    with pytest.raises(ShopError):
+        daily_revenue([{"at": "0001-01-01T02:00:00+08:00", "cents": 10}])
