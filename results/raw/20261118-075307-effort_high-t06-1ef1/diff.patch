diff --git a/tests/test_dates.py b/tests/test_dates.py
index fbfd5f2..6afd581 100644
--- a/tests/test_dates.py
+++ b/tests/test_dates.py
@@ -1,6 +1,9 @@
 from datetime import date
 
+import pytest
+
 from shoplib.dates import add_business_days, is_business_day
+from shoplib.errors import ShopError
 
 
 def test_is_business_day():
@@ -12,3 +15,25 @@ def test_forward_over_weekend():
     # Friday + 1 business day = Monday
     assert add_business_days(date(2026, 11, 13), 1) == date(2026, 11, 16)
     assert add_business_days(date(2026, 11, 16), 3) == date(2026, 11, 19)
+
+
+def test_holidays_are_skipped_in_both_directions():
+    holiday = date(2026, 11, 17)  # Tuesday
+    assert add_business_days(date(2026, 11, 16), 1, [holiday]) == date(2026, 11, 18)
+    assert add_business_days(date(2026, 11, 18), -1, [holiday]) == date(2026, 11, 16)
+
+
+def test_negative_days_move_strictly_before_start():
+    assert add_business_days(date(2026, 11, 16), -1) == date(2026, 11, 13)
+    assert add_business_days(date(2026, 11, 15), -1) == date(2026, 11, 13)
+
+
+def test_zero_returns_start_or_next_business_day():
+    assert add_business_days(date(2026, 11, 16), 0) == date(2026, 11, 16)
+    assert add_business_days(date(2026, 11, 15), 0) == date(2026, 11, 16)
+    assert add_business_days(date(2026, 11, 16), 0, [date(2026, 11, 16)]) == date(2026, 11, 17)
+
+
+def test_n_must_be_an_integer():
+    with pytest.raises(ShopError):
+        add_business_days(date(2026, 11, 16), 1.5)
