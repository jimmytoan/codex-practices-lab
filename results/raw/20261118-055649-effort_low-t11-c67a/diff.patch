diff --git a/src/shoplib/invoice.py b/src/shoplib/invoice.py
index 5d1398c..b965c89 100644
--- a/src/shoplib/invoice.py
+++ b/src/shoplib/invoice.py
@@ -1,5 +1,8 @@
 """Invoices: coupon allocation and tax. See docs/invoicing.md."""
 
+from shoplib.errors import ShopError
+from shoplib.money import percent_of
+
 # Tax rates in percent, by region and product category.
 TAX_RATES = {
     "DE": {"standard": 19, "food": 7, "books": 7},
@@ -10,4 +13,64 @@ TAX_RATES = {
 
 def build_invoice(lines, coupon_cents: int, shipping_cents: int, region: str) -> dict:
     """Build an invoice for an order. See docs/invoicing.md."""
-    raise NotImplementedError
+    if region not in TAX_RATES:
+        raise ShopError(f"unknown region: {region}")
+    if not lines:
+        raise ShopError("lines must not be empty")
+    if coupon_cents < 0:
+        raise ShopError("coupon must not be negative")
+    if shipping_cents < 0:
+        raise ShopError("shipping must not be negative")
+
+    rates = TAX_RATES[region]
+    prepared = []
+    total_gross = 0
+    for line in lines:
+        try:
+            sku, unit_price_cents, qty, category = line
+        except (TypeError, ValueError):
+            raise ShopError("each line must contain sku, price, quantity and category") from None
+        if unit_price_cents < 0:
+            raise ShopError("price must not be negative")
+        if qty < 1:
+            raise ShopError("quantity must be at least 1")
+        if category not in rates:
+            raise ShopError(f"unknown category: {category}")
+        gross = unit_price_cents * qty
+        prepared.append((sku, gross, rates[category]))
+        total_gross += gross
+
+    coupon = min(coupon_cents, total_gross)
+    discounts = [0] * len(prepared)
+    if total_gross:
+        remainders = []
+        allocated = 0
+        for index, (_, gross, _) in enumerate(prepared):
+            discounts[index], remainder = divmod(coupon * gross, total_gross)
+            allocated += discounts[index]
+            remainders.append((remainder, index))
+        for _, index in sorted(remainders, key=lambda item: (-item[0], item[1]))[:coupon - allocated]:
+            discounts[index] += 1
+
+    invoice_lines = []
+    taxable_line_exists = False
+    for (sku, gross, rate), discount in zip(prepared, discounts):
+        net = gross - discount
+        invoice_lines.append({
+            "sku": sku,
+            "gross_cents": gross,
+            "discount_cents": discount,
+            "net_cents": net,
+            "tax_cents": percent_of(net, rate),
+        })
+        taxable_line_exists |= rate > 0
+
+    shipping_tax = percent_of(shipping_cents, rates["standard"]) if taxable_line_exists else 0
+    total = sum(line["net_cents"] + line["tax_cents"] for line in invoice_lines)
+    total += shipping_cents + shipping_tax
+    return {
+        "lines": invoice_lines,
+        "shipping_cents": shipping_cents,
+        "shipping_tax_cents": shipping_tax,
+        "total_cents": total,
+    }
diff --git a/tests/test_invoice.py b/tests/test_invoice.py
new file mode 100644
index 0000000..d633f60
--- /dev/null
+++ b/tests/test_invoice.py
@@ -0,0 +1,75 @@
+import pytest
+
+from shoplib.errors import ShopError
+from shoplib.invoice import build_invoice
+
+
+def test_coupon_is_split_by_largest_remainder_and_earlier_line_wins_ties():
+    invoice = build_invoice(
+        [("a", 1, 1, "food"), ("b", 1, 1, "food"), ("c", 1, 1, "food")],
+        2,
+        0,
+        "OR",
+    )
+    assert [line["discount_cents"] for line in invoice["lines"]] == [1, 1, 0]
+    assert [line["net_cents"] for line in invoice["lines"]] == [0, 0, 1]
+
+
+def test_coupon_is_capped_at_order_gross_and_tax_is_per_line():
+    invoice = build_invoice(
+        [("a", 3, 1, "food"), ("b", 3, 1, "food")], 100, 0, "DE"
+    )
+    assert [line["discount_cents"] for line in invoice["lines"]] == [3, 3]
+    assert [line["tax_cents"] for line in invoice["lines"]] == [0, 0]
+    assert invoice["total_cents"] == 0
+
+
+def test_tax_and_shipping_tax_follow_region_rules():
+    invoice = build_invoice(
+        [("food", 101, 1, "food"), ("book", 1000, 1, "books")],
+        0,
+        100,
+        "DE",
+    )
+    assert [line["tax_cents"] for line in invoice["lines"]] == [7, 70]
+    assert invoice["shipping_tax_cents"] == 19
+    assert invoice["total_cents"] == 1297
+
+    untaxed = build_invoice([("book", 1000, 1, "books")], 0, 100, "SG")
+    assert untaxed["shipping_tax_cents"] == 0
+    assert untaxed["total_cents"] == 1100
+
+
+def test_zero_gross_lines_get_no_discount():
+    invoice = build_invoice([("a", 0, 1, "food")], 20, 50, "DE")
+    assert invoice == {
+        "lines": [{
+            "sku": "a", "gross_cents": 0, "discount_cents": 0,
+            "net_cents": 0, "tax_cents": 0,
+        }],
+        "shipping_cents": 50,
+        "shipping_tax_cents": 10,
+        "total_cents": 60,
+    }
+
+
+@pytest.mark.parametrize(
+    "lines,coupon,shipping,region",
+    [
+        ([("a", 1, 1, "food")], 0, 0, "XX"),
+        ([("a", 1, 1, "unknown")], 0, 0, "DE"),
+        ([], 0, 0, "DE"),
+        ([("a", 1, 0, "food")], 0, 0, "DE"),
+        ([("a", -1, 1, "food")], 0, 0, "DE"),
+        ([("a", 1, 1, "food")], -1, 0, "DE"),
+        ([("a", 1, 1, "food")], 0, -1, "DE"),
+    ],
+)
+def test_invalid_invoice_arguments_raise_value_error(lines, coupon, shipping, region):
+    with pytest.raises(ValueError):
+        build_invoice(lines, coupon, shipping, region)
+
+
+def test_invalid_invoice_arguments_use_shop_error():
+    with pytest.raises(ShopError):
+        build_invoice([], 0, 0, "DE")
