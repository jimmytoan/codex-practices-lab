+def _pack_parcels(items: list[tuple[str, int, int]], max_weight_g: int):
+    """Return parcels with their SKUs and total weights."""
+    units = []
+    for sku, weight, qty in items:
+        if weight < 1 or qty < 1:
+            raise ShopError("weight and quantity must be positive")
+        if weight > max_weight_g:
+            raise ShopError("unit is too heavy")
+        units.extend((sku, weight) for _ in range(qty))
+
+    units.sort(key=lambda unit: (-unit[1], unit[0]))
+    parcels = []
+    for sku, weight in units:
+        for parcel in parcels:
+            if parcel[1] + weight <= max_weight_g:
+                parcel[0].append(sku)
+                parcel[1] += weight
+                break
+        else:
+            parcels.append([[sku], weight])
+    return parcels
 
 
 def split_parcels(items: list[tuple[str, int, int]], max_weight_g: int) -> list[list[str]]:
     """Split order items into parcels. See docs/shipping.md."""
-    raise NotImplementedError
+    return [skus for skus, _ in _pack_parcels(items, max_weight_g)]
 
 
 def shipment_cost(items: list[tuple[str, int, int]], max_weight_g: int) -> int:
     """Total shipping cost of an order. See docs/shipping.md."""
-    raise NotImplementedError
+    return sum(shipping_cost(weight) for _, weight in _pack_parcels(items, max_weight_g))
