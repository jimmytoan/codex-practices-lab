 def test_fixed_never_negative():
     assert apply_coupon(300, Coupon("FIVE", "fixed", 500)) == 0
+
+
+def test_apply_coupons_eligibility_selection_and_order():
+    today = date(2026, 1, 10)
+    coupons = [
+        Coupon("ZFIX", "fixed", 10, expires=today, min_subtotal_cents=100),
+        Coupon("EXPIRED", "percent", 90, expires=date(2026, 1, 9)),
+        Coupon("TOO_HIGH", "percent", 80, min_subtotal_cents=101),
+        Coupon("ZPCT", "percent", 20),
+        Coupon("APCT", "percent", 20),
+        Coupon("LOW", "percent", 10),
+        Coupon("AFIX", "fixed", 5, min_subtotal_cents=100),
+    ]
+    assert apply_coupons(100, coupons, today) == (65, ["AFIX", "APCT", "ZFIX"])
+
+
+def test_apply_coupons_rounds_percent_half_up_before_fixed():
+    coupons = [Coupon("FIX", "fixed", 1), Coupon("PCT", "percent", 50)]
+    assert apply_coupons(5, coupons, date(2026, 1, 1)) == (1, ["FIX", "PCT"])
+
+
+def test_apply_coupons_clamps_total_and_keeps_all_applied_codes():
+    coupons = [Coupon("Z", "fixed", 200), Coupon("A", "fixed", 100)]
+    assert apply_coupons(50, coupons, date(2026, 1, 1)) == (0, ["A", "Z"])
+
+
+def test_apply_coupons_with_no_coupons():
+    assert apply_coupons(100, [], date(2026, 1, 1)) == (100, [])
+
+
+def test_apply_coupons_rejects_negative_subtotal():
+    with pytest.raises(ShopError):
+        apply_coupons(-1, [], date(2026, 1, 1))
+
+
+@pytest.mark.parametrize("expires", [None, date(2025, 12, 31)])
+def test_apply_coupons_rejects_unknown_kind(expires):
+    with pytest.raises(ShopError, match="unknown coupon kind"):
+        apply_coupons(100, [Coupon("BAD", "other", 10, expires=expires)], date(2026, 1, 1))
