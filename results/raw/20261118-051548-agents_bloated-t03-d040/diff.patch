diff --git a/tests/test_inventory.py b/tests/test_inventory.py
index 37436c0..e768c5f 100644
--- a/tests/test_inventory.py
+++ b/tests/test_inventory.py
@@ -18,3 +18,43 @@ def test_cannot_reserve_more_than_available():
     inv.receive("A", 2)
     with pytest.raises(ValueError):
         inv.reserve("A", 3)
+
+
+def test_release_returns_reserved_units_to_available():
+    inv = Inventory()
+    inv.receive("A", 10)
+    inv.reserve("A", 6)
+
+    inv.release("A", 2)
+
+    assert inv.on_hand("A") == 10
+    assert inv.reserved("A") == 4
+    assert inv.available("A") == 6
+
+
+@pytest.mark.parametrize("qty", [0, -1])
+def test_release_requires_positive_quantity(qty):
+    inv = Inventory()
+    inv.receive("A", 10)
+    inv.reserve("A", 4)
+
+    with pytest.raises(ValueError, match="qty must be positive"):
+        inv.release("A", qty)
+
+    assert inv.reserved("A") == 4
+    assert inv.available("A") == 6
+
+
+@pytest.mark.parametrize("reserved, qty", [(0, 1), (2, 3)])
+def test_cannot_release_more_than_reserved(reserved, qty):
+    inv = Inventory()
+    inv.receive("A", 10)
+    if reserved:
+        inv.reserve("A", reserved)
+
+    with pytest.raises(ValueError, match=f"only {reserved} of A reserved"):
+        inv.release("A", qty)
+
+    assert inv.on_hand("A") == 10
+    assert inv.reserved("A") == reserved
+    assert inv.available("A") == 10 - reserved
