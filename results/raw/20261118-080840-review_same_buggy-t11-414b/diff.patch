index 0000000..6a73f31
--- /dev/null
+++ b/tests/test_invoice.py
@@ -0,0 +1,94 @@
+import pytest
+
+from shoplib.invoice import build_invoice
+
+
+def test_coupon_is_split_proportionally_and_caps_at_gross():
+    invoice = build_invoice(
+        [("A", 100, 1, "books"), ("B", 300, 1, "books")],
+        coupon_cents=200,
+        shipping_cents=0,
+        region="OR",
+    )
+
+    assert [line["discount_cents"] for line in invoice["lines"]] == [50, 150]
+    assert [line["net_cents"] for line in invoice["lines"]] == [50, 150]
+    assert invoice["total_cents"] == 200
+
+    capped = build_invoice(
+        [("A", 100, 1, "books"), ("B", 0, 2, "books")],
+        coupon_cents=500,
+        shipping_cents=0,
+        region="OR",
+    )
+    assert [line["discount_cents"] for line in capped["lines"]] == [100, 0]
+
+
+def test_equal_coupon_remainders_go_to_earlier_line():
+    invoice = build_invoice(
+        [("first", 1, 1, "books"), ("second", 1, 1, "books")],
+        coupon_cents=1,
+        shipping_cents=0,
+        region="OR",
+    )
+
+    assert [line["discount_cents"] for line in invoice["lines"]] == [1, 0]
+
+
+def test_line_tax_is_rounded_on_net_and_shipping_is_taxed_when_applicable():
+    invoice = build_invoice(
+        [("food", 50, 1, "food")],
+        coupon_cents=1,
+        shipping_cents=50,
+        region="DE",
+    )
+
+    assert invoice["lines"][0] == {
+        "sku": "food",
+        "gross_cents": 50,
+        "discount_cents": 1,
+        "net_cents": 49,
+        "tax_cents": 3,
+    }
+    assert invoice["shipping_tax_cents"] == 10
+    assert invoice["total_cents"] == 112
+
+
+def test_shipping_is_not_taxed_if_all_line_categories_are_zero_rated():
+    invoice = build_invoice(
+        [("book", 100, 1, "books")],
+        coupon_cents=0,
+        shipping_cents=100,
+        region="SG",
+    )
+
+    assert invoice["shipping_tax_cents"] == 0
+    assert invoice["total_cents"] == 200
+
+
+@pytest.mark.parametrize(
+    "lines,coupon,shipping,region",
+    [
+        ([("A", 1, 1, "books")], 0, 0, "XX"),
+        ([], 0, 0, "OR"),
+        ([("A", 1, 1, "unknown")], 0, 0, "OR"),
+        ([("A", 1, 0, "books")], 0, 0, "OR"),
+        ([("A", -1, 1, "books")], 0, 0, "OR"),
+        ([("A", 1, 1, "books")], -1, 0, "OR"),
+        ([("A", 1, 1, "books")], 0, -1, "OR"),
+    ],
+)
+def test_invalid_invoice_arguments_raise_value_error(lines, coupon, shipping, region):
+    with pytest.raises(ValueError):
+        build_invoice(lines, coupon, shipping, region)
+
+
+def test_zero_gross_lines_receive_no_coupon():
+    invoice = build_invoice(
+        [("A", 0, 1, "books"), ("B", 0, 2, "books")],
+        coupon_cents=10,
+        shipping_cents=0,
+        region="OR",
+    )
+
+    assert [line["discount_cents"] for line in invoice["lines"]] == [0, 0]
