@@ -0,0 +1,51 @@
+import pytest
+
+from shoplib.errors import ShopError
+from shoplib.search import Product, search
+
+
+@pytest.fixture
+def products():
+    return [
+        Product("MUG-1", "Blue mug", 1200, ["kitchen", "sale"]),
+        Product("CUP-2", "Blue cup", 900, ["kitchen"]),
+        Product("MUG-3", "Travel mug", 1500, ["outdoor"]),
+    ]
+
+
+def test_bare_terms_and_quoted_phrases_match_names_in_order(products):
+    assert [p.sku for p in search(products, "blue mug")] == ["MUG-1"]
+    assert [p.sku for p in search(products, '"blue m"')] == ["MUG-1"]
+    assert [p.sku for p in search(products, 'name:"blue c"')] == ["CUP-2"]
+    assert [p.sku for p in search(products, '"mug: blue"')] == []
+    assert search(products, '"price>=1000"') == []
+
+
+def test_fields_price_and_negation_combine_with_and(products):
+    result = search(products, "sku:MUG-* tag:kitchen price>=1000 -name:travel")
+    assert [p.sku for p in result] == ["MUG-1"]
+    assert [p.sku for p in search(products, "price<1200")] == ["CUP-2"]
+    assert [p.sku for p in search(products, "price=1500")] == ["MUG-3"]
+    assert [p.sku for p in search(products, "-tag:sale")] == ["CUP-2", "MUG-3"]
+
+
+def test_search_is_case_insensitive_and_empty_query_matches_everything(products):
+    assert [p.sku for p in search(products, "sku:mUg-1")] == ["MUG-1"]
+    assert [p.sku for p in search(products, "tag:KITCHEN")] == ["MUG-1", "CUP-2"]
+    assert search(products, "  \t ") == products
+
+
+@pytest.mark.parametrize(
+    "query",
+    ["price:5", "tag:", "color:red", "-", 'name:"unfinished', "price>=1.5"],
+)
+def test_invalid_queries_raise_shop_error(products, query):
+    with pytest.raises(ShopError):
+        search(products, query)
+
+
+def test_prefix_star_is_special_only_at_the_end(products):
+    assert [p.sku for p in search(products, "sku:MUG-*")] == ["MUG-1", "MUG-3"]
+    assert search(products, "sku:MUG*1") == []
+    assert [p.sku for p in search(products, "tag:kit*")] == ["MUG-1", "CUP-2"]
+
