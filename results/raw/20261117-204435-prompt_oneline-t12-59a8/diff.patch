 @dataclass
 class Product:
@@ -13,4 +16,103 @@ class Product:
 
 def search(products: list[Product], query: str) -> list[Product]:
     """The products that match `query`, in their input order. See docs/search.md."""
-    raise NotImplementedError
+    terms = _tokenize(query)
+    if not terms:
+        return list(products)
+
+    parsed_terms = [_parse_term(chars, quoted) for chars, quoted in terms]
+    return [
+        product
+        for product in products
+        if all(_matches(product, term) for term in parsed_terms)
+    ]
+
+
+def _tokenize(query: str) -> list[tuple[str, list[bool]]]:
+    """Split on unquoted whitespace and remember which characters were quoted."""
+    tokens: list[tuple[str, list[bool]]] = []
+    chars: list[str] = []
+    quoted_chars: list[bool] = []
+    in_quote = False
+
+    for char in query:
+        if char == '"':
+            in_quote = not in_quote
+        elif char.isspace() and not in_quote:
+            if chars:
+                tokens.append(("".join(chars), quoted_chars))
+                chars = []
+                quoted_chars = []
+        else:
+            chars.append(char)
+            quoted_chars.append(in_quote)
+
+    if in_quote:
+        raise ShopError("unclosed quote")
+    if chars:
+        tokens.append(("".join(chars), quoted_chars))
+    return tokens
+
+
+def _parse_term(chars: str, quoted: list[bool]) -> tuple[str, str, str, bool]:
+    negated = bool(chars) and chars[0] == "-" and not quoted[0]
+    if negated:
+        chars = chars[1:]
+        quoted = quoted[1:]
+        if not chars:
+            raise ShopError("missing term after '-'")
+
+    colon = next(
+        (index for index, char in enumerate(chars) if char == ":" and not quoted[index]),
+        None,
+    )
+    if colon is not None:
+        field_name = chars[:colon]
+        value = chars[colon + 1 :]
+        if field_name not in {"sku", "name", "tag"} or any(quoted[:colon]):
+            raise ShopError(f"unknown search field: {field_name}")
+        if not value:
+            raise ShopError("field value must not be empty")
+        return (field_name, "contains", value, negated)
+
+    price_match = (
+        None if any(quoted) else re.match(r"^price(<=|>=|<|>|=)(.*)$", chars)
+    )
+    if price_match:
+        operator, value = price_match.groups()
+        if not re.fullmatch(r"[0-9]+", value):
+            raise ShopError("price comparison must use whole cents")
+        return ("price", operator, value, negated)
+
+    return ("name", "contains", chars, negated)
+
+
+def _matches(product: Product, term: tuple[str, str, str, bool]) -> bool:
+    field_name, operator, value, negated = term
+    if field_name == "price":
+        cents = int(value)
+        matched = {
+            "<": product.price_cents < cents,
+            "<=": product.price_cents <= cents,
+            ">": product.price_cents > cents,
+            ">=": product.price_cents >= cents,
+            "=": product.price_cents == cents,
+        }[operator]
+    elif field_name == "sku":
+        candidate = product.sku.casefold()
+        sought = value.casefold()
+        if sought.endswith("*"):
+            matched = candidate.startswith(sought[:-1])
+        else:
+            matched = candidate == sought
+    elif field_name == "tag":
+        sought = value.casefold()
+        if sought.endswith("*"):
+            prefix = sought[:-1]
+            matched = any(tag.casefold().startswith(prefix) for tag in product.tags)
+        else:
+            matched = any(tag.casefold() == sought for tag in product.tags)
+    else:
+        matched = value.casefold() in product.name.casefold()
+
+    return not matched if negated else matched
