@@ -0,0 +1,76 @@
+import pytest
+
+from shoplib.errors import ShopError
+from shoplib.search import Product, search
+
+
+@pytest.fixture
+def products():
+    return [
+        Product("MUG-1", "Blue Ceramic Mug", 1000, ["Sale", "Kitchen Gear"]),
+        Product("mug-2", "Red mug", 1500, ["SALE-ITEM"]),
+        Product("TEA*1", "Blue Tea", 500, ["Drinks"]),
+        Product("T-1", "tag:sale -red price>=1000", 0, []),
+    ]
+
+
+@pytest.mark.parametrize(
+    ("query", "indices"),
+    [
+        ("", [0, 1, 2, 3]),
+        (" \t\n ", [0, 1, 2, 3]),
+        ("MuG", [0, 1]),
+        ('"blue ceramic"', [0]),
+        ('name:"CERAMIC mug"', [0]),
+        ("name:blue", [0, 2]),
+        ("sku:mUg-1", [0]),
+        ("sku:MUG-*", [0, 1]),
+        ("sku:TEA*1", [2]),
+        ("tag:sALE", [0]),
+        ("tag:sale*", [0, 1]),
+        ('tag:"kitchen gear"', [0]),
+        ("blue -tag:sale", [2]),
+        ("-sku:MUG-*", [2, 3]),
+        ("-price>=1000", [2, 3]),
+        ('"tag:sale"', [3]),
+        ('"-red"', [3]),
+        ('"price>=1000"', [3]),
+        ('name:"tag:sale"', [3]),
+        ('price>="1000"', [0, 1]),
+        ("price<1000", [2, 3]),
+        ("price<=1000", [0, 2, 3]),
+        ("price>1000", [1]),
+        ("price>=1000", [0, 1]),
+        ("price=1000", [0]),
+        ("price=001000", [0]),
+        ("mug tag:sale* price>=1000 -sku:MUG-2", [0]),
+    ],
+)
+def test_search_terms(products, query, indices):
+    assert search(products, query) == [products[i] for i in indices]
+
+
+def test_case_insensitive_matching_uses_unicode_casefold():
+    product = Product("STRASSE", "Straße Kaffee", 100, ["GROSSE"])
+    for query in ("STRASSE", "name:STRASSE", "sku:straße", "sku:straß*", "tag:große", "tag:groß*"):
+        assert search([product], query) == [product]
+
+
+@pytest.mark.parametrize(
+    "query",
+    [
+        "price:5", "unknown:value", ":value", "name:", 'tag:""', "sku:",
+        "-", "-tag:", '"unclosed', 'name:"unclosed',
+        "price<", "price>=-1", "price=1.5", "price=abc", "price==1",
+        'price>="nope"', 'price<"=1"',
+    ],
+)
+def test_invalid_queries_raise_shop_error_even_without_products(query):
+    with pytest.raises(ShopError):
+        search([], query)
+
+
+def test_price_comparison_accepts_large_whole_numbers():
+    product = Product("BIG", "Big", 10 ** 5000)
+    assert search([product], "price=" + "1" + "0" * 5000) == [product]
+    assert search([product], "price<" + "9" * 5002) == [product]
